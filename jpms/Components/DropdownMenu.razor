@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    The house dropdown: a toggle button and a panel of items beneath it.

    EVERY toggle-and-panel on the site is this component. It was pulled out of the hand-rolled
    copies in 2026-09, and the copies left behind each drifted into their own dismissal
    behaviour — two with none at all, three that closed but swallowed the outside press — which
    is the bug this component exists to make impossible. A new menu that hand-rolls its own
    open-state is that bug again.

    Dismissal, the whole contract: the toggle closes it when open, a press anywhere outside it
    closes it, and Escape closes it. The outside press is watched at the document by
    dropdown-menu.js while the panel is open and STILL LANDS on whatever was pressed — a menu
    dismissing is never a click the user has to spend twice. Each item closes the menu before
    running, so a click can never leave it hanging open, and because each menu owns its own
    open-state, pressing one toggle while another is open closes that one and opens this one in
    the same click.

    Two ways to use it:
      • Pass Items and let it render them — the common case, and the one that keeps every menu
        looking the same.
      • Pass ChildContent for a menu that needs its own markup (a checkmark, a nested control).
        Call Close() from an @onclick if you do.
*@

<div class="relative @Class" @ref="root">
    <button type="button"
            class="@ToggleClass"
            title="@ToggleTitle"
            disabled="@Disabled"
            aria-haspopup="menu"
            aria-expanded="@(open ? "true" : "false")"
            @onclick="Toggle"
            @onmousedown:preventDefault="ShouldKeepFocus">
        @if (ToggleContent is not null)
        {
            @ToggleContent
        }
        else
        {
            <span>@Label</span>
        }
        @if (ShowCaret)
        {
            <span class="text-xs" aria-hidden="true">@(open ? "▲" : "▼")</span>
        }
    </button>

    @if (open)
    {
        <div class="absolute @AlignClass mt-2 @WidthClass rounded border border-line bg-surface shadow-lg z-30 overflow-hidden"
             role="menu">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                <ul class="divide-y divide-line">
                    @foreach (var group in Items.GroupBy(item => item.Group))
                    {
                        @foreach (var item in group)
                        {
                            var entry = item;
                            <li>
                                @if (entry.Href is not null)
                                {
                                    <a href="@entry.Href"
                                       download="@(entry.Download ? "" : null)"
                                       role="menuitem"
                                       title="@entry.Hint"
                                       class="block px-3 py-2 text-sm text-content hover:bg-surface-raised transition"
                                       @onclick="Close">@entry.Label</a>
                                }
                                else
                                {
                                    <button type="button"
                                            role="menuitem"
                                            title="@entry.Hint"
                                            disabled="@entry.Disabled"
                                            class="w-full text-left px-3 py-2 text-sm transition @(entry.Disabled ?"text-content-subtle cursor-default" : entry.Destructive ? "text-negative hover:bg-surface-raised" : "text-content hover:bg-surface-raised")"
                                            @onclick="() => Run(entry)">
                                        @entry.Label@(entry.Selected ? " ✓" : "")
                                    </button>
                                }
                            </li>
                        }
                    }
                </ul>
            }
        </div>
    }
</div>

@code {
    /// <summary>One row in the menu. Either Href (renders a link) or OnSelect (renders a button) —
    /// not both. Group only affects ordering: items sharing a group render adjacent, and the
    /// divider between every row is the same either way.</summary>
    public sealed record Item(
        string Label,
        EventCallback? OnSelect = null,
        string? Href = null,
        string? Hint = null,
        bool Disabled = false,
        bool Destructive = false,
        bool Selected = false,
        bool Download = false,
        int Group = 0);

    [Parameter] public string Label { get; set; } = "Actions";

    /// <summary>Custom toggle content, when a plain label isn't enough (a status pill, an avatar).</summary>
    [Parameter] public RenderFragment? ToggleContent { get; set; }

    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string ToggleClass { get; set; } = "btn-secondary";

    /// <summary>Hide the ▲/▼ caret — for icon-only toggles (a Toolbar button), where the caret
    /// would crowd the glyph and the hover text already says a menu opens.</summary>
    [Parameter] public bool ShowCaret { get; set; } = true;
    [Parameter] public string ToggleTitle { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string WidthClass { get; set; } = "w-60";

    /// <summary>Which edge the panel hangs from. Right by default so a menu at the end of a title
    /// bar doesn't run off the page.</summary>
    [Parameter] public bool AlignLeft { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Stops the toggle taking focus, so whatever the user had selected stays selected —
    /// for a menu whose items act on that selection. The rich-text colour menu needs it: pressing
    /// the toggle would otherwise collapse the caret in the contenteditable body and leave
    /// foreColor with nothing to colour. Off everywhere else, because a toggle that cannot take
    /// focus cannot be reached by keyboard.</summary>
    [Parameter] public bool ShouldKeepFocus { get; set; }

    /// <summary>Raised whenever the panel opens (true) or closes (false). A host whose menu sits
    /// inside an overflow/scroll container listens to this to lift the clipping while the panel
    /// is showing — an absolutely-positioned panel cannot escape an overflow ancestor on its own,
    /// so its bottom items are cut off at the container's edge (which is how a row's Delete… went
    /// missing in the valuation invoices table).</summary>
    [Parameter] public EventCallback<bool> OnOpenChanged { get; set; }

    private bool open;
    private ElementReference root;
    private DotNetObjectReference<DropdownMenu>? selfRef;
    private bool watching;

    private string AlignClass => AlignLeft ? "left-0" : "right-0";

    /// <summary>Keeps the document-level outside-press watcher in step with the panel: on while
    /// open, off once closed. Done after render so the watcher only ever sees a root that exists,
    /// and so every way of closing (toggle, item, Close(), outside press) tears it down the same
    /// way.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (open == watching) return;
        watching = open;
        if (open)
        {
            selfRef ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("jpmsDropdownMenu.watch", root, selfRef);
        }
        else if (selfRef is not null)
        {
            await Js.InvokeVoidAsync("jpmsDropdownMenu.unwatch", selfRef);
        }
    }

    /// <summary>Called from dropdown-menu.js on a press outside the menu or an Escape key.</summary>
    [JSInvokable]
    public async Task CloseFromOutside()
    {
        if (!open) return;
        open = false;
        await OnOpenChanged.InvokeAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (selfRef is null) return;
        // Take the JS listeners down BEFORE the reference is disposed, so a press during teardown
        // can't call back into a dead object (same race UpdateToast hit).
        if (watching)
        {
            try { await Js.InvokeVoidAsync("jpmsDropdownMenu.unwatch", selfRef); }
            catch { /* Tearing down during navigation/unload — the listeners die with the page. */ }
            watching = false;
        }
        selfRef.Dispose();
        selfRef = null;
    }

    private async Task Toggle()
    {
        open = !open;
        await OnOpenChanged.InvokeAsync(open);
    }

    /// <summary>Closes the menu. Public so a ChildContent menu can dismiss itself.</summary>
    public void Close()
    {
        if (!open) return;
        open = false;
        _ = OnOpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    private async Task Run(Item item)
    {
        if (item.Disabled) return;
        open = false;
        await OnOpenChanged.InvokeAsync(false);
        if (item.OnSelect is { } callback) await callback.InvokeAsync();
    }
}
