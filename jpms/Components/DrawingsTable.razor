@inject NavigationManager Nav
@using Jewel.JPMS.Features.Drawings

@* The drawing register table. With folders present the rows group into collapsible sections —
   one per folder in tree order (top level A–Z, each sub-folder indented beneath its parent),
   Ungrouped last — inside a single table so the sticky column headers hold across sections.
   Drawings sit at whatever level their folder is. With no folders it renders the flat register
   it always was. Collapse state is per-visit; the register reopens fully expanded. *@

<div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
    <table class="w-full text-sm">
        <thead class="bg-surface-raised border-b border-line">
            <tr class="text-left eyebrow">
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Code</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Title</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden lg:table-cell">File</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 text-center">Latest approved</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 text-center">Status</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 text-center">Pipeline</th>
                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden md:table-cell">Added</th>
            </tr>
        </thead>
        @if (Folders.Count == 0)
        {
            <tbody class="divide-y divide-line">
                @foreach (var drawing in Drawings)
                {
                    @DrawingRow(drawing, depth: 0)
                }
            </tbody>
        }
        else
        {
            @foreach (var folderSection in VisibleSections)
            {
                <tbody class="divide-y divide-line border-t border-line">
                    <tr class="bg-surface-raised/70 cursor-pointer select-none hover:bg-surface-raised transition"
                        @onclick="() => ToggleCollapse(folderSection.Key)">
                        <td colspan="@ColumnCount" class="px-4 py-2" style="@IndentStyle(folderSection.Depth)">
                            <div class="flex items-center gap-2">
                                <ActionIcon Name="chevron-down"
                                            Class="@(IsCollapsed(folderSection.Key) ? "w-3.5 h-3.5 text-content-subtle -rotate-90 transition-transform" : "w-3.5 h-3.5 text-content-subtle transition-transform")" />
                                @if (folderSection.Folder is not null)
                                {
                                    <ActionIcon Name="folder" Class="w-4 h-4 text-content-subtle" />
                                    <span class="font-medium text-content">@folderSection.Folder.Name</span>
                                }
                                else
                                {
                                    <span class="font-medium text-content-muted italic">Ungrouped</span>
                                }
                                <span class="text-xs text-content-subtle tabular-nums" title="Documents in this folder, sub-folders included">@SubtreeCount(folderSection)</span>
                                @if (CanManage && folderSection.Folder is { } folder)
                                {
                                    <span class="ml-auto flex items-center gap-1">
                                        <button type="button" title="Upload documents into this folder" aria-label="Upload documents into this folder"
                                                @onclick="() => OnUploadToFolder.InvokeAsync(folder)" @onclick:stopPropagation="true"
                                                class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-content hover:bg-surface transition">
                                            <ActionIcon Name="upload" Class="w-3.5 h-3.5" />
                                        </button>
                                        <button type="button" title="New sub-folder" aria-label="New sub-folder"
                                                @onclick="() => OnCreateSubFolder.InvokeAsync(folder)" @onclick:stopPropagation="true"
                                                class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-content hover:bg-surface transition">
                                            <ActionIcon Name="plus" Class="w-3.5 h-3.5" />
                                        </button>
                                        <button type="button" title="Rename folder" aria-label="Rename folder"
                                                @onclick="() => OnRenameFolder.InvokeAsync(folder)" @onclick:stopPropagation="true"
                                                class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-content hover:bg-surface transition">
                                            <ActionIcon Name="pencil" Class="w-3.5 h-3.5" />
                                        </button>
                                        <button type="button" title="Delete folder (its documents and sub-folders move up a level)" aria-label="Delete folder"
                                                @onclick="() => OnDeleteFolder.InvokeAsync(folder)" @onclick:stopPropagation="true"
                                                class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-red-700 hover:bg-red-50 transition">
                                            <ActionIcon Name="trash" Class="w-3.5 h-3.5" />
                                        </button>
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                    @if (!IsCollapsed(folderSection.Key))
                    {
                        @if (folderSection.Drawings.Count == 0 && !HasSubFolders(folderSection))
                        {
                            <tr>
                                <td colspan="@ColumnCount" class="px-4 py-3 text-xs text-content-subtle italic" style="@IndentStyle(folderSection.Depth + 1)">No documents in this folder yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var drawing in folderSection.Drawings)
                            {
                                @DrawingRow(drawing, folderSection.Depth + 1)
                            }
                        }
                    }
                </tbody>
            }
        }
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Drawing> Drawings { get; set; } = Array.Empty<Drawing>();

    /// <summary>The project's folders, every level (A–Z from the store). Empty = flat table.</summary>
    [Parameter] public IReadOnlyList<DrawingFolder> Folders { get; set; } = Array.Empty<DrawingFolder>();

    [Parameter] public bool CanManage { get; set; }
    [Parameter] public EventCallback<DrawingFolder> OnCreateSubFolder { get; set; }

    /// <summary>The folder row's upload button: open the upload panel with this folder already
    /// chosen, so "upload INTO the folder" is one click rather than upload-then-pick.</summary>
    [Parameter] public EventCallback<DrawingFolder> OnUploadToFolder { get; set; }
    [Parameter] public EventCallback<DrawingFolder> OnRenameFolder { get; set; }
    [Parameter] public EventCallback<DrawingFolder> OnDeleteFolder { get; set; }

    private readonly HashSet<string> collapsed = new();

    private const string UngroupedKey = "";
    private const int ColumnCount = 7;
    private const double IndentRemPerLevel = 1.5;

    private sealed record Section(string Key, DrawingFolder? Folder, int Depth, IReadOnlyList<Drawing> Drawings);

    // Rebuilt once per parameter set, not per render — the tree is read many times a render.
    private DrawingFolderTree Tree = new(Array.Empty<DrawingFolder>());

    protected override void OnParametersSet() => Tree = new DrawingFolderTree(Folders);

    // A collapsed folder hides its whole sub-tree, not just its own drawings.
    private IEnumerable<Section> VisibleSections =>
        Sections.Where(section => !Tree.HasAncestor(section.Folder?.DrawingFolderId, collapsed));

    // Every folder gets a section even when empty (so it can be renamed/deleted and shows it
    // exists); Ungrouped renders last and only when something is actually ungrouped.
    private IEnumerable<Section> Sections
    {
        get
        {
            // A drawing whose folder id is not in Folders (the folder list lagging a beat behind
            // the register, or a folder deleted elsewhere) falls into Ungrouped rather than into
            // a section that never renders — a drawing must NEVER be invisible on its own register.
            var knownFolderIds = Tree.Nodes.Select(node => node.Folder.DrawingFolderId).ToHashSet();
            var byFolder = Drawings
                .GroupBy(drawing => drawing.DrawingFolderId is { } folderId && knownFolderIds.Contains(folderId) ? folderId : UngroupedKey)
                .ToDictionary(group => group.Key, group => (IReadOnlyList<Drawing>)group.ToList());

            foreach (var node in Tree.Nodes)
            {
                byFolder.TryGetValue(node.Folder.DrawingFolderId, out var drawings);
                yield return new Section(node.Folder.DrawingFolderId, node.Folder, node.Depth, drawings ?? Array.Empty<Drawing>());
            }

            if (byFolder.TryGetValue(UngroupedKey, out var ungrouped) && ungrouped.Count > 0)
                yield return new Section(UngroupedKey, null, 0, ungrouped);
        }
    }

    private bool IsCollapsed(string key) => collapsed.Contains(key);

    private bool HasSubFolders(Section section) =>
        section.Folder is not null && Tree.ChildrenOf(section.Folder.DrawingFolderId).Any();

    private int SubtreeCount(Section section)
    {
        if (section.Folder is null) return section.Drawings.Count;
        var ids = Tree.SubtreeIds(section.Folder.DrawingFolderId).ToHashSet();
        return Drawings.Count(drawing => drawing.DrawingFolderId is { } folderId && ids.Contains(folderId));
    }

    private static string IndentStyle(int depth) =>
        depth == 0 ? "" : $"padding-left: {1 + depth * IndentRemPerLevel}rem";

    private void ToggleCollapse(string key)
    {
        if (!collapsed.Add(key)) collapsed.Remove(key);
    }

    private void OpenDrawing(Drawing drawing) =>
        Nav.NavigateTo($"/projects/{drawing.ProjectId}/documents/{drawing.DrawingId}");

    private RenderFragment DrawingRow(Drawing drawing, int depth) => __builder =>
    {
        <tr class="hover:bg-surface-raised cursor-pointer transition"
            @onclick="() => OpenDrawing(drawing)">
            <td class="px-4 py-3 font-mono text-xs text-content-muted" style="@IndentStyle(depth)">@DrawingNaming.Code(drawing)</td>
            <td class="px-4 py-3 text-content font-medium">
                @if (DrawingNaming.IsNamedByFile(drawing))
                {
                    <span class="text-content-muted" title="No title yet — showing the file name">@DrawingNaming.Name(drawing)</span>
                }
                else
                {
                    @DrawingNaming.Name(drawing)
                }
            </td>
            <td class="px-4 py-3 text-xs text-content-subtle hidden lg:table-cell max-w-[16rem] truncate" title="@drawing.LatestFileName">
                @(drawing.LatestFileName ?? DrawingNaming.Blank)
            </td>
            <td class="px-4 py-3 text-center">
                @if (DrawingNaming.ApprovedRevisionText(drawing) is { } approvedText)
                {
                    <Pill Tone="Tone.Positive" Class="justify-center font-mono">
                        @approvedText
                    </Pill>
                }
                else
                {
                    <span class="text-xs text-content-subtle italic">@DrawingNaming.Blank</span>
                }
            </td>
            <td class="px-4 py-3 text-center whitespace-nowrap">
                @if (drawing.UnapprovedCount > 0)
                {
                    <Pill Tone="Tone.Warning">
                        @drawing.UnapprovedCount pending
                    </Pill>
                }
                @if (drawing.ArchivedCount > 0)
                {
                    <Pill Tone="Tone.Muted" Class="ml-1">
                        @drawing.ArchivedCount archived
                    </Pill>
                }
                @if (drawing.UnapprovedCount == 0 && drawing.ArchivedCount == 0 && drawing.HasApprovedRevision)
                {
                    <Pill Tone="Tone.Positive">
                        Approved
                    </Pill>
                }
            </td>
            <td class="px-4 py-3 text-center whitespace-nowrap">
                @* Pipeline status of the latest revision: has Bluebeam extracted its
                   metadata, and has the change analysis run? Pending states are shown
                   just as loudly so un-analysed drawings can't be silently missed. *@
                @if (drawing.LatestMetadataExtractedAt is { } extractedAt)
                {
                    <Pill Tone="Tone.Positive" Title="@($"Metadata extracted {extractedAt.LocalDateTime:d MMM yyyy, HH:mm}")">
                        Metadata ✓
                    </Pill>
                }
                else
                {
                    <Pill Tone="Tone.Warning" Title="The latest revision's metadata has not been extracted yet">
                        Not extracted
                    </Pill>
                }
                @if (drawing.LatestAnalysedAt is { } analysedAt)
                {
                    <Pill Tone="Tone.Positive" Class="ml-1" Title="@($"Change analysis run {analysedAt.LocalDateTime:d MMM yyyy, HH:mm}")">
                        Analysed ✓
                    </Pill>
                }
                else
                {
                    <Pill Tone="Tone.Warning" Class="ml-1" Title="The latest revision has not been analysed yet">
                        Not analysed
                    </Pill>
                }
            </td>
            <td class="px-4 py-3 text-content-muted hidden md:table-cell">
                @drawing.CreatedAt.LocalDateTime.ToString("d MMM yyyy")
            </td>
        </tr>
    };
}
