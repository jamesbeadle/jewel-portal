@using Jewel.JPMS.Contracts.UsefulInformation
@inject IUsefulInformationStore Notes
@inject SessionService Session

@*
    The credential section of the note dialog: the one shared site credential a note may hold —
    WiFi, alarm or gate code, a shared equipment PIN; never a person's own password (Jeremy,
    2026-09-22). Typed masked, held encrypted, and read back only by the directors: Reveal asks
    the server, which answers the directors alone and writes who looked to the audit trail.
    Everyone else on staff sees that a credential is held and can replace or remove it.
*@

<div class="space-y-2">
    @if (Note is { HasSecret: true })
    {
        <div class="flex items-center justify-between gap-3 rounded border border-line px-3 py-2">
            <span class="min-w-0">
                <span class="block text-sm font-medium text-content">Credential held</span>
                @if (revealed is { } value)
                {
                    <span class="block font-mono text-sm text-content break-all">@value</span>
                }
                else
                {
                    <span class="block font-mono text-sm text-content-subtle">••••••••</span>
                }
            </span>
            @if (MayReveal)
            {
                <button type="button" class="btn-secondary shrink-0" disabled="@revealing" @onclick="ToggleReveal">
                    @(revealed is null ? (revealing ? "Revealing…" : "Reveal") : "Hide")
                </button>
            }
        </div>
        @if (revealError is not null)
        {
            <Notice Tone="Tone.Negative">@revealError</Notice>
        }
        @if (!MayReveal)
        {
            <TableNote>Only a director can reveal it. Every reveal is recorded.</TableNote>
        }
        <Checkbox Label="Remove the credential from this note" Value="@Remove" ValueChanged="RemoveChanged" />
    }

    @if (!Remove)
    {
        <FormField Label="@(Note is { HasSecret: true } ? "Replace the credential" : "Credential (optional)")"
                   InputType="password" Value="@Draft" OnChange="DraftChanged"
                   Placeholder="A shared site code — WiFi, alarm, gate. Never someone's own password."
                   Hint="Held masked and encrypted; only a director can reveal it, and every reveal is recorded." />
    }
</div>

@code {
    /// <summary>The note being edited, or null when adding one.</summary>
    [Parameter] public UsefulInformationNote? Note { get; set; }

    /// <summary>The credential typed in this dialog — blank means leave what is held alone.</summary>
    [Parameter] public string Draft { get; set; } = "";
    [Parameter] public EventCallback<string> DraftChanged { get; set; }

    /// <summary>Ticked to take the held credential off the note on save.</summary>
    [Parameter] public bool Remove { get; set; }
    [Parameter] public EventCallback<bool> RemoveChanged { get; set; }

    private string? revealed;
    private bool revealing;
    private string? revealError;

    private bool MayReveal => Session.CanOpen(UsefulInformationRoles.AllowedToReveal);

    private async Task ToggleReveal()
    {
        if (revealed is not null) { revealed = null; return; }
        if (Note is null || revealing) return;
        revealing = true;
        revealError = null;
        try { revealed = (await Notes.RevealSecretAsync(Note.UsefulInformationNoteId)).Secret; }
        catch { revealError = "Couldn't reveal the credential. Please try again."; }
        finally { revealing = false; }
    }
}
