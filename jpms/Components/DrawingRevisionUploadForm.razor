@inject IDrawingStore DrawingStore

@* Uploads a new revision straight into a known drawing (unlike DrawingUploadForm, which
   resolves the drawing by code from the register). Used on the drawing detail page. Only the
   file is required — the revision label and issuer can be added later. *@
<EditForm Model="this" OnValidSubmit="HandleUpload"
      class="border border-line bg-surface p-5 space-y-3">

    <div>
        <FormField Label="New version file" Required>
        <InputFile OnChange="OnFileSelected" class="w-full text-sm text-content-muted" />
        </FormField>
        @if (selectedFile is not null)
        {
            <p class="mt-2 rounded border border-line bg-surface-raised px-3 py-2 text-sm text-content">
                <span class="eyebrow mr-2">Original file</span>
                <span class="font-medium break-all">@selectedFile.Name</span>
                <span class="text-content-subtle"> · @FormatSize(selectedFile.Size)</span>
            </p>
        }
    </div>

    <div>
        <FormField Label="Revision">
        <input type="text" @bind="revisionLabel" placeholder="B (optional)" class="field" />
        </FormField>
    </div>

    <div>
        <FormField Label="Issued by">
        <input type="email" @bind="issuedBy" placeholder="architect@example.com (optional)" class="field" />
        </FormField>
    </div>

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }

    <p class="text-xs text-content-subtle">New uploads are saved as <span class="font-medium">Unapproved</span>. They become the latest version of the document only once approved.</p>

    <button type="submit" disabled="@busy"
            class="btn-primary w-full">
        @(busy ? "Uploading…" : "Upload revision")
    </button>
</EditForm>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter, EditorRequired] public string DrawingId { get; set; } = "";
    [Parameter] public EventCallback OnUploaded { get; set; }

    private IBrowserFile? selectedFile;
    private string revisionLabel = "";
    private string issuedBy = "";
    private bool busy;
    private string? error;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        error = null;
        if (string.IsNullOrWhiteSpace(revisionLabel))
        {
            var extracted = ExtractRevisionLabel(selectedFile.Name);
            if (extracted.Length > 0) revisionLabel = extracted;
        }
    }

    private async Task HandleUpload()
    {
        if (selectedFile is null) { error = "Choose a file to upload."; return; }

        busy = true;
        error = null;
        try
        {
            await DrawingStore.UploadRevisionAsync(
                ProjectId, DrawingId, revisionLabel.Trim().ToUpperInvariant(), issuedBy.Trim(), selectedFile, CancellationToken.None);

            // Wait for the revision list to reload before clearing the form, so the new version
            // is on screen the moment "Uploading…" ends — not after a page refresh.
            await DrawingStore.RefreshNowAsync(ProjectId, DrawingId, CancellationToken.None);

            selectedFile = null; revisionLabel = ""; issuedBy = "";
            await OnUploaded.InvokeAsync();
        }
        catch (Exception ex)
        {
            error = $"Upload failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static string ExtractRevisionLabel(string fileName)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            fileName, @"[_-]Rev[_-]?([A-Za-z0-9]+)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return match.Success ? match.Groups[1].Value.ToUpperInvariant() : "";
    }

}
