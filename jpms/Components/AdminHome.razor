@inject IUserDirectory UserDirectory
@inject IAccessRequestStore Requests
@implements IDisposable

<section class="px-6 py-6 md:px-8">

    <header class="mb-6 md:mb-8">
        <h1 class="eyebrow mb-1">JPMS · Administrator</h1>
        <p class="text-[10px] text-content-subtle break-all leading-snug">You are signed in as @CurrentUser.Email</p>
    </header>

    <AdminStatsRow />

    @* An admin carries every role server-side, so this page shows both halves of the job: the real
       project work first, then the user-administration panels. It used to end on WhatsNextPanel —
       a hard-coded engineering backlog with no data behind it, which is not something anybody
       administering the system can act on. *@
    <div class="space-y-6 mb-6">
        @* Open to-do items assigned to this administrator — general and project items alike. *@
        <MyTodosPanel />
        <OpenRequestsPanel />
        <NextValuationsPanel />
    </div>

    <PendingRequestsPanel />
    <ApprovedUsersPanel CurrentUserEmail="@CurrentUser.Email" />

</section>

@code {
    [Parameter, EditorRequired] public AuthenticatedUser CurrentUser { get; set; } = default!;

    protected override void OnInitialized()
    {
        UserDirectory.OnChange += StateHasChanged;
        Requests.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        UserDirectory.OnChange -= StateHasChanged;
        Requests.OnChange -= StateHasChanged;
    }
}
