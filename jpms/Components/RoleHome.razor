@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Projects
@using Jewel.JPMS.Features.Requests
@using Jewel.JPMS.Features.Subcontractors
@using Jewel.JPMS.Features.Xero
@inject ComplianceOverviewReadModel Compliance
@inject ProjectListReadModel Projects
@inject CurrentProjectService CurrentProject
@inject RfiRegisterReadModel Rfis
@inject IRateLibrary Rates
@inject XeroLedgerReadModel XeroLedger
@inject IIntakeQueue Intake
@implements IDisposable

@*
    The landing page for every internal role.

    It used to be the sidebar redrawn as tiles, plus a "you are signed in as…" line and two stat
    tiles that never changed. A PM, QS, H&S officer or director landed on nothing they could act
    on. This version leads with work: a count strip of the things that are actually late or
    waiting, then the queues themselves, and only then the navigation cards — which are still
    useful, just not the point of the page.

    Everything here reads from stores and queries that already existed (the cross-project RFI
    register, the to-do list, the project list's valuation dates, the rate library's staleness
    check, the allocation page's tab-bar counts, the triage queue's live inbox total). No new
    backend query was needed, so nothing here can drift from the registers it summarises.
*@

<div>

    <PageHeader Eyebrow="@Role.DisplayName()" Subtitle="@RoleBrief">
        <TitleContent>@Greeting, @FirstName.</TitleContent>
    </PageHeader>

    @if (Tiles.Count > 0)
    {
        @* The count strip: only the things that are late, waiting or need a decision. A zero is
           worth showing — "nothing overdue" is information — but a metric that doesn't apply to
           this role is left out entirely rather than rendered as a dash. *@
        <div class="grid grid-cols-2 @(Tiles.Count >= 4 ?"lg:grid-cols-4" : "lg:grid-cols-3") gap-3 md:gap-4 mb-8">
            @foreach (var tile in Tiles)
            {
                <a href="@tile.Href" class="panel p-5 hover:border-line-strong hover:bg-surface-raised transition">
                    <MetricStat Label="@tile.Label" Value="@tile.Value"
                                DeltaLabel="@tile.Note" IsDeltaPositive="@(!tile.IsBad)" />
                </a>
            }
        </div>
    }

    <div class="space-y-6 mb-10">
        @if (ShowMyDay)
        {
            @* Site-floor roles do their day here: sign in, hours against cost codes, and any
               timesheet sent back for correction. *@
            <MyDayWorkspace />
        }

        @if (ShowMyTodos)
        {
            @* Open to-dos assigned to any role this user holds — general and project alike.
               (Mirrors TodoRoles.AssignableAsTodoAssignee; site-floor and external roles carry
               none, so they never see an empty panel.) The panel owns the fetch and hands the
               open items up, so the count tiles above and the rows here are one read. *@
            <MyTodosPanel OnOpenItemsChanged="items => openTodos = items" />
        }

        @if (ShowRequests)
        {
            <OpenRequestsPanel />
        }

        @if (ShowValuations)
        {
            @* Which valuations are coming up or overdue across every project — the dates
               themselves are set on each project's Setup tab. *@
            <NextValuationsPanel />
        }

        @if (ShowExpiringDocuments)
        {
            @* Subcontractor compliance documents expired or inside 30 days, across the whole
               directory — insurance above all. The panel owns the fetch; the count tile above
               reads the same snapshot, so the two can never disagree. *@
            <ExpiringDocumentsPanel />
        }

        @if (ShowStaleRates)
        {
            <div class="panel p-5">
                <div class="flex items-center justify-between gap-2 mb-1">
                    <div class="flex items-center gap-3">
                        <h2 class="text-sm font-semibold text-content">Rates needing a review</h2>
                        @if (StaleRateCount > 0)
                        {
                            <span class="text-xs font-medium text-negative">@StaleRateCount stale</span>
                        }
                    </div>
                    <a href="/rate-library/stale" class="text-xs font-medium text-accent hover:underline">View all</a>
                </div>
                <p class="text-xs text-content-subtle">
                    Library rates not re-checked in @StaleRateThresholdDays days. Pricing a tender or a
                    variation off a stale rate is how margin quietly disappears.
                </p>
                @if (StaleRateCount == 0)
                {
                    <p class="text-sm text-content-subtle italic mt-3">Every rate has been reviewed recently.</p>
                }
            </div>
        }
    </div>

    <h2 class="text-sm font-medium text-content-muted mb-3">Where to next</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
        @foreach (var destination in Destinations)
        {
            <a href="@destination.Href"
               class="panel p-5 flex items-center gap-3 hover:border-line-strong hover:bg-surface-raised transition">
                <NavIcon Route="@destination.IconKey" Class="w-5 h-5 text-accent shrink-0" />
                <span class="text-base font-medium text-content">@destination.Label</span>
            </a>
        }
    </div>

</div>

