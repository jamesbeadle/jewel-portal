@using Jewel.JPMS.Features.Commercial
@using Jewel.JPMS.Features.Projects
@inject ICommandSender Commands
@inject IQueryClient Queries
@inject ValuationLinesReadModel ValuationLines
@inject ProjectListReadModel Projects
@inject NavigationManager Nav
@inject AuthService Auth
@inject IWorkOrderAttachmentStore WorkOrderAttachments

@* Raises (or edits) a work order through WorkOrderForm — the shared core-order component the
   Control Centre's System Actions pane also hosts — with this modal owning everything AROUND the
   order: the optional reconciliation package matched against the valuation sales lines, the
   record-keeping attachments, and the released order's automatic purchase-order email. Editing
   covers manual orders for the whole team and ANY order for the MD/FD/administrators (the API
   enforces the split); saving an edit never re-emails the supplier.
 *@
<Modal IsOpen="IsOpen"
       Title="@(IsEditing ? Editing!.Order.IsDraft ? "Edit draft work order" : $"Edit work order {EditingReference}" : "Add work order")"
       ConfirmLabel="@(busy ? "Saving…" : IsEditing ? "Save changes" : FormSaveAsDraft ? "Save draft" : createPackage && pickedAmounts.Count > 0 ? "Save order + package" : "Save order")"
       ConfirmDisabled="@(busy || form is null || !form.CanSave)"
       OnConfirm="SaveAsync"
       OnCancel="OnClose"
       Class="max-w-6xl">
    <div class="space-y-4">
        <WorkOrderForm @ref="form" ProjectId="@ProjectId" Busy="@busy" Editing="@Editing"
                       DraftTickLocked="@(createdOrder is not null)" OnChanged="HandleFormChanged" />

        @* ── Attachments: record keeping only — never sent to the supplier ───── *@
        <div class="rounded border border-line bg-surface p-3">
            <div class="flex items-center justify-between gap-3 mb-1">
                <p class="eyebrow"
                   title="Kept on the order for the office's records — the quote it rests on, a signed copy, photos. Never emailed to the supplier and never printed on the purchase order">
                    Attachments — record keeping
                </p>
                <label class="btn-secondary text-xs cursor-pointer @(busy ?"opacity-50 pointer-events-none" : "")">
                    Add files
                    <InputFile OnChange="OnAttachmentFilesSelected" multiple class="hidden" />
                </label>
            </div>
            <p class="text-xs text-content-subtle">
                Stored on the order for the office's records — never sent to the supplier.@(IsEditing ? "" : " Files upload when you save the order.")
            </p>
            @if (existingAttachments.Count > 0)
            {
                <ul class="mt-2 space-y-1">
                    @foreach (var attachment in existingAttachments)
                    {
                        <li class="flex items-center gap-2 text-sm text-content">
                            <a class="text-accent hover:underline truncate"
                               href="@WorkOrderAttachments.FileUrl(Editing!.Order.WorkOrderId, attachment.WorkOrderAttachmentId)"
                               target="_blank" rel="noopener" title="@attachment.DisplayName">@attachment.DisplayName</a>
                            <span class="text-xs text-content-subtle whitespace-nowrap">@(attachment.Source == WorkOrderAttachmentSource.Email ? "from email" : attachment.Source == WorkOrderAttachmentSource.Chat ? "from chat" : "uploaded")</span>
                            <button type="button" class="ml-auto text-xs text-content-subtle hover:text-negative"
                                    disabled="@busy" @onclick="() => RemoveExistingAttachmentAsync(attachment)">Remove</button>
                        </li>
                    }
                </ul>
            }
            @if (stagedAttachmentFiles.Count > 0)
            {
                <ul class="mt-2 space-y-1">
                    @foreach (var file in stagedAttachmentFiles.ToList())
                    {
                        var staged = file;
                        <li class="flex items-center gap-2 text-sm text-content">
                            <span class="truncate">@staged.Name</span>
                            <span class="text-xs text-content-subtle whitespace-nowrap">@FormatBytes(staged.Size)</span>
                            <button type="button" aria-label="Remove this file" class="ml-auto text-xs text-content-subtle hover:text-negative"
                                    disabled="@busy" @onclick="() => stagedAttachmentFiles.Remove(staged)">Remove</button>
                        </li>
                    }
                </ul>
            }
            @if (attachmentError is not null)
            {
                <p class="text-xs text-negative mt-2">@attachmentError</p>
            }
        </div>

        @* ── Optional: package the order against its sales lines right away ──
           Creation only (and never for a draft — packages carry approved scope, and a
           draft hasn't been approved yet): an existing order's packaging lives in the
           Packages section. *@
        @if (!IsEditing && !FormSaveAsDraft)
        {
        <div class="rounded border border-line bg-surface p-3">
            <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none mb-2">
                <input type="checkbox" class="cursor-pointer align-middle" disabled="@busy" @bind="createPackage" />
                Create a reconciliation package with this order
            </label>
            @if (createPackage)
            {
                <div class="mb-2">
                    <FormField Label="Package name">
                    <input type="text" maxlength="128" placeholder="e.g. BVMH groundworks &amp; civils"
                           class="field"
                           disabled="@busy" @bind="packageName" @bind:event="oninput" />
                    </FormField>
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="eyebrow"
                       title="Tick a line to take its full remaining value; edit the amount for a partial share when a client line covers more than one sub">
                        Sales side — valuation lines
                    </p>
                    <SearchInput @bind-Value="lineSearch" Placeholder="Search…" Width="w-36" />
                </div>
                <div class="overflow-y-auto max-h-60 space-y-1">
                    @foreach (var entry in FilteredSalesLines)
                    {
                        var salesLine = entry.Line;
                        var picked = pickedAmounts.ContainsKey(salesLine.ValuationLineItemId);
                        var exhausted = !picked && entry.Available == 0m;
                        <div class="flex items-center gap-2 text-sm @(exhausted ?"opacity-50" : "")">
                            <input type="checkbox" class="cursor-pointer" disabled="@(busy || exhausted)"
                                   title="@(exhausted ? "Fully assigned to other packages" : "")"
                                   checked="@picked"
                                   @onchange="() => ToggleSalesLine(entry)" />
                            <span class="font-mono text-xs text-content-subtle whitespace-nowrap" title="@RefTitle(salesLine)">@Ref(salesLine)</span>
                            <span class="text-content-muted truncate" title="@DescriptionFor(salesLine)">@DescriptionFor(salesLine)</span>
                            <span class="ml-auto flex items-center gap-1.5 whitespace-nowrap">
                                @if (picked)
                                {
                                    <input type="number" step="any"
                                           class="field text-right text-xs w-24"
                                           title="@($"This package's share — {Money(entry.Available)} of the line's {Money(salesLine.LineAmount)} is available")"
                                           disabled="@busy"
                                           value="@pickedAmounts[salesLine.ValuationLineItemId]"
                                           @onchange="e => SetSalesAmount(salesLine.ValuationLineItemId, e.Value?.ToString())" />
                                }
                                else
                                {
                                    <span class="text-content-muted text-xs">@Money(entry.Available) avail.</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="rounded border border-line bg-surface-raised px-3 py-2 mt-2 text-sm flex flex-wrap items-center gap-x-6 gap-y-1">
                    <span class="text-content-muted">Sales <span class="text-content font-medium">@Money(SalesTotal)</span></span>
                    <span class="text-content-muted">Target cost (÷@DivisorText) <span class="text-content font-medium">@Money(TargetTotal)</span></span>
                    <span class="text-content-muted">Order value <span class="text-content font-medium">@Money(OrderTotal)</span></span>
                    <span class="@(Difference < 0m ?"text-negative" : "text-content-muted")"
                          title="Target cost less the order's value — a large gap either way suggests the scope on the two sides doesn't match yet">
                        Difference <span class="font-medium">@Money(Difference)</span>
                    </span>
                </div>
            }
        </div>
        }

        @if (PackageValidationError is not null)
        {
            <p class="text-sm text-negative">@PackageValidationError</p>
        }
        @if (saveError is not null)
        {
            <p class="text-sm text-negative">@saveError</p>
        }
    </div>
</Modal>

@* The no-matching-sale guardrail — stacks over the form when a line's cost centre has no
   priced valuation report line. Confirming resumes the save with the override acknowledged. *@
<WorkOrderSaleWarningDialog IsOpen="saleWarningOpen" Busy="busy" Codes="uncoveredCostCentres"
                            OnConfirm="ConfirmSaleWarningAsync" OnCancel="CancelSaleWarning" />
