@using Jewel.JPMS.Contracts.Commercial
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Commercial
@using Jewel.JPMS.Features.Subcontractors
@using Jewel.JPMS.Models
@inject ICommandSender Commands
@inject IQueryClient Queries
@inject SubcontractorsReadModel Subcontractors
@inject CostCentersReadModel CostCenters
@inject ValuationLinesReadModel ValuationLines
@inject AuthService Auth

@* Raises a work order directly — no bid package, no tender — and, in the same act,
   matches it against the valuation sales lines that priced its scope, creating a
   reconciliation package with the order already assigned. For commitments made outside
   the tendering flow. The package step is optional: untick it to just raise the order.
   With Editing set, the same form edits a manually raised order wholesale instead —
   supplier, title, scope and priced lines — without the packaging step. *@
<Modal IsOpen="IsOpen"
       Title="@(IsEditing ? Editing!.Order.IsDraft ? "Edit draft work order" : $"Edit work order {EditingReference}" : "Add work order")"
       ConfirmLabel="@(busy ? "Saving…" : IsEditing ? "Save changes" : saveAsDraft ? "Save draft" : createPackage && pickedAmounts.Count > 0 ? "Save order + package" : "Save order")"
       ConfirmDisabled="@(busy || !CanSave)"
       OnConfirm="SaveAsync"
       OnCancel="OnClose"
       Class="max-w-6xl">
    <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subcontractor</label>
                <select class="w-full bg-surface border border-line-strong rounded-lg px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                        disabled="@busy" @onchange="e => SetSubcontractor(e.Value?.ToString())">
                    <option value="" selected="@(subcontractorId == "")">Choose a subcontractor…</option>
                    @foreach (var sub in SortedSubcontractors)
                    {
                        <option value="@sub.SubcontractorId" selected="@(subcontractorId == sub.SubcontractorId)">@sub.CompanyName</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Order title</label>
                <input type="text" maxlength="256" placeholder="e.g. Groundworks package — BVMH"
                       class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                       disabled="@busy" @bind="title" @bind:event="oninput" />
            </div>
        </div>
        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Scope</label>
            <textarea rows="2" maxlength="4000" placeholder="What the order instructs (optional)"
                      class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                      disabled="@busy" @bind="scope" @bind:event="oninput"></textarea>
        </div>

        @* ── Programme: printed in the purchase order's Programme section ──── *@
        <div class="rounded-lg border border-line bg-surface p-3">
            <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2"
               title="Printed in the purchase order's Programme section — leave everything empty to omit it">Programme</p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Start date</label>
                    <input type="date"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                           disabled="@busy" @bind="programmeStart" />
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Target completion</label>
                    <input type="date"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                           disabled="@busy" @bind="targetCompletion" />
                </div>
            </div>
            <div class="mt-3">
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Programme notes</label>
                <textarea rows="2" maxlength="2000" placeholder="e.g. Weekly programme duration 1st &amp; 2nd fix phases (optional)"
                          class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                          disabled="@busy" @bind="programmeNotes" @bind:event="oninput"></textarea>
            </div>
        </div>

        @* ── Priced lines: each carries its own cost centre ────────────────── *@
        <div class="rounded-lg border border-line bg-surface p-3">
            <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2"
               title="Each line lands on its own cost centre — the order's value is their sum">Priced lines</p>
            <div class="space-y-2">
                @for (var index = 0; index < lines.Count; index++)
                {
                    var lineIndex = index;
                    var line = lines[lineIndex];
                    <div>
                    <div class="flex items-center gap-2 mb-1">
                        @* Typed-to-find, like every other cost-centre picker (valuation lines,
                           variation approval, Xero allocation): the master runs to hundreds of
                           codes, so scrolling a native select is the wrong instrument. *@
                        <SearchSelect Options="@CostCentreOptionsFor(line)" WidthClass="w-64"
                                      Placeholder="Cost centre…" Disabled="@busy"
                                      InputClass="bg-surface border border-line px-2 py-1.5"
                                      Value="@line.CostCode" ValueChanged="value => SetLineCode(line, value)" />
                        <input type="text" maxlength="256" placeholder="What this line covers" disabled="@busy"
                               class="bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm flex-1"
                               value="@line.Title"
                               @onchange="e => SetLineTitle(line, e.Value?.ToString())" />
                        <input type="number" step="any" placeholder="Amount £" disabled="@busy"
                               class="bg-surface border border-line rounded-lg px-2 py-1.5 text-right text-content text-sm w-32"
                               title="@(line.PaidToDate != 0m ? $"{Money(line.PaidToDate)} already paid against this line — the amount can't drop below that" : "")"
                               value="@line.AmountText"
                               @onchange="e => SetLineAmount(line, e.Value?.ToString())" />
                        <button type="button" aria-label="Remove this line"
                                disabled="@(busy || lines.Count == 1 || line.PaidToDate != 0m)"
                                title="@(line.PaidToDate != 0m ? $"{Money(line.PaidToDate)} already paid against this line — it can't be removed" : "")"
                                class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-negative hover:bg-surface-raised"
                                @onclick="() => lines.RemoveAt(lineIndex)">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        </button>
                    </div>
                    @* The longer detail printed in the PO items table's Description column — optional,
                       so the title above can stay a short label instead of carrying the whole scope
                       (titles cap at 256 characters and are cut off beyond that). *@
                    <textarea rows="2" maxlength="1024" placeholder="Description — the full detail printed on the purchase order (optional)"
                              disabled="@busy"
                              class="w-full bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm placeholder:text-content-subtle"
                              value="@line.Description"
                              @onchange="e => SetLineDescription(line, e.Value?.ToString())"></textarea>
                    </div>
                }
            </div>
            <div class="flex items-center justify-between mt-2">
                <button type="button" disabled="@busy" @onclick="() => lines.Add(new LineRow())"
                        class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4">
                    + Add another line
                </button>
                <span class="text-sm text-content-muted">Order value <span class="text-content font-medium">@Money(OrderTotal)</span></span>
            </div>
        </div>

        @* ── Deposit: printed at the foot of the purchase order when required ─
           Percentage only — the business records the share of the order value,
           never a £ figure. *@
        <div class="rounded-lg border border-line bg-surface p-3">
            <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none"
                   title="Tick when the subcontractor requires a deposit — the percentage prints at the foot of the purchase order">
                <input type="checkbox" class="cursor-pointer align-middle" disabled="@busy" @bind="depositRequired" />
                Deposit required
            </label>
            @if (depositRequired)
            {
                <div class="mt-2 flex items-center gap-2">
                    <input type="number" step="any" min="0" max="100" placeholder="%" disabled="@busy"
                           class="bg-surface border border-line rounded-lg px-2 py-1.5 text-right text-content text-sm w-24"
                           value="@depositPercentText"
                           @onchange="e => SetDepositPercent(e.Value?.ToString())" />
                    <span class="text-sm text-content-muted">% of the order value</span>
                </div>
            }
        </div>

        @* ── Draft or release: a draft sits unnumbered and uncommitted until released ── *@
        @if (!IsEditing)
        {
        @* Locked once the order itself has saved (the package-retry path): the order is
           already issued by then, so "save as draft" would be a claim the save can't keep. *@
        <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none"
               title="A draft is stored without a number and is invisible to the supplier — though its value counts in the Financials tab's committed figures — until someone approves or rejects it from the Work Orders tab">
            <input type="checkbox" class="cursor-pointer align-middle" disabled="@(busy || createdOrder is not null)" @bind="saveAsDraft" />
            Save as a draft — needs approval before it's issued
        </label>
        }

        @* ── Optional: package the order against its sales lines right away ──
           Creation only (and never for a draft — packages carry approved scope, and a
           draft hasn't been approved yet): an existing order's packaging lives in the
           Packages section. *@
        @if (!IsEditing && !saveAsDraft)
        {
        <div class="rounded-lg border border-line bg-surface p-3">
            <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none mb-2">
                <input type="checkbox" class="cursor-pointer align-middle" disabled="@busy" @bind="createPackage" />
                Create a reconciliation package with this order
            </label>
            @if (createPackage)
            {
                <div class="mb-2">
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Package name</label>
                    <input type="text" maxlength="128" placeholder="@(string.IsNullOrWhiteSpace(title) ? "e.g. BVMH groundworks & civils" : title)"
                           class="w-full md:w-1/2 rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:border-accent"
                           disabled="@busy" @bind="packageName" @bind:event="oninput" />
                </div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold"
                       title="Tick a line to take its full remaining value; edit the amount for a partial share when a client line covers more than one sub">
                        Sales side — valuation lines
                    </p>
                    <input type="search" placeholder="Search…"
                           class="bg-surface border border-line rounded-lg px-2 py-1 text-xs text-content placeholder:text-content-subtle w-36"
                           @bind="lineSearch" @bind:event="oninput" />
                </div>
                <div class="overflow-y-auto max-h-60 space-y-1">
                    @foreach (var entry in FilteredSalesLines)
                    {
                        var salesLine = entry.Line;
                        var picked = pickedAmounts.ContainsKey(salesLine.ValuationLineItemId);
                        var exhausted = !picked && entry.Available == 0m;
                        <div class="flex items-center gap-2 text-sm @(exhausted ? "opacity-50" : "")">
                            <input type="checkbox" class="cursor-pointer" disabled="@(busy || exhausted)"
                                   title="@(exhausted ? "Fully assigned to other packages" : "")"
                                   checked="@picked"
                                   @onchange="() => ToggleSalesLine(entry)" />
                            <span class="font-mono text-[11px] text-content-subtle whitespace-nowrap" title="@RefTitle(salesLine)">@Ref(salesLine)</span>
                            <span class="text-content-muted truncate" title="@DescriptionFor(salesLine)">@DescriptionFor(salesLine)</span>
                            <span class="ml-auto flex items-center gap-1.5 whitespace-nowrap">
                                @if (picked)
                                {
                                    <input type="number" step="any"
                                           class="bg-surface border border-line rounded-lg px-2 py-0.5 text-right text-content text-xs w-24"
                                           title="@($"This package's share — {Money(entry.Available)} of the line's {Money(salesLine.LineAmount)} is available")"
                                           disabled="@busy"
                                           value="@pickedAmounts[salesLine.ValuationLineItemId]"
                                           @onchange="e => SetSalesAmount(salesLine.ValuationLineItemId, e.Value?.ToString())" />
                                }
                                else
                                {
                                    <span class="text-content-muted text-xs">@Money(entry.Available) avail.</span>
                                }
                            </span>
                        </div>
                    }
                </div>
                <div class="rounded-lg border border-line bg-surface-raised px-3 py-2 mt-2 text-sm flex flex-wrap items-center gap-x-6 gap-y-1">
                    <span class="text-content-muted">Sales <span class="text-content font-medium">@Money(SalesTotal)</span></span>
                    <span class="text-content-muted">Target cost (÷@DivisorText) <span class="text-content font-medium">@Money(TargetTotal)</span></span>
                    <span class="text-content-muted">Order value <span class="text-content font-medium">@Money(OrderTotal)</span></span>
                    <span class="@(Difference < 0m ? "text-negative" : "text-content-muted")"
                          title="Target cost less the order's value — a large gap either way suggests the scope on the two sides doesn't match yet">
                        Difference <span class="font-medium">@Money(Difference)</span>
                    </span>
                </div>
            }
        </div>
        }

        @if (ClientValidationError is not null)
        {
            <p class="text-sm text-negative">@ClientValidationError</p>
        }
        @if (saveError is not null)
        {
            <p class="text-sm text-negative">@saveError</p>
        }
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string ProjectId { get; set; } = "";

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after a successful save so hosts can refresh their stores.</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    /// <summary>The order being edited, with its lines — null when raising a new order.
    /// Only manually raised orders (Order.IsManual) may be passed here.</summary>
    [Parameter] public ProjectWorkOrderDetail? Editing { get; set; }

    private bool IsEditing => Editing is not null;
    private string EditingReference => Editing?.Order.Reference ?? "";

    private sealed class LineRow
    {
        // Ties the row to an existing line so its paid-to-date and invoice history
        // survive the edit; null for rows added in this session.
        public string? WorkOrderLineId { get; set; }
        public decimal PaidToDate { get; set; }
        public string CostCode { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string AmountText { get; set; } = "";
    }

    private string subcontractorId = "";
    private string title = "";
    private string scope = "";
    // Programme (all optional): date-only inputs, sent as UTC dates like other date pickers.
    private DateTime? programmeStart;
    private DateTime? targetCompletion;
    private string programmeNotes = "";
    private List<LineRow> lines = new() { new LineRow() };
    // Deposit the supplier requires — percentage of the order value only, printed at the
    // foot of the purchase order. The text field is parsed like the line amounts.
    private bool depositRequired;
    private string depositPercentText = "";
    private bool createPackage = true;
    // Store the order as an unnumbered draft rather than releasing it (creation only).
    private bool saveAsDraft;
    private string packageName = "";
    private string lineSearch = "";
    // Sales line id → this package's £ share, as typed (invariant decimal text).
    private readonly Dictionary<string, string> pickedAmounts = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ReconciliationPackage> allPackages = Array.Empty<ReconciliationPackage>();

    private bool seeded;
    private bool busy;
    private string? saveError;
    // Set once the order itself has saved, so a package failure can be retried
    // without raising a duplicate order.
    private WorkOrder? createdOrder;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            seeded = false;
            return;
        }
        if (seeded) return;
        seeded = true;
        if (Editing is not null)
        {
            subcontractorId = Editing.Order.SubcontractorId;
            title = Editing.Order.Title;
            scope = Editing.Order.Scope;
            programmeStart = Editing.Order.ProgrammeStart?.LocalDateTime.Date;
            targetCompletion = Editing.Order.ScheduledCompletion?.LocalDateTime.Date;
            programmeNotes = Editing.Order.ProgrammeNotes;
            lines = Editing.Lines
                .OrderBy(line => line.SortOrder)
                .Select(line => new LineRow
                {
                    WorkOrderLineId = line.WorkOrderLineId,
                    PaidToDate = line.PaidToDate,
                    CostCode = line.CostCode,
                    Title = line.Title,
                    Description = line.Description,
                    AmountText = line.LineTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)
                })
                .ToList();
            if (lines.Count == 0) lines = new List<LineRow> { new LineRow() };
            depositRequired = Editing.Order.DepositRequired;
            depositPercentText = Editing.Order.DepositPercent?
                .ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
            createPackage = false;
        }
        else
        {
            subcontractorId = "";
            title = "";
            scope = "";
            programmeStart = null;
            targetCompletion = null;
            programmeNotes = "";
            lines = new List<LineRow> { new LineRow() };
            depositRequired = false;
            depositPercentText = "";
            createPackage = true;
        }
        saveAsDraft = false;
        packageName = "";
        lineSearch = "";
        pickedAmounts.Clear();
        saveError = null;
        createdOrder = null;
        // Freshen everything the pickers show; cached values render immediately. Editing
        // has no packaging step, so the sales-side lookups are only needed when raising.
        if (IsEditing)
        {
            await Task.WhenAll(
                Subcontractors.RefreshAsync(CancellationToken.None),
                CostCenters.RefreshAsync(CancellationToken.None));
            return;
        }
        var packagesTask = Queries.AskAsync(new ListReconciliationPackagesForProject(ProjectId), CancellationToken.None);
        await Task.WhenAll(
            Subcontractors.RefreshAsync(CancellationToken.None),
            CostCenters.RefreshAsync(CancellationToken.None),
            ValuationLines.RefreshAsync(ProjectId, CancellationToken.None));
        allPackages = await packagesTask;
    }

    private IEnumerable<Subcontractor> SortedSubcontractors =>
        (Subcontractors.Current ?? Array.Empty<Subcontractor>())
            .OrderBy(sub => sub.CompanyName, StringComparer.OrdinalIgnoreCase);

    private static decimal? Parse(string text) =>
        decimal.TryParse(text, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? value
            : null;

    private decimal OrderTotal => lines.Sum(line => Parse(line.AmountText) ?? 0m);

    // Counting sales lines with how much of each is still available to this new package
    // (the line's value less what existing packages have taken).
    private List<(ValuationLineItem Line, decimal Available)> FilteredSalesLines
    {
        get
        {
            var taken = allPackages
                .SelectMany(package => package.SalesLines)
                .GroupBy(slice => slice.ValuationLineItemId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.Sum(slice => slice.Amount), StringComparer.OrdinalIgnoreCase);
            return ValuationLines.Current(ProjectId)
                .Where(line => line.CountsTowardTotals && line.LineAmount != 0m)
                .Where(line => string.IsNullOrWhiteSpace(lineSearch)
                               || line.Description.Contains(lineSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                               || line.CostCode.Contains(lineSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                               || line.SectionName.Contains(lineSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                               || line.VariationRef.Contains(lineSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                               || line.VariationTitle.Contains(lineSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .Select(line => (Line: line,
                    Available: line.LineAmount - (taken.TryGetValue(line.ValuationLineItemId, out var amount) ? amount : 0m)))
                .OrderBy(entry => entry.Line.CostCode, StringComparer.OrdinalIgnoreCase)
                .ThenBy(entry => entry.Line.DisplayOrder)
                .ToList();
        }
    }

    // The label carries code + name so typing matches either ("kit" finds CARP-KIT Carpentry
    // kitchens; "SUB" finds every subcontract centre) — same convention as the Xero allocation
    // page and the valuation line form. Cached against the read model's own list so the
    // per-line lookup below doesn't rebuild it for every row on every render.
    private IReadOnlyList<SearchSelect.Option>? costCentreOptionsCache;
    private object? costCentreOptionsCacheKey;

    private IReadOnlyList<SearchSelect.Option> CostCentreOptions
    {
        get
        {
            var centres = CostCenters.Alphabetical;
            if (costCentreOptionsCache is null || !ReferenceEquals(costCentreOptionsCacheKey, centres))
            {
                costCentreOptionsCache = centres
                    .Select(centre => new SearchSelect.Option(centre.Code, $"{centre.Code} {centre.Name}"))
                    .ToList();
                costCentreOptionsCacheKey = centres;
            }
            return costCentreOptionsCache;
        }
    }

    // An order being edited can carry a code the master no longer offers — the centre was retired
    // after the order was raised. Lead the list with the stored value so the picker shows the code
    // the line actually sits on; a blank control would read as "no cost centre" and the save
    // validation would then block an edit that never touched that line.
    private IReadOnlyList<SearchSelect.Option> CostCentreOptionsFor(LineRow line)
    {
        var options = CostCentreOptions;
        if (line.CostCode == "" || options.Any(option => option.Value == line.CostCode)) return options;
        var master = options.FirstOrDefault(option =>
            string.Equals(option.Value, line.CostCode, StringComparison.OrdinalIgnoreCase));
        var withCurrent = new List<SearchSelect.Option>(options.Count + 1)
        {
            new(line.CostCode, master?.Label ?? $"{line.CostCode} (retired)")
        };
        withCurrent.AddRange(options.Where(option => !ReferenceEquals(option, master)));
        return withCurrent;
    }

    private void SetSubcontractor(string? value) => subcontractorId = value ?? "";
    private static void SetLineCode(LineRow line, string? value) => line.CostCode = value ?? "";
    private static void SetLineTitle(LineRow line, string? value) => line.Title = value ?? "";
    private static void SetLineDescription(LineRow line, string? value) => line.Description = value ?? "";
    private static void SetLineAmount(LineRow line, string? value) => line.AmountText = value ?? "";
    private void SetSalesAmount(string lineItemId, string? value) => pickedAmounts[lineItemId] = value ?? "";
    private void SetDepositPercent(string? value) => depositPercentText = value ?? "";

    private void ToggleSalesLine((ValuationLineItem Line, decimal Available) entry)
    {
        if (pickedAmounts.Remove(entry.Line.ValuationLineItemId)) return;
        // Whole-line default: the full remaining value; edit the amount for a partial share.
        pickedAmounts[entry.Line.ValuationLineItemId] =
            entry.Available.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private decimal SalesTotal => pickedAmounts.Values.Sum(text => Parse(text) ?? 0m);
    private decimal TargetTotal => Math.Round(SalesTotal * FinancialSummaryAssumptions.CostFactor, 2);
    private decimal Difference => TargetTotal - OrderTotal;

    private static string DivisorText =>
        $"{1m + FinancialSummaryAssumptions.MarkupPercent / 100m:0.##}";

    private string? ClientValidationError
    {
        get
        {
            var filledLines = lines.Where(line =>
                line.CostCode != "" || !string.IsNullOrWhiteSpace(line.Title) || !string.IsNullOrWhiteSpace(line.AmountText)).ToList();
            if (filledLines.Any(line => line.CostCode == "")) return "Choose a cost centre for every line.";
            if (filledLines.Any(line => string.IsNullOrWhiteSpace(line.Title))) return "Every line needs a title.";
            if (filledLines.Any(line => Parse(line.AmountText) is not { } amount || amount == 0m))
                return "Every line needs a non-zero amount.";
            if (depositRequired && (Parse(depositPercentText) is not { } depositPercent
                                    || depositPercent <= 0m || depositPercent > 100m))
                return "A required deposit needs a percentage above 0 and no more than 100.";
            // A paid line anchors the Financials tab's paid figures: its amount can
            // change, but never below what has already been paid against it.
            foreach (var line in filledLines.Where(line => line.PaidToDate != 0m))
            {
                if (Parse(line.AmountText) is { } amount && Math.Abs(amount) < Math.Abs(line.PaidToDate))
                    return $"\"{Truncate(line.Title, 40)}\" — {Money(line.PaidToDate)} has been paid against this line; its amount can't drop below that.";
            }
            if (createPackage && !IsEditing && !saveAsDraft)
            {
                if (pickedAmounts.Values.Any(text => Parse(text) is not { } amount || amount == 0m))
                    return "Every ticked sales line needs a non-zero amount.";
                var linesById = ValuationLines.Current(ProjectId)
                    .ToDictionary(line => line.ValuationLineItemId, StringComparer.OrdinalIgnoreCase);
                foreach (var picked in pickedAmounts)
                {
                    if (!linesById.TryGetValue(picked.Key, out var salesLine)) continue;
                    var amount = Parse(picked.Value)!.Value;
                    if (Math.Sign(amount) != Math.Sign(salesLine.LineAmount))
                        return $"\"{Truncate(DescriptionFor(salesLine), 40)}\" — the share must carry the line's sign ({Money(salesLine.LineAmount)}).";
                    var available = salesLine.LineAmount - allPackages
                        .SelectMany(package => package.SalesLines)
                        .Where(slice => string.Equals(slice.ValuationLineItemId, picked.Key, StringComparison.OrdinalIgnoreCase))
                        .Sum(slice => slice.Amount);
                    if (Math.Abs(amount) > Math.Abs(available))
                        return $"\"{Truncate(DescriptionFor(salesLine), 40)}\" — only {Money(available)} of the line is still available.";
                }
            }
            return null;
        }
    }

    private bool CanSave =>
        subcontractorId != ""
        && !string.IsNullOrWhiteSpace(title)
        && lines.Any(line => line.CostCode != "" && Parse(line.AmountText) is { } amount && amount != 0m)
        && ClientValidationError is null;

    private async Task SaveAsync()
    {
        if (busy || !CanSave) return;
        busy = true;
        saveError = null;
        try
        {
            // Editing: the whole editable surface travels in one command — no packaging step.
            if (Editing is not null)
            {
                var editedLines = lines
                    .Where(line => line.CostCode != "" && Parse(line.AmountText) is { } amount && amount != 0m)
                    .Select(line => new UpdatedManualWorkOrderLine(
                        line.WorkOrderLineId, line.CostCode, line.Title.Trim(), Parse(line.AmountText)!.Value,
                        line.Description.Trim()))
                    .ToList();
                await Commands.SendAsync(new UpdateManualWorkOrder(
                    ProjectId, Editing.Order.WorkOrderId, subcontractorId,
                    title.Trim(), scope.Trim(), editedLines,
                    AsUtcDate(programmeStart), AsUtcDate(targetCompletion), programmeNotes.Trim(),
                    DepositRequired: depositRequired,
                    DepositPercent: depositRequired ? Parse(depositPercentText) : null), CancellationToken.None);
                seeded = false; // reseed fresh on next open
                await OnSaved.InvokeAsync();
                return;
            }

            // Step 1 — the order itself (skipped on a retry after a package failure,
            // so the order is never raised twice).
            if (createdOrder is null)
            {
                var orderLines = lines
                    .Where(line => line.CostCode != "" && Parse(line.AmountText) is { } amount && amount != 0m)
                    .Select(line => new ManualWorkOrderLine(
                        line.CostCode, line.Title.Trim(), Parse(line.AmountText)!.Value, line.Description.Trim()))
                    .ToList();
                createdOrder = await Commands.SendAsync(new CreateManualWorkOrder(
                    ProjectId, subcontractorId, title.Trim(), scope.Trim(),
                    Auth.CurrentUser?.Email ?? "", orderLines,
                    AsUtcDate(programmeStart), AsUtcDate(targetCompletion), programmeNotes.Trim(),
                    SaveAsDraft: saveAsDraft,
                    DepositRequired: depositRequired,
                    DepositPercent: depositRequired ? Parse(depositPercentText) : null), CancellationToken.None);
            }

            // Step 2 — the package, with the fresh order already assigned. Never for a
            // draft: packages carry approved scope, and a draft hasn't been approved yet.
            if (!saveAsDraft && createPackage && pickedAmounts.Count > 0)
            {
                var slices = pickedAmounts
                    .Where(picked => Parse(picked.Value) is { } amount && amount != 0m)
                    .Select(picked => new PackageSalesSlice(picked.Key, Parse(picked.Value)!.Value))
                    .ToList();
                await Commands.SendAsync(new SaveReconciliationPackage(
                    ProjectId,
                    null,
                    string.IsNullOrWhiteSpace(packageName) ? title.Trim() : packageName.Trim(),
                    new List<string> { createdOrder.WorkOrderId },
                    slices), CancellationToken.None);
            }

            seeded = false; // reseed fresh on next open
            await OnSaved.InvokeAsync();
        }
        catch (CommandFailedException ex)
        {
            saveError = IsEditing
                ? $"Couldn't save the changes: {ex.Message}"
                : createdOrder is null
                ? $"Couldn't raise the order: {ex.Message}"
                : $"The order was raised ({createdOrder.Reference}) but the package couldn't be created: {ex.Message} — fix and save again, or close and build the package from the Packages section.";
        }
        finally
        {
            busy = false;
        }
    }

    // Mirrors the Valuation Report tab's CodeFor (and the cost-centre sales-lines modal's Ref)
    // so the picker cross-references against that tab: works/PC/contingency lines show the cost
    // code (NRM2 section ref as a fallback); variation lines show their V-ref from the contract's
    // variations register. The bill section / variation title survive in the tooltip.
    private static string Ref(ValuationLineItem line) =>
        line.ElementType == ValuationElementType.Variation
            ? (string.IsNullOrWhiteSpace(line.VariationRef) ? line.CostCode : line.VariationRef)
            : (string.IsNullOrWhiteSpace(line.CostCode) ? line.SectionCode : line.CostCode);

    private static string RefTitle(ValuationLineItem line) =>
        line.ElementType == ValuationElementType.Variation
            ? line.VariationTitle
            : string.IsNullOrWhiteSpace(line.SectionCode)
                ? line.SectionName
                : $"{line.SectionCode} — {line.SectionName}";

    // Variation lines mirror an approved VO whose descriptive text lives in VariationTitle;
    // older lines have an empty Description, so fall back to the title instead of a blank row.
    private static string DescriptionFor(ValuationLineItem line) =>
        line.ElementType == ValuationElementType.Variation && string.IsNullOrWhiteSpace(line.Description)
            ? line.VariationTitle
            : line.Description;

    // Date-only picker value → a UTC date, matching how other date inputs are sent.
    private static DateTimeOffset? AsUtcDate(DateTime? date) =>
        date is null ? null : new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc));

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "…";

    private static string Money(decimal value) =>
        value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
}
