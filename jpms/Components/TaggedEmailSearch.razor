@inject IQueryClient Queries
@inject SessionService Session
@inject ControlCentreOpenEmail OpenEmail
@inject NavigationManager Nav
@implements IDisposable

@*
    The tagged-email half of the to-do searches (Pages/Todos.razor and ProjectTodoList.razor):
    the same keywords that filter the to-do list also search the projects mailbox (subjects,
    bodies, senders, attachment names — SearchMailboxMessages), so "that email about the canopy"
    is findable from the same box as the to-do it produced. Each hit renders with its record-tag
    chips resolved to links (ResolveRecordTags): a chip is the record the email is tagged to, and
    clicking it opens the record's own page, where the email sits in its communications.

    SEARCH BY TAG: Graph $search does not look at categories, so a typed reference would find
    nothing by text alone. A query that looks like one ("TODO-0011", "WO-0045", "RFI-012") is
    therefore ALSO resolved as a tag stem (the same ResolveRecordTags the chips use), and the
    matching record's tagged emails are read live (ListRecordEmails) into their own group above
    the keyword hits — typing a reference answers "what mail is tagged to this record".

    The mailbox search is a live Graph call, so it is debounced rather than run per keystroke,
    and it renders only for the roles the api lets search the mailbox at large
    (TriageRoles.AllowedToTriage — mirrored below, like DesktopNavigation.TriageRoles): for
    everyone else the whole section simply doesn't exist, rather than existing and 403ing.
*@

@if (CanSearchMailbox && Active)
{
    <div class="border-t border-line pt-4 mt-2">
        <h3 class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2">Emails</h3>

        @if (recordMatch is LinkableRecord match)
        {
            <div class="mb-4">
                <p class="text-xs text-content-subtle mb-2">
                    Tagged to
                    @if (HrefFor(match) is string matchHref)
                    {
                        <a class="font-mono text-accent hover:underline" href="@matchHref" title="@ChipTitle(match)">@match.Reference</a>
                    }
                    else
                    {
                        <span class="font-mono">@match.Reference</span>
                    }
                    — @match.Title
                </p>
                @if (recordEmails is null)
                {
                    <p class="text-sm text-content-subtle italic">Reading its emails…</p>
                }
                else if (recordEmails.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">No emails are tagged to @match.Reference yet.</p>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var email in recordEmails.Take(RecordEmailCap))
                        {
                            @EmailRow(email)
                        }
                    </div>
                    @if (recordEmails.Count > RecordEmailCap && HrefFor(match) is string moreHref)
                    {
                        <p class="text-[11px] text-content-subtle mt-2">
                            Showing @RecordEmailCap of @recordEmails.Count —
                            <a class="underline underline-offset-2 hover:text-content" href="@moreHref">open @match.Reference for the rest</a>.
                        </p>
                    }
                }
            </div>
        }

        @if (results is null)
        {
            <p class="text-sm text-content-subtle italic">Searching the mailbox…</p>
        }
        else if (error is not null)
        {
            <p class="text-sm text-negative">@error</p>
        }
        else
        {
            var keywordResults = KeywordResults;
            @if (keywordResults.Count == 0)
            {
                @if (recordMatch is null)
                {
                    <p class="text-sm text-content-subtle italic">No mailbox emails match "@lastQuery".</p>
                }
            }
            else
            {
                <p class="text-xs text-content-subtle mb-2">
                    Mailbox emails matching the keywords — each chip is a record the email is tagged to;
                    click one to open that record. Tags themselves are managed in the
                    <a class="underline underline-offset-2 hover:text-content" href="/control-centre">Control Centre</a>.
                </p>
                <div class="space-y-2">
                    @foreach (var email in keywordResults)
                    {
                        @EmailRow(email)
                    }
                </div>
            }
        }
    </div>
}

@code {
    /// <summary>The host search box's current text — the component debounces it itself.</summary>
    [Parameter, EditorRequired] public string Query { get; set; } = "";

    private const int Take = 15;
    private const int RecordEmailCap = 8;
    private const int DebounceMs = 500;
    private const int MinQueryLength = 2;

    private string pendingQuery = "";
    // The query the current results answer — shown in the empty state so a stale "no match" can
    // never be read against newer keystrokes.
    private string lastQuery = "";
    private string? error;
    private IReadOnlyList<MailboxMessage>? results;
    // The record a reference-shaped query resolved to, and its live tagged mail (newest first) —
    // the "search by tag" answer, rendered as its own group above the keyword hits.
    private LinkableRecord? recordMatch;
    private IReadOnlyList<MailboxMessage>? recordEmails;
    // Stem -> record, accumulated across searches; stems that resolved to nothing are remembered
    // too, so workflow tags aren't re-asked on every search.
    private readonly Dictionary<string, LinkableRecord> resolved = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> unresolvable = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? debounce;

    private bool Active => (Query ?? "").Trim().Length >= MinQueryLength;

    // Mirrors the api's TriageRoles.AllowedToTriage (and DesktopNavigation.TriageRoles — keep the
    // three in step): searching the mailbox at large is a triage power. Administrators hold every
    // role server-side, so they pass via Role.Admin.
    private bool CanSearchMailbox =>
        Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector
            or Role.ProjectManager or Role.FinanceDirector);

    // The keyword hits minus anything already shown in the record group above — one email never
    // renders twice. InternetMessageId is the stable identity; Graph ids fall back for safety.
    private IReadOnlyList<MailboxMessage> KeywordResults =>
        results is null
            ? Array.Empty<MailboxMessage>()
            : recordEmails is null
                ? results
                : results.Where(email => !recordEmails.Any(shown =>
                        (!string.IsNullOrEmpty(shown.InternetMessageId) && shown.InternetMessageId == email.InternetMessageId)
                        || shown.Id == email.Id))
                    .ToList();

    protected override void OnParametersSet()
    {
        if (!CanSearchMailbox) return;
        var query = (Query ?? "").Trim();
        if (query == pendingQuery) return;
        pendingQuery = query;
        debounce?.Cancel();
        error = null;
        // Below the threshold nothing renders (Active is false); null also means "in flight", so
        // the next visible state is honest either way.
        results = null;
        recordMatch = null;
        recordEmails = null;
        if (query.Length < MinQueryLength) return;
        var cts = debounce = new CancellationTokenSource();
        _ = SearchSoonAsync(query, cts.Token);
    }

    private async Task SearchSoonAsync(string query, CancellationToken token)
    {
        try { await Task.Delay(DebounceMs, token); } catch (TaskCanceledException) { return; }
        // The tag lookup and the keyword search are independent reads — run them together. Either
        // failing leaves the other's half standing.
        var tagLookup = LooksLikeReference(query) ? LookupRecordEmailsAsync(query, token) : Task.CompletedTask;
        try
        {
            var found = await Queries.AskAsync(new SearchMailboxMessages(query, Take), token);
            if (token.IsCancellationRequested) return;
            results = found;
            lastQuery = query;
            // The emails render at once; the chips upgrade to links as the resolve lands.
            await InvokeAsync(StateHasChanged);
            await ResolveTagsAsync(found, token);
        }
        catch (OperationCanceledException) { return; }
        catch
        {
            if (token.IsCancellationRequested) return;
            results = Array.Empty<MailboxMessage>();
            lastQuery = query;
            error = "The mailbox couldn't be searched just then. Try again in a moment.";
        }
        finally
        {
            await tagLookup;
            if (!token.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    // A single token containing a dash reads as a reference/tag stem ("TODO-0011", "wo-0045",
    // "RFI-012") — worth offering to the tag resolver. Multi-word queries are prose, not tags.
    private static bool LooksLikeReference(string query) =>
        !query.Contains(' ') && query.Contains('-');

    private async Task LookupRecordEmailsAsync(string query, CancellationToken token)
    {
        try
        {
            var records = await Queries.AskAsync(new ResolveRecordTags(new[] { query }), token);
            var record = records.FirstOrDefault();
            if (record is null || token.IsCancellationRequested) return;
            recordMatch = record;
            resolved[record.TagReference] = record; // the chips learn it too
            await InvokeAsync(StateHasChanged);
            var emails = await Queries.AskAsync(new ListRecordEmails(record.Type, record.RecordId), token);
            if (token.IsCancellationRequested) return;
            recordEmails = emails.OrderByDescending(email => email.ReceivedAt).ToList();
        }
        catch (OperationCanceledException) { }
        catch { /* the keyword half still answers; the record group just doesn't render */ }
    }

    private async Task ResolveTagsAsync(IReadOnlyList<MailboxMessage> emails, CancellationToken token)
    {
        var stems = emails
            .SelectMany(email => email.Categories)
            .Select(TagStem)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(stem => !resolved.ContainsKey(stem) && !unresolvable.Contains(stem))
            .ToList();
        if (stems.Count == 0) return;
        try
        {
            var records = await Queries.AskAsync(new ResolveRecordTags(stems), token);
            foreach (var record in records) resolved[record.TagReference] = record;
            foreach (var stem in stems.Where(stem => !resolved.ContainsKey(stem))) unresolvable.Add(stem);
        }
        catch (OperationCanceledException) { }
        catch { /* the emails are already on screen; unresolved chips just render unlinked */ }
    }

    // One email row — shared by the record group and the keyword list so the two can never drift.
    // The ROW opens the email in the Control Centre with it selected (ControlCentreOpenEmail):
    // reading it, tagging it to a record, and the assistant's page context all live there — an
    // email a search can show but not open is a dead end, worst of all for the untagged ones,
    // which have no chips and no other way in. Chips stay their own links (stopPropagation).
    private RenderFragment<MailboxMessage> EmailRow => email =>
        @<div @key="email.Id" role="button" tabindex="0"
              class="rounded-lg border border-line px-3 py-2 cursor-pointer hover:border-line-strong hover:bg-surface-raised"
              title="Open in the Control Centre — read the email and manage its tags"
              @onclick="() => OpenInControlCentre(email)">
            <div class="flex items-baseline justify-between gap-2">
                <span class="text-sm font-medium text-content truncate">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                <span class="text-[11px] text-content-subtle shrink-0">@email.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
            </div>
            <div class="flex items-center gap-1.5 mt-0.5">
                <p class="text-sm text-content truncate flex-1">@email.Subject</p>
                @if (email.HasAttachments)
                {
                    <span class="inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle shrink-0">attachment</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(email.BodyPreview))
            {
                <p class="text-xs text-content-subtle truncate mt-0.5">@email.BodyPreview</p>
            }
            <div class="flex flex-wrap items-center gap-1 mt-1">
                @if (email.Categories.Count == 0)
                {
                    <span class="inline-flex items-center rounded-full bg-surface-raised border border-line text-content-subtle text-[10px] font-medium px-2 py-0.5">Not tagged to a record</span>
                }
                else
                {
                    @foreach (var stem in email.Categories.Select(TagStem))
                    {
                        @if (resolved.TryGetValue(stem, out var record) && HrefFor(record) is string href)
                        {
                            <a class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5 hover:bg-accent/20 hover:underline"
                               href="@href" title="@ChipTitle(record)" @onclick:stopPropagation="true">@record.Reference</a>
                        }
                        else
                        {
                            @* A workflow tag (Discarded, Replied) or a stem no provider claimed. *@
                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@stem</span>
                        }
                    }
                }
            </div>
        </div>;

    // Hand the email to the Control Centre and go there — it arrives selected, whichever pile
    // (queue or tagged) it lives in.
    private void OpenInControlCentre(MailboxMessage email)
    {
        OpenEmail.Set(email);
        Nav.NavigateTo("/control-centre");
    }

    private static string TagStem(string tag) =>
        tag.StartsWith("JPMS/", StringComparison.OrdinalIgnoreCase) ? tag["JPMS/".Length..] : tag;

    // Where each record family's own page lives — mirrors ExplorerRecordTypes.FullPageHref, except
    // a to-do links to the ITEM's page (/todos/{id}) rather than a list it would then need finding
    // on again. Null = no page to offer; the chip renders unlinked.
    private static string? HrefFor(LinkableRecord record) => record.Type switch
    {
        RecordType.Todo => $"/todos/{record.RecordId}",
        RecordType.Request => $"/projects/{record.ProjectId}/requests/view/{record.RecordId}",
        RecordType.Variation or RecordType.VariationQuote => $"/projects/{record.ProjectId}/variations/{record.RecordId}",
        RecordType.BidPackageInvite => $"/projects/{record.ProjectId}/bid-package-invites/{record.RecordId}",
        RecordType.WorkOrder => $"/projects/{record.ProjectId}/work-orders",
        RecordType.Defect => $"/projects/{record.ProjectId}/defects",
        RecordType.Scheduling or RecordType.Lad => $"/projects/{record.ProjectId}/programme",
        RecordType.ValuationClaim => $"/projects/{record.ProjectId}/valuation",
        RecordType.CalendarEvent => $"/projects/{record.ProjectId}/calendar?event={record.RecordId}",
        _ => null
    };

    private static string ChipTitle(LinkableRecord record) =>
        $"Open {record.Reference}{(string.IsNullOrWhiteSpace(record.StatusLabel) ? "" : $" ({record.StatusLabel})")} — {record.Title}";

    public void Dispose()
    {
        debounce?.Cancel();
        debounce?.Dispose();
    }
}
