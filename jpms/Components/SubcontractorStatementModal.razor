@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Contracts.Subcontractors
@using Jewel.JPMS.Models
@inject IQueryClient Queries
@inject ICommandSender Commands

@* The subcontractor's statement of account — their work orders across every project with the
   invoices claimed against each — previewed here, downloadable as the branded PDF, and sent from
   the shared projects mailbox with the PDF attached and its figures rendered server-side from the
   live register. Save as draft leaves it in Drafts for Outlook instead. Used from the directory
   record and the project Work Orders tab. *@
<Modal IsOpen="IsOpen"
       Title="@($"Statement of account · {statement?.CompanyName ?? SubcontractorName}")"
       OnCancel="Close"
       Class="max-w-3xl w-full">
    <ChildContent>
    @if (loadError is not null)
    {
        <Notice Tone="Tone.Negative">@loadError</Notice>
    }
    else if (statement is null)
    {
        <p class="text-sm text-content-subtle">Loading statement…</p>
    }
    else
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Sends from the shared projects mailbox with the statement PDF attached, to
            @(string.IsNullOrWhiteSpace(statement.ContactEmail) ? "the subcontractor (no directory email yet)" : statement.ContactEmail).
            The PDF is rendered from the register as it goes, so its figures are always current.
            Save as draft to review it in Outlook first.
        </p>

        <RecordsTable Dense="true" MaxHeight="" Class="mb-3">
            <thead>
                <tr>
                    <th>Project</th>
                    <th class="text-right">Orders</th>
                    <th class="text-right">Ordered</th>
                    <th class="text-right">Invoiced</th>
                    <th class="text-right">Remaining</th>
                </tr>
            </thead>
            <tbody>
                @if (statement.Projects.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-content-subtle italic">
                            No work orders are recorded on this account yet.
                        </td>
                    </tr>
                }
                @foreach (var project in statement.Projects)
                {
                    <tr>
                        <td class="text-content whitespace-nowrap">
                            <span class="font-mono text-xs text-content-subtle mr-1.5">@project.ProjectReference</span>@project.ProjectName
                        </td>
                        <td class="text-right">@project.Orders.Count</td>
                        <td class="text-right">@MoneyExact(project.Ordered)</td>
                        <td class="text-right">@MoneyExact(project.Invoiced)</td>
                        <td class="text-right @(project.Remaining < 0 ?"text-negative" : "")">@MoneyExact(project.Remaining)</td>
                    </tr>
                }
            </tbody>
            @if (statement.Projects.Count > 0)
            {
                <tfoot class="border-t border-line-strong bg-surface-raised">
                    <tr class="font-semibold text-content">
                        <td>Account total</td>
                        <td class="text-right">@statement.OrderCount</td>
                        <td class="text-right">@MoneyExact(statement.TotalOrdered)</td>
                        <td class="text-right">@MoneyExact(statement.TotalInvoiced)</td>
                        <td class="text-right @(statement.TotalRemaining < 0 ?"text-negative" : "")">@MoneyExact(statement.TotalRemaining)</td>
                    </tr>
                </tfoot>
            }
        </RecordsTable>

        <div class="flex items-center justify-between gap-3 mb-3">
            <a class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
               href="@($"/api/subcontractors/{SubcontractorId}/statement/pdf")" target="_blank" rel="noopener">
                Download the statement PDF (what gets attached)
            </a>
            <span class="text-xs text-content-subtle">All figures net of VAT · credit notes deduct</span>
        </div>

        @if (drafted)
        {
            <Notice Tone="@(sent ? Tone.Positive : sendFailure is null ? Tone.Info : Tone.Warning)">
                <p class="mb-1">@OutcomeText</p>
                @if (draftLink is not null)
                {
                    <a class="underline underline-offset-4 font-medium" href="@draftLink" target="_blank" rel="noopener">Open it in Outlook on the web</a>
                }
            </Notice>
        }
        else
        {
            <p class="text-xs text-content-subtle mb-1">This is the email as it will go:</p>
            <RecordEmailPreviewPanel Preview="preview" Loading="previewing" Error="@previewError" />

            <FormField Label="Subject" Class="mt-3">
            <input class="field mb-3" @bind="subject" />
            </FormField>

            <FormField Label="Cover note (HTML) — the statement itself travels as the attached PDF">
            <textarea class="field font-mono text-xs" rows="10" @bind="htmlBody"></textarea>
            </FormField>
        }

        @if (error is not null)
        {
            <Notice Tone="Tone.Negative" Class="mt-3">@error</Notice>
        }
    }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-secondary btn-lg" @onclick="Close">Close</button>
        <button type="button" class="btn-secondary btn-lg" disabled="@CannotSend"
                @onclick="() => EmailStatementAsync(saveAsDraftOnly: true)">Save as draft</button>
        <button type="button" class="btn-primary btn-lg" disabled="@CannotSend"
                @onclick="() => EmailStatementAsync(saveAsDraftOnly: false)">@(busy ? "Working…" : "Send statement")</button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>The directory record whose account the statement covers.</summary>
    [Parameter] public string SubcontractorId { get; set; } = "";

    /// <summary>Display name shown while the statement loads.</summary>
    [Parameter] public string SubcontractorName { get; set; } = "";

    [Parameter] public EventCallback OnClose { get; set; }

    private SubcontractorStatement? statement;
    private string? loadedForId;
    private string? loadError;

    private bool busy;
    private bool drafted;
    private bool sent;
    private string? sendFailure;
    private string? error;
    private string? draftLink;
    private string draftRecipient = "";

    private string subject = "";
    private string htmlBody = "";

    private bool previewing;
    private string? previewError;
    private RecordEmailPreview? preview;

    private bool CannotSend => busy || drafted || statement is null;

    private string OutcomeText =>
        sent ? $"Sent to {draftRecipient} with the statement PDF attached."
        : sendFailure ?? $"Draft created in the shared mailbox to {draftRecipient}, with the statement PDF "
            + "attached. Review and send it from the mailbox's Drafts folder.";

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            // Reset the per-open outcome so reopening starts clean; the statement itself reloads
            // per open below, so figures never go stale between visits.
            drafted = false;
            sent = false;
            sendFailure = null;
            error = null;
            draftLink = null;
            loadedForId = null;
            return;
        }

        if (loadedForId == SubcontractorId) return;
        loadedForId = SubcontractorId;
        statement = null;
        loadError = null;
        try
        {
            statement = await Queries.AskAsync(new GetSubcontractorStatement(SubcontractorId), CancellationToken.None);
            await LoadPreviewAsync();
        }
        catch
        {
            loadError = "Couldn't load the statement. Please try again.";
        }
    }

    /// <summary>The subject and the covering note are the SERVER'S, read through the preview: this
    /// page composed its own copy of both until 2026-09-18, so the portal held two spellings of one
    /// email and only the page's could ever be seen.</summary>
    private async Task LoadPreviewAsync()
    {
        previewError = null;
        previewing = true;
        try
        {
            preview = await Queries.AskAsync(
                new PreviewRecordEmail(RecordType.SubcontractorComms, SubcontractorId), CancellationToken.None);
            subject = preview.Subject;
            htmlBody = preview.BodyHtml;
        }
        catch
        {
            preview = null;
            previewError = "Couldn't read the email yet — check the subcontractor has an email address in the directory.";
        }
        finally { previewing = false; }
    }

    private async Task EmailStatementAsync(bool saveAsDraftOnly)
    {
        if (busy || drafted || statement is null) return;
        error = null;
        try
        {
            busy = true;
            var outcome = await Commands.SendAsync(
                new SendSubcontractorStatementEmail(SubcontractorId, subject.Trim(), htmlBody, saveAsDraftOnly),
                CancellationToken.None);
            drafted = true;
            sent = outcome.Sent;
            sendFailure = outcome.FailureNote;
            draftRecipient = outcome.RecipientEmail;
            draftLink = outcome.WebLink;
        }
        catch (CommandFailedException ex) { error = $"Couldn't email the statement: {ex.Message}"; }
        catch { error = "Couldn't email the statement. Check the subcontractor has an email address in the directory and the mailbox connection, then try again."; }
        finally { busy = false; }
    }

    private Task Close() => OnClose.InvokeAsync();

    private static string MoneyExact(decimal value) =>
        value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
}
