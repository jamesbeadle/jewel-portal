@using Jewel.JPMS.Features.Projects
@using Jewel.JPMS.Features.Requests
@inject RfiRegisterReadModel Register
@inject ProjectListReadModel Projects
@implements IDisposable

@*
    "RFIs waiting on someone" — the dashboard's request queue, across every live project.

    Reads the same cross-project register that backs /rfis, so no new query was needed: the list
    already carries DaysOutstanding and IsOverdue (open for more than seven days since issue). The
    panel shows the ones that need chasing first — overdue, longest-waiting at the top — because
    that is the question a PM actually opens the app with. Everything else is one click away on the
    full register. Every row names its project (RFI numbers are minted per project, so RFI-004
    alone says nothing about which job is waiting), resolved through the project list exactly as
    the full register does — so the gate waits for both reads, never painting an id for a name.
*@

<div class="panel p-5">
    <div class="flex items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-3">
            <h2 class="text-sm font-semibold text-content">@Title</h2>
            @if (Register.Current is not null && Outstanding.Count > 0)
            {
                <span class="text-xs text-content-subtle">@Outstanding.Count open</span>
                @if (OverdueCount > 0)
                {
                    <span class="text-xs font-medium text-negative">@OverdueCount overdue</span>
                }
            }
        </div>
        <a href="/rfis" class="text-xs font-medium text-accent hover:underline">View all</a>
    </div>
    <p class="text-xs text-content-subtle mb-4">
        Open RFIs across every live project, the longest-waiting first. Anything past seven days
        since issue counts as overdue.
    </p>

    <LoadGate IsLoading="@(Register.Current is null || IsWaitingForProjects)" Prominent="true" Label="Loading RFIs">
    @if (Outstanding.Count == 0)
    {
        <p class="text-sm text-content-subtle italic">Nothing outstanding — every RFI has been closed.</p>
    }
    else
    {
        <ul class="divide-y divide-line -mx-5">
            @foreach (var request in Top)
            {
                <li>
                    <a href="@Href(request)"
                       class="flex items-center justify-between gap-4 px-5 py-2.5 hover:bg-surface-raised transition">
                        <span class="min-w-0">
                            <span class="flex items-center gap-2">
                                <span class="font-mono text-xs font-semibold text-content shrink-0">@request.Reference</span>
                                @if (ProjectName(request) is { } projectName)
                                {
                                    <span class="text-sm font-medium text-content shrink-0">@projectName</span>
                                }
                                <span class="text-sm text-content-muted truncate">@request.Title</span>
                            </span>
                        </span>
                        <span class="text-right shrink-0">
                            <span class="block text-sm font-semibold @(request.IsOverdue ?"text-negative" : "text-content")">
                                @(request.DaysOutstanding is int days ? $"{days}d" : "—")
                            </span>
                            <span class="block text-xs text-content-subtle">@request.Status.DisplayName()</span>
                        </span>
                    </a>
                </li>
            }
        </ul>
        @if (Outstanding.Count > Top.Count)
        {
            <p class="text-xs text-content-subtle mt-3">
                Showing the @Top.Count longest-waiting of @Outstanding.Count.
                <a href="/rfis" class="text-accent hover:underline">See the rest</a>.
            </p>
        }
    }
    </LoadGate>
</div>

@code {
    [Parameter] public string Title { get; set; } = "RFIs waiting on someone";

    /// <summary>How many rows to show before deferring to the full register.</summary>
    [Parameter] public int Take { get; set; } = 6;

    private IReadOnlyList<Request> Outstanding =>
        (Register.Current ?? Array.Empty<Request>())
            .Where(request => request.Status is not RequestStatus.Closed)
            .OrderByDescending(request => request.DaysOutstanding ?? 0)
            .ToList();

    private IReadOnlyList<Request> Top => Outstanding.Take(Take).ToList();

    private int OverdueCount => Outstanding.Count(request => request.IsOverdue);

    private static string Href(Request request) =>
        $"/projects/{request.ProjectId}/requests/view/{request.RequestId}";

    // The gate holds the rows until the project list has landed, so a project is always found —
    // unless that read failed, when the row simply carries no project rather than a bare id.
    private bool projectsFailed;

    private bool IsWaitingForProjects => Projects.Current is null && !projectsFailed;

    private string? ProjectName(Request request) => Projects.Find(request.ProjectId)?.Name;

    protected override async Task OnInitializedAsync()
    {
        Register.OnChanged += StateHasChanged;
        Projects.OnChanged += StateHasChanged;
        // Refresh on entry, never from render (the front-end data-loading convention): cached rows
        // paint immediately on a revisit, then update when the reload lands. The project list is
        // fetched only when nothing has landed yet — the role home refreshes it for its own tiles.
        await Task.WhenAll(RefreshRegisterAsync(), EnsureProjectsLoadedAsync());
    }

    private async Task RefreshRegisterAsync()
    {
        try { await Register.RefreshAsync(CancellationToken.None); } catch { /* panel shows its empty state */ }
    }

    private async Task EnsureProjectsLoadedAsync()
    {
        if (Projects.Current is not null) return;
        try { await Projects.RefreshAsync(CancellationToken.None); }
        catch { projectsFailed = true; }
    }

    public void Dispose()
    {
        Register.OnChanged -= StateHasChanged;
        Projects.OnChanged -= StateHasChanged;
    }
}
