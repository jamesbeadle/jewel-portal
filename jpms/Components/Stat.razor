@*
    A labelled figure. Pass IsLoading while the store behind Value is still fetching: the label
    stays (so the page keeps its shape) and the figure is replaced by the pulsing jewel. Never let
    this render a placeholder zero — a reader believes the first number they see.
*@

<article class="panel p-6">
    <p class="eyebrow mb-4">@Label</p>
    @if (IsLoading)
    {
        <p class="text-content text-xl font-medium flex items-center h-5" role="status" aria-live="polite" aria-busy="true">
            <JewelIcon Class="w-4 h-4 animate-jewel-pulse" />
            <span class="sr-only">Loading @Label</span>
        </p>
    }
    else
    {
        <p class="text-content text-xl font-medium">@Value</p>
    }
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";

    /// <summary>True until the store behind Value has produced its first result.</summary>
    [Parameter] public bool IsLoading { get; set; }
}
