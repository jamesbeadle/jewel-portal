@using Jewel.JPMS.Commercial
@inject IValuationReportStore Store
@inject ICostCenterStore CostCenters
@inject IVariationStore Variations
@inject SessionService Session
@implements IDisposable

@if (lines.Count == 0)
{
    <div class="rounded-xl border border-line bg-surface px-3 py-6 text-center text-content-subtle italic">
        No lines yet. Add contract works, provisional sums, contingency and variation lines to build the report.
    </div>
}
else
{
    @* Bulk % entry on a Draft claim: every counting line's % becomes an input, one Save
       records the lot. Built for entering an opening position when joining a project
       mid-way (200+ lines), but just as useful for a heavy-update month. *@
    @if (CanEditEntries)
    {
        <div class="flex items-center justify-end gap-2 mb-2 flex-wrap">
            @if (bulkError is not null)
            {
                <span class="text-xs text-negative">@bulkError</span>
            }
            @if (!bulkEditing)
            {
                <button type="button" @onclick="StartBulkEdit"
                        title="Edit every line's % complete at once — for opening positions and heavy months"
                        class="rounded-lg border border-line bg-surface text-content-muted font-medium text-sm px-3 py-2 hover:border-line-strong transition">
                    Bulk edit %
                </button>
            }
            else
            {
                <span class="text-xs text-content-subtle">@BulkChangedCount changed — totals update on save</span>
                <button type="button" @onclick="SaveBulkAsync" disabled="@bulkSaving"
                        class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover disabled:bg-surface-field transition">
                    @(bulkSaving ? "Saving…" : "Save all")
                </button>
                <button type="button" @onclick="CancelBulkEdit" disabled="@bulkSaving"
                        class="rounded-lg border border-line bg-surface text-content-muted font-medium text-sm px-3 py-2 hover:border-line-strong transition">
                    Cancel
                </button>
            }
        </div>
    }
    <div class="space-y-3">
        @foreach (var valuationSection in Sections)
        {
            var isOpen = IsExpanded(valuationSection.Type);
            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                <button type="button" @onclick="@(() => Toggle(valuationSection.Type))" aria-expanded="@isOpen"
                        class="w-full flex items-center gap-3 px-4 py-3 text-left hover:bg-surface-raised/60 transition">
                    <svg class="@(isOpen ? "w-4 h-4 shrink-0 text-content-subtle rotate-90 transition-transform" : "w-4 h-4 shrink-0 text-content-subtle transition-transform")"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 6l6 6-6 6" />
                    </svg>
                    <span class="font-semibold text-content whitespace-nowrap">@valuationSection.Title</span>
                    <span class="text-xs text-content-subtle whitespace-nowrap">
                        @valuationSection.Lines.Count @(valuationSection.Lines.Count == 1 ? "line" : "lines")
                    </span>
                    <span class="ml-auto flex items-baseline gap-6 whitespace-nowrap">
                        @if (SelectedClaim is not null)
                        {
                            <span class="text-sm">
                                <span class="text-[11px] uppercase tracking-wider text-content-subtle mr-1.5">Claimed</span>
                                <span class="text-content-muted">@Money(ClaimedTotalFor(valuationSection)) (@Pct(PercentTotalFor(valuationSection)))</span>
                            </span>
                            <span class="text-sm">
                                <span class="text-[11px] uppercase tracking-wider text-content-subtle mr-1.5">This period</span>
                                <span class="text-content-muted">@Money(PeriodTotalFor(valuationSection))</span>
                            </span>
                        }
                        <span class="text-sm">
                            <span class="text-[11px] uppercase tracking-wider text-content-subtle mr-1.5">Total</span>
                            <span class="text-content font-medium">@Money(valuationSection.Amount)</span>
                        </span>
                    </span>
                </button>

                @if (isOpen)
                {
                    @if (valuationSection.Lines.Count == 0)
                    {
                        <div class="border-t border-line px-4 py-5 text-center text-content-subtle italic text-sm">
                            No @valuationSection.Title.ToLowerInvariant() lines yet.
                        </div>
                    }
                    else
                    {
                        @* `isolate` traps the sticky cells' z-10/20/30 in a local stacking context so they
                           never paint over the app header (sticky z-30 in MainLayout) when the page scrolls. *@
                        <div class="isolate border-t border-line overflow-x-auto overflow-y-auto max-h-[85vh]">
                            <table class="w-full text-sm border-collapse">
                                <thead class="bg-surface-raised border-b border-line">
                                    <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                        <th class="sticky left-0 top-0 z-30 bg-surface-raised px-3 py-3 w-[72px]">Code</th>
                                        <th class="sticky left-[72px] top-0 z-30 bg-surface-raised px-3 py-3 min-w-[220px]">Description</th>
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 whitespace-nowrap min-w-[220px]">Cost centre</th>
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap">Qty</th>
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap">Rate £</th>
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap">Amount £</th>
                                        @if (SelectedClaim is not null)
                                        {
                                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap"
                                                title="@PrevColumnTitle">Prev. %</th>
                                        }
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap">% Complete</th>
                                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap">Claimed £</th>
                                        @if (SelectedClaim is not null)
                                        {
                                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right whitespace-nowrap"
                                                title="Movement this period — cumulative claimed now less the previous claim's cumulative">Period £</th>
                                        }
                                        @if (CanEditLines)
                                        {
                                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right w-[80px]"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                    @{ var currentArea = ""; }
                                    @foreach (var row in RowsFor(valuationSection))
                                    {
                                        @* The Variations valuationSection consolidates each variation's lines per cost
                                           centre into one row (VariationRollUps); a rolled-up row opens to show
                                           the lines beneath it, each with its own % complete. *@
                                        @if (row.RollUp is { } rollUp)
                                        {
                                            var isRollUpOpen = IsRollUpOpen(rollUp);
                                            <tr class="@(rollUp.CountsTowardTotals ? "bg-surface-raised" : "bg-surface-raised opacity-60")">
                                                <td class="sticky left-0 z-10 bg-surface-raised px-3 py-2 font-mono text-[11px] text-content-subtle whitespace-nowrap">@rollUp.VariationRef</td>
                                                <td class="sticky left-[72px] z-10 bg-surface-raised px-3 py-2 text-content">
                                                    <button type="button" @onclick="() => ToggleRollUp(rollUp)" aria-expanded="@isRollUpOpen"
                                                            title="@(isRollUpOpen ? "Hide this row's lines" : "Show this row's lines")"
                                                            class="flex items-start gap-1.5 text-left">
                                                        <svg class="@(isRollUpOpen ? "w-3.5 h-3.5 mt-1 shrink-0 text-content-subtle rotate-90 transition-transform" : "w-3.5 h-3.5 mt-1 shrink-0 text-content-subtle transition-transform")"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <path d="M9 6l6 6-6 6" />
                                                        </svg>
                                                        <span>
                                                            <span class="font-medium">@rollUp.VariationTitle</span>
                                                            <span class="block text-[11px] text-content-subtle">@rollUp.Lines.Count lines consolidated</span>
                                                        </span>
                                                    </button>
                                                </td>
                                                <td class="px-3 py-2 whitespace-nowrap text-content-muted">@CostCentreLabel(rollUp.CostCode)</td>
                                                <td class="px-3 py-2 text-right text-content-subtle whitespace-nowrap">—</td>
                                                <td class="px-3 py-2 text-right text-content-subtle whitespace-nowrap">—</td>
                                                <td class="px-3 py-2 text-right text-content font-medium whitespace-nowrap">@Money(rollUp.Amount)</td>
                                                @if (SelectedClaim is not null)
                                                {
                                                    <td class="px-3 py-2 text-right text-content-subtle whitespace-nowrap">
                                                        @(rollUp.CountsTowardTotals && HasPreviousClaim ? Pct(RollUpPreviousPercent(rollUp)) : "—")
                                                    </td>
                                                }
                                                <td class="px-3 py-2 text-right whitespace-nowrap">
                                                    @if (bulkEditing && CanEditEntries)
                                                    {
                                                        <span class="text-[11px] text-content-subtle" title="In bulk edit the percentages are typed per line below">per line</span>
                                                    }
                                                    else if (CanEditEntries && rollUp.CountsTowardTotals)
                                                    {
                                                        @if (editingRollUpKey == rollUp.Key)
                                                        {
                                                            <span class="inline-flex items-center gap-1">
                                                                <input @ref="editInput" type="text" inputmode="decimal"
                                                                       value="@editValue"
                                                                       onfocus="this.select()"
                                                                       @oninput="@(e => { editValue = e.Value?.ToString() ?? ""; editError = false; })"
                                                                       @onkeydown="@(e => OnRollUpEditKeyDownAsync(e, rollUp))"
                                                                       @onblur="@(() => OnRollUpEditBlurAsync(rollUp))"
                                                                       aria-label="Percent complete for every line in this row"
                                                                       class="field w-16 text-right px-2 py-1 focus:outline-none focus:ring-2 @(editError ? "ring-2 ring-negative border-negative" : "focus:ring-accent focus:border-accent")" />
                                                                <button type="button" title="Save (Enter)" aria-label="Save percent complete"
                                                                        @onmousedown:preventDefault
                                                                        @onclick="() => CommitRollUpEditAsync(rollUp)"
                                                                        class="inline-flex items-center justify-center w-6 h-6 rounded-md text-positive hover:bg-surface-raised">
                                                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                         stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
                                                                </button>
                                                                <button type="button" title="Cancel (Esc)" aria-label="Cancel edit"
                                                                        @onmousedown:preventDefault
                                                                        @onclick="CancelRollUpEdit"
                                                                        class="inline-flex items-center justify-center w-6 h-6 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised">
                                                                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                         stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                                                </button>
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-baseline gap-1.5 justify-end">
                                                                <button type="button" title="Set the same % complete on every line in this row — open the row to set lines individually"
                                                                        @onclick="() => StartRollUpEdit(rollUp)"
                                                                        class="underline decoration-dotted underline-offset-2 hover:decoration-solid @(RollUpPercent(rollUp) == 0m ? "text-content-muted" : "text-content")">
                                                                    @Pct(RollUpPercent(rollUp))
                                                                </button>
                                                                @if (ShowRollUpDelta(rollUp))
                                                                {
                                                                    <span class="text-[11px] text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(RollUpDelta(rollUp))</span>
                                                                }
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content-muted">@(rollUp.CountsTowardTotals ? Pct(RollUpPercent(rollUp)) : "—")</span>
                                                        @if (ShowRollUpDelta(rollUp))
                                                        {
                                                            <span class="ml-1.5 text-[11px] text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(RollUpDelta(rollUp))</span>
                                                        }
                                                    }
                                                </td>
                                                <td class="px-3 py-2 text-right text-content-muted whitespace-nowrap">
                                                    @(rollUp.CountsTowardTotals ? Money(RollUpClaimed(rollUp)) : "—")
                                                </td>
                                                @if (SelectedClaim is not null)
                                                {
                                                    <td class="px-3 py-2 text-right whitespace-nowrap @(RollUpPeriod(rollUp) == 0m ? "text-content-subtle" : "text-content")">
                                                        @(rollUp.CountsTowardTotals ? Money(RollUpPeriod(rollUp)) : "—")
                                                    </td>
                                                }
                                                @if (CanEditLines)
                                                {
                                                    <td class="px-3 py-2 text-right whitespace-nowrap">
                                                        <button type="button" @onclick="() => ToggleRollUp(rollUp)"
                                                                class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">@(isRollUpOpen ? "Hide lines" : "Show lines")</button>
                                                    </td>
                                                }
                                            </tr>
                                            continue;
                                        }
                                        var line = row.Line!;
                                        @* Area title rows — the estimate's own valuationSection headings ("Electrics",
                                           "Plumbing & Heating"), falling back to the line's cost-centre name,
                                           so the bill reads in the same titled areas as the estimate instead
                                           of one flat run. Consecutive runs in display order, never a re-sort. *@
                                        @if (ValuationReportAreas.GroupsByArea(valuationSection.Type))
                                        {
                                            var area = AreaTitleFor(line);
                                            if (ValuationReportAreas.StartsNewArea(area, currentArea))
                                            {
                                                currentArea = area;
                                                <tr>
                                                    <td colspan="2" class="sticky left-0 z-10 bg-surface-raised px-3 pt-3 pb-1.5 text-[11px] uppercase tracking-wider font-semibold text-content-muted whitespace-nowrap">@area</td>
                                                    <td colspan="@(ColumnCount - 2)" class="bg-surface-raised"></td>
                                                </tr>
                                            }
                                        }
                                        <tr class="@(line.CountsTowardTotals ? "" : "opacity-60")">
                                            <td class="sticky left-0 z-10 bg-surface px-3 py-2 font-mono text-[11px] text-content-subtle whitespace-nowrap">
                                                <div>@(row.IsDetail ? "↳ " : "")@CodeFor(line)</div>
                                                @* The client's own item number for the line — how the contract document reads. *@
                                                @if (!string.IsNullOrWhiteSpace(line.ClientReference))
                                                {
                                                    <div class="text-[10px] text-content-muted">@line.ClientReference</div>
                                                }
                                            </td>
                                            <td class="sticky left-[72px] z-10 bg-surface px-3 py-2 text-content @(row.IsDetail ? "pl-7" : "")">
                                                <div class="font-medium">@TitleFor(line)</div>
                                                @if (!string.IsNullOrWhiteSpace(line.Comments))
                                                {
                                                    <div class="text-[11px] text-content-subtle">@line.Comments</div>
                                                }
                                                @if (!line.CountsTowardTotals)
                                                {
                                                    <span class="inline-block mt-0.5 text-[10px] uppercase tracking-wide text-content-subtle">@line.LineType</span>
                                                }
                                            </td>
                                            @* Where this line's value is allocated in the cost-centre master.
                                               Editable for Admin/MD/FD/PM at ANY claim status (the API enforces the
                                               same gate): recoding is a finance allocation, never a value change, so
                                               it stays open when the bill itself is locked by a preapproved claim.
                                               Variation recodes move the mirrored VO's committed budget with them. *@
                                            <td class="px-3 py-2 whitespace-nowrap">
                                                    @if (CanRecodeCostCentres)
                                                    {
                                                        <SearchSelect Options="@CostCentreOptionsFor(line)" WidthClass="w-52"
                                                                      Placeholder="Cost centre…"
                                                                      Value="@line.CostCode"
                                                                      Disabled="@(recodingLineId == line.ValuationLineItemId)"
                                                                      ValueChanged="value => SetCostCentreAsync(line, value)" />
                                                        @if (costCentreErrorLineId == line.ValuationLineItemId && costCentreError is not null)
                                                        {
                                                            <div class="text-[11px] text-negative mt-1">@costCentreError</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content-muted">@CostCentreLabel(line.CostCode)</span>
                                                    }
                                                </td>
                                            <td class="px-3 py-2 text-right text-content-muted whitespace-nowrap">@Num(line.Quantity)</td>
                                            <td class="px-3 py-2 text-right text-content-muted whitespace-nowrap">@Num(line.Rate)</td>
                                            <td class="px-3 py-2 text-right text-content whitespace-nowrap">
                                                @if (CanEditLines && line.ElementType == ValuationElementType.Variation
                                                     && CanReviseVariationValue && RevisableVoFor(line) is { } amountVo)
                                                {
                                                    @if (revisingVoLineId == line.ValuationLineItemId)
                                                    {
                                                        @* Explicit commit only: Enter / tick saves, Esc / cross discards. Deliberately NOT
                                                           the % editor's save-on-blur — re-pricing a VO moves the CVR and committed budget,
                                                           so it only ever happens on a deliberate commit; a click away leaves the editor open. *@
                                                        <span class="inline-flex items-center gap-1">
                                                            <input @ref="reviseInput" type="text" inputmode="decimal"
                                                                   value="@reviseValue" disabled="@reviseSaving"
                                                                   @oninput="@(e => { reviseValue = e.Value?.ToString() ?? ""; reviseError = false; })"
                                                                   @onkeydown="@(e => OnVoReviseKeyDownAsync(e, line))"
                                                                   aria-label="Variation value"
                                                                   class="field w-28 text-right px-2 py-1 focus:outline-none focus:ring-2 @(reviseError ? "ring-2 ring-negative border-negative" : "focus:ring-accent focus:border-accent")" />
                                                            <button type="button" title="Save (Enter)" aria-label="Save variation value"
                                                                    disabled="@reviseSaving" @onclick="() => CommitVoReviseAsync(line)"
                                                                    class="inline-flex items-center justify-center w-6 h-6 rounded-md text-positive hover:bg-surface-raised">
                                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
                                                            </button>
                                                            <button type="button" title="Cancel (Esc)" aria-label="Cancel revise"
                                                                    disabled="@reviseSaving" @onclick="CancelVoRevise"
                                                                    class="inline-flex items-center justify-center w-6 h-6 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised">
                                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                                            </button>
                                                        </span>
                                                        @if (reviseFailure is not null)
                                                        {
                                                            <div class="text-[11px] text-negative mt-1">@reviseFailure</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                title="Revise @(amountVo.VariationRef)'s value — re-prices this line and moves the CVR and committed cost-centre budget with it"
                                                                @onclick="() => StartVoRevise(line, amountVo)"
                                                                class="underline decoration-dotted underline-offset-2 hover:decoration-solid">@Money(line.LineAmount)</button>
                                                    }
                                                }
                                                else
                                                {
                                                    @Money(line.LineAmount)
                                                }
                                            </td>
                                            @if (SelectedClaim is not null)
                                            {
                                                @* Cumulative % claimed on the previous claim — the baseline the current
                                                   claim moves off, so the client can see what changed this period. *@
                                                <td class="px-3 py-2 text-right text-content-subtle whitespace-nowrap">
                                                    @(line.CountsTowardTotals && HasPreviousClaim ? Pct(PreviousPercentFor(line)) : "—")
                                                </td>
                                            }
                                            <td class="px-3 py-2 text-right whitespace-nowrap">
                                                @if (bulkEditing && CanEditEntries && line.CountsTowardTotals)
                                                {
                                                    <input type="text" inputmode="decimal"
                                                           value="@BulkValueFor(line)"
                                                           @oninput="@(e => SetBulkValue(line, e.Value?.ToString() ?? ""))"
                                                           aria-label="Percent complete"
                                                           class="field w-16 text-right px-2 py-1 focus:outline-none focus:ring-2 @(bulkErrorLines.Contains(line.ValuationLineItemId) ? "ring-2 ring-negative border-negative" : "focus:ring-accent focus:border-accent")" />
                                                }
                                                else if (CanEditEntries && line.CountsTowardTotals)
                                                {
                                                    @if (editingLineId == line.ValuationLineItemId)
                                                    {
                                                        @* Enter / tick saves, Esc / cross discards — and clicking away also saves a changed,
                                                           valid value (OnEditBlurAsync), so scrolling off and clicking another row's % can't
                                                           silently lose an edit. The tick/cross buttons preventDefault their mousedown so the
                                                           input doesn't blur first: the cross stays an explicit discard. Enter additionally
                                                           hops to the next line's % editor (see AdvanceToNextEditable) so a whole claim can be
                                                           keyed top-to-bottom without the mouse; the plain onfocus selects the value ready to
                                                           overtype. *@
                                                        <span class="inline-flex items-center gap-1">
                                                            @if (HasPreviousClaim)
                                                            {
                                                                @* Old percentage stays visible while editing so it's clear what's being changed from. *@
                                                                <span class="text-[11px] text-content-subtle mr-1 whitespace-nowrap">was @Pct(PreviousPercentFor(line))</span>
                                                            }
                                                            <input @ref="editInput" type="text" inputmode="decimal"
                                                                   value="@editValue"
                                                                   onfocus="this.select()"
                                                                   @oninput="@(e => { editValue = e.Value?.ToString() ?? ""; editError = false; })"
                                                                   @onkeydown="@(e => OnEditKeyDownAsync(e, line))"
                                                                   @onblur="@(() => OnEditBlurAsync(line))"
                                                                   aria-label="Percent complete"
                                                                   class="field w-16 text-right px-2 py-1 focus:outline-none focus:ring-2 @(editError ? "ring-2 ring-negative border-negative" : "focus:ring-accent focus:border-accent")" />
                                                            <button type="button" title="Save (Enter)" aria-label="Save percent complete"
                                                                    @onmousedown:preventDefault
                                                                    @onclick="() => CommitEditAsync(line)"
                                                                    class="inline-flex items-center justify-center w-6 h-6 rounded-md text-positive hover:bg-surface-raised">
                                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
                                                            </button>
                                                            <button type="button" title="Cancel (Esc)" aria-label="Cancel edit"
                                                                    @onmousedown:preventDefault
                                                                    @onclick="CancelEdit"
                                                                    class="inline-flex items-center justify-center w-6 h-6 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised">
                                                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                                            </button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-baseline gap-1.5 justify-end">
                                                            <button type="button" title="Edit % complete"
                                                                    @onclick="() => StartEdit(line)"
                                                                    class="underline decoration-dotted underline-offset-2 hover:decoration-solid @(PercentFor(line) == 0m ? "text-content-muted" : "text-content")">
                                                                @Pct(PercentFor(line))
                                                            </button>
                                                            @if (ShowDelta(line))
                                                            {
                                                                <span class="text-[11px] text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(DeltaFor(line))</span>
                                                            }
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-content-muted">@(line.CountsTowardTotals ? Pct(PercentFor(line)) : "—")</span>
                                                    @if (ShowDelta(line))
                                                    {
                                                        <span class="ml-1.5 text-[11px] text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(DeltaFor(line))</span>
                                                    }
                                                }
                                            </td>
                                            <td class="px-3 py-2 text-right text-content-muted whitespace-nowrap">
                                                @(line.CountsTowardTotals ? Money(ClaimedFor(line)) : "—")
                                            </td>
                                            @if (SelectedClaim is not null)
                                            {
                                                @* What this period moved in money. On Claim 1 (no previous claim)
                                                   everything claimed is movement, which is exactly right. *@
                                                <td class="px-3 py-2 text-right whitespace-nowrap @(PeriodFor(line) == 0m ? "text-content-subtle" : "text-content")">
                                                    @(line.CountsTowardTotals ? Money(PeriodFor(line)) : "—")
                                                </td>
                                            }
                                            @if (CanEditLines)
                                            {
                                                <td class="px-3 py-2 text-right whitespace-nowrap">
                                                    @if (line.ElementType == ValuationElementType.Variation)
                                                    {
                                                        @if (CanReviseVariationValue && RevisableVoFor(line) is { } actionVo)
                                                        {
                                                            @* Edits go through the VO revise pipeline so the VO, CVR and budget move together. *@
                                                            <button @onclick="() => StartVoRevise(line, actionVo)"
                                                                    title="Revise the variation's value — the VO, CVR and cost-centre budget move with it"
                                                                    class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">Revise</button>
                                                        }
                                                        else
                                                        {
                                                            @* Variation lines mirror approved VOs and can only change via the variation itself. *@
                                                            <span class="text-content-subtle text-xs" title="From an approved variation order — manage it on the Variations tab.">Locked</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <button @onclick="@(() => OnEditLine.InvokeAsync(line))"
                                                                class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">Edit</button>
                                                        <button @onclick="@(() => RemoveLineAsync(line))"
                                                                class="ml-2 text-negative/80 hover:text-negative underline underline-offset-2 text-xs">Remove</button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

@* Extra accordion sections that live with the bill (e.g. valuation invoices) but are fed
   from their own store rather than the line items. *@
@if (ExtraSections is not null)
{
    <div class="mt-3">@ExtraSections</div>
}

@if (lines.Count > 0)
{
    <div class="mt-4 rounded-xl border border-line bg-surface-raised p-5">
        <h3 class="text-sm font-semibold text-content mb-3">Valuation summary@(SelectedClaim is null ? "" : $" — {SelectedClaim.DisplayName}")</h3>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-1.5 text-sm max-w-2xl">
            <SummaryRow Label="Original contract sum" Value="@Money(contractSum)" />
            <SummaryRow Label="Net variations" Value="@Money(netVariations)" />
            <SummaryRow Label="Revised contract sum" Value="@Money(revisedContractSum)" Strong="true" />
            <SummaryRow Label="Total works complete" Value="@Money(totalWorksComplete)" />
            @if (SelectedClaim is not null)
            {
                <SummaryRow Label="Works claimed this period" Value="@Money(PeriodClaimedTotal)" />
            }
            <SummaryRow Label=@($"Retention held ({Pct(retentionPercent)})") Value="@Money(retentionHeld)" />
            <SummaryRow Label=@($"Retention released ({Pct(retentionReleasePercent)})") Value="@Money(retentionReleased)" />
            @* Cash-up-front deposit — only projects with one show the block, so everyone
               else's summary keeps its familiar By France shape. Mirrors the workbook:
               total payable, less the deposit released, equals the amount invoiced. *@
            @if (depositPercent > 0m || depositReleased != 0m)
            {
                <SummaryRow Label=@($"Deposit received ({Pct(depositPercent)})") Value="@Money(depositReceived)" />
            }
            <SummaryRow Label="Certified to date" Value="@Money(certifiedToDate)" />
            @if (depositPercent > 0m || depositReleased != 0m)
            {
                <SummaryRow Label="Payment due before deposit (ex VAT)" Value="@Money(paymentDueBeforeDeposit)" />
                <SummaryRow Label=@($"Less deposit released ({Pct(depositPercent)})") Value="@Money(depositReleased)" />
            }
            <SummaryRow Label="Payment due (ex VAT)" Value="@Money(paymentDueExVat)" Strong="true" />
        </dl>
    </div>
}

