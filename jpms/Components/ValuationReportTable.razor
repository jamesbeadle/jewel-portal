@using Jewel.JPMS.Commercial
@using Jewel.JPMS.Features.Commercial
@using static Jewel.JPMS.Features.Commercial.ValuationReportDisplay
@inject IValuationReportStore Store
@inject ICostCenterStore CostCenters
@inject IVariationStore Variations
@inject SessionService Session
@implements IDisposable

@if (lines.Count == 0)
{
    <div class="panel px-3 py-6 text-center text-content-subtle italic">
        No lines yet. Add contract works, provisional sums, contingency and variation lines to build the report.
    </div>
}
else
{
    @if (CanEditEntries)
    {
        <BulkPercentToolbar Editing="bulkEditing" Saving="bulkSaving" Error="@bulkError" ChangedCount="BulkChangedCount"
                            OnStart="StartBulkEdit" OnSave="SaveBulkAsync" OnCancel="CancelBulkEdit" />
    }
    <div class="space-y-3">
        @foreach (var valuationSection in Sections)
        {
            var isOpen = IsExpanded(valuationSection.Type);
            <div class="panel overflow-hidden">
                <ValuationSectionHeader Title="@valuationSection.Title" LineCount="valuationSection.Lines.Count" Amount="valuationSection.Amount"
                                        IsOpen="isOpen" OnToggle="() => Toggle(valuationSection.Type)"
                                        ShowClaim="SelectedClaim is not null"
                                        Claimed="ClaimedTotalFor(valuationSection)" ClaimedPercent="PercentTotalFor(valuationSection)"
                                        Period="PeriodTotalFor(valuationSection)" />

                @if (isOpen)
                {
                    @if (valuationSection.Lines.Count == 0)
                    {
                        <div class="border-t border-line px-4 py-5 text-center text-content-subtle italic text-sm">
                            No @valuationSection.Title.ToLowerInvariant() lines yet.
                        </div>
                    }
                    else
                    {
                        @* `isolate` traps the sticky cells' z-10/20/30 in a local stacking context so they
                           never paint over the app header (sticky z-30 in MainLayout) when the page scrolls. *@
                        <div class="isolate border-t border-line overflow-x-auto overflow-y-auto max-h-[85vh]">
                            <table class="data-table data-table-dense">
                                <thead>
                                    <tr>
                                        <th class="sticky left-0 z-30 bg-canvas w-[72px]">Code</th>
                                        <th class="sticky left-[72px] z-30 bg-canvas min-w-[220px]">Description</th>
                                        <th class="whitespace-nowrap min-w-[220px]">Cost centre</th>
                                        <th class="text-right whitespace-nowrap">Qty</th>
                                        <th class="text-right whitespace-nowrap">Rate £</th>
                                        <th class="text-right whitespace-nowrap">Amount £</th>
                                        @if (SelectedClaim is not null)
                                        {
                                            <th class="text-right whitespace-nowrap"
                                                title="@PrevColumnTitle">Prev. %</th>
                                        }
                                        <th class="text-right whitespace-nowrap">% Complete</th>
                                        <th class="text-right whitespace-nowrap">Claimed £</th>
                                        @if (SelectedClaim is not null)
                                        {
                                            <th class="text-right whitespace-nowrap"
                                                title="Movement this period — cumulative claimed now less the previous claim's cumulative">Period £</th>
                                        }
                                        @if (CanEditLines)
                                        {
                                            <th class="text-right w-[80px]"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var currentArea = ""; }
                                    @foreach (var row in RowsFor(valuationSection))
                                    {
                                        @* The Variations valuationSection consolidates each variation's lines per cost
                                           centre into one row (VariationRollUps); a rolled-up row opens to show
                                           the lines beneath it, each with its own % complete. *@
                                        @if (row.RollUp is { } rollUp)
                                        {
                                            var isRollUpOpen = IsRollUpOpen(rollUp);
                                            <tr class="@(rollUp.CountsTowardTotals ?"bg-surface-raised" : "bg-surface-raised opacity-60")">
                                                <td class="sticky left-0 z-10 bg-surface font-mono text-xs text-content-subtle whitespace-nowrap">@rollUp.VariationRef</td>
                                                <td class="sticky left-[72px] z-10 bg-surface text-content">
                                                    <button type="button" @onclick="() => ToggleRollUp(rollUp)" aria-expanded="@isRollUpOpen"
                                                            title="@(isRollUpOpen ? "Hide this row's lines" : "Show this row's lines")"
                                                            class="flex items-start gap-1.5 text-left">
                                                        <svg class="@(isRollUpOpen ?"w-3.5 h-3.5 mt-1 shrink-0 text-content-subtle rotate-90 transition-transform" : "w-3.5 h-3.5 mt-1 shrink-0 text-content-subtle transition-transform")"
                                                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <path d="M9 6l6 6-6 6" />
                                                        </svg>
                                                        <span>
                                                            <span class="font-medium">@rollUp.VariationTitle</span>
                                                            <span class="block text-xs text-content-subtle">@rollUp.Lines.Count lines consolidated</span>
                                                        </span>
                                                    </button>
                                                </td>
                                                <td class="whitespace-nowrap">@CostCentreLabel(rollUp.CostCode)</td>
                                                <td class="text-right text-content-subtle whitespace-nowrap">—</td>
                                                <td class="text-right text-content-subtle whitespace-nowrap">—</td>
                                                <td class="text-right text-content font-medium whitespace-nowrap">@Money(rollUp.Amount)</td>
                                                @if (SelectedClaim is not null)
                                                {
                                                    <td class="text-right text-content-subtle whitespace-nowrap">
                                                        @(rollUp.CountsTowardTotals && HasPreviousClaim ? Pct(RollUpPreviousPercent(rollUp)) : "—")
                                                    </td>
                                                }
                                                <td class="text-right whitespace-nowrap">
                                                    @if (bulkEditing && CanEditEntries)
                                                    {
                                                        <span class="text-xs text-content-subtle" title="In bulk edit the percentages are typed per line below">per line</span>
                                                    }
                                                    else if (CanEditEntries && rollUp.CountsTowardTotals)
                                                    {
                                                        @if (editingRollUpKey == rollUp.Key)
                                                        {
                                                            <InlineValueEditor Value="@editValue" ValueChanged="value => { editValue = value; editError = false; }"
                                                                               Error="editError" SelectOnFocus="true" PreventBlur="true"
                                                                               AriaLabel="Percent complete for every line in this row" SaveLabel="Save percent complete" CancelLabel="Cancel edit"
                                                                               OnKeyDown="e => OnRollUpEditKeyDownAsync(e, rollUp)"
                                                                               OnBlur="() => OnRollUpEditBlurAsync(rollUp)"
                                                                               OnSave="() => CommitRollUpEditAsync(rollUp)"
                                                                               OnCancel="CancelRollUpEdit" />
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-baseline gap-1.5 justify-end">
                                                                <button type="button" title="Set the same % complete on every line in this row — open the row to set lines individually"
                                                                        @onclick="() => StartRollUpEdit(rollUp)"
                                                                        class="underline decoration-dotted underline-offset-2 hover:decoration-solid @(RollUpPercent(rollUp) == 0m ?"text-content-muted" : "text-content")">
                                                                    @Pct(RollUpPercent(rollUp))
                                                                </button>
                                                                @if (ShowRollUpDelta(rollUp))
                                                                {
                                                                    <span class="text-xs text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(RollUpDelta(rollUp))</span>
                                                                }
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content-muted">@(rollUp.CountsTowardTotals ? Pct(RollUpPercent(rollUp)) : "—")</span>
                                                        @if (ShowRollUpDelta(rollUp))
                                                        {
                                                            <span class="ml-1.5 text-xs text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(RollUpDelta(rollUp))</span>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-right whitespace-nowrap">
                                                    @(rollUp.CountsTowardTotals ? Money(RollUpClaimed(rollUp)) : "—")
                                                </td>
                                                @if (SelectedClaim is not null)
                                                {
                                                    <td class="text-right whitespace-nowrap @(RollUpPeriod(rollUp) == 0m ?"text-content-subtle" : "text-content")">
                                                        @(rollUp.CountsTowardTotals ? Money(RollUpPeriod(rollUp)) : "—")
                                                    </td>
                                                }
                                                @if (CanEditLines)
                                                {
                                                    <td class="text-right whitespace-nowrap">
                                                        <button type="button" @onclick="() => ToggleRollUp(rollUp)"
                                                                class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">@(isRollUpOpen ? "Hide lines" : "Show lines")</button>
                                                    </td>
                                                }
                                            </tr>
                                            continue;
                                        }
                                        var line = row.Line!;
                                        @* Area title rows — the estimate's own valuationSection headings ("Electrics",
                                           "Plumbing & Heating"), falling back to the line's cost-centre name,
                                           so the bill reads in the same titled areas as the estimate instead
                                           of one flat run. Consecutive runs in display order, never a re-sort. *@
                                        @if (ValuationReportAreas.GroupsByArea(valuationSection.Type))
                                        {
                                            var area = AreaTitleFor(line);
                                            if (ValuationReportAreas.StartsNewArea(area, currentArea))
                                            {
                                                currentArea = area;
                                                <tr>
                                                    <td colspan="2" class="sticky left-0 z-10 bg-surface pb-1.5 text-xs font-semibold whitespace-nowrap">@area</td>
                                                    <td colspan="@(ColumnCount - 2)"></td>
                                                </tr>
                                            }
                                        }
                                        <tr class="@(line.CountsTowardTotals ?"" : "opacity-60")">
                                            <td class="sticky left-0 z-10 bg-surface font-mono text-xs text-content-subtle whitespace-nowrap">
                                                <div>@(row.IsDetail ? "↳ " : "")@CodeFor(line)</div>
                                                @* The client's own item number for the line — how the contract document reads. *@
                                                @if (!string.IsNullOrWhiteSpace(line.ClientReference))
                                                {
                                                    <div class="text-xs text-content-muted">@line.ClientReference</div>
                                                }
                                            </td>
                                            <td class="sticky left-[72px] z-10 bg-surface text-content @(row.IsDetail ?"pl-7" : "")">
                                                <div class="font-medium">@TitleFor(line)</div>
                                                @if (!string.IsNullOrWhiteSpace(line.Comments))
                                                {
                                                    <div class="text-xs text-content-subtle">@line.Comments</div>
                                                }
                                                @if (!line.CountsTowardTotals)
                                                {
                                                    <span class="inline-block mt-0.5 eyebrow">@line.LineType</span>
                                                }
                                            </td>
                                            @* Where this line's value is allocated in the cost-centre master.
                                               Editable for Admin/MD/FD/PM at ANY claim status (the API enforces the
                                               same gate): recoding is a finance allocation, never a value change, so
                                               it stays open when the bill itself is locked by a preapproved claim.
                                               Variation recodes move the mirrored VO's committed budget with them. *@
                                            <td class="whitespace-nowrap">
                                                    @if (CanRecodeCostCentres)
                                                    {
                                                        <SearchSelect Options="@CostCentreOptionsFor(line)" WidthClass="w-52"
                                                                      Placeholder="Cost centre…"
                                                                      Value="@line.CostCode"
                                                                      Disabled="@(recodingLineId == line.ValuationLineItemId)"
                                                                      ValueChanged="value => SetCostCentreAsync(line, value)" />
                                                        @if (costCentreErrorLineId == line.ValuationLineItemId && costCentreError is not null)
                                                        {
                                                            <div class="text-xs text-negative mt-1">@costCentreError</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content-muted">@CostCentreLabel(line.CostCode)</span>
                                                    }
                                                </td>
                                            <td class="text-right whitespace-nowrap">@Num(line.Quantity)</td>
                                            <td class="text-right whitespace-nowrap">@Num(line.Rate)</td>
                                            <td class="text-right text-content whitespace-nowrap">
                                                @if (CanEditLines && line.ElementType == ValuationElementType.Variation
                                                     && CanReviseVariationValue && RevisableVoFor(line) is { } amountVo)
                                                {
                                                    @if (revisingVoLineId == line.ValuationLineItemId)
                                                    {
                                                        @* Explicit commit only: Enter / tick saves, Esc / cross discards. Deliberately NOT
                                                           the % editor's save-on-blur — re-pricing a VO moves the CVR and committed budget,
                                                           so it only ever happens on a deliberate commit; a click away leaves the editor open. *@
                                                        <InlineValueEditor Value="@reviseValue" ValueChanged="value => { reviseValue = value; reviseError = false; }"
                                                                           Error="reviseError" Disabled="reviseSaving" WidthClass="w-28"
                                                                           AriaLabel="Variation value" SaveLabel="Save variation value" CancelLabel="Cancel revise"
                                                                           OnKeyDown="e => OnVoReviseKeyDownAsync(e, line)"
                                                                           OnSave="() => CommitVoReviseAsync(line)"
                                                                           OnCancel="CancelVoRevise" />
                                                        @if (reviseFailure is not null)
                                                        {
                                                            <div class="text-xs text-negative mt-1">@reviseFailure</div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                title="Revise @(amountVo.VariationRef)'s value — re-prices this line and moves the CVR and committed cost-centre budget with it"
                                                                @onclick="() => StartVoRevise(line, amountVo)"
                                                                class="underline decoration-dotted underline-offset-2 hover:decoration-solid">@Money(line.LineAmount)</button>
                                                    }
                                                }
                                                else
                                                {
                                                    @Money(line.LineAmount)
                                                }
                                            </td>
                                            @if (SelectedClaim is not null)
                                            {
                                                @* Cumulative % claimed on the previous claim — the baseline the current
                                                   claim moves off, so the client can see what changed this period. *@
                                                <td class="text-right text-content-subtle whitespace-nowrap">
                                                    @(line.CountsTowardTotals && HasPreviousClaim ? Pct(PreviousPercentFor(line)) : "—")
                                                </td>
                                            }
                                            <td class="text-right whitespace-nowrap">
                                                @if (bulkEditing && CanEditEntries && line.CountsTowardTotals)
                                                {
                                                    <input type="text" inputmode="decimal"
                                                           value="@BulkValueFor(line)"
                                                           @oninput="@(e => SetBulkValue(line, e.Value?.ToString() ?? ""))"
                                                           aria-label="Percent complete"
                                                           class="field w-16 text-right px-2 py-1 focus:outline-none focus:ring-2 @(bulkErrorLines.Contains(line.ValuationLineItemId) ?"ring-2 ring-negative border-negative" : "focus:ring-accent focus:border-accent")" />
                                                }
                                                else if (CanEditEntries && line.CountsTowardTotals)
                                                {
                                                    @if (editingLineId == line.ValuationLineItemId)
                                                    {
                                                        @* Enter / tick saves, Esc / cross discards — and clicking away also saves a changed,
                                                           valid value (OnEditBlurAsync), so scrolling off and clicking another row's % can't
                                                           silently lose an edit. The tick/cross buttons preventDefault their mousedown so the
                                                           input doesn't blur first: the cross stays an explicit discard. Enter additionally
                                                           hops to the next line's % editor (see AdvanceToNextEditable) so a whole claim can be
                                                           keyed top-to-bottom without the mouse; the plain onfocus selects the value ready to
                                                           overtype. *@
                                                        <span class="inline-flex items-center gap-1">
                                                            @if (HasPreviousClaim)
                                                            {
                                                                @* Old percentage stays visible while editing so it's clear what's being changed from. *@
                                                                <span class="text-xs text-content-subtle mr-1 whitespace-nowrap">was @Pct(PreviousPercentFor(line))</span>
                                                            }
                                                            <InlineValueEditor Value="@editValue" ValueChanged="value => { editValue = value; editError = false; }"
                                                                               Error="editError" SelectOnFocus="true" PreventBlur="true"
                                                                               AriaLabel="Percent complete" SaveLabel="Save percent complete" CancelLabel="Cancel edit"
                                                                               OnKeyDown="e => OnEditKeyDownAsync(e, line)"
                                                                               OnBlur="() => OnEditBlurAsync(line)"
                                                                               OnSave="() => CommitEditAsync(line)"
                                                                               OnCancel="CancelEdit" />
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-baseline gap-1.5 justify-end">
                                                            <button type="button" title="Edit % complete"
                                                                    @onclick="() => StartEdit(line)"
                                                                    class="underline decoration-dotted underline-offset-2 hover:decoration-solid @(PercentFor(line) == 0m ?"text-content-muted" : "text-content")">
                                                                @Pct(PercentFor(line))
                                                            </button>
                                                            @if (ShowDelta(line))
                                                            {
                                                                <span class="text-xs text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(DeltaFor(line))</span>
                                                            }
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-content-muted">@(line.CountsTowardTotals ? Pct(PercentFor(line)) : "—")</span>
                                                    @if (ShowDelta(line))
                                                    {
                                                        <span class="ml-1.5 text-xs text-content-subtle whitespace-nowrap" title="Change from the previous claim">@SignedPct(DeltaFor(line))</span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-right whitespace-nowrap">
                                                @(line.CountsTowardTotals ? Money(ClaimedFor(line)) : "—")
                                            </td>
                                            @if (SelectedClaim is not null)
                                            {
                                                @* What this period moved in money. On Claim 1 (no previous claim)
                                                   everything claimed is movement, which is exactly right. *@
                                                <td class="text-right whitespace-nowrap @(PeriodFor(line) == 0m ?"text-content-subtle" : "text-content")">
                                                    @(line.CountsTowardTotals ? Money(PeriodFor(line)) : "—")
                                                </td>
                                            }
                                            @if (CanEditLines)
                                            {
                                                <td class="text-right whitespace-nowrap">
                                                    @if (line.ElementType == ValuationElementType.Variation)
                                                    {
                                                        @if (CanReviseVariationValue && RevisableVoFor(line) is { } actionVo)
                                                        {
                                                            @* Edits go through the VO revise pipeline so the VO, CVR and budget move together. *@
                                                            <button @onclick="() => StartVoRevise(line, actionVo)"
                                                                    title="Revise the variation's value — the VO, CVR and cost-centre budget move with it"
                                                                    class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">Revise</button>
                                                        }
                                                        else
                                                        {
                                                            @* Variation lines mirror approved VOs and can only change via the variation itself. *@
                                                            <span class="text-content-subtle text-xs" title="From an approved variation order — manage it on the Variations tab.">Locked</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <button @onclick="@(() => OnEditLine.InvokeAsync(line))"
                                                                class="text-content-subtle hover:text-content underline underline-offset-2 text-xs">Edit</button>
                                                        <button @onclick="@(() => RemoveLineAsync(line))"
                                                                class="ml-2 text-negative/80 hover:text-negative underline underline-offset-2 text-xs">Remove</button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

@* Extra accordion sections that live with the bill (e.g. valuation invoices) but are fed
   from their own store rather than the line items. *@
@if (ExtraSections is not null)
{
    <div class="mt-3">@ExtraSections</div>
}

@if (lines.Count > 0)
{
    <ValuationSummaryPanel Figures="figures" ClaimName="@SelectedClaim?.DisplayName"
                           PeriodClaimed="@(SelectedClaim is null ? null : PeriodClaimedTotal)" />
}

