@inject IQueryClient Queries
@inject ICommandSender Commands
@inject IXeroLedgerStore Ledger
@inject ICostCenterStore CostCenters

@* The purchase invoices behind one report line's Actual Cost of Sales figure on the
   Financials tab: every allocated Xero purchase line coded to the centre — or to any
   member centre, for a roll-up (credit notes negative, split lines showing this centre's
   share). Each whole line can be linked to the work order it pays against (unlinked lines
   count as non-work-order cost of sales) or moved to another cost centre; splits are
   re-cut on the cost allocation screen. Fetched on open, one ask per centre. *@
<Modal IsOpen="IsOpen"
       Title="@($"{Heading} · Actual cost of sales")"
       ShowFooter="false"
       OnCancel="OnClose"
       Class="max-w-6xl">
    @if (loading)
    {
        <p class="text-sm text-content-subtle italic">Loading allocated costs…</p>
    }
    else if (entries.Count == 0)
    {
        <EmptyState Message="No Xero purchase lines have been allocated to this report line yet." />
    }
    else
    {
        <div class="space-y-4">
            <div class="rounded-lg border border-line overflow-x-auto overflow-y-auto max-h-[60vh]">
                <table class="data-table data-table-dense">
                    <thead>
                        <tr>
                            <th class="whitespace-nowrap">Date</th>
                            @if (ShowCentreColumn)
                            {
                                <th class="whitespace-nowrap">Centre</th>
                            }
                            <th>Supplier</th>
                            <th class="whitespace-nowrap">Invoice</th>
                            <th>Description</th>
                            <th class="text-right whitespace-nowrap">Net £</th>
                            <th class="whitespace-nowrap">Work Order</th>
                            <th><span class="sr-only">Move</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in ResidentEntries)
                        {
                            var line = entry.Line;
                            <tr>
                                <td class="whitespace-nowrap">@(line.Date?.ToString("dd MMM yyyy") ?? "—")</td>
                                @if (ShowCentreColumn)
                                {
                                    <td class="font-mono text-xs text-content-subtle whitespace-nowrap">@entry.CostCode</td>
                                }
                                <td class="text-content">@line.Supplier</td>
                                <td class="whitespace-nowrap">@line.InvoiceNumber</td>
                                <td>
                                    @line.Description
                                    @if (line.IsSplit)
                                    {
                                        <span class="ml-1.5 text-xs font-medium border border-line rounded px-1.5 py-0.5"
                                              title="This centre's share of a line split across several cost centres">Split</span>
                                    }
                                </td>
                                <td class="text-right whitespace-nowrap @(line.Net < 0 ?"text-negative" : "text-content")">@MoneyExact(line.Net)</td>
                                <td class="whitespace-nowrap">
                                    @if (line.IsSplit)
                                    {
                                        @* Linking classifies the whole ledger line — a split's other shares
                                           would silently follow. Link whole lines only. *@
                                        <span class="text-xs text-content-subtle" title="Split lines can't be linked to a work order">—</span>
                                    }
                                    else if (IsAmountSplit(line))
                                    {
                                        @* The line pays several orders (or part of one) — the dropdown can't
                                           express that, so show the split and edit it in the split editor. *@
                                        <span class="inline-flex items-center gap-2">
                                            <span class="text-xs text-content" title="@SplitTitle(line)">
                                                Split · @line.Links.Count @(line.Links.Count == 1 ? "order" : "orders") · @MoneyExact(line.LinkedTotal)
                                            </span>
                                            <button type="button" disabled="@linkingLineIds.Contains(line.XeroLedgerLineId)"
                                                    class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                                    @onclick="() => splitEntry = entry">Edit split</button>
                                        </span>
                                    }
                                    else
                                    {
                                        var singleLinkId = SingleLinkId(line);
                                        <span class="inline-flex items-center gap-1.5">
                                            @* Keyed on a nonce so a failed save recreates the element — otherwise the
                                               browser keeps showing the picked work order even though it didn't stick. *@
                                            <select class="field w-64"
                                                    @key="@($"{line.XeroLedgerLineId}|{linkRevertNonce}")"
                                                    disabled="@linkingLineIds.Contains(line.XeroLedgerLineId)"
                                                    title="The work order this invoice line pays against — options that can't take the line's value are disabled; unlinked lines count as non-work-order cost of sales"
                                                    @onchange="e => LinkAsync(entry, e.Value?.ToString())">
                                                <option value="" selected="@(singleLinkId is null)">Not linked</option>
                                                @foreach (var order in LinkableWorkOrders)
                                                {
                                                    var isCurrent = singleLinkId == order.Order.WorkOrderId;
                                                    var remaining = RemainingFor(order.Order.WorkOrderId);
                                                    // Mirror the API's hard balance check so doomed picks aren't offered: a
                                                    // positive line must fit the order's remaining balance (plus its own net
                                                    // when re-selecting the order it's already linked to).
                                                    var fits = remaining is null || line.Net <= 0m
                                                        || line.Net <= remaining.Value + (isCurrent ? Math.Max(line.Net, 0m) : 0m);
                                                    <option value="@order.Order.WorkOrderId" selected="@isCurrent" disabled="@(!fits && !isCurrent)">
                                                        @($"WO-{order.Order.Number:0000} · {order.SubcontractorName}{(remaining is null ? "" : $" · {MoneyExact(remaining.Value)} left")}")
                                                    </option>
                                                }
                                            </select>
                                            <button type="button" disabled="@linkingLineIds.Contains(line.XeroLedgerLineId)"
                                                    title="Split this line across several work orders — for a bill that pays more than one order"
                                                    class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                                    @onclick="() => splitEntry = entry">Split…</button>
                                        </span>
                                    }
                                </td>
                                <td class="whitespace-nowrap text-right">
                                    @if (line.IsSplit)
                                    {
                                        @* Only a share of the line sits here — moving the whole line from this
                                           modal would silently drag the other centres' shares with it. Splits
                                           are re-cut on the cost allocation screen. *@
                                        <span class="text-xs text-content-subtle" title="Re-allocate split lines from the cost allocation screen">—</span>
                                    }
                                    else if (movingLineId == line.XeroLedgerLineId)
                                    {
                                        <span class="inline-flex items-center gap-1.5">
                                            <select class="field w-52"
                                                    disabled="@isMoving"
                                                    @onchange="e => MoveAsync(entry, e.Value?.ToString())">
                                                <option value="" selected>Move to…</option>
                                                @foreach (var centre in CostCenters.ActiveAlphabetical().Where(c => !string.Equals(c.Code, entry.CostCode, StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <option value="@centre.Code">@centre.Code @centre.Name</option>
                                                }
                                            </select>
                                            <button type="button" aria-label="Cancel move" disabled="@isMoving"
                                                    class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised"
                                                    @onclick="CancelMove">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                            </button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" disabled="@isMoving"
                                                class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                                @onclick="() => movingLineId = line.XeroLedgerLineId">Move</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="border-t-2 border-line-strong bg-surface-raised">
                        <tr class="font-semibold text-content">
                            <td colspan="@(ShowCentreColumn ? 5 : 4)">Total — allocated to this centre</td>
                            <td class="text-right whitespace-nowrap">@MoneyExact(ResidentEntries.Sum(entry => entry.Line.Net))</td>
                            <td class="whitespace-nowrap text-content-subtle text-xs">
                                @MoneyExact(ResidentEntries.Sum(entry => entry.Line.Net - (entry.Line.IsSplit ? 0m : entry.Line.LinkedTotal))) not linked
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (AttributionEntries.Count > 0)
            {
                @* The same re-attribution the Financials column applies: spend linked to a work
                   order moves from the invoice's Xero centre onto the order's centres, pro-rata
                   to the order's line values. Negative rows are this centre's spend moving out;
                   positive rows arrive via orders coded here. *@
                <div class="rounded-lg border border-line overflow-x-auto">
                    <p class="px-4 pt-3 pb-1 eyebrow">
                        Moved via work orders — linked spend follows the order's cost centres
                    </p>
                    <table class="data-table data-table-dense">
                        <tbody>
                            @foreach (var entry in AttributionEntries)
                            {
                                var line = entry.Line;
                                <tr class="text-content-muted">
                                    <td class="whitespace-nowrap">@(line.Date?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@line.Supplier</td>
                                    <td class="whitespace-nowrap">@line.InvoiceNumber</td>
                                    <td>@line.Description</td>
                                    <td class="whitespace-nowrap">
                                        <Pill Tone="Tone.Muted" Title="@(line.Net < 0m
                                                         ? $"Linked to {line.ViaWorkOrderRef} — moved onto that order's cost centres"
                                                         : $"Arrives via {line.ViaWorkOrderRef}, invoiced on {line.SourceCostCode}")">
                                            @line.ViaWorkOrderRef
                                        </Pill>
                                    </td>
                                    <td class="text-right whitespace-nowrap @(line.Net < 0m ?"text-negative" : "text-content")">@MoneyExact(line.Net)</td>
                                </tr>
                            }
                            <tr class="border-t-2 border-line-strong bg-surface-raised font-semibold text-content">
                                <td colspan="5">Total — actual cost of sales for this centre</td>
                                <td class="text-right whitespace-nowrap">@MoneyExact(entries.Sum(entry => entry.Line.Net))</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
            @if (moveError is not null)
            {
                <p class="text-sm text-negative">@moveError</p>
            }
            @if (linkError is not null)
            {
                <p class="text-sm text-negative">@linkError</p>
            }
        </div>
    }
</Modal>

<WorkOrderLinkSplitModal IsOpen="@(splitEntry is not null)"
                         ProjectId="@ProjectId"
                         LineId="@(splitEntry?.Line.XeroLedgerLineId ?? "")"
                         LineLabel="@(splitEntry is null ? "" : $"{splitEntry.Line.Supplier} · {splitEntry.Line.InvoiceNumber}")"
                         LineNet="@(splitEntry?.Line.Net ?? 0m)"
                         CurrentLinks="@(splitEntry?.Line.Links ?? Array.Empty<XeroWorkOrderLinkSlice>())"
                         Options="SplitOptions"
                         OnClose="() => splitEntry = null"
                         OnSaved="HandleSplitSavedAsync" />

