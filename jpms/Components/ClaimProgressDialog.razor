@using System.Text.Json
@inject IValuationReportStore Store
@implements IDisposable

@*
    "Set % complete" — the Valuation Report's % column, batched into a dialog: a list of lines with
    a new cumulative % each, saved as ONE RecordClaimEntries against the selected Draft claim. The
    same act as typing into the report row by row, batched into one save.
*@
<Modal IsOpen="IsOpen"
       Title="@($"Set % complete — {Claim?.DisplayName}")"
       ConfirmLabel="@(saving ? "Saving…" : $"Save {Pending.Count} line{(Pending.Count == 1 ? "" : "s")}")"
       ConfirmDisabled="@(saving || Pending.Count == 0 || !ClaimIsDraft)"
       OnCancel="Cancel"
       OnConfirm="SaveAsync"
       Class="max-w-3xl">
    @if (!ClaimIsDraft)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">
            @(Claim is null ? "No claim is selected." : $"{Claim.DisplayName} is {Claim.Status.DisplayName()} — % complete can only be recorded on a Draft claim.")
        </Notice>
    }
    else
    {
        <p class="text-xs text-content-subtle mb-3">
            Cumulative % complete to date on @Claim!.DisplayName — the same as typing into the report's % column,
            one save for the lot. 0–100 on contract lines; variation lines may go wider (a weighted % of a net variation).
        </p>
    }

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@error</Notice>
    }

    <div class="space-y-2">
        <div class="hidden sm:grid grid-cols-[1fr_5rem_6rem_1.5rem] gap-2 px-1">
            <span class="eyebrow">Line</span>
            <span class="eyebrow text-right">Now %</span>
            <span class="eyebrow text-right">New %</span>
            <span></span>
        </div>

        @foreach (var entry in Pending)
        {
            var row = entry;
            var line = LineFor(row.ValuationLineItemId);
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_5rem_6rem_1.5rem] gap-2 items-center">
                <div class="text-sm text-content truncate" title="@LabelFor(line)">@LabelFor(line)</div>
                <div class="text-right text-sm font-mono text-content-muted">@FormatPercent(CurrentPercentFor(row.ValuationLineItemId))</div>
                <input class="field text-right" type="number" step="any"
                       value="@row.PercentText" @oninput="e => { row.PercentText = e.Value?.ToString() ?? string.Empty; Publish(); }" />
                <button type="button" class="text-content-subtle hover:text-negative" title="Remove"
                        @onclick="() => Remove(row)">✕</button>
            </div>
        }

        @if (Pending.Count == 0)
        {
            <p class="text-sm text-content-subtle italic px-1">No lines yet — pick one below, or ask the assistant.</p>
        }

        <div class="flex items-center gap-2 pt-2">
            <SearchSelect Options="@LineOptions" WidthClass="w-full" Placeholder="Add a line…"
                          InputClass="bg-surface-field border border-line-strong px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
                          Value="@pickedLineId" ValueChanged="AddPicked" />
        </div>
    </div>
</Modal>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    /// <summary>The claim the entries land on — must be Draft to save.</summary>
    [Parameter] public ValuationClaim? Claim { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class PendingEntry
    {
        public string ValuationLineItemId { get; set; } = "";
        public string PercentText { get; set; } = "";
    }

    private readonly List<PendingEntry> Pending = new();
    private string pickedLineId = "";
    private string? error;
    private bool saving;
    private bool wasOpen;

    private bool ClaimIsDraft => Claim is { Status: ValuationClaimStatus.Draft };

    private IReadOnlyList<ValuationLineItem> Lines => Store.LinesFor(ProjectId);

    private IReadOnlyList<ClaimLine> Entries => Claim is null ? Array.Empty<ClaimLine>() : Store.EntriesFor(Claim.ValuationClaimId);

    protected override void OnInitialized()
    {
        Store.OnChange += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        // Each opening starts clean — last time's list must not read as this time's.
        if (IsOpen && !wasOpen)
        {
            Pending.Clear();
            error = null;
            pickedLineId = "";
        }
        wasOpen = IsOpen;
    }

    public void Dispose()
    {
        Store.OnChange -= StateHasChanged;
    }

    // ---- The list -------------------------------------------------------------------------------

    private IReadOnlyList<SearchSelect.Option> LineOptions =>
        Lines.Where(line => line.CountsTowardTotals)
            .Where(line => Pending.All(entry => entry.ValuationLineItemId != line.ValuationLineItemId))
            .OrderBy(line => line.ElementType).ThenBy(line => line.DisplayOrder)
            .Select(line => new SearchSelect.Option(line.ValuationLineItemId,
                $"{LabelFor(line)} — {FormatPercent(CurrentPercentFor(line.ValuationLineItemId))}"))
            .ToList();

    private void AddPicked(string lineId)
    {
        pickedLineId = "";
        if (string.IsNullOrWhiteSpace(lineId) || LineFor(lineId) is null) return;
        if (Pending.Any(entry => entry.ValuationLineItemId == lineId)) return;
        Pending.Add(new PendingEntry
        {
            ValuationLineItemId = lineId,
            PercentText = EditText(CurrentPercentFor(lineId))
        });
        Publish();
    }

    private void Remove(PendingEntry row)
    {
        Pending.Remove(row);
        Publish();
    }

    private ValuationLineItem? LineFor(string lineId) =>
        Lines.FirstOrDefault(line => line.ValuationLineItemId == lineId);

    private decimal CurrentPercentFor(string lineId) =>
        Entries.FirstOrDefault(entry => entry.ValuationLineItemId == lineId)?.PercentComplete ?? 0m;

    private static string LabelFor(ValuationLineItem? line) =>
        line is null
            ? "(line not on this report)"
            : line.ElementType == ValuationElementType.Variation
                ? $"{line.VariationRef} · {line.Description}"
                : $"{(string.IsNullOrWhiteSpace(line.CostCode) ? line.SectionName : line.CostCode)} · {line.Description}";

    private static string FormatPercent(decimal value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    // Every stored decimal place, trailing zeros trimmed — the seed for the input, so a saved
    // 33.3333% is not re-saved as the 33.33% the display shows.
    private static string EditText(decimal value) =>
        value.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture);

    // Any number, any decimals, positive or negative, on every kind of line; +/-100000 is only a
    // sanity rail against typos (the API applies the same one).
    private const decimal PercentRail = 100000m;

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task SaveAsync()
    {
        if (saving || Claim is null || !ClaimIsDraft) return;
        error = null;

        var entries = new List<ClaimEntryInput>();
        foreach (var row in Pending)
        {
            var line = LineFor(row.ValuationLineItemId);
            if (line is null)
            {
                error = "One of the lines is no longer on the report — remove it and save again.";
                return;
            }
            if (!FormNumber.TryParseAmount(row.PercentText, out var percent))
            {
                error = $"\"{LabelFor(line)}\" needs a number for its new %.";
                return;
            }
            if (percent < -PercentRail || percent > PercentRail)
            {
                error = $"\"{LabelFor(line)}\": {FormatPercent(percent)} is outside {FormatPercent(-PercentRail)}–{FormatPercent(PercentRail)}.";
                return;
            }
            entries.Add(new ClaimEntryInput(line.ValuationLineItemId, percent));
        }
        if (entries.Count == 0)
        {
            error = "Add at least one line.";
            return;
        }

        saving = true;
        try
        {
            await Store.RecordEntriesAsync(ProjectId, new RecordClaimEntries(Claim.ValuationClaimId, entries));
            await OnSaved.InvokeAsync();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't save the percentages. Please try again."; }
        finally { saving = false; }
    }

    private void Publish()
    {
        // The dialog once republished its live state to the in-portal assistant here. The chat is
        // retired (2026-08-27, MCP connector instead) — edits now only repaint.
    }

}
