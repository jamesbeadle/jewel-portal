@namespace Jewel.JPMS.Components

@* A dismissible outcome notice: a toned title row with its ✕, then whatever the caller has to
   say. Positive reads as done ("Email sent"), Warning as needs-a-look ("Partially linked"). *@
<div class="panel p-5 mb-4 @BorderClass space-y-2">
    <div class="flex items-center justify-between gap-2">
        <p class="text-xs uppercase tracking-wider font-semibold @TitleClass">@Title</p>
        <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                @onclick="() => OnDismiss.InvokeAsync()">✕</button>
    </div>
    @ChildContent
</div>

@code {
    public enum NoticeTone { Positive, Warning }

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public NoticeTone Tone { get; set; } = NoticeTone.Positive;
    [Parameter] public EventCallback OnDismiss { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string BorderClass => Tone == NoticeTone.Positive ? "border-positive/40" : "border-amber-500/40";
    private string TitleClass => Tone == NoticeTone.Positive ? "text-positive" : "text-amber-600";
}
