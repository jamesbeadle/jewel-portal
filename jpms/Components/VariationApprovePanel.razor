@using Jewel.JPMS.Contracts.Variations
@inject ICostCenterStore CostCenters
@implements IDisposable

@*
    The manual/tendered approval panel — builds a variation's value up from priced lines. Each line
    is coded to a cost centre (picked from the master, never typed free) and becomes a Variation line
    on the valuation report under the minted V-ref; the total is the agreed value. Nothing is written
    until "Approve … & raise VO" is pressed — that runs the commercial write-through server-side.
*@

<div class="space-y-3">
    @if (ShowHeading)
    {
        <h3 class="eyebrow">@(IsManual ? "Approve manually & raise Variation Order" : "Approve & raise Variation Order")</h3>
    }

    @if (!string.IsNullOrWhiteSpace(HelpOverride))
    {
        <p class="text-xs text-content-subtle">@HelpOverride</p>
    }
    else if (IsManual)
    {
        <p class="text-xs text-content-subtle">
            No winning tender has been selected — approving here raises the order without a
            subcontractor attached. The lines still write through to the Valuation Report, the CVR and
            the cost-centre budgets, exactly like a tendered approval.
        </p>
    }
    else
    {
        <p class="text-xs text-content-subtle">Approving writes these lines into the Valuation Report, the CVR and the cost-centre budgets.</p>
    }

    @* The panel's own validation, or the caller's report of a refused save — either way the reason
       belongs in front of the lines it is about, not on the page behind the dialog. *@
    @if (error is not null || SubmitError is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@(error ?? SubmitError)</p>
    }

    <div class="space-y-2">
        <div class="hidden sm:grid grid-cols-[1.3fr_1.7fr_4.5rem_6rem_6rem_1.5rem] gap-2 px-1">
            <span class="eyebrow">Cost centre</span>
            <span class="eyebrow">Description</span>
            <span class="eyebrow text-right">Qty</span>
            <span class="eyebrow text-right">Rate £</span>
            <span class="eyebrow text-right">Amount £</span>
            <span></span>
        </div>

        @foreach (var line in lines)
        {
            var row = line;
            <div class="grid grid-cols-1 sm:grid-cols-[1.3fr_1.7fr_4.5rem_6rem_6rem_1.5rem] gap-2 items-center">
                <SearchSelect Options="@CostCentreOptions" WidthClass="w-full" Placeholder="Cost centre…"
                              InputClass="bg-surface-field border border-line-strong px-3 py-2 focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent"
                              Value="@row.CostCode" ValueChanged="@(v => { row.CostCode = v; NotifyEdited(); })" />
                <input class="field" placeholder="Description"
                       value="@row.Description" @oninput="e => { row.Description = e.Value?.ToString() ?? string.Empty; NotifyEdited(); }" />
                <input class="field text-right" type="number" step="any"
                       value="@row.Qty" @oninput="e => { row.Qty = e.Value?.ToString() ?? string.Empty; NotifyEdited(); }" />
                <input class="field text-right" type="number" step="any"
                       value="@row.Rate" @oninput="e => { row.Rate = e.Value?.ToString() ?? string.Empty; NotifyEdited(); }" />
                <div class="text-right text-sm font-mono text-content whitespace-nowrap">@Money(LineAmount(row))</div>
                <button type="button" class="text-content-subtle hover:text-negative disabled:opacity-30"
                        title="Remove line" disabled="@(lines.Count == 1)" @onclick="() => RemoveLine(row)">✕</button>
            </div>
        }

        <div class="flex items-center justify-between pt-1">
            <button type="button" class="text-sm text-accent underline underline-offset-2" @onclick="AddLine">+ Add line</button>
            <p class="text-sm text-content-muted">Total <span class="ml-1 font-mono font-semibold text-content">@Money(Total)</span></p>
        </div>
    </div>

    <p class="text-xs text-content-subtle">
        Each line writes to the valuation report under this variation's V-ref, coded to its own cost
        centre. Use a negative rate for an omit — work removed from the contract scope.
    </p>

    <button type="button" class="btn-primary w-full" disabled="@Busy" @onclick="Submit">
        @(SubmitLabel ?? (IsManual ? "Approve manually & raise VO" : "Approve & raise VO"))
    </button>
</div>

@code {
    [Parameter] public bool IsManual { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter] public decimal? EstimatedValue { get; set; }
    [Parameter] public string DefaultDescription { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<ApproveRequest> OnApprove { get; set; }
    // Editing an existing (approved) variation: seed the rows from its current lines instead of a
    // single estimate line, and relabel the button / help for an edit rather than an approval.
    [Parameter] public IReadOnlyList<VariationLineInput>? InitialLines { get; set; }
    [Parameter] public string? SubmitLabel { get; set; }
    [Parameter] public string? HelpOverride { get; set; }
    // Why the caller's save was refused, shown where the panel shows its own validation.
    [Parameter] public string? SubmitError { get; set; }

    // ---- The assistant pipe (variation_edit_lines) ----------------------------------------------
    // Out: every edit raises OnLinesEdited so the host can republish the live rows
    // (AiTaskState.UpdateDraft) — the model reasons from what is on screen NOW. In: ReplaceLines
    // takes the model's schedule and REPLACES the rows (the lines array is the whole schedule by
    // stated contract), keeping a row's ValuationLineItemId when the model carried it. Optional:
    // a host with no assistant simply doesn't listen or call.

    /// <summary>Raised after any row changes, however it changed.</summary>
    [Parameter] public EventCallback OnLinesEdited { get; set; }

    private void NotifyEdited()
    {
        if (OnLinesEdited.HasDelegate) _ = OnLinesEdited.InvokeAsync();
    }

    /// <summary>The rows as the JSON the assistant task carries with every turn — the dialog's
    /// schema exactly (quantity and rate as NUMBERS, null while unparseable), so the model learns
    /// the shape it must send back.</summary>
    public string SnapshotLines() => System.Text.Json.JsonSerializer.Serialize(new
    {
        lines = lines.Select(row => new
        {
            valuationLineItemId = row.ValuationLineItemId,
            costCode = row.CostCode,
            description = row.Description,
            quantity = FormNumber.TryParseAmount(row.Qty, out var qty) ? qty : (decimal?)null,
            rate = FormNumber.TryParseAmount(row.Rate, out var rate) ? rate : (decimal?)null,
            amount = LineAmount(row)
        }).ToList()
    });

    /// <summary>
    /// The assistant's schedule, replacing the rows. A JSON object with a "lines" array of
    /// {valuationLineItemId?, costCode, description, quantity, rate}; numbers are tolerated as
    /// strings (the model is not the only writer). A malformed or empty proposal leaves the rows
    /// as they are — the user still presses Save lines, and the panel's own validation still runs.
    /// </summary>
    public void ReplaceLines(string fieldsJson)
    {
        if (string.IsNullOrWhiteSpace(fieldsJson)) return;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(fieldsJson);
            var root = document.RootElement;
            if (root.ValueKind != System.Text.Json.JsonValueKind.Object) return;
            if (!root.TryGetProperty("lines", out var proposed) || proposed.ValueKind != System.Text.Json.JsonValueKind.Array) return;

            var replacement = new List<LineRow>();
            foreach (var item in proposed.EnumerateArray())
            {
                if (item.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var row = new LineRow
                {
                    ValuationLineItemId = NullIfBlank(ReadText(item, "valuationLineItemId")),
                    CostCode = ReadText(item, "costCode") ?? "",
                    Description = ReadText(item, "description") ?? "",
                    Qty = ReadNumberText(item, "quantity") ?? "1",
                    Rate = ReadNumberText(item, "rate") ?? "0"
                };
                replacement.Add(row);
            }
            if (replacement.Count == 0) return;

            // A line id the model invented (or one from another variation) must not be sent back
            // as a re-price: only ids seeded from this variation's own lines survive.
            var known = lines.Where(row => row.ValuationLineItemId is not null)
                .Select(row => row.ValuationLineItemId!)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            foreach (var row in replacement)
                if (row.ValuationLineItemId is { } id && !known.Contains(id)) row.ValuationLineItemId = null;

            lines.Clear();
            lines.AddRange(replacement);
            error = null;
            StateHasChanged();
        }
        catch (System.Text.Json.JsonException)
        {
            // A malformed proposal is the model's problem, not the user's. The rows stand.
        }
    }

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? ReadText(System.Text.Json.JsonElement item, string name) =>
        item.TryGetProperty(name, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String
            ? value.GetString()
            : null;

    private static string? ReadNumberText(System.Text.Json.JsonElement item, string name)
    {
        if (!item.TryGetProperty(name, out var value)) return null;
        return value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.Number => value.GetDecimal().ToString(System.Globalization.CultureInfo.InvariantCulture),
            System.Text.Json.JsonValueKind.String when !string.IsNullOrWhiteSpace(value.GetString()) => value.GetString(),
            _ => null
        };
    }

    public sealed record ApproveRequest(string PrimaryCostCode, decimal Total, IReadOnlyList<VariationLineInput> Lines);

    private sealed class LineRow
    {
        // Set only on a row seeded from an existing report line; null on a row the user added.
        public string? ValuationLineItemId { get; set; }
        public string CostCode { get; set; } = "";
        public string Description { get; set; } = "";
        public string Qty { get; set; } = "1";
        public string Rate { get; set; } = "0";
    }

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");

    private readonly List<LineRow> lines = new();
    private string? error;

    protected override void OnInitialized()
    {
        CostCenters.OnChange += OnCostCentresChanged;
        if (InitialLines is { Count: > 0 })
        {
            // Editing: seed one row per existing line so the user adds to / edits the current build-up.
            foreach (var line in InitialLines)
                lines.Add(new LineRow
                {
                    ValuationLineItemId = line.ValuationLineItemId,
                    CostCode = line.CostCode,
                    Description = line.Description,
                    Qty = line.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    Rate = line.Rate.ToString(System.Globalization.CultureInfo.InvariantCulture)
                });
        }
        else
        {
            // Approving: seed a first line from the estimate so a simple one-line variation just needs a cost centre.
            lines.Add(new LineRow
            {
                Description = DefaultDescription,
                Qty = "1",
                Rate = EstimatedValue is { } est ? est.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0"
            });
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Fill the cost-centre master if it hasn't loaded yet, so the dropdowns have options.
        try { await CostCenters.ListAllAsync(); } catch { /* dropdown falls back to whatever is cached */ }
    }

    private void OnCostCentresChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => CostCenters.OnChange -= OnCostCentresChanged;

    private IReadOnlyList<SearchSelect.Option> CostCentreOptions =>
        CostCenters.ActiveAlphabetical()
            .Select(centre => new SearchSelect.Option(centre.Code, $"{centre.Code} {centre.Name}"))
            .ToList();

    private void AddLine()
    {
        lines.Add(new LineRow());
        NotifyEdited();
    }

    private void RemoveLine(LineRow row)
    {
        if (lines.Count > 1) lines.Remove(row);
        NotifyEdited();
    }

    private static decimal LineAmount(LineRow row) =>
        FormNumber.ParseAmount(row.Qty) * FormNumber.ParseAmount(row.Rate);

    private decimal Total => lines.Sum(LineAmount);


    private async Task Submit()
    {
        if (Busy) return;
        error = null;

        var built = new List<VariationLineInput>();
        foreach (var row in lines)
        {
            var costCode = row.CostCode?.Trim() ?? "";
            var qty = FormNumber.ParseAmount(row.Qty);
            var rate = FormNumber.ParseAmount(row.Rate);
            var blank = string.IsNullOrWhiteSpace(costCode)
                        && string.IsNullOrWhiteSpace(row.Description)
                        && qty == 0m && rate == 0m;
            // An untouched extra row is ignored; a seeded row the user has emptied is how a line is
            // removed — it simply isn't submitted, so the revision drops it.
            if (blank) continue;
            if (string.IsNullOrWhiteSpace(costCode))
            {
                error = "Every line needs a cost centre — pick one or clear the line.";
                return;
            }
            built.Add(new VariationLineInput(costCode, row.Description?.Trim() ?? "", qty, rate, row.ValuationLineItemId));
        }

        if (built.Count == 0)
        {
            error = "Add at least one line with a cost centre and value.";
            return;
        }

        var total = built.Sum(line => line.Quantity * line.Rate);
        if (total == 0m)
        {
            error = "The total can't be zero — enter the agreed values (negative rate for an omit).";
            return;
        }

        await OnApprove.InvokeAsync(new ApproveRequest(built[0].CostCode, total, built));
    }
}
