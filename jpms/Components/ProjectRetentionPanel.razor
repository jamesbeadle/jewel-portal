@using Jewel.JPMS.Commercial
@using Jewel.JPMS.Contracts.Retention
@inject SessionService Session
@inject IProjectRetentionStore Retention
@inject IValuationReportStore ValuationReport
@inject IValuationInvoiceStore Invoices
@implements IDisposable

@*
    The project's deposit & client-retention terms and their live position. Terms are stored
    (typically a 20% cash-up-front deposit and 5% / 2.5% / 6 or 12 months retention);
    everything else is calculated live from the valuation figures — the deposit's
    received/released/still-to-release trio from the contract sum and the contract-side
    works complete (ValuationSummaryFigures), the retention schedule via RetentionSchedule.
    The deposit releases automatically with each valuation claim; retention releases are
    confirmed manually — the schedule only ever forecasts.
*@

<div class="rounded-xl border border-line bg-surface-raised p-5 mb-6">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-content">Deposit & retention</h3>
        @if (CanEdit)
        {
            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="OpenTerms">
                @(Current is null ? "Add terms" : "Edit terms")
            </button>
        }
    </div>

    @if (Current is null)
    {
        <p class="text-sm text-content-subtle">
            No deposit or retention terms recorded. Add them to see the deposit release
            position, held-to-date and the release schedule here and on the Cashflow tab.
        </p>
    }
    else
    {
        <h4 class="eyebrow mb-2">Cash up front deposit</h4>
        @if (Current.DepositPercent <= 0m)
        {
            <p class="text-sm text-content-subtle mb-4">No cash up front deposit on this project.</p>
        }
        else
        {
            <p class="text-sm text-content-subtle mb-3">
                @Pct(Current.DepositPercent) of the contract sum received before works start ·
                released back to the client as works complete — each valuation claim's payment
                due is reduced by @Pct(Current.DepositPercent) of the works claimed on contract
                works, PC sums and contingency (variations excluded).
                @if (Current.DepositReleasedOpening > 0m)
                {
                    <text> · @Money(Current.DepositReleasedOpening) settled before tracking began</text>
                }
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                <div class="rounded-lg border border-line bg-surface px-3 py-2">
                    <p class="eyebrow"
                       title="Deposit % of the original contract sum — the cash the client paid up front">Received</p>
                    <p class="text-base font-semibold text-content">@Money(DepositReceived)</p>
                </div>
                <div class="rounded-lg border border-line bg-surface px-3 py-2">
                    <p class="eyebrow"
                       title="Deposit % of the contract-side works complete on the latest claim — already deducted from payments due">Released to date</p>
                    <p class="text-base font-semibold text-content">@Money(DepositReleasedToDate)</p>
                </div>
                <div class="rounded-lg border border-line bg-surface px-3 py-2">
                    <p class="eyebrow"
                       title="Received less released — still to be handed back over the remaining works">Still to release</p>
                    <p class="text-base font-semibold text-content">@Money(DepositReceived - DepositReleasedToDate)</p>
                </div>
            </div>
        }

        <h4 class="eyebrow mb-2">Retention</h4>
        <p class="text-sm text-content-subtle mb-3">
            @Pct(Current.RetentionPercent) held on works complete until practical completion ·
            @Pct(Current.CompletionReleasePercent) released at completion ·
            balance @Current.DefectsPeriodMonths months later
            @if (Current.PracticalCompletionAt is { } pc)
            {
                <text> · practical completion @pc.ToString("d MMM yyyy")</text>
            }
            else
            {
                <text> · practical completion date not set</text>
            }
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
            <div class="rounded-lg border border-line bg-surface px-3 py-2">
                <p class="eyebrow"
                   title="Retention % of total works complete on the latest valuation claim">Held to date</p>
                <p class="text-base font-semibold text-content">@Money(Schedule.HeldToDate)</p>
            </div>
            <div class="rounded-lg border border-line bg-surface px-3 py-2">
                <p class="eyebrow"
                   title="Confirmed releases only — money actually freed">Released to date</p>
                <p class="text-base font-semibold text-content">@Money(Schedule.ReleasedToDate)</p>
            </div>
            <div class="rounded-lg border border-line bg-surface px-3 py-2">
                <p class="eyebrow"
                   title="Held less released — still withheld by the client">Outstanding</p>
                <p class="text-base font-semibold text-content">@Money(Schedule.Outstanding)</p>
            </div>
        </div>

        <div class="space-y-2">
            @foreach (var (line, label) in new[]
            {
                (Schedule.CompletionRelease, $"{Pct(Current.CompletionReleasePercent)} at practical completion"),
                (Schedule.FinalRelease, $"Balance {Current.DefectsPeriodMonths} months after completion")
            })
            {
                <div class="flex items-center justify-between rounded-lg border border-line bg-surface px-3 py-2">
                    <div>
                        <p class="text-sm text-content">@label</p>
                        <p class="text-xs text-content-subtle">
                            @if (line.IsConfirmed)
                            {
                                <text>Released @line.ConfirmedAt?.ToString("d MMM yyyy")</text>
                            }
                            else if (line.DueOn is { } due)
                            {
                                <text>Due @due.ToString("d MMM yyyy") (forecast)</text>
                            }
                            else
                            {
                                <text>Due when practical completion is set (forecast)</text>
                            }
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <p class="text-sm font-semibold text-content">@Money(line.Amount)</p>
                        @if (!line.IsConfirmed && CanEdit)
                        {
                            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5"
                                    @onclick="() => OpenConfirm(line)">Confirm release</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<Modal IsOpen="@termsOpen" Title="@(Current is null ? "Add deposit & retention terms" : "Edit deposit & retention terms")"
       ConfirmLabel="@(busy ? "Saving…" : "Save terms")" CancelLabel="Cancel"
       ConfirmDisabled="@busy" OnConfirm="SaveTerms" OnCancel="CloseTerms">
    <div class="space-y-3">
        @if (error is not null)
        {
            <Notice Tone="Tone.Negative">@error</Notice>
        }

        <div class="grid grid-cols-2 gap-4">
            <div>
                <FormField Label="Cash up front deposit %">
                <input type="number" step="0.5" class="field" @bind="depositPercent" />
                </FormField>
                <p class="text-xs text-content-subtle mt-1">
                    Received from the client before works start and released back to them
                    against each valuation's contract-side works — every claim's payment due
                    is reduced by its share. 0 = no deposit.
                </p>
            </div>
            <div>
                <FormField Label="Released before tracking (£)">
                <input type="number" step="0.01" class="field" @bind="depositReleasedOpening" />
                </FormField>
                <p class="text-xs text-content-subtle mt-1">
                    Deposit releases already made or settled before the portal began
                    deducting them — excluded from future claim deductions. Leave 0 for a
                    project tracked from day one.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <FormField Label="Retention %">
                <input type="number" step="0.5" class="field" @bind="retentionPercent" />
                </FormField>
            </div>
            <div>
                <FormField Label="Released at completion %">
                <input type="number" step="0.5" class="field" @bind="completionReleasePercent" />
                </FormField>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <FormField Label="Defects period">
                <select class="field" @bind="defectsPeriodMonths">
                    <option value="6">6 months</option>
                    <option value="12">12 months</option>
                </select>
                </FormField>
            </div>
            <div>
                <FormField Label="Practical completion" Hint="Planned or achieved — anchors both release due dates. Leave empty if unknown.">
                <input type="date" class="field" @bind="practicalCompletionDate" />
                </FormField>
            </div>
        </div>
    </div>
</Modal>

<Modal IsOpen="@confirmOpen" Title="Confirm retention release"
       ConfirmLabel="@(busy ? "Saving…" : "Confirm release")" CancelLabel="Cancel"
       ConfirmDisabled="@(busy || ParsedConfirmAmount is not { } parsed || parsed <= 0m)" OnConfirm="SaveConfirm" OnCancel="CloseConfirm">
    <div class="space-y-3">
        @if (error is not null)
        {
            <Notice Tone="Tone.Negative">@error</Notice>
        }

        <p class="text-sm text-content-subtle">
            Records that this release actually happened and freezes the amount — the figure is
            prefilled with the forecast but can be adjusted to what was actually agreed.
        </p>

        <div>
            <FormField Label="Amount released (ex VAT)">
            <input type="number" step="0.01" class="field" @bind="confirmAmount" />
            </FormField>
        </div>
    </div>
</Modal>

