@namespace Jewel.JPMS.Components

@* A sortable table column's header: the label as a button, with the ▼/▲ marker when this column
   drives the sort. The table owns the sort state; the header only reports the click. *@
<button type="button"
        class="inline-flex items-center gap-1 uppercase tracking-wider font-semibold hover:text-content"
        title="Sort by @Label"
        @onclick="() => OnSort.InvokeAsync(Column)">
    @Label
    @if (IsActive)
    {
        <span aria-hidden="true">@(Descending ? "▼" : "▲")</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public string Column { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string ActiveColumn { get; set; } = "";
    [Parameter] public bool Descending { get; set; }
    [Parameter] public EventCallback<string> OnSort { get; set; }

    private bool IsActive => ActiveColumn == Column;
}
