@*
    One message in a threaded conversation, with its replies nested beneath it behind a left
    rule. Renders itself recursively — replies nest freely — and keeps the amber internal tint
    RequestConversation established, so "don't show the client" stays legible at every depth.
    Purely presentational: the hosting panel owns loading, posting and the reply state.
*@

<div class="rounded-lg border px-4 py-3 @(IsInternal ? "border-amber-500/40 bg-amber-500/[0.04]" : "border-line bg-surface-raised")">
    <div class="flex items-start justify-between gap-3 mb-2">
        <div class="flex items-center gap-2.5 min-w-0">
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-[11px] font-semibold @(IsInternal ? "bg-amber-500/15 text-amber-600" : "bg-surface text-content-muted border border-line")"
                  aria-hidden="true">@Initials()</span>
            <span class="text-sm font-semibold text-content truncate">@AuthorLabel()</span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            @if (ShowVisibility && IsInternal)
            {
                <span class="inline-flex items-center rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">Internal</span>
            }
            <time class="text-xs text-content-subtle whitespace-nowrap" datetime="@Entry.PostedAt.ToString("o")">
                @Entry.PostedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")
            </time>
        </div>
    </div>
    <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@Entry.Body</p>
    @if (CanReply)
    {
        <div class="mt-2">
            <button type="button" class="text-xs font-medium text-accent hover:underline"
                    @onclick="() => OnReply.InvokeAsync(Entry)">Reply</button>
        </div>
    }
    @if (Entry.Replies.Count > 0)
    {
        <div class="mt-3 space-y-3 border-l-2 border-line pl-3">
            @foreach (var reply in Entry.Replies)
            {
                <ConversationMessageCard Entry="reply" ShowVisibility="ShowVisibility"
                                         CanReply="CanReply" OnReply="OnReply" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ConversationEntry Entry { get; set; } = default!;

    /// <summary>Whether internal messages exist in this view at all — the client portal hides
    /// the badge because everything a client sees is shared by construction.</summary>
    [Parameter] public bool ShowVisibility { get; set; }

    [Parameter] public bool CanReply { get; set; }
    [Parameter] public EventCallback<ConversationEntry> OnReply { get; set; }

    private bool IsInternal => Entry.IsInternal;

    private string AuthorLabel() =>
        string.IsNullOrWhiteSpace(Entry.AuthorName) ? Entry.AuthorEmail : Entry.AuthorName;

    // Up to two initials for the author avatar — the same scanning aid RequestConversation uses.
    private string Initials()
    {
        var label = AuthorLabel().Trim();
        if (label.Length == 0) return "?";
        var words = label.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2 && !label.Contains('@'))
            return $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[^1][0])}";
        return char.ToUpperInvariant(label[0]).ToString();
    }
}
