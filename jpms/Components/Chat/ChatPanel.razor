    private string? conversationId;
    private string? agentKey;
    private string draft = "";
    private bool busy;
    private string? activityLabel;
    private string? error;
    private string? modelNote;
    private bool showCarryOn;
    // A continuation hop failed to reach the server (after one quiet retry). Continuing is always
    // safe — the server rebuilds the turn from its own transcript — so a Retry chip is offered.
    private bool showRetryContinue;
