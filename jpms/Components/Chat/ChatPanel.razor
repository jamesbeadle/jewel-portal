@namespace Jewel.JPMS.Components.Chat
@using System.Text.Json
@using Jewel.JPMS.Contracts.Ai
@using Jewel.JPMS.Services.Ai
@using Jewel.JPMS.Features.Projects
@using Microsoft.AspNetCore.Components.Forms
@inject SessionService Session
@inject ChatPanelState Chat
@inject AiTaskState AiTasks
@inject NavigationManager Nav
@inject ProjectListReadModel Projects
@inject ICommandSender Commands
@inject IQueryClient Queries
@implements IDisposable

@*
    The assistant panel. Desktop: a fixed column pinned to the right edge, whose width MainLayout
    also reserves as shell padding — so the page in the middle narrows rather than being covered.
    Mobile: the same element goes full-bleed and overlays everything.

    The conversation lives on the SERVER. This component sends one message and the scope it was sent
    from; it never sends history. See docs/ai/00-agent-architecture.md §3.

    It also drives TASKS: a page opens a registered dialog, starts an AiTask, and this panel runs the
    conversation that fills it in. The dialog's live contents ride along with every turn and the
    assistant's proposals come back as update_open_modal actions. Nothing here writes to JPMS — the
    user presses the dialog's own button. See docs/ai/00-agent-architecture.md §5.
*@

@if (CanUseAssistant)
{
    @if (Chat.IsOpen)
    {
        @* Mobile only: tapping beside a full-screen panel closes it. Desktop pushes rather than
           overlays, so the page behind stays live and must not be covered. *@
        <button type="button" @onclick="CloseChat" tabindex="-1" aria-hidden="true"
                class="md:hidden fixed inset-0 z-30 bg-canvas/70 cursor-default"></button>
    }

    <aside id="@DomId" class="@PanelClass" aria-label="Jewel Assistant"
           aria-hidden="@AriaHidden" inert="@(!Chat.IsOpen)">
        <div class="h-full flex flex-col bg-surface">

            <header class="shrink-0 border-b border-line">
                <div class="h-14 px-4 flex items-center justify-between gap-3">
                    <div class="min-w-0 flex items-center gap-2.5">
                        <span class="shrink-0 w-8 h-8 rounded-lg border border-line bg-surface-raised flex items-center justify-center text-accent">
                            <ChatIcon Class="w-4 h-4" />
                        </span>
                        <span class="min-w-0">
                            <span class="block text-sm font-semibold text-content truncate">Jewel Assistant</span>
                            <span class="block text-[11px] text-content-subtle truncate" title="@ContextLabel">@ContextLabel</span>
                            @if (AgentChip is { } chip)
                            {
                                @* Which hat is on. Only shown once a specialist agent is in force —
                                   the orchestrator is the resting state and not worth announcing. *@
                                <span class="block text-[11px] font-medium text-accent truncate">@chip</span>
                            }
                        </span>
                    </div>
                    <div class="shrink-0 flex items-center gap-1">
                        @if (Chat.HasAcknowledgedCost && messages.Count > 0)
                        {
                            @* Disabled mid-turn: clearing the transcript while a reply is in flight
                               lands the old conversation's messages, and its id, in the new chat. *@
                            <button type="button" @onclick="StartNewChat" title="New chat" aria-label="New chat" disabled="@busy"
                                    class="inline-flex items-center justify-center w-8 h-8 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-40">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            </button>
                        }
                        <button type="button" @onclick="CloseChat" title="Close" aria-label="Close assistant"
                                class="inline-flex items-center justify-center w-8 h-8 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                        </button>
                    </div>
                </div>
            </header>

            @if (AiTasks.Active is { } activeTask)
            {
                @* The task banner. Not a LoadGate — nothing here is loading; this says what the
                   conversation is FOR, so a panel full of variation talk is never a mystery. *@
                <div class="shrink-0 flex items-start gap-2 px-4 py-2 border-b border-line bg-accent/5">
                    <span class="grow min-w-0">
                        <span class="block eyebrow text-accent">Working on</span>
                        <span class="block text-xs leading-snug text-content-muted truncate"
                              title="@activeTask.BannerLabel">@activeTask.BannerLabel</span>
                    </span>
                    <button type="button" @onclick="EndTask" title="Stop working on this"
                            class="shrink-0 text-[11px] text-content-subtle hover:text-content underline underline-offset-2">
                        Done
                    </button>
                </div>
            }

            @if (!Chat.HasAcknowledgedCost)
            {
                @* ---- Cost gate: once per user, per browser. No composer behind it. ---- *@
                <div class="grow overflow-y-auto px-5 py-5">
                    <div class="rounded-xl border border-negative/40 bg-negative/5 p-4">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 shrink-0 mt-0.5 text-negative" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M10.3 3.9a2 2 0 0 1 3.4 0l7.3 12.6A2 2 0 0 1 19.3 19.5H4.7a2 2 0 0 1-1.7-3z" />
                                <path d="M12 9v4.2M12 16.4h.01" />
                            </svg>
                            <div class="min-w-0">
                                <p class="eyebrow text-negative mb-1">Billed feature</p>
                                <h2 class="text-sm font-semibold text-content mb-2">Using this assistant costs money</h2>
                                <p class="text-xs leading-relaxed text-content-muted mb-3">
                                    Every message you send calls the Claude API and is charged to Jewel's account.
                                    Long conversations cost more than short ones, because the whole thread is sent
                                    again with each reply.
                                </p>
                                <ul class="text-xs leading-relaxed text-content-muted space-y-1.5 mb-3">
                                    <li class="flex gap-2"><span class="text-content-faint" aria-hidden="true">&mdash;</span>
                                        Charges land on the company account, not a personal one.</li>
                                    <li class="flex gap-2"><span class="text-content-faint" aria-hidden="true">&mdash;</span>
                                        Every message and every look-up is recorded against your name.</li>
                                    <li class="flex gap-2"><span class="text-content-faint" aria-hidden="true">&mdash;</span>
                                        Having the panel open is free. Each message you send is not.</li>
                                </ul>

                                @if (AiTasks.Active is { } pending)
                                {
                                    @* The whole point of the gate, said in the terms of the thing they
                                       just clicked: this is where the RFI and its emails leave JPMS.
                                       Nothing has been sent yet and nothing will be if they decline. *@
                                    <div class="rounded-lg border border-line bg-surface px-3 py-2 mb-3">
                                        <p class="text-xs leading-relaxed text-content-muted">
                                            <span class="text-content font-medium">@pending.BannerLabel.</span>
                                            To do it, the assistant will read that record and every email tagged to it,
                                            and send them to the Claude API. Nothing has been sent yet.
                                        </p>
                                        <p class="text-[11px] leading-relaxed text-content-subtle mt-1.5">
                                            Decline and the form beside this panel still works — you just fill it in
                                            yourself.
                                        </p>
                                    </div>
                                }

                                <p class="text-[11px] leading-relaxed text-content-subtle">
                                    Access is limited to the commercial team for this reason.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <footer class="shrink-0 border-t border-line px-4 py-3 flex items-center justify-end gap-2">
                    <button type="button" class="btn-neutral" @onclick="CloseChat">Not now</button>
                    <button type="button" class="btn-primary" @onclick="AcknowledgeCost">I understand the cost</button>
                </footer>
            }
            else
            {
                @* ---- Persistent reminder: the gate is accepted once, this never goes away. ---- *@
                <div class="shrink-0 flex items-start gap-2 px-4 py-2 border-b border-line bg-surface-raised">
                    <svg class="w-3.5 h-3.5 shrink-0 mt-px text-negative" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M10.3 3.9a2 2 0 0 1 3.4 0l7.3 12.6A2 2 0 0 1 19.3 19.5H4.7a2 2 0 0 1-1.7-3z" />
                        <path d="M12 9v4.2M12 16.4h.01" />
                    </svg>
                    <p class="text-[11px] leading-snug text-content-subtle">
                        <span class="text-content-muted font-medium">Billed usage.</span>
                        Each message calls the Claude API and adds to Jewel's bill.
                    </p>
                </div>

                @if (messages.Count == 0 && !busy && AiTasks.Active is null)
                {
                    @* Suppressed during a task: the kick-off turn is on its way, and a greeting is
                       the panel not paying attention at the exact moment it was asked to do one
                       specific job. Deliberately just the one line — the header already names the
                       page in view, and the conversation itself is where the assistant shows what
                       it can do. *@
                    <div class="grow overflow-y-auto px-5 py-6 flex flex-col items-center justify-center text-center">
                        <span class="w-11 h-11 rounded-xl border border-line bg-surface-raised flex items-center justify-center text-accent mb-3">
                            <ChatIcon Class="w-5 h-5" />
                        </span>
                        <p class="text-sm font-semibold text-content">How can I help you today?</p>
                    </div>
                }
                else
                {
                    <div class="grow overflow-y-auto px-4 py-4 space-y-3.5">
                        @foreach (var message in messages)
                        {
                            var isUser = message.Role == AiChatRole.User;
                            <div class="flex flex-col @(isUser ? "items-end" : "items-start")">
                                <div class="@BubbleClass(isUser)">
                                    <p class="whitespace-pre-line">@message.Body</p>
                                </div>
                                <span class="mt-1 text-[10px] text-content-faint">@message.PostedAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        }

                        @if (lastToolsUsed.Count > 0 && !busy)
                        {
                            <div class="flex flex-wrap gap-1.5 pt-0.5">
                                @foreach (var tool in lastToolsUsed.Distinct())
                                {
                                    <span class="rounded-md border border-line bg-surface-raised px-2 py-0.5 text-[10px] text-content-faint">@tool</span>
                                }
                            </div>
                        }

                        @if (modelNote is not null && !busy)
                        {
                            @* The server stepped the model up a tier because the conversation had
                               outgrown the chosen one. Said quietly, once per turn — a reply that
                               billed as a bigger model must never be a mystery. *@
                            <p class="text-[10px] leading-snug text-content-faint">@modelNote</p>
                        }

                        @if (busy)
                        {
                            <div class="flex flex-col items-start">
                                <div class="rounded-2xl rounded-bl-md border border-line bg-surface-raised px-3.5 py-3 flex items-center gap-1.5">
                                    <span class="jpms-typing-dot w-1.5 h-1.5 rounded-full bg-content-subtle"></span>
                                    <span class="jpms-typing-dot jpms-typing-dot-2 w-1.5 h-1.5 rounded-full bg-content-subtle"></span>
                                    <span class="jpms-typing-dot jpms-typing-dot-3 w-1.5 h-1.5 rounded-full bg-content-subtle"></span>
                                </div>
                                @* Named, during a task, so a 20-second wait says what it is waiting
                                   on rather than leaving the user to wonder whether it hung. *@
                                <span class="mt-1 text-[10px] text-content-faint">@BusyLabel</span>
                            </div>
                        }

                        @if (error is not null)
                        {
                            <div class="rounded-lg border border-negative/40 bg-negative/5 px-3 py-2">
                                <p class="text-xs leading-snug text-content-muted">@error</p>
                            </div>
                        }

                        @if (showCarryOn && !busy)
                        {
                            @* One tap instead of typing "carry on": a new user message resets the
                               server's derived look-up budget, so this is all a continuation needs. *@
                            <button type="button" @onclick="CarryOn"
                                    class="rounded-lg border border-line bg-surface-raised px-3 py-1.5 text-xs leading-snug text-content-muted hover:text-content hover:border-line-strong transition">
                                Carry on
                            </button>
                        }
                    </div>
                }

                <footer class="shrink-0 border-t border-line px-3 py-3">
                    @if (attachedFiles.Count > 0 || uploadingFileName is not null || attachError is not null)
                    {
                        <div class="px-1 pb-2 space-y-1">
                            <div class="flex flex-wrap items-center gap-1.5">
                                @foreach (var name in attachedFiles)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-md border border-line bg-surface-raised px-2 py-0.5 text-[10px] text-content-muted">
                                        <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 12.5l-8.5 8.5a5.66 5.66 0 0 1-8-8l9-9a3.77 3.77 0 0 1 5.3 5.3l-9 9a1.89 1.89 0 0 1-2.7-2.7l8.3-8.3" />
                                        </svg>
                                        @name
                                    </span>
                                }
                                @if (uploadingFileName is not null)
                                {
                                    <span class="text-[10px] text-content-faint">Reading @uploadingFileName…</span>
                                }
                            </div>
                            @if (attachError is not null)
                            {
                                <p class="text-[10px] leading-snug text-negative">@attachError</p>
                            }
                        </div>
                    }
                    <div class="rounded-xl border border-line bg-surface-field transition focus-within:border-line-strong">
                        <textarea @bind="draft" @bind:event="oninput" @onkeydown="HandleComposerKeyDown"
                                  rows="2" maxlength="8000" disabled="@busy"
                                  placeholder="@ComposerPlaceholder" aria-label="Message"
                                  class="w-full resize-none bg-transparent px-3 pt-2.5 pb-1 text-sm leading-relaxed text-content placeholder:text-content-faint focus:outline-none disabled:opacity-60"></textarea>
                        <div class="flex items-center justify-between gap-2 px-2 pb-2">
                            <div class="min-w-0 flex items-center gap-1.5">
                                @* Attach a spreadsheet and the assistant reads it — the bridge for
                                   work still living in the boss's tracker. Extracted server-side
                                   once; the file itself is never stored. *@
                                <label for="jpms-chat-attachment" title="Attach a spreadsheet or text file (xlsx, csv, tsv, txt)"
                                       class="shrink-0 inline-flex items-center justify-center w-7 h-7 rounded-md cursor-pointer text-content-subtle hover:text-content hover:bg-surface-raised @(busy || uploadingFileName is not null ? "pointer-events-none opacity-40" : "")">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M21 12.5l-8.5 8.5a5.66 5.66 0 0 1-8-8l9-9a3.77 3.77 0 0 1 5.3 5.3l-9 9a1.89 1.89 0 0 1-2.7-2.7l8.3-8.3" />
                                    </svg>
                                </label>
                                <InputFile id="jpms-chat-attachment" OnChange="OnFileSelected" accept=".xlsx,.csv,.tsv,.txt" class="hidden" />
                                <span class="min-w-0 truncate pl-0.5 text-[10px] text-content-faint">@ComposerFootnote</span>
                            </div>
                            <div class="shrink-0 flex items-center gap-2">
                                @* The cost lever. Cheap is the default on purpose; the user's own
                                   pick is remembered per browser and wins from then on. Only a tier
                                   KEY leaves the browser — the server maps it to a model id. *@
                                <select @bind="BoundModelKey" disabled="@busy" title="@ModelHint" aria-label="Model"
                                        class="bg-transparent text-[10px] text-content-subtle hover:text-content focus:outline-none disabled:opacity-60 cursor-pointer">
                                    @foreach (var choice in AiModelCatalogue.All)
                                    {
                                        <option value="@choice.Key" title="@choice.Hint">@choice.DisplayName</option>
                                    }
                                </select>
                                <button type="button" class="btn-primary px-3 py-1.5" disabled="@CannotSend" @onclick="Send">
                                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M4 12l16-8-5.5 16-3.2-6.3z" />
                                    </svg>
                                    Send
                                </button>
                            </div>
                        </div>
                    </div>
                </footer>
            }
        </div>
    </aside>
}

@code {
    /// <summary>Stable id so the launchers can point aria-controls at the panel.</summary>
    public const string DomId = "jpms-chat-panel";

    private readonly List<AiChatMessage> messages = new();
    private List<string> lastToolsUsed = new();
    private string? conversationId;
    private string? agentKey;
    private string draft = "";
    private bool busy;
    private string? activityLabel;
    private string? error;
    private string? modelNote;
    private bool showCarryOn;
    // A task kick-off hands the previous conversation's id to the server so its tail can follow
    // the user into the fresh one (the handover Context row). Consumed by the next Send.
    private string? pendingPreviousConversationId;
    private bool resumeAttempted;
    private string modelKey = AiModelCatalogue.DefaultKey;
    private bool modelLoaded;
    // Files attached to THIS conversation, shown as chips above the composer. The contents live
    // server-side on the conversation (a Context row), so the chips are a reminder, not the data.
    private readonly List<string> attachedFiles = new();
    private string? uploadingFileName;
    private string? attachError;

    /// <summary>
    /// Uploads a chat attachment: bytes go up base64 in the command body, the server extracts the
    /// contents to text ONCE onto the conversation, and every later turn replays it to the model.
    /// Free — no Claude call happens until the user actually sends a message about it.
    /// </summary>
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || busy || uploadingFileName is not null) return;

        attachError = null;
        uploadingFileName = file.Name;
        StateHasChanged();

        try
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                attachError = $"\"{file.Name}\" is too big — the limit is 10 MB.";
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var receipt = await Commands.SendAsync(
                new AddAiAttachment(conversationId, file.Name, Convert.ToBase64String(buffer.ToArray()),
                    BuildScope(), string.Empty),
                CancellationToken.None);

            conversationId = receipt.ConversationId;
            _ = Chat.RememberConversationAsync(conversationId);
            attachedFiles.Add($"{receipt.FileName} · {receipt.Summary}");
        }
        catch (Exception ex)
        {
            // The server's refusals (wrong format, unreadable, too big) come back as sentences
            // worth showing verbatim.
            attachError = ex.Message;
        }
        finally
        {
            uploadingFileName = null;
        }
    }

    /// <summary>The picker's binding: normalises, remembers per user, and never blocks the UI on
    /// the write — a failed persist only costs the user one re-pick next visit.</summary>
    private string BoundModelKey
    {
        get => modelKey;
        set
        {
            var normalised = AiModelCatalogue.Normalise(value);
            if (normalised == modelKey) return;
            modelKey = normalised;
            _ = Chat.RememberModelAsync(modelKey);
        }
    }

    private string ModelHint =>
        AiModelCatalogue.Find(modelKey)?.Hint ?? "Which Claude model answers";

    /// <summary>Cheap by default; the user's stored choice wins once the session is known.</summary>
    private async Task TryLoadModelChoiceAsync()
    {
        if (modelLoaded) return;
        if (!CanUseAssistant) return; // Guarantees the session — and the storage key — are known.
        modelLoaded = true;
        var stored = await Chat.LoadStoredModelAsync();
        if (string.IsNullOrWhiteSpace(stored)) return;
        modelKey = AiModelCatalogue.Normalise(stored);
        StateHasChanged();
    }

    private bool CanUseAssistant =>
        Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role);

    // Widths mirror MainLayout's reserved shell padding and .modal-overlay-chat — change all three
    // together or the page and the panel will overlap. The slide itself is `chat-panel*` in
    // Styles/app.tailwind.css.
    //
    // The layer moves: a modal overlay is z-50, so while a chat-aware dialog is being worked
    // alongside the panel the panel has to sit ABOVE it, or the conversation the dialog is being
    // filled in from would be behind the dim.
    private string PanelClass
    {
        get
        {
            // Only from md up. Below that the panel is full-bleed, so lifting it above the overlay
            // would hide the very form it is meant to sit beside — and with the backdrop click
            // disabled there would be no way back to it. On a phone the modal wins.
            var layer = Chat.CoexistingModalOpen ? "z-40 md:z-[60]" : "z-40";
            var baseClass = $"chat-panel fixed top-0 bottom-0 right-0 {layer} "
                + "w-full md:w-[400px] lg:w-[440px] md:border-l border-line";
            return Chat.IsOpen ? $"{baseClass} chat-panel-open" : $"{baseClass} chat-panel-closed";
        }
    }

    private string AriaHidden => Chat.IsOpen ? "false" : "true";

    private string BubbleClass(bool isUser)
    {
        var baseClass = "max-w-[17rem] rounded-2xl px-3.5 py-2.5 text-sm leading-relaxed";
        return isUser
            ? $"{baseClass} rounded-br-md bg-accent text-accent-ink"
            : $"{baseClass} rounded-bl-md border border-line bg-surface-raised text-content-muted";
    }

    private bool CannotSend => busy || string.IsNullOrWhiteSpace(draft);

    // What it is doing right now beats what the task is broadly for, which beats nothing.
    private string BusyLabel => activityLabel ?? AiTasks.Active?.BusyLabel ?? "Thinking…";

    // The same words as the empty state above it — one voice, not two competing prompts.
    private string ComposerPlaceholder => AiTasks.Active is null
        ? "How can I help you today?"
        : "Tell it what to change…";

    // "Can't change anything yet" is true of the portal and false of the form beside the panel. The
    // second half of the task wording is the part that matters: the assistant never presses anything.
    private string ComposerFootnote => AiTasks.Active is null
        ? "Reads the portal; can't change anything yet"
        : "Fills in the form beside you. You still press the button.";

    // The panel's subject: the page in the middle column, named exactly as the header above it
    // names it, prefixed with the project when the page belongs to one.
    private string ContextLabel
    {
        get
        {
            var page = PageContext.LabelFor(CurrentPath, Session.ActiveRole) ?? "this page";
            return PageProject is { } project ? $"{project.Reference} · {page}" : page;
        }
    }

    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath;

    // Read from the URL, not CurrentProjectService: the remembered project is what sidebar links
    // aim at and falls back to the first active project, which would have the panel claim to be
    // looking at a different project from the one actually on screen.
    private Project? PageProject
    {
        get
        {
            const string prefix = "/projects/";
            var path = CurrentPath;
            if (!path.StartsWith(prefix, StringComparison.Ordinal)) return null;
            var rest = path[prefix.Length..];
            var slash = rest.IndexOf('/');
            var id = slash < 0 ? rest : rest[..slash];
            return id.Length == 0 ? null : Projects.Find(id);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleSessionChange;
        Chat.OnChange += StateHasChanged;
        AiTasks.OnChange += HandleTaskChanged;
        Projects.OnChanged += StateHasChanged;
        Nav.LocationChanged += HandleLocationChanged;
        await Chat.EnsureAcknowledgementLoadedAsync();
        await TryLoadModelChoiceAsync();
        await TryResumeAsync();
    }

    // The panel is instantiated before auth resolves, so the acknowledgement can only be read once
    // the session lands — the same reason SideNav defers its project fetch to this event.
    private void HandleSessionChange()
    {
        _ = Chat.EnsureAcknowledgementLoadedAsync();
        _ = TryLoadModelChoiceAsync();
        _ = TryResumeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Picks the thread back up after a refresh or a new tab. The server holds every transcript;
    /// all the browser forgets is WHICH conversation this panel was in, so the stored id plus
    /// ListAiConversation is a full resume. Once, only into an empty panel, and never over a turn
    /// in flight. A stored id that will not replay (deleted, or another environment's) is
    /// forgotten so it cannot fail on every load.
    /// </summary>
    private async Task TryResumeAsync()
    {
        if (resumeAttempted) return;
        if (!CanUseAssistant) return; // Also guarantees the session — and the storage key — are known.
        resumeAttempted = true;

        if (conversationId is not null || messages.Count > 0 || busy) return;
        var stored = await Chat.LoadStoredConversationIdAsync();
        if (string.IsNullOrWhiteSpace(stored)) return;

        try
        {
            var replay = await Queries.AskAsync(new ListAiConversation(stored), CancellationToken.None);

            // A turn may have started while the replay was in flight — its conversation wins.
            if (conversationId is not null || messages.Count > 0 || busy) return;
            if (replay.Count == 0)
            {
                await Chat.ForgetConversationAsync();
                return;
            }

            conversationId = stored;
            messages.AddRange(replay);
            StateHasChanged();
        }
        catch
        {
            await Chat.ForgetConversationAsync();
        }
    }

    private void HandleLocationChanged(object? sender, EventArgs args) => StateHasChanged();

    private void CloseChat() => Chat.Close();

    private async Task AcknowledgeCost()
    {
        await Chat.AcknowledgeCostAsync();
        // The queued kick-off goes now, and only now. Nothing has reached the Claude API before
        // this click, which is the whole point of the gate.
        await TryStartTaskAsync();
    }

    private void EndTask() => AiTasks.End();

    /// <summary>
    /// A task started, or ended. Fired by AiTaskState — never by an edit in the dialog, which would
    /// repaint the panel on every keystroke.
    /// </summary>
    private void HandleTaskChanged() => _ = InvokeAsync(async () =>
    {
        await TryStartTaskAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Opens the drafting conversation. A task always gets a FRESH conversation: the transcript is
    /// the account of how this one document came to say what it says (docs/ai §8), and starting it
    /// clean is also the cheapest possible first turn.
    ///
    /// <para>Does nothing until the billed-usage notice has been accepted — the kick-off simply
    /// stays queued in AiTaskState, and the user fills the form in by hand if they decline. It also
    /// stands off while a turn is in flight rather than consuming the kick-off and discovering that
    /// Send() will refuse it: the queue is left intact and Send's own tail retries. Taking it and
    /// dropping it would leave the dialog open, the banner up, and the assistant permanently idle.
    /// </para>
    /// </summary>
    private async Task TryStartTaskAsync()
    {
        if (AiTasks.Active is null) return;
        if (!Chat.HasAcknowledgedCost) return;
        if (busy) return;

        // TakePendingKickoff clears as it reads, so this is what makes the send exactly-once.
        var kickoff = AiTasks.TakePendingKickoff();
        if (string.IsNullOrWhiteSpace(kickoff)) return;

        // A task gets a fresh conversation, but the one the user was just in follows them across
        // as a handover: the server copies its tail into the new conversation as background, so
        // "draft it the way we just discussed" still means something.
        var previousConversationId = conversationId;
        StartNewChat();
        pendingPreviousConversationId = previousConversationId;
        draft = kickoff;
        await Send();
    }

    private void StartNewChat()
    {
        messages.Clear();
        lastToolsUsed = new List<string>();
        conversationId = null;
        agentKey = null;
        draft = "";
        error = null;
        modelNote = null;
        showCarryOn = false;
        pendingPreviousConversationId = null;
        attachedFiles.Clear();
        attachError = null;
        _ = Chat.ForgetConversationAsync();
    }

    /// <summary>The specialist agent in force, when one is — the orchestrator is the resting state
    /// and stays unannounced.</summary>
    private string? AgentChip =>
        agentKey is { } key
        && !string.Equals(key, AgentCatalogue.Orchestrator.Key, StringComparison.OrdinalIgnoreCase)
        && AgentCatalogue.Find(key) is { } agent
            ? $"{agent.DisplayName} agent"
            : null;

    /// <summary>
    /// Everything the assistant needs about where the user is. The portal map is derived from
    /// NavigationCatalog so it cannot drift; the task block carries the dialog's contents AS THEY
    /// STAND NOW, every turn, so an edit made a second ago is what the model reasons from.
    /// </summary>
    private AiScope BuildScope()
    {
        var (recordType, recordId) = RouteRecord.From(CurrentPath);
        return new AiScope(
            PageProject?.ProjectId,
            CurrentPath,
            PageContext.LabelFor(CurrentPath, Session.ActiveRole),
            Session.ActiveRole is { } role ? PortalMap.For(role) : null,
            recordType,
            recordId,
            AiTasks.Active is { } task
                ? new AiTaskScope(
                    task.TaskKey, task.ModalKey, task.RecordType,
                    task.RecordId, task.RecordReference, AiTasks.DraftJson)
                : null);
    }

    /// <summary>Folds one hop into the panel, then repaints so the status line moves.</summary>
    private void Fold(AiTurnResult result)
    {
        // Mid-turn assistant text is the model narrating its own next step ("Checking the
        // variations register…") — asked for in the system prompt precisely so the wait can say
        // what it is doing. It becomes the live status line, not a bubble; the reply that lands as
        // a message is the hop with no tools left to run.
        var working = result.Status == AiTurnStatus.NeedsContinue;
        string? narration = null;
        foreach (var message in result.NewMessages)
        {
            if (message.Role == AiChatRole.User) continue;
            if (working && message.Role == AiChatRole.Assistant && !string.IsNullOrWhiteSpace(message.Body))
            {
                narration = message.Body;
                continue;
            }
            messages.Add(message);
        }

        foreach (var step in result.Steps) lastToolsUsed.Add(step.Tool);
        foreach (var action in result.UiActions) Apply(action);

        agentKey = result.AgentKey;
        if (result.ModelNote is not null) modelNote = result.ModelNote;
        activityLabel = narration ?? result.LatestLabel;

        // No API key, or the call failed. Tell the dialog, so a form sitting blank waiting for a
        // draft fills itself in from the record instead.
        if (result.Status == AiTurnStatus.Unavailable) AiTasks.ReportAssistantUnavailable();

        StateHasChanged();
    }

    private async Task Send()
    {
        if (CannotSend) return;

        var text = draft.Trim();
        draft = "";
        error = null;
        busy = true;
        showCarryOn = false;
        activityLabel = null;
        modelNote = null;
        lastToolsUsed = new List<string>();

        // The handover only makes sense on the FIRST message of a fresh conversation; consumed
        // here so a retry cannot resend it into a conversation that meanwhile exists.
        var previousConversationId = conversationId is null ? pendingPreviousConversationId : null;
        pendingPreviousConversationId = null;

        // Show the user's own message straight away rather than waiting on the round trip. The
        // server's copy replaces it when the reply lands, so the id is only ever local.
        messages.Add(new AiChatMessage(
            Guid.NewGuid().ToString("N"), AiChatRole.User, text, null, DateTimeOffset.UtcNow));
        StateHasChanged();

        try
        {
            // The task block carries the dialog's contents AS THEY STAND NOW, every turn — so an
            // edit the user made a second ago is what the model reasons from, not a copy of the
            // form from three turns back.
            var scope = BuildScope();

            var result = await Commands.SendAsync(
                new SendAiMessage(conversationId, text, scope, string.Empty, previousConversationId, modelKey),
                CancellationToken.None);

            conversationId = result.ConversationId;
            _ = Chat.RememberConversationAsync(conversationId);

            // The optimistic user bubble STAYS. The server never echoes the user's message back in
            // NewMessages (a hop's result carries only what the hop created), so the old
            // remove-and-replace here removed and never replaced — the user's own words vanished
            // from the panel the moment the first hop landed, though the server had them all along
            // (which is why a refresh brought them back).

            // A turn is a sequence of hops. Each one is a single Claude call server-side, so the
            // panel can say what it is doing between them instead of sitting on one long request.
            // The cap tracks AiTurnRunner.MaxHops (10) with headroom — the server is authoritative.
            for (var hop = 0; hop < 12; hop++)
            {
                Fold(result);
                if (result.Status != AiTurnStatus.NeedsContinue) break;

                result = await Commands.SendAsync(
                    new ContinueAiTurn(conversationId, scope, string.Empty, modelKey), CancellationToken.None);
                conversationId = result.ConversationId;
            }

            if (result.Status == AiTurnStatus.Truncated)
            {
                error = "That took more look-ups than one message allows.";
                showCarryOn = true;
            }

            // No API key, or the Claude call failed. Tell the dialog, so a form that is sitting
            // blank waiting for a draft fills itself in from the record instead.
            if (result.Status == AiTurnStatus.Unavailable) AiTasks.ReportAssistantUnavailable();
        }
        catch (Exception ex)
        {
            error = $"Couldn't send that: {ex.Message}";
            AiTasks.ReportAssistantUnavailable();
        }
        finally
        {
            busy = false;
            activityLabel = null;
        }

        // A task started while this turn was in flight left its kick-off queued. Send it now.
        // Not recursive: TakePendingKickoff has already cleared the queue by the time Send runs
        // again, so the second pass returns immediately.
        await TryStartTaskAsync();
    }

    /// <summary>One tap instead of typing "carry on" — a new user message resets the server's
    /// derived look-up budget, so this is all a continuation needs.</summary>
    private async Task CarryOn()
    {
        showCarryOn = false;
        draft = "Carry on from where you got to.";
        await Send();
    }

    /// <summary>
    /// Enter sends; Shift+Enter stays a newline. Blazor cannot conditionally preventDefault, so the
    /// browser still inserts the newline behind Send's back — Send has already captured and cleared
    /// the draft by then (its synchronous head runs before the input event lands), so the clean-up
    /// afterwards just clears the stray newline the default action left in the box. The textarea is
    /// disabled while a turn is in flight, so nothing the user typed can be sitting there to lose.
    /// </summary>
    private async Task HandleComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || e.ShiftKey) return;
        await Send();
        draft = "";
    }

    /// <summary>
    /// UI tools are the only ones that run in the browser. Nothing security-relevant is asserted
    /// here — the worst a bad action can do is take the user to a page they can already open, or put
    /// a wrong word in a form they are looking at and have not submitted.
    /// </summary>
    private void Apply(AiUiAction action)
    {
        switch (action.Tool?.ToLowerInvariant())
        {
            case "navigate_to": ApplyNavigate(action); break;
            case "update_open_modal": ApplyModalUpdate(action); break;
            case "open_modal": ApplyOpenModal(action); break;
        }
    }

    private void ApplyNavigate(AiUiAction action)
    {
        try
        {
            using var document = JsonDocument.Parse(
                string.IsNullOrWhiteSpace(action.ArgumentsJson) ? "{}" : action.ArgumentsJson);
            if (!document.RootElement.TryGetProperty("route", out var routeElement)) return;

            Navigate(routeElement.GetString());
        }
        catch (JsonException)
        {
            // A malformed argument is the model's problem, not the user's. Stay put.
        }
    }

    /// <summary>
    /// The assistant's draft, on its way to the dialog. The arguments ARE the field values, so they
    /// go straight through: the dialog is the only thing that knows its own shape, and it validates
    /// and MERGES rather than replacing — a field the assistant did not mention keeps what the user
    /// typed. Nothing is created; the user still presses the dialog's button.
    /// </summary>
    private void ApplyModalUpdate(AiUiAction action)
    {
        if (AiTasks.Active is null) return;
        if (string.IsNullOrWhiteSpace(action.ArgumentsJson)) return;
        AiTasks.ApplyFromAssistant(action.ArgumentsJson);
    }

    /// <summary>
    /// Take the user to the page that owns a registered dialog. The page opens it on arrival — see
    /// ProjectRequestDetail's pending-task check. Only dialogs in the catalogue, and only ones this
    /// user's role may open, so the assistant cannot route anybody somewhere they'd be bounced from.
    /// </summary>
    private void ApplyOpenModal(AiUiAction action)
    {
        if (Session.ActiveRole is not { } role) return;

        try
        {
            using var document = JsonDocument.Parse(
                string.IsNullOrWhiteSpace(action.ArgumentsJson) ? "{}" : action.ArgumentsJson);
            var root = document.RootElement;

            var modal = ModalCatalog.Find(ReadString(root, "modal_key"));
            if (modal is null || !ModalCatalog.CanOpen(modal, new[] { role })) return;

            var recordId = ReadString(root, "record_id");
            if (string.IsNullOrWhiteSpace(recordId)) return;

            var projectId = ReadString(root, "project_id") ?? PageProject?.ProjectId;
            if (string.IsNullOrWhiteSpace(projectId)) return;

            Navigate(modal.RouteTemplate
                .Replace("{project}", projectId, StringComparison.Ordinal)
                .Replace("{record}", recordId, StringComparison.Ordinal)
                + "?openModal=" + modal.ModalKey);
        }
        catch (JsonException)
        {
        }
    }

    private static string? ReadString(JsonElement root, string name) =>
        root.ValueKind == JsonValueKind.Object
        && root.TryGetProperty(name, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private void Navigate(string? route)
    {
        // Relative paths only — never let a tool result become an off-site redirect.
        if (string.IsNullOrWhiteSpace(route) || !route.StartsWith('/') || route.StartsWith("//")) return;
        Nav.NavigateTo(route);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChange;
        Chat.OnChange -= StateHasChanged;
        AiTasks.OnChange -= HandleTaskChanged;
        Projects.OnChanged -= StateHasChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
