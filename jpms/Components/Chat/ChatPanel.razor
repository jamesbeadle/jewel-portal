        if (historyOpen)
        {
            historyLoadStarted = false;
            _ = TryLoadHistoryAsync();
        }
    }

    /// <summary>
    /// Carries a past conversation on: replays it from the server and makes it the live one — the
    /// next message continues that thread. Ends any task in force first (its dialog belongs to the
    /// conversation being put down, and its contents would ride along with every turn of the
    /// resumed one). Never over a turn in flight, and one at a time.
    /// </summary>
    private async Task ResumeConversationAsync(string id)
    {
        if (busy || resumingId is not null) return;

        resumingId = id;
        StateHasChanged();
        try
        {
            var replay = await Queries.AskAsync(new ListAiConversation(id), CancellationToken.None);
            if (busy) return; // A kick-off may have started a turn while the replay was in flight.
            if (replay.Count == 0)
            {
                // Deleted, or another environment's id. Drop the dead row rather than failing on
                // every press.
                history.RemoveAll(row => row.ConversationId == id);
                historyError = "That chat couldn't be loaded — it may have been removed.";
                return;
            }

            if (AiTasks.Active is not null) AiTasks.End();
            StartNewChat();
            conversationId = id;
            messages.AddRange(replay);
            // A past chat opens at its latest exchange — where it would be carried on from.
            RequestScrollToBottom(isUserAction: true);
        }
        catch
        {
            historyError = "That chat couldn't be loaded just now.";
        }
        finally
        {
            resumingId = null;
            StateHasChanged();
        }
    }

    private string HistoryTitle(AiConversationSummary row) =>
        string.IsNullOrWhiteSpace(row.Title) ? "Untitled chat" : row.Title;

    /// <summary>"JB-042 · Tue 14:32" — the project when the thread had one, then when it last moved.</summary>
    private string HistoryMeta(AiConversationSummary row)
    {
        var when = FormatWhen(row.LastMessageAt.ToLocalTime());
        return row.ProjectId is { } projectId && Projects.Find(projectId) is { } project
            ? $"{project.Reference} · {when}"
            : when;
    }

    private static string FormatWhen(DateTimeOffset local)
    {
        var today = DateTimeOffset.Now.Date;
        if (local.Date == today) return $"today {local:HH:mm}";
        if (local.Date == today.AddDays(-1)) return $"yesterday {local:HH:mm}";
        return local.Year == today.Year ? local.ToString("d MMM HH:mm") : local.ToString("d MMM yyyy");
    }

    private void HandleLocationChanged(object? sender, EventArgs args)
    {
        EndTaskIfPageGone();
        StateHasChanged();
    }

    /// <summary>
    /// The safety net under every page's own Dispose: a task whose owning page is no longer the
    /// one on screen is over, whatever the page did or didn't clean up. Without this, navigating
    /// away mid-task left <c>AiTasks.Active</c> dangling for the rest of the session — every later
    /// turn shipped stale form JSON for a dialog that no longer existed, assistant updates fell
    /// into a subscriber-less event, and the panel stayed lifted above every future modal
    /// (CoexistingModalOpen was never cleared).
    /// </summary>
    private void EndTaskIfPageGone()
    {
        if (AiTasks.Active is not { } task) return;
        var modal = ModalCatalog.Find(task.ModalKey);
        if (modal is not null && RouteMatchesTemplate(CurrentPath, modal.RouteTemplate)) return;
        AiTasks.End();
        Chat.SetCoexistence(false);
    }

    /// <summary>Whether a live path is an instance of a ModalCatalog route template — same
    /// segment count, literal segments equal, <c>{...}</c> segments matching anything. The
    /// template's own query string (work_order_edit's <c>?record=</c>) is ignored, and the
    /// Control Centre's legacy route counts as its canonical one.</summary>
    private static bool RouteMatchesTemplate(string path, string template)
    {
        var stem = template;
        var query = stem.IndexOf('?');
        if (query >= 0) stem = stem[..query];

        if (string.Equals(stem, "/control-centre", StringComparison.OrdinalIgnoreCase)
            && path.StartsWith("/requests/triage", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var wanted = stem.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var actual = path.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (wanted.Length != actual.Length) return false;
        for (var i = 0; i < wanted.Length; i++)
        {
            if (wanted[i].StartsWith('{')) continue;
            if (!string.Equals(wanted[i], actual[i], StringComparison.OrdinalIgnoreCase)) return false;
        }
        return true;
    }

    private void CloseChat() => Chat.Close();

    private async Task AcknowledgeCost()
    {
        await Chat.AcknowledgeCostAsync();
        // The queued kick-off goes now, and only now. Nothing has reached the Claude API before
        // this click, which is the whole point of the gate.
        await TryStartTaskAsync();
    }

    private void EndTask() => AiTasks.End();

    /// <summary>
    /// A task started, or ended. Fired by AiTaskState — never by an edit in the dialog, which would
    /// repaint the panel on every keystroke.
    /// </summary>
    private void HandleTaskChanged() => _ = InvokeAsync(async () =>
    {
        await TryStartTaskAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Opens the drafting conversation. A task always gets a FRESH conversation: the transcript is
    /// the account of how this one document came to say what it says (docs/ai §8), and starting it
    /// clean is also the cheapest possible first turn. Fresh server-side, that is — on SCREEN the
    /// chat the user was in stays put, dimmed above a divider, so the kick-off never reads as the
    /// panel throwing their conversation away.
    ///
    /// <para>Does nothing until the billed-usage notice has been accepted — the kick-off simply
    /// stays queued in AiTaskState, and the user fills the form in by hand if they decline. It also
    /// stands off while a turn is in flight rather than consuming the kick-off and discovering that
    /// Send() will refuse it: the queue is left intact and Send's own tail retries. Taking it and
    /// dropping it would leave the dialog open, the banner up, and the assistant permanently idle.
    /// </para>
    /// </summary>
    private async Task TryStartTaskAsync()
    {
        if (AiTasks.Active is null) return;
        if (!Chat.HasAcknowledgedCost) return;
        if (busy) return;

        // TakePendingKickoff clears as it reads, so this is what makes the send exactly-once.
        var kickoff = AiTasks.TakePendingKickoff();
        if (string.IsNullOrWhiteSpace(kickoff)) return;

        // Give the dialog a beat to publish its REAL state before the kick-off's scope is built.
        // A task started with "{}" while the dialog was still rendering (work_order_edit's
        // pre-filled lines, the composer's prefilled envelope) otherwise tells the model the form
        // is empty — and it then "helpfully" overwrites what was already there.
        for (var i = 0; i < 10 && !AiTasks.DraftPublishedSinceStart && AiTasks.Active is not null; i++)
            await Task.Delay(60);
        if (AiTasks.Active is null) return; // Ended while waiting (page navigated away).

        // A task gets a fresh conversation, but the one the user was just in follows them across
        // as a handover: the server copies its tail into the new conversation as background, so
        // "draft it the way we just discussed" still means something.
        var previousConversationId = conversationId;
        // The fresh conversation must not LOOK like the chat being wiped. The bubbles the user
        // was just reading stay on screen, dimmed above a divider — the visible mirror of the
        // handover below, which carries the same chat's tail to the server as background.
        var visibleTranscript = messages.ToList();
        StartNewChat();
        if (previousConversationId is not null && visibleTranscript.Count > 0)
        {
            messages.AddRange(visibleTranscript);
            carriedOverMessageCount = visibleTranscript.Count;
        }
        pendingPreviousConversationId = previousConversationId;
        nextSendIsKickoff = true;
        draft = kickoff;
        await Send();
    }

    // The next Send carries a task's machine-authored kick-off — rendered and stored as a badge,
    // never as the user's own words. Consumed by Send.
    private bool nextSendIsKickoff;

    /// <summary>The badge line for a kick-off: the task banner when one is in force (the honest
    /// short name of the job), else the instruction clipped. A badge in the carried-over region
    /// belongs to an EARLIER task, so it never borrows the live banner — that would relabel
    /// yesterday's kick-off with today's job.</summary>
    private string KickoffLabel(string body, bool isCarriedOver = false)
    {
        var banner = isCarriedOver ? null : AiTasks.Active?.BannerLabel;
        if (!string.IsNullOrWhiteSpace(banner)) return banner!;
        return body.Length <= 80 ? body : body[..80] + "…";
    }

    /// <summary>
    /// The header's New chat: a TRUE clean slate. Ends any task in force (otherwise the banner
    /// stays up and the dialog's contents keep riding along with every turn of the "fresh" chat),
    /// drops the staged file, and empties the panel. Nothing is destroyed — every past
    /// conversation stays persisted server-side and sits in the history list, one press from
    /// being carried on; the model just cannot see any of it from here.
    /// </summary>
    private void StartFresh()
    {
        // Deliberately NOT SetCoexistence(false): that flag belongs to the dialog, which may still
        // be open beside the panel — the user can carry on filling it in by hand.
        if (AiTasks.Active is not null) AiTasks.End();
        StartNewChat();
    }

    private void StartNewChat()
    {
        // The chat being put down belongs in the history list from this moment — refresh it so
        // "the one I was just in" is the first row, not a mystery absence.
        var hadConversation = conversationId is not null;

        messages.Clear();
        carriedOverMessageCount = 0;
        lastToolsUsed = new List<string>();
        conversationId = null;
        agentKey = null;
        draft = "";
        error = null;
        modelNote = null;
        showCarryOn = false;
        showRetryContinue = false;
        pendingPreviousConversationId = null;
        attachError = null;
        historyOpen = false;
        ClearStagedFile();

        if (hadConversation)
        {
            historyLoadStarted = false;
            _ = TryLoadHistoryAsync();
        }
    }

    /// <summary>The specialist agent in force, when one is — the orchestrator is the resting state
    /// and stays unannounced.</summary>
    private string? AgentChip =>
        agentKey is { } key
        && !string.Equals(key, AgentCatalogue.Orchestrator.Key, StringComparison.OrdinalIgnoreCase)
        && AgentCatalogue.Find(key) is { } agent
            ? $"{agent.DisplayName} agent"
            : null;

    /// <summary>
    /// Everything the assistant needs about where the user is. The portal map is derived from
    /// NavigationCatalog so it cannot drift; the task block carries the dialog's contents AS THEY
    /// STAND NOW, every turn, so an edit made a second ago is what the model reasons from.
    /// </summary>
    private AiScope BuildScope()
    {
        var (recordType, recordId) = RouteRecord.From(CurrentPath);
        // The route's project wins; the page's published project fills the gap on routes with no
        // /projects/{id} segment (the Control Centre's auto-matched email project, above all).
        // Without the fallback the turn context says "no project is in view" on those routes while
        // the page note names one — and the model believes the instruction over the note.
        return new AiScope(
            PageProject?.ProjectId ?? Chat.CurrentPageProjectId(),
            CurrentPath,
            PageContext.LabelFor(CurrentPath, Session.ActiveRole),
            Session.ActiveRole is { } role ? PortalMap.For(role) : null,
            recordType,
            recordId,
            AiTasks.Active is { } task
                ? new AiTaskScope(
                    task.TaskKey, task.ModalKey, task.RecordType,
                    task.RecordId, task.RecordReference, AiTasks.DraftJson)
                : null,
            Chat.CurrentPageNote(),
            // The selected email's message id (the Control Centre's open queue email), so
            // read_selected_email can default to "the one in front of them" instead of the model
            // transcribing an opaque Graph id out of the prose note.
            Chat.CurrentPageMailId());
    }

    /// <summary>Folds one hop into the panel, then repaints so the status line moves.</summary>
    private async Task FoldAsync(AiTurnResult result)
    {
        // Mid-turn assistant text is the model narrating its own next step ("Checking the
        // variations register…") — asked for in the system prompt precisely so the wait can say
        // what it is doing. It becomes the live status line, not a bubble; the reply that lands as
        // a message is the hop with no tools left to run.
        var working = result.Status == AiTurnStatus.NeedsContinue;
        string? narration = null;
        foreach (var message in result.NewMessages)
        {
            if (message.Role == AiChatRole.User) continue;
            if (working && message.Role == AiChatRole.Assistant && !string.IsNullOrWhiteSpace(message.Body))
            {
                narration = message.Body;
                continue;
            }
            messages.Add(message);
        }

        foreach (var step in result.Steps) lastToolsUsed.Add(step.Tool);
        foreach (var action in result.UiActions) await ApplyAsync(action);

        agentKey = result.AgentKey;
        if (result.ModelNote is not null) modelNote = result.ModelNote;
        activityLabel = narration ?? result.LatestLabel;

        // No API key, or the call failed. Tell the dialog, so a form sitting blank waiting for a
        // draft fills itself in from the record instead.
        if (result.Status == AiTurnStatus.Unavailable) AiTasks.ReportAssistantUnavailable();

        RequestScrollToBottom();
        StateHasChanged();
    }

    private async Task Send()
    {
        if (CannotSend) return;

        // The staged attachment goes up FIRST — its row must precede the message row so the model
        // reads the file with this very message. A failed upload aborts the send with the error
        // shown and the draft intact; an attachment-only send (no text) stops after the pill.
        AiAttachmentReceipt? attached = null;
        if (stagedFileBase64 is not null)
        {
            attached = await UploadStagedFileAsync();
            if (attached is null) return;
        }

        if (string.IsNullOrWhiteSpace(draft))
        {
            if (attached is not null)
            {
                messages.Add(new AiChatMessage(
                    Guid.NewGuid().ToString("N"), AiChatRole.Context,
                    $"Attached {attached.FileName} ({attached.Summary}) — the assistant can read it now.",
                    "attachment", DateTimeOffset.UtcNow));
                RequestScrollToBottom(isUserAction: true);
                StateHasChanged();
            }
            return;
        }

        var text = draft.Trim();
        var isKickoff = nextSendIsKickoff;
        nextSendIsKickoff = false;
        draft = "";
        error = null;
        busy = true;
        Chat.SetAssistantBusy(true);
        showCarryOn = false;
        showRetryContinue = false;
        hopNavigated = false;
        hopOpenedModal = false;
        activityLabel = null;
        modelNote = null;
        lastToolsUsed = new List<string>();

        // The handover only makes sense on the FIRST message of a fresh conversation; consumed
        // here so a retry cannot resend it into a conversation that meanwhile exists.
        var previousConversationId = conversationId is null ? pendingPreviousConversationId : null;
        pendingPreviousConversationId = null;

        // Show the user's own message straight away rather than waiting on the round trip. A
        // kick-off carries its marker, so it renders as a task badge, never as their words. Kept
        // by reference so a send that never reached the server can take it back out.
        var optimistic = new AiChatMessage(
            Guid.NewGuid().ToString("N"), AiChatRole.User, text, isKickoff ? "kickoff" : null, DateTimeOffset.UtcNow);
        messages.Add(optimistic);
        // The attachment pill sits UNDER the message it went with — sent together, shown together.
        if (attached is not null)
        {
            messages.Add(new AiChatMessage(
                Guid.NewGuid().ToString("N"), AiChatRole.Context,
                $"Attached {attached.FileName} ({attached.Summary}) — the assistant can read it now.",
                "attachment", DateTimeOffset.UtcNow));
        }
        // Their bubble and the working indicator must be in view the moment Send is pressed.
        RequestScrollToBottom(isUserAction: true);
        StateHasChanged();

        try
        {
            // The task block carries the dialog's contents AS THEY STAND NOW, every turn — so an
            // edit the user made a second ago is what the model reasons from, not a copy of the
            // form from three turns back.
            var scope = BuildScope();

            var result = await Commands.SendAsync(
                new SendAiMessage(conversationId, text, scope, string.Empty, previousConversationId, modelKey, isKickoff),
                CancellationToken.None);

            conversationId = result.ConversationId;

            // The optimistic user bubble STAYS. The server never echoes the user's message back in
            // NewMessages (a hop's result carries only what the hop created), so the old
            // remove-and-replace here removed and never replaced — the user's own words vanished
            // from the panel the moment the first hop landed, though the server had them all along
            // (which is why a refresh brought them back).

            await RunHopLoopAsync(result);
        }
        catch (Exception)
        {
            if (conversationId is null)
            {
                // The very first send of a new conversation never reached the server (or never
                // answered) — take the optimistic bubble back out and put the words back in the
                // box, so nothing the user typed is lost.
                messages.Remove(optimistic);
                draft = text;
                error = "Couldn't reach the server — nothing was sent. Your message is back in the box.";
            }
            else
            {
                // The conversation exists server-side, so the safe move is to CONTINUE it, not to
                // resend the message (a resend would land the same words twice).
                error = "Lost the connection sending that. Press Retry — nothing needs typing again.";
                showRetryContinue = true;
            }
            AiTasks.ReportAssistantUnavailable();
        }
        finally
        {
            busy = false;
            Chat.SetAssistantBusy(false);
            activityLabel = null;
            // The reply, or the Retry / Carry on chip that stands in for one, must be in view.
            RequestScrollToBottom();
        }

        // A task started while this turn was in flight left its kick-off queued. Send it now.
        // Not recursive: TakePendingKickoff has already cleared the queue by the time Send runs
        // again, so the second pass returns immediately.
        await TryStartTaskAsync();
    }

    /// <summary>One tap instead of typing "carry on" — a new user message resets the server's
    /// derived look-up budget, so this is all a continuation needs.</summary>
    private async Task CarryOn()
    {
        showCarryOn = false;
        draft = "Carry on from where you got to.";
        await Send();
    }

    /// <summary>
    /// A turn is a sequence of hops. Each one is a single Claude call server-side, so the panel
    /// can say what it is doing between them instead of sitting on one long request. The cap
    /// tracks AiTurnRunner.MaxHops (10) with headroom — the server is authoritative.
    /// </summary>
    private async Task RunHopLoopAsync(AiTurnResult result)
    {
        for (var hop = 0; hop < 12; hop++)
        {
            // A hop whose Claude call outlived the request's inline wait answers Pending with a
            // reply id. The call is still running server-side; collect it before folding.
            try
            {
                result = await CollectIfPendingAsync(result);
            }
            catch (CommandFailedException ex)
            {
                // The server set the reply aside ("the conversation moved on", "already
                // collected"): its own words, and Retry — a plain continuation — is the recovery.
                error = ex.Message;
                showRetryContinue = true;
                AiTasks.ReportAssistantUnavailable();
                return;
            }
            if (result.Status == AiTurnStatus.Pending)
            {
                error = "That reply is taking longer than expected. Nothing is lost — press Retry to carry on.";
                showRetryContinue = true;
                AiTasks.ReportAssistantUnavailable();
                return;
            }

            await FoldAsync(result);
            if (result.Status != AiTurnStatus.NeedsContinue) break;

            // A hop that navigated or opened a dialog changed which page owns the screen — give
            // that page a beat to initialise before the next hop's scope is built from it, or the
            // model reads a half-loaded page (no task, no note, no project) and reasons from it.
            await WaitForPageAfterActionsAsync();

            // Scope is REBUILT per hop, not reused from the send: a navigate_to in the previous
            // hop changed the page (and the page note), and the next hop must reason from where
            // the user is NOW — that is what makes navigate-then-act chains work.
            try
            {
                result = await Commands.SendAsync(
                    new ContinueAiTurn(conversationId, BuildScope(), string.Empty, modelKey), CancellationToken.None);
            }
            catch (Exception)
            {
                // One quiet retry, then the Retry chip. Continuing is ALWAYS safe — the server
                // rebuilds the turn from its own transcript — so a network blip must not kill a
                // nine-hop job with everything it has already read.
                await Task.Delay(800);
                try
                {
                    result = await Commands.SendAsync(
                        new ContinueAiTurn(conversationId, BuildScope(), string.Empty, modelKey), CancellationToken.None);
                }
                catch (Exception)
                {
                    error = "Lost the connection mid-task. Nothing is lost — press Retry to carry on from where it got to.";
                    showRetryContinue = true;
                    return;
                }
            }
            conversationId = result.ConversationId;
        }

        if (result.Status == AiTurnStatus.Truncated)
        {
            error = "That took more look-ups than one message allows.";
            showCarryOn = true;
        }

        // No API key, or the Claude call failed. Tell the dialog, so a form that is sitting
        // blank waiting for a draft fills itself in from the record instead.
        if (result.Status == AiTurnStatus.Unavailable) AiTasks.ReportAssistantUnavailable();
    }

    /// <summary>
    /// Collects a pending reply (docs/ai/07-reply-collection.md). Each collect is a short request
    /// the server holds for up to twenty seconds, so the loop is a handful of polls, not a storm;
    /// the whole wait is bounded here, after which the Retry chip takes over. Anything other than
    /// Pending — the finished hop, or a failure — comes back to the hop loop unchanged. A lost
    /// connection mid-collect gets one quiet retry, exactly like a lost continuation.
    /// </summary>
    private async Task<AiTurnResult> CollectIfPendingAsync(AiTurnResult result)
    {
        var clock = System.Diagnostics.Stopwatch.StartNew();
        var missed = 0;
        while (result.Status == AiTurnStatus.Pending
               && result.PendingReplyId is { } replyId
               && conversationId is not null
               && clock.Elapsed < PendingWait)
        {
            if (string.IsNullOrWhiteSpace(activityLabel)) activityLabel = "Still thinking…";
            RequestScrollToBottom();
            StateHasChanged();
            await Task.Delay(PendingPollGap);
            try
            {
                result = await Commands.SendAsync(
                    new CollectAiReply(conversationId, replyId, BuildScope(), string.Empty), CancellationToken.None);
                missed = 0;
            }
            catch (CommandFailedException)
            {
                // The server's own refusal — never a blip, so never retried here.
                throw;
            }
            catch (Exception)
            {
                if (++missed >= 2) throw;
                await Task.Delay(800);
            }
        }
        return result;
    }

    /// <summary>How long the panel keeps collecting one reply before offering Retry. Above the
    /// server's own background budget (three and a half minutes), so a slow answer is always
    /// collected rather than abandoned a poll too early.</summary>
    private static readonly TimeSpan PendingWait = TimeSpan.FromMinutes(5);
    /// <summary>The pause between one collect answering Pending and the next going out.</summary>
    private static readonly TimeSpan PendingPollGap = TimeSpan.FromMilliseconds(750);

    /// <summary>The Retry chip: picks a broken turn back up with a plain continuation. Safe to
    /// press any number of times — a hop that never answered wrote nothing.</summary>
    private async Task RetryContinue()
    {
        if (busy || conversationId is null) return;

        showRetryContinue = false;
        error = null;
        busy = true;
        Chat.SetAssistantBusy(true);
        RequestScrollToBottom(isUserAction: true);
        try
        {
            var result = await Commands.SendAsync(
                new ContinueAiTurn(conversationId, BuildScope(), string.Empty, modelKey), CancellationToken.None);
            conversationId = result.ConversationId;
            await RunHopLoopAsync(result);
        }
        catch (Exception)
        {
            error = "Still couldn't reach the server. Check the connection and press Retry again.";
            showRetryContinue = true;
        }
        finally
        {
            busy = false;
            Chat.SetAssistantBusy(false);
            activityLabel = null;
            RequestScrollToBottom();
        }
        await TryStartTaskAsync();
    }

    /// <summary>
    /// The beat between a hop that changed the page and the next hop's scope build. An opened
    /// dialog is waited on properly — up to two seconds for the destination page to honour the
    /// query and start the task, checked every tenth — because the whole point of the next hop is
    /// usually that dialog. A plain navigation gets a short fixed grace for the page's providers
    /// to register. Neither wait throws and both are bounded, so a page that never settles costs
    /// tenths of a second, not the turn.
    /// </summary>
    private async Task WaitForPageAfterActionsAsync()
    {
        var openedModal = hopOpenedModal;
        var navigated = hopNavigated;
        hopOpenedModal = false;
        hopNavigated = false;

        if (openedModal)
        {
            for (var i = 0; i < 20 && AiTasks.Active is null; i++)
                await Task.Delay(100);
            return;
        }
        if (navigated) await Task.Delay(400);
    }

    /// <summary>
    /// Enter sends; Shift+Enter stays a newline. Blazor cannot preventDefault for one key without
    /// swallowing them all, so chat-composer-keys.js (wired in OnAfterRenderAsync) stops the
    /// browser's own newline for the sending Enter; this handler only does the sending.
    /// </summary>
    private async Task HandleComposerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || e.ShiftKey) return;
        await Send();
    }

    /// <summary>
    /// UI tools are the only ones that run in the browser. Nothing security-relevant is asserted
    /// here — the worst a bad action can do is take the user to a page they can already open, or put
    /// a wrong word in a form they are looking at and have not submitted.
    /// </summary>
    private async Task ApplyAsync(AiUiAction action)
    {
        switch (action.Tool?.ToLowerInvariant())
        {
            // Every one of these is the assistant OPERATING the portal — from the first one until
            // the turn ends, the takeover overlay (MainLayout) dims the app and blocks its input
            // so the user and the assistant cannot fight over the same controls. Cleared by
            // SetAssistantBusy(false) in Send's finally, whatever way the turn ends.
            case "navigate_to": Chat.SetAssistantControlling(true); hopNavigated = true; ApplyNavigate(action); break;
            case "update_open_modal": Chat.SetAssistantControlling(true); ApplyModalUpdate(action); break;
            case "open_modal": Chat.SetAssistantControlling(true); hopOpenedModal = true; ApplyOpenModal(action); break;
            case "stage_triage_tag":
            case "stage_triage_todo":
            case "stage_triage_work_order":
            case "select_email":
                // Addressed to the open page (the Control Centre), not to the panel — and AWAITED,
                // so the next hop's page note reports what actually staged or selected. The server
                // only offers these tools on that route, so a missing handler means the builds
                // have drifted — said out loud, per the open_modal lesson: a silent no-op here is
                // the model narrating a stage that never happened. (select_email was exactly that
                // silent no-op until 2026-08-22: the tool, the server offer and the page handler
                // all existed, and this switch had no case for it.)
                Chat.SetAssistantControlling(true);
                if (!await Chat.DispatchPageActionAsync(action.Tool!.ToLowerInvariant(), action.ArgumentsJson ?? "{}"))
                    error = "The assistant tried to act on this page, but no page is listening for "
                        + $"\"{action.Tool}\". That happens in the Control Centre — if you ARE there, "
                        + "hard-refresh the browser and restart the API (the builds have drifted).";
                break;
            default:
                // A Ui tool this build has no case for. The server said "handed to browser", so a
                // silent drop here is the model narrating an action that never happened — the
                // single worst failure this feature has. Say so.
                error = $"The assistant asked for a browser action this app build doesn't know "
                    + $"(\"{action.Tool}\"). If the portal was just updated, hard-refresh the "
                    + "browser and restart the API.";
                break;
        }
    }

    private void ApplyNavigate(AiUiAction action)
    {
        try
        {
            using var document = JsonDocument.Parse(
                string.IsNullOrWhiteSpace(action.ArgumentsJson) ? "{}" : action.ArgumentsJson);
            if (!document.RootElement.TryGetProperty("route", out var routeElement)) return;

            Navigate(routeElement.GetString());
        }
        catch (JsonException)
        {
            // A malformed argument is the model's problem, not the user's. Stay put.
        }
    }

    /// <summary>
    /// The assistant's draft, on its way to the dialog. The arguments ARE the field values, so they
    /// go straight through: the dialog is the only thing that knows its own shape, and it validates
    /// and MERGES rather than replacing — a field the assistant did not mention keeps what the user
    /// typed. Nothing is created; the user still presses the dialog's button.
    /// </summary>
    private void ApplyModalUpdate(AiUiAction action)
    {
        if (AiTasks.Active is null || string.IsNullOrWhiteSpace(action.ArgumentsJson))
        {
            // No task at all: the server offered update_open_modal but nothing is open to receive
            // it. Say so — a silent drop is the model narrating a filled form that was never filled
            // (the update_open_modal twin of the open_modal "ok meant only posted" lesson).
            error = "The assistant tried to fill a dialog, but none is open beside the chat right now. "
                + "Open the dialog first, then ask again.";
            return;
        }
        // ApplyFromAssistant returns whether a LIVE dialog took the update. A false means the draft
        // reached no open dialog — the wrong page, or one that just closed — so nothing was filled;
        // the model finds the same truth in next hop's dialog-contents block, but the user should
        // not be left looking at an unchanged form while the model says "done".
        if (!AiTasks.ApplyFromAssistant(action.ArgumentsJson))
        {
            error = "The assistant sent lines to a dialog that isn't open on this page any more, so "
                + "nothing was filled in. Re-open the dialog and ask again — nothing was changed.";
        }
    }

    /// <summary>
    /// Take the user to the page that owns a registered dialog. The page opens it on arrival — see
    /// ProjectRequestDetail's pending-task check. Only dialogs in the catalogue, and only ones this
    /// user's role may open, so the assistant cannot route anybody somewhere they'd be bounced from.
    /// </summary>
    private void ApplyOpenModal(AiUiAction action)
    {
        if (Session.ActiveRole is not { } role) return;

        try
        {
            using var document = JsonDocument.Parse(
                string.IsNullOrWhiteSpace(action.ArgumentsJson) ? "{}" : action.ArgumentsJson);
            var root = document.RootElement;

            // Every refusal below SAYS SO in the panel. A silently dropped open_modal is the worst
            // failure this feature has: the model narrates a dialog that never appeared and nobody
            // can tell which link in the chain broke.
            var modalKey = ReadString(root, "modal_key");
            var modal = ModalCatalog.Find(modalKey);
            if (modal is null)
            {
                error = $"The assistant asked to open a dialog this app build doesn't know (\"{modalKey}\"). "
                        + "If the portal was just updated, hard-refresh the browser and restart the API.";
                return;
            }
            if (!ModalCatalog.CanOpen(modal, new[] { role }))
            {
                error = $"The assistant asked to open \"{modal.DisplayName}\", but the {role} role can't open it.";
                return;
            }

            var route = modal.RouteTemplate;

            // A dialog on a project page needs a project; a whole-company dialog (compose_email on
            // the Control Centre) has no {project} in its route and needs none.
            if (route.Contains("{project}", StringComparison.Ordinal))
            {
                var projectId = ReadString(root, "project_id") ?? PageProject?.ProjectId;
                if (string.IsNullOrWhiteSpace(projectId))
                {
                    error = $"The assistant asked to open \"{modal.DisplayName}\" but didn't say which project.";
                    return;
                }
                route = route.Replace("{project}", projectId, StringComparison.Ordinal);
            }

            // A dialog that works FROM a record (variation_draft) needs one; a dialog that CREATES
            // (manual_variation) has no {record} in its route and needs none.
            if (route.Contains("{record}", StringComparison.Ordinal))
            {
                var recordId = ReadString(root, "record_id");
                if (string.IsNullOrWhiteSpace(recordId))
                {
                    error = $"The assistant asked to open \"{modal.DisplayName}\" without saying which record.";
                    return;
                }
                route = route.Replace("{record}", recordId, StringComparison.Ordinal);
            }

            // A route template may already carry a query of its own (work_order_edit's ?record=,
            // because work orders have no detail page) — append with & rather than a second ?.
            Navigate(route + (route.Contains('?') ? "&openModal=" : "?openModal=") + modal.ModalKey);
        }
        catch (JsonException)
        {
        }
    }

    private static string? ReadString(JsonElement root, string name) =>
        root.ValueKind == JsonValueKind.Object
        && root.TryGetProperty(name, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private void Navigate(string? route)
    {
        // Relative paths only — never let a tool result become an off-site redirect. A backslash
        // counts: browsers read "/\host/…" as "//host/…". (The server checks the same in
        // AiNavigationRoute.IsPortalPath; this is the last line.)
        if (string.IsNullOrWhiteSpace(route) || !route.StartsWith('/') || route.StartsWith("//") || route.Contains('\\')) return;
        Nav.NavigateTo(route);
    }

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChange;
        Chat.OnChange -= StateHasChanged;
        AiTasks.OnChange -= HandleTaskChanged;
        Projects.OnChanged -= StateHasChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }
}
