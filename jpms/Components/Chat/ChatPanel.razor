    private string modelKey = AiModelCatalogue.DefaultKey;
    private bool modelLoaded;
    private string? uploadingFileName;
    private string? attachError;
    // The staged file: picked with the paperclip, dropped, or pasted — sent WITH the next message,
    // like any chat app. Nothing reaches the server until Send, so removing the chip costs nothing.
    private string? stagedFileName;
    private string? stagedFileBase64;
    // Set only when the staged file is an image — drives the thumbnail beside the pill.
    private string? stagedFileMediaType;

    private const long MaxAttachmentBytes = 10 * 1024 * 1024;
    // Above this an image is downscaled in the browser before staging: Claude reads nothing above
    // ~1568px, so a 12-megapixel site photo is pure upload weight. Below it the original bytes go
    // as-is — a small PNG screenshot stays pixel-crisp instead of picking up JPEG artefacts.
    private const long MaxOriginalImageBytes = 1_500_000;

    private static readonly Dictionary<string, string> ImageMediaTypes =
        new(StringComparer.OrdinalIgnoreCase)
        {
            [".png"] = "image/png",
            [".jpg"] = "image/jpeg",
            [".jpeg"] = "image/jpeg",
            [".gif"] = "image/gif",
            [".webp"] = "image/webp"
        };

    private string? StagedImageDataUrl =>
        stagedFileMediaType is null || stagedFileBase64 is null
            ? null
            : $"data:{stagedFileMediaType};base64,{stagedFileBase64}";

    /// <summary>Stages the picked file locally. The upload happens on Send, attachment first so
    /// the model reads it with that very message. Oversized images are downscaled in the browser
    /// first (canvas, via RequestImageFileAsync) rather than refused — the paste that arrives here
    /// is usually a screenshot the user cannot easily make smaller.</summary>
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null || busy || uploadingFileName is not null) return;

        attachError = null;
        try
        {
            var isImage = ImageMediaTypes.TryGetValue(Path.GetExtension(file.Name), out var mediaType);

            var toRead = file;
            var name = file.Name;
            if (isImage && file.Size > MaxOriginalImageBytes)
            {
                // JPEG on purpose: what arrives this big is photographs, and 1568px JPEG keeps a
                // drawing or a defect photo perfectly readable at a fraction of the bytes. (An
                // animated gif flattens to its first frame — the model only ever saw one anyway.)
                toRead = await file.RequestImageFileAsync("image/jpeg", 1568, 1568);
                mediaType = "image/jpeg";
                name = Path.ChangeExtension(name, ".jpg");
            }

            if (toRead.Size > MaxAttachmentBytes)
            {
                attachError = $"\"{file.Name}\" is too big — the limit is 10 MB.";
                return;
            }

            await using var stream = toRead.OpenReadStream(maxAllowedSize: MaxAttachmentBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            stagedFileName = name;
            stagedFileBase64 = Convert.ToBase64String(buffer.ToArray());
            stagedFileMediaType = isImage ? mediaType : null;
        }
        catch (Exception ex)
        {
            attachError = ex.Message;
        }
    }

    private void ClearStagedFile()
    {
        stagedFileName = null;
        stagedFileBase64 = null;
        stagedFileMediaType = null;
    }

    /// <summary>
    /// Sends the staged file: the server extracts the contents to text ONCE onto the conversation
    /// and every later turn replays it to the model. Returns the receipt, or null on failure (the
    /// error is shown and the draft is left intact for a retry).
    /// </summary>
    private async Task<AiAttachmentReceipt?> UploadStagedFileAsync()
    {
        if (stagedFileBase64 is null || stagedFileName is null) return null;

        uploadingFileName = stagedFileName;
        StateHasChanged();
        try
        {
            var receipt = await Commands.SendAsync(
                new AddAiAttachment(conversationId, stagedFileName, stagedFileBase64, BuildScope(), string.Empty),
                CancellationToken.None);

            conversationId = receipt.ConversationId;
            ClearStagedFile();
            return receipt;
        }
        catch (Exception ex)
        {
            // The server's refusals (wrong format, unreadable, too big) come back as sentences
            // worth showing verbatim. The file stays staged; fix or remove it and send again.
            attachError = ex.Message;
            return null;
        }
        finally
        {
            uploadingFileName = null;
        }
    }

    /// <summary>The picker's binding: normalises, remembers per user, and never blocks the UI on
