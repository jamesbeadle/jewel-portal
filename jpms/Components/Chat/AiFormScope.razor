@namespace Jewel.JPMS.Components.Chat
@using Jewel.JPMS.Services.Ai
@inject ActiveFormContext ActiveForm
@implements IDisposable

@*
    Wrap a form in this and the assistant can help complete it.

    Registering is the whole opt-in — a form the assistant should not touch simply does not wrap
    itself. Fields are read through a callback rather than passed as a value, so the assistant always
    sees what is on screen now rather than what was there when the dialog opened.

        <AiFormScope FormKey="variation.create"
                     Title="New variation"
                     Fields="@(() => new[]
                     {
                         new AiFormField("title", "Title", "text", model.Title, true, Array.Empty<string>()),
                         new AiFormField("value", "Value", "money", model.Value?.ToString(), false, Array.Empty<string>())
                     })"
                     OnFill="@ApplyFromAssistant">
            ... the form ...
        </AiFormScope>

    OnFill receives only the fields the assistant chose to set. Ignore names you do not recognise —
    it is working from a snapshot and the form may have moved on.
*@

@ChildContent

@code {
    /// <summary>Stable across renders. Used to decide whether a late Dispose should clear the slot.</summary>
    [Parameter, EditorRequired] public string FormKey { get; set; } = "";

    /// <summary>What the assistant calls this form when it talks about it.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Read at send time, not at registration time.</summary>
    [Parameter, EditorRequired] public Func<IReadOnlyList<AiFormField>> Fields { get; set; } = () => Array.Empty<AiFormField>();

    /// <summary>Applies the values the assistant proposed. Never submits — that stays the user's.</summary>
    [Parameter, EditorRequired] public Action<IReadOnlyDictionary<string, string>> OnFill { get; set; } = _ => { };

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() =>
        ActiveForm.Register(
            FormKey,
            () => new AiFormSnapshot(FormKey, Title, Fields()),
            OnFill);

    public void Dispose() => ActiveForm.Release(FormKey);
}
