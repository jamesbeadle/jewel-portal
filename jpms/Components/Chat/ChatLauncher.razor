@namespace Jewel.JPMS.Components.Chat
@inject SessionService Session
@inject ChatPanelState Chat
@implements IDisposable

@*
    The chat trigger, in two guises from one file so the two can never drift apart:

      Floating="false" (default) — the header button, far right of the top bar past the role
      switcher, desktop only. It sits inside the shell, so it stays visible and shifts left with
      the rest of the header when the panel pushes the page across.

      Floating="true" — the mobile bubble, bottom right above the home-indicator inset, hidden
      from md up. The open panel covers the whole screen and outranks it, so it needs no
      open/closed state of its own.

    Both are gated on DesktopNavigation.CanUseAssistant: administrators, the managing director and
    the finance director. Everyone else never sees that the panel exists.
*@

@if (CanUseAssistant)
{
    @if (Floating)
    {
        <button type="button" @onclick="Toggle" title="@Label"
                class="md:hidden fixed right-4 bottom-4 z-30 w-14 h-14 rounded-full bg-accent text-accent-ink shadow-lg flex items-center justify-center transition hover:bg-accent-hover"
                style="bottom: calc(1rem + env(safe-area-inset-bottom));"
                aria-label="@Label" aria-expanded="@(Chat.IsOpen ? "true" : "false")" aria-controls="@PanelDomId">
            <ChatIcon Class="w-6 h-6" />
        </button>
    }
    else
    {
        <button type="button" @onclick="Toggle" title="@Label" class="@HeaderClass"
                aria-label="@Label" aria-expanded="@(Chat.IsOpen ? "true" : "false")" aria-controls="@PanelDomId">
            <ChatIcon Class="w-4 h-4" />
        </button>
    }
}

@code {
    /// <summary>The mobile guise: a floating bubble instead of a header button.</summary>
    [Parameter] public bool Floating { get; set; }

    private const string Label = "Jewel Assistant";
    private static readonly string PanelDomId = ChatPanel.DomId;

    private bool CanUseAssistant =>
        Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role);

    private string HeaderClass
    {
        get
        {
            var baseClass = "hidden md:inline-flex items-center justify-center w-9 h-9 rounded-md border transition";
            return Chat.IsOpen
                ? $"{baseClass} border-line-strong bg-surface-raised text-content"
                : $"{baseClass} border-line bg-surface text-content-subtle hover:text-content hover:border-line-strong";
        }
    }

    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
        Chat.OnChange += StateHasChanged;
    }

    private void Toggle() => Chat.Toggle();

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
        Chat.OnChange -= StateHasChanged;
    }
}
