@using Jewel.JPMS.Models

@*
    The record tab bar: the request chain — Request → RFI (official stage) → Variation, with bid
    packages branching off the variation — presented as document tabs rather than a chip map, so
    the page reads as ONE containing object whose related documents sit behind tabs. Rendered on
    every page in the chain; the active tab is the record (or pane) you are looking at.

    Only tabs whose record EXISTS render (plus the request page's own panes): a request that has
    not been promoted shows no RFI tab, an RFI with no variation shows no Variation tab. The
    actions that create the next stage live on the current stage's tab, not on a placeholder.

    Two kinds of tab, one look:
      • Local panes (the request page's Request / official-document tabs) switch in place via
        OnSelect when LocalRequestTabs is set.
      • Everything else is a link to the record's own page, which renders this same bar with its
        tab active — so moving along the chain feels like switching tabs, not changing page.
*@

<nav class="flex flex-wrap items-center gap-1.5 mb-5 text-sm" aria-label="Related records">
    @foreach (var tab in MainTabs)
    {
        var current = tab;
        @if (current.Id == ActiveId)
        {
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent text-accent-ink font-medium"
                  aria-current="page" title="@current.Title">
                <ActionIcon Name="@current.Icon" Class="w-4 h-4 shrink-0" />
                <span>@current.Eyebrow</span>
                <span class="font-mono text-xs">@current.Label</span>
            </span>
        }
        else if (LocalRequestTabs && current.Id is "request" or "official")
        {
            <button type="button" class="@InactiveClass" title="@current.Title"
                    @onclick="() => OnSelect.InvokeAsync(current.Id)">
                <ActionIcon Name="@current.Icon" Class="w-4 h-4 shrink-0" />
                <span>@current.Eyebrow</span>
                <span class="font-mono text-xs">@current.Label</span>
            </button>
        }
        else
        {
            <a href="@current.Href" class="@InactiveClass" title="@current.Title">
                <ActionIcon Name="@current.Icon" Class="w-4 h-4 shrink-0" />
                <span>@current.Eyebrow</span>
                <span class="font-mono text-xs">@current.Label</span>
            </a>
        }
    }

    @if (Variation is not null && BidPackages is { Count: > 0 })
    {
        <span class="mx-1 h-5 w-px bg-line shrink-0" aria-hidden="true"></span>
        @foreach (var package in BidPackages)
        {
            var current = package;
            @if (current.BidPackageId == ActiveId)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-accent text-accent-ink font-medium"
                      aria-current="page" title="@PackageTitle(current)">
                    <ActionIcon Name="package" Class="w-4 h-4 shrink-0" />
                    <span class="font-mono text-xs">@PackageLabel(current)</span>
                </span>
            }
            else
            {
                <a href="@PackageHref(current.BidPackageId)" class="@InactiveClass" title="@PackageTitle(current)">
                    <ActionIcon Name="package" Class="w-4 h-4 shrink-0" />
                    <span class="font-mono text-xs">@PackageLabel(current)</span>
                </a>
            }
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>The active tab: "request", "official", "variation", or a bid package id.</summary>
    [Parameter, EditorRequired] public string ActiveId { get; set; } = "";

    [Parameter] public Request? Request { get; set; }

    /// <summary>The variation this chain produced, at whatever stage it has reached — one record,
    /// whichever status it holds.</summary>
    [Parameter] public VariationOrder? Variation { get; set; }

    [Parameter] public IReadOnlyList<BidPackage>? BidPackages { get; set; }

    /// <summary>Set on the request page: the Request / official-document tabs switch panes in
    /// place (via OnSelect) instead of navigating.</summary>
    [Parameter] public bool LocalRequestTabs { get; set; }

    /// <summary>Receives "request" or "official" when a local pane tab is clicked.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private const string InactiveClass =
        "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-content-muted hover:text-content hover:bg-surface-raised";

    private sealed record TabDef(string Id, string Icon, string Eyebrow, string Label, string Href, string Title);

    private IEnumerable<TabDef> MainTabs
    {
        get
        {
            if (Request is not null)
            {
                yield return new TabDef("request", "document", "Request", ContainerReference(Request), RequestHref,
                    $"{Request.Title} — the containing request and its correspondence");

                // The official stage exists once promoted: the same record, minted as its
                // instrument (RFI / NOD / EOT). Pre-official kinds have no official document yet
                // — no tab until promotion mints one (IsEmailable is what "official" means here).
                if (Request.Kind.IsEmailable())
                {
                    yield return new TabDef("official", "document-question", Request.Kind.DisplayName(), Request.Reference, OfficialHref,
                        $"{Request.Title} — the official {Request.Kind.DisplayName()} document, {Request.Status.DisplayName()}");
                }
            }

            if (Variation is not null)
            {
                yield return new TabDef("variation", "pound", "Variation", VariationLabel(Variation), VariationHref,
                    $"{Variation.Title} — {Variation.Status.DisplayName()}");
            }
        }
    }

    private string RequestHref => Request is null ? "" : $"/projects/{ProjectId}/requests/view/{Request.RequestId}";
    private string OfficialHref => Request is null ? "" : $"/projects/{ProjectId}/requests/view/{Request.RequestId}?tab=official";
    private string VariationHref => Variation is null ? "" : $"/projects/{ProjectId}/variations/{Variation.VariationOrderId}";
    private string PackageHref(string bidPackageId) => $"/projects/{ProjectId}/bid-package-invites/{bidPackageId}";

    // The container tab always shows the REQ-#### number (the official reference lives on the
    // official-stage tab); a back-filled record with no number falls back to its reference.
    private static string ContainerReference(Request request) =>
        string.IsNullOrEmpty(request.DisplayNumber) ? request.Reference : request.DisplayNumber;

    // An approved variation carries the V-ref minted at approval; before that DisplayNumber renders
    // the same number the same way, so the tab's label never changes shape as it moves stages.
    private static string VariationLabel(VariationOrder variation) =>
        string.IsNullOrWhiteSpace(variation.VariationRef) ? variation.DisplayNumber : variation.VariationRef!;

    private static string PackageLabel(BidPackage package) =>
        string.IsNullOrWhiteSpace(package.Reference) ? package.Title : package.Reference;

    private static string PackageTitle(BidPackage package) =>
        $"{package.Title} ({package.Trade}) — invited subcontractors and their tenders";
}
