@inject IRequestRegister RequestRegister
@inject IRequestAttachmentStore Attachments

@*
    The raise-request dialog: RequestForm (the shared fields/validation/payload component — the
    Control Centre's System Actions pane hosts the same form to stage a draft) inside the house
    Modal, with this wrapper owning the SEND — raise, then apply the chosen attachments the moment
    the request has an id. An attachment failure never loses the request: the button becomes
    "Continue", carrying the user to the request to attach by hand.
*@

<Modal IsOpen="IsOpen"
       Title="@(RfiOnly ? "Raise an RFI" : "Raise a request")"
       ConfirmLabel="@(saving ? "Raising…" : raisedRequest is null ? (RfiOnly ? "Raise RFI" : "Raise request") : (RfiOnly ? "Continue to the RFI" : "Continue to the request"))"
       OnCancel="Cancel"
       OnConfirm="Submit"
       Class="max-w-2xl">
    <div class="space-y-3">
        <RequestForm @ref="form" ProjectId="@ProjectId" LockToRfi="@RfiOnly" Busy="@saving" OnSubmit="SendAsync" />
        @if (attachmentWarning is not null)
        {
            <p class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 text-xs text-content">@attachmentWarning</p>
        }
    </div>
</Modal>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Lock the dialog to raising an official RFI (no General option) — the RFIs page's
    /// manual entry. General requests are sunset (2026-08-14).</summary>
    [Parameter] public bool RfiOnly { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Request> OnRaised { get; set; }

    private RequestForm? form;
    private bool saving;
    private bool wasOpen;
    // Attachments failing must not lose the request that was just created, so a failure here is a
    // warning on a request that already exists — not an error that pretends nothing happened.
    private string? attachmentWarning;
    // Non-null once the request has actually been created. Guards against a second press raising a
    // second request when only the attachment step failed.
    private Request? raisedRequest;

    protected override void OnParametersSet()
    {
        var opening = IsOpen && !wasOpen;
        wasOpen = IsOpen;
        if (!opening) return;
        // The Modal renders its children only while open, so each opening MOUNTS a fresh
        // RequestForm — no reset call needed (and none safe: the previous instance is disposed).
        raisedRequest = null;
        attachmentWarning = null;
        saving = false;
    }

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task Submit()
    {
        if (saving || form is null) return;
        // Already raised and only its attachments failed — the button now means "carry on to it",
        // never "raise another one".
        if (raisedRequest is { } alreadyRaised)
        {
            await OnRaised.InvokeAsync(alreadyRaised);
            return;
        }
        await form.TrySubmitAsync(); // a valid form comes back through SendAsync
    }

    private async Task SendAsync(RequestForm.Draft draft)
    {
        try
        {
            saving = true;
            var raised = await RequestRegister.RaiseAsync(draft.Command);
            // Remember it immediately: from here on the request EXISTS.
            raisedRequest = raised;

            if (draft.DrawingRevisionIds.Count > 0 || draft.Files.Count > 0)
            {
                try
                {
                    if (draft.DrawingRevisionIds.Count > 0)
                        await Attachments.AttachDrawingsAsync(raised.RequestId, draft.DrawingRevisionIds);
                    if (draft.Files.Count > 0)
                        await Attachments.UploadFilesAsync(raised.RequestId, draft.Files, caption: null);
                }
                catch (Exception attachmentFailure)
                {
                    attachmentWarning =
                        $"{raised.DisplayNumber} was raised, but the attachments didn't save: {attachmentFailure.Message} " +
                        "Continue to the request and add them there.";
                    saving = false;
                    return;
                }
            }

            await OnRaised.InvokeAsync(raised);
        }
        catch (CommandFailedException ex)
        {
            form?.ShowError(ex.Message);
            saving = false;
        }
        catch
        {
            form?.ShowError("Couldn't raise the request. Please try again.");
            saving = false;
        }
    }
}
