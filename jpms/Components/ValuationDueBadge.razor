@using Jewel.JPMS.Features.Projects

@* A project's next expected valuation date with its Overdue / Due soon reading — the one cell the
   Upcoming valuations panel and the portfolio table both render, so a date reads the same red or
   amber wherever it appears. "Not set" is muted, never alarming: it is a gap, not a lateness. *@

@if (Project.NextExpectedValuationDate is { } date && Project.Stage != ProjectStage.Completed)
{
    var status = ValuationDue.Of(Project);
    <span class="whitespace-nowrap @(status switch
                 {
                     ValuationDue.Status.Overdue => "text-negative",
                     ValuationDue.Status.DueSoon => "text-amber-400",
                     _ => "text-content",
                 })">@date.ToString("d MMM yyyy")</span>
    @if (status == ValuationDue.Status.Overdue)
    {
        <span class="ml-2 text-[11px] uppercase tracking-wider font-semibold text-negative bg-negative/10 border border-negative/30 rounded px-1.5 py-0.5">Overdue</span>
    }
    else if (status == ValuationDue.Status.DueSoon)
    {
        <span class="ml-2 text-[11px] uppercase tracking-wider font-semibold text-amber-400 bg-amber-400/10 border border-amber-400/30 rounded px-1.5 py-0.5">Due soon</span>
    }
}
else
{
    <span class="text-content-subtle">@(Project.Stage == ProjectStage.Completed ? "—" : "Not set")</span>
}

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}
