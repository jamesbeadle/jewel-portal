@* One labelled line of an email's envelope, so the preview's To/Cc/Subject/Attached rows all
   align and read the same way. *@
<div class="flex gap-2">
    <dt class="w-16 shrink-0 text-content-subtle">@Label</dt>
    <dd class="text-content break-words">@Value</dd>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}
