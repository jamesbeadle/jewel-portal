@inject IUserDirectory UserDirectory
@implements IDisposable

<section class="panel overflow-hidden mb-6">
    <header class="panel-header flex items-center justify-between">
        <h2 class="text-sm font-medium text-content">Users</h2>
        <div class="flex items-center gap-3">
            @if (UserDirectory.IsLoaded)
            {
                <span class="text-xs text-content-subtle">@ApprovedUsers.Count</span>
            }
            <button type="button" @onclick="ToggleForm"
                    class="text-xs font-medium text-accent hover:text-accent-hover">
                @(showForm ? "Close" : "+ Add user")
            </button>
        </div>
    </header>

    @if (showForm)
    {
        <div class="p-4 border-b border-line">
            <InviteUserForm OnInvited="HandleInvited" OnClosed="CloseForm" />
        </div>
    }

    <LoadGate IsLoading="@(!UserDirectory.IsLoaded)" Prominent="true" Label="Loading users">
        @if (ApprovedUsers.Count == 0)
        {
            <div class="p-5">
                <p class="text-content-subtle italic text-sm">
                    No users yet. Use <em>Add user</em> to invite the first one.
                </p>
            </div>
        }
        else
        {
            <ul class="divide-y divide-line">
                @foreach (var user in ApprovedUsers)
                {
                    <ApprovedUserRow @key="user.Email" User="user" IsCurrentUser="@IsCurrentUser(user.Email)" />
                }
            </ul>
        }
    </LoadGate>
</section>

@code {
    [Parameter, EditorRequired] public string CurrentUserEmail { get; set; } = "";

    private bool showForm;

    private IReadOnlyList<DirectoryUser> ApprovedUsers => UserDirectory.All();

    private bool IsCurrentUser(string email) =>
        string.Equals(email, CurrentUserEmail, StringComparison.OrdinalIgnoreCase);

    private void ToggleForm() => showForm = !showForm;

    private void CloseForm() => showForm = false;

    private void HandleInvited(DirectoryUser invited)
    {
        // Reflect the new user immediately; the API has already persisted them.
        UserDirectory.Upsert(invited);
    }

    protected override void OnInitialized() => UserDirectory.OnChange += StateHasChanged;

    public void Dispose() => UserDirectory.OnChange -= StateHasChanged;
}
