@using Jewel.JPMS.Contracts.Requests
@inject AuthService Auth
@inject IRequestRegister RequestRegister

@*
    The request's conversation: internal notes, shared notes and the live email legs, newest first.

    Every message is a bordered card rather than a row hanging off a thin left rule. With only a
    2px rule between them, consecutive messages ran into each other — a long note and the reply
    under it read as one block of text. The card pattern is the one ProjectCommunications already
    uses for tagged email; this brings the request page onto it. Internal notes keep a warm tint and
    a marked edge so "don't send this to the client" is legible at a glance, not just a small badge.
*@

<Panel Title="Conversation" BodyClass="p-5">
    <HeaderActions>
        <div class="flex items-center gap-3">
            @if (loaded && allMessages.Count > 0)
            {
                <span class="text-xs text-content-subtle">
                    @allMessages.Count message@(allMessages.Count == 1 ? "" : "s")@(InternalCount > 0 ? $" · {InternalCount} internal" : "")
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(RequestReference))
            {
                @* Search the whole mailbox and tag what belongs to this request — the conversation
                   AND the assistant's context both get richer with each tag. *@
                <Jewel.JPMS.Features.Triage.Panels.EmailFinder Type="RecordType.Request" RecordId="@RequestId"
                             RecordReference="@RequestReference" ExcludeTag="@($"JPMS/{RequestReference}")"
                             OnLinked="LoadAsync" />
            }
        </div>
    </HeaderActions>
    <ChildContent>
    @if (!loaded)
    {
        <JewelSpinner Class="py-6" Label="Loading" />
    }
    else
    {
        @if (messages.Count == 0)
        {
            <p class="rounded-lg border border-dashed border-line px-4 py-6 text-center text-sm text-content-subtle italic mb-5">
                No messages yet. Start the discussion below.
            </p>
        }
        else
        {
            <ol class="space-y-3 mb-5">
                @foreach (var message in messages)
                {
                    var isInternal = message.Visibility == MessageVisibility.Internal;
                    <li class="rounded-lg border px-4 py-3 @(isInternal ? "border-amber-500/40 bg-amber-500/[0.04]" : "border-line bg-surface-raised")">
                        <div class="flex items-start justify-between gap-3 mb-2">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-[11px] font-semibold @(isInternal ? "bg-amber-500/15 text-amber-600" : "bg-surface text-content-muted border border-line")"
                                      aria-hidden="true">@Initials(message)</span>
                                <span class="text-sm font-semibold text-content truncate">@AuthorLabel(message)</span>
                                @if (!string.IsNullOrEmpty(message.MailboxId))
                                {
                                    <span class="inline-flex items-center rounded border border-line bg-surface px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-content-subtle shrink-0">Email</span>
                                }
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                @if (isInternal)
                                {
                                    <span class="inline-flex items-center rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">Internal</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded bg-surface border border-line px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-content-muted">Shared</span>
                                }
                                <time class="text-xs text-content-subtle whitespace-nowrap" datetime="@message.PostedAt.ToString("o")">
                                    @message.PostedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")
                                </time>
                            </div>
                        </div>
                        @* A MailboxId marks a LIVE email leg (inbound, or the mailbox's own sent
                           reply read from Sent Items) — both expand to their full body on demand. *@
                        @if (!string.IsNullOrEmpty(message.MailboxId)
                             && expanded.Contains(message.MessageId))
                        {
                            @* Expanded email: the full body (incl. the quoted thread), fetched live on demand,
                               rendered in the shared correspondence card's shape — To/Cc envelope lines above
                               the body, the attachments as their own bounded block below. The listed Body is
                               only Graph's short preview snippet, so long emails and their history only appear
                               here. HTML is sanitised server-side before it reaches us. *@
                            <div class="rounded-lg bg-surface border border-line p-3 max-h-[28rem] overflow-y-auto">
                                @if (!details.TryGetValue(message.MessageId, out var detail) || detail is null)
                                {
                                    <p class="text-sm text-content-subtle italic">Loading full email…</p>
                                }
                                else
                                {
                                    @if (detail.To is { Count: > 0 } to)
                                    {
                                        <p class="text-xs text-content-subtle truncate">To: @string.Join("; ", to)</p>
                                    }
                                    @if (detail.Cc is { Count: > 0 } cc)
                                    {
                                        <p class="text-xs text-content-subtle truncate">Cc: @string.Join("; ", cc)</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                                    {
                                        <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto mt-1">@((MarkupString)detail.BodyHtml)</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(detail.BodyHtml))
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap mt-1">@detail.BodyHtml</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap mt-1">@message.Body</p>
                                    }
                                }
                            </div>
                            @if (details.TryGetValue(message.MessageId, out var loadedDetail)
                                 && loadedDetail is { Attachments.Count: > 0 })
                            {
                                @* View opens the file in a new tab (types a browser renders); Download always
                                   saves. Both stream through the request-scoped attachment endpoint, which
                                   checks the email carries this request's tag — same gate as the body above. *@
                                <div class="mt-2 rounded-lg bg-surface border border-line p-3">
                                    <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                                        @loadedDetail.Attachments.Count attachment@(loadedDetail.Attachments.Count == 1 ? "" : "s")
                                    </p>
                                    <ul class="space-y-1">
                                        @foreach (var attachment in loadedDetail.Attachments)
                                        {
                                            <li class="flex items-center justify-between gap-3 text-sm text-content">
                                                <span class="truncate">@attachment.Name</span>
                                                <span class="flex items-center gap-3 whitespace-nowrap">
                                                    @if (attachment.Size > 0)
                                                    {
                                                        <span class="text-xs text-content-subtle">@FormatSize(attachment.Size)</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(attachment.Id))
                                                    {
                                                        @if (RendersInBrowser(attachment))
                                                        {
                                                            <a href="@AttachmentUrl(message, attachment, viewInline: true)" target="_blank" rel="noopener"
                                                               class="text-xs text-accent hover:underline">View</a>
                                                        }
                                                        <a href="@AttachmentUrl(message, attachment, viewInline: false)"
                                                           class="text-xs text-accent hover:underline">Download</a>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@message.Body</p>
                        }
                        @* Typed messages thread: Reply answers this message, and the replies nest
                           beneath it. Email legs keep their own reply flow (the official-PDF
                           Outlook draft below) — the two are different acts on purpose. *@
                        @if (string.IsNullOrEmpty(message.MailboxId))
                        {
                            <div class="mt-2">
                                <button type="button" class="text-xs font-medium text-accent hover:underline"
                                        @onclick="() => StartReply(message)">Reply</button>
                            </div>
                        }
                        @{ var replies = RepliesFor(message.MessageId); }
                        @if (replies.Count > 0)
                        {
                            <div class="mt-3 space-y-3 border-l-2 border-line pl-3">
                                @foreach (var reply in replies)
                                {
                                    <ConversationMessageCard Entry="reply" ShowVisibility="true"
                                                             CanReply="true" OnReply="StartReplyEntry" />
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(message.MailboxId))
                        {
                            <div class="mt-3 pt-2 border-t border-line/70 flex flex-wrap items-center gap-4">
                                <button type="button"
                                        class="text-xs font-medium text-accent hover:underline"
                                        @onclick="() => ToggleExpandAsync(message)">
                                    @(expanded.Contains(message.MessageId) ? "Show summary" : "Show full email")
                                </button>
                                @if (CanDraftReply)
                                {
                                    <button type="button"
                                            class="text-xs font-medium text-accent hover:underline"
                                            disabled="@(replyingId is not null)"
                                            @onclick="() => DraftReplyAsync(message)">
                                        @(replyingId == message.MessageId ? "Drafting reply…" : "Reply with official PDF")
                                    </button>
                                }
                            </div>
                            @if (replyForMessageId == message.MessageId && replyError is not null)
                            {
                                <p class="mt-2 rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@replyError</p>
                            }
                            @if (replyForMessageId == message.MessageId && replyDraft is not null)
                            {
                                <div class="mt-2 rounded-lg bg-positive/10 border border-positive/30 px-3 py-2">
                                    <p class="text-sm font-medium text-positive">
                                        Reply draft created in the projects mailbox — official PDF attached, in this email's thread.
                                    </p>
                                    <p class="text-xs text-content-subtle mt-1">To: @string.Join(", ", replyDraft.Recipients)</p>
                                    @if (replyDraft.Cc is { Count: > 0 } replyCc)
                                    {
                                        <p class="text-xs text-content-subtle">CC: @string.Join(", ", replyCc)</p>
                                    }
                                    <p class="text-xs text-content-subtle">Review the recipients and send it from Outlook — nothing has been sent.</p>
                                    @if (!string.IsNullOrWhiteSpace(replyDraft.WebLink))
                                    {
                                        <a href="@replyDraft.WebLink" target="_blank" rel="noopener"
                                           class="text-xs text-accent hover:underline underline-offset-2">Open the draft in Outlook</a>
                                    }
                                </div>
                            }
                        }
                    </li>
                }
            </ol>
        }

        @* The composer is its own bounded area, and it takes the warm internal tint the moment
           "Internal only" is ticked — so what you are about to write is visibly the same kind of
           thing as the internal cards above it, before you write it. *@
        <div class="rounded-lg border px-4 py-3 transition-colors @(internalOnly ? "border-amber-500/40 bg-amber-500/[0.04]" : "border-line bg-surface-raised")">
            @if (error is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@error</p>
            }
            @if (replyToId is not null)
            {
                <p class="mb-2 text-xs text-content-muted">
                    Replying to <span class="font-medium text-content">@replyToAuthor</span> ·
                    <button type="button" class="text-accent hover:underline" @onclick="CancelReply">cancel</button>
                </p>
            }
            <textarea class="field mb-3" rows="3" value="@draft" @oninput="OnDraftInput"
                      placeholder="@(internalOnly ? "Add an internal note — the client and external parties never see this…" : "Add to the conversation…")"></textarea>
            <div class="flex flex-wrap items-center justify-between gap-3">
                <label class="inline-flex items-center gap-2 text-sm text-content-muted cursor-pointer">
                    <input type="checkbox" checked="@internalOnly" @onchange="OnVisibilityChanged" class="rounded border-line-strong" />
                    Internal only (hide from client &amp; external parties)
                </label>
                <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(draft))" @onclick="Post">
                    @(busy ? "Posting…" : replyToId is not null ? "Post reply" : internalOnly ? "Post internal note" : "Post message")
                </button>
            </div>
        </div>
    }
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired] public string RequestId { get; set; } = "";

    /// <summary>The request's human reference ("RFI-049"). When supplied, the header offers the
    /// Find-emails dialog so more correspondence can be tagged to the request from right here.</summary>
    [Parameter] public string? RequestReference { get; set; }

    /// <summary>Whether the signed-in user may stage reply drafts carrying the official PDF —
    /// mirrors the page-level draft gate (directors, PMs, site managers, architects).</summary>
    [Parameter] public bool CanDraftReply { get; set; }

    private bool loaded;
    private bool busy;
    private string? error;
    private string draft = "";
    private bool internalOnly;
    // Every message on the request (for the header count) and the top-level slice the list
    // renders — replies hang off their parents via repliesByParent instead.
    private IReadOnlyList<RequestMessage> allMessages = Array.Empty<RequestMessage>();
    private IReadOnlyList<RequestMessage> messages = Array.Empty<RequestMessage>();
    private ILookup<string, RequestMessage> repliesByParent =
        Array.Empty<RequestMessage>().ToLookup(m => m.MessageId);
    private string? replyToId;
    private string? replyToAuthor;

    // Inbound emails render their short preview by default; expanding fetches the FULL body (with the
    // quoted thread + attachment names) live from the mailbox, cached per message for the page's life.
    private readonly HashSet<string> expanded = new();
    private readonly Dictionary<string, MailboxMessageDetail?> details = new();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        allMessages = await RequestRegister.ListMessagesAsync(RequestId);
        var knownIds = allMessages.Select(m => m.MessageId).ToHashSet();
        repliesByParent = allMessages
            .Where(m => m.ParentMessageId is not null && knownIds.Contains(m.ParentMessageId))
            .ToLookup(m => m.ParentMessageId!);
        // Top level, newest first — the latest exchange is what people come to check. A reply
        // whose parent isn't in the list surfaces here rather than disappearing.
        messages = allMessages
            .Where(m => m.ParentMessageId is null || !knownIds.Contains(m.ParentMessageId))
            .OrderByDescending(m => m.PostedAt)
            .ToList();
        loaded = true;
    }

    // The reply subtree under one typed message, oldest first — a thread reads downwards.
    private IReadOnlyList<ConversationEntry> RepliesFor(string messageId) =>
        repliesByParent[messageId]
            .OrderBy(m => m.PostedAt)
            .Select(ToEntry)
            .ToList();

    private ConversationEntry ToEntry(RequestMessage message) => new(
        message.MessageId, message.ParentMessageId, message.AuthorEmail, message.AuthorName,
        message.Body, message.Visibility == MessageVisibility.Internal, message.PostedAt)
    { Replies = RepliesFor(message.MessageId) };

    private void StartReply(RequestMessage message)
    {
        replyToId = message.MessageId;
        replyToAuthor = AuthorLabel(message);
    }

    private void StartReplyEntry(ConversationEntry entry)
    {
        replyToId = entry.MessageId;
        replyToAuthor = string.IsNullOrWhiteSpace(entry.AuthorName) ? entry.AuthorEmail : entry.AuthorName;
    }

    private void CancelReply()
    {
        replyToId = null;
        replyToAuthor = null;
    }

    private void OnDraftInput(ChangeEventArgs e) => draft = e.Value?.ToString() ?? "";

    private void OnVisibilityChanged(ChangeEventArgs e) => internalOnly = e.Value is true;

    private async Task Post()
    {
        if (busy || string.IsNullOrWhiteSpace(draft)) return;
        error = null;
        var user = Auth.CurrentUser;
        if (user is null) { error = "You must be signed in to post."; return; }

        // Author is set authoritatively by the API from the signed-in session; the
        // values supplied here are placeholders the server overrides.
        var command = new PostRequestMessage(
            RequestId,
            draft.Trim(),
            internalOnly ? MessageVisibility.Internal : MessageVisibility.Shared,
            user.Email,
            user.DisplayName,
            replyToId);

        try
        {
            busy = true;
            await RequestRegister.PostMessageAsync(command);
            draft = "";
            internalOnly = false;
            CancelReply();
            await LoadAsync();
        }
        catch
        {
            error = "Couldn't post your message. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ToggleExpandAsync(RequestMessage message)
    {
        if (!expanded.Add(message.MessageId))
        {
            expanded.Remove(message.MessageId);
            return;
        }

        if (details.ContainsKey(message.MessageId) || string.IsNullOrEmpty(message.MailboxId))
            return;

        try
        {
            var detail = await RequestRegister.GetEmailDetailAsync(RequestId, message.MailboxId, message.EmailMessageId);
            details[message.MessageId] = detail;
        }
        catch
        {
            // Fetch failed — fall back to the preview body inside the expanded pane.
            details[message.MessageId] = new MailboxMessageDetail(message.MailboxId, "", false, Array.Empty<IntakeAttachment>());
        }
    }

    // ---- Reply with the official PDF: an Outlook draft in this email's thread ----

    private string? replyingId;        // message currently being drafted against (disables the buttons)
    private string? replyForMessageId; // where the latest outcome (error or draft) is displayed
    private string? replyError;
    private RequestEmailDraft? replyDraft;

    private async Task DraftReplyAsync(RequestMessage message)
    {
        if (replyingId is not null || string.IsNullOrEmpty(message.MailboxId)) return;
        replyError = null;
        replyDraft = null;
        replyForMessageId = message.MessageId;
        replyingId = message.MessageId;
        try
        {
            replyDraft = await RequestRegister.PrepareReplyDraftAsync(RequestId, message.MailboxId!);
        }
        catch (CommandFailedException ex)
        {
            replyError = $"Couldn't create the reply draft: {ex.Message}";
        }
        catch
        {
            replyError = "Couldn't create the reply draft. Check the mailbox connection and try again.";
        }
        finally
        {
            replyingId = null;
        }
    }

    private static string AuthorLabel(RequestMessage message) =>
        string.IsNullOrWhiteSpace(message.AuthorName) ? message.AuthorEmail : message.AuthorName;

    private int InternalCount => allMessages.Count(m => m.Visibility == MessageVisibility.Internal);

    // Same formatting as the shared correspondence list's attachment block.
    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    // The request-scoped attachment stream. Both ids travel so the server can re-find the message
    // by internetMessageId when its Graph id has gone stale — same re-find as the body fetch.
    private string AttachmentUrl(RequestMessage message, IntakeAttachment attachment, bool viewInline) =>
        $"/api/requests/{Uri.EscapeDataString(RequestId)}/messages/email-attachment"
        + $"?id={Uri.EscapeDataString(message.MailboxId ?? "")}"
        + $"&imid={Uri.EscapeDataString(message.EmailMessageId ?? "")}"
        + $"&aid={Uri.EscapeDataString(attachment.Id)}"
        + (viewInline ? "&inline=1" : "");

    // "View" only offers what the endpoint will actually serve inline: raster images and PDFs.
    // (Never SVG — served on the portal's origin it would run the sender's markup as the reader.)
    private static readonly HashSet<string> InlineViewableTypes = new(StringComparer.OrdinalIgnoreCase)
        { "image/png", "image/jpeg", "image/jpg", "image/gif", "image/webp", "image/bmp", "application/pdf" };

    private static bool RendersInBrowser(IntakeAttachment attachment) =>
        attachment.ContentType is { } contentType && InlineViewableTypes.Contains(contentType);

    // Up to two initials for the author avatar: "Nigel Reilly" → NR, "plg@…" → P. Purely a scanning
    // aid, so anything unexpected degrades to a single character rather than throwing.
    private static string Initials(RequestMessage message)
    {
        var label = AuthorLabel(message).Trim();
        if (label.Length == 0) return "?";
        var words = label.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2 && !label.Contains('@'))
            return $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[^1][0])}";
        return char.ToUpperInvariant(label[0]).ToString();
    }
}
