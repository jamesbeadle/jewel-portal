@using Jewel.JPMS.Contracts.ProjectContracts
@inject IProjectContractStore Contracts
@inject SessionService Session
@implements IDisposable

@*
    The project's contract: the executed document, the amendments made to it, and the terms keyed
    off it.

    One document per project — there is one executed contract, and uploading again means the wrong
    file went up, so a replacement supersedes rather than versions (the server deletes the old blob
    once the row is committed). Amendments are exactly the separate record type that convention
    promised: each deed of variation or side letter is its own row with its own document,
    accumulating in date order — never a version chain on the executed contract. The terms stay
    the single source of truth; an amendment that changes a term is recorded here as evidence and
    the term is edited to match.

    The terms beside it are what get_project_contract returns: until they are keyed, the AI
    correctly answers "no contract has been recorded for this project" to any question about
    retention, notice periods or OH&P, because the system prompt forbids it guessing them.

    One gate over the whole body (Panel's own LoadGate): the document line and the terms come from
    the same store, so revealing either before the other would just be two waits where there is one.
*@

<Panel Title="Contract" IsLoading="@(!Contracts.LoadedFor(ProjectId) && !dataFailed)" LoadingLabel="Loading contract">
    <HeaderActions>
        @if (CanManage && Contracts.LoadedFor(ProjectId))
        {
            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="OpenTerms">
                @(Current is null ? "Record terms" : "Edit terms")
            </button>
        }
    </HeaderActions>
    <ChildContent>

    @if (dataFailed)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">
            Couldn't load the contract. The error toast has the reference and the detail.
        </p>
    }
    else
    {
        <section class="mb-6">
            <h4 class="eyebrow mb-2">Executed contract</h4>

            @if (Current is { HasDocument: true } contract)
            {
                <div class="rounded-lg border border-line bg-surface px-3 py-2.5 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="text-sm text-content font-medium truncate">@contract.DocumentFileName</p>
                        <p class="text-xs text-content-subtle mt-0.5">
                            @FormatSize(contract.DocumentFileSizeBytes)
                            @if (contract.DocumentUploadedAt is { } uploadedAt)
                            {
                                <text> · uploaded @uploadedAt.ToLocalTime().ToString("d MMM yyyy")</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(contract.DocumentUploadedByEmail))
                            {
                                <text> by @contract.DocumentUploadedByEmail</text>
                            }
                        </p>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <a href="@DocumentUrl(inline: true)" target="_blank" rel="noopener"
                           class="text-xs text-accent hover:underline underline-offset-2">View</a>
                        <a href="@DocumentUrl(inline: false)" target="_blank" rel="noopener"
                           class="text-xs text-accent hover:underline underline-offset-2">Download</a>
                    </div>
                </div>
            }
            else
            {
                <p class="text-sm text-content-subtle">
                    No contract document uploaded.
                    @if (CanManage)
                    {
                        <text>Upload the executed contract below — it is stored against the project and downloadable by anyone internal.</text>
                    }
                </p>
            }

            @if (CanManage)
            {
                <div class="mt-3 flex flex-wrap items-end gap-3">
                    <div class="min-w-0">
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">
                            @(Current is { HasDocument: true } ? "Replace document" : "Contract document")
                        </label>
                        <InputFile OnChange="OnFileSelected" disabled="@uploading" class="text-sm text-content-muted" />
                    </div>
                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5"
                            disabled="@(uploading || selectedFile is null)" @onclick="UploadAsync">
                        @(uploading ? "Uploading…" : "Upload")
                    </button>
                </div>

                @if (selectedFile is not null && !uploading)
                {
                    <p class="text-xs text-content-subtle mt-1.5">
                        @selectedFile.Name · @FormatSize(selectedFile.Size)
                        @if (Current is { HasDocument: true } existing)
                        {
                            <text> — this supersedes @existing.DocumentFileName, which is deleted once the upload lands.</text>
                        }
                    </p>
                }

                @if (uploadError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mt-2">@uploadError</p>
                }

                <p class="text-xs text-content-subtle mt-1.5">PDF or Word, up to 100 MB.</p>
            }
        </section>

        <section class="mb-6">
            <h4 class="eyebrow mb-2">Amendments</h4>

            @if (Amendments.Count == 0)
            {
                <p class="text-sm text-content-subtle">
                    No amendments recorded.
                    @if (CanManage)
                    {
                        <text>When a deed of variation or side letter is executed, file it here — and if it
                        changes a term, edit the terms too, because they are what everything downstream reads.</text>
                    }
                </p>
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var (amendment, index) in Amendments.Select((a, i) => (a, i)))
                    {
                        <li class="rounded-lg border border-line bg-surface px-3 py-2.5 flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-sm text-content font-medium truncate">
                                    <span class="text-content-subtle">@(index + 1).</span> @amendment.Title
                                    @if (amendment.AmendmentDate is { } made)
                                    {
                                        <span class="text-content-subtle font-normal"> · @made.ToString("d MMM yyyy")</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(amendment.Notes))
                                {
                                    <p class="text-xs text-content-muted mt-0.5">@amendment.Notes</p>
                                }
                                <p class="text-xs text-content-subtle mt-0.5">
                                    @amendment.DocumentFileName · @FormatSize(amendment.DocumentFileSizeBytes)
                                    · uploaded @amendment.DocumentUploadedAt.ToLocalTime().ToString("d MMM yyyy")
                                    by @amendment.DocumentUploadedByEmail
                                </p>
                            </div>
                            <div class="flex items-center gap-3 shrink-0">
                                <a href="@AmendmentDocumentUrl(amendment.ProjectContractAmendmentId, inline: true)" target="_blank" rel="noopener"
                                   class="text-xs text-accent hover:underline underline-offset-2">View</a>
                                <a href="@AmendmentDocumentUrl(amendment.ProjectContractAmendmentId, inline: false)" target="_blank" rel="noopener"
                                   class="text-xs text-accent hover:underline underline-offset-2">Download</a>
                                @if (CanManage)
                                {
                                    <button type="button" class="text-xs text-accent hover:underline underline-offset-2"
                                            @onclick="() => editingAmendment = amendment">Edit</button>
                                    <button type="button" class="text-xs text-red-600 hover:text-red-700 hover:underline underline-offset-2"
                                            @onclick="() => pendingRemove = amendment">Remove</button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }

            @if (CanManage)
            {
                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                        <input type="text" class="field" @bind="amendmentTitle"
                               placeholder="e.g. Deed of Variation No. 1" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Amendment date</label>
                        <input type="date" class="field" @bind="amendmentDate" />
                    </div>
                </div>
                <div class="mt-3 flex flex-wrap items-end gap-3">
                    <div class="min-w-0">
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Amendment document</label>
                        <InputFile OnChange="OnAmendmentFileSelected" disabled="@amendmentUploading" class="text-sm text-content-muted" />
                    </div>
                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5"
                            disabled="@(amendmentUploading || selectedAmendmentFile is null)" @onclick="UploadAmendmentAsync">
                        @(amendmentUploading ? "Uploading…" : "Add amendment")
                    </button>
                </div>

                @if (selectedAmendmentFile is not null && !amendmentUploading)
                {
                    <p class="text-xs text-content-subtle mt-1.5">
                        @selectedAmendmentFile.Name · @FormatSize(selectedAmendmentFile.Size)
                    </p>
                }

                @if (amendmentError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mt-2">@amendmentError</p>
                }

                <p class="text-xs text-content-subtle mt-1.5">
                    PDF or Word, up to 100 MB. Each upload is a new amendment — notes can be added
                    after via Edit.
                </p>
            }
        </section>

        <section>
            <h4 class="eyebrow mb-2">Terms</h4>

            @if (Current is not { } terms)
            {
                <p class="text-sm text-content-subtle">
                    No contract terms recorded. Until they are, anything that needs a retention rate,
                    a notice period or an OH&amp;P percentage — the valuation cycle, variation pricing,
                    and the assistant — has nothing to read.
                </p>
            }
            else
            {
                @if (terms.IsAmended)
                {
                    <p class="rounded-lg bg-info/10 border border-info/30 px-3 py-2 text-xs text-content mb-3">
                        <span class="font-semibold">Amended form.</span>
                        @(string.IsNullOrWhiteSpace(terms.BespokeDeviations)
                            ? "Clause numbers do not map to the standard form."
                            : terms.BespokeDeviations)
                    </p>
                }

                <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-4 gap-y-3 text-sm">
                    @foreach (var (label, value) in Summary(terms))
                    {
                        <div>
                            <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">@label</dt>
                            <dd class="text-content">@value</dd>
                        </div>
                    }
                </dl>

                @if (!string.IsNullOrWhiteSpace(terms.UpdatedByEmail))
                {
                    <p class="text-xs text-content-subtle mt-3">
                        Last updated @terms.UpdatedAt.ToLocalTime().ToString("d MMM yyyy") by @terms.UpdatedByEmail
                    </p>
                }
            }
        </section>
    }
    </ChildContent>
</Panel>

@if (termsOpen)
{
    <ProjectContractTermsDialog ProjectId="@ProjectId"
                                OnSaved="CloseTerms"
                                OnCancelled="CloseTerms" />
}

@if (editingAmendment is not null)
{
    <ProjectContractAmendmentDialog ProjectId="@ProjectId"
                                    Amendment="editingAmendment"
                                    OnSaved="() => editingAmendment = null"
                                    OnCancelled="() => editingAmendment = null" />
}

<Modal IsOpen="pendingRemove is not null"
       Title="Remove amendment?"
       ConfirmLabel="@(removeBusy ? "Removing…" : "Remove amendment")"
       OnCancel="() => { if (!removeBusy) pendingRemove = null; }"
       OnConfirm="RemovePendingAsync">
    <p class="text-sm text-content-muted">
        This permanently removes <strong>@pendingRemove?.Title</strong>
        (@pendingRemove?.DocumentFileName) and its stored file. If it changed any contract terms,
        those stay as recorded — edit them separately if they need to move back.
        This cannot be undone.
    </p>
    @if (removeError is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mt-2">@removeError</p>
    }
</Modal>

