@using System.Text.Json
@using Jewel.JPMS.Contracts.Variations

@*
    The manual-variation FORM — fields, validation and payload building, with no opinion about
    what happens on submit (split from AddManualVariationDialog 2026-08-10, same pattern as
    RequestForm). The dialog creates immediately; the Control Centre's System Actions pane stages
    the draft to fire with the email's Apply.

    The build-up is captured HERE, up front (2026-09-14): the priced lines, one per cost centre,
    in the same VariationApprovePanel the approve modal uses — their total is the estimate, and
    they carry through as the staged build-up so approval opens pre-seeded. A variation raised by
    hand has already gone to the client, so it lands in Issued, not Quoting; nothing reaches the
    valuation report until it is approved.
*@

<div class="space-y-4">
    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }

    @if (ShowIntro)
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
            Adds a standalone variation as <span class="font-medium text-content">Issued</span> — no RFI needed; raising it
            by hand means it has already gone to the client. Build the price up from the lines below: their total is the
            variation's value and they carry through to <span class="font-medium text-content">Approve</span>, which is
            what writes it onto the valuation report.
        </p>
    }

    <div>
        <FormField Label="Variation no." Value="@numberText" OnChange="v => Set(ref numberText, v)" InputType="number" />
        <p class="mt-1 text-xs text-content-subtle">
            Becomes <span class="font-mono text-content">@Preview</span> — set it to match the client's report,
            or leave it for the project's next number.
        </p>
    </div>

    <FormField Label="Title" Value="@title" OnChange="v => Set(ref title, v)" Required="true" />

    <div>
        <FormField Label="Description">
        <textarea class="field" rows="3" value="@description" @oninput="OnDescriptionInput"
                  placeholder="What the variation covers…"></textarea>
        </FormField>
    </div>

    @* The priced build-up — the same lines editor the approve modal uses, without its own button:
       this form's submit validates the lines along with the fields. *@
    <div class="space-y-2">
        <h3 class="eyebrow">Build-up</h3>
        <VariationApprovePanel @ref="linesPanel"
                               IsManual="true" ShowHeading="false" ShowSubmitButton="false"
                               HelpOverride="One line per cost centre. The total becomes the variation's value now and opens the approve dialog pre-filled later; a negative rate is an omit."
                               OnLinesEdited="OnLinesEditedAsync" />
    </div>

    @* The official document's narrative sections — printed on the VO sheet when it is downloaded
       or emailed. All optional here: the wording is editable on the variation page at every stage. *@
    <div>
        <FormField Label="Commercial basis">
        <textarea class="field" rows="3" value="@commercialBasis" @oninput="e => Set(ref commercialBasis, e.Value?.ToString() ?? string.Empty)"
                  placeholder="What the price is based on — tender-face position, rate basis, OH&amp;P…"></textarea>
        </FormField>
    </div>

    <div>
        <FormField Label="Programme impact">
        <textarea class="field" rows="3" value="@programmeImpact" @oninput="e => Set(ref programmeImpact, e.Value?.ToString() ?? string.Empty)"
                  placeholder="Effect on the programme — procurement, mobilisation, works duration…"></textarea>
        </FormField>
    </div>

    <div>
        <FormField Label="Exclusions">
        <textarea class="field" rows="3" value="@exclusions" @oninput="e => Set(ref exclusions, e.Value?.ToString() ?? string.Empty)"
                  placeholder="What this variation expressly does not price…"></textarea>
        </FormField>
    </div>
</div>

@code {
    /// <summary>A valid submission — the host sends it now (dialog) or stages it (System Actions).
    /// Lines is the validated build-up (at least one, every line coded); Total is their sum.</summary>
    public sealed record Draft(
        string Title, string? Description, IReadOnlyList<VariationLineInput> Lines, decimal Total, int? Number,
        string? CommercialBasis, string? ProgrammeImpact, string? Exclusions);

    /// <summary>Raised by <see cref="TrySubmitAsync"/> when the form validates.</summary>
    [Parameter] public EventCallback<Draft> OnSubmit { get; set; }

    /// <summary>Numbers already taken on the project — caught here so the common clash never
    /// round-trips. Empty when the host has no register to hand; the server still rejects.</summary>
    [Parameter] public IReadOnlyCollection<int> UsedNumbers { get; set; } = Array.Empty<int>();

    /// <summary>Hosts that say what happens next in their own words (the System Actions pane's
    /// approve-on-apply toggle) turn the standard lands-in-Issued blurb off.</summary>
    [Parameter] public bool ShowIntro { get; set; } = true;

    private VariationApprovePanel? linesPanel;
    private string numberText = "";
    private string title = "";
    private string description = "";
    private string commercialBasis = "";
    private string programmeImpact = "";
    private string exclusions = "";
    private string? error;

    private int? ParsedNumber => int.TryParse(numberText, out var n) && n > 0 ? n : null;
    // Shows the number the way the rest of the app shows it ("V50").
    private string Preview => ParsedNumber is { } n ? $"V{n}" : "V…";

    /// <summary>What's typed right now — read by hosts that describe the staged action in their own words.</summary>
    public string CurrentTitle => title.Trim();

    private void OnDescriptionInput(ChangeEventArgs e) => Set(ref description, e.Value?.ToString() ?? "");

    // ---- The assistant pipe --------------------------------------------------------------------
    // Out: every edit raises OnEdited so the host can republish the live state (AiTaskState.
    // UpdateDraft) — the model always reasons from what is on screen NOW. In: ApplyAssistant merges
    // the model's proposals field by field — a field it did not send keeps what the user typed.

    /// <summary>Raised after any field changes, however it changed. Optional: a host with no
    /// assistant (the System Actions pane) simply doesn't listen.</summary>
    [Parameter] public EventCallback OnEdited { get; set; }

    private void Set(ref string field, string value)
    {
        field = value;
        if (OnEdited.HasDelegate) _ = OnEdited.InvokeAsync();
    }

    private Task OnLinesEditedAsync() => OnEdited.HasDelegate ? OnEdited.InvokeAsync() : Task.CompletedTask;

    /// <summary>The form's live state as the JSON the assistant task carries with every turn.
    /// number goes out as a NUMBER (null while blank or unparseable) — the schema declares it
    /// numeric, and serialising the raw text ("" included) taught the model the wrong shape and
    /// read as a value someone had set. lines is the build-up as the panel snapshots it.</summary>
    public string SerialiseState()
    {
        JsonElement? lines = null;
        if (linesPanel is not null)
        {
            using var snapshot = JsonDocument.Parse(linesPanel.SnapshotLines());
            if (snapshot.RootElement.TryGetProperty("lines", out var rows)) lines = rows.Clone();
        }
        return JsonSerializer.Serialize(new
        {
            number = ParsedNumber,
            title,
            description,
            lines,
            commercialBasis,
            programmeImpact,
            exclusions
        });
    }

    /// <summary>
    /// The assistant's proposals, merged in. Only the fields it sent are touched; values arrive as
    /// the dialog's schema declares them (numbers for number/estimatedValue) but strings are
    /// tolerated — the model is not the only writer of that JSON. Validation is unchanged: whatever
    /// lands here still goes through TrySubmitAsync when the user presses the button.
    /// </summary>
    public void ApplyAssistant(string fieldsJson)
    {
        if (string.IsNullOrWhiteSpace(fieldsJson)) return;
        try
        {
            using var document = JsonDocument.Parse(fieldsJson);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object) return;

            if (ReadText(root, "title") is { } proposedTitle) title = proposedTitle;
            if (ReadText(root, "description") is { } proposedDescription) description = proposedDescription;
            if (ReadText(root, "commercialBasis") is { } proposedBasis) commercialBasis = proposedBasis;
            if (ReadText(root, "programmeImpact") is { } proposedImpact) programmeImpact = proposedImpact;
            if (ReadText(root, "exclusions") is { } proposedExclusions) exclusions = proposedExclusions;
            if (ReadNumberText(root, "number") is { } proposedNumber) numberText = proposedNumber;
            // The build-up is the panel's: it replaces its rows from the same object (the "lines" array).
            if (root.TryGetProperty("lines", out _)) linesPanel?.ReplaceLines(fieldsJson);

            StateHasChanged();
        }
        catch (JsonException)
        {
            // A malformed proposal is the model's problem, not the user's. The form stands.
        }
    }

    // Whitespace-only counts as not sent: the schema promises "leave it out to keep what
    // stands", and an empty string used to wipe what the user had typed.
    private static string? ReadText(JsonElement root, string name) =>
        root.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            && !string.IsNullOrWhiteSpace(value.GetString())
            ? value.GetString()
            : null;

    private static string? ReadNumberText(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var value)) return null;
        return value.ValueKind switch
        {
            JsonValueKind.Number => value.GetDecimal().ToString(System.Globalization.CultureInfo.InvariantCulture),
            JsonValueKind.String when !string.IsNullOrWhiteSpace(value.GetString()) => value.GetString(),
            _ => null
        };
    }

    /// <summary>Seed the number field (the dialog's next-number suggestion). No-op once typed in.</summary>
    public void SuggestNumber(int suggested)
    {
        if (!string.IsNullOrWhiteSpace(numberText) || suggested <= 0) return;
        numberText = suggested.ToString();
        // The seed is field state — published like any edit, so the model sees the project's
        // next number instead of proposing one that may already exist.
        if (OnEdited.HasDelegate) _ = OnEdited.InvokeAsync();
        StateHasChanged();
    }

    public void Reset()
    {
        numberText = title = description = "";
        commercialBasis = programmeImpact = exclusions = "";
        error = null;
        linesPanel?.ResetLines();
        StateHasChanged();
    }

    public void ShowError(string message)
    {
        error = message;
        StateHasChanged();
    }

    /// <summary>Validate and, when valid, hand the draft to the host through OnSubmit.</summary>
    public async Task<bool> TrySubmitAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(title)) { error = "A title is required."; return false; }
        if (!string.IsNullOrWhiteSpace(numberText) && ParsedNumber is null)
        {
            error = "The variation number must be a positive whole number.";
            return false;
        }
        if (ParsedNumber is { } requested && UsedNumbers.Contains(requested))
        {
            error = $"V{requested} already exists on this project — choose a different number.";
            return false;
        }
        // The lines validate in the panel, which shows its own reason next to the rows.
        var buildUp = linesPanel?.TryBuildRequest();
        if (buildUp is null) return false;

        await OnSubmit.InvokeAsync(new Draft(
            title.Trim(),
            string.IsNullOrWhiteSpace(description) ? null : description.Trim(),
            buildUp.Lines,
            buildUp.Total,
            ParsedNumber,
            string.IsNullOrWhiteSpace(commercialBasis) ? null : commercialBasis.Trim(),
            string.IsNullOrWhiteSpace(programmeImpact) ? null : programmeImpact.Trim(),
            string.IsNullOrWhiteSpace(exclusions) ? null : exclusions.Trim()));
        return true;
    }
}
