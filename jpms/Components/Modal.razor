@inject ChatPanelState Chat
@implements IDisposable

@if (IsOpen)
{
    <div class="@OverlayClass" @onclick="HandleOverlayClick">
        <div class="modal-panel @Class flex flex-col max-h-[85vh]" @onclick:stopPropagation="true">
            <header class="shrink-0 flex items-center justify-between gap-3 px-5 py-4 border-b border-line">
                <h2 class="text-base font-semibold text-content">@Title</h2>
                <button type="button" @onclick="OnCancel" aria-label="Close"
                        class="inline-flex items-center justify-center w-8 h-8 rounded-md text-content-subtle hover:text-content hover:bg-surface-raised">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </header>

            <div class="px-5 py-4 overflow-y-auto grow">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <footer class="shrink-0 flex items-center justify-end gap-2 px-5 py-4 border-t border-line">
                    @FooterContent
                </footer>
            }
            else if (ShowFooter)
            {
                <footer class="shrink-0 flex items-center justify-end gap-2 px-5 py-4 border-t border-line">
                    <button type="button" class="btn-neutral" @onclick="OnCancel">@CancelLabel</button>
                    <button type="button" class="btn-primary" disabled="@ConfirmDisabled" @onclick="OnConfirm">@ConfirmLabel</button>
                </footer>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // When set, replaces the default Cancel/Action footer buttons entirely (ShowFooter is ignored) —
    // for dialogs whose actions don't fit the two-button shape (e.g. the to-do detail modal).
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string ConfirmLabel { get; set; } = "Action";
    [Parameter] public bool ConfirmDisabled { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Opt in to being worked ALONGSIDE the assistant rather than instead of it: while the chat
    /// panel is open the overlay reserves its width, so this dialog centres in the column beside the
    /// conversation instead of underneath it (.modal-overlay-chat), and ChatPanel raises itself
    /// above the overlay so it stays live. Off by default, so every other dialog is untouched.
    /// </summary>
    [Parameter] public bool ChatAware { get; set; }

    /// <summary>
    /// Clicking the backdrop cancels. Set false for a dialog holding state that reopening cannot
    /// rebuild — a stray click beside a live conversation must not throw away a drafted variation
    /// and the exchange that produced it. The header X and the Cancel button still work.
    /// </summary>
    [Parameter] public bool DismissOnOverlayClick { get; set; } = true;

    // Only a chat-aware dialog listens: otherwise all ~74 modals in the app would re-render every
    // time the panel slides open or shut, for a class name none of them use.
    private bool subscribed;

    private string OverlayClass =>
        ChatAware && Chat.IsOpen ? "modal-overlay modal-overlay-chat" : "modal-overlay";

    protected override void OnInitialized()
    {
        if (!ChatAware) return;
        Chat.OnChange += StateHasChanged;
        subscribed = true;
    }

    private Task HandleOverlayClick() =>
        DismissOnOverlayClick ? OnCancel.InvokeAsync() : Task.CompletedTask;

    public void Dispose()
    {
        if (subscribed) Chat.OnChange -= StateHasChanged;
    }
}
