@implements IDisposable
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="@OverlayClass" @onclick="HandleOverlayClick">
        <div class="modal-panel @Class flex flex-col max-h-[85vh] outline-none" tabindex="-1"
             @ref="panelRef" @onclick:stopPropagation="true">
            @* The Figma modal: 32px padding, 24/Semi title, a hairline under the header, Large buttons
               in the footer (see .modal-panel and [data-modal-footer] in app.tailwind.css). *@
            <header class="shrink-0 flex items-center justify-between gap-3 px-8 pt-8 pb-4 border-b border-line-strong">
                <h2 class="text-2xl font-semibold text-content">@Title</h2>
                <button type="button" @onclick="OnCancel" aria-label="Close"
                        class="inline-flex items-center justify-center w-8 h-8 rounded text-content hover:bg-surface-raised">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </header>

            <div class="px-8 py-6 overflow-y-auto grow" data-modal-body>
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <footer class="shrink-0 flex items-center justify-end gap-2.5 px-8 pt-4 pb-8" data-modal-footer>
                    @FooterContent
                </footer>
            }
            else if (ShowFooter)
            {
                <footer class="shrink-0 flex items-center justify-end gap-2.5 px-8 pt-4 pb-8" data-modal-footer>
                    <button type="button" class="btn-secondary btn-lg" @onclick="OnCancel">@CancelLabel</button>
                    <button type="button" class="btn-primary btn-lg" disabled="@ConfirmDisabled" @onclick="OnConfirm">@ConfirmLabel</button>
                </footer>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    // When set, replaces the default Cancel/Action footer buttons entirely (ShowFooter is ignored) —
    // for dialogs whose actions don't fit the two-button shape (e.g. the to-do detail modal).
    [Parameter] public RenderFragment? FooterContent { get; set; }
    [Parameter] public bool ShowFooter { get; set; } = true;
    [Parameter] public string CancelLabel { get; set; } = "Cancel";
    [Parameter] public string ConfirmLabel { get; set; } = "Action";
    [Parameter] public bool ConfirmDisabled { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>
    /// Opt in to being worked ALONGSIDE the assistant rather than instead of it: while the chat
    /// panel is open the overlay reserves its width, so this dialog centres in the column beside the
    /// conversation instead of underneath it (.modal-overlay-chat), and ChatPanel raises itself
    /// above the overlay so it stays live. Off by default, so every other dialog is untouched.
    /// </summary>

    /// <summary>
    /// Clicking the backdrop cancels. Set false for a dialog holding state that reopening cannot
    /// rebuild — a stray click beside a live conversation must not throw away a drafted variation
    /// and the exchange that produced it. The header X and the Cancel button still work.
    /// </summary>
    [Parameter] public bool DismissOnOverlayClick { get; set; } = true;

    private string OverlayClass => "modal-overlay";

    private ElementReference panelRef;
    private bool wasOpen;
    private bool focusPending;

    // Focus the first control the moment the dialog opens, so the user can begin straight
    // away (type the folder name, hit Enter) instead of reaching for the mouse. Detected as
    // the closed→open transition — a fresh instance rendered already-open counts too — and
    // performed after render, once the panel exists in the DOM. jpmsModalAutofocus (wwwroot/
    // js/modal-autofocus.js) picks the target: first body control, else the footer's Cancel.
    protected override void OnParametersSet()
    {
        if (IsOpen && !wasOpen) focusPending = true;
        wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusPending || !IsOpen) return;
        focusPending = false;
        try { await JS.InvokeVoidAsync("jpmsModalAutofocus", panelRef); }
        catch { /* focus is a courtesy — never let it break the dialog */ }
    }

    private Task HandleOverlayClick() =>
        DismissOnOverlayClick ? OnCancel.InvokeAsync() : Task.CompletedTask;

    public void Dispose()
    {
    }
}
