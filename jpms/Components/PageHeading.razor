@inject NavigationManager Nav
@inject SessionService Session
@implements IDisposable

<h1 class="text-xl font-medium text-content truncate">@CurrentTitle</h1>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += HandleLocationChanged;

    // The matcher itself lives in PageContext so the assistant panel's context line names the
    // middle column exactly as this heading does.
    private string CurrentTitle =>
        PageContext.LabelFor(new Uri(Nav.Uri).AbsolutePath, Session.ActiveRole) ?? "";

    private void HandleLocationChanged(object? sender, EventArgs args) => StateHasChanged();

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
