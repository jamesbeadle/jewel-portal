@using Jewel.JPMS.Contracts.Todos
@inject ITodoStore Todos
@inject SessionService Session
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects

@*
    "My to-dos" — the dashboard home panel. Shows the OPEN items assigned to any ROLE the
    signed-in user holds, general (company-wide) and project items alike, read through
    ListMyTodoItems (the server stamps the roles from the session). Rows show only the title;
    clicking one opens the detail modal (TodoDetailModal) with the full detail, the item's linked
    emails, and the Mark done action — the API allows a role-holder to update their role's items
    even outside the manage-todos gate. Completing removes the item from this open-only panel.
    The full list, with filters and done items, lives on the /todos page.
*@

<div class="panel p-5">
    <div class="flex items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-3">
            <h2 class="text-sm font-semibold text-content">My to-dos</h2>
            @if (!loading && openItems.Count > 0)
            {
                <span class="text-[11px] text-content-subtle">@openItems.Count open</span>
            }
        </div>
        <a href="/todos" class="text-xs font-medium text-accent hover:underline">View all</a>
    </div>
    <p class="text-xs text-content-subtle mb-4">
        Items assigned to your role — general and project to-dos alike. Click one for its detail,
        linked emails and to mark it done.
    </p>

    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@error</p>
    }

    @if (loading)
    {
        <JewelSpinner Class="py-6" Label="Loading" />
    }
    else if (openItems.Count == 0)
    {
        <p class="text-sm text-content-subtle italic">Nothing is assigned to your role right now.</p>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var item in openItems)
            {
                <button type="button" @key="item.TodoItemId" title="Open this item"
                        class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                        @onclick="() => selected = item">
                    <p class="truncate text-sm text-content">
                        <span class="font-mono text-xs text-content-muted mr-2">@item.Reference</span>@item.Title
                    </p>
                    <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                        <span class="whitespace-nowrap @(IsGeneral(item) ? "text-accent font-medium" : "")">@ScopeLabel(item)</span>
                        @if (item.DueAt is not null)
                        {
                            <span class="whitespace-nowrap @(IsOverdue(item) ? "text-negative font-medium" : "")">Due @item.DueAt.Value.LocalDateTime.ToString("d MMM yyyy")</span>
                        }
                        @if (item.AssigneeRole is Role assignedRole)
                        {
                            <span class="whitespace-nowrap">Assigned to @assignedRole.DisplayName()</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

<TodoDetailModal Item="@selected" Busy="@busy" Error="@(selected is null ? null : error)"
                 ScopeLabel="@(selected is null ? null : ScopeLabel(selected))"
                 CanComplete="true" CanDelete="false"
                 CanReassign="@CanManage" AssigneeOptions="@assigneeOptions"
                 OnClose="() => selected = null"
                 OnToggleComplete="Complete" OnReassign="Reassign" />

@code {
    /// <summary>
    /// Fires with the current OPEN items whenever they change — on the initial load and after a
    /// complete or reassign takes one out of (or back into) the list. RoleHome feeds its
    /// open/overdue to-do count tiles from this, so the strip and the panel are always the same
    /// fetch telling the same story — the tiles never show a figure the rows below contradict.
    /// </summary>
    [Parameter] public EventCallback<IReadOnlyList<TodoItem>> OnOpenItemsChanged { get; set; }

    private IReadOnlyList<TodoItem> openItems = Array.Empty<TodoItem>();
    // The role pool for the detail modal's reassign picker — fetched only for users inside the
    // manage gate, who are the only ones offered the control.
    private IReadOnlyList<SearchSelect.Option> assigneeOptions = Array.Empty<SearchSelect.Option>();
    private bool loading = true;
    private bool busy;
    private string? error;

    // The item open in the detail modal (null = closed). This panel lists open items only, so a
    // successful complete closes the modal and drops the item from the panel; the /todos page is
    // where it reappears under Done.
    private TodoItem? selected;

    // Mirrors the API's TodoRoles.AllowedToManageTodos gate: directors, project managers, site
    // managers and accounts (administrators carry every role). Everyone else can tick their own
    // items off here but not hand them on.
    private bool CanManage =>
        Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.ProjectManager
            or Role.SiteManager or Role.Accounts);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        // Project labels for the modal's scope line — a failed load degrades the label, never the list.
        try { if (Projects.Current is null) await Projects.RefreshAsync(CancellationToken.None); } catch { }
        // A failed load leaves the reassign picker with no options, which hides the control — the
        // panel's own job (read and tick off) is untouched.
        if (CanManage)
        {
            try
            {
                assigneeOptions = (await Todos.ListAssignableRolesAsync())
                    .Select(role => new SearchSelect.Option(((int)role).ToString(), role.DisplayName()))
                    .ToList();
            }
            catch { }
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            openItems = (await Todos.ListMineAsync()).Where(item => !item.IsComplete).ToList();
            await OnOpenItemsChanged.InvokeAsync(openItems);
        }
        catch { error = "Couldn't load your to-dos right now."; }
        finally { loading = false; }
    }

    private async Task Complete(TodoItem item)
    {
        if (busy) return;
        error = null;
        try
        {
            busy = true;
            await Todos.UpdateAsync(new UpdateTodoItem(
                item.TodoItemId,
                item.Title,
                NullIfBlank(item.Notes),
                item.AssigneeRole,
                item.DueAt,
                IsComplete: true));
            openItems = openItems.Where(open => open.TodoItemId != item.TodoItemId).ToList();
            await OnOpenItemsChanged.InvokeAsync(openItems);
            selected = null;
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "That action didn't complete. Please try again."; }
        finally { busy = false; }
    }

    // Hand the item to a different role. This panel is "items assigned to MY role", so passing one
    // on usually means it leaves the panel — reload and re-find, and close the modal when it has
    // gone rather than leaving a record on screen that is no longer this reader's.
    private async Task Reassign(Role? role)
    {
        if (busy || selected is null) return;
        var item = selected;
        if (role == item.AssigneeRole) return;
        error = null;
        try
        {
            busy = true;
            await Todos.UpdateAsync(new UpdateTodoItem(
                item.TodoItemId,
                item.Title,
                NullIfBlank(item.Notes),
                role,
                item.DueAt,
                item.IsComplete));
            openItems = (await Todos.ListMineAsync()).Where(open => !open.IsComplete).ToList();
            await OnOpenItemsChanged.InvokeAsync(openItems);
            selected = openItems.FirstOrDefault(open => open.TodoItemId == item.TodoItemId);
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "That action didn't complete. Please try again."; }
        finally { busy = false; }
    }

    private static bool IsGeneral(TodoItem item) => string.IsNullOrWhiteSpace(item.ProjectId);

    private string ScopeLabel(TodoItem item)
    {
        if (IsGeneral(item)) return "General";
        var project = (Projects.Current ?? (IReadOnlyList<Project>)Array.Empty<Project>())
            .FirstOrDefault(p => p.ProjectId == item.ProjectId);
        return project is null ? "Project" : $"{project.Reference} — {project.Name}";
    }

    private static bool IsOverdue(TodoItem item) =>
        !item.IsComplete && item.DueAt is not null && item.DueAt.Value < DateTimeOffset.Now.Date;

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
