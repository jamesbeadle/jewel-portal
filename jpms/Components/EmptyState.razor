@namespace Jewel.JPMS.Components

@*
    THE "nothing here" line. Centred, quiet (14/Reg, subtle), with room for the one action that
    changes it. Renders only when its region has LOADED and is empty — the gate above decides;
    an EmptyState must never stand in for a list that is still fetching.
*@

<div class="py-10 px-6 text-center @Class">
    <p class="text-sm text-content-subtle">@Message</p>
    @if (ChildContent is not null)
    {
        <div class="mt-4 flex justify-center">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
