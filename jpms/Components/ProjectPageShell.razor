@using Jewel.JPMS.Features.Projects
@inject ProjectListReadModel Projects
@inject CurrentProjectService CurrentProject
@inject ProjectStageFilter StageFilter
@inject NavigationManager Nav
@implements IDisposable

@if (Projects.Current is null)
{
    @* The project list hasn't loaded yet — render a quiet loading state rather than
       flashing "Project not found" before the data arrives. *@
    <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
}
else if (Project is null)
{
    <PageHeader Title="Project not found" />
    <p class="text-content-muted">
        <a class="text-content underline" href="/projects">Back to projects</a>.
    </p>
}
else
{
    <div>
        <nav class="mb-4 text-sm">
            <a href="/projects" class="text-content-subtle hover:text-content underline underline-offset-4">Projects</a>
            <span class="text-content-subtle mx-2">/</span>
            <a href="@($"/projects/{Project.ProjectId}")" class="text-content-subtle hover:text-content underline underline-offset-4">@Project.Reference</a>
        </nav>

        <PageHeader Eyebrow="@Project.Reference">
            <TitleContent>
                @* Cycle through the switcher's projects by reference, looping at either end,
                   staying on the current tab (completed projects join the loop when the picker's
                   "Show completed" toggle is on). Hidden when there's nowhere else to go. *@
                @if (Neighbour(-1) is { } previous)
                {
                    <button type="button" @onclick="() => GoTo(previous)"
                            aria-label="Previous project" title="@($"{previous.Reference} · {previous.Name}")"
                            class="inline-flex items-center justify-center w-8 h-8 rounded text-content-subtle hover:text-content hover:bg-surface-raised shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
                    </button>
                }

                @* The sidebar's project picker is THE switcher; the title stays a plain heading
                   with the quick prev/next arrows either side. *@
                <span>@Project.Name</span>

                @if (Neighbour(1) is { } next)
                {
                    <button type="button" @onclick="() => GoTo(next)"
                            aria-label="Next project" title="@($"{next.Reference} · {next.Name}")"
                            class="inline-flex items-center justify-center w-8 h-8 rounded text-content-subtle hover:text-content hover:bg-surface-raised shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                    </button>
                }
            </TitleContent>
            <SubtitleContent>@Project.ClientName · @Project.Organisation.ShortCode() · <ProjectStageBadge Stage="Project.Stage" /></SubtitleContent>
        </PageHeader>

        @ChildContent
    </div>
}

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    // The page's slug — switching project (arrows or the sidebar picker) stays on the same page.
    // Empty on the project landing page.
    [Parameter] public string ActiveTab { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Project? Project => Projects.Find(ProjectId);

    // The switcher/arrow loop: active (non-Completed) projects in the canonical work order
    // (ProjectOrdering.InWorkOrder) — so the arrows walk the same sequence the switcher lists.
    // With the picker's "Show completed" toggle on (ProjectStageFilter), completed projects join
    // the loop in their own band at the end, exactly as the switcher lists them.
    private List<Project> Cycle =>
        (Projects.Current ?? (IReadOnlyList<Project>)Array.Empty<Project>())
            .Where(project => StageFilter.IncludeCompleted || project.Stage != ProjectStage.Completed)
            .InWorkOrder()
            .ToList();

    private Project? Neighbour(int step)
    {
        var cycle = Cycle;
        var index = cycle.FindIndex(project =>
            string.Equals(project.ProjectId, ProjectId, StringComparison.OrdinalIgnoreCase));

        // Viewing a Completed project (not in the loop): both arrows enter the loop at its
        // nearest end rather than disappearing entirely.
        if (index < 0)
            return cycle.Count == 0 ? null : (step > 0 ? cycle[0] : cycle[^1]);

        if (cycle.Count < 2) return null;
        return cycle[(index + step + cycle.Count) % cycle.Count];
    }

    private void GoTo(Project project) =>
        Nav.NavigateTo(string.IsNullOrEmpty(ActiveTab)
            ? $"/projects/{project.ProjectId}"
            : $"/projects/{project.ProjectId}/{ActiveTab}");

    protected override async Task OnInitializedAsync()
    {
        Projects.OnChanged += StateHasChanged;
        StageFilter.OnChange += StateHasChanged;
        _ = StageFilter.EnsureLoadedAsync();
        // The cold-load path has to swallow too, for the same reason the background one does: an
        // exception escaping OnInitializedAsync replaces every project page with the error boundary,
        // so a single failed read would take out the whole project section rather than showing
        // "Project not found" and letting the next navigation retry. The failure still reaches the
        // toast via the query client's error sink.
        if (Projects.Current is null) await RefreshInBackgroundAsync();
        else
        {
            RememberIfReal(); // The cached list already knows it — switch the side nav at once.
            _ = RefreshInBackgroundAsync(); // stale-while-revalidate: header/stage update on tab nav
        }
    }

    /// <summary>
    /// Every project page passing through the shell marks its project as the one the user is
    /// working on — the side nav's project-scoped entries follow it — but only a project that
    /// EXISTS. Remembering the raw route value put whatever a bad URL carried (a site-map
    /// placeholder, a reference, a typo — live, 2026-08-25, from an assistant navigate_to) at
    /// the head of the recent-projects list, where it stuck as the "current" project until the
    /// next real visit while the side nav quietly fell back to the first live project.
    /// </summary>
    private void RememberIfReal()
    {
        if (Project is not null) _ = CurrentProject.RememberAsync(Project.ProjectId);
    }

    private async Task RefreshInBackgroundAsync()
    {
        // Fire-and-forget must swallow failures: the cached list is still shown, and the next
        // navigation retries.
        try { await Projects.RefreshAsync(CancellationToken.None); }
        catch { }
        // After the fresh list lands: the cold load's first chance, and the warm path's catch-up
        // for a project created since the list was cached.
        RememberIfReal();
    }

    public void Dispose()
    {
        Projects.OnChanged -= StateHasChanged;
        StageFilter.OnChange -= StateHasChanged;
    }
}
