@using Jewel.JPMS.Contracts.ProjectContracts
@inject IProjectContractStore Contracts

@*
    Keys the contract terms — the row every clause citation, retention calculation and OH&P
    addition on the project is argued from (docs/ai/03-qs-capability-pack.md §13). The AI's
    get_project_contract tool reads exactly these fields, and the system prompt forbids it quoting
    a percentage or notice period without calling that tool first: until this dialog is used, it
    correctly answers "no contract has been recorded".

    Rendered only while open (the parent guards with @@if), so it always seeds fresh from the
    stored row rather than from whatever was typed and abandoned last time.

    The document is deliberately untouched here — SetProjectContractTerms does not carry it, so
    re-keying a term can never detach the executed contract.
*@

<Modal IsOpen="true" Title="@(Current is null ? "Record contract terms" : "Edit contract terms")"
       Class="max-w-3xl" OnCancel="Cancel">
    <ChildContent>

    <div class="space-y-6">

        <section>
            <h4 class="eyebrow mb-2">The form</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="@LabelClass">Form *</label>
                    <select class="field" @bind="form">
                        @foreach (var option in Enum.GetValues<ContractForm>())
                        {
                            <option value="@option">@option.LongName(null)</option>
                        }
                    </select>
                </div>
                <FormField Label="Edition" Value="@formEdition" OnChange="v => formEdition = v" />
            </div>
            <div class="mt-3">
                <label class="@LabelClass">Amendments and deviations</label>
                <textarea class="field" rows="3" @bind="bespokeDeviations"
                          placeholder="How this contract departs from the standard form. Leave blank if unamended."></textarea>
                <p class="text-xs text-content-subtle mt-1">
                    Anything citing a clause number checks this first — an amended form does not map to the standard.
                    Required for a bespoke form.
                </p>
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">The parties</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <FormField Label="Employer" Value="@employerName" OnChange="v => employerName = v" />
                <FormField Label="Contractor" Value="@contractorName" OnChange="v => contractorName = v" />
                <FormField Label="Contract administrator" Value="@caName" OnChange="v => caName = v" />
                <FormField Label="Contract administrator email" Value="@caEmail" OnChange="v => caEmail = v" InputType="email" />
                <FormField Label="Architect" Value="@architectName" OnChange="v => architectName = v" />
                <FormField Label="Architect email" Value="@architectEmail" OnChange="v => architectEmail = v" InputType="email" />
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">The money</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="@LabelClass">Contract sum (£)</label>
                    <input type="number" step="0.01" min="0" class="field" @bind="contractSum" />
                </div>
                <div>
                    <label class="@LabelClass">Liquidated damages (£ per week)</label>
                    <input type="number" step="0.01" min="0" class="field" @bind="liquidatedDamagesPerWeek" />
                </div>
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">The dates</h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="@LabelClass">Contract date</label>
                    <input type="date" class="field" @bind="contractDate" />
                </div>
                <div>
                    <label class="@LabelClass">Date of possession</label>
                    <input type="date" class="field" @bind="possessionDate" />
                </div>
                <div>
                    <label class="@LabelClass">Completion date</label>
                    <input type="date" class="field" @bind="completionDate" />
                </div>
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">Retention and defects</h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="@LabelClass">Retention (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="retentionPercent" />
                </div>
                <div>
                    <label class="@LabelClass">After completion (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="retentionPercentAfterCompletion" />
                </div>
                <div>
                    <label class="@LabelClass">Defects liability (months)</label>
                    <input type="number" step="1" min="0" max="240" class="field" @bind="defectsLiabilityPeriodMonths" />
                </div>
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">The payment mechanism</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="@LabelClass">Valuation cut-off (day of month)</label>
                    <input type="number" step="1" min="1" max="28" class="field" @bind="applicationCutOffDayOfMonth"
                           placeholder="Leave blank if not fixed" />
                    <p class="text-xs text-content-subtle mt-1">1–28, so it falls in every month.</p>
                </div>
                <div>
                    <label class="@LabelClass">Payment notice (days after the valuation)</label>
                    <input type="number" step="1" min="0" max="90" class="field" @bind="paymentNoticeDays" />
                </div>
                <div>
                    <label class="@LabelClass">Pay-less notice (days before final date)</label>
                    <input type="number" step="1" min="0" max="90" class="field" @bind="payLessNoticeDays" />
                </div>
                <div>
                    <label class="@LabelClass">Final date for payment (days after due date)</label>
                    <input type="number" step="1" min="0" max="180" class="field" @bind="finalDateForPaymentDays" />
                </div>
            </div>
        </section>

        <section>
            <h4 class="eyebrow mb-2">Overheads, profit and attendance</h4>
            @if (Current is null)
            {
                <p class="text-xs text-content-subtle mb-2">
                    Shown at the rates these usually run at. They are contract terms, not house defaults —
                    check each against the Contract Particulars before saving, because every variation
                    priced on this project uses them.
                </p>
            }
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="@LabelClass">OH&amp;P, direct works (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="ohpDirectWorksPercent" />
                </div>
                <div>
                    <label class="@LabelClass">OH&amp;P, subcontractor (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="ohpSubcontractorPercent" />
                </div>
                <div>
                    <label class="@LabelClass">Attendance, client direct (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="attendanceOnClientDirectPercent" />
                </div>
                <div>
                    <label class="@LabelClass">Daywork labour (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="dayworkLabourPercent" />
                </div>
                <div>
                    <label class="@LabelClass">Daywork materials (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="dayworkMaterialsPercent" />
                </div>
                <div>
                    <label class="@LabelClass">Daywork plant (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="field" @bind="dayworkPlantPercent" />
                </div>
            </div>
        </section>
    </div>

    </ChildContent>
    <FooterContent>
        @*
            In the footer, not the body: the body scrolls (six sections inside max-h-[85vh]) while
            the footer is pinned, so an error rendered at the bottom of the form would be off-screen
            at the moment the user pressed Save and nothing would appear to have happened.
        *@
        @if (error is not null)
        {
            <p class="mr-auto text-sm text-negative">@error</p>
        }
        <button type="button" class="btn-neutral" disabled="@busy" @onclick="Cancel">Cancel</button>
        <button type="button" class="btn-primary" disabled="@busy" @onclick="SaveAsync">
            @(busy ? "Saving…" : "Save terms")
        </button>
    </FooterContent>
</Modal>

