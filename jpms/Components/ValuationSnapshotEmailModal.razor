@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Models
@using Jewel.JPMS.Features.Triage
@inject ICommandSender Commands
@inject IQueryClient Queries

@* The client-facing valuation statement on its way out: Send delivers it from the shared projects
   mailbox — the frozen report rendered server-side and attached as the branded PDF, addressed to
   the project's Client and Architect contacts (projects@ is cc'd automatically) — and Save as draft
   leaves it in Drafts for Outlook instead. The snapshot is immutable, so the attachment is the
   report exactly as frozen, however long it sits. Used from the Valuation Report tab's snapshot
   register and the Valuation Snapshots page. *@
<Modal IsOpen="@(Snapshot is not null)"
       Title="@($"Email valuation report · {Snapshot?.Label}")"
       OnCancel="Close"
       Class="max-w-3xl w-full">
    <ChildContent>
    @if (Snapshot is { } snapshot)
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Sends from the shared projects mailbox with the frozen report attached as a PDF, to the
            project's client and architect contacts. The snapshot is immutable, so the attachment
            shows the report exactly as it stood on @DateTimeText(snapshot.TakenAt).
            Save as draft to review it in Outlook first.
        </p>

        @if (snapshot.IsSuperseded)
        {
            <p class="rounded bg-warning/10 border border-warning/30 px-3 py-2 text-xs text-content mb-3">
                A later snapshot has superseded this one — check you're not sending figures the
                client has already had corrected.
            </p>
        }

        <RecordsTable Dense="true" MaxHeight="" Class="mb-3">
            <tbody>
                <tr>
                    <td class="text-content-subtle whitespace-nowrap">Revised contract sum</td>
                    <td class="text-right text-content">@Money(snapshot.RevisedContractSum)</td>
                    <td class="text-content-subtle whitespace-nowrap">Total works complete</td>
                    <td class="text-right text-content">@Money(snapshot.TotalWorksComplete)</td>
                </tr>
                <tr>
                    <td class="text-content-subtle whitespace-nowrap">Certified to date</td>
                    <td class="text-right text-content">@Money(snapshot.CertifiedToDate)</td>
                    <td class="text-content-subtle whitespace-nowrap">Payment due (ex VAT)</td>
                    <td class="text-right font-semibold text-content">@Money(snapshot.PaymentDueExVat)</td>
                </tr>
            </tbody>
        </RecordsTable>

        <div class="flex items-center justify-between gap-3 mb-3">
            <a class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
               href="@($"/api/valuation-report-snapshots/{snapshot.ValuationReportSnapshotId}/pdf")" target="_blank" rel="noopener">
                Download the report PDF (what gets attached)
            </a>
            <span class="text-xs text-content-subtle">All figures net of VAT</span>
        </div>

        @if (drafted)
        {
            <Notice Tone="@(sent ? Tone.Positive : sendFailure is null ? Tone.Info : Tone.Warning)">
                <p class="mb-1">@OutcomeText</p>
                @if (draftLink is not null)
                {
                    <a class="underline underline-offset-4 font-medium" href="@draftLink" target="_blank" rel="noopener">Open it in Outlook on the web</a>
                }
            </Notice>
        }
        else
        {
            <p class="text-xs text-content-subtle mb-1">This is the email as it will go:</p>
            <RecordEmailPreviewPanel Preview="preview" Loading="previewing" Error="@previewError" />

            <FormField Label="Subject" Class="mt-3">
            <input class="field mb-3" @bind="subject" />
            </FormField>

            <FormField Label="Cover note — the report itself travels as the attached PDF">
            <RichTextEditor @bind-Value="htmlBody" MinHeight="220" />
            </FormField>
        }

        @if (error is not null)
        {
            <Notice Tone="Tone.Negative" Class="mt-3">@error</Notice>
        }
    }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn-secondary btn-lg" @onclick="Close">Close</button>
        <button type="button" class="btn-secondary btn-lg" disabled="@CannotSend"
                @onclick="() => EmailSnapshotAsync(saveAsDraftOnly: true)">Save as draft</button>
        <button type="button" class="btn-primary btn-lg" disabled="@CannotSend"
                @onclick="() => EmailSnapshotAsync(saveAsDraftOnly: false)">@(busy ? "Working…" : "Send to client")</button>
    </FooterContent>
</Modal>

@code {
    /// <summary>The snapshot to email; null keeps the modal closed.</summary>
    [Parameter] public ValuationReportSnapshot? Snapshot { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");

    private string? preparedForSnapshotId;

    private bool busy;
    private bool drafted;
    private bool sent;
    private string? sendFailure;
    private string? error;
    private string? draftLink;
    private string draftRecipients = "";

    private string subject = "";
    private string htmlBody = "";

    private string? previewedSnapshotId;
    private bool previewing;
    private string? previewError;
    private RecordEmailPreview? preview;

    private bool CannotSend => busy || drafted || Snapshot is null;

    private string OutcomeText =>
        sent ? $"Sent to {draftRecipients} with the report PDF attached."
        : sendFailure ?? $"Draft created in the shared mailbox to {draftRecipients}, with the report PDF "
            + "attached. Review and send it from the mailbox's Drafts folder.";

    protected override void OnParametersSet()
    {
        if (Snapshot is null)
        {
            // Reset the per-open outcome so reopening starts clean.
            drafted = false;
            sent = false;
            sendFailure = null;
            error = null;
            draftLink = null;
            preparedForSnapshotId = null;
            return;
        }

        if (preparedForSnapshotId == Snapshot.ValuationReportSnapshotId) return;
        preparedForSnapshotId = Snapshot.ValuationReportSnapshotId;
        drafted = false;
        sent = false;
        sendFailure = null;
        error = null;
        draftLink = null;
        subject = "";
        htmlBody = "";
    }

    /// <summary>The subject and the covering note are the SERVER'S, read through the preview: this
    /// page composed its own copy of both until 2026-09-18, so the portal held two spellings of one
    /// email and only the page's could ever be seen.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (Snapshot is not { } snapshot) { preview = null; return; }
        if (previewedSnapshotId == snapshot.ValuationReportSnapshotId) return;
        previewedSnapshotId = snapshot.ValuationReportSnapshotId;
        previewError = null;
        previewing = true;
        try
        {
            preview = await Queries.AskAsync(
                new PreviewRecordEmail(RecordType.ValuationReportSnapshot, snapshot.ValuationReportSnapshotId),
                CancellationToken.None);
            subject = preview.Subject;
            htmlBody = preview.BodyHtml;
        }
        catch
        {
            preview = null;
            previewError = "Couldn't read the email yet — check the project has a client or architect contact with an email address.";
        }
        finally { previewing = false; }
    }

    private async Task EmailSnapshotAsync(bool saveAsDraftOnly)
    {
        if (busy || drafted || Snapshot is null) return;
        error = null;
        try
        {
            busy = true;
            var outcome = await Commands.SendAsync(
                new SendValuationReportSnapshotEmail(
                    Snapshot.ValuationReportSnapshotId, subject.Trim(), htmlBody, saveAsDraftOnly),
                CancellationToken.None);
            drafted = true;
            sent = outcome.Sent;
            sendFailure = outcome.FailureNote;
            draftRecipients = string.Join(", ", outcome.RecipientEmails);
            draftLink = outcome.WebLink;
        }
        catch (CommandFailedException ex) { error = $"Couldn't email the valuation report: {ex.Message}"; }
        catch { error = "Couldn't email the valuation report. Check the project has a client or architect contact with an email address and the mailbox connection, then try again."; }
        finally { busy = false; }
    }

    private Task Close() => OnClose.InvokeAsync();
}
