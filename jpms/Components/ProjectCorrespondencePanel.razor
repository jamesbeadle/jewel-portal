@using Jewel.JPMS.Contracts.Projects
@using Jewel.JPMS.Features.Projects
@inject ProjectListReadModel Projects
@inject ICorrespondenceStore Correspondence
@inject IClientStore ClientStore
@inject IArchitectStore ArchitectStore
@inject SessionService Session

@*
    The project's correspondence profile: who its request documents (RFIs etc.) go to.
    - The To correspondent follows the project's party (set via "Edit details"); the party's
      contact book supplies the people, each at their default To/CC/BCC routing.
    - Per-project overrides re-route a party contact for this project only (e.g. BCC the
      practice's finance person here but nowhere else).
    - Project contacts — the project's own contact list: consultants, engineers, internal Jewel
      staff or any third party. Each has a role and a routing; Off means the contact is on the
      list without being copied on issued documents.
*@

<div class="panel p-5 mb-6">
    <div class="flex items-center justify-between gap-3 mb-3">
        <h3 class="eyebrow">Correspondence</h3>
        @if (loading)
        {
            <JewelIcon Class="w-3.5 h-3.5 animate-jewel-pulse" />
        }
    </div>

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-3">@error</Notice>
    }

    @if (Project is null)
    {
        <p class="text-sm text-content-subtle">Project not loaded.</p>
    }
    else
    {
        @if (string.IsNullOrEmpty(Project.PartyId))
        {
            <p class="text-sm text-content-subtle mb-4">No corresponding party is set. Use <span class="font-medium">Edit details</span> to choose the client or architect this project corresponds with; their contacts then appear here.</p>
        }
        else
        {
            <p class="text-sm text-content mb-3">
                Corresponds with <span class="font-medium">@(partyName ?? "…")</span>
                <span class="text-content-subtle">(@Project.PartyKind.DisplayName().ToLowerInvariant())</span>
                — request documents are addressed to the practice's primary contact; CC/BCC contacts are copied on every issue.
            </p>

            @if (partyContacts.Count > 0)
            {
                <div class="border border-line rounded-lg overflow-hidden mb-4">
                    <table class="data-table data-table-dense">
                        <thead>
                            <tr>
                                <th>Contact</th>
                                <th>Email</th>
                                <th>On this project</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contact in partyContacts)
                            {
                                var effective = EffectiveRouting(contact);
                                var overridden = OverrideFor(contact.PartyContactId) is not null;
                                <tr>
                                    <td class="text-content">
                                        @contact.Name
                                        @if (contact.IsPrimary)
                                        {
                                            <Pill Tone="Tone.Info" Class="ml-2">Primary</Pill>
                                        }
                                    </td>
                                    <td>@contact.Email</td>
                                    <td class="whitespace-nowrap">
                                        <select class="field text-xs py-1 inline-block w-auto" value="@((int)effective)" disabled="@(busy || !CanManage)"
                                                @onchange="e => SetPartyContactRoutingAsync(contact, e)">
                                            <option value="@((int)CorrespondenceRouting.To)">To</option>
                                            <option value="@((int)CorrespondenceRouting.Cc)">CC</option>
                                            <option value="@((int)CorrespondenceRouting.Bcc)">BCC</option>
                                            <option value="@((int)CorrespondenceRouting.None)">Off</option>
                                        </select>
                                        @if (overridden)
                                        {
                                            <span class="ml-2 eyebrow" title="This project overrides the contact's default routing">overridden</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (!loading)
            {
                <p class="text-sm text-content-subtle mb-4">The @Project.PartyKind.DisplayName().ToLowerInvariant() has no contacts on its book yet — add them from the @(Project.PartyKind == PartyKind.Architect ? "Architects" : "Clients") page.</p>
            }
        }

        <h4 class="eyebrow mb-2">Project contacts</h4>
        @if (adHocContacts.Count == 0)
        {
            <p class="text-xs text-content-subtle mb-3">No contacts on this project yet. Contacts can be copied (CC/BCC) on every document this project issues.</p>
        }
        else
        {
            <div class="border border-line rounded-lg overflow-hidden mb-3">
                <table class="data-table data-table-dense">
                    <thead>
                        <tr>
                            <th>Contact</th>
                            <th>Email</th>
                            <th>Organisation</th>
                            <th>Role</th>
                            <th>Routing</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contact in adHocContacts)
                        {
                            <tr class="border-b border-line last:border-0 @(contact.ContactId == editingContactId ? "bg-surface-raised" : null)">
                                <td class="text-content">@contact.Name</td>
                                <td>@contact.Email</td>
                                <td>@(contact.Organisation ?? "—")</td>
                                <td>@contact.Role.DisplayName()</td>
                                <td class="whitespace-nowrap">
                                    <select class="field text-xs py-1 inline-block w-auto" value="@((int)contact.Routing)" disabled="@(busy || !CanManage)"
                                            @onchange="e => SetAdHocRoutingAsync(contact, e)">
                                        <option value="@((int)CorrespondenceRouting.None)">Off</option>
                                        <option value="@((int)CorrespondenceRouting.To)">To</option>
                                        <option value="@((int)CorrespondenceRouting.Cc)">CC</option>
                                        <option value="@((int)CorrespondenceRouting.Bcc)">BCC</option>
                                    </select>
                                </td>
                                <td class="text-right whitespace-nowrap">
                                    @if (CanManage)
                                    {
                                        <button type="button" class="text-xs font-medium text-content-muted hover:text-content mr-3"
                                                disabled="@busy" @onclick="() => BeginEdit(contact)">Edit</button>
                                        <button type="button" class="text-xs font-medium text-negative/80 hover:text-negative"
                                                disabled="@busy" @onclick="() => RemoveAdHocAsync(contact)">Remove</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (CanManage)
        {
            <div class="space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <FormField Label="Name" Value="@formName" OnChange="v => formName = v" />
                    <FormField Label="Email" Value="@formEmail" OnChange="v => formEmail = v" InputType="email" />
                    <FormField Label="Organisation" Value="@formOrganisation" OnChange="v => formOrganisation = v" />
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
                    <div>
                        <FormField Label="Role">
                        <select class="field" @bind="formRole">
                            @foreach (var role in RoleOptions)
                            {
                                <option value="@((int)role)">@role.DisplayName()</option>
                            }
                        </select>
                        </FormField>
                    </div>
                    <div>
                        <FormField Label="Routing">
                        <select class="field" @bind="formRouting">
                            <option value="@((int)CorrespondenceRouting.None)">Off — contact list only</option>
                            <option value="@((int)CorrespondenceRouting.To)">To</option>
                            <option value="@((int)CorrespondenceRouting.Cc)">CC</option>
                            <option value="@((int)CorrespondenceRouting.Bcc)">BCC</option>
                        </select>
                        </FormField>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" class="btn-secondary" disabled="@busy" @onclick="SaveContactAsync">
                            @(busy ? "Saving…" : editingContactId is null ? "Add contact" : "Save contact")
                        </button>
                        @if (editingContactId is not null)
                        {
                            <button type="button" class="text-sm text-content-muted hover:text-content" disabled="@busy" @onclick="CancelEdit">Cancel</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

