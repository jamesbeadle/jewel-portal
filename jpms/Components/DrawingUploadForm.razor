@inject IDrawingStore DrawingStore

@* Only the file is required. Code, title, revision and issuer are all optional — a drawing
   uploaded with none of them is shown on the register by its original file name and can be
   named, labelled and filed later from its page.

   The file field accepts MANY files at once — dragged onto the drop zone or multi-selected in
   the dialog. One file keeps the full form; several switch it to bulk mode: each file becomes
   its own drawing (blank code and title, revision label extracted from the file name where it
   is obvious) filed into the chosen folder, so a register can be populated quickly and the
   details attached later through each drawing's page. A zip dropped here is unpacked in the
   browser into its files (DrawingArchiveExpander) — each lands as its own drawing; the zip
   itself is never registered.

   The folder picker sits ABOVE the drop zone and is ONE instance whatever the mode — rendered
   always and only hidden by CSS in revision mode. When it lived inside the single/bulk branches
   a mode switch (dropping a second file after choosing the folder) disposed the picker and
   silently reset the choice to "No folder", which is exactly how drawings ended up ungrouped
   despite a folder having been selected. *@

<EditForm Model="this" OnValidSubmit="HandleUpload"
      class="rounded-2xl border border-line bg-surface p-5 space-y-3">

    <div>
        <h3 class="text-sm font-semibold text-content">Add documents to the register</h3>
        <p class="text-xs text-content-subtle mt-0.5">
            Choose where they go, drop the files in, then press the upload button below — nothing
            is saved to the register until it is pressed.
        </p>
    </div>

    <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
        <button type="button" @onclick="() => SetMode(isRevision: false)"
                class="rounded-md text-sm px-3 py-1.5 transition @(!isRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
            New document
        </button>
        <button type="button" @onclick="() => SetMode(isRevision: true)" disabled="@(ExistingDrawings.Count == 0 || IsBulk)"
                title="@(IsBulk ? "A revision is one file into one document — reduce the selection to one file first." : null)"
                class="rounded-md text-sm px-3 py-1.5 transition disabled:opacity-50 @(isRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
            Revision of existing document
        </button>
    </div>

    @* One instance across every mode — hidden, not removed, in revision mode (a revision lands
       in its drawing's folder), so the chosen folder survives single/bulk/revision switches. *@
    <div class="@(isRevision ? "hidden" : null)">
        <DrawingFolderPicker @ref="folderPicker" ProjectId="@ProjectId" InitialFolderId="@InitialFolderId" />
    </div>

    @if (isRevision)
    {
        <div>
            <FormField Label="Existing document" Required>
            <select @bind="selectedDrawingId"
                    class="field">
                <option value="">Select a document…</option>
                @foreach (var drawing in ExistingDrawings)
                {
                    <option value="@drawing.DrawingId">@DrawingNaming.Label(drawing)</option>
                }
            </select>
            </FormField>
        </div>
    }

    <div>
        <label class="block text-sm font-medium text-content mb-1">
            @(isRevision ? "Document file *" : "Document files *")
        </label>
        @* Drag highlight is a DEPTH COUNTER, not a boolean: dragging across the zone's children
           fires dragenter on the child BEFORE dragleave on the zone, so a boolean flips to false
           while the pointer is still inside — the "sometimes doesn't highlight" flicker. The
           count only reaches zero when the drag has actually left (or dropped). *@
        <div class="relative rounded-xl border-2 border-dashed px-4 py-6 text-center transition @(IsDragOver ? "border-accent bg-surface-raised" : "border-line-strong")"
             @ondragenter="() => dragDepth++"
             @ondragleave="() => dragDepth = Math.Max(0, dragDepth - 1)"
             @ondrop="() => dragDepth = 0"
             @ondragend="() => dragDepth = 0">
            @* One InputFile per drop, all kept: a picked file is only a handle into its own
               input's file list, and the next pick on that input kills every earlier handle. So
               inputs that hold selected files stay in the DOM (hidden, disabled) and only the
               newest takes the drop zone — see inputGenerations in the code-behind. *@
            @foreach (var generation in inputGenerations)
            {
                var isActive = generation == ActiveGeneration;
                <InputFile @key="generation" OnChange="OnFilesSelected" multiple="@(!isRevision)"
                           disabled="@(busy || unpacking is not null || !isActive)"
                           class="@(isActive ? "absolute inset-0 h-full w-full opacity-0 cursor-pointer" : "hidden")" />
            }
            <p class="text-sm text-content-muted pointer-events-none">
                @(unpacking is not null
                    ? $"Unpacking {unpacking}…"
                    : isRevision
                        ? "Drag the revised file here, or click to choose it."
                        : selectedFiles.Count == 0
                            ? "Drag files here, or click to choose — drawings, reports, letters, anything for the project; select as many as needed. A zip is unpacked into its files."
                            : "Drop or choose more files to add them to the selection.")
            </p>
        </div>

        @if (selectedFiles.Count == 1)
        {
            <p class="mt-2 flex items-center gap-2 rounded-lg border border-line bg-surface-raised px-3 py-2 text-sm text-content">
                <span class="eyebrow shrink-0">Original file</span>
                <span class="flex-1 min-w-0 font-medium break-all">@selectedFiles[0].Name</span>
                <span class="text-content-subtle shrink-0">@FormatSize(selectedFiles[0].Size)</span>
                <button type="button" @onclick="() => RemoveFile(selectedFiles[0])" disabled="@busy" aria-label="Remove @selectedFiles[0].Name"
                        class="shrink-0 text-content-subtle hover:text-red-700 transition disabled:opacity-50">
                    ✕
                </button>
            </p>
        }
        else if (IsBulk)
        {
            <div class="mt-2 rounded-lg border border-line bg-surface-raised">
                <div class="flex items-center justify-between px-3 py-2 border-b border-line">
                    <span class="eyebrow">@selectedFiles.Count files · @FormatSize(selectedFiles.Sum(file => file.Size))</span>
                    <button type="button" @onclick="ClearSelection" disabled="@busy"
                            class="text-xs text-content-muted hover:text-content transition disabled:opacity-50">
                        Clear all
                    </button>
                </div>
                <ul class="max-h-56 overflow-y-auto divide-y divide-line">
                    @foreach (var file in selectedFiles)
                    {
                        <li class="flex items-center gap-2 px-3 py-1.5 text-sm">
                            <span class="flex-1 min-w-0 truncate text-content" title="@file.Name">@file.Name</span>
                            <span class="text-content-subtle shrink-0">@FormatSize(file.Size)</span>
                            <button type="button" @onclick="() => RemoveFile(file)" disabled="@busy" aria-label="Remove @file.Name"
                                    class="shrink-0 text-content-subtle hover:text-red-700 transition disabled:opacity-50">
                                ✕
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

    @if (!isRevision && !IsBulk)
    {
        <div>
            <FormField Label="Document code">
            <input type="text" @bind="drawingCode" placeholder="A-100 (optional)"
                   class="field" />
            </FormField>
        </div>

        <div>
            <FormField Label="Title" Hint="Leave blank and the register shows the original file name instead.">
            <input type="text" @bind="title" placeholder="Garden, shed, … (optional)"
                   class="field" />
            </FormField>
        </div>
    }

    @if (!IsBulk)
    {
        <div>
            <FormField Label="Revision">
            <input type="text" @bind="revisionLabel" placeholder="A (optional)"
                   class="field" />
            </FormField>
        </div>

        <div>
            <FormField Label="Issued by">
            <input type="email" @bind="issuedBy" placeholder="architect@example.com (optional)"
                   class="field" />
            </FormField>
        </div>
    }

    @if (error is not null)
    {
        <p class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">@error</p>
    }

    @if (failures.Count > 0)
    {
        <div class="text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2 space-y-1">
            <p class="font-medium">@failures.Count file@(failures.Count == 1 ? "" : "s") failed to upload — still listed above, press Upload to retry:</p>
            <ul class="list-disc ml-5 space-y-0.5">
                @foreach (var failure in failures)
                {
                    <li><span class="font-medium break-all">@failure.Name</span> — @failure.Message</li>
                }
            </ul>
        </div>
    }

    @if (IsBulk)
    {
        <p class="text-xs text-content-subtle">
            Each file becomes its own drawing, shown on the register by its file name and saved as
            <span class="font-medium">Unapproved</span>. Codes, titles, revisions and issuers can be
            added later from each drawing's page.
        </p>
    }
    else
    {
        <p class="text-xs text-content-subtle">New uploads are saved as <span class="font-medium">Unapproved</span>. They become the latest version of the document only once approved.</p>
    }

    <button type="submit" disabled="@(busy || unpacking is not null)"
            class="w-full rounded-lg bg-accent text-accent-ink font-medium px-4 py-2.5 hover:bg-accent-hover transition disabled:opacity-60">
        @SubmitLabel
    </button>
</EditForm>

