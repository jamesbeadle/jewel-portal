@*
    The record activity badge: how much correspondence has landed on a record recently, from the
    decayed ActivityScore (contracts). Two shapes, one meaning: the pill (count + heat colour) for
    table rows, DotOnly for the RecordTabBar's tabs. Hover text is mandatory — the colour says
    "something is going on", the title says exactly what.

    Renders NOTHING for a null summary or the None band. That is the whole loading story: per the
    loading conventions a single inline mark is never gated, and an absent badge cannot mislead the
    way a 0 can — absence while the activity store loads and absence after it mean the same thing.

    Colour: Recent is a muted pill with a warning dot, Active a warning pill, Busy a warning pill
    in bold — deliberately never red: in this app red means overdue, and an active record is a
    signal, not a problem.
*@

@if (Activity is { } summary && summary.Band is not ActivityBand.None)
{
    @if (DotOnly)
    {
        <span class="inline-block w-1.5 h-1.5 rounded-full shrink-0 @DotClass(summary.Band) @Class"
              title="@Hover(summary)"></span>
    }
    else
    {
        <Pill Tone="@ToneOf(summary.Band)" Dot="true" Class="@($"align-middle {(summary.Band == ActivityBand.Busy ? "font-semibold" : "")} {Class}")"
              Title="@Hover(summary)">@CountLabel(summary)</Pill>
    }
}

@code {
    /// <summary>The record's activity, from RecordActivityReadModel.For(...). Null renders nothing.</summary>
    [Parameter] public RecordActivitySummary? Activity { get; set; }

    /// <summary>Render as a bare heat dot (the RecordTabBar's tabs) instead of the count pill.</summary>
    [Parameter] public bool DotOnly { get; set; }

    /// <summary>Extra classes appended to the outer element (e.g. "ml-1.5" in a title cell).</summary>
    [Parameter] public string Class { get; set; } = "";

    private static Tone ToneOf(ActivityBand band) => band switch
    {
        ActivityBand.Busy   => Tone.Warning,
        ActivityBand.Active => Tone.Warning,
        _                   => Tone.Muted
    };

    private static string DotClass(ActivityBand band) => ToneOf(band) == Tone.Muted ? Tone.Warning.Dot() : ToneOf(band).Dot();

    // The pill's number is the last-7-days count. It can legitimately be 0 while the band is still
    // Recent (several emails just over a week old holding the score up) — show the fading dot with
    // no number rather than a "0" that reads as nothing having happened.
    private static string CountLabel(RecordActivitySummary summary) =>
        summary.CountLast7Days > 0 ? summary.CountLast7Days.ToString() : "";

    private static string Hover(RecordActivitySummary summary)
    {
        var lastOne = $"last one {AgoLabel(summary.LastAt)}";
        return summary.CountLast7Days switch
        {
            0 => $"Emails were linked to this record recently — {lastOne}",
            1 => $"1 email linked in the last 7 days — {AgoLabel(summary.LastAt)}",
            var n => $"{n} emails linked in the last 7 days — {lastOne}"
        };
    }

    private static string AgoLabel(DateTimeOffset at)
    {
        var age = DateTimeOffset.UtcNow - at;
        if (age < TimeSpan.Zero) age = TimeSpan.Zero;
        if (age.TotalMinutes < 60) return $"{Math.Max(1, (int)age.TotalMinutes)} min ago";
        if (age.TotalHours < 24) return $"{Math.Max(1, (int)age.TotalHours)} h ago";
        var days = (int)age.TotalDays;
        return days <= 1 ? "yesterday" : $"{days} days ago";
    }
}
