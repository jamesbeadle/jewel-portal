@inject IDrawingStore DrawingStore

@* "Rev A" (or "No revision") with an in-place editor for the roles that curate the register —
   revisions can be uploaded without a label and given one here later. Inline markup only, so it
   sits inside the revision list's heading line. *@
@if (!isEditing)
{
    <span>@DrawingNaming.RevisionText(Revision.RevisionLabel)</span>
    @if (CanEdit)
    {
        <button type="button" title="Set revision" aria-label="Set revision" @onclick="BeginEdit"
                class="ml-1 inline-flex items-center justify-center w-6 h-6 rounded text-content-subtle hover:text-content hover:bg-surface-raised transition align-middle">
            <ActionIcon Name="pencil" Class="w-3 h-3" />
        </button>
    }
}
else
{
    <span class="inline-flex items-center gap-1.5 align-middle">
        <input type="text" @bind="label" placeholder="A" maxlength="16"
               class="field w-16" />
        <button type="button" disabled="@busy" @onclick="SaveAsync"
                class="btn-primary">
            @(busy ? "Saving…" : "Save")
        </button>
        <button type="button" disabled="@busy" @onclick="() => isEditing = false"
                class="text-xs font-normal text-content-muted hover:text-content">Cancel</button>
        @if (error is not null)
        {
            <span class="text-xs font-normal text-negative">@error</span>
        }
    </span>
}

@code {
    [Parameter, EditorRequired] public DrawingRevision Revision { get; set; } = default!;
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter] public bool CanEdit { get; set; }

    private bool isEditing;
    private bool busy;
    private string? error;
    private string label = "";

    private void BeginEdit()
    {
        label = Revision.RevisionLabel;
        error = null;
        isEditing = true;
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            await DrawingStore.SetRevisionLabelAsync(
                ProjectId, Revision.DrawingId, Revision.DrawingRevisionId, label.Trim().ToUpperInvariant(), CancellationToken.None);
            isEditing = false;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
