@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@inject ITodoStore Todos

@*
    The to-do item detail modal — opened by clicking an item's title on the project To-do tab, the
    /todos browser page, or the "My to-dos" dashboard panel (the rows themselves show only the
    title). Shows everything about the item plus its LINKED EMAILS, read live by tag: an item
    created from an email at triage tags the email "JPMS/<reference>", so whatever carries that tag
    now is the item's mail. Completing (or reopening) happens here — the parent moves the item to
    its done section — and delete, where permitted, lives here too rather than on the row.

    The modal is presentation-only for actions: complete/reopen and delete are raised as events so
    each parent keeps its own reload/refresh behaviour. Only the linked-email read lives here.
*@

<Modal IsOpen="@(Item is not null)" Title="@(Item is null ? "" : $"To-do · {Item.Reference}")" OnCancel="Close">
    <ChildContent>
        @if (Item is not null)
        {
            <div class="space-y-4">
                @if (Error is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@Error</p>
                }

                <div>
                    <div class="flex items-start justify-between gap-3">
                        <h3 class="text-base font-medium @(Item.IsComplete ? "text-content-subtle line-through" : "text-content")">@Item.Title</h3>
                        <span class="shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium @(Item.IsComplete ? "bg-positive/10 text-positive" : "bg-accent/10 text-accent")">
                            @(Item.IsComplete ? "Done" : "Open")
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Item.Notes))
                    {
                        <p class="text-sm text-content-muted mt-2 whitespace-pre-wrap">@Item.Notes</p>
                    }
                </div>

                <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
                    @* The scope row: where the item lives (a project, or company-wide). With the
                       move gate it grows the same two-step editor as Assigned to below — pick the
                       destination, then Save — because re-filing an item is re-allocating work,
                       one stray click away from making it vanish from a whole team's list. *@
                    @if (!string.IsNullOrWhiteSpace(ScopeLabel) || ShowMove)
                    {
                        <div>
                            <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Scope</dt>
                            @if (moving)
                            {
                                <dd class="mt-1 space-y-2">
                                    <SearchSelect Options="@MoveOptions" Value="@moveTo" ValueChanged="v => moveTo = v"
                                                  Placeholder="Pick where this item goes" WidthClass="w-full"
                                                  InputClass="bg-surface border border-line px-2 py-1"
                                                  Disabled="@Busy" />
                                    <div class="flex gap-2">
                                        <button type="button" class="btn-primary text-xs px-2 py-1" disabled="@(Busy || moveTo == "")" @onclick="HandleMove">Save</button>
                                        <button type="button" class="btn-secondary text-xs px-2 py-1" disabled="@Busy" @onclick="CancelMove">Cancel</button>
                                    </div>
                                    <p class="text-[11px] text-content-subtle">
                                        The item keeps its reference, assignee, due date and linked emails — it simply
                                        leaves this list for the destination's To-do tab.
                                    </p>
                                </dd>
                            }
                            else
                            {
                                <dd class="text-content mt-0.5 flex flex-wrap items-center gap-2">
                                    <span>@(string.IsNullOrWhiteSpace(ScopeLabel) ? "This project" : ScopeLabel)</span>
                                    @if (ShowMove)
                                    {
                                        <button type="button" class="btn-ghost text-[11px] px-1.5 py-0.5" disabled="@Busy"
                                                title="Move this item to a different project" @onclick="StartMove">Move</button>
                                    }
                                </dd>
                            }
                        </div>
                    }
                    @* Assignment is to a ROLE, optionally pinned to a named holder of it — the
                       picker offers both as sibling rows ("Project Manager" and
                       "Project Manager — Jane Doe"), so reassigning and pinning are one pick.
                       Two steps on purpose (Reassign, then Save): a single-click picker sitting in a
                       detail panel is one stray click away from handing someone else's work away. *@
                    <div>
                        <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Assigned to</dt>
                        @if (reassigning)
                        {
                            <dd class="mt-1 space-y-2">
                                <SearchSelect Options="@AssigneeOptions" Value="@reassignTo" ValueChanged="v => reassignTo = v"
                                              Placeholder="Unassigned" WidthClass="w-full"
                                              InputClass="bg-surface border border-line px-2 py-1"
                                              Disabled="@Busy" />
                                <div class="flex gap-2">
                                    <button type="button" class="btn-primary text-xs px-2 py-1" disabled="@Busy" @onclick="HandleReassign">Save</button>
                                    <button type="button" class="btn-secondary text-xs px-2 py-1" disabled="@Busy" @onclick="CancelReassign">Cancel</button>
                                </div>
                                <p class="text-[11px] text-content-subtle">
                                    A role puts this item on the list of everyone holding it; a named person keeps
                                    it to their list alone. Either way it leaves the old assignee's list.
                                </p>
                            </dd>
                        }
                        else
                        {
                            <dd class="text-content mt-0.5 flex flex-wrap items-center gap-2">
                                <span>@(TodoAssigneePicker.Label(Item) ?? "Unassigned")</span>
                                @if (ShowReassign)
                                {
                                    <button type="button" class="btn-ghost text-[11px] px-1.5 py-0.5" disabled="@Busy"
                                            title="Assign this item to a different role or person" @onclick="StartReassign">Reassign</button>
                                }
                            </dd>
                        }
                    </div>
                    <div>
                        <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Due</dt>
                        <dd class="mt-0.5 @(IsOverdue ? "text-negative font-medium" : "text-content")">
                            @(Item.DueAt is null ? "—" : Item.DueAt.Value.LocalDateTime.ToString("d MMM yyyy"))@(IsOverdue ? " (overdue)" : "")
                        </dd>
                    </div>
                    <div>
                        <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Added</dt>
                        <dd class="text-content mt-0.5">
                            @Item.CreatedAt.LocalDateTime.ToString("d MMM yyyy")@(string.IsNullOrWhiteSpace(Item.CreatedByEmail) ? "" : $" by {Item.CreatedByEmail}")
                        </dd>
                    </div>
                    @if (Item.CompletedAt is not null)
                    {
                        <div>
                            <dt class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Completed</dt>
                            <dd class="text-content mt-0.5">@Item.CompletedAt.Value.LocalDateTime.ToString("d MMM yyyy")</dd>
                        </div>
                    }
                </dl>

                <div class="border-t border-line pt-4">
                    <h4 class="text-sm font-semibold text-content mb-1">
                        Linked emails
                        @if (!emailsLoading && emailsError is null && emails.Count > 0)
                        {
                            <span class="ml-1.5 inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@emails.Count</span>
                        }
                    </h4>
                    <p class="text-xs text-content-subtle mb-3">
                        Mail tagged <span class="font-mono">JPMS/@Item.Reference</span> in the mailbox, read live — tag or untag an email in the Control Centre and this list follows.
                    </p>

                    @if (emailsLoading)
                    {
                        <JewelSpinner Class="py-6" Label="Loading" />
                    }
                    else if (emailsError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@emailsError</p>
                    }
                    else if (emails.Count == 0)
                    {
                        <p class="text-sm text-content-subtle italic">No emails are linked to this item.</p>
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var email in emails)
                            {
                                <li class="rounded-lg border border-line bg-surface px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <span class="text-sm font-medium text-content">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                                        <span class="text-xs text-content-subtle">@email.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
                                    </div>
                                    <p class="text-sm text-content mt-0.5">
                                        @email.Subject
                                        @if (email.HasAttachments)
                                        {
                                            <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(email.BodyPreview))
                                    {
                                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@email.BodyPreview</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        @if (Item is not null)
        {
            @if (CanDelete)
            {
                @* Two-step delete, confirmed in place (no nested modal): the first click arms the
                   button — it restyles and asks — and only the second click actually deletes.
                   Anything else (Close, Mark done, opening another item) disarms it. *@
                <button type="button" disabled="@Busy" @onclick="HandleDelete"
                        class="btn-ghost text-negative mr-auto @(deleteArmed ? "bg-negative/10 font-semibold" : "")">
                    @(deleteArmed ? "Delete this item? Click again to confirm" : "Delete")
                </button>
            }
            <button type="button" class="btn-secondary" @onclick="Close">Close</button>
            @if (CanComplete)
            {
                <button type="button" class="btn-primary" disabled="@Busy"
                        @onclick="HandleToggleComplete">
                    @(Item.IsComplete ? "Reopen" : "Mark done")
                </button>
            }
        }
    </FooterContent>
</Modal>

@code {
    /// <summary>The item to show; null keeps the modal closed.</summary>
    [Parameter] public TodoItem? Item { get; set; }
    /// <summary>Optional scope line ("General" or "P-021 — Name") — the global list and dashboard
    /// pass it; the project To-do tab, where scope is implicit, omits it.</summary>
    [Parameter] public string? ScopeLabel { get; set; }
    [Parameter] public bool CanComplete { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    /// <summary>Whether the signed-in user may move this item to a different role or person — the
    /// API's TodoRoles.AllowedToManageTodos gate, mirrored by the parent.</summary>
    [Parameter] public bool CanReassign { get; set; }
    /// <summary>The assignee pool for the reassign picker — roles and their pinnable holders
    /// (ListTodoAssignableRoles + ListTodoAssignablePeople), already shaped as options by the
    /// parent via TodoAssigneePicker.BuildOptions. Empty hides the control rather than offering a
    /// picker with nothing in it.</summary>
    [Parameter] public IReadOnlyList<SearchSelect.Option> AssigneeOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    /// <summary>Raised with the chosen assignee — a role, optionally pinned to a person (null =
    /// unassigned). Like complete/delete, the write itself belongs to the parent, which owns the
    /// reload.</summary>
    [Parameter] public EventCallback<TodoAssignee?> OnReassign { get; set; }
    /// <summary>Whether the signed-in user may move this item to a different project — the API's
    /// MoveTodoItem manage gate, mirrored by the parent. Company-wide as a destination is a
    /// narrower (MD/admin) call the parent makes by including or omitting that option.</summary>
    [Parameter] public bool CanMove { get; set; }
    /// <summary>The destinations the move picker offers: the projects the item could go to
    /// (excluding wherever it is now) and, for the MD / administrators, the company-wide row
    /// (value <see cref="GeneralScope"/>). Empty hides the control rather than offering a picker
    /// with nothing in it.</summary>
    [Parameter] public IReadOnlyList<SearchSelect.Option> MoveOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    /// <summary>Raised with the chosen destination — a ProjectId, or <see cref="GeneralScope"/>
    /// for company-wide. Like complete/delete, the write itself belongs to the parent, which owns
    /// the reload.</summary>
    [Parameter] public EventCallback<string> OnMove { get; set; }
    /// <summary>The parent's in-flight-action flag — disables the action buttons while a
    /// complete/reopen/delete round-trip runs.</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>The parent's action error, surfaced inside the modal so a failed complete/delete
    /// is visible where it was clicked.</summary>
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<TodoItem> OnToggleComplete { get; set; }
    [Parameter] public EventCallback<TodoItem> OnDelete { get; set; }

    private string? loadedForItemId;
    private bool emailsLoading;
    private string? emailsError;
    private IReadOnlyList<MailboxMessage> emails = Array.Empty<MailboxMessage>();

    // The delete button's arm-and-confirm state: one click arms, the next deletes. Reset whenever
    // the shown item changes, the modal closes, or the user does something else instead.
    private bool deleteArmed;

    // Reassign editor state. `submittedReassignTo` holds the pick that has been sent but not yet
    // seen coming back: the editor closes only when the refreshed Item actually carries the new
    // assignee, so a failed save leaves the pick on screen to retry rather than silently reverting.
    private bool reassigning;
    private string reassignTo = "";
    private string? submittedReassignTo;

    // Reassigning a DONE item would move work nobody is going to do, so the control is for open
    // items only — and it needs a pool to pick from.
    private bool ShowReassign =>
        CanReassign && Item is { IsComplete: false } && AssigneeOptions.Count > 0;

    /// <summary>The move picker's value for the company-wide (general, no-project) destination —
    /// a real pick, distinct from the picker's own blank "nothing chosen yet" row. Parents map it
    /// to the blank ProjectId the MoveTodoItem command stores.</summary>
    public const string GeneralScope = "__general__";

    // Move editor state, the same shape as reassign: `submittedMoveTo` holds the destination that
    // has been sent but not yet seen coming back, so the editor closes only when the refreshed
    // Item actually lives there — a failed save leaves the pick on screen to retry.
    private bool moving;
    private string moveTo = "";
    private string? submittedMoveTo;

    // Like reassign: moving a DONE item re-files work nobody is going to do, so open items only —
    // and it needs somewhere to move to.
    private bool ShowMove =>
        CanMove && Item is { IsComplete: false } && MoveOptions.Count > 0;

    // Where the item lives now, in the move picker's own encoding.
    private static string ScopeValueFor(TodoItem item) =>
        string.IsNullOrWhiteSpace(item.ProjectId) ? GeneralScope : item.ProjectId;

    // Fetch the linked emails once per opened item (an on-demand read, not a cached render-time
    // store — so no fetch-once-per-key store bookkeeping applies here). Re-opening the same item
    // while the modal never left the page re-reads, since closing clears the key.
    protected override async Task OnParametersSetAsync()
    {
        if (Item is null)
        {
            loadedForItemId = null;
            emails = Array.Empty<MailboxMessage>();
            emailsError = null;
            emailsLoading = false;
            deleteArmed = false;
            ResetReassign();
            ResetMove();
            return;
        }

        if (Item.TodoItemId == loadedForItemId)
        {
            // The same item, re-supplied after a save: close the editor once the record itself
            // shows the assignee (or scope) that was picked. Anything else (a failed save, an
            // unrelated reload) leaves it open with the pick intact.
            if (submittedReassignTo is not null && TodoAssigneePicker.ValueFor(Item) == submittedReassignTo) ResetReassign();
            if (submittedMoveTo is not null && ScopeValueFor(Item) == submittedMoveTo) ResetMove();
            return;
        }

        var itemId = Item.TodoItemId;
        loadedForItemId = itemId;
        deleteArmed = false;
        ResetReassign();
        ResetMove();
        emailsLoading = true;
        emailsError = null;
        emails = Array.Empty<MailboxMessage>();
        try
        {
            var result = await Todos.ListEmailsAsync(itemId);
            if (loadedForItemId == itemId) emails = result;
        }
        catch
        {
            if (loadedForItemId == itemId) emailsError = "Couldn't load the linked emails. Please try again.";
        }
        finally
        {
            if (loadedForItemId == itemId) emailsLoading = false;
        }
    }

    private bool IsOverdue =>
        Item is not null && !Item.IsComplete && Item.DueAt is not null && Item.DueAt.Value < DateTimeOffset.Now.Date;

    private async Task HandleDelete()
    {
        if (Item is null) return;
        if (!deleteArmed) { deleteArmed = true; return; }
        deleteArmed = false;
        await OnDelete.InvokeAsync(Item);
    }

    private void StartReassign()
    {
        // Start from the current assignee when it is one the picker actually offers; a legacy role
        // outside the pool (or a pin whose person has left the pool) starts blank rather than
        // silently pre-selecting something else.
        var current = Item is null ? "" : TodoAssigneePicker.ValueFor(Item);
        reassignTo = AssigneeOptions.Any(option => option.Value == current) ? current : "";
        submittedReassignTo = null;
        deleteArmed = false;
        // One editor at a time: opening this one closes the other, so two half-made changes can't
        // sit side by side.
        ResetMove();
        reassigning = true;
    }

    private void CancelReassign() => ResetReassign();

    private void ResetReassign()
    {
        reassigning = false;
        reassignTo = "";
        submittedReassignTo = null;
    }

    private async Task HandleReassign()
    {
        if (Item is null) return;
        submittedReassignTo = reassignTo;
        await OnReassign.InvokeAsync(TodoAssigneePicker.Parse(reassignTo));
    }

    private void StartMove()
    {
        // The options already exclude wherever the item is now, so the picker starts blank — every
        // offered row is a real move — and Save stays disabled until a destination is picked.
        moveTo = "";
        submittedMoveTo = null;
        deleteArmed = false;
        ResetReassign();
        moving = true;
    }

    private void CancelMove() => ResetMove();

    private void ResetMove()
    {
        moving = false;
        moveTo = "";
        submittedMoveTo = null;
    }

    private async Task HandleMove()
    {
        if (Item is null || moveTo == "") return;
        submittedMoveTo = moveTo;
        await OnMove.InvokeAsync(moveTo);
    }

    private async Task HandleToggleComplete()
    {
        if (Item is null) return;
        deleteArmed = false;
        ResetReassign();
        ResetMove();
        await OnToggleComplete.InvokeAsync(Item);
    }

    private Task Close()
    {
        deleteArmed = false;
        ResetReassign();
        ResetMove();
        return OnClose.InvokeAsync();
    }
}
