<RecordsTable>
    <thead>
        <tr>
            <th>Trade</th>
            <th>Description</th>
            <th class="hidden md:table-cell">Supplier</th>
            <th class="text-right">Unit</th>
            <th class="text-right">Rate</th>
            <th class="hidden lg:table-cell">Last priced</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rate in Rates)
        {
            <tr>
                <td class="text-content font-medium">@rate.Trade</td>
                <td>@rate.Description</td>
                <td class="hidden md:table-cell">@rate.SupplierName</td>
                <td class="text-right text-content-subtle">@rate.Unit</td>
                <td class="text-right text-content font-medium">@WholeMoney(rate.Value)</td>
                <td class="hidden lg:table-cell">
                    @DateText(rate.LastPricedAt)
                </td>
            </tr>
        }
    </tbody>
</RecordsTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Rate> Rates { get; set; } = Array.Empty<Rate>();

}
