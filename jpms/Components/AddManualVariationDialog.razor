@using Jewel.JPMS.Models
@using Jewel.JPMS.Contracts.Ai
@inject IVariationStore Variations
@inject AiTaskState AiTasks
@inject ChatPanelState Chat
@implements IDisposable

@*
    Manual variation entry: ManualVariationForm (the shared fields/validation component — the
    Control Centre's System Actions pane hosts the same form to stage a draft) inside the house
    Modal, with this wrapper owning the SEND. Creates a standalone variation order (in Quoting)
    with no request/RFI behind it, for reconciling historic or client-instructed variations.

    When the assistant opened it (an AiTask with this dialog's modal key is active), this wrapper
    is also the dialog ⇄ assistant pipe: every edit republishes the form's live state, and the
    assistant's update_open_modal proposals are MERGED into the form — a field it did not send
    keeps what the user typed. The user still presses Add variation; filling writes nothing.
*@
<Modal IsOpen="IsOpen"
       Title="Add variation manually"
       ConfirmLabel="@(saving ? "Adding…" : "Add variation")"
       OnCancel="Cancel"
       OnConfirm="Submit"
       ChatAware="true"
       DismissOnOverlayClick="@(!AssistantTaskActive)"
       Class="max-w-xl">
    @if (AssistantTaskActive && Chat.AssistantBusy)
    {
        @* The assistant is mid-turn on this very form. Without this, the user watches a blank
           dialog while the model works through the wire and has no idea anything is happening. *@
        <div class="mb-3 flex items-center gap-2 rounded-lg border border-accent/40 bg-accent/10 px-3 py-2">
            <span class="w-3 h-3 shrink-0 rounded-full border-2 border-accent/30 border-t-accent animate-spin"></span>
            <p class="text-xs text-accent">The assistant is working on this form — fields fill in as it goes.</p>
        </div>
    }
    <ManualVariationForm @ref="form" UsedNumbers="@UsedNumbers" OnSubmit="SendAsync" OnEdited="PublishDraft" />
</Modal>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int SuggestedNumber { get; set; }
    [Parameter] public IReadOnlyCollection<int> UsedNumbers { get; set; } = System.Array.Empty<int>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<VariationOrder> OnCreated { get; set; }

    private ManualVariationForm? form;
    private bool saving;

    private bool AssistantTaskActive =>
        AiTasks.Active?.ModalKey == ModalCatalog.ManualVariation.ModalKey;

    protected override void OnInitialized()
    {
        // The assistant's proposals, when a task is in force. Subscribed for the component's life —
        // the handler itself checks the task matches, so a variation_draft task elsewhere never
        // writes into this form.
        AiTasks.OnDraftApplied += HandleAssistantDraft;
        // Repaints the working banner as the assistant's turn starts and finishes.
        Chat.OnChange += StateHasChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Seed the number field with the project's next number once the form has mounted (the
        // Modal renders children only while open, so each opening mounts a fresh form).
        if (IsOpen) form?.SuggestNumber(SuggestedNumber);
    }

    /// <summary>The model's update_open_modal, landing in the form. Merge, republish, repaint.</summary>
    private void HandleAssistantDraft(string fieldsJson)
    {
        if (!IsOpen || !AssistantTaskActive || form is null) return;
        form.ApplyAssistant(fieldsJson);
        AiTasks.UpdateDraft(form.SerialiseState());
        StateHasChanged();
    }

    /// <summary>Every human edit republishes the live state, so the model reasons from the form as
    /// it stands NOW — the same merge-never-replace contract as the variation_draft dialog.</summary>
    private void PublishDraft()
    {
        if (!AssistantTaskActive || form is null) return;
        AiTasks.UpdateDraft(form.SerialiseState());
    }

    public void Dispose()
    {
        AiTasks.OnDraftApplied -= HandleAssistantDraft;
        Chat.OnChange -= StateHasChanged;
    }

    private async Task Cancel() => await OnClose.InvokeAsync();

    private async Task Submit()
    {
        if (saving || form is null) return;
        await form.TrySubmitAsync(); // a valid form comes back through SendAsync
    }

    private async Task SendAsync(ManualVariationForm.Draft draft)
    {
        saving = true;
        try
        {
            var created = await Variations.CreateManualAsync(
                ProjectId, draft.Title, draft.Description, draft.EstimatedValue, draft.Number,
                draft.CommercialBasis, draft.ProgrammeImpact, draft.Exclusions);
            await OnCreated.InvokeAsync(created);
        }
        catch (System.Exception ex)
        {
            // The command sender surfaces the endpoint's own message (e.g. a duplicate-number
            // rejection) verbatim, so show it when we have one.
            form?.ShowError(string.IsNullOrWhiteSpace(ex.Message)
                ? "Couldn't add the variation. Please try again."
                : ex.Message);
        }
        finally { saving = false; }
    }
}
