@namespace Jewel.JPMS.Components
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav

@* The signed-in, approved gate every page stands behind: a quiet loader while the session is
   checked, the sign-in redirect for anonymous visitors, the request-access view for signed-in
   users not yet approved — and only then the page itself. One component instead of the same
   three-branch scaffold at the top of every page. *@
@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool sessionReady;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        sessionReady = true;
    }
}
