@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@inject ITodoStore Todos
@inject IRequestRegister Requests
@inject IVariationStore Variations
@inject IDrawingStore Drawings
@inject SessionService Session
@inject AuthService Auth
@inject TodoViewStorage ViewStorage
@inject NavigationManager Nav
@implements IDisposable

@*
    The project's to-do list, shown on the To-do tab. Items are added here directly or created
    from an email at the triage stage ("Create new → To-do item"), in which case the email is tagged
    "JPMS/TODO-####" per item. Each row is a single fixed-height line of title + key facts (never
    the multiline notes) — clicking one opens the item's own page (/todos/{id}) with the full
    detail including those notes, the linked to-dos and communications, and the actions:
    complete/reopen, reassign, move and delete all live there. The board's drag-to-complete and
    the Add modal stay here.

    Keyword search: the search box filters the to-do items AND surfaces this project's related
    records that match the keywords — requests (ref / kind / title / description), variations
    (at any stage) and drawings — each row navigating to the record. Every whitespace-separated
    keyword must match somewhere on a record (AND across keywords, case-insensitive), so
    "canopy rfi" narrows rather than widens. Requests and drawings come from their cached
    registers (refreshed on entry, stale-while-revalidate per the store convention); variations
    are fetched once in the background when the tab loads. For the triage roles the same keywords
    also search the projects mailbox (TaggedEmailSearch, under the related records): each email
    hit shows the records it is tagged to as chips that click through to those records.
*@

<div class="panel p-5">
    <div class="flex items-center justify-between gap-2 mb-1">
        <div class="flex items-center gap-3">
            <h2 class="text-sm font-semibold text-content">To-do list</h2>
            @if (items.Count > 0)
            {
                <span class="text-[11px] text-content-subtle">@items.Count(i => i.IsComplete) of @items.Count done</span>
            }
        </div>
        <div class="flex items-center gap-2">
            @if (!loading)
            {
                @* Board or list — the same per-user preference every to-do surface reads
                   (TodoViewStorage), so the idiom follows the reader between screens. *@
                <div class="flex items-center gap-1">
                    <button type="button" class="@ViewTabClass(true)" title="Status board — drag a card between columns to change its status" @onclick="() => SetView(true)">Board</button>
                    <button type="button" class="@ViewTabClass(false)" title="Flat list" @onclick="() => SetView(false)">List</button>
                </div>
            }
            @if (CanManage && !loading)
            {
                <button type="button" class="btn-primary text-xs px-2.5 py-1.5" @onclick="OpenAdd">Add item</button>
            }
        </div>
    </div>
    <p class="text-xs text-content-subtle mb-4">
        Items added here or captured from an email in the Control Centre. Click an item for its full
        detail, linked to-dos and communications@(CanManage ? ", and to mark it done" : "").
    </p>

    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@error</p>
    }

    @if (loading)
    {
        <JewelSpinner Class="py-8" Label="Loading" />
    }
    else
    {
        <div class="flex items-center gap-2 mb-4">
            <div class="relative flex-1">
                <input type="search" class="field w-full text-sm pr-8" placeholder="Search keywords — filters the list and finds related requests, variations and drawings"
                       value="@search" @oninput="OnSearchInput" />
                @if (HasQuery)
                {
                    <button type="button" title="Clear search"
                            class="absolute right-2 top-1/2 -translate-y-1/2 text-content-faint hover:text-content-muted text-sm leading-none"
                            @onclick="ClearSearch">✕</button>
                }
            </div>
            @* The role filter, board and list alike. Options are the roles that actually have
               items on this project — built from data, so it never offers a row that matches
               nothing — plus Unassigned when that would match something. *@
            <select class="field !w-auto text-xs" title="Filter by assigned role"
                    value="@roleFilter" @onchange="e => roleFilter = e.Value?.ToString() ?? string.Empty">
                <option value="">Any role</option>
                @if (HasUnassigned)
                {
                    <option value="@UnassignedFilter">Unassigned</option>
                }
                @foreach (var role in RolesOnList)
                {
                    <option value="@((int)role)">@role.DisplayName()</option>
                }
            </select>
        </div>

        @if (items.Count == 0)
        {
            <p class="text-sm text-content-subtle italic mb-4">No to-do items on this project yet.</p>
        }
        else
        {
            var visible = items.Where(item => MatchesRoleFilter(item) && (!HasQuery || MatchesTodo(item))).ToList();
            var open = visible.Where(i => !i.IsComplete).ToList();
            var done = visible.Where(i => i.IsComplete).ToList();

            @if ((HasQuery || roleFilter != "") && visible.Count == 0)
            {
                <p class="text-sm text-content-subtle italic mb-4">No to-do items match @(HasQuery ? "\"" + search + "\"" : "this role filter").</p>
            }
            else if (boardView)
            {
                @* The board answers "what's open / what's done" by layout, so the list's own
                   empty-state lines and Done heading don't apply here. Drag mirrors the manage
                   gate; read-only visitors still click cards through to the item's page. *@
                <div class="mb-4">
                    <TodoBoard Items="@visible" Busy="@busy"
                               OnOpen="OpenItem"
                               OnSetComplete="args => SetComplete(args.Item, args.IsComplete)"
                               CanDrag="_ => CanManage" />
                </div>
            }
            else if (open.Count == 0 && !HasQuery)
            {
                <p class="text-sm text-content-subtle italic mb-4">Nothing open — every item is done.</p>
            }
            else
            {
                <div class="space-y-2 mb-4">
                    @foreach (var item in open)
                    {
                        <button type="button" @key="item.TodoItemId" title="Open this item"
                                class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                                @onclick="() => OpenItem(item)">
                            <p class="truncate text-sm text-content">
                                <span class="font-mono text-xs text-content-muted mr-2">@item.Reference</span>@item.Title
                            </p>
                            <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                                @if (item.DueAt is not null)
                                {
                                    <span class="whitespace-nowrap @(IsOverdue(item) ? "text-negative font-medium" : "")">Due @item.DueAt.Value.LocalDateTime.ToString("d MMM yyyy")</span>
                                }
                                <TodoAssigneeBadge Item="item" />
                                @if (!string.IsNullOrWhiteSpace(item.CreatedByEmail))
                                {
                                    <span class="truncate">Added by @item.CreatedByEmail</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }

            @if (!boardView && done.Count > 0)
            {
                <h3 class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2">Done</h3>
                <div class="space-y-2 mb-4">
                    @foreach (var item in done)
                    {
                        <button type="button" @key="item.TodoItemId" title="Open this item"
                                class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                                @onclick="() => OpenItem(item)">
                            <p class="truncate text-sm text-content-subtle line-through">
                                <span class="font-mono text-xs text-content-muted mr-2">@item.Reference</span>@item.Title
                            </p>
                            <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                                @if (item.CompletedAt is not null)
                                {
                                    <span class="whitespace-nowrap">Done @item.CompletedAt.Value.LocalDateTime.ToString("d MMM yyyy")</span>
                                }
                                <TodoAssigneeBadge Item="item" />
                                @if (!string.IsNullOrWhiteSpace(item.CreatedByEmail))
                                {
                                    <span class="truncate">Added by @item.CreatedByEmail</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        }

        @if (HasQuery)
        {
            var matchedRequests = MatchedRequests;
            var matchedVariations = MatchedVariations;
            var matchedDrawings = MatchedDrawings;
            var anyRelated = matchedRequests.Count + matchedVariations.Count + matchedDrawings.Count > 0;

            <div class="border-t border-line pt-4 mt-2">
                <h3 class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2">Related records</h3>

                @if (!anyRelated)
                {
                    <p class="text-sm text-content-subtle italic">
                        @(relatedLoading ? "Looking for related records…" : $"No requests, variations or drawings on this project match \"{search}\".")
                    </p>
                }
                else
                {
                    @if (matchedRequests.Count > 0)
                    {
                        <p class="text-xs text-content-subtle mb-2">Requests (@matchedRequests.Count)</p>
                        <div class="space-y-2 mb-4">
                            @foreach (var record in matchedRequests.Take(MaxRelated))
                            {
                                <button type="button" @key="record.RequestId" title="Open this request"
                                        class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                                        @onclick="() => OpenRequest(record)">
                                    <p class="truncate text-sm text-content">
                                        <span class="font-mono text-xs text-content-muted mr-2">@record.Reference</span>@record.Title
                                    </p>
                                    <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                                        <span class="whitespace-nowrap" title="@record.Kind.LongName()">@record.Kind.DisplayName()</span>
                                        <span class="whitespace-nowrap">@RequestStatusLabel(record.Status)</span>
                                    </div>
                                </button>
                            }
                        </div>
                        @if (matchedRequests.Count > MaxRelated)
                        {
                            <p class="text-[11px] text-content-subtle mb-4">
                                Showing @MaxRelated of @matchedRequests.Count — refine the keywords, or search from the
                                <a class="underline underline-offset-2 hover:text-content-muted" href="@($"/projects/{ProjectId}/requests")">Requests tab</a>.
                            </p>
                        }
                    }

                    @if (matchedVariations.Count > 0)
                    {
                        <p class="text-xs text-content-subtle mb-2">Variations (@matchedVariations.Count)</p>
                        <div class="space-y-2 mb-4">
                            @foreach (var order in matchedVariations.Take(MaxRelated))
                            {
                                <button type="button" @key="order.VariationOrderId" title="Open this variation order"
                                        class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                                        @onclick="() => OpenVariation(order.VariationOrderId)">
                                    <p class="truncate text-sm text-content">
                                        <span class="font-mono text-xs text-content-muted mr-2">@(order.VariationRef ?? order.Reference)</span>@order.Title
                                    </p>
                                    <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                                        <span class="whitespace-nowrap">Variation · @order.Status</span>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (matchedDrawings.Count > 0)
                    {
                        <p class="text-xs text-content-subtle mb-2">Drawings (@matchedDrawings.Count)</p>
                        <div class="space-y-2 mb-4">
                            @foreach (var drawing in matchedDrawings.Take(MaxRelated))
                            {
                                <button type="button" @key="drawing.DrawingId" title="Open this drawing"
                                        class="w-full rounded-lg border border-line px-3 py-2 text-left hover:border-line-strong hover:bg-surface-raised"
                                        @onclick="() => OpenDrawing(drawing)">
                                    <p class="truncate text-sm text-content">
                                        <span class="font-mono text-xs text-content-muted mr-2">@DrawingNaming.Code(drawing)</span>@DrawingNaming.Name(drawing)
                                    </p>
                                    <div class="mt-1 flex items-center gap-x-3 overflow-hidden text-[11px] text-content-subtle">
                                        <span class="whitespace-nowrap">
                                            @(DrawingNaming.ApprovedRevisionText(drawing) is { } approvedText ? $"{approvedText} approved" : "No approved revision")
                                        </span>
                                    </div>
                                </button>
                            }
                        </div>
                        @if (matchedDrawings.Count > MaxRelated)
                        {
                            <p class="text-[11px] text-content-subtle mb-4">
                                Showing @MaxRelated of @matchedDrawings.Count — refine the keywords, or use the
                                <a class="underline underline-offset-2 hover:text-content-muted" href="@($"/projects/{ProjectId}/drawings")">Drawings tab</a>.
                            </p>
                        }
                    }
                }
            </div>

            @* The same keywords searched against the projects mailbox — an email's record-tag
               chips link through to the records it feeds. Mailbox-wide on purpose (the email
               being hunted is often filed against another project's record, or none); renders
               only for the triage roles — the gate lives in the component. *@
            <TaggedEmailSearch Query="@search" />
        }
    }
</div>

<Modal IsOpen="@addOpen" Title="Add a to-do item" ConfirmLabel="Add to-do item" CancelLabel="Cancel"
       OnConfirm="Add" OnCancel="CloseAdd">
    <div class="space-y-3">
        @if (addError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@addError</p>
        }

        <FormField Label="Title" Value="@newTitle" OnChange="v => newTitle = v" Required="true" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Assigned to</label>
                <SearchSelect Options="@AssigneeOptions" Value="@newAssignee" ValueChanged="v => newAssignee = v"
                              Placeholder="Unassigned" WidthClass="w-full" />
            </div>
            <FormField Label="Due" Value="@newDue" OnChange="v => newDue = v" InputType="date" />
        </div>

        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Notes</label>
            <textarea class="field" rows="2" value="@newNotes" @oninput="OnNewNotesInput"></textarea>
        </div>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    private IReadOnlyList<TodoItem> items = Array.Empty<TodoItem>();

    // The assignee picker's option pool: the ROLES a to-do can be assigned to (internal
    // office/management roles — TodoRoles.AssignableAsTodoAssignee, served by
    // ListTodoAssignableRoles) and, under each role, the directory holders it can be pinned to
    // (ListTodoAssignablePeople), fetched once when the tab loads and shaped by
    // TodoAssigneePicker.BuildOptions. Assignment is picker-only.
    private IReadOnlyList<SearchSelect.Option> AssigneeOptions = Array.Empty<SearchSelect.Option>();
    private bool loading = true;
    private bool busy;
    private string? error;
    // Board (the default) or flat list — the shared per-user preference (TodoViewStorage).
    private bool boardView = true;
    // The assigned-role filter: "" = any, UnassignedFilter, or a Role's int as a string.
    private const string UnassignedFilter = "__unassigned__";
    private string roleFilter = "";

    // Keyword search state. The query filters the to-do list and drives the "Related records"
    // sections. Requests and drawings read synchronously from their cached stores; variation orders
    // have no cached register, so they are fetched once in the background when the tab loads and held
    // here for the session's stay on the tab.
    private const int MaxRelated = 8;
    private string search = "";
    private IReadOnlyList<VariationOrder> variations = Array.Empty<VariationOrder>();
    private bool relatedLoading = true;

    // "Add a to-do item" modal state. The form lives in the modal; opening it starts from a clean
    // slate, and a successful add closes it.
    private bool addOpen;
    private string? addError;
    private string newTitle = "";
    private string newNotes = "";
    private string newAssignee = "";
    private string newDue = "";

    // Managing the list mirrors the server-side TodoRoles.AllowedToManageTodos gate: directors
    // (managing and finance), project managers, site managers and accounts (administrators carry
    // every role). Everyone else sees the list read-only.
    private bool CanManage =>
        Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.FinanceDirector
            or Role.ProjectManager or Role.SiteManager or Role.Accounts);

    protected override async Task OnInitializedAsync()
    {
        boardView = await ViewStorage.ReadBoardAsync(Auth.CurrentUser?.Email ?? "");

        // Related-record sources for the keyword search. Refresh on entry per the store
        // convention: cached requests/drawings serve matches immediately, then update when the
        // background reload lands. Variation orders load once alongside (no cached register to lean on).
        Requests.OnChange += HandleRegisterChange;
        Drawings.OnChange += HandleRegisterChange;
        Requests.Refresh(ProjectId);
        Drawings.Refresh(ProjectId);
        _ = LoadVariationsAsync();

        // The list and the assignable-role pool (the add modal's picker) are independent reads —
        // run them together.
        if (CanManage) await Task.WhenAll(LoadAsync(), LoadAssignableRolesAsync());
        else await LoadAsync();
    }

    public void Dispose()
    {
        Requests.OnChange -= HandleRegisterChange;
        Drawings.OnChange -= HandleRegisterChange;
    }

    private void HandleRegisterChange() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadVariationsAsync()
    {
        // A failed load simply leaves variations out of the search results rather than blocking
        // the tab — requests and drawings still match.
        try
        {
            variations = await Variations.ListForProjectAsync(ProjectId);
        }
        catch { }
        finally
        {
            relatedLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAssignableRolesAsync()
    {
        // A failed load leaves the picker with no options rather than blocking the tab — the add
        // modal still works, the item just goes in unassigned.
        try
        {
            var rolesTask = Todos.ListAssignableRolesAsync();
            var peopleTask = Todos.ListAssignablePeopleAsync();
            AssigneeOptions = TodoAssigneePicker.BuildOptions(await rolesTask, await peopleTask);
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        loading = true;
        try { items = await Todos.ListForProjectAsync(ProjectId); }
        catch { error = "Couldn't load the to-do list. Please try again."; }
        finally { loading = false; }
    }

    private void OnNewNotesInput(ChangeEventArgs e) => newNotes = e.Value?.ToString() ?? "";

    private void OpenAdd()
    {
        newTitle = newNotes = newAssignee = "";
        // Due defaults to one week out; clear the field to raise an item with no due date.
        newDue = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
        addError = null;
        addOpen = true;
    }

    private void CloseAdd()
    {
        addOpen = false;
        addError = null;
    }

    private async Task Add()
    {
        if (busy) return;
        if (string.IsNullOrWhiteSpace(newTitle)) { addError = "A title is required."; return; }
        addError = null;
        var assignee = TodoAssigneePicker.Parse(newAssignee);
        await Run(async () =>
        {
            await Todos.AddAsync(new AddTodoItem(
                ProjectId,
                newTitle.Trim(),
                NullIfBlank(newNotes),
                assignee?.Role,
                assignee?.PersonEmail,
                ParseDate(newDue)));
            CloseAdd();
        });
        // A failed add leaves the modal open with the panel-level error mirrored inside it.
        if (error is not null && addOpen) addError = error;
    }

    // Opening an item is a navigation: everything beyond the row — full detail, linked to-dos,
    // communications, the manage actions — lives on the item's own page.
    private void OpenItem(TodoItem item) => Nav.NavigateTo($"/todos/{item.TodoItemId}");

    // The board's drag onto the other column — the tab's one in-place status change. The reloaded
    // list re-groups the item into Open/Done with the server's ordering.
    private async Task SetComplete(TodoItem item, bool complete)
    {
        if (busy || item.IsComplete == complete) return;
        await Run(() => Todos.UpdateAsync(new UpdateTodoItem(
            item.TodoItemId,
            item.Title,
            NullIfBlank(item.Notes),
            item.AssigneeRole,
            item.AssigneePersonEmail,
            item.DueAt,
            complete)));
    }

    private async Task Run(Func<Task> action)
    {
        error = null;
        try
        {
            busy = true;
            await action();
            // Take the server's fresh open-first/done-pile order: a dragged card re-grouping on
            // reload is the expected "moves to the done column" behaviour.
            items = await Todos.ListForProjectAsync(ProjectId);
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "That action didn't complete. Please try again."; }
        finally { busy = false; }
    }

    // ---- Keyword search ------------------------------------------------------------------------

    private bool HasQuery => !string.IsNullOrWhiteSpace(search);

    private void OnSearchInput(ChangeEventArgs e) => search = e.Value?.ToString() ?? "";

    private void ClearSearch() => search = "";

    // Every whitespace-separated keyword must appear in at least one of the record's fields
    // (case-insensitive) — AND across keywords so extra words narrow the results.
    private bool MatchesKeywords(params string?[] fields)
    {
        var tokens = search.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return tokens.All(token =>
            fields.Any(field => field is not null && field.Contains(token, StringComparison.OrdinalIgnoreCase)));
    }

    private bool MatchesTodo(TodoItem item) =>
        MatchesKeywords(item.Reference, item.Title, item.Notes, item.AssigneePersonName);

    private IReadOnlyList<Request> MatchedRequests =>
        Requests.ForProject(ProjectId)
            .Where(r => MatchesKeywords(r.Reference, r.DisplayNumber, r.Kind.DisplayName(), r.Kind.LongName(), r.Title, r.Description))
            .ToList();

    private IReadOnlyList<VariationOrder> MatchedVariations =>
        variations.Where(v => MatchesKeywords(v.Reference, v.DisplayNumber, v.VariationRef ?? "", v.Title, v.Description)).ToList();

    private IReadOnlyList<Drawing> MatchedDrawings =>
        Drawings.DrawingsFor(ProjectId).Where(d => MatchesKeywords(d.DrawingCode, d.Title)).ToList();

    private void OpenRequest(Request record) =>
        Nav.NavigateTo($"/projects/{ProjectId}/requests/view/{record.RequestId}");

    private void OpenVariation(string variationId) =>
        Nav.NavigateTo($"/projects/{ProjectId}/variations/{variationId}");

    private void OpenDrawing(Drawing drawing) =>
        Nav.NavigateTo($"/projects/{ProjectId}/drawings/{drawing.DrawingId}");

    private static string RequestStatusLabel(RequestStatus status) => status.DisplayName();

    // --------------------------------------------------------------------------------------------

    // The role filter's option pool: the roles that actually have items on this project.
    private IReadOnlyList<Role> RolesOnList =>
        items.Where(item => item.AssigneeRole is not null)
            .Select(item => item.AssigneeRole!.Value)
            .Distinct()
            .OrderBy(role => role.DisplayName(), StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool HasUnassigned => items.Any(item => item.AssigneeRole is null);

    private bool MatchesRoleFilter(TodoItem item) =>
        roleFilter == "" ? true
        : roleFilter == UnassignedFilter ? item.AssigneeRole is null
        : int.TryParse(roleFilter, out var value) && item.AssigneeRole == (Role)value;

    private string ViewTabClass(bool board) =>
        boardView == board
            ? "btn-primary text-xs px-2.5 py-1.5"
            : "btn-secondary text-xs px-2.5 py-1.5";

    private async Task SetView(bool board)
    {
        if (boardView == board) return;
        boardView = board;
        await ViewStorage.WriteAsync(Auth.CurrentUser?.Email ?? "", board);
    }

    private static bool IsOverdue(TodoItem item) =>
        !item.IsComplete && item.DueAt is not null && item.DueAt.Value < DateTimeOffset.Now.Date;

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static DateTimeOffset? ParseDate(string value) =>
        DateTimeOffset.TryParse(value, out var parsed) ? parsed : null;
}
