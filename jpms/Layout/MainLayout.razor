@inherits LayoutComponentBase
@inject AuthService Auth
@inject SessionService Session
@inject StoreChangeHub Stores
@inject AppVersionService Versions
@implements IDisposable

<div class="min-h-dvh bg-canvas text-content antialiased">

    @* Above everything, including the sticky header — an error the user cannot see is an error
       that gets reported as "it just doesn't work". *@
    <ErrorToast />

    @* The informative one: a newer JBB Portal has been deployed than the build this tab is running.
       Sits under ErrorToast in the stack, because something being broken outranks something
       being newer. *@
    <UpdateToast />

    @* The two-hour "Viewing as" clock for opted-in users (Admin → Users → "Defaults back to own
       role"): asks whether to keep the temporary role, reverts quietly if ignored. Under both
       toasts in the stack — broken or newer both outrank a role about to change back. *@
    <RoleOverridePrompt />


    @if (CanSeeNavigation)
    {
        <NavigationDrawer IsOpen="isPhoneNavOpen" IsExpanded="isSideNavExpanded"
                          OnClose="ClosePhoneNav" OnToggleExpand="ToggleSideNav" />
    }

    <div class="@ShellClass">
        <header class="sticky top-0 z-30 h-14 bg-canvas/80 backdrop-blur border-b border-line">
            <div class="h-full px-4 flex items-center justify-between gap-3">
                @if (CanSeeNavigation)
                {
                    <div class="min-w-0 flex items-center gap-3">
                        @* Below md the sidebar is a drawer, and this is the button that opens it. *@
                        <ToolbarButton Icon="menu" Label="Open navigation" OnClick="OpenPhoneNav" Class="w-10 h-10 md:hidden" />
                        <PageHeading />
                    </div>
                }
                else
                {
                    <span></span>
                }
                <div class="shrink-0 flex items-center gap-2">
                    @if (Auth.IsSignedIn)
                    {
                        <RoleSwitcher />
                    }
                    else
                    {
                        <span class="eyebrow">Jewel Project Management System</span>
                    }
                </div>
            </div>
        </header>

        <main class="flex-1">
            @Body
        </main>

        <footer class="border-t border-line pb-[env(safe-area-inset-bottom)]">
            <div class="px-4 py-3 text-xs text-content-subtle flex items-center justify-between">
                <span>Jewel Bespoke Build</span>
                @* The version the API announces ("v473"), adopted from the first response this
                   tab sees; "dev" until one lands. The footer is the first place to look when asking
                   "which build is this user on?", and it says the same number as the update toast. *@
                <span>JBB Portal @Versions.RunningDisplay</span>
            </div>
        </footer>
    </div>

</div>

@code {
    private bool isSideNavExpanded = true;
    private bool isPhoneNavOpen;

    private bool CanSeeNavigation => Auth.IsSignedIn && Session.IsApproved;

    // Below md the page runs edge to edge and the nav is a drawer over it; from md up the shell
    // leaves room for the sidebar at whichever width it is.
    private string ShellClass
    {
        get
        {
            var column = "min-h-dvh flex flex-col";
            if (!CanSeeNavigation) return column;
            var padding = isSideNavExpanded ? "md:pl-64" : "md:pl-16";
            return $"{column} {padding}";
        }
    }

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        Session.OnChange += StateHasChanged;
        // Repaint the current page whenever any data store finishes a background
        // load, so views that read lazily-loaded data fill in on their own instead
        // of staying empty until the user navigates away and back.
        Stores.OnAnyChange += Repaint;
        Versions.OnChange += Repaint;
    }

    private void ToggleSideNav() => isSideNavExpanded = !isSideNavExpanded;

    // The drawer is always the labelled nav: opening it on a phone also expands the sidebar, so a
    // desktop that collapsed it to the rail and then shrank never shows a drawer of bare icons.
    private void OpenPhoneNav()
    {
        isSideNavExpanded = true;
        isPhoneNavOpen = true;
    }

    private void ClosePhoneNav() => isPhoneNavOpen = false;

    private void Repaint() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        Session.OnChange -= StateHasChanged;
        Stores.OnAnyChange -= Repaint;
        Versions.OnChange -= Repaint;
    }
}
