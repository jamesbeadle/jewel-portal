@inherits LayoutComponentBase
@inject AuthService Auth
@inject SessionService Session
@inject StoreChangeHub Stores
@inject ChatPanelState Chat
@implements IDisposable

<div class="min-h-dvh bg-canvas text-content antialiased">

    @* Above everything, including the sticky header — an error the user cannot see is an error
       that gets reported as "it just doesn't work". *@
    <ErrorToast />

    @* The informative one: a newer JPMS has been deployed than the build this tab is running.
       Sits under ErrorToast in the stack, because something being broken outranks something
       being newer. *@
    <UpdateToast />


    @if (CanSeeNavigation)
    {
        <aside class="@SideNavClass">
            <SideNav IsExpanded="isSideNavExpanded" OnToggleExpand="ToggleSideNav" />
        </aside>
    }

    <div class="@ShellClass">
        <header class="sticky top-0 z-30 h-14 bg-canvas/80 backdrop-blur border-b border-line">
            <div class="h-full px-4 flex items-center justify-between gap-3">
                @if (CanSeeNavigation)
                {
                    <PageHeading />
                }
                else
                {
                    <span></span>
                }
                <div class="shrink-0 flex items-center gap-2">
                    @if (Auth.IsSignedIn)
                    {
                        <RoleSwitcher />
                        <ChatLauncher />
                    }
                    else
                    {
                        <span class="eyebrow">Jewel Project Management System</span>
                    }
                </div>
            </div>
        </header>

        <main class="flex-1">
            @Body
        </main>

        <footer class="border-t border-line">
            <div class="px-4 py-3 text-xs text-content-subtle flex items-center justify-between">
                <span>Jewel Bespoke Build</span>
                @* The deploy's run number ("v473"), stamped by the workflow; "dev" locally. The
                   footer is the first place to look when asking "which build is this user on?" *@
                <span>JPMS @BuildVersion.Display</span>
            </div>
        </footer>
    </div>

    @* The takeover: while the assistant is operating the portal (navigating, opening a dialog,
       writing into a form) the whole app dims behind a breathing green-edged vignette and stops
       taking input, so the user and the assistant can never fight over the same controls
       mid-action. The chat panel lifts above it (ChatPanel.PanelClass → z-[60]) and stays fully
       usable — watching the assistant work, or telling it to stop, is exactly what this moment is
       for. Raised by ChatPanel on the turn's first UI action; dropped when the turn ends, on every
       path, by ChatPanelState.SetAssistantBusy(false). Styles: .jpms-takeover* in app.tailwind.css. *@
    @if (Chat.AssistantControlling)
    {
        @* The right padding mirrors ChatPanel/ShellClass widths so the label centres in the app
           column beside the open panel, not half-underneath it. *@
        <div class="jpms-takeover @(Chat.IsOpen ? "md:pr-[400px] lg:pr-[440px]" : "")" aria-hidden="true">
            <div class="jpms-takeover-edge"></div>
            <div class="jpms-takeover-label">
                <span class="jpms-takeover-eyebrow">Jewel Assistant</span>
                <span class="jpms-takeover-title">AI in control of the site</span>
                <span class="flex items-center gap-1.5 pt-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent jpms-typing-dot"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-accent jpms-typing-dot jpms-typing-dot-2"></span>
                    <span class="w-1.5 h-1.5 rounded-full bg-accent jpms-typing-dot jpms-typing-dot-3"></span>
                </span>
            </div>
        </div>
    }

    @* The assistant lives outside the shell so it can pin to the viewport's right edge while the
       shell's padding (see ShellClass) reserves its width — the page narrows instead of being
       covered. Both components self-gate on role, so they cost nothing for everyone else. *@
    <ChatPanel />
    <ChatLauncher Floating="true" />
</div>

@code {
    private bool isSideNavExpanded = true;

    private bool CanSeeNavigation => Auth.IsSignedIn && Session.IsApproved;

    private string SideNavClass
    {
        get
        {
            var width = isSideNavExpanded ? "md:w-64" : "md:w-16";
            return $"fixed top-0 bottom-0 left-0 z-40 w-16 {width} border-r border-line";
        }
    }

    private string ShellClass
    {
        get
        {
            // Width mirrors ChatPanel's own md:/lg: widths — change the two together.
            var column = "chat-push min-h-dvh flex flex-col";
            var chat = Chat.IsOpen ? "md:pr-[400px] lg:pr-[440px]" : "";
            if (!CanSeeNavigation) return $"{column} {chat}";
            var padding = isSideNavExpanded ? "pl-16 md:pl-64" : "pl-16 md:pl-16";
            return $"{column} {padding} {chat}";
        }
    }

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        Session.OnChange += StateHasChanged;
        // Reserving the panel's width is the layout's job, so the shell repaints when it opens.
        Chat.OnChange += StateHasChanged;
        // Repaint the current page whenever any data store finishes a background
        // load, so views that read lazily-loaded data fill in on their own instead
        // of staying empty until the user navigates away and back.
        Stores.OnAnyChange += Repaint;
    }

    private void ToggleSideNav() => isSideNavExpanded = !isSideNavExpanded;

    private void Repaint() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        Session.OnChange -= StateHasChanged;
        Chat.OnChange -= StateHasChanged;
        Stores.OnAnyChange -= Repaint;
    }
}
