@using Jewel.JPMS.Features.Projects
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject ProjectListReadModel Projects
@inject CurrentProjectService CurrentProject
@inject ProjectStageFilter StageFilter
@implements IDisposable

@*
    The app's single navigation plane: Home, the project picker, then ONE list of collapsible
    folders (docs/Pathway-Split-Platform-Flow-Plan.md §6) — Client, Subcontractor, Internal,
    Project, Financials. Folders mix scopes deliberately: project-scoped rows target
    the picked project, company rows sit beside them where the work mixes. The picker doubles as
    the project switcher (the portfolio lives in its footer); picking a project while on a
    project page jumps to the same page of the new project. A role whose whole world is one
    folder sees that folder's rows flat, with no header (decision 2026-07-22) — folder chrome is
    for people who work across folders. Below every folder sit the folderless rows
    (SidebarFolders.Standalone, e.g. the Control Centre): top-level links, because they are not about the
    project the picker has chosen.
*@

<div class="h-full flex flex-col bg-surface">

    <div class="@HeaderLayout border-b border-line">
        <a href="@HomeHref" @onclick="HandleNavigate" @onclick:preventDefault="false"
           class="flex items-center gap-3 px-3 font-semibold text-content overflow-hidden">
            <JewelIcon Class="w-5 h-5 text-content shrink-0" />
            <span class="@LabelClass">JPMS</span>
        </a>
        <button type="button" @onclick="OnToggleExpand"
                class="hidden md:inline-flex items-center justify-center w-8 h-8 rounded text-content-subtle hover:text-content hover:bg-surface-raised"
                aria-label="Toggle navigation">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="@(IsExpanded ? "M15 6l-6 6 6 6" : "M9 6l6 6-6 6")" />
            </svg>
        </button>
    </div>

    <nav class="flex-1 px-2 py-3 overflow-y-auto flex flex-col">
        <ul class="space-y-0.5">
            <li>
                <a href="@DesktopNavigation.Home.Href" @onclick="HandleNavigate" @onclick:preventDefault="false"
                   class="@LinkClass(DesktopNavigation.Home.IsActiveFor(CurrentPath))" title="@DesktopNavigation.Home.Label">
                    <NavIcon Route="@DesktopNavigation.Home.Href" Class="w-5 h-5 shrink-0" />
                    <span class="@LabelClass">@DesktopNavigation.Home.Label</span>
                </a>
            </li>

            @if (ShowsProjectPicker && IsExpanded)
            {
                @* ---- Project picker: every {project}-templated row below targets this project. ---- *@
                <li class="hidden md:block pt-2 pb-1">
                    <div class="relative">
                        <button type="button" @onclick="() => pickerOpen = !pickerOpen"
                                class="w-full flex items-center gap-2 rounded border border-line bg-surface-raised px-3 py-2 text-left hover:border-line-strong transition"
                                aria-haspopup="listbox" aria-expanded="@pickerOpen" title="Switch project">
                            @if (PickedProject is { } picked)
                            {
                                <span class="min-w-0 flex-1">
                                    <span class="block font-mono text-xs text-content-subtle truncate">@picked.Reference</span>
                                    <span class="block text-sm font-semibold text-content truncate">@picked.Name</span>
                                </span>
                            }
                            else
                            {
                                <span class="min-w-0 flex-1 text-sm text-content-subtle">Pick a project…</span>
                            }
                            <svg class="w-4 h-4 text-content-subtle shrink-0 transition-transform @(pickerOpen ?"rotate-180" : "")"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                        </button>

                        @if (pickerOpen)
                        {
                            <button type="button" class="fixed inset-0 z-30 cursor-default" aria-hidden="true"
                                    @onclick="() => pickerOpen = false" tabindex="-1"></button>
                            <div class="absolute left-0 right-0 top-full z-40 mt-1 max-h-80 overflow-y-auto panel py-1"
                                 role="listbox">
                                @if (RecentlyOpened.Count > 0)
                                {
                                    @* The projects this user is actually working across, most
                                       recently opened first — a shortcut into the list below,
                                       which keeps its canonical order (see RecentlyOpened). *@
                                    <p class="eyebrow px-3 pt-1.5 pb-1">Recent</p>
                                    @foreach (var candidate in RecentlyOpened)
                                    {
                                        @ProjectOption(candidate)
                                    }
                                    <div class="border-t border-line mt-1"></div>
                                    <p class="eyebrow px-3 pt-2 pb-1">All projects</p>
                                }
                                @foreach (var candidate in ActiveProjects)
                                {
                                    @ProjectOption(candidate)
                                }
                                @if (CompletedProjects.Count > 0)
                                {
                                    @* The status filter (decision 2026-08-03): completed projects
                                       stay out of the switcher until asked for, but their records
                                       (valuation report, financials) must stay reachable after
                                       handover. The toggle persists per user (ProjectStageFilter)
                                       and the header's prev/next arrows follow it. *@
                                    <div class="border-t border-line mt-1"></div>
                                    <label class="flex items-center gap-2 px-3 py-2 text-xs text-content-subtle hover:text-content cursor-pointer transition">
                                        <input type="checkbox" checked="@StageFilter.IncludeCompleted"
                                               @onchange="e => StageFilter.SetAsync((bool)e.Value!)" />
                                        Show completed (@CompletedProjects.Count)
                                    </label>
                                    @if (StageFilter.IncludeCompleted)
                                    {
                                        <p class="eyebrow px-3 pt-1 pb-1">Completed</p>
                                        @foreach (var candidate in CompletedProjects)
                                        {
                                            @ProjectOption(candidate)
                                        }
                                    }
                                }
                                <div class="border-t border-line mt-1 pt-1">
                                    <a href="/projects" class="block px-3 py-2 text-xs text-content-subtle hover:text-content hover:bg-surface-raised transition"
                                       @onclick="ClosePickerAndNavigate" @onclick:preventDefault="false">
                                        Project portfolio · New project →
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </li>
            }

            @if (RendersFlat)
            {
                @* A single visible folder reads as a flat list of top-level items — no header
                   (decision 2026-07-22): e.g. a future client login sees "Requests" as a
                   top-level item, never a folder labelled "Client". *@
                @foreach (var item in Folders[0].Items)
                {
                    <li>
                        @if (IsUnresolvable(item))
                        {
                            <span class="@DisabledLinkClass" title="Pick a project first">
                                <NavIcon Route="@item.Href" Class="w-5 h-5 shrink-0" />
                                <span class="@LabelClass">@item.Label</span>
                            </span>
                        }
                        else
                        {
                            <a href="@item.ResolveHref(EffectiveProjectId)" @onclick="HandleNavigate" @onclick:preventDefault="false"
                               class="@LinkClass(item.IsActiveFor(CurrentPath))" title="@item.Label">
                                <NavIcon Route="@item.Href" Class="w-5 h-5 shrink-0" />
                                <span class="@LabelClass">@item.Label</span>
                            </a>
                        }
                    </li>
                }
            }
            else
            {
                @foreach (var folder in Folders)
                {
                    @if (IsExpanded)
                    {
                        @* Mobile stays an icon rail even while the desktop panel is expanded —
                           one icon per folder, straight to its first page. *@
                        <li class="md:hidden">
                            <a href="@folder.Items[0].ResolveHref(EffectiveProjectId)" @onclick="HandleNavigate" @onclick:preventDefault="false"
                               class="@LinkClass(IsFolderActive(folder))" title="@folder.Label">
                                <NavIcon Route="@folder.IconKey" Class="w-5 h-5 shrink-0" />
                            </a>
                        </li>
                        <li class="hidden md:block pt-2">
                            <button type="button" @onclick="() => ToggleFolder(folder)"
                                    class="w-full flex items-center gap-1.5 px-3 py-1 rounded text-left hover:bg-surface-raised transition"
                                    aria-expanded="@IsFolderOpen(folder)" title="@folder.Label">
                                <svg class="w-3 h-3 text-content-subtle shrink-0 transition-transform @(IsFolderOpen(folder) ?"rotate-90" : "")"
                                     viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                                <span class="eyebrow">@folder.Label</span>
                            </button>
                        </li>
                        @if (IsFolderOpen(folder))
                        {
                            @foreach (var item in folder.Items)
                            {
                                <li class="hidden md:block">
                                    @if (IsUnresolvable(item))
                                    {
                                        @* Project-scoped rows need a picked project; until one
                                           resolves they sit muted rather than dead-linking.
                                           Company rows in the same folder keep working. *@
                                        <span class="@DisabledRowClass" title="Pick a project first">@item.Label</span>
                                    }
                                    else
                                    {
                                        <a href="@item.ResolveHref(EffectiveProjectId)" @onclick="HandleNavigate" @onclick:preventDefault="false"
                                           class="@FolderItemClass(item.IsActiveFor(CurrentPath))" title="@item.Label">@item.Label</a>
                                    }
                                </li>
                            }
                        }
                    }
                    else
                    {
                        @* Collapsed rail: one icon per folder, straight to its first page. *@
                        <li>
                            <a href="@folder.Items[0].ResolveHref(EffectiveProjectId)" @onclick="HandleNavigate" @onclick:preventDefault="false"
                               class="@LinkClass(IsFolderActive(folder))" title="@folder.Label">
                                <NavIcon Route="@folder.IconKey" Class="w-5 h-5 shrink-0" />
                            </a>
                        </li>
                    }
                }
            }
        </ul>

        @if (StandaloneItems.Count > 0)
        {
            @* ---- Folderless rows, pinned below every folder (mt-auto). Top-level links with an
               icon, like Home: they are not about the picked project, so they must not read as a
               row of one of the folders the picker feeds. ---- *@
            <ul class="mt-auto pt-3 space-y-0.5 border-t border-line">
                @foreach (var item in StandaloneItems)
                {
                    <li>
                        <a href="@item.ResolveHref(EffectiveProjectId)" @onclick="HandleNavigate" @onclick:preventDefault="false"
                           class="@LinkClass(item.IsActiveFor(CurrentPath))" title="@item.Label">
                            <NavIcon Route="@item.Href" Class="w-5 h-5 shrink-0" />
                            <span class="@LabelClass">@item.Label</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </nav>

    @if (Auth.IsSignedIn)
    {
        <div class="border-t border-line px-3 py-3">
            <div class="@(IsExpanded ?"hidden md:block" : "hidden") mb-3">
                <p class="eyebrow mb-1">Signed in as</p>
                <p class="text-content text-sm font-medium truncate" title="@Auth.CurrentUser!.Email">@Auth.CurrentUser.DisplayName</p>
                <p class="text-xs text-content-subtle truncate" title="@Auth.CurrentUser.Email">@Auth.CurrentUser.Email</p>
            </div>
            <button type="button" @onclick="SignOut" class="btn-secondary w-full" title="Sign out">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round"><path d="M15 12H3m0 0l4-4m-4 4l4 4M11 4h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6" /></svg>
                <span class="@LabelClass">Sign out</span>
            </button>
        </div>
    }
</div>


@code {
    // One rendering for a project row in the picker dropdown, shared by the Recent group and the
    // full list so the two can never drift apart.
    private RenderFragment<Project> ProjectOption => candidate =>
        @<button type="button" role="option" aria-selected="@IsCurrent(candidate)"
                 class="w-full text-left px-3 py-2 text-sm transition @(IsCurrent(candidate) ?"bg-surface-raised text-content font-semibold" : "text-content-muted hover:text-content hover:bg-surface-raised")"
                 @onclick="() => PickProject(candidate)">
            <span class="font-mono text-xs text-content-subtle mr-2">@candidate.Reference</span>@candidate.Name
        </button>;
}
