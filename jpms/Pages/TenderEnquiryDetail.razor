@page "/tender-enquiries/{TenderEnquiryId}"
@using Jewel.JPMS.Contracts.TenderEnquiries
@using Jewel.JPMS.Features.TenderEnquiries
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@implements IDisposable

<PageTitle>Tender Enquiry · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <section class="px-6 py-6 md:px-8">
        <nav class="mb-4 text-sm">
            <a href="/tender-enquiries" class="text-content-subtle hover:text-content underline underline-offset-4">Tender enquiries</a>
        </nav>

        @if (error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4 whitespace-pre-wrap">@error</p>
        }

        <LoadGate IsLoading="@(enquiry is null && !loadAttempted)" Prominent="true" Label="Loading tender enquiry">
        @if (enquiry is null)
        {
            <p class="text-sm text-content-subtle italic">That tender enquiry could not be loaded.</p>
        }
        else
        {
            <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <p class="text-xs font-mono tracking-wide text-content-subtle mb-0.5">@enquiry.Reference</p>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-semibold text-content leading-tight">@enquiry.Title</h1>
                        <TenderEnquiryStatusBadge Status="@enquiry.Status" />
                    </div>
                    <p class="text-sm text-content-muted">
                        @enquiry.ArchitectPracticeName@(string.IsNullOrWhiteSpace(enquiry.ArchitectContactName) ? "" : $" · {enquiry.ArchitectContactName}")
                        @if (Project is { } project)
                        {
                            <span> · </span><a class="font-mono text-xs hover:underline" href="@($"/projects/{project.ProjectId}")">@project.Reference</a>
                            <ProjectStageBadge Stage="@project.Stage" />
                        }
                    </p>
                </div>
                @if (CanManage)
                {
                    <button type="button" class="btn-secondary" @onclick="OpenEdit">Edit details</button>
                }
            </header>

            <div class="flex flex-wrap items-center gap-2 mb-5 text-sm">
                @foreach (var tab in SectionTabs)
                {
                    var key = tab.Key;
                    <button type="button" class="@TabClass(key)" @onclick="() => activeTab = key">@tab.Label</button>
                }
            </div>

            @if (activeTab == "overview")
            {
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                    <div class="lg:col-span-2 space-y-5">
                        <div class="panel p-5 space-y-3">
                            <h3 class="eyebrow">The enquiry</h3>
                            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 text-sm">
                                <dt class="text-content-subtle">Architect</dt><dd class="text-content">@enquiry.ArchitectPracticeName</dd>
                                <dt class="text-content-subtle">Contact</dt><dd class="text-content">@ContactLine</dd>
                                <dt class="text-content-subtle">Contract form</dt><dd class="text-content">@(string.IsNullOrWhiteSpace(enquiry.ContractForm) ? "—" : enquiry.ContractForm)</dd>
                                <dt class="text-content-subtle">Bid owner</dt><dd class="text-content">@enquiry.OwnerEmail</dd>
                            </dl>
                            <div>
                                <h4 class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Scope of works</h4>
                                <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@(string.IsNullOrWhiteSpace(enquiry.ScopeSummary) ? "—" : enquiry.ScopeSummary)</p>
                            </div>
                        </div>
                        <RecordAuditHistory RecordId="@TenderEnquiryId" RecordType="RecordType.TenderEnquiry" />
                    </div>
                    <TenderEnquiryStatusPanel Enquiry="@enquiry" CanMove="@CanManage" OnChanged="OnStatusChanged" />
                </div>
            }
            else if (activeTab == "pqq")
            {
                <div class="space-y-5">
                    <TenderEnquiryAnswersEditor TenderEnquiryId="@TenderEnquiryId" Enquiry="@enquiry" CanEdit="@CanManage" />
                    @if (CanManage)
                    {
                        <TenderEnquiryResponseSender Enquiry="@enquiry" OnChanged="OnStatusChanged" />
                    }
                </div>
            }
            else if (activeTab == "documents")
            {
                <TenderEnquiryAttachmentsPanel TenderEnquiryId="@TenderEnquiryId" CanEdit="@CanManage" />
            }
            else if (activeTab == "emails")
            {
                <TenderEnquiryEmailsPanel Enquiry="@enquiry" />
            }
        }
        </LoadGate>
    </section>

    <Modal IsOpen="showEdit" Title="Edit enquiry details" ShowFooter="true"
           ConfirmLabel="@(busy ? "Saving…" : "Save")" ConfirmDisabled="@(busy || draft.Problem is not null)"
           CancelLabel="Cancel" OnCancel="() => showEdit = false" OnConfirm="SaveEditAsync" Class="max-w-2xl w-full">
        <TenderEnquiryDetailsForm Draft="@draft" OnChanged="StateHasChanged" />
    </Modal>
}

@code {
    [Parameter] public string TenderEnquiryId { get; set; } = "";

    private static readonly (string Key, string Label)[] SectionTabs =
    {
        ("overview", "Overview"), ("pqq", "PQQ response"), ("documents", "Documents"), ("emails", "Emails")
    };

    private bool sessionReady;
    private bool loadAttempted;
    private bool busy;
    private bool showEdit;
    private string? error;
    private string activeTab = "overview";
    private TenderEnquiry? enquiry;
    private TenderEnquiryDetailsDraft draft = new();

    private bool CanManage => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.ProjectManager or Role.QuantitySurveyor
            or Role.OfficeComplianceCoordinator or Role.OfficeAdmin);

    private Project? Project => enquiry is null ? null : Projects.Find(enquiry.ProjectId);

    private string ContactLine => enquiry is null ? "" : string.Join(" · ",
        new[] { enquiry.ArchitectContactName, enquiry.ArchitectContactEmail }.Where(part => !string.IsNullOrWhiteSpace(part)));

    private string TabClass(string key) => key == activeTab
        ? "px-3 py-1.5 rounded-md bg-accent text-accent-ink font-medium"
        : "px-3 py-1.5 rounded-md text-content-muted hover:text-content hover:bg-surface-raised";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        Projects.OnChanged += StateHasChanged;
        if (Projects.Current is null) _ = Projects.RefreshAsync(CancellationToken.None);
        try { enquiry = await Queries.AskAsync(new GetTenderEnquiryById(TenderEnquiryId), CancellationToken.None); }
        catch { error = "Couldn't load the tender enquiry."; }
        finally { loadAttempted = true; }
    }

    public void Dispose() => Projects.OnChanged -= StateHasChanged;

    // Winning moves the project on from Lead — the header's stage badge should say so.
    private Task OnStatusChanged(TenderEnquiry updated)
    {
        enquiry = updated;
        return updated.Status == TenderEnquiryStatus.Won ? Projects.RefreshAsync(CancellationToken.None) : Task.CompletedTask;
    }

    private void OpenEdit()
    {
        if (enquiry is null) return;
        draft = TenderEnquiryDetailsDraft.From(enquiry);
        error = null;
        showEdit = true;
    }

    private async Task SaveEditAsync()
    {
        if (busy || draft.Problem is not null) return;
        busy = true;
        try
        {
            enquiry = await Commands.SendAsync(new UpdateTenderEnquiryDetails(TenderEnquiryId, draft.ToDetails()), CancellationToken.None);
            showEdit = false;
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
