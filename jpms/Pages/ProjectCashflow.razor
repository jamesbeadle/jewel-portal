@page "/projects/{ProjectId}/cashflow"
@using Jewel.JPMS.Commercial
@using Jewel.JPMS.Contracts.ValuationInvoices
@using Jewel.JPMS.Contracts.Variations
@using Jewel.JPMS.Features.Commercial
@using Jewel.JPMS.Features.Procurement
@inject AuthService Auth
@inject SessionService Session
@inject ProjectFinancialSummaryReadModel Summary
@inject ProjectWorkOrdersReadModel WorkOrders
@inject IValuationReportStore ValuationReport
@inject IProjectRetentionStore Retention
@inject IQueryClient Queries
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Project Cashflow · JPMS</PageTitle>

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="cashflow">
        <h2 class="text-lg font-semibold text-content mb-1">Project Cashflow</h2>
        <p class="text-sm text-content-subtle mb-4 max-w-2xl">
            The project claim against the cash already allocated, then the cash still to move —
            out to costs, back from retention — through practical completion to the end of the
            project. These figures spread across the months they are expected to land in, company
            wide, are the
            <a href="/finance/cash-forecast" class="underline underline-offset-2 hover:text-content">Cash Forecast</a>.
        </p>

        @* ── Statement on the left, its explanatory notes alongside — the two share the width
           rather than one narrow column floating in it. Stacks on smaller screens. ── *@
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] gap-6 items-start">
        <div>
        @* ── One statement, one gate: every figure below reads every source, so it reveals in one piece. ── *@
        <LoadGate IsLoading="@(!StatementReady && !dataFailed)" Prominent="true" Label="Loading cashflow">
            @if (dataFailed)
            {
                <p class="text-sm text-negative mb-6">Couldn't load the cashflow figures. The details are in the red bar at the top — reload to try again.</p>
            }
            else
            {
            <div class="panel mb-4">

                @* ── The claim, and the cash already allocated against it ── *@
                <div class="flex items-baseline justify-between gap-4 px-4 py-3">
                    <div>
                        <p class="text-sm font-semibold text-content"
                           title="The valuation report's counting lines — contract works, provisional sums, contingency and variations">Project claim</p>
                        <p class="text-xs text-content-subtle mt-0.5">The full value of the works as currently valued</p>
                    </div>
                    <p class="text-lg font-semibold text-content whitespace-nowrap">@Money(ContractSales)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm font-semibold text-content"
                           title="Valuation invoices the client has paid, plus retention withheld on works complete (held less confirmed releases, from the retention terms on the Setup tab)">Cash allocated</p>
                        <p class="text-xs text-content-subtle mt-0.5">
                            @Money(CashReceived) received from the client · @Money(RetentionOutstanding) held in retention
                        </p>
                    </div>
                    <p class="text-lg font-semibold text-content whitespace-nowrap">@Money(-CashAllocated)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t-2 border-line">
                    <div>
                        <p class="text-sm font-semibold text-content"
                           title="Project claim less cash allocated, less the retention that will be withheld on the works still to value — what can actually be invoiced to the client before the releases">Left to claim</p>
                        @if (RetentionStillToWithhold != 0m)
                        {
                            <p class="text-xs text-content-subtle mt-0.5"
                               title="Valuation invoices are raised net of retention, so this slice of the remainder is never invoiceable on a valuation — it comes back through the release rows below instead">
                                less @Money(RetentionStillToWithhold) retention to be withheld (@Pct(RetentionPercent) of works left to value)
                            </p>
                        }
                        @if (InvoicedAwaitingPayment != 0m)
                        {
                            <p class="text-xs text-content-subtle mt-0.5">of which @Money(InvoicedAwaitingPayment) already invoiced &amp; awaiting payment</p>
                        }
                    </div>
                    <p class="text-lg font-semibold text-content whitespace-nowrap">@Money(LeftToClaim)</p>
                </div>

                @* ── The cash still to go out before practical completion ── *@
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm text-content"
                           title="The Financials tab's drawdown to the penny — each cost centre's unspent target cost, with finalised lines realised to profit / loss and reconciliation packages accounted for. Overspent centres are NOT netted off; their excess sits below the completion total as the available buy back.">Cost centre drawdowns</p>
                        <p class="text-xs text-content-subtle mt-0.5">Budget still expected to be spent, on top of orders and bills — overspends counted separately below</p>
                    </div>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@Money(-Drawdown)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm text-content"
                           title="Work-order value not yet invoiced by suppliers — committed spend still to bill; see the WO Allocation tab">Uninvoiced work orders</p>
                        <p class="text-xs text-content-subtle mt-0.5">@Money(WoCommitted) committed · @Money(WoInvoiced) invoiced to date</p>
                    </div>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@Money(-WoLeftToInvoice)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm text-content"
                           title="The net still owed on allocated purchase lines, part-payment aware: a bill Xero has partly settled counts only its remainder, from the bill's AmountDue as last synced">Unpaid Xero purchase invoices</p>
                        @if (BillsSettledOnPartPaid != 0m)
                        {
                            <p class="text-xs text-content-subtle mt-0.5">@Money(BillsSettledOnPartPaid) on part-paid bills already settled</p>
                        }
                        @if (UnallocatedOutstandingNet != 0m)
                        {
                            <p class="text-xs text-negative mt-0.5"
                               title="Unpaid bills whose Xero Sites tracking points at this project but which nobody has allocated in JPMS — not counted in this figure. The magnifier lists them; allocate them on the Xero allocation screen.">
                                ⚠ @Money(UnallocatedOutstandingNet) tracked to this site in Xero is not yet allocated
                            </p>
                        }
                    </div>
                    <span class="inline-flex items-center gap-1.5">
                        <span class="text-base font-semibold @(BillsUnpaid == 0m ?"text-content" : "text-negative") whitespace-nowrap">@Money(-BillsUnpaid)</span>
                        <button type="button" aria-label="View the unpaid invoices behind this figure"
                                title="The transactions behind this figure — every allocated purchase line not yet paid in Xero, with Excel export for reconciling"
                                class="inline-flex items-center justify-center w-7 h-7 rounded text-content-subtle hover:text-content hover:bg-surface-raised"
                                @onclick="() => showUnpaidInvoices = true">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
                        </button>
                    </span>
                </div>

                @* ── Retention release 1 — comes back before the project completes ── *@
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm text-content"
                           title="The first retention release, forecast against the revised contract sum and due at practical completion. Once confirmed it moves into the claim, so it is no longer added back here.">Retention release 1</p>
                        <p class="text-xs text-content-subtle mt-0.5">@Release1Note</p>
                    </div>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@AddBack(Release1AddBack)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t-2 border-line">
                    <p class="text-sm font-semibold text-content"
                       title="Left to claim, less cost centre drawdowns, uninvoiced work orders and unpaid purchase invoices, plus the first retention release — the net cash movement between now and practical completion">Practical completion cashflow</p>
                    <p class="text-xl font-semibold @(PracticalCompletionCashflow < 0m ?"text-negative" : "text-positive") whitespace-nowrap">@Money(PracticalCompletionCashflow)</p>
                </div>

                @* ── Retention release 2 — the balance after the defects period ── *@
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <div>
                        <p class="text-sm text-content"
                           title="The final retention release, forecast against the revised contract sum and due after the defects period. Once confirmed it moves into the claim, so it is no longer added back here.">Retention release 2</p>
                        <p class="text-xs text-content-subtle mt-0.5">@Release2Note</p>
                    </div>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@AddBack(Release2AddBack)</p>
                </div>

                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t-2 border-line">
                    <p class="text-sm font-semibold text-content"
                       title="Practical completion cashflow plus the final retention release — the project's net cash movement to the end of the defects period">Project completion cashflow</p>
                    <p class="text-xl font-semibold @(ProjectCompletionCashflow < 0m ?"text-negative" : "text-positive") whitespace-nowrap">@Money(ProjectCompletionCashflow)</p>
                </div>
            </div>

            @* ── The buy back, in its own card (finance director, 2026-08-17): the statement
               ends at the completion total, and these two rows are the upside sitting outside
               it — spent in full above, recovered only if actually bought back. Solid border,
               unlike the dashed potential card: overspends are real figures, not maybes. ── *@
            @if (AvailableToBuyBack != 0m)
            {
            <div class="panel mb-4">
                <div class="flex items-baseline justify-between gap-4 px-4 py-3">
                    <div>
                        <p class="text-sm text-content"
                           title="The Financials tab's overspend to the penny — committed cost already past target across the overspent centres. Recovered only where an overspend is actually bought back; the statement above never assumes it.">Cost centre overspends — available to buy back</p>
                        <p class="text-xs text-content-subtle mt-0.5">Committed cost past target — not assumed recouped in the statement above</p>
                    </div>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@AddBack(AvailableToBuyBack)</p>
                </div>
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t-2 border-line">
                    <p class="text-sm font-semibold text-content"
                       title="Project completion cashflow plus every overspend bought back — the position if the full buy back is achieved.">Position with overspends bought back</p>
                    <p class="text-xl font-semibold @(PositionWithOverspendsBoughtBack < 0m ?"text-negative" : "text-positive") whitespace-nowrap">@Money(PositionWithOverspendsBoughtBack)</p>
                </div>
            </div>
            }

            @* ── Potential — unapproved variations. A separate, dashed card BELOW the statement:
               nothing in it is confirmed, so it must never read as part of the position above.
               The generous top margin is deliberate — the gap itself says "not part of the statement". ── *@
            @if (PendingVariations.Count > 0)
            {
            <div class="border border-dashed border-line bg-surface mt-10 mb-4">
                <div class="px-4 py-3">
                    <p class="text-sm font-semibold text-content"
                       title="Variation orders not yet decided — quoting, issued, or awaiting an Architect's Instruction — at their estimated values. Approved variations are already inside the project claim; rejected ones are gone.">Potential — unapproved variations</p>
                    <p class="text-xs text-content-subtle mt-0.5">Not confirmed — no commercial effect until approved. Kept apart from the statement above on purpose.</p>
                </div>
                @foreach (var vo in PendingVariations)
                {
                    <div class="flex items-baseline justify-between gap-4 px-4 py-2.5 border-t border-line">
                        <div>
                            <p class="text-sm text-content">
                                @(string.IsNullOrEmpty(vo.DisplayNumber) ? vo.Reference : vo.DisplayNumber) · @vo.Title
                            </p>
                            <p class="text-xs text-content-subtle mt-0.5" title="@vo.Status.Hint()">@vo.Status.DisplayName()</p>
                        </div>
                        <p class="text-sm font-medium text-content whitespace-nowrap">
                            @(vo.EstimatedValue is { } estimate ? Money(estimate) : "no estimate yet")
                        </p>
                    </div>
                }
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t-2 border-line">
                    <p class="text-sm font-semibold text-content"
                       title="The sum of the estimated values above — claim value that may yet be added to the project">Potential additional claim</p>
                    <p class="text-base font-semibold text-content whitespace-nowrap">@AddBack(PotentialVariationValue)</p>
                </div>
                <div class="flex items-baseline justify-between gap-4 px-4 py-3 border-t border-line">
                    <p class="text-sm font-semibold text-content"
                       title="Project completion cashflow plus every unapproved variation at its estimate — if all of them are approved and claimed. The costs to deliver them are not yet in the drawdowns, so treat this as the upper bound of the upside.">Potential project completion cashflow</p>
                    <p class="text-lg font-semibold @(PotentialProjectCompletionCashflow < 0m ?"text-negative" : "text-positive") whitespace-nowrap">@Money(PotentialProjectCompletionCashflow)</p>
                </div>
            </div>
            }
            }
        </LoadGate>
        </div>

        @* ── The notes are static copy, so they render immediately — no gate (never gate a line
           of text); the jewel next door is the only loading mark on this screen. ── *@
        <aside class="panel px-4 py-4 space-y-3">
            <h3 class="eyebrow">Where these figures come from</h3>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Project claim</span> is the valuation
                report's counting lines — contract works, provisional sums, contingency and
                variations.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Cash allocated</span> counts valuation
                invoices the client has paid plus retention withheld on works complete (held less
                confirmed releases, from the retention terms on the Setup tab). Valuation invoices
                are raised net of retention, so retention held is money earned but not invoiceable
                until released.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Left to claim</span> is the project claim
                less cash allocated, and also less the retention that will be withheld on the works
                still to value — that slice of the remainder is never invoiceable on a valuation,
                and comes back through the two release rows instead. Deducting it here is what
                stops the statement counting it twice.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Cost centre drawdowns</span> reuse the
                Financials tab's drawdown figure to the penny, so the two always agree: each cost
                centre's unspent target cost, with finalised lines realised to profit / loss and
                reconciliation packages accounted for. Overspent centres are not netted off —
                netting read as recouping every overspend — so the statement spends the full
                drawdown and shows the overspends on their own rows below.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Cost centre overspends</span> are the
                other side of the same split: committed cost already past target. They sit in
                their own card under the statement as the buy back still available — the
                position improves by an overspend only where it is actually bought back, so the
                completion cashflow never assumes it.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Uninvoiced work orders</span> are
                committed order value suppliers haven't billed yet, from the invoice links managed
                on the WO Allocation tab. <span class="font-semibold text-content">Unpaid Xero
                purchase invoices</span> is the net still owed on allocated purchase lines,
                part-payment aware: each bill's outstanding amount is read from Xero on every
                sync, so a part-paid bill counts only its remainder and the figure tracks the
                aged payables. Bills tracked to this site in Xero but not yet allocated in JPMS
                are warned about on the row rather than silently missed.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">The retention releases</span> are forecast
                against the revised contract sum with due dates anchored to practical completion. A
                confirmed release is no longer added back because it has moved into the claim —
                and, once paid, into cash allocated.
            </p>
            <p class="text-xs text-content-subtle">
                <span class="font-semibold text-content">Potential — unapproved variations</span>
                sits in its own dashed card below the statement because nothing in it is
                confirmed: variations still quoting, issued, or awaiting an Architect's
                Instruction, at their estimated values. Approved variations are already inside
                the project claim; rejected ones are gone. The costs to deliver them are not yet
                in the drawdowns, so the potential figure is the upper bound of the upside.
            </p>
        </aside>
        </div>

        <UnpaidXeroInvoicesModal IsOpen="showUnpaidInvoices"
                                 Lines="UnpaidCostLines"
                                 UnallocatedBills="@(unallocatedBills ?? Array.Empty<UnallocatedSiteBill>())"
                                 OnClose="() => showUnpaidInvoices = false" />
    </ProjectPageShell>
</Page>

