@page "/directory"
@using Jewel.JPMS.Contracts.Subcontractors
@using Jewel.JPMS.Contracts.Xero
@inject AuthService Auth
@inject SessionService Session
@inject ISubcontractorStore SubcontractorStore
@inject IClientStore ClientStore
@inject IArchitectStore ArchitectStore
@inject Jewel.JPMS.Features.Directory.DirectoryReadModel Staff
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Directory · JPMS</PageTitle>

@*
    THE unified directory (pathway-split plan §5/§9): one page, filter chips — Clients, Architects,
    Subcontractors (the company directory), Internal staff — replacing the three separate nav
    entries. A presentation-layer merge only: the company directory keeps its DirectoryCategory
    rows and detail pages; first-class Client accounts and Architect practices render read-only
    here with links to their own pages, where creating/editing and the contacts / correspondence
    profile editors stay; Internal staff folds in the RBAC user list. Gate widened (2026-07-22) to
    Admin / MD / FD / PM — though each group's API keeps its own gate, so a group a role can't
    read shows a quiet restriction note instead of rows.
*@

@if (!isLoaded)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!CanAccess)
{
    <section class="px-6 md:px-8 py-12">
        <h1 class="text-2xl font-semibold text-content mb-2">Not available</h1>
        <p class="text-content-muted">The directory is restricted to administrators, directors and project managers.</p>
    </section>
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · Directory</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Directory</h1>
                <p class="text-sm text-content-muted mt-2">@GroupSummary</p>
            </div>
            @if (group == DirectoryGroup.Subcontractors)
            {
                <div class="flex items-center gap-4 shrink-0">
                    <ExportToExcelButton FileName="Directory"
                                         Disabled="@(SubcontractorStore.All().Count == 0)"
                                         ShowIncludeAllRows="@(!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(categoryFilter))"
                                         IncludeAllLabel="Ignore search & filter"
                                         BuildWorkbook="BuildExportWorkbook" />
                    @if (CanManage)
                    {
                        <button type="button" class="btn-primary" @onclick="OpenAddModal">+ Add company</button>
                    }
                </div>
            }
        </header>

        @* The group chips: who you're looking for. Subcontractors is the company directory
           (the page's original body, unchanged); the other groups fold in alongside. *@
        <div class="flex flex-wrap items-center gap-2 mb-5">
            @foreach (var option in GroupChips)
            {
                var value = option.Group;
                <button type="button" class="@GroupChipClass(value)" @onclick="() => SelectGroup(value)">@option.Label</button>
            }
        </div>

        @if (group == DirectoryGroup.Clients)
        {
            @if (clientsError is not null)
            {
                <p class="text-sm text-content-subtle italic">@clientsError</p>
            }
            else if (clients.Count == 0)
            {
                <LoadGate IsLoading="@(!clientsLoaded)" Label="Loading">
                    <p class="text-sm text-content-subtle italic">No client accounts yet.</p>
                </LoadGate>
            }
            else
            {
                <div class="panel overflow-x-auto overflow-y-auto max-h-[85vh]">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-content-subtle border-b border-line">
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Client</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Primary contact</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Contact email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var client in clients)
                            {
                                <tr class="border-b border-line last:border-0">
                                    <td class="px-4 py-3 font-medium text-content">@client.Name</td>
                                    <td class="px-4 py-3 text-content-muted">@Dash(client.PrimaryContactName)</td>
                                    <td class="px-4 py-3 text-content-muted">@Dash(client.PrimaryContactEmail)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="text-xs text-content-subtle mt-3">
                Create, edit and manage contacts on the
                <a class="underline hover:text-content" href="/clients">Client accounts</a> page.
            </p>
        }
        else if (group == DirectoryGroup.Architects)
        {
            @if (architectsError is not null)
            {
                <p class="text-sm text-content-subtle italic">@architectsError</p>
            }
            else if (architects.Count == 0)
            {
                <LoadGate IsLoading="@(!architectsLoaded)" Label="Loading">
                    <p class="text-sm text-content-subtle italic">No architect practices yet.</p>
                </LoadGate>
            }
            else
            {
                <div class="panel overflow-x-auto overflow-y-auto max-h-[85vh]">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-content-subtle border-b border-line">
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Practice</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Contact</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Contact email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var architect in architects)
                            {
                                <tr class="border-b border-line last:border-0">
                                    <td class="px-4 py-3 font-medium text-content">@architect.Name</td>
                                    <td class="px-4 py-3 text-content-muted">@Dash(architect.ContactName)</td>
                                    <td class="px-4 py-3 text-content-muted">@Dash(architect.ContactEmail)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <p class="text-xs text-content-subtle mt-3">
                Create, edit and manage contacts on the
                <a class="underline hover:text-content" href="/architects">Architects</a> page.
            </p>
        }
        else if (group == DirectoryGroup.Staff)
        {
            @if (staffError is not null)
            {
                <p class="text-sm text-content-subtle italic">@staffError</p>
            }
            else if (StaffUsers.Count == 0)
            {
                <LoadGate IsLoading="@(!staffLoaded)" Label="Loading">
                    <p class="text-sm text-content-subtle italic">No internal staff recorded.</p>
                </LoadGate>
            }
            else
            {
                <div class="panel overflow-x-auto overflow-y-auto max-h-[85vh]">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-content-subtle border-b border-line">
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Name</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Email</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Roles</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in StaffUsers)
                            {
                                <tr class="border-b border-line last:border-0">
                                    <td class="px-4 py-3 font-medium text-content">@user.DisplayName</td>
                                    <td class="px-4 py-3 text-content-muted">@user.Email</td>
                                    <td class="px-4 py-3">
                                        <span class="flex flex-wrap gap-1">
                                            @foreach (var role in user.Roles)
                                            {
                                                <RoleBadge Role="role" />
                                            }
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
        @* Filters: category + free-text search across all types *@
        <div class="flex flex-wrap items-end gap-3 mb-5">
            <div class="grow min-w-[14rem]">
                <label class="eyebrow block mb-1">Search</label>
                <input class="field" placeholder="Company, trade, contact, town…" value="@search" @oninput="OnSearchInput" />
            </div>
            <div>
                <label class="eyebrow block mb-1">Type</label>
                <select class="field" value="@categoryFilter" @onchange="OnCategoryChanged">
                    <option value="">All types</option>
                    @foreach (var c in AllCategories)
                    {
                        <option value="@c">@Label(c)</option>
                    }
                </select>
            </div>
            @if (CanManage)
            {
                <div class="flex items-center gap-2">
                    <button type="button" class="btn-secondary inline-flex items-center gap-1.5"
                            title="Copy supplier records from Xero into the directory"
                            @onclick="OpenImportModal">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                        Import from Xero
                    </button>
                    @if (SelectedForConsolidation().Count >= 2)
                    {
                        <button type="button" class="btn-primary"
                                title="Merge the ticked records into one master record"
                                @onclick="OpenConsolidateModal">
                            Consolidate (@SelectedForConsolidation().Count)
                        </button>
                    }
                </div>
            }
        </div>

        @if (Filtered().Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No companies match.</p>
        }
        else
        {
            <div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
                <table class="w-full text-sm">
                    <thead class="bg-surface-raised border-b border-line">
                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                            @if (CanManage)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised pl-4 pr-1 py-3 w-8" title="Tick records to consolidate"></th>
                            }
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Company</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Type</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden sm:table-cell">Trade</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden md:table-cell">Primary contact</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden lg:table-cell">Location</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var sub in Filtered())
                        {
                            <tr class="hover:bg-surface-raised cursor-pointer transition" @onclick="() => Open(sub.SubcontractorId)">
                                @if (CanManage)
                                {
                                    <td class="pl-4 pr-1 py-3" @onclick:stopPropagation="true">
                                        <input type="checkbox" class="cursor-pointer"
                                               checked="@selectedIds.Contains(sub.SubcontractorId)"
                                               @onchange="e => ToggleSelected(sub.SubcontractorId, e)" />
                                    </td>
                                }
                                <td class="px-4 py-3 text-content font-medium">
                                    <span class="inline-flex items-center gap-1.5">
                                        @sub.CompanyName
                                        @if (sub.XeroLinked)
                                        {
                                            <svg class="w-3.5 h-3.5 text-content-subtle shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                 stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Linked to Xero"><title>Linked to Xero</title><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
                                        }
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">@Label(sub.Category)</span>
                                </td>
                                <td class="px-4 py-3 hidden sm:table-cell">
                                    <span class="flex flex-wrap gap-1">
                                        @foreach (var trade in sub.Trades)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">@trade.Name</span>
                                        }
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-content-muted hidden md:table-cell">
                                    @sub.ContactName
                                    @if (!string.IsNullOrWhiteSpace(sub.ContactEmail))
                                    {
                                        <span class="block text-xs text-content-subtle">@sub.ContactEmail</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-content-subtle hidden lg:table-cell">@Location(sub)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        }
    </section>

    <Modal IsOpen="showAddModal" Title="Add company" ShowFooter="true"
           ConfirmLabel="@(saving ? "Saving…" : "Add company")" CancelLabel="Cancel"
           OnCancel="CloseAddModal" OnConfirm="SaveCompany" Class="max-w-lg w-full">
        @if (addError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@addError</p>
        }
        <div class="space-y-3">
            <div>
                <label class="eyebrow block mb-1">Company name</label>
                <input class="field" @bind="nCompany" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="eyebrow block mb-1">Type</label>
                    <select class="field" @bind="nCategory">
                        @foreach (var c in AllCategories)
                        {
                            <option value="@c">@Label(c)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="eyebrow block mb-1">Trades</label>
                    @if (nTradeIds.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1 mb-1">
                            @foreach (var trade in SelectedTrades(nTradeIds))
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">
                                    @trade.Name
                                    <button type="button" class="text-content-subtle hover:text-content" @onclick="() => nTradeIds.Remove(trade.TradeId)">×</button>
                                </span>
                            }
                        </div>
                    }
                    <select class="field" value="" @onchange="e => AddTradeToSelection(e, nTradeIds)">
                        <option value="">Add a trade…</option>
                        @foreach (var trade in SubcontractorStore.Trades().Where(t => !nTradeIds.Contains(t.TradeId)))
                        {
                            <option value="@trade.TradeId">@trade.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div>
                <label class="eyebrow block mb-1">Not in the list?</label>
                <div class="flex gap-2">
                    <input class="field flex-1" @bind="nNewTrade" @bind:event="oninput" placeholder="New trade, e.g. Hod carrier" />
                    <button type="button" class="btn-secondary shrink-0" disabled="@(addingTrade || string.IsNullOrWhiteSpace(nNewTrade))" @onclick="CreateTrade">
                        @(addingTrade ? "Adding…" : "Add trade")
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="eyebrow block mb-1">Contact name</label>
                    <input class="field" @bind="nContact" />
                </div>
                <div>
                    <label class="eyebrow block mb-1">Email</label>
                    <input class="field" @bind="nEmail" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="eyebrow block mb-1">Phone</label>
                    <input class="field" @bind="nPhone" />
                </div>
                <div>
                    <label class="eyebrow block mb-1">Mobile</label>
                    <input class="field" @bind="nMobile" />
                </div>
            </div>
            <div>
                <label class="eyebrow block mb-1">Address line</label>
                <input class="field" placeholder="Street address, printed on purchase orders" @bind="nAddressLine" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="eyebrow block mb-1">Town</label>
                    <input class="field" @bind="nTown" />
                </div>
                <div>
                    <label class="eyebrow block mb-1">County</label>
                    <input class="field" @bind="nCounty" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="eyebrow block mb-1">Postcode</label>
                    <input class="field" @bind="nPostcode" />
                </div>
                <div>
                    <label class="eyebrow block mb-1">Website</label>
                    <input class="field" @bind="nWebsite" />
                </div>
            </div>
        </div>
    </Modal>

    @* ---- Import from Xero: the supplier list straight out of the accounts system. Each import
       creates a NEW linked record; duplicates are then resolved with Consolidate, so there is one
       consistent flow for all duplicates. ---- *@
    <Modal IsOpen="importOpen" Title="Import from Xero" ShowFooter="false"
           OnCancel="CloseImportModal" Class="max-w-2xl w-full">
        @if (importError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@importError</p>
        }
        <div class="flex flex-wrap items-end gap-3 mb-4">
            <div class="grow min-w-[14rem]">
                <label class="eyebrow block mb-1">Search</label>
                <input class="field" placeholder="Supplier name, email, town…" value="@importSearch"
                       @oninput="OnImportSearchInput" />
            </div>
            <button type="button" class="btn-secondary shrink-0" disabled="@importLoading"
                    title="Re-read the supplier list from Xero"
                    @onclick="() => LoadSuppliersAsync(force: true)">
                @(importLoading ? "Refreshing…" : "Refresh")
            </button>
        </div>

        @if (importSnapshot is null)
        {
            @* A failed fetch must open the gate — the error paragraph above says what went wrong. *@
            @if (importError is null)
            {
                <LoadGate IsLoading="true" Prominent="true" Label="Reading Xero" />
            }
        }
        else if (!importSnapshot.IsConfigured)
        {
            <p class="text-sm text-content-subtle italic">
                Xero isn't connected — the Xero__ClientId / Xero__ClientSecret app settings are missing.
            </p>
        }
        else if (importSnapshot.Error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@importSnapshot.Error</p>
        }
        else if (FilteredSuppliers().Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No Xero suppliers match.</p>
        }
        else
        {
            <div class="rounded-xl border border-line overflow-y-auto max-h-[50vh]">
                <table class="w-full text-sm">
                    <tbody class="divide-y divide-line">
                        @foreach (var supplier in FilteredSuppliers())
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <p class="text-content font-medium">@supplier.Name</p>
                                    <p class="text-xs text-content-subtle">
                                        @string.Join(" · ", new[] { supplier.EmailAddress, supplier.Town }.Where(x => !string.IsNullOrWhiteSpace(x)))
                                    </p>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    @if (supplier.AlreadyImported)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">Imported</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-secondary text-xs px-2.5 py-1.5"
                                                disabled="@(importingContactId is not null)"
                                                @onclick="() => ImportSupplierAsync(supplier.ContactId)">
                                            @(importingContactId == supplier.ContactId ? "Importing…" : "Import")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (importSnapshot.Truncated)
            {
                <p class="text-xs text-content-subtle mt-2">
                    Xero holds more suppliers than the page cap allows — the list is incomplete (raise Xero__MaxPages).
                </p>
            }
        }
        <p class="text-xs text-content-subtle mt-3">
            Importing copies the supplier into the directory as a new record marked with the
            Xero link symbol. If it duplicates an existing record, tick both in the directory
            and use Consolidate to merge them into one master record.
        </p>
    </Modal>

    @* ---- Consolidate: merge the ticked records into one master. Pick the master, then the
       winning value for each detail; every reference is re-pointed and the other records are
       deleted — their contact details are kept as contacts on the master. ---- *@
    <Modal IsOpen="consolidateOpen" Title="Consolidate records" ShowFooter="true"
           ConfirmLabel="@(consolidating ? "Consolidating…" : $"Merge {consolidateCandidates.Count} records")"
           CancelLabel="Cancel" DismissOnOverlayClick="false"
           OnCancel="CloseConsolidateModal" OnConfirm="SaveConsolidationAsync" Class="max-w-2xl w-full">
        @if (consolidateError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@consolidateError</p>
        }
        <div class="space-y-4">
            <div>
                <p class="eyebrow mb-1">Master record</p>
                <p class="text-xs text-content-subtle mb-2">
                    The record the others merge into. It keeps its history (work orders, invites,
                    compliance documents all move here) — the others are deleted after the merge.
                </p>
                <div class="space-y-1">
                    @foreach (var candidate in consolidateCandidates)
                    {
                        var id = candidate.SubcontractorId;
                        <label class="flex items-center gap-2 text-sm text-content cursor-pointer">
                            <input type="radio" name="consolidate-master" checked="@(masterId == id)"
                                   @onchange="() => masterId = id" />
                            <span class="font-medium">@candidate.CompanyName</span>
                            <span class="text-xs text-content-subtle">
                                @string.Join(" · ", new[] { Label(candidate.Category), candidate.TradesLabel, candidate.XeroLinked ? "Linked to Xero" : "" }.Where(x => !string.IsNullOrWhiteSpace(x)))
                            </span>
                        </label>
                    }
                </div>
            </div>

            @if (mergeFields.Any(field => field.Options.Count > 1))
            {
                <div>
                    <p class="eyebrow mb-1">Choose the winning values</p>
                    <p class="text-xs text-content-subtle mb-2">
                        Where the records disagree, pick the value the master record keeps. Contact
                        details that lose here are kept as additional contacts on the master.
                    </p>
                    <div class="space-y-3">
                        @foreach (var field in mergeFields.Where(field => field.Options.Count > 1))
                        {
                            <div>
                                <p class="text-xs font-medium text-content-muted mb-1">@field.Fieldname</p>
                                <div class="flex flex-wrap gap-x-4 gap-y-1">
                                    @foreach (var option in field.Options)
                                    {
                                        <label class="flex items-center gap-1.5 text-sm text-content cursor-pointer">
                                            <input type="radio" name="@("consolidate-" + field.Key)" checked="@(field.Chosen == option)"
                                                   @onchange="() => field.Chosen = option" />
                                            @option
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <p class="text-xs text-content-subtle">
                Trades are combined, every contact is kept, and Xero links carry across — if any of
                the merged records came from Xero, the master stays linked to Xero.
            </p>
        </div>
    </Modal>
}

@code {
    private bool isLoaded;
    private string search = "";
    private string categoryFilter = ""; // "" = all

    private static readonly DirectoryCategory[] AllCategories =
        (DirectoryCategory[])Enum.GetValues(typeof(DirectoryCategory));

    // Widened for the unified directory (2026-07-22): Admin, MD, FD and PM may browse.
    private bool CanAccess => Session.AvailableRoles.Any(r =>
        r is Role.Admin or Role.ManagingDirector or Role.FinanceDirector or Role.ProjectManager);

    // Adding companies mirrors the API's add authorisation (Admin, MD, FD — the API also allows
    // Office & Compliance, but that role can't reach this page). FD added 2026-07-28.
    private bool CanManage => Session.AvailableRoles.Any(r =>
        r is Role.Admin or Role.ManagingDirector or Role.FinanceDirector);

    // ---- Group chips -------------------------------------------------------
    private enum DirectoryGroup { Clients, Architects, Subcontractors, Staff }

    // Subcontractors default: the company directory is what /directory has always shown.
    private DirectoryGroup group = DirectoryGroup.Subcontractors;

    private static readonly (DirectoryGroup Group, string Label)[] GroupChips =
    {
        (DirectoryGroup.Clients,        "Clients"),
        (DirectoryGroup.Architects,     "Architects"),
        (DirectoryGroup.Subcontractors, "Subcontractors"),
        (DirectoryGroup.Staff,          "Internal staff")
    };

    private string GroupChipClass(DirectoryGroup value) =>
        group == value
            ? "btn-primary text-xs px-2.5 py-1.5"
            : "btn-secondary text-xs px-2.5 py-1.5";

    private string GroupSummary => group switch
    {
        DirectoryGroup.Clients => clientsLoaded
            ? $"{clients.Count} client account{(clients.Count == 1 ? "" : "s")}."
            : "Client accounts.",
        DirectoryGroup.Architects => architectsLoaded
            ? $"{architects.Count} architect practice{(architects.Count == 1 ? "" : "s")}."
            : "Architect practices.",
        DirectoryGroup.Staff => staffLoaded
            ? $"{StaffUsers.Count} internal staff."
            : "Internal staff.",
        _ => $"{Filtered().Count} of {SubcontractorStore.All().Count} companies."
    };

    // Each group loads on first selection, best-effort: the groups keep their own API gates
    // (clients: Admin/MD/PM; staff: Admin/FD), so a 403 for this user's roles shows a quiet
    // restriction note rather than failing the page.
    private void SelectGroup(DirectoryGroup value)
    {
        group = value;
        _ = value switch
        {
            DirectoryGroup.Clients => LoadClientsAsync(),
            DirectoryGroup.Architects => LoadArchitectsAsync(),
            DirectoryGroup.Staff => LoadStaffAsync(),
            _ => Task.CompletedTask
        };
    }

    private IReadOnlyList<Client> clients = Array.Empty<Client>();
    private bool clientsLoaded;
    private string? clientsError;

    private async Task LoadClientsAsync()
    {
        if (clientsLoaded) return;
        try
        {
            clients = await ClientStore.ListAsync();
            clientsLoaded = true;
            clientsError = null;
        }
        catch { clientsError = "Client accounts couldn't be loaded — they're restricted to administrators, the managing director and project managers."; }
        StateHasChanged();
    }

    private IReadOnlyList<Architect> architects = Array.Empty<Architect>();
    private bool architectsLoaded;
    private string? architectsError;

    private async Task LoadArchitectsAsync()
    {
        if (architectsLoaded) return;
        try
        {
            architects = await ArchitectStore.ListAsync();
            architectsLoaded = true;
            architectsError = null;
        }
        catch { architectsError = "Architect practices couldn't be loaded — they're restricted to administrators, the managing director and project managers."; }
        StateHasChanged();
    }

    private bool staffLoaded;
    private string? staffError;

    private IReadOnlyList<DirectoryUser> StaffUsers =>
        Staff.Current ?? (IReadOnlyList<DirectoryUser>)Array.Empty<DirectoryUser>();

    private async Task LoadStaffAsync()
    {
        if (staffLoaded) return;
        try
        {
            await Staff.RefreshAsync(CancellationToken.None);
            staffLoaded = true;
            staffError = null;
        }
        catch { staffError = "The internal staff list couldn't be loaded — it's restricted to administrators and the finance director."; }
        StateHasChanged();
    }

    // Add-company form state
    private bool showAddModal;
    private bool saving;
    private string? addError;
    private string nCompany = "", nContact = "", nEmail = "", nPhone = "", nMobile = "", nTown = "", nCounty = "", nWebsite = "", nAddressLine = "", nPostcode = "";
    private string nNewTrade = "";
    private bool addingTrade;
    private readonly HashSet<string> nTradeIds = new(StringComparer.OrdinalIgnoreCase);
    private DirectoryCategory nCategory = DirectoryCategory.Subcontractor;

    private void OpenAddModal()
    {
        nCompany = nContact = nEmail = nPhone = nMobile = nTown = nCounty = nWebsite = nAddressLine = nPostcode = nNewTrade = "";
        nTradeIds.Clear();
        nCategory = DirectoryCategory.Subcontractor;
        addError = null;
        showAddModal = true;
    }

    private void CloseAddModal() => showAddModal = false;

    private void AddTradeToSelection(ChangeEventArgs e, HashSet<string> target)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id)) target.Add(id);
    }

    private IReadOnlyList<Trade> SelectedTrades(HashSet<string> ids) =>
        SubcontractorStore.Trades().Where(t => ids.Contains(t.TradeId)).ToList();

    // Adds a brand-new trade to the curated list and selects it for this company.
    private async Task CreateTrade()
    {
        if (addingTrade || string.IsNullOrWhiteSpace(nNewTrade)) return;
        addError = null;
        try
        {
            addingTrade = true;
            var trade = await SubcontractorStore.AddTradeAsync(nNewTrade.Trim());
            nTradeIds.Add(trade.TradeId);
            nNewTrade = "";
        }
        catch { addError = "Couldn't add that trade. Please try again."; }
        finally { addingTrade = false; }
    }

    private void SaveCompany()
    {
        if (saving) return;
        addError = null;
        if (string.IsNullOrWhiteSpace(nCompany)) { addError = "Company name is required."; return; }
        if ((nCategory is DirectoryCategory.Subcontractor or DirectoryCategory.Supplier) && nTradeIds.Count == 0)
        { addError = "At least one trade is required for subcontractors and suppliers."; return; }
        try
        {
            saving = true;
            SubcontractorStore.Upsert(new Subcontractor(
                "", nCompany.Trim(), SelectedTrades(nTradeIds), nContact.Trim(), nEmail.Trim(), nPhone.Trim(),
                "", DateTimeOffset.UtcNow, nCategory, nMobile.Trim(), nTown.Trim(), nCounty.Trim(), nWebsite.Trim(),
                AddressLine: nAddressLine.Trim(), Postcode: nPostcode.Trim()));
            showAddModal = false;
        }
        catch { addError = "Couldn't add the company. Please try again."; }
        finally { saving = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        SubcontractorStore.OnChange += OnStoreChanged;
        _ = SubcontractorStore.All(); // kick off the directory load (async; raises OnChange)
        _ = SubcontractorStore.Trades(); // and the curated trade list for the add-company form
        isLoaded = true;
    }

    public void Dispose() => SubcontractorStore.OnChange -= OnStoreChanged;

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    private void OnSearchInput(ChangeEventArgs e) => search = e.Value?.ToString() ?? "";

    private void OnCategoryChanged(ChangeEventArgs e) => categoryFilter = e.Value?.ToString() ?? "";

    private IReadOnlyList<Subcontractor> Filtered()
    {
        var q = (search ?? "").Trim();
        DirectoryCategory? cat = Enum.TryParse<DirectoryCategory>(categoryFilter, out var c) ? c : null;
        return SubcontractorStore.All()
            .Where(s => cat is null || s.Category == cat)
            .Where(s => q.Length == 0
                || (s.CompanyName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || s.Trades.Any(t => t.Name.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (s.ContactName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || (s.ContactEmail ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || (s.Town ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || (s.County ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s.CompanyName)
            .ToList();
    }

    private void Open(string id) => Nav.NavigateTo($"/directory/{id}");

    // ---- Import from Xero --------------------------------------------------
    // The modal lists Xero's suppliers (contacts that have had a bill). Its search box starts
    // from whatever is in the directory search box, so "sear" over the directory carries straight
    // into the Xero list. Importing creates a NEW linked record every time — duplicates are then
    // resolved with Consolidate below, one consistent flow for all duplicates.

    private bool importOpen;
    private string importSearch = "";
    private XeroSuppliersSnapshot? importSnapshot;
    private bool importLoading;
    private string? importError;
    private string? importingContactId;

    private void OpenImportModal()
    {
        importSearch = search; // the modal's search starts as the directory's search text
        importError = null;
        importOpen = true;
        if (importSnapshot is null) _ = LoadSuppliersAsync(force: false);
    }

    private void CloseImportModal() => importOpen = false;

    private void OnImportSearchInput(ChangeEventArgs e) => importSearch = e.Value?.ToString() ?? "";

    private async Task LoadSuppliersAsync(bool force)
    {
        if (importLoading) return;
        importError = null;
        try
        {
            importLoading = true;
            if (force) importSnapshot = null;
            importSnapshot = await SubcontractorStore.FetchXeroSuppliersAsync(force);
        }
        catch { importError = "The Xero supplier list couldn't be loaded. Please try again."; }
        finally { importLoading = false; StateHasChanged(); }
    }

    private IReadOnlyList<XeroSupplier> FilteredSuppliers()
    {
        if (importSnapshot is null) return Array.Empty<XeroSupplier>();
        var q = (importSearch ?? "").Trim();
        return importSnapshot.Suppliers
            .Where(supplier => q.Length == 0
                || supplier.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || supplier.EmailAddress.Contains(q, StringComparison.OrdinalIgnoreCase)
                || supplier.Town.Contains(q, StringComparison.OrdinalIgnoreCase)
                || supplier.County.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task ImportSupplierAsync(string contactId)
    {
        if (importingContactId is not null) return;
        importError = null;
        try
        {
            importingContactId = contactId;
            await SubcontractorStore.ImportFromXeroAsync(contactId);
            // Mark the row imported in place rather than re-reading Xero for a flag we already know.
            if (importSnapshot is not null)
            {
                importSnapshot = importSnapshot with
                {
                    Suppliers = importSnapshot.Suppliers
                        .Select(supplier => supplier.ContactId == contactId
                            ? supplier with { AlreadyImported = true }
                            : supplier)
                        .ToList()
                };
            }
        }
        catch (CommandFailedException ex) { importError = $"Couldn't import: {ex.Message}"; }
        catch { importError = "Couldn't import that supplier. Please try again."; }
        finally { importingContactId = null; }
    }

    // ---- Consolidation -----------------------------------------------------
    // Tick 2+ records, choose the master and the winning value for each detail; the server
    // re-points every reference to the master, keeps losing contact details as contacts, moves
    // the Xero links across and deletes the merged-away records.

    private readonly HashSet<string> selectedIds = new(StringComparer.OrdinalIgnoreCase);
    private bool consolidateOpen;
    private bool consolidating;
    private string? consolidateError;
    private string masterId = "";
    private List<Subcontractor> consolidateCandidates = new();
    private List<MergeField> mergeFields = new();

    private sealed class MergeField
    {
        public string Key = "";
        public string Fieldname = "";
        public List<string> Options = new();
        public string Chosen = "";
    }

    private void ToggleSelected(string subcontractorId, ChangeEventArgs e)
    {
        if (e.Value is bool ticked && ticked) selectedIds.Add(subcontractorId);
        else selectedIds.Remove(subcontractorId);
    }

    // Selection intersected with the current directory, so a stale tick (record merged away in
    // another tab) can never enter a consolidation.
    private List<Subcontractor> SelectedForConsolidation() =>
        SubcontractorStore.All().Where(sub => selectedIds.Contains(sub.SubcontractorId)).ToList();

    private void OpenConsolidateModal()
    {
        consolidateCandidates = SelectedForConsolidation();
        if (consolidateCandidates.Count < 2) return;

        // Default master: the oldest record — the company has been known under it the longest.
        masterId = consolidateCandidates.OrderBy(sub => sub.OnboardedAt).First().SubcontractorId;

        var master = consolidateCandidates.First(sub => sub.SubcontractorId == masterId);
        mergeFields = new List<MergeField>
        {
            BuildField("company", "Company name", master.CompanyName, consolidateCandidates.Select(sub => sub.CompanyName)),
            BuildField("category", "Type", Label(master.Category), consolidateCandidates.Select(sub => Label(sub.Category))),
            BuildField("contact", "Contact name", master.ContactName, consolidateCandidates.Select(sub => sub.ContactName)),
            BuildField("email", "Email", master.ContactEmail, consolidateCandidates.Select(sub => sub.ContactEmail)),
            BuildField("phone", "Phone", master.ContactPhone, consolidateCandidates.Select(sub => sub.ContactPhone)),
            BuildField("mobile", "Mobile", master.MobileNumber, consolidateCandidates.Select(sub => sub.MobileNumber)),
            BuildField("address", "Address line", master.AddressLine, consolidateCandidates.Select(sub => sub.AddressLine)),
            BuildField("town", "Town", master.Town, consolidateCandidates.Select(sub => sub.Town)),
            BuildField("county", "County", master.County, consolidateCandidates.Select(sub => sub.County)),
            BuildField("postcode", "Postcode", master.Postcode, consolidateCandidates.Select(sub => sub.Postcode)),
            BuildField("website", "Website", master.Website, consolidateCandidates.Select(sub => sub.Website)),
            BuildField("cis", "CIS status", master.CisStatus, consolidateCandidates.Select(sub => sub.CisStatus)),
            BuildField("terms", "Payment terms (days)", master.PaymentTermsDays.ToString(),
                consolidateCandidates.Select(sub => sub.PaymentTermsDays.ToString()))
        };

        consolidateError = null;
        consolidateOpen = true;
    }

    private static MergeField BuildField(string key, string fieldname, string masterValue, IEnumerable<string> values)
    {
        var options = values
            .Select(value => (value ?? "").Trim())
            .Where(value => value.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        var chosen = !string.IsNullOrWhiteSpace(masterValue) ? masterValue.Trim() : options.FirstOrDefault() ?? "";
        return new MergeField { Key = key, Fieldname = fieldname, Options = options, Chosen = chosen };
    }

    private void CloseConsolidateModal() => consolidateOpen = false;

    private string ChosenValue(string key) =>
        mergeFields.FirstOrDefault(field => field.Key == key)?.Chosen ?? "";

    private async Task SaveConsolidationAsync()
    {
        if (consolidating) return;
        if (string.IsNullOrWhiteSpace(masterId)) { consolidateError = "Pick the master record."; return; }
        if (string.IsNullOrWhiteSpace(ChosenValue("company"))) { consolidateError = "Company name is required."; return; }
        consolidateError = null;

        // The Type radio carries the label; map it back to the enum (labels are one-to-one).
        var category = AllCategories.FirstOrDefault(c => Label(c) == ChosenValue("category"));
        var terms = int.TryParse(ChosenValue("terms"), out var parsedTerms) ? parsedTerms : 30;
        var mergedIds = consolidateCandidates
            .Select(sub => sub.SubcontractorId)
            .Where(id => !string.Equals(id, masterId, StringComparison.OrdinalIgnoreCase))
            .ToList();

        try
        {
            consolidating = true;
            await SubcontractorStore.ConsolidateAsync(new ConsolidateDirectoryRecords(
                masterId, mergedIds,
                ChosenValue("company"), ChosenValue("contact"), ChosenValue("email"), ChosenValue("phone"),
                ChosenValue("cis"), category, ChosenValue("mobile"), ChosenValue("town"), ChosenValue("county"),
                ChosenValue("website"), terms,
                AddressLine: ChosenValue("address"), Postcode: ChosenValue("postcode")));
            selectedIds.Clear();
            consolidateOpen = false;
        }
        catch (CommandFailedException ex) { consolidateError = $"Couldn't consolidate: {ex.Message}"; }
        catch { consolidateError = "Couldn't consolidate the records. Please try again."; }
        finally { consolidating = false; }
    }

    // The screen's "Primary contact" cell is compound (name + email subtitle) — split
    // into two columns so the email isn't lost from the export.
    private ExcelWorkbook? BuildExportWorkbook(bool ignoreFilters)
    {
        // "Ignore search & filter" (offered while either is narrowing the table) exports the
        // complete directory in the same company-name order.
        var subs = ignoreFilters
            ? SubcontractorStore.All().OrderBy(s => s.CompanyName).ToList()
            : Filtered();
        if (subs.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Directory",
            new ExcelColumn("Company"),
            new ExcelColumn("Type"),
            new ExcelColumn("Trade"),
            new ExcelColumn("Primary contact"),
            new ExcelColumn("Contact email"),
            new ExcelColumn("Location"));

        foreach (var sub in subs)
        {
            sheet.AddRow(
                sub.CompanyName,
                Label(sub.Category),
                sub.TradesLabel,
                sub.ContactName,
                sub.ContactEmail,
                Location(sub));
        }
        return workbook;
    }

    private static string Location(Subcontractor s) =>
        string.Join(", ", new[] { s.Town, s.County }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string Label(DirectoryCategory c) => c switch
    {
        DirectoryCategory.Subcontractor => "Subcontractor",
        DirectoryCategory.Client => "Client",
        DirectoryCategory.Architect => "Architect",
        DirectoryCategory.Supplier => "Supplier",
        _ => "Other"
    };
