@page "/projects/{ProjectId}/drawings"
@inject AuthService Auth
@inject SessionService Session
@inject IDrawingStore DrawingStore
@inject BluebeamStatusStore Bluebeam
@inject NavigationManager Nav
@implements IDisposable
@using Jewel.JPMS.Features.Drawings

<PageTitle>Drawings · JPMS</PageTitle>

@if (!isLoaded)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="drawings">
        <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
            <div>
                <h2 class="text-lg font-semibold text-content">Drawing register</h2>
                <p class="text-sm text-content-muted">
                    @Drawings.Count drawings
                    @if (Folders.Count > 0)
                    {
                        @* Lead with the top-level count — the folder rows the register actually
                           shows — and disclose sub-folders as their own number: one figure
                           covering both levels reads as a wrong count next to a table of fewer
                           rows. *@
                        <span class="text-content-subtle">· @TopLevelFolderCount folders</span>
                        @if (SubFolderCount > 0)
                        {
                            <span class="text-content-subtle">· @SubFolderCount sub-folders</span>
                        }
                    }
                    @if (Ambiguous.Count > 0)
                    {
                        <span class="ml-2 inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-1.5 py-0.5 text-[10px] font-medium text-amber-800">
                            @Ambiguous.Count ambiguous
                        </span>
                    }
                </p>
            </div>
            <div class="flex items-center gap-2">
                <ExportToExcelButton FileName="Drawing register"
                                     Disabled="@(Drawings.Count == 0)"
                                     ShowIncludeAllRows="@approvedOnly"
                                     IncludeAllLabel="Include unapproved"
                                     BuildWorkbook="BuildExportWorkbook" />
                <button type="button" @onclick="() => approvedOnly = !approvedOnly"
                        class="rounded-lg border text-sm px-3 py-2 transition @(approvedOnly ? "bg-emerald-50 border-emerald-200 text-emerald-800" : "border-line-strong text-content-muted hover:bg-surface-raised")">
                    @(approvedOnly ? "Showing approved" : "All drawings")
                </button>
                @if (CanManage)
                {
                    @if (Bluebeam.IsConnected)
                    {
                        @* Queues every drawing whose latest live PDF revision has never been
                           extracted — the Bluebeam markups + text-layer backlog in one click. *@
                        <button type="button" @onclick="() => confirmingExtractAll = true"
                                class="rounded-lg border border-line-strong text-sm px-3 py-2 text-content-muted hover:bg-surface-raised transition">
                            Extract all
                        </button>
                    }
                    <button type="button" @onclick="OpenNewFolder"
                            class="rounded-lg border border-line-strong text-sm px-3 py-2 text-content-muted hover:bg-surface-raised transition">
                        + New folder
                    </button>
                    @* "Add drawings" OPENS the panel; the button that actually uploads lives inside
                       it and says "…to the register" — two different acts, two different labels. *@
                    <button type="button" @onclick="ToggleUploadPanel"
                            class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition">
                        @(isUploading ? "Close" : "+ Add drawings")
                    </button>
                }
            </div>
        </div>

        @if (isUploading)
        {
            <div class="mb-5">
                <DrawingUploadForm ProjectId="@ProjectId"
                                   InitialFolderId="@uploadIntoFolder?.DrawingFolderId"
                                   OnUploaded="CloseUploadPanel" />
            </div>
        }

        @if (VisibleDrawings.Count == 0 && Folders.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                @(approvedOnly ? "No approved drawings yet." : "No drawings uploaded yet.")
            </p>
        }
        else
        {
            <DrawingsTable Drawings="VisibleDrawings"
                           Folders="Folders"
                           CanManage="CanManage"
                           OnCreateSubFolder="OpenNewSubFolder"
                           OnUploadToFolder="OpenUploadTo"
                           OnRenameFolder="OpenRenameFolder"
                           OnDeleteFolder="OpenDeleteFolder" />
        }

        @* New folder / new sub-folder / rename share one name dialog — which command runs depends
           on renamingFolder, and where a new folder lands on parentFolder. *@
        <Modal IsOpen="folderDialogOpen"
               Title="@FolderDialogTitle"
               ConfirmLabel="@(folderBusy ? "Saving…" : renamingFolder is null ? "Create folder" : "Rename folder")"
               ConfirmDisabled="@(folderBusy || string.IsNullOrWhiteSpace(folderName))"
               OnCancel="CloseFolderDialog"
               OnConfirm="SaveFolderAsync">
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Folder name *</label>
            <input type="text" @bind="folderName" @bind:event="oninput" placeholder="Architectural, Structural, M&E…"
                   class="field" />
            @if (folderError is not null)
            {
                <p class="mt-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">@folderError</p>
            }
        </Modal>

        <Modal IsOpen="deletingFolder is not null"
               Title="Delete folder?"
               ConfirmLabel="@(folderBusy ? "Deleting…" : "Delete folder")"
               ConfirmDisabled="@folderBusy"
               OnCancel="() => deletingFolder = null"
               OnConfirm="DeleteFolderAsync">
            <p class="text-sm text-content-muted">
                This deletes the folder <strong>@deletingFolder?.Name</strong>. Nothing inside it is
                deleted — its drawings and sub-folders move up a level
                @(deletingFolder?.ParentDrawingFolderId is null ? "(to the register's top level and Ungrouped section)." : $"into “{Tree.PathOf(deletingFolder.ParentDrawingFolderId)}”.")
            </p>
            @if (folderError is not null)
            {
                <p class="mt-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">@folderError</p>
            }
        </Modal>

        <Modal IsOpen="confirmingExtractAll"
               Title="Extract all unprocessed drawings?"
               ConfirmLabel="@(extractAllBusy ? "Queueing…" : "Extract all")"
               ConfirmDisabled="@extractAllBusy"
               OnCancel="() => confirmingExtractAll = false"
               OnConfirm="ExtractAllAsync">
            <p class="text-sm text-content-muted">
                Every drawing whose latest live PDF revision hasn't had its data extracted is queued
                through Bluebeam (markups) and the text-layer reader. The runs happen in the
                background — each drawing's page shows its own progress and results.
            </p>
            @if (extractAllError is not null)
            {
                <p class="mt-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">@extractAllError</p>
            }
        </Modal>

        @if (extractAllNote is not null)
        {
            <p class="mt-4 rounded-lg bg-surface-raised border border-line px-3 py-2 text-sm text-content">@extractAllNote</p>
        }
    </ProjectPageShell>
}

