@page "/projects/{ProjectId}/financials"
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Commercial
@using Jewel.JPMS.Features.Procurement
@using Jewel.JPMS.Commercial
@inject AuthService Auth
@inject SessionService Session
@inject CostCentersReadModel CostCenters
@inject ProjectFinancialSummaryReadModel Summary
@inject ProjectWorkOrdersReadModel WorkOrders
@inject ValuationLinesReadModel ValuationLines
@inject CostCentreGroupsReadModel Groups
@inject ICommandSender Commands
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Financials · JPMS</PageTitle>

@if (!isLoaded)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="financials">
        <h2 class="text-lg font-semibold text-content mb-3">Financial summary</h2>

        @if (CostCenters.Current.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No cost centres found. Run the cost-centre seed script against the database to populate the master list.
            </p>
        }
        else
        {
            @if (Summary.LastRefreshFailed(ProjectId))
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">
                    The financial summary could not be loaded — the figures below only show work-order data.
                    <button type="button" class="underline underline-offset-2 ml-1" @onclick="RetrySummaryAsync">Retry</button>
                </p>
            }
            @if (actionError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">
                    @actionError
                </p>
            }
            @if (PendingLabourTotal > 0m)
            {
                <p class="rounded-lg bg-amber-500/10 border border-amber-500/30 px-3 py-2 text-sm text-amber-600 mb-3">
                    Pending labour: £@PendingLabourTotal.ToString("N2") submitted on timesheets but not yet approved —
                    it posts to cost of sales only once approved on the
                    <a class="underline underline-offset-2" href="@($"/projects/{ProjectId}/labour")">Labour tab</a>.
                </p>
            }
            <FinancialsTable CostCenters="CostCenters.Current"
                             SummaryRows="Summary.Current(ProjectId)"
                             Groups="Groups.Current(ProjectId)"
                             WorkOrderCommittedByCode="WoCommittedByCode"
                             Packages="packageRows"
                             OnContractSalesSelected="OpenSalesLinesModal"
                             OnWorkOrderCommittedSelected="OpenWorkOrdersModal"
                             OnCostOfSalesSelected="OpenCostOfSalesModal"
                             OnReportSelected="OpenReconciliationModal"
                             OnGroupRequested="OpenGroupDialog"
                             OnUngroupRequested="HandleUngroupAsync"
                             OnCostCompletionChanged="HandleCostCompletionChangedAsync"
                             OnFinalisationToggled="HandleFinalisationToggledAsync" />
            <p class="text-xs text-content-subtle mt-3">
                Contract sales value is the valuation report's contract value per cost centre — initial
                contract plus variation lines, declined/TBC excluded; click a figure for the valuation
                lines behind it. % complete is the sales-side completion from the latest claim (edit it
                on the valuation report); claim value is the cumulative claimed amount at that
                completion. Target cost value is the contract sales value with our assumed
                @($"{FinancialSummaryAssumptions.MarkupPercent:0.#}%") markup backed out (divided by
                @($"{1m + FinancialSummaryAssumptions.MarkupPercent / 100m:0.##}")) — what the line
                should cost us. Work orders is the value committed to work orders — click a figure
                for the line's orders. Actual cost of sales is Xero purchase spend allocated to this
                project on the Allocation page, net of credit notes — click a figure for the invoices,
                where each can be linked to the work order it pays against or moved to another centre.
                Spend linked to a work order is shown against the order's cost centres (pro-rata to the
                order's lines) rather than the centre the invoice was coded to in Xero, so it lines up
                with the Work Orders column; the click-through shows those moves as ± rows.
                Non-WO cost of sales is the share of that spend not linked to any work order and stays
                on the invoice's own centre. Committed cost of sales is work orders plus non-WO cost
                of sales — what is already committed against the line. What's left of the target cost
                after that splits by sign: drawdown is the remainder where positive (funds still
                available), overspend where negative (committed cost past the target) — split per
                centre, so a roll-up shows both sides rather than netting one against the other.
                Forecasted cost of sales is committed plus drawdown — the line's expected total cost:
                an underspent line is forecast to spend its full target, an overspent one what is
                already committed. Lock a line when no more
                is to be spent on it: its remaining drawdown moves to profit / loss, realising what was
                made (or lost) buying against that centre. Cost % complete is the cost-side
                completion — edit it directly in the table. Tick two or more rows to roll them up into
                one named line — existing roll-ups can be ticked too, merging them into the new line
                (e.g. add a third centre to a group of two without ungrouping). On a rolled-up line,
                figures are summed, the two percentages are value-weighted, and editing cost % or the
                lock applies to every member. With "Hide scope in packages" ticked (the default),
                sales, work orders and invoiced cost (including direct purchase invoices assigned
                to a package's cost side) already in a reconciliation package
                are netted off the cost-centre rows and appear instead as PKG lines in this table —
                so every pound shows exactly once and the Total row still covers the whole project.
                Package lines are managed (edit / lock / dissolve) in the Packages section below.
                Untick to see gross figures on the centres; the package lines drop out so nothing
                double-counts.
            </p>

            @* Reconciliation packages: a sub's work orders against the valuation lines that
               priced their scope — the truth at the level the work was bought and sold. *@
            <PackageReconciliationSection ProjectId="@ProjectId"
                                          ValuationLines="ValuationLines.Current(ProjectId)"
                                          Orders="WorkOrders.Current(ProjectId)"
                                          OnRowsChanged="HandlePackageRowsChangedAsync"
                                          OnOrdersChanged="HandleOrdersChangedAsync" />

            <CostCentreSalesLinesModal IsOpen="@(selectedSales is not null)"
                                       ProjectId="@ProjectId"
                                       Heading="@(selectedSales?.Heading ?? "")"
                                       CostCodes="@(selectedSales?.CostCodes ?? Array.Empty<string>())"
                                       Lines="ValuationLines.Current(ProjectId)"
                                       OnClose="CloseSalesLinesModal"
                                       OnLineRecoded="HandleSalesLineRecodedAsync" />

            <CostCentreWorkOrdersModal IsOpen="@(selectedWo is not null)"
                                       ProjectId="@ProjectId"
                                       Heading="@(selectedWo?.Heading ?? "")"
                                       CostCodes="@(selectedWo?.CostCodes ?? Array.Empty<string>())"
                                       Orders="WorkOrders.Current(ProjectId)"
                                       OnClose="CloseWorkOrdersModal" />

            <CostCentreReconciliationModal IsOpen="@(selectedReport is not null)"
                                           ProjectId="@ProjectId"
                                           Heading="@(selectedReport?.Heading ?? "")"
                                           CostCodes="@(selectedReport?.CostCodes ?? Array.Empty<string>())"
                                           SummaryRows="Summary.Current(ProjectId)"
                                           Lines="ValuationLines.Current(ProjectId)"
                                           Orders="WorkOrders.Current(ProjectId)"
                                           OnClose="CloseReconciliationModal" />

            <CostCentreCostOfSalesModal IsOpen="@(selectedCostOfSales is not null)"
                                        ProjectId="@ProjectId"
                                        Heading="@(selectedCostOfSales?.Heading ?? "")"
                                        CostCodes="@(selectedCostOfSales?.CostCodes ?? Array.Empty<string>())"
                                        Orders="WorkOrders.Current(ProjectId)"
                                        OnClose="CloseCostOfSalesModal"
                                        OnInvoiceMoved="HandleInvoiceMovedAsync"
                                        OnWorkOrderLinkChanged="HandleWorkOrderLinkChangedAsync" />

            <Modal IsOpen="@(pendingGroupCodes is not null)"
                   Title="Roll up into one line"
                   ConfirmLabel="Create group"
                   ConfirmDisabled="@(string.IsNullOrWhiteSpace(groupName) || isCreatingGroup)"
                   OnConfirm="CreateGroupAsync"
                   OnCancel="CloseGroupDialog"
                   Class="max-w-md">
                <div class="space-y-3">
                    <p class="text-sm text-content-subtle">
                        The selected cost centres will show as one report line. Figures are summed and
                        percentages value-weighted; nothing changes underneath — ungroup at any time.
                        @if (pendingReplaceGroupIds.Count > 0)
                        {
                            <text> The selected roll-up@(pendingReplaceGroupIds.Count > 1 ? "s are" : " is") merged
                            into this new line.</text>
                        }
                    </p>
                    <p class="text-sm text-content font-mono text-[12px]">@string.Join(", ", pendingGroupCodes ?? Array.Empty<string>())</p>
                    <label class="block text-sm text-content-subtle">
                        Name for the rolled-up line
                        <input type="text" maxlength="128"
                               class="mt-1 w-full rounded-md border border-line bg-surface px-3 py-2 text-sm text-content
                                      focus:outline-none focus:border-line-strong"
                               placeholder="e.g. Windows, doors and glazing"
                               @bind="groupName" @bind:event="oninput" />
                    </label>
                    @if (groupDialogError is not null)
                    {
                        <p class="text-sm text-negative">@groupDialogError</p>
                    }
                </div>
            </Modal>
        }
    </ProjectPageShell>
}

