@page "/projects/{ProjectId}/valuation"
@using Jewel.JPMS.Commercial
@using Jewel.JPMS.Contracts.Ai
@using Jewel.JPMS.Contracts.Commercial
@using Jewel.JPMS.Features.Commercial
@inject AuthService Auth
@inject SessionService Session
@inject IValuationReportStore Store
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@inject IValuationInvoiceStore Invoices
@inject IProjectRetentionStore Retention
@inject ICostCenterStore CostCenters
@inject IVariationStore Variations
@inject IClientCostReferenceStore ClientReferences
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Valuation Report · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="valuation">
        <div class="flex items-center justify-between gap-4 mb-4 flex-wrap">
            <h2 class="text-lg font-semibold text-content">Valuation Report</h2>
            <div class="flex items-center gap-2 flex-wrap">
                @* Working-copy exports of the report AS IT STANDS — available at every claim
                   stage, draft included, so the accountant can review the layout before anything
                   is submitted. Both are stamped as a working copy; the client-facing statement
                   remains the frozen snapshot behind the invoice. Disabled (not hidden) until the
                   report has loaded — a control is never gated. *@
                <Toolbar>
                    <ToolbarButton Icon="download" Label="Download PDF — working copy of the report as it stands" Target="_blank"
                                   Disabled="@(!ReportReady)"
                                   Href="@($"/api/projects/{ProjectId}/valuation-report/pdf")" />
                    @* Also waits for the variations register: the workbook's Pending tab reads it,
                       and exporting before it has answered would pass "not loaded" off as "none". *@
                    <ExportToExcelButton FileName="@LiveExportFileName" FileDate="@DateTimeOffset.UtcNow"
                                         Disabled="@(!ReportReady || PendingVariationsUnanswered || ClientReferencesUnanswered)"
                                         BuildWorkbook="BuildLiveExportWorkbook" />
                    @* Report setup, apart from the document actions: the client's schedule-of-works
                       references per cost centre, printed as a "Client ref" column on the PDF. *@
                    @if (CanMapClientReferences)
                    {
                        <ToolbarDivider />
                        <ToolbarButton Icon="tag" Label="Client references — map cost centres to the client's schedule-of-works item numbers for the PDF"
                                       Disabled="@(!ReportReady)"
                                       OnClick="@(() => showClientReferences = true)" />
                    }
                </Toolbar>
                @* The claim picker sits in a row with the New claim button, so it shows its own
                   waiting state rather than a spinner between two controls. Disabled while the
                   claims load: an empty picker reads as "this project has never been valued". *@
                @if (!ClaimReady)
                {
                    <select disabled
                            class="rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content-subtle">
                        <option>Loading claims…</option>
                    </select>
                }
                else if (Claims.Count > 0)
                {
                    <select @bind="selectedClaimId"
                            class="rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent">
                        @foreach (var claim in Claims)
                        {
                            <option value="@claim.ValuationClaimId">@claim.DisplayName — @claim.Status.DisplayName() (@claim.ClaimDate.ToString("dd MMM yyyy"))</option>
                        }
                    </select>
                }
                <button @onclick="ToggleStartClaim"
                        class="rounded-lg border border-line bg-surface text-content-muted font-medium text-sm px-3 py-2 hover:border-line-strong transition">
                    New claim
                </button>
            </div>
        </div>

        @if (actionError is not null)
        {
            <p class="mb-2 rounded-lg border border-negative/30 bg-negative/10 px-3 py-2 text-sm text-negative">
                @actionError
                <button @onclick="@(() => actionError = null)" class="ml-2 underline underline-offset-2">Dismiss</button>
            </p>
        }

        @* One card per selected claim: where it is in its life, the ONE next action as the
           primary button beside the stepper, and everything else behind the Actions menu. *@
        @* The stage, the hint and the stepper are read off the claim AND the invoices drawn
           against it, so the card waits for both — half the picture names the wrong next action,
           and "No claim selected" is a real answer that must not be shown as a guess. *@
        <LoadGate IsLoading="@(!ClaimReady)" Prominent="true" Label="Loading the claim">
        <ClaimProgressDialog ProjectId="@ProjectId" IsOpen="claimProgressOpen" Claim="@Selected"
                             OnClose="CloseClaimProgress" OnSaved="ClaimProgressSaved" />

        @if (Selected is { } s)
        {
            <section class="rounded-xl border border-line bg-surface p-4 mb-4">
                <div class="flex items-start justify-between gap-4 flex-wrap">
                    <div class="min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-semibold text-content">@s.DisplayName</span>
                            <span class="@ClaimBadgeClass(s.Status)"
                                  title="@(s.Status == ValuationClaimStatus.Preapproved && s.PreapprovedAt is { } pa ? $"Issued {pa:dd MMM yyyy}" : "")">@s.Status.DisplayName()</span>
                        </div>
                        <p class="text-sm text-content-muted mt-1.5">@StageHint(s)</p>
                    </div>
                    @* Secondary claim actions (rename, reopen, early confirm, delete) live behind one
                       menu — two clicks away, so nothing destructive sits raw on the title bar — and
                       only for the roles that run the report, never the client. *@
                    @if (CanManageClaims)
                    {
                        <DropdownMenu Label="Actions" WidthClass="w-72" Items="ClaimMenuItems" Class="shrink-0" />
                    }
                </div>
                <div class="mt-3 flex items-center justify-between gap-4 flex-wrap">
                    <ol class="flex items-center gap-1.5 text-xs flex-wrap">
                        @foreach (var step in StepsFor(s))
                        {
                            <li class="flex items-center gap-1.5">
                                <span class="w-4 h-4 rounded-full inline-flex items-center justify-center text-[10px] @(step.Done ? "bg-accent text-accent-ink" : step.Current ? "border border-accent text-accent" : "border border-line text-content-subtle")">
                                    @(step.Done ? "✓" : step.Index.ToString())
                                </span>
                                <span class="@(step.Current ? "text-content font-medium" : step.Done ? "text-content-muted" : "text-content-subtle")">@step.Label</span>
                                @if (step.Index < 6)
                                {
                                    <span class="w-6 h-px bg-line mx-1" aria-hidden="true"></span>
                                }
                            </li>
                        }
                    </ol>
                    @* The ONE next action sits at the end of the stage stepper it advances —
                       the stepper says where the claim is, the button says what moves it on. *@
                    @switch (StageFor(s))
                    {
                        case ClaimStage.Draft:
                            <button @onclick="PreapproveAsync" disabled="@busy"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                We're claiming this
                            </button>
                            break;
                        case ClaimStage.AwaitingInvoice:
                            <button @onclick="RaiseInvoiceAsync" disabled="@(busy || PaymentDueNow <= 0m)"
                                    title="@(PaymentDueNow > 0m
                                              ? "One click: raises the valuation invoice for the amount due and sends the claim to the architect/client — the report snapshot freezes behind it."
                                              : "Nothing is currently due — manage invoices in Valuation Invoices below")"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Raise &amp; send invoice (@Money(PaymentDueNow))
                            </button>
                            break;
                        case ClaimStage.InvoiceDraft:
                            <button @onclick="SendInvoiceAsync" disabled="@busy"
                                    title="Sends the drafted invoice to the architect/client for approval — Actions has the no-approval-loop issue"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Send claim
                            </button>
                            break;
                        case ClaimStage.AwaitingApproval:
                            <button @onclick="ApproveInvoiceAsync" disabled="@busy"
                                    title="Record the architect/client's approval — Actions has rejection, and issue-without-approval for clients with no formal loop"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Record approval
                            </button>
                            break;
                        case ClaimStage.ApprovedAwaitingIssue:
                            <button @onclick="IssueInvoiceAsync" disabled="@busy"
                                    title="Marks the invoice issued to the client — moves certified to date"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Issue invoice
                            </button>
                            break;
                        case ClaimStage.InvoiceRejected:
                            <button @onclick="AmendRejectedInvoice" disabled="@busy"
                                    title="Amend the rejected invoice — saving returns it to draft, ready to resend"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Amend invoice…
                            </button>
                            break;
                        case ClaimStage.AwaitingPayment:
                            @if (IsLatestClaim(s))
                            {
                                <button @onclick="@(() => OpenNextClaimForm(s))"
                                        title="Payment isn't a gate — carry on with the next period. Record payment… is in Actions for when the cash lands"
                                        class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover transition shrink-0">
                                    Start next claim
                                </button>
                            }
                            break;
                        case ClaimStage.ReadyToConfirm:
                            <button @onclick="ConfirmClickedAsync" disabled="@busy"
                                    title="The invoice payment is already recorded — this locks the period as the baseline and rolls into the next"
                                    class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover disabled:bg-surface-field transition shrink-0">
                                Confirm &amp; roll over
                            </button>
                            break;
                        case ClaimStage.Confirmed:
                            @if (IsLatestClaim(s))
                            {
                                <button @onclick="@(() => OpenNextClaimForm(s))"
                                        class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-4 py-2 hover:bg-accent-hover transition shrink-0">
                                    Start next claim
                                </button>
                            }
                            break;
                    }
                </div>
            </section>
        }
        else
        {
            <p class="text-sm text-content-subtle italic mb-4">No claim selected. Build the bill below, then start a claim to value works complete.</p>
        }
        </LoadGate>

        @* Whether lines can still be added is the selected claim's status — offer this before the
           claims land and it appears on a locked claim, then vanishes. *@
        @if (ClaimReady && Selected is null or { Status: ValuationClaimStatus.Draft })
        {
            <div class="flex justify-end mb-2">
                <button @onclick="OpenAddLine"
                        class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition">
                    Add line
                </button>
            </div>
        }

        @* Every row is a valuation line priced against the cost-centre master and the claim's
           entries, so the table holds until both masters are in. *@
        <LoadGate IsLoading="@(!ReportReady)" Prominent="true" Label="Loading the valuation report">
        <ValuationReportTable ProjectId="@ProjectId" SelectedClaim="@Selected" PreviousClaim="@PreviousClaim"
                              OnEditLine="StartEditLine" CertifiedToDate="@CertifiedToDateGross"
                              DepositCreditedToDate="@DepositCreditedToDate">
            <ExtraSections>
                @* The old Cash Calls tab, folded into the report: issued invoices feed
                   "Certified to date" and therefore the payment due. *@
                <ValuationInvoicesSection @ref="invoicesSection"
                                          ProjectId="@ProjectId"
                                          ValuationClaimId="@Selected?.ValuationClaimId"
                                          OnInvoicedToDateChanged="OnInvoicedToDateChanged"
                                          OnCertifiedChanged="OnCertifiedChanged"
                                          OnViewSnapshot="OpenSnapshot" />
                @* Snapshot register: the frozen report behind each invoice submission,
                   plus on-demand period-end captures. *@
                <div class="mt-3">
                    <ValuationSnapshotsSection ProjectId="@ProjectId" OnView="OpenSnapshot" OnDeleted="OnSnapshotDeleted" OnEmail="OpenSnapshotEmail" />
                </div>
            </ExtraSections>
        </ValuationReportTable>
        </LoadGate>

        <Modal IsOpen="@(showLineForm || editingLine is not null)"
               Title="@(editingLine is null ? "Add a line" : "Edit line")"
               ShowFooter="false" Class="max-w-3xl" OnCancel="CloseLineForm">
            <ValuationLineForm ProjectId="@ProjectId" Editing="@editingLine" OnSaved="OnLineSaved" OnCancel="CloseLineForm" />
        </Modal>

        @if (showClientReferences)
        {
            <ClientCostReferencesModal ProjectId="@ProjectId"
                                       OnSaved="@(() => showClientReferences = false)"
                                       OnCancelled="@(() => showClientReferences = false)" />
        }

        <Modal IsOpen="@(viewingSnapshotId is not null)"
               Title="Valuation report snapshot"
               ShowFooter="false" Class="max-w-6xl" OnCancel="CloseSnapshot">
            @if (viewingSnapshotId is not null)
            {
                <ValuationSnapshotViewer SnapshotId="@viewingSnapshotId"
                                         OnEmailRequested="@(CanEmailSnapshot ? EventCallback.Factory.Create<string>(this, OpenSnapshotEmail) : default)" />
            }
        </Modal>

        <ValuationSnapshotEmailModal Snapshot="@emailingSnapshot" OnClose="@(() => emailingSnapshot = null)" />

        <Modal IsOpen="@showStartClaim"
               Title="@($"Start claim {NextClaimNumber}")"
               ConfirmLabel="@(busy ? "Starting…" : "Start claim")"
               ConfirmDisabled="@busy"
               OnCancel="@(() => showStartClaim = false)"
               OnConfirm="StartClaimAsync"
               Class="max-w-lg">
            <div class="space-y-3">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Period name</label>
                    <input type="text" @bind="newClaimName" placeholder="e.g. June 2026"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent" />
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Claim date</label>
                    <input type="date" @bind="newClaimDate"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent" />
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Retention</label>
                    @* Read-only: the claim stamps its retention from the project's terms when it
                       starts — the completion date decides whether the release % applies. *@
                    @* "No terms recorded" is advice to go and record some, so it waits until the
                       terms have actually been looked for. *@
                    <LoadGate IsLoading="@(!Retention.RetentionLoadedFor(ProjectId))" Height="min-h-[44px]" Label="Loading retention terms">
                    @if (Retention.RetentionFor(ProjectId) is { } terms)
                    {
                        <p class="text-sm text-content-muted py-2">
                            @PctText(terms.RetentionPercent) held · @PctText(terms.CompletionReleasePercent) releases at
                            practical completion@(terms.PracticalCompletionAt is { } pc ? $" ({pc:dd MMM yyyy})" : " — date not set")
                        </p>
                    }
                    else
                    {
                        <p class="text-sm text-warning py-2">
                            No retention terms recorded — this claim will hold 0%. Record them in project setup first.
                        </p>
                    }
                    </LoadGate>
                </div>
                @* Valuations stack month on month, so the new period ALWAYS starts from the last
                   claim's cumulative percentages — stated as fact, not offered as a choice. *@
                @if (LatestClaim is not null)
                {
                    <p class="text-sm text-content-muted"
                       title="Copies each line's cumulative % complete from @LatestClaim.DisplayName, so this period starts where the last one left off and only movement needs entering.">
                        Starts from @(LatestClaim.DisplayName)'s percentages — only movement needs entering.
                    </p>
                }
            </div>
        </Modal>

        <Modal IsOpen="@showRename"
               Title="Rename claim"
               ConfirmLabel="@(busy ? "Saving…" : "Save name")"
               OnCancel="@(() => showRename = false)"
               OnConfirm="SaveRenameAsync"
               Class="max-w-md">
            <div class="space-y-3">
                <p class="text-sm text-content">
                    Name the period this claim values — it shows everywhere the claim does.
                    Leave blank to fall back to "Claim @(Selected?.ClaimNumber)".
                </p>
                <FormField Label="Period name" Value="@renameValue" OnChange="@(v => renameValue = v)" />
            </div>
        </Modal>

        <Modal IsOpen="@showDeleteClaim"
               Title="Delete claim"
               ConfirmLabel="@(busy ? "Deleting…" : "Delete claim")"
               OnCancel="@(() => showDeleteClaim = false)"
               OnConfirm="DeleteClaimAsync"
               Class="max-w-md">
            <div class="space-y-2 text-sm text-content">
                <p>
                    Delete <span class="font-medium">@(Selected?.DisplayName)</span> and its per-line
                    % complete entries? This can't be undone.
                </p>
                <p class="text-content-subtle">
                    Valuation invoices and report snapshots keep their amounts and history — only
                    their link to this claim is cleared. Certified to date does not move.
                </p>
            </div>
        </Modal>

        <Modal IsOpen="@showConfirmNudge"
               Title="No invoice issued yet"
               ConfirmLabel="@(busy ? "Confirming…" : "Confirm anyway")"
               OnCancel="@(() => showConfirmNudge = false)"
               OnConfirm="ConfirmAsync"
               Class="max-w-md">
            <div class="space-y-2 text-sm text-content">
                <p>
                    No valuation invoice drawn against <span class="font-medium">@(Selected?.DisplayName)</span>
                    has been issued yet, so certified to date won't reflect this claim.
                </p>
                <p class="text-content-subtle">
                    The usual order is: raise &amp; send the invoice, record the approval, issue it,
                    then confirm the claim once the client pays. You can still confirm now and
                    sort the invoice out afterwards.
                </p>
            </div>
        </Modal>
    </ProjectPageShell>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    // Session checked and the user is signed in. This is NOT "the report is here" — keeping the
    // two apart is the point: the heading and the New claim button show at once, each panel holds
    // until everything behind it can be shown together.
    private bool sessionReady;
    private bool busy;
    private bool showStartClaim;
    private bool showLineForm;
    private bool showClientReferences;
    private string selectedClaimId = "";
    private ValuationLineItem? editingLine;

    // Certification runs GROSS of the deposit: each issued/paid invoice's cash amount plus
    // the deposit credit embedded in it. Both figures come from our own invoice list, which
    // the invoices section keeps fresh via OnInvoicedToDateChanged below.
    private IEnumerable<ValuationInvoice> CertifiableInvoices => (projectInvoices ?? Array.Empty<ValuationInvoice>())
        .Where(invoice => invoice.Status is ValuationInvoiceStatus.Issued or ValuationInvoiceStatus.Paid);

    private decimal CertifiedToDateGross => CertifiableInvoices.Sum(invoice => invoice.CertifiedAmount);

    private decimal DepositCreditedToDate => CertifiableInvoices.Sum(invoice => invoice.DepositCredited);

    // Fired by the invoices section on every reload — keep our copy of the invoice list in
    // step so the claim card's stage (invoice raised? issued? paid?) and the certified
    // figures track reality. The raw total is superseded by CertifiedToDateGross above.
    private async Task OnInvoicedToDateChanged(decimal total)
    {
        await RefreshInvoicesAsync();
        StateHasChanged();
    }

    // ---- Claim stage (drives the card's hint, primary button and stepper) ---
    // Nullable on purpose. No invoices yet is a real answer — it puts the claim at "awaiting
    // invoice" — so "not fetched yet" has to be a state the card can tell apart.
    private IReadOnlyList<ValuationInvoice>? projectInvoices;

    // A failed fetch must open the gate, or the jewel pulses forever; the stage then falls back
    // to the claim status alone, as it always did.
    private bool invoicesFailed;

    // -- Panel gates. Each lists every source the panel reads, so it appears in one piece. --
    private bool ClaimReady =>
        Store.ReportLoadedFor(ProjectId) && (projectInvoices is not null || invoicesFailed);

    private bool ReportReady => Store.ReportLoadedFor(ProjectId) && CostCenters.IsLoaded;

    private async Task RefreshInvoicesAsync()
    {
        try { projectInvoices = await Invoices.ListAsync(ProjectId); }
        catch { invoicesFailed = true; /* stage falls back to claim status alone */ }
    }

    // The live invoice drawn against this claim (latest wins; cancelled ones don't count).
    private ValuationInvoice? InvoiceFor(ValuationClaim claim) => (projectInvoices ?? Array.Empty<ValuationInvoice>())
        .Where(invoice => invoice.ValuationClaimId == claim.ValuationClaimId
                          && invoice.Status != ValuationInvoiceStatus.Cancelled)
        .OrderByDescending(invoice => invoice.Number)
        .FirstOrDefault();

    // One stage per invoice status, so the card can always name the ONE most likely next
    // action — the FD's whole flow (send → approve → issue → paid) runs off this panel
    // instead of the row dropdown in Valuation Invoices below.
    private enum ClaimStage { Draft, AwaitingInvoice, InvoiceDraft, AwaitingApproval, ApprovedAwaitingIssue, InvoiceRejected, AwaitingPayment, ReadyToConfirm, Confirmed }

    private ClaimStage StageFor(ValuationClaim claim)
    {
        if (claim.Status == ValuationClaimStatus.Confirmed) return ClaimStage.Confirmed;
        if (claim.Status == ValuationClaimStatus.Draft) return ClaimStage.Draft;
        var invoice = InvoiceFor(claim);
        if (invoice is null) return ClaimStage.AwaitingInvoice;
        return invoice.Status switch
        {
            ValuationInvoiceStatus.Paid => ClaimStage.ReadyToConfirm,
            ValuationInvoiceStatus.Issued => ClaimStage.AwaitingPayment,
            ValuationInvoiceStatus.Approved => ClaimStage.ApprovedAwaitingIssue,
            ValuationInvoiceStatus.Submitted => ClaimStage.AwaitingApproval,
            ValuationInvoiceStatus.Rejected => ClaimStage.InvoiceRejected,
            _ => ClaimStage.InvoiceDraft // Raised — a draft that was never sent (legacy, or a manually added invoice)
        };
    }

    private string StageHint(ValuationClaim claim)
    {
        var invoice = InvoiceFor(claim);
        return StageFor(claim) switch
        {
            ClaimStage.Draft =>
                "Set each line's cumulative % complete (Bulk edit % handles many at once), then lock the claim.",
            ClaimStage.AwaitingInvoice =>
                $"Locked — {Money(claim.TotalWorksComplete)} works complete. One click raises the invoice for the amount due and sends the claim to the architect/client.",
            ClaimStage.InvoiceDraft =>
                $"Invoice {invoice?.DisplayNumber} drafted for {Money(invoice?.Amount ?? 0m)} but not sent — send the claim, or issue it directly from Actions if this client runs no approval loop.",
            ClaimStage.AwaitingApproval =>
                $"Claimed — invoice {invoice?.DisplayNumber} for {Money(invoice?.Amount ?? 0m)} is with the architect/client{(invoice?.SubmittedAt is { } sub ? $" since {sub:dd MMM yyyy}" : "")}. Record their approval (or rejection, in Actions) when it comes.",
            ClaimStage.ApprovedAwaitingIssue =>
                $"Approved — issue invoice {invoice?.DisplayNumber} to count it toward certified to date, then raise it in the accounts as usual.",
            ClaimStage.InvoiceRejected =>
                $"Invoice {invoice?.DisplayNumber} was rejected{(invoice?.RejectedAt is { } rej ? $" on {rej:dd MMM yyyy}" : "")} — amend it (back to draft, ready to resend), or cancel it in Valuation Invoices below.",
            ClaimStage.AwaitingPayment =>
                $"Invoice {invoice?.DisplayNumber} issued for {Money(invoice?.Amount ?? 0m)} — payment is no gate: carry on with the next claim and record the payment (Actions) when the cash lands.",
            ClaimStage.ReadyToConfirm =>
                $"Invoice {invoice?.DisplayNumber} is paid — confirm to lock this period as the baseline and roll into the next.",
            ClaimStage.Confirmed =>
                $"Confirmed{(claim.ConfirmedAt is { } at ? $" on {at:dd MMM yyyy}" : "")} — this claim is the baseline the next period starts from.",
            _ => ""
        };
    }

    private sealed record ClaimStep(int Index, string Label, bool Done, bool Current);

    private IEnumerable<ClaimStep> StepsFor(ValuationClaim claim)
    {
        var locked = claim.Status != ValuationClaimStatus.Draft;
        var invoice = InvoiceFor(claim);
        // A rejected invoice reads as "not claimed": the Claim step lights up again, which is
        // exactly where the FD is — amend and resend. Issued-without-approval marks Approve
        // done implicitly; the audit trail keeps the distinction.
        var claimed = invoice is { Status: ValuationInvoiceStatus.Submitted or ValuationInvoiceStatus.Approved or ValuationInvoiceStatus.Issued or ValuationInvoiceStatus.Paid };
        var approved = invoice is { Status: ValuationInvoiceStatus.Approved or ValuationInvoiceStatus.Issued or ValuationInvoiceStatus.Paid };
        var invoiced = invoice is { Status: ValuationInvoiceStatus.Issued or ValuationInvoiceStatus.Paid };
        var paid = invoice is { Status: ValuationInvoiceStatus.Paid };
        var confirmed = claim.Status == ValuationClaimStatus.Confirmed;
        yield return new(1, "Value & lock", locked, !locked);
        yield return new(2, "Claim", claimed || confirmed, locked && !claimed && !confirmed);
        yield return new(3, "Approve", approved || confirmed, claimed && !approved && !confirmed);
        yield return new(4, "Invoice", invoiced || confirmed, approved && !invoiced && !confirmed);
        yield return new(5, "Paid", paid || confirmed, invoiced && !paid && !confirmed);
        yield return new(6, "Confirm & roll over", confirmed, paid && !confirmed);
    }

    private static string ClaimBadgeClass(ValuationClaimStatus status)
    {
        const string baseClass = "inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium ";
        return status switch
        {
            ValuationClaimStatus.Preapproved => baseClass + "bg-warning/10 border-warning/30 text-warning",
            ValuationClaimStatus.Confirmed => baseClass + "bg-positive/10 border-positive/30 text-positive",
            _ => baseClass + "bg-surface-raised border-line text-content-muted"
        };
    }

