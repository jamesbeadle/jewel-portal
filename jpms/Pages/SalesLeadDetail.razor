@page "/sales/leads/{LeadId}"
@using Jewel.JPMS.Contracts.Sales
@using Jewel.JPMS.Features.Sales
@using Jewel.JPMS.Features.Triage.Panels
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject LeadDetailReadModel Detail
@inject SalesStrategyListReadModel Strategies
@implements IDisposable

<PageTitle>@(Lead?.Reference ?? "Lead") · JPMS</PageTitle>

@*
    Moves along the open ladder are the sales team's; Lost (with a reason) and Nurture are the
    directors'; Won is its own button, directors only, because it creates the Client account and
    the project shell in one move and cannot be undone from here. Delete (2026-09-15) is the
    directors' too, never on a Won lead — for a mistaken capture or a duplicate; a real lead that
    went nowhere is Lost.
*@

<Page OpenTo="SalesRoles.Readers">
    @if (!Detail.LoadedFor(LeadId) && !dataFailed)
    {
        <LoadGate IsLoading="true" Prominent="true" Label="Loading lead" />
    }
    else if (Lead is null)
    {
        <WorkspaceSectionNav />
        <div class="panel p-6">
            <p class="text-sm text-content-muted">
                @(dataFailed ? "The lead couldn't be loaded — the error banner has the detail. Reload the page to retry." : "There is no lead with that id.")
                <a href="/sales/leads" class="text-info underline underline-offset-4 ml-1">Back to leads</a>
            </p>
        </div>
    }
    else
    {
        var lead = Lead;
        var detail = Current!;
        <div>
            <WorkspaceSectionNav />
            <LeadPageHeader Lead="@lead" HasAcceptedProposal="@Proposals.Any(proposal => proposal.Status == SalesProposalStatus.Accepted)"
                            OnWin="() => winOpen = true" OnEdit="() => editOpen = true" OnLog="() => logOpen = true" OnDelete="() => deleteOpen = true" />

            @if (actionNote is not null)
            {
                <Notice Tone="Tone.Positive" Class="mb-4">@actionNote</Notice>
            }

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
                    <LeadDetailsPanel Lead="@lead" />

                    @if (!string.IsNullOrWhiteSpace(lead.Notes))
                    {
                        <Panel Title="Notes">
                            <p class="text-sm text-content-muted whitespace-pre-wrap">@lead.Notes</p>
                        </Panel>
                    }

                    @* The enquiry's pricing (2026-09-15): the estimates opened on the lead, and the
                       enquiry mail read live by the lead's tag — filed from the Control Centre's
                       Sales pane, never from here (a lead has no project). *@
                    <LeadEstimatesPanel LeadId="@LeadId" Estimates="@Estimates" CanWork="@CanWork" OnChanged="ReloadAsync" />
                    <LeadHouseModelSection Estimates="@Estimates" />
                    <Panel BodyClass="p-5">
                        <RecordCorrespondenceSection Type="RecordType.Lead" RecordId="@LeadId" RecordReference="@lead.Reference"
                                                     ProjectId="" Title="Enquiry emails">
                            <EmptyMessage>
                                No emails filed to @lead.Reference yet. Open the enquiry in the Control Centre and tag it to this lead on the Sales pane — the email then reads here, live.
                            </EmptyMessage>
                        </RecordCorrespondenceSection>
                    </Panel>

                    @* The journey after identification (2026-09-06): the QR-coded imagine link and
                       its rounds, then the proposals — acceptance there is what Won builds on. *@
                    <LeadImaginePanel LeadId="@LeadId" LeadReference="@lead.Reference" Imagine="@detail.Imagine" CanWork="@CanWork" OnChanged="ReloadAsync" />
                    <LeadProposalsPanel LeadId="@LeadId" ContactEmail="@lead.ContactEmail" Proposals="@Proposals" Concepts="@Concepts"
                                        CanWork="@CanWork" CanDecide="@CanDecide" OnChanged="ReloadAsync" />

                    <LeadTimelinePanel Activities="@Activities" />
                </div>

                <div class="space-y-6">
                    <LeadStageLadder Stage="@lead.Stage" CanWork="@CanWork" CanDecide="@CanDecide" OnMove="stage => moveTo = stage" />
                </div>
            </div>
        </div>

        <LeadFormModal IsOpen="@editOpen" Existing="@lead" Strategies="@Strategies.Current" OnSaved="OnEditedAsync" OnCancel="() => editOpen = false" />

        <LeadStageMoveDialog Target="@moveTo" LeadId="@LeadId" OnMoved="OnMovedAsync" OnCancel="() => moveTo = null" />
        <LeadWinDialog IsOpen="@winOpen" Lead="@lead" OnWon="OnWonAsync" OnCancel="() => winOpen = false" />
        <LeadDeleteDialog IsOpen="@deleteOpen" Detail="@detail" OnDeleted="OnDeleted" OnCancel="() => deleteOpen = false" />
        <LeadActivityLogDialog IsOpen="@logOpen" LeadId="@LeadId" OnLogged="OnLoggedAsync" OnCancel="() => logOpen = false" />
    }
</Page>
