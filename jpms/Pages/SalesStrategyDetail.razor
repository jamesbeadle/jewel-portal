@page "/sales/strategies/{StrategyId}"
@using Jewel.JPMS.Contracts.Sales
@using Jewel.JPMS.Features.Sales
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject SalesStrategyDetailReadModel Detail
@inject SalesStrategyListReadModel Strategies
@inject ICommandSender Commands
@implements IDisposable

<PageTitle>@(Strategy?.Name ?? "Strategy") · JPMS</PageTitle>

@*
    One sales strategy (2026-09-06): the argument, the approach plan — drafted by Claude from the
    argument or written by hand — the funnel its leads make, and those leads. Status (Draft /
    Active / Paused / Retired) is the directors' call. Edits are modals.
*@

<Page>
    @if (!Detail.LoadedFor(StrategyId) && !dataFailed)
    {
        <LoadGate IsLoading="true" Prominent="true" Label="Loading strategy" />
    }
    else if (Strategy is null)
    {
        <WorkspaceSectionNav />
        <div class="panel p-6">
            <p class="text-sm text-content-muted">
                @(dataFailed ? "The strategy couldn't be loaded — the error banner has the detail. Reload the page to retry." : "There is no strategy with that id.")
                <a href="/sales/strategies" class="text-info underline underline-offset-4 ml-1">Back to strategies</a>
            </p>
        </div>
    }
    else
    {
        var strategy = Strategy;
        <div>
            <WorkspaceSectionNav />
            <StrategyPageHeader Strategy="@strategy" IsBusy="@busy" OnStatusChosen="SetStatusAsync" OnEdit="() => editOpen = true"
                                OnResearch="RunResearchAsync" OnAddLead="() => addLeadOpen = true" />

            @if (actionError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-4">@actionError</Notice>
            }

            <StrategyResearchStatusNotice Strategy="@strategy" />
            <StrategyFunnelTiles Funnel="@Funnel" />

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
                    @if (!string.IsNullOrWhiteSpace(strategy.ResearchFindings))
                    {
                        <Panel Title="Research findings">
                            <SimpleMarkdown Text="@strategy.ResearchFindings" />
                            @if (strategy.ResearchCompletedAt is { } researchedAt)
                            {
                                <p class="text-xs text-content-faint mt-4">Researched by Claude @DateTimeText(researchedAt.ToLocalTime()). Every figure carries its source; check the ones a decision rests on.</p>
                            }
                        </Panel>
                    }

                    <StrategyApproachPlanPanel Strategy="@strategy" IsBusy="@busy" IsGenerating="@generating"
                                               OnEditPlan="OpenPlanEdit" OnGenerate="OpenGenerate" />
                    <StrategyLeadsPanel Leads="@Leads" />
                </div>

                <div class="space-y-6">
                    <StrategyArgumentPanel Strategy="@strategy" />
                    <StrategyFunnelPanel Funnel="@Funnel" />
                </div>
            </div>
        </div>

        <StrategyFormModal IsOpen="@editOpen" Existing="@strategy" OnSaved="OnEditedAsync" OnCancel="() => editOpen = false" />

        <LeadFormModal IsOpen="@addLeadOpen" Strategies="@StrategyOptionsList" FixedStrategyId="@StrategyId"
                       OnSaved="OnLeadAddedAsync" OnCancel="() => addLeadOpen = false" />

        <StrategyPlanEditDialog IsOpen="@planEditOpen" Strategy="@strategy" OnSaved="OnPlanSavedAsync"
                                OnFailed="message => actionError = message" OnCancel="() => planEditOpen = false" />
        <StrategyPlanGenerateDialog IsOpen="@generateOpen" HasPlan="@(!string.IsNullOrWhiteSpace(strategy.ApproachPlan))"
                                    OnGenerate="GenerateAsync" OnCancel="() => generateOpen = false" />
    }
</Page>
