    /// <summary>The form, as the model will read it. Field names and TYPES match
    /// ModalCatalog.VariationDraft exactly — that is the contract between the dialog and the tool's
    /// input schema, and a value it reads as a string but is told to send as a number is the one
    /// place the two could quietly disagree.</summary>
    private string SerialiseDraft() => JsonSerializer.Serialize(new
    {
        title = draftVariationTitle,
        description = draftVariationDescription,
        estimatedValue = ParsedDraftValue(),
        trade = DraftPackageTrade,
        lines = draftVariationLines.Select(row => new
        {
            description = row.Line.Description,
            unit = row.Line.Unit,
            quantity = row.Line.Quantity,
            trade = row.Line.Trade,
            costCode = row.CostCode,
            accepted = row.Accepted
        })
    });

    /// <summary>The value box as a number, or null when it is blank or not one — never a string, so
    /// the model is not shown "" where its own schema says number.</summary>
    private decimal? ParsedDraftValue()
    {
        if (string.IsNullOrWhiteSpace(draftVariationValue)) return null;
        var raw = draftVariationValue.Replace("£", "").Replace(",", "").Trim();
        return decimal.TryParse(raw, out var parsed) && parsed >= 0 ? parsed : null;
    }

    /// <summary>
    /// The assistant cannot answer — unkeyed environment, or the API failed. The dialog was opened
    /// blank on the promise of a draft, so it now fills itself in from the record: back to exactly
    /// what the user got before any of this existed. Only when it is still untouched — a draft the
    /// user has started typing is theirs, and must not be overwritten by a fallback.
    /// </summary>
    private void HandleAssistantUnavailable() =>
        _ = InvokeAsync(() =>
        {
            if (record is null || !IsDraftBlank) return;
            draftVariationTitle = record.Title;
            draftVariationDescription = record.Description;
            PublishDraft();
            StateHasChanged();
        });

    private void HandleAssistantDraft(string fieldsJson) =>
        _ = InvokeAsync(() =>
        {
            ApplyAssistantDraft(fieldsJson);
            StateHasChanged();
        });

    /// <summary>
    /// MERGE, never replace. Only the fields the assistant actually sent are touched, so an edit the
    /// user made to a field it did not mention survives — which is the entire reason it is shown the
    /// live values in the first place. A malformed payload changes nothing.
    /// </summary>
    private void ApplyAssistantDraft(string fieldsJson)
    {
        var changed = new HashSet<string>();

        try
        {
            using var document = JsonDocument.Parse(fieldsJson);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object) return;

            if (ReadText(root, "title") is { } title && !string.IsNullOrWhiteSpace(title))
            {
                draftVariationTitle = Clamp(title, MaxVariationTitleChars);
                changed.Add("title");
            }

            if (ReadText(root, "description") is { } description && !string.IsNullOrWhiteSpace(description))
            {
                draftVariationDescription = Clamp(description, MaxVariationDescriptionChars);
                changed.Add("description");
            }

            // Counted as a change even though it has no field of its own on the form: without it, a
            // turn that set only the trade would fall through the "nothing changed" guard below and
            // never republish, so the next turn would still be shown the old one.
            if (ReadText(root, "trade") is { } trade && !string.IsNullOrWhiteSpace(trade))
            {
                draftVariationTrade = trade.Trim();
                changed.Add("trade");
            }

            // A string here is the model ignoring the schema; a zero or a negative is nonsense as a
            // variation value. Both are dropped rather than shown to the user as a figure.
            if (root.TryGetProperty("estimatedValue", out var value)
                && value.ValueKind == JsonValueKind.Number
                && value.TryGetDecimal(out var parsed) && parsed > 0)
            {
                draftVariationValue = parsed.ToString("0.##");
                changed.Add("estimatedValue");
            }

            if (root.TryGetProperty("lines", out var lines) && lines.ValueKind == JsonValueKind.Array)
            {
                draftVariationLines = MergeLines(lines);
                changed.Add("lines");
            }
        }
        catch (JsonException)
        {
            // A malformed argument is the model's problem, not the user's. Leave the form alone.
            return;
        }

        if (changed.Count == 0) return;

        flashedFields = changed;
        PublishDraft();
        RestartFlashTimer();
    }

    /// <summary>
    /// Rebuilds the scope lines from the assistant's list, carrying forward the two decisions the
    /// USER owns — whether a line is ticked, and which cost centre it lands on — for any line whose
    /// description it recognises.
    /// </summary>
    private List<DraftLineRow> MergeLines(JsonElement lines)
    {
        var existing = draftVariationLines.ToList();
        var merged = new List<DraftLineRow>();

        foreach (var item in lines.EnumerateArray())
        {
            if (item.ValueKind != JsonValueKind.Object) continue;

            var description = ReadText(item, "description");
            if (string.IsNullOrWhiteSpace(description)) continue;

            var quantity = item.TryGetProperty("quantity", out var q)
                && q.ValueKind == JsonValueKind.Number
                && q.TryGetDecimal(out var parsedQuantity) && parsedQuantity > 0
                    ? parsedQuantity
                    : 1m;

            var line = new VoqDraftLine(
                ReadText(item, "trade") ?? "",
                description.Trim(),
                ReadText(item, "unit") ?? "item",
                quantity);

            var previous = existing.FirstOrDefault(row =>
                string.Equals(row.Line.Description.Trim(), description.Trim(), StringComparison.OrdinalIgnoreCase));

            merged.Add(previous is not null
                ? previous with { Line = line }
                : new DraftLineRow(line, true, ResolveCostCode(ReadText(item, "costCode"))));
        }

        return merged;
    }

    /// <summary>
    /// A suggested cost code counts only if it is one the portal actually has, spelled exactly.
    /// Anything else is dropped in silence and the user picks from the list — a hallucinated code
    /// would send a real committed value to the wrong cost centre and go unnoticed for a month.
    /// </summary>
    private string ResolveCostCode(string? suggested)
    {
        if (string.IsNullOrWhiteSpace(suggested)) return "";
        var match = CostCenters.Alphabetical.FirstOrDefault(centre =>
            string.Equals(centre.Code, suggested.Trim(), StringComparison.OrdinalIgnoreCase));
        return match?.Code ?? "";
    }

    private static string? ReadText(JsonElement element, string property) =>
        element.TryGetProperty(property, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private static string Clamp(string value, int max)
    {
        var trimmed = value.Trim();
        return trimmed.Length > max ? trimmed[..max] : trimmed;
    }

    // Roughly the length of the .jpms-flash keyframe. The pulse marks what moved; leaving it on
    // would just be decoration.
    private void RestartFlashTimer()
    {
        flashTimer?.Dispose();
        flashTimer = new System.Threading.Timer(_ => InvokeAsync(() =>
        {
            flashedFields = new HashSet<string>();
            StateHasChanged();
        }), null, TimeSpan.FromMilliseconds(1600), Timeout.InfiniteTimeSpan);
    }

    private async Task OnPartyChanged(ChangeEventArgs e)
    {
        if (record is null || busy) return;
        ladderError = null;

        var selection = e.Value?.ToString() ?? "";
        var partyKind = PartyKind.Client;
        string? partyId = null;
        string? onBehalfOfClientId = null;

        if (selection.StartsWith(ArchitectPrefix, StringComparison.Ordinal))
        {
            partyKind = PartyKind.Architect;
            partyId = selection[ArchitectPrefix.Length..];
            // Keep the recorded on-behalf-of client when switching between architects.
            onBehalfOfClientId = record.OnBehalfOfClientId;
        }
        else if (selection.StartsWith(ClientPrefix, StringComparison.Ordinal))
        {
            partyId = selection[ClientPrefix.Length..];
        }

        try
        {
            busy = true;
            record = await RequestRegister.LinkToPartyAsync(record.RequestId, partyKind, partyId, onBehalfOfClientId, ProjectId);
            await LoadRecipientPreviewAsync();
        }
        catch
        {
            ladderError = "Couldn't update the linked party. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

