@page "/projects/{ProjectId}/requests/view/{RequestId}"
@using System.Text.Json
@using Jewel.JPMS.Contracts.Ai
@using Jewel.JPMS.Contracts.Requests
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Contracts.Variations
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.RecordLinks
@implements IDisposable
@inject AuthService Auth
@inject ICommandSender Commands
@inject CostCentersReadModel CostCenters
@inject SessionService Session
@inject IRequestRegister RequestRegister
@inject RecordActivityReadModel Activity
@inject IClientStore ClientStore
@inject IArchitectStore ArchitectStore
@inject ICorrespondenceStore Correspondence
@inject IVariationStore Variations
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ChatPanelState Chat
@inject AiTaskState AiTasks

<PageTitle>Request · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!dataLoaded)
{
    @* Tab chrome first, the record when it lands. The whole body reads off the record, the
       variation and its bid packages, so it waits for the lot rather than filling in around a
       lineage bar that still says "no variation". *@
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading request" />
    </ProjectPageShell>
}
else if (record is null)
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        <p class="text-sm text-content-subtle italic">That request could not be found.</p>
        <a href="@RegisterHref" class="btn-neutral mt-4">Back to register</a>
    </ProjectPageShell>
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        <a href="@RegisterHref" class="text-sm text-content-muted hover:text-content inline-flex items-center gap-1 mb-4">
            &larr; Request register
        </a>

        @* Title bar. Everything that acts on this request is up here with the record it acts on:
           the identity and status on the left, one primary action plus a single Actions menu on the
           right. No panel below carries an action on the request any more — the page used to
           scatter them down the column (four separate "Edit" links, the promote button), so finding
           one meant scanning the whole page. The only buttons left in the body belong to a
           different record (the variation card) or to an open editor (the form's Save / Cancel). *@
        <header class="panel px-5 py-4 mb-5">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2.5 mb-1.5">
                        @* Lead with the official instrument number (RFI-014) once promoted; the REQ
                           container number is secondary context (it names the request's folder in
                           the projects mailbox). *@
                        <span class="font-mono text-base font-semibold text-content" title="@record.Kind.LongName()">@PrimaryReference</span>
                        @if (ShowContainerNumber)
                        {
                            <span class="font-mono text-sm text-content-muted" title="Container number — the request's folder in the projects mailbox">@record.DisplayNumber</span>
                        }
                        <span class="text-content-subtle text-xs uppercase tracking-wide" title="@record.Kind.LongName()">@record.Kind.DisplayName()</span>

                        <span class="h-4 w-px bg-line" aria-hidden="true"></span>

                        @if (CanEditDetails)
                        {
                            @* The status pill doubles as the status control: click it, pick the new
                               status. Closed routes through its existing flow (close confirm with
                               date + agent gate) — everything else applies directly. *@
                            <DropdownMenu AlignLeft="true" WidthClass="w-48" Disabled="@busy"
                                          ToggleTitle="Change status"
                                          ToggleClass="@($"inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] font-medium {StatusClass(record.Status)}")"
                                          Items="StatusMenuItems">
                                <ToggleContent><span>@record.Status.DisplayName()</span></ToggleContent>
                            </DropdownMenu>
                        }
                        else
                        {
                            <span class="inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] font-medium @StatusClass(record.Status)">@record.Status.DisplayName()</span>
                        }
                        @if (record.ImpliesVariation)
                        {
                            <span class="inline-flex items-center rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">Variation</span>
                        }
                        @if (record.CriticalPath)
                        {
                            <span class="inline-flex items-center rounded bg-negative/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-negative"
                                  title="Programme-related — the answer gates work on the programme's critical path">Critical path</span>
                        }
                    </div>
                    <h2 class="text-xl font-semibold text-content leading-snug">@record.Title</h2>
                </div>

                <div class="flex flex-wrap items-center gap-2 shrink-0">
                    @if (record.Kind.IsEmailable() && CanDraftEmail)
                    {
                        <button type="button" class="btn-primary" disabled="@(busy || preparingDraft)" @onclick="OpenEmailModal">
                            Email @record.Kind.DisplayName()
                        </button>
                    }
                    else if (CanEditDetails && record.Kind is not RequestType.Rfi)
                    {
                        @* Nothing to email yet — promoting is the action that unblocks everything
                           else, so it takes the primary slot until it has been done. *@
                        <button type="button" class="btn-primary" disabled="@busy" @onclick="PromoteToRfi">Promote to RFI</button>
                    }
                    <DropdownMenu Label="Actions" WidthClass="w-72" Items="ActionMenuItems" />
                </div>
            </div>
        </header>

        @* The request is the containing object; its related documents sit behind tabs. Request and
           the official stage are panes of THIS page; the variation and bid package tabs carry on
           to those records' own pages, which render the same bar. *@
        <RecordTabBar ProjectId="@ProjectId" ActiveId="@ActiveTabId"
                      Request="record" Variation="variation"
                      LocalRequestTabs="true" OnSelect="SetActiveTab"
                      ActivityFor="TabActivity" />

        @* At-a-glance facts run across the top rather than down a rail, so the columns below are
           left for the substance: the request itself on the left, actions on the right. *@
        <div class="panel px-5 py-4 mb-5">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-3 text-sm">
                <MetaCell Label="Raised by" Value="@record.RaisedByEmail" />
                @* Issued is the official date the correspondent was notified. Rows predating the
                   IssuedAt backfill fall back to the internal created-on stamp rather than a dash. *@
                <MetaCell Label="Issued" Value="@Date(record.IssuedAt ?? record.RaisedAt)" />
                <MetaCell Label="Response due" Value="@Date(record.ResponseDue)" />
                <div>
                    <p class="text-[10px] uppercase tracking-wide font-semibold text-content-subtle mb-0.5">Days outstanding</p>
                    <p class="@(record.IsOverdue ? "text-negative font-semibold" : "text-content")">@(record.DaysOutstanding is int d ? d.ToString() : "—")</p>
                </div>
                @* A closed record always shows its Closed fact — a legacy close with no recorded
                   date surfaces as a dash rather than hiding, so the gap is visible and fixable
                   (Edit facts requires a date on a closed record). *@
                @if (record.Status is RequestStatus.Closed || record.ClosedAt is not null)
                {
                    <MetaCell Label="Closed" Value="@Date(record.ClosedAt)" />
                }
                <MetaCell Label="Drawing / detail" Value="@Dash(record.DrawingRef)" />
                <MetaCell Label="Related drawing / spec" Value="@Dash(record.RelatedDrawingSpec)" />
                @if (record.Kind is not RequestType.Rfi)
                {
                    <MetaCell Label="Value" Value="@(record.Value is null ? "—" : Money(record.Value.Value))" />
                }
                @* The system's own stamp, distinct from the official Issued date — when this record
                   was created in the register. Not editable; Issued is the date that is. *@
                <MetaCell Label="Created" Value="@Date(record.RaisedAt)" />
            </div>
        </div>

        @* Outcomes of header actions (close/reopen/response/triage/delete) surface here, under the
           facts strip, now that the Manage panel is gone. *@
        @if (actionError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-5">@actionError</p>
        }
        @* The two-week critical-path nudge: an RFI still outstanding after a fortnight is usually
           gating programme work. Yes tags it (same command as the Actions-menu toggle); No records
           the decision on the request so the banner never re-asks anyone about this RFI. *@
        @if (ShowCriticalPathNudge)
        {
            <div class="rounded-lg bg-amber-500/10 border border-amber-500/30 px-3 py-2 mb-5 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <div>
                    <p class="text-sm font-medium text-amber-700">RFI 2 weeks old — tag as critical path?</p>
                    <p class="text-xs text-content-subtle">Outstanding @record.DaysOutstanding days. Critical path RFIs surface in the Programme tab, where their answers gate the programme.</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" class="btn-primary text-xs" disabled="@busy" @onclick="() => AnswerCriticalPathNudge(true)">Yes — tag as critical path</button>
                    <button type="button" class="btn-neutral text-xs" disabled="@busy" @onclick="() => AnswerCriticalPathNudge(false)" title="Hides this prompt for this RFI, for everyone — the tag can still be set from the Actions menu">No</button>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <div class="lg:col-span-2 space-y-5">
                @* ---- Request (container) pane: the request's own detail and correspondence ---- *@
                @if (ShowContainerPane)
                {
                <Panel Title="Detail">
                    <p class="text-sm text-content-muted whitespace-pre-wrap leading-relaxed">@(string.IsNullOrWhiteSpace(record.Description) ? "—" : record.Description)</p>
                </Panel>
                }

                @* ---- Official-document pane: the form, the response, and the document's own
                       actions. For an unpromoted General request there is no official tab yet, so
                       the prepared-ahead form simply sits on the container pane as before. ---- *@
                @if (ShowOfficialContent)
                {
                <div class="panel p-5">
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <div>
                            <h3 class="eyebrow">@(record.Kind.IsEmailable() ? $"Official {record.Kind.DisplayName()} form" : "Official form")</h3>
                            <p class="text-xs text-content-subtle mt-0.5">@(record.Kind.IsEmailable()
                                ? "The itemised queries and sections rendered on the issued document."
                                : "Prepared ahead: these sections are carried onto the official document when the request is promoted to an RFI.")</p>
                        </div>
                        @* The document's own actions, grouped: get it out (PDF, email). *@
                        @if (record.Kind.IsEmailable())
                        {
                            <Toolbar>
                                <ToolbarButton Icon="download" Label="@($"Download the {record.Kind.DisplayName()} PDF")"
                                               Href="@DocumentHref" Download="true" />
                                @if (CanDraftEmail)
                                {
                                    <ToolbarButton Icon="email" Label="@($"Email this {record.Kind.DisplayName()}")"
                                                   OnClick="OpenEmailModal" Disabled="@busy" Busy="@preparingDraft" />
                                }
                            </Toolbar>
                        }
                    </div>

                    @if (formError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@formError</p>
                    }

                    @if (!editingForm)
                    {
                        @if (record.ItemList.Count == 0
                            && string.IsNullOrWhiteSpace(record.BasisOfQueries)
                            && string.IsNullOrWhiteSpace(record.ResponseActionRequired)
                            && string.IsNullOrWhiteSpace(record.ImpactIfLate))
                        {
                            <p class="text-sm text-content-subtle italic">No itemised queries yet. The issued document carries the detail above only.</p>
                        }
                        else
                        {
                            @if (record.ItemList.Count > 0)
                            {
                                <div class="overflow-x-auto -mx-1 px-1">
                                    <table class="w-full text-sm">
                                        <thead>
                                            <tr class="text-left text-content-subtle border-b border-line">
                                                <th class="py-2 pr-3 font-medium w-10">Item</th>
                                                <th class="py-2 pr-3 font-medium">Drawing ref</th>
                                                <th class="py-2 pr-3 font-medium">Member / area</th>
                                                <th class="py-2 pr-3 font-medium">Query</th>
                                                <th class="py-2 font-medium">Response</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in record.ItemList)
                                            {
                                                <tr class="border-b border-line last:border-0 align-top">
                                                    <td class="py-2 pr-3 font-mono text-content-muted">@item.Position</td>
                                                    <td class="py-2 pr-3 text-content-muted whitespace-pre-wrap">@Dash(item.DrawingRef)</td>
                                                    <td class="py-2 pr-3 text-content whitespace-pre-wrap">@Dash(item.MemberArea)</td>
                                                    <td class="py-2 pr-3 text-content whitespace-pre-wrap">@Dash(item.Query)</td>
                                                    <td class="py-2 text-content-muted whitespace-pre-wrap">@Dash(item.Response)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(record.BasisOfQueries))
                            {
                                <div class="mt-3">
                                    <h4 class="eyebrow mb-1">Basis of queries</h4>
                                    <p class="text-sm text-content-muted whitespace-pre-wrap">@record.BasisOfQueries</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(record.ResponseActionRequired))
                            {
                                <div class="mt-3">
                                    <h4 class="eyebrow mb-1">Response / action required</h4>
                                    <p class="text-sm text-content whitespace-pre-wrap">@record.ResponseActionRequired</p>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(record.ImpactIfLate))
                            {
                                <div class="mt-3">
                                    <h4 class="eyebrow mb-1">Impact if not received by the required date</h4>
                                    <p class="text-sm text-content-muted whitespace-pre-wrap">@record.ImpactIfLate</p>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="space-y-4">
                            <div>
                                <label class="eyebrow block mb-2">Itemised queries</label>
                                @if (formItems.Count == 0)
                                {
                                    <p class="text-sm text-content-subtle italic mb-2">No items — add the first numbered query below.</p>
                                }
                                <div class="space-y-3">
                                    @{ var itemNumber = 0; }
                                    @foreach (var row in formItems)
                                    {
                                        itemNumber++;
                                        <div class="rounded-lg border border-line p-3 space-y-2">
                                            <div class="flex items-center justify-between">
                                                <span class="font-mono text-xs font-semibold text-content-muted">Item @itemNumber</span>
                                                <button type="button" class="text-xs text-negative hover:underline underline-offset-2" @onclick="() => RemoveFormItem(row)">Remove</button>
                                            </div>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                                <div>
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Drawing ref</label>
                                                    <textarea class="field" rows="2" value="@row.DrawingRef" @oninput="e => row.DrawingRef = e.Value?.ToString() ?? string.Empty"
                                                              placeholder="Dwg 1986_111 Rev D&#10;SD8, SD3"></textarea>
                                                </div>
                                                <div>
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Member / area</label>
                                                    <textarea class="field" rows="2" value="@row.MemberArea" @oninput="e => row.MemberArea = e.Value?.ToString() ?? string.Empty"
                                                              placeholder="West Elevation — lead valley gutter"></textarea>
                                                </div>
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Query</label>
                                                <textarea class="field" rows="3" value="@row.Query" @oninput="e => row.Query = e.Value?.ToString() ?? string.Empty"
                                                          placeholder="Please confirm…"></textarea>
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Response (when received)</label>
                                                <textarea class="field" rows="2" value="@row.Response" @oninput="e => row.Response = e.Value?.ToString() ?? string.Empty"></textarea>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <button type="button" class="btn-secondary mt-2" @onclick="AddFormItem">Add item</button>
                            </div>

                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Basis of queries</label>
                                <textarea class="field" rows="2" value="@formBasis" @oninput="e => formBasis = e.Value?.ToString() ?? string.Empty"
                                          placeholder="Architect's email ref…, site inspection observations, drawings…"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Response / action required</label>
                                <textarea class="field" rows="3" value="@formResponseAction" @oninput="e => formResponseAction = e.Value?.ToString() ?? string.Empty"
                                          placeholder="Please provide written confirmation / instruction on the items above…"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Impact if not received by the required date</label>
                                <textarea class="field" rows="2" value="@formImpact" @oninput="e => formImpact = e.Value?.ToString() ?? string.Empty"
                                          placeholder="Works cannot proceed, risking programme delay while scaffold remains in place…"></textarea>
                            </div>

                            <div class="flex flex-wrap gap-2">
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="SaveForm">@(busy ? "Saving…" : "Save form")</button>
                                <button type="button" class="btn-neutral" disabled="@busy" @onclick="CancelFormEdit">Cancel</button>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(record.ResponseText))
                {
                    <div class="panel p-5">
                        <h3 class="eyebrow mb-2">Response</h3>
                        <p class="text-sm text-content whitespace-pre-wrap">@record.ResponseText</p>
                        @if (!string.IsNullOrWhiteSpace(record.RespondedByEmail))
                        {
                            <p class="text-xs text-content-subtle mt-2">@record.RespondedByEmail · @Date(record.RespondedAt)</p>
                        }
                    </div>
                }
                }

                @if (ShowContainerPane)
                {
                @* Per-message reply drafting is off: emailing the document (fresh or into a tagged
                   chain) is consolidated behind the single Email button in the page header. *@
                @* Drawings linked from the register and photos taken on site. Uploaded files ride
                   out on the RFI email; linked drawings do not — the architect issued those, and
                   the document already cites them by code and revision. *@
                <RequestAttachmentsPanel ProjectId="@ProjectId" RequestId="@RequestId" CanEdit="@CanEditDetails" />

                <RequestConversation RequestId="@RequestId" CanDraftReply="false"
                                     RequestReference="@record?.Reference" />

                @if (!HasOfficialTab)
                {
                @* The record's own audit slice. Its main job here is answering "did the document go
                   out?" — every draft the portal creates writes a row the moment it lands in the
                   projects mailbox, with a link that opens that draft in Outlook. Sent is never
                   observable from code (a human presses Send), so "drafted" is the honest signal. *@
                <RecordAuditHistory RecordId="@RequestId"
                                    RecordType="Jewel.JPMS.Models.RecordType.Request"
                                    Title="History" />
                }
                }
            </div>

            <div class="space-y-5">
                @if (ShowContainerPane && HasOfficialTab)
                {
                    @* On a promoted record the container pane's rail carries the audit slice; the
                       issue machinery (recipients, variation) lives with the official document. *@
                    <RecordAuditHistory RecordId="@RequestId"
                                        RecordType="Jewel.JPMS.Models.RecordType.Request"
                                        Title="History" />
                }

                @if (ShowOfficialContent)
                {
                @* Document + email actions live with the official form; this rail panel is just the
                   record's shape — its type (with promotion) and who it corresponds with. Hidden
                   entirely when there is nothing to show (official kind, no edit rights). *@
                @if (!record.Kind.IsEmailable() || CanEditDetails)
                {
                <div class="panel p-5 space-y-3">
                    <h3 class="eyebrow">Request type &amp; recipients</h3>
                    @if (!record.Kind.IsEmailable())
                    {
                        <p class="text-sm text-content-subtle">
                            A @record.Kind.DisplayName() request is the pre-official stage — there is no
                            official document yet and nothing is emailed. Promoting it to an RFI mints the
                            reference and creates the official document, ready to email when you choose.
                        </p>
                    }

                    @if (CanEditDetails)
                    {
                        <div class="space-y-4">
                        <p class="text-sm text-content">
                            Current: <span class="font-medium">@record.Kind.DisplayName()</span>
                            @if (record.HasRfq)
                            {
                                <span class="ml-2 inline-flex items-center rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">RFQ enabled</span>
                            }
                        </p>

                        @if (ladderError is not null)
                        {
                            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@ladderError</p>
                        }

                        @if (record.Kind is not RequestType.Rfi)
                        {
                            @* The button itself is in the title bar (primary slot until there is
                               something to email); this just explains what it will do. *@
                            <p class="text-xs text-content-subtle">Promoting mints the RFI reference and creates the official document — use <span class="text-content font-medium">Promote to RFI</span> at the top of the page. No email is drafted by promotion; when you are ready to issue, the Email button appears in its place.</p>
                        }
                        <div>
                            <label class="eyebrow block mb-1">Issued to</label>
                            <select class="field" value="@PartySelectionValue" @onchange="OnPartyChanged" disabled="@busy">
                                <option value="">— None —</option>
                                @if (clients.Count > 0)
                                {
                                    <optgroup label="Clients">
                                        @foreach (var client in clients)
                                        {
                                            <option value="@($"{ClientPrefix}{client.ClientId}")">@client.Name</option>
                                        }
                                    </optgroup>
                                }
                                @if (architects.Count > 0)
                                {
                                    <optgroup label="Architects">
                                        @foreach (var architect in architects)
                                        {
                                            <option value="@($"{ArchitectPrefix}{architect.ArchitectId}")">@architect.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <p class="text-xs text-content-subtle mt-1">The email an RFI is issued to comes from this party — a client directly, or an architect acting on the client's behalf.</p>
                        </div>

                        @if (record.PartyKind == PartyKind.Architect && !string.IsNullOrEmpty(record.PartyId))
                        {
                            <div>
                                <label class="eyebrow block mb-1">On behalf of client</label>
                                <select class="field" value="@(record.OnBehalfOfClientId ?? "")" @onchange="OnOnBehalfOfClientChanged" disabled="@busy">
                                    <option value="">— Not recorded —</option>
                                    @foreach (var client in clients)
                                    {
                                        <option value="@client.ClientId">@client.Name</option>
                                    }
                                </select>
                                <p class="text-xs text-content-subtle mt-1">Optional: the client this architect is acting for.</p>
                            </div>
                        }

                        @if (recipientPreview is not null)
                        {
                            <div class="rounded-lg bg-surface-raised border border-line px-3 py-2 space-y-1">
                                <p class="text-[10px] uppercase tracking-wide font-semibold text-content-subtle">Draft will be addressed to</p>
                                @if (recipientPreview.To.Count == 0)
                                {
                                    <p class="text-xs text-negative">No correspondent resolves — link a party or set a project contact's routing to To.</p>
                                }
                                else
                                {
                                    <p class="text-xs text-content"><span class="font-medium">To:</span> @RecipientLine(recipientPreview.To)</p>
                                }
                                @if (recipientPreview.Cc.Count > 0)
                                {
                                    <p class="text-xs text-content"><span class="font-medium">CC:</span> @RecipientLine(recipientPreview.Cc)</p>
                                }
                                @if (recipientPreview.Bcc.Count > 0)
                                {
                                    <p class="text-xs text-content"><span class="font-medium">BCC:</span> @RecipientLine(recipientPreview.Bcc)</p>
                                }
                                <p class="text-[10px] text-content-subtle">From the project's correspondence profile (Setup tab). BCC never appears on the document or the shared trail.</p>
                            </div>
                        }
                        </div>
                    }
                </div>
                }

                @* Any RFI can raise a variation order quote — an architect answering "yes, do it"
                   is the ordinary way one starts, with no subcontractor tender involved. The RFQ
                   flag is not the gate; it only decides whether bid packages hang off the
                   variation afterwards. *@
                @if (record.Kind is RequestType.Rfi || record.HasRfq || variation is not null)
                {
                    <div class="panel p-5 space-y-3">
                        <h3 class="eyebrow">Variation</h3>
                        @if (variation is not null)
                        {
                            <p class="text-sm text-content">
                                <span class="font-mono font-semibold">@variation.DisplayNumber</span>
                                <span class="text-content-subtle ml-2">@variation.Status.DisplayName()</span>
                            </p>
                            <a href="@VariationHref" class="btn-secondary w-full inline-flex justify-center">Open variation</a>
                        }
                        else
                        {
                            @if (variationError is not null)
                            {
                                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@variationError</p>
                            }
                            <p class="text-xs text-content-subtle">
                                @(record.HasRfq
                                    ? "This RFI carries an RFQ, so bid packages can go out to subcontractors under the variation."
                                    : "Price the work this RFI has led to.")
                                @if (CanUseAssistant)
                                {
                                    @:The assistant drafts it from this RFI and its tagged emails, in the panel beside the
                                    @:form — talk it through and change anything you like before you raise it.
                                }
                                You decide the title, the value and which lines to keep. It stays in Quoting until the
                                client approves it.
                            </p>
                            @if (CanRaiseVariation)
                            {
                                <button type="button" class="btn-primary w-full" disabled="@busy" @onclick="OpenVariationDraft">Create Variation Order Quote</button>
                            }
                        }
                    </div>
                }
                }

            </div>
        </div>
    </ProjectPageShell>

    <Modal IsOpen="confirmingDelete"
           Title="Delete this request?"
           ConfirmLabel="@(busy ? "Deleting…" : "Delete request")"
           OnCancel="CancelDelete"
           OnConfirm="PerformDelete">
        <p class="text-sm text-content">
            This will permanently remove <span class="font-mono">@record?.Reference</span> — “@record?.Title” — and its entire conversation. This cannot be undone.
        </p>
    </Modal>

    <Modal IsOpen="confirmingReturn"
           Title="Return this request to the Control Centre?"
           ConfirmLabel="@(busy ? "Returning…" : "Return to Control Centre")"
           OnCancel="CancelReturn"
           OnConfirm="PerformReturn">
        <p class="text-sm text-content">
            Every email linked to <span class="font-mono">@record?.Reference</span> — “@record?.Title” — will go back to the Control Centre queue so the thread can be processed again from scratch. The request itself and its conversation history stay in the register.
        </p>
    </Modal>

    <Modal IsOpen="confirmingClose"
           Title="Close this request?"
           ConfirmLabel="@(busy ? "Closing…" : "Close request")"
           OnCancel="CancelClose"
           OnConfirm="PerformClose">
        <div class="space-y-3">
            <p class="text-sm text-content">
                Closes <span class="font-mono">@record?.Reference</span> — “@record?.Title”. If the request was actually resolved earlier, set the date it closed below.
            </p>
            <FormField Label="Date closed" Value="@closeDate" OnChange="v => closeDate = v" InputType="date" />
            @if (closeError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@closeError</p>
            }
        </div>
    </Modal>

    <Modal IsOpen="emailModalOpen"
           Title="@($"Email this {record.Kind.DisplayName()}")"
           ConfirmLabel="@(preparingDraft ? "Creating draft…" : "Create draft")"
           ConfirmDisabled="@preparingDraft"
           ShowFooter="@(draftResult is null)"
           OnCancel="CloseEmailModal"
           OnConfirm="ConfirmEmailDraft"
           Class="max-w-xl">
        <div class="space-y-4">
            @if (draftResult is null)
            {
                <p class="text-sm text-content-subtle">
                    Stages a draft in the projects mailbox with the @record.Kind.DisplayName() PDF attached.
                    Review and send it from Outlook — nothing is sent from here.
                </p>

                <div class="space-y-2">
                    <label class="flex items-start gap-2.5 rounded-lg border p-3 cursor-pointer @(selectedChainMailboxId == "" ? "border-accent bg-accent/5" : "border-line hover:border-line-strong")">
                        <input type="radio" name="email-target" class="mt-0.5" checked="@(selectedChainMailboxId == "")"
                               @onchange="@(() => selectedChainMailboxId = "")" />
                        <span>
                            <span class="block text-sm font-medium text-content">Start a fresh email</span>
                            <span class="block text-xs text-content-subtle mt-0.5">A new thread — To/CC/BCC pre-filled from the project's correspondence profile.</span>
                        </span>
                    </label>

                    <LoadGate IsLoading="@taggedEmailsLoading" Label="Loading tagged emails">
                    @if (taggedEmails.Count == 0)
                    {
                        <p class="text-xs text-content-subtle px-1">No emails are tagged to this request yet, so there is no chain to append to.</p>
                    }
                    else
                    {
                        <p class="eyebrow pt-1">Or append to a tagged email chain</p>
                        @foreach (var email in taggedEmails)
                        {
                            <label class="flex items-start gap-2.5 rounded-lg border p-3 cursor-pointer @(selectedChainMailboxId == email.MailboxId ? "border-accent bg-accent/5" : "border-line hover:border-line-strong")">
                                <input type="radio" name="email-target" class="mt-0.5" checked="@(selectedChainMailboxId == email.MailboxId)"
                                       @onchange="@(() => selectedChainMailboxId = email.MailboxId!)" />
                                <span class="min-w-0">
                                    <span class="block text-sm font-medium text-content truncate">@(string.IsNullOrWhiteSpace(email.Subject) ? Truncate(email.Body, 80) : email.Subject)</span>
                                    <span class="block text-xs text-content-subtle mt-0.5">@AuthorLabel(email) · @email.PostedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm") — reply-all in this thread, the whole chain quoted beneath.</span>
                                </span>
                            </label>
                        }
                    }
                    </LoadGate>
                </div>

                @if (draftError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@draftError</p>
                }
            }
            else
            {
                <div class="rounded-lg bg-emerald-500/10 border border-emerald-500/30 px-3 py-2.5">
                    <p class="text-sm font-medium text-emerald-600">Draft created in the projects mailbox.</p>
                    <p class="text-xs text-content-subtle mt-1">To: @string.Join(", ", draftResult.Recipients)</p>
                    @if (draftResult.Cc is { Count: > 0 } draftCc)
                    {
                        <p class="text-xs text-content-subtle">CC: @string.Join(", ", draftCc)</p>
                    }
                    @if (draftResult.Bcc is { Count: > 0 } draftBcc)
                    {
                        <p class="text-xs text-content-subtle">BCC: @string.Join(", ", draftBcc)</p>
                    }
                    <p class="text-xs text-content-subtle mt-1">Review the recipients and send it from Outlook — nothing has been sent.</p>
                    @if (!string.IsNullOrWhiteSpace(draftResult.WebLink))
                    {
                        <a href="@draftResult.WebLink" target="_blank" rel="noopener"
                           class="text-xs text-accent hover:underline underline-offset-2">Open the draft in Outlook</a>
                    }
                </div>
                <div class="flex justify-end">
                    <button type="button" class="btn-primary" @onclick="CloseEmailModal">Done</button>
                </div>
            }
        </div>
    </Modal>

    <Modal IsOpen="respondingOpen"
           Title="Record a response"
           ConfirmLabel="@(busy ? "Saving…" : "Save response")"
           ConfirmDisabled="@busy"
           OnCancel="CancelResponseModal"
           OnConfirm="SaveResponseFromModal">
        <div class="space-y-3">
            <p class="text-sm text-content-subtle">
                The formal answer or decision recorded on the request itself — it appears in the
                Response panel, prints on the official document, and moves the request to Needs
                action (the ball is back with us). (Use the conversation for ordinary discussion.)
            </p>
            <textarea class="field" rows="4" value="@responseDraft" @oninput="OnResponseDraftInput"
                      placeholder="The answer or decision…"></textarea>
            @if (actionError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
            }
        </div>
    </Modal>

    @* The old single "Edit request details" modal is split three ways, each opened from an Edit
       control on the surface it edits: the page header (reference, status, subject), the facts
       strip (dates, drawing refs, value) and the Detail panel (the detail text). *@
    <Modal IsOpen="editingHeader"
           Title="Edit reference &amp; status"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="CancelHeaderEdit"
           OnConfirm="SaveHeaderEdit"
           Class="max-w-xl">
        <div class="space-y-4">
            @if (editError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@editError</p>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Reference" Value="@editReference" OnChange="v => editReference = v" Required="true" />
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Status</label>
                    <select class="field" value="@((int)editStatus)" @onchange="OnEditStatusChanged">
                        @foreach (var option in StatusOptions)
                        {
                            <option value="@((int)option)">@option.DisplayName()</option>
                        }
                    </select>
                </div>
            </div>

            <FormField Label="Subject" Value="@editTitle" OnChange="v => editTitle = v" Required="true" />

            @if (editStatus == RequestStatus.Closed)
            {
                <FormField Label="Date closed" Value="@editClosedAt" OnChange="v => editClosedAt = v" InputType="date" Required="true" />
            }

            @if (record.Kind is RequestType.Rfi)
            {
                <label class="flex items-start gap-2 text-sm text-content">
                    <input type="checkbox" class="mt-0.5" @bind="editCriticalPath" />
                    <span>Critical path <span class="text-content-subtle">— programme-related; shows under Critical Path RFIs on the Programme tab</span></span>
                </label>
            }
        </div>
    </Modal>

    <Modal IsOpen="editingFacts"
           Title="Edit request facts"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="CancelFactsEdit"
           OnConfirm="SaveFactsEdit"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (editError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@editError</p>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Date issued" Value="@editIssuedAt" OnChange="v => editIssuedAt = v" InputType="date" />
                <FormField Label="Response due" Value="@editResponseDue" OnChange="v => editResponseDue = v" InputType="date" />
                @* Offered on every closed record — including legacy closes that predate the close
                   date and so have none recorded yet. Required while closed: the date is what the
                   frozen Days-out count is computed from. *@
                @if (record.Status is RequestStatus.Closed || record.ClosedAt is not null)
                {
                    <FormField Label="Date closed" Value="@editClosedAt" OnChange="v => editClosedAt = v" InputType="date" Required="true" />
                }
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Drawing / detail ref" Value="@editDrawingRef" OnChange="v => editDrawingRef = v" />
            </div>

            <FormField Label="Related drawing / spec" Value="@editRelatedSpec" OnChange="v => editRelatedSpec = v" />

            @if (record.Kind is not RequestType.Rfi)
            {
                <FormField Label="Value (£, optional)" Value="@editValue" OnChange="v => editValue = v" />
            }
        </div>
    </Modal>

    <Modal IsOpen="editingDetail"
           Title="Edit detail"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="CancelDetailEdit"
           OnConfirm="SaveDetailEdit"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (editError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@editError</p>
            }

            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Detail</label>
                <textarea class="field" rows="6" value="@editDescription" @oninput="OnEditDescriptionInput"></textarea>
            </div>
        </div>
    </Modal>

    @* Worked alongside the assistant, not instead of it: ChatAware reserves the panel's width so
       this dialog centres beside the conversation rather than under it, and the backdrop does not
       dismiss — a stray click must not throw away a drafted variation and the exchange that
       produced it. The X and Cancel still close it, and both keep the draft for reopening. *@
    <Modal IsOpen="variationDraftOpen"
           Title="Create Variation Order Quote"
           ConfirmLabel="@(busy ? "Raising…" : "Raise variation")"
           ConfirmDisabled="@busy"
           ChatAware="true"
           DismissOnOverlayClick="false"
           OnCancel="CancelVariationDraft"
           OnConfirm="ConfirmVariationDraft"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (variationDraftError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@variationDraftError</p>
            }

            @if (TaskIsForThisRecord && Chat.AssistantBusy)
            {
                @* The assistant is mid-turn on this very form — say so, or the user watches a
                   blank dialog with no idea the model is typing into it through the wire. *@
                <div class="flex items-center gap-2 rounded-lg border border-accent/40 bg-accent/10 px-3 py-2">
                    <span class="w-3 h-3 shrink-0 rounded-full border-2 border-accent/30 border-t-accent animate-spin"></span>
                    <p class="text-xs text-accent">The assistant is working on this form — fields fill in as it goes.</p>
                </div>
            }

            @if (TaskIsForThisRecord)
            {
                <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-xs text-content">
                    @(IsDraftBlank && AssistantWillDraft
                        ? "The assistant is reading this RFI and its emails in the panel on the right; the draft will appear here. Start typing if you would rather write it yourself."
                        : "The assistant is working on this with you in the panel on the right.")
                    Everything here is yours to change, and nothing is created until you press Raise variation.
                </p>
            }

            <div class="@FlashClass("title")">
                <FormField Label="Title" Value="@draftVariationTitle" OnChange="OnDraftTitleChanged" Required="true" />
            </div>

            <div class="@FlashClass("description")">
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Scope description</label>
                <textarea class="field" rows="6" value="@draftVariationDescription" @oninput="OnDraftDescriptionInput"></textarea>
            </div>

            <div class="@FlashClass("estimatedValue")">
                <FormField Label="Estimated value (£, optional)" Value="@draftVariationValue" OnChange="OnDraftValueChanged" />
            </div>

            @if (draftVariationLines.Count > 0)
            {
                <div class="@FlashClass("lines")">
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Suggested scope lines</label>
                    <p class="text-xs text-content-subtle mb-2">
                        Ticked lines become the variation's scope, held as a draft bid package (@DraftPackageTrade)@(record?.HasRfq == true ? " ready to send to subcontractors" : " — send it out to subcontractors later, or price it yourselves"). Every ticked line needs a cost centre — that's the cost code its committed value lands on. Untick any line you don't want; untick them all to raise the variation on its own.
                    </p>
                    <ul class="space-y-1.5">
                        @foreach (var (row, index) in draftVariationLines.Select((r, i) => (r, i)))
                        {
                            var i = index;
                            <li>
                                <label class="flex items-start gap-2 text-sm text-content">
                                    <input type="checkbox" class="mt-0.5" checked="@row.Accepted"
                                           @onchange="e => OnDraftLineAcceptedChanged(i, e.Value is true)" />
                                    <span>@row.Line.Description <span class="text-content-subtle">— @row.Line.Quantity @row.Line.Unit · @row.Line.Trade</span></span>
                                </label>
                                @if (row.Accepted)
                                {
                                    @* A control, not a region: it renders disabled with a "Loading…"
                                       placeholder rather than behind a gate, so the layout holds
                                       still and a wrong choice cannot be made (CLAUDE.md). *@
                                    <select class="field mt-1 ml-6 min-w-[14rem] text-sm" value="@row.CostCode"
                                            disabled="@(!CostCenters.IsLoaded)"
                                            @onchange="e => OnDraftLineCostCodeChanged(i, e.Value?.ToString() ?? string.Empty)">
                                        <option value="">@(CostCenters.IsLoaded ? "Cost centre…" : "Loading…")</option>
                                        @foreach (var centre in CostCenters.Alphabetical)
                                        {
                                            <option value="@centre.Code">@($"{centre.Code} — {centre.Name}")</option>
                                        }
                                    </select>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </Modal>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string RequestId { get; set; } = "";

    // Session checked and the user is signed in — not "the record is here". The tab chrome shows
    // straight away; `dataLoaded` is the separate question of whether the record has arrived.
    private bool sessionReady;
    private bool dataLoaded;
    private Request? record;

    // ---- Panes ------------------------------------------------------------------------------
    // The request is the containing object; once promoted, the official document (RFI / NOD / EOT)
    // is its own tab. "request" or "official" — the variation tab navigates to that record's page.
    private string activeTab = "request";

    // An unpromoted request (General or any pre-official kind) has no official tab: there is no
    // official document yet, so the prepared-ahead form and the issue machinery sit on the
    // container pane, exactly as they always did. IsEmailable is what "official" means here —
    // the same test the form panel and the tab bar use.
    private bool HasOfficialTab => record is not null && record.Kind.IsEmailable();

    private bool ShowContainerPane => !HasOfficialTab || activeTab != "official";
    private bool ShowOfficialContent => !HasOfficialTab || activeTab == "official";

    private string ActiveTabId => HasOfficialTab && activeTab == "official" ? "official" : "request";

    private void SetActiveTab(string tab) =>
        activeTab = tab == "official" && HasOfficialTab ? "official" : "request";

    // Deep links (the variation page's RFI tab, forwarded links) land on the official pane with
    // ?tab=official. Read once at load; the address bar is not the source of truth thereafter.
    private void HonourRequestedTabFromRoute()
    {
        var query = new Uri(Nav.Uri).Query;
        if (query.Contains("?tab=official", StringComparison.OrdinalIgnoreCase)
            || query.Contains("&tab=official", StringComparison.OrdinalIgnoreCase))
            SetActiveTab("official");
    }
    private string responseDraft = "";
    private bool busy;
    private string? actionError;
    private bool confirmingDelete;
    private bool confirmingReturn;
    private bool respondingOpen;
    private IReadOnlyList<Client> clients = Array.Empty<Client>();
    private IReadOnlyList<Architect> architects = Array.Empty<Architect>();

    private const string ClientPrefix = "client:";
    private const string ArchitectPrefix = "architect:";

    // The composite value driving the party select: "client:{id}" / "architect:{id}" / "".
    private string PartySelectionValue =>
        record is null || string.IsNullOrEmpty(record.PartyId)
            ? ""
            : (record.PartyKind == PartyKind.Architect ? ArchitectPrefix : ClientPrefix) + record.PartyId;
    private string? ladderError;
    private VariationOrder? variation;
    private string? variationError;

    // Official document form editor (the itemised queries + narrative sections).
    private bool editingForm;
    private string? formError;
    private List<FormItemRow> formItems = new();
    private string formBasis = "";
    private string formResponseAction = "";
    private string formImpact = "";

    // Email draft staging (Outlook draft in the projects mailbox) — all lives in the email modal.
    private bool emailModalOpen;
    private bool preparingDraft;
    private string? draftError;
    private RequestEmailDraft? draftResult;
    private RequestRecipientSet? recipientPreview;

    // The emails tagged to this request (inbound legs with a live mailbox id), offered in the
    // modal as chains the official document can be issued into as a reply — newest first.
    // "" = no chain selected = start a fresh email.
    private IReadOnlyList<RequestMessage> taggedEmails = Array.Empty<RequestMessage>();
    private bool taggedEmailsLoading;
    private string selectedChainMailboxId = "";

    private string VariationHref => variation is null ? "" : $"/projects/{ProjectId}/variations/{variation.VariationOrderId}";

    // The reference the page leads with: once promoted, the official instrument number (RFI-014) —
    // the number correspondents know it by — with the REQ container number as secondary context.
    // A General request leads with its REQ-#### container number.
    private string PrimaryReference =>
        record is null ? "" :
        record.Kind != RequestType.General && !string.IsNullOrWhiteSpace(record.Reference)
            ? record.Reference
            : string.IsNullOrEmpty(record.DisplayNumber) ? record.Reference : record.DisplayNumber;

    private bool ShowContainerNumber =>
        record is not null && !string.IsNullOrEmpty(record.DisplayNumber) && record.DisplayNumber != PrimaryReference;

    private string RegisterHref => $"/projects/{ProjectId}/requests";

    // Streams the official PDF from the api, regenerated from SQL on every download.
    private string DocumentHref => $"/api/requests/{RequestId}/document";

    // Mirrors PrepareRequestEmailDraftAuthorisation server-side (directors, project managers, site
    // managers and architects; admins carry every role server-side).
    private bool CanDraftEmail => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.ProjectManager or Role.SiteManager or Role.Architect);

    // Mirrors DeleteRequestAuthorisation server-side: the Admin role only (master administrators
    // carry every role, so they qualify too).
    private bool IsAdmin => Session.AvailableRoles.Any(role => role is Role.Admin);

    // Returning to triage is a triage action, open to administrators, project managers, and the
    // finance director (admins carry every role server-side, so they always satisfy this too).
    private bool CanTriage => Session.AvailableRoles.Any(role => role is Role.Admin or Role.ProjectManager or Role.FinanceDirector);

    // Editing request field values (date issued, references, status, etc.) is open to project
    // managers and administrators. Admins carry every role server-side, so they always qualify.
    private bool CanEditDetails => Session.AvailableRoles.Any(role => role is Role.Admin or Role.ProjectManager);

    // Raising a variation is a wider set than editing the request, and always was on the server:
    // this mirrors VariationRoles.AllowedToManageVariations and ModalCatalog.VariationDraft's
    // OpenableBy exactly. Keeping the button behind CanEditDetails hid it from the MD and the QS
    // while the API would happily have accepted CreateVoqFromRfq from either — and now that the
    // assistant can route someone here with open_modal, a gate narrower than the grant means being
    // told a form has been opened over a page that has no form.
    private bool CanRaiseVariation => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.ProjectManager or Role.QuantitySurveyor);

    // Lifecycle order: the ball starts with us (Needs action), goes to the correspondent (Open),
    // may come back needing a variation order quote (Needs variation), then closes.
    private static readonly RequestStatus[] StatusOptions =
    {
        RequestStatus.NeedsAction, RequestStatus.Open,
        RequestStatus.NeedsVariation, RequestStatus.Closed
    };

    // Close confirm modal: the close date defaults to today but is editable, so a request that
    // actually closed days ago can be recorded against the date it really closed (never a future one).
    private bool confirmingClose;
    private string closeDate = "";
    private string? closeError;

    // One flag per edit modal — header (reference/status/subject), facts strip, Detail panel.
    // The edit* fields below are shared scratch state; each Open* seeds the ones its modal uses,
    // and only one modal is ever open at a time.
    private bool editingHeader;
    private bool editingFacts;
    private bool editingDetail;
    private string editReference = "";
    private string editTitle = "";
    private string editDescription = "";
    private string editIssuedAt = "";
    private string editResponseDue = "";
    private string editClosedAt = "";
    private string editDrawingRef = "";
    private string editRelatedSpec = "";
    private string editValue = "";
    private RequestStatus editStatus = RequestStatus.NeedsAction;
    private bool editCriticalPath;
    private string? editError;

    protected override async Task OnInitializedAsync()
    {
        // The pipe from the assistant panel. Subscribed before anything awaits, so a proposal that
        // lands while the page is still loading is not dropped on the floor.
        AiTasks.OnDraftApplied += HandleAssistantDraft;
        AiTasks.OnAssistantUnavailable += HandleAssistantUnavailable;
        CostCenters.OnChanged += Repaint;
        Activity.OnChanged += Repaint;
        Chat.OnChange += Repaint; // the dialog's "assistant is working" banner tracks the panel's turn
        Nav.LocationChanged += HandleLocationChangedForModal;

        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        // Activity dots on the tab bar land in the background — absent until then (never gated).
        Activity.Refresh(ProjectId);
        // Two waves instead of six sequential round-trips. Everything in the first wave is
        // independent — the record, the pickers and the variation all key off the route values,
        // not off each other — so they go out together and the page waits once for the slowest
        // rather than for the sum. Only the recipient preview genuinely needs the loaded record,
        // so it follows.
        var firstWave = new List<Task> { LoadAsync(), LoadVariationAsync() };
        if (CanEditDetails)
        {
            firstWave.Add(LoadClientsAsync());
            firstWave.Add(LoadArchitectsAsync());
        }
        await Task.WhenAll(firstWave);

        await LoadRecipientPreviewAsync();
        HonourRequestedTabFromRoute();
        dataLoaded = true;

        await HonourRequestedModalAsync();
    }

    /// <summary>
    /// The assistant's open_modal lands here with <c>?openModal=variation_draft</c>.
    ///
    /// <para>Called from BOTH lifecycle hooks. KeyedPageRouteView keys on route values, and the
    /// query string is not one — so arriving from another page runs OnInitializedAsync, while
    /// arriving from this very record (the common case: the user is already looking at the RFI they
    /// asked about) reuses the component and only runs OnParametersSetAsync.</para>
    ///
    /// <para>Honoured only where this user could have opened the dialog by clicking, under the same
    /// conditions the button itself renders under. The assistant can route somebody to a page; it
    /// cannot get them past a gate.</para>
    /// </summary>
    private async Task HonourRequestedModalAsync()
    {
        if (!WantsVariationDraftFromRoute()) return;

        // Cleared first, whether or not it is honoured, and through history rather than the router:
        // NavigateTo here would re-enter OnParametersSetAsync and fire a second, concurrent fetch of
        // the record. Left in the address bar it would re-open on every refresh or restored tab — a
        // fresh conversation and another paid read of the whole email thread, for pressing F5.
        try { await JS.InvokeVoidAsync("history.replaceState", null, "", new Uri(Nav.Uri).GetLeftPart(UriPartial.Path)); }
        catch { /* Address bar cosmetics. Never worth failing the page over. */ }
        modalRequestHonoured = true;

        // Refused OUT LOUD — a silently dropped open_modal is the worst failure this feature
        // has: the model narrates a form that never appeared and nobody can tell what broke.
        if (record is null) return;
        if (!CanRaiseVariation)
        {
            variationError = "The assistant tried to open the variation dialog, but the role you "
                + "are signed in as can't raise variations.";
            StateHasChanged();
            return;
        }
        if (variation is not null)
        {
            variationError = $"The assistant tried to draft a variation from {record.Reference}, "
                + "but this request already has one — it's on the Variation tab.";
            StateHasChanged();
            return;
        }
        if (record.Kind is not RequestType.Rfi && !record.HasRfq)
        {
            variationError = "The assistant tried to draft a variation here, but this request "
                + "isn't an RFI — a variation is drafted from the RFI stage.";
            StateHasChanged();
            return;
        }

        await OpenVariationDraft();
    }

    // history.replaceState does not raise LocationChanged, so Nav.Uri keeps the stripped-out query
    // for the life of this component. This is what stops a later repaint re-honouring it.
    private bool modalRequestHonoured;

    private bool WantsVariationDraftFromRoute() =>
        !modalRequestHonoured
        && new Uri(Nav.Uri).Query.Contains(
            $"openModal={ModalCatalog.VariationDraft.ModalKey}", StringComparison.OrdinalIgnoreCase);

    private void Repaint() => InvokeAsync(StateHasChanged);

    // The tab bar's per-record activity dots (the request's own linked mail, the variation's, each
    // bid package's) — one lookup shared by every tab.
    private RecordActivitySummary? TabActivity(RecordType type, string recordId) =>
        Activity.For(ProjectId, type, recordId);

    /// <summary>
    /// The case the lifecycle hooks miss: the panel's open_modal firing while the user is ALREADY
    /// on this very record changes only the query string — route parameter values are identical,
    /// so Blazor re-renders nothing and neither lifecycle hook runs (found live on the Variations
    /// register; same latent hole here). LocationChanged always fires; history.replaceState does
    /// not raise it, so honouring cannot loop.
    /// </summary>
    private void HandleLocationChangedForModal(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            if (!dataLoaded) return;
            modalRequestHonoured = false; // a fresh navigation is a fresh request
            await HonourRequestedModalAsync();
            StateHasChanged();
        });

    public void Dispose()
    {
        AiTasks.OnDraftApplied -= HandleAssistantDraft;
        AiTasks.OnAssistantUnavailable -= HandleAssistantUnavailable;
        CostCenters.OnChanged -= Repaint;
        Activity.OnChanged -= Repaint;
        Chat.OnChange -= Repaint;
        Nav.LocationChanged -= HandleLocationChangedForModal;
        flashTimer?.Dispose();

        // The dialog goes with the page, so the panel must not stay lifted above an overlay that no
        // longer exists.
        Chat.SetCoexistence(false);

        // The task belongs to this page too. Navigating away ends it, so the panel does not keep
        // offering to fill in a form that is no longer on screen. The conversation is persisted
        // server-side, so nothing evidential goes with it.
        if (AiTasks.Active?.RecordId == RequestId) AiTasks.End();
    }

    // Each of these swallows its own failure so one unavailable picker can never stop the page
    // rendering — the same behaviour as when these ran one after another, just concurrently.
    private async Task LoadClientsAsync()
    {
        try { clients = await ClientStore.ListAsync(); } catch { clients = Array.Empty<Client>(); }
    }

    private async Task LoadArchitectsAsync()
    {
        try { architects = await ArchitectStore.ListAsync(); } catch { architects = Array.Empty<Architect>(); }
    }

    // The tagged emails offered as reply targets in the email modal, fetched fresh each time the
    // modal opens. Best-effort: the modal just shows its empty state on error.
    private async Task LoadTaggedEmailsAsync()
    {
        if (record is null || !record.Kind.IsEmailable() || !CanDraftEmail)
        {
            taggedEmails = Array.Empty<RequestMessage>();
            return;
        }
        try
        {
            taggedEmailsLoading = true;
            // Any live email leg (MailboxId set) can anchor a reply — including the mailbox's own
            // sent copy, where reply-all correctly re-addresses the original recipients.
            taggedEmails = (await RequestRegister.ListMessagesAsync(record.RequestId))
                .Where(m => !string.IsNullOrEmpty(m.MailboxId))
                .OrderByDescending(m => m.PostedAt)
                .ToList();
        }
        catch
        {
            taggedEmails = Array.Empty<RequestMessage>();
        }
        finally
        {
            taggedEmailsLoading = false;
        }
    }

    // The resolved To/CC/BCC an issue or draft would use right now — same resolver as the send
    // paths, refreshed whenever the linked party changes. Best-effort: the panel just hides on error.
    private async Task LoadRecipientPreviewAsync()
    {
        try { recipientPreview = record is null ? null : await Correspondence.ResolveRequestRecipientsAsync(record.RequestId); }
        catch { recipientPreview = null; }
    }

    private static string RecipientLine(IReadOnlyList<CorrespondenceRecipient> recipients) =>
        string.Join(", ", recipients.Select(r => string.IsNullOrWhiteSpace(r.Name) ? r.Email : $"{r.Name} <{r.Email}>"));

    private async Task LoadVariationAsync()
    {
        // A variation normally appears only after the RFQ step (HasRfq), but one can also be attached
        // to this request through the register's "Link…" repair — those links can predate the
        // flag, so always look for one rather than gating on HasRfq. Returns null when none.
        try { variation = await Variations.GetByRequestAsync(RequestId); }
        catch { variation = null; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!dataLoaded) return;
        await LoadAsync();
        // Query-only navigation reuses this component, so this is the hook that catches an
        // open_modal aimed at the record already on screen.
        await HonourRequestedModalAsync();
    }

    private async Task LoadAsync()
    {
        record = await RequestRegister.GetAsync(RequestId);
        responseDraft = record?.ResponseText ?? "";
    }

    private void OnResponseDraftInput(ChangeEventArgs e) => responseDraft = e.Value?.ToString() ?? "";

    // ---- Title-bar menus --------------------------------------------------------------------------
    // Both menus are built here rather than inline in markup, so the whole set of things you can do
    // to a request — and exactly what gates each one — reads as a single list in one place.

    private List<DropdownMenu.Item> StatusMenuItems => StatusOptions
        .Select(option => new DropdownMenu.Item(
            Label: option.DisplayName(),
            OnSelect: EventCallback.Factory.Create(this, () => ChangeStatusFromPill(option)),
            Hint: option.Hint(),
            Disabled: busy || option == record?.Status,
            Selected: option == record?.Status))
        .ToList();

    private List<DropdownMenu.Item> ActionMenuItems
    {
        get
        {
            var items = new List<DropdownMenu.Item>();
            if (record is null) return items;

            // Group 0 — the document itself.
            if (record.Kind.IsEmailable())
                items.Add(new(Label: $"Download {record.Kind.DisplayName()} PDF", Href: DocumentHref,
                    Hint: "Regenerated from the register on every download, so it always reflects the request as it stands"));

            // Group 1 — moving the request along.
            if (record.Status is not RequestStatus.Closed)
            {
                items.Add(new(Label: "Record response…", OnSelect: EventCallback.Factory.Create(this, OpenResponseModal),
                    Hint: "The formal answer recorded on the request — it prints on the official document", Group: 1));
                items.Add(new(Label: "Close request…", OnSelect: EventCallback.Factory.Create(this, OpenCloseConfirm), Group: 1));
            }
            else
            {
                items.Add(new(Label: "Reopen request", OnSelect: EventCallback.Factory.Create(this, ReopenFromMenu), Group: 1));
            }

            // Promotion also has the primary slot when there is nothing to email yet; it stays here
            // so the menu is a complete list of what can be done, not a list of leftovers.
            if (CanEditDetails && record.Kind is not RequestType.Rfi)
                items.Add(new(Label: "Promote to RFI", OnSelect: EventCallback.Factory.Create(this, PromoteToRfi),
                    Disabled: busy, Group: 1));

            // Group 2 — editing, gathering up the four inline "Edit" links the panels used to carry.
            if (CanEditDetails)
            {
                items.Add(new(Label: "Edit subject & reference…", OnSelect: EventCallback.Factory.Create(this, OpenHeaderEdit), Group: 2));
                items.Add(new(Label: "Edit dates & references…", OnSelect: EventCallback.Factory.Create(this, OpenFactsEdit),
                    Hint: "Date issued, response due, drawing references", Group: 2));
                items.Add(new(Label: "Edit description…", OnSelect: EventCallback.Factory.Create(this, OpenDetailEdit), Group: 2));
                items.Add(new(Label: "Edit official form", OnSelect: EventCallback.Factory.Create(this, OpenFormEditor),
                    Hint: "The itemised queries and the basis / response / impact sections",
                    Disabled: editingForm, Group: 2));

                if (record.Kind is RequestType.Rfi)
                    items.Add(new(Label: record.CriticalPath ? "Remove critical path tag" : "Mark as critical path",
                        OnSelect: EventCallback.Factory.Create(this, ToggleCriticalPathFromMenu),
                        Hint: "Tagged RFIs show under Critical Path RFIs on the Programme tab", Group: 2));

                // Hidden once a variation exists (including one attached via the register's Link…
                // repair) — that step has already been taken.
                if (record.Kind is RequestType.Rfi && !record.HasRfq && variation is null)
                    items.Add(new(Label: "Create bid packages",
                        OnSelect: EventCallback.Factory.Create(this, CreateBidPackagesFromMenu),
                        Hint: "Marks this RFI as carrying an RFQ, so the variation's scope can go out to tender", Group: 2));

            }

            // The same action as the rail's button, mirrored into the menu so it sits with the
            // other "move this record along" steps. Any RFI can raise one — no RFQ required.
            // Outside the CanEditDetails block on purpose: raising a variation is the wider gate
            // (CanRaiseVariation), and the two must agree or the MD and the QS get a button on the
            // rail and no matching row in the menu.
            if (record.Kind is RequestType.Rfi && variation is null && CanRaiseVariation)
                items.Add(new(Label: "Create Variation Order Quote…",
                    OnSelect: EventCallback.Factory.Create(this, OpenVariationDraft),
                    Hint: "Drafts a priced quote from this RFI and its tagged emails for you to review", Group: 1));

            // Group 3 — the destructive tail, kept last and marked.
            if (CanTriage)
                items.Add(new(Label: "Return to Control Centre…",
                    OnSelect: EventCallback.Factory.Create(this, () => { confirmingReturn = true; }),
                    Hint: "Sends every email linked to this request back to the Control Centre queue",
                    Destructive: true, Group: 3));
            if (IsAdmin)
                items.Add(new(Label: "Delete request…",
                    OnSelect: EventCallback.Factory.Create(this, () => { confirmingDelete = true; }),
                    Destructive: true, Group: 3));

            return items;
        }
    }

    private void OpenResponseModal()
    {
        actionError = null;
        responseDraft = record?.ResponseText ?? "";
        respondingOpen = true;
    }

    private void CancelResponseModal()
    {
        if (busy) return;
        respondingOpen = false;
    }

    private async Task SaveResponseFromModal()
    {
        // A recorded response puts the ball back in our court: review it, then close it, raise the
        // variation order quote it calls for, or re-issue.
        await Apply(RequestStatus.NeedsAction, responseDraft);
        if (actionError is null) respondingOpen = false;
    }

    private async Task ReopenFromMenu()
    {
        await ReopenRequest();
    }

    // The status pill's dropdown: Closed has its own flow (the close confirm with its date and
    // the agent gate) so a pill change can never skip its safeguards; the rest apply directly,
    // keeping the recorded response text.
    private async Task ChangeStatusFromPill(RequestStatus status)
    {
        if (record is null || busy || status == record.Status) return;
        switch (status)
        {
            case RequestStatus.Closed:
                OpenCloseConfirm();
                break;
            default:
                await Apply(status, record.ResponseText);
                break;
        }
    }

    // "Create bid packages": marks the RFI as carrying an RFQ, which unlocks the Variation Order
    // Quote (and its bid packages) in the rail.
    private async Task CreateBidPackagesFromMenu()
    {
        await EnableRfq();
    }

    // The close confirm modal: opens with today's date pre-filled so the common case is one click,
    // but the date is editable for closures only recorded after the fact.
    private void OpenCloseConfirm()
    {
        if (record is null || busy) return;
        closeDate = DateTime.Today.ToString("yyyy-MM-dd");
        closeError = null;
        confirmingClose = true;
    }

    private void CancelClose() => confirmingClose = false;

    private async Task PerformClose()
    {
        var closedAt = ParseDate(closeDate);
        if (closedAt is null) { closeError = "A close date is required."; return; }
        if (closedAt.Value.Date > DateTime.Today) { closeError = "The closed date cannot be in the future."; return; }
        confirmingClose = false;
        await CloseRequest(closedAt.Value);
    }

    // Closes the request as at the user-chosen date. Any drafted response is persisted first so
    // it isn't lost.
    private async Task CloseRequest(DateTimeOffset closedAt)
    {
        if (record is null || busy) return;
        actionError = null;

        if (!string.IsNullOrWhiteSpace(responseDraft) && responseDraft.Trim() != (record.ResponseText ?? "").Trim())
            await Apply(RequestStatus.NeedsAction, responseDraft);
        if (record is null) return;

        try
        {
            busy = true;
            var closed = await RequestRegister.CloseAsync(record.RequestId, record.ProjectId, closedAt);
            if (closed)
            {
                record = await RequestRegister.GetAsync(RequestId);
                responseDraft = record?.ResponseText ?? "";
            }
            else
            {
                actionError = "This request no longer exists — refresh the page.";
            }
        }
        catch
        {
            actionError = "Couldn't close the request. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    // Reopening puts the ball back in our court — the reopened request needs someone to act.
    private async Task ReopenRequest() => await Apply(RequestStatus.NeedsAction, record?.ResponseText);

    // Drops every dialog and inline editor on the page. Used when the page is about to navigate
    // away, so a modal can never be left hanging over the destination during the transition.
    private void CloseOpenDialogs()
    {
        confirmingDelete = false;
        confirmingReturn = false;
        confirmingClose = false;
        respondingOpen = false;
        emailModalOpen = false;
        editingHeader = false;
        editingFacts = false;
        editingDetail = false;
        editingForm = false;
        variationDraftOpen = false;
        Chat.SetCoexistence(false);
    }

    // Promotion is the end of this record's triage, not the start of another edit: it mints the RFI
    // reference and the official document, and the next thing anyone does is pick up the next
    // request. So the page closes anything open and returns to the register, where the promoted row
    // now reads as an RFI — rather than leaving the user on a page whose buttons have all changed
    // underneath them. A failure keeps them here with the reason.
    private async Task PromoteToRfi()
    {
        if (record is null || busy) return;
        ladderError = null;
        try
        {
            busy = true;
            var promoted = await RequestRegister.PromoteToRfiAsync(record.RequestId, ProjectId);
            record = promoted;
            responseDraft = promoted.ResponseText ?? "";
            CloseOpenDialogs();
            Nav.NavigateTo($"/projects/{ProjectId}/requests");
        }
        catch
        {
            ladderError = "Couldn't promote the request to an RFI. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task EnableRfq()
    {
        if (record is null || busy) return;
        ladderError = null;
        try
        {
            busy = true;
            record = await RequestRegister.EnableRfqAsync(record.RequestId, ProjectId);
            await LoadVariationAsync();
        }
        catch
        {
            ladderError = "Couldn't enable bid packages on this RFI. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }

    // The variation draft. The dialog opens INSTANTLY, seeded from the RFI's own title and
    // description, and the assistant fills it in from the panel beside it — an exchange rather than
    // a five-second wait on one blocking call. Nothing here writes: CreateVoqFromRfq commits what
    // the user presses Raise variation on. (Those command names are API identifiers and keep their
    // historic spelling.)
    private bool variationDraftOpen;

    // Whether the form has already been filled in for this page's record. Keyed on the PAGE, not on
    // AiTaskState: ending the conversation (the panel's "Done") must never be the thing that
    // discards a drafted variation the next time the dialog is opened.
    private bool variationDraftSeeded;

    private string? variationDraftError;
    private string draftVariationTitle = "";
    private string draftVariationDescription = "";
    private string draftVariationValue = "";
    private string draftVariationTrade = "";
    private List<DraftLineRow> draftVariationLines = new();

    // Which fields the assistant changed on its last pass, so they pulse rather than silently
    // differing from what the user last read. Cleared on a timer.
    private HashSet<string> flashedFields = new();
    private System.Threading.Timer? flashTimer;

    // Storage limits on VariationOrderEntity. Enforced here now that no server-side draft handler
    // sits in front of the dialog to clamp what a model returned.
    private const int MaxVariationTitleChars = 256;
    private const int MaxVariationDescriptionChars = 2048;

    private sealed record DraftLineRow(VoqDraftLine Line, bool Accepted, string CostCode = "");

    private bool CanUseAssistant =>
        Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role);

    /// <summary>
    /// A draft is genuinely on its way: this user has the assistant AND has accepted the billed-usage
    /// notice. Without the second half the kick-off stays queued in AiTaskState and nothing is ever
    /// sent — so a form left blank for it would stay blank.
    /// </summary>
    private bool AssistantWillDraft => CanUseAssistant && Chat.HasAcknowledgedCost;

    private bool TaskIsForThisRecord =>
        AiTasks.Active is { } task && task.RecordId == RequestId;

    private string FlashClass(string field) => flashedFields.Contains(field) ? "jpms-flash" : "";

    /// <summary>Nothing typed and nothing drafted yet — the state the dialog opens in while the
    /// assistant reads. Not a load gate: the form is fully usable, it is simply still empty.</summary>
    private bool IsDraftBlank =>
        string.IsNullOrWhiteSpace(draftVariationTitle)
        && string.IsNullOrWhiteSpace(draftVariationDescription)
        && draftVariationLines.Count == 0;

    // The trade for the draft bid package. An explicitly-set trade wins: the assistant is told the
    // field IS the package's trade, so honouring it is both what the schema promises and what makes
    // it round-trip — set Electrical, read Electrical back next turn. Falls back to the first
    // accepted line's trade, which is what this used before the field existed.
    private string DraftPackageTrade
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(draftVariationTrade)) return draftVariationTrade;
            var accepted = draftVariationLines.FirstOrDefault(row => row.Accepted && !string.IsNullOrWhiteSpace(row.Line.Trade));
            return accepted is not null ? accepted.Line.Trade : "General";
        }
    }

    private async Task OpenVariationDraft()
    {
        if (record is null || busy) return;
        variationError = null;
        variationDraftError = null;
        variationDraftOpen = true;

        // The panel has to sit above the dialog's overlay while both are on screen. Owned here, by
        // the thing that knows whether a dialog is open, and cleared everywhere this one closes.
        Chat.SetCoexistence(true);

        // Reopening after a cancel restores what was drafted rather than discarding the exchange
        // that produced it. Only a first open reseeds the form.
        if (!variationDraftSeeded)
        {
            variationDraftSeeded = true;
            draftVariationValue = "";
            draftVariationTrade = "";
            draftVariationLines = new();
            flashedFields = new();

            // Blank when the assistant is about to fill it in. Pre-filling with the RFI's own title
            // and description only looked like an answer for the second before it was overwritten,
            // and a variation's scope is not the RFI's question restated.
            //
            // Seeded whenever nothing else is coming — no assistant for this role, OR the billed-
            // usage notice not accepted, which holds the kick-off back so no turn is ever sent and
            // no "unavailable" ever arrives to trigger the fallback. Blank forever is the one
            // outcome worse than a pre-filled form.
            draftVariationTitle = AssistantWillDraft ? "" : record.Title;
            draftVariationDescription = AssistantWillDraft ? "" : record.Description;

            if (CanUseAssistant)
            {
                AiTasks.Start(
                    new AiTask(
                        TaskKey: "variation-draft",
                        ModalKey: ModalCatalog.VariationDraft.ModalKey,
                        BannerLabel: $"Drafting a variation from {record.Reference}",
                        BusyLabel: $"Reading {record.Reference} and the emails tagged to it…",
                        // A user turn, so it outranks the system prompt — it has to say the same
                        // thing. An earlier version ended "ask me before you write anything", and
                        // that one clause was enough to get a list of questions instead of a draft.
                        KickoffMessage:
                            $"Draft the variation that {record.Reference} has led to. Read the RFI and every "
                            + "email tagged to it properly, then put your draft into the form open beside me. "
                            + "Draft whatever the correspondence supports and tell me in one line what you "
                            + "could not establish from it. Only ask me a question if there is genuinely "
                            + "nothing there to scope.",
                        ProjectId: ProjectId,
                        RecordType: nameof(RecordType.Request),
                        RecordId: record.RequestId,
                        RecordReference: record.Reference),
                    SerialiseDraft());

                Chat.Open();
            }
        }
        else if (CanUseAssistant && !TaskIsForThisRecord)
        {
            // Reopened after the conversation moved on ("Done", New chat, a resumed thread ended
            // the task). Without re-attaching one, update_open_modal no longer exists and every
            // proposal is dropped while the model narrates success — so the task comes back, but
            // SILENTLY: no kick-off, no billed turn, the drafted fields riding along as they
            // stand. The user asks for what they want in their own words.
            AiTasks.Start(
                new AiTask(
                    TaskKey: "variation-draft",
                    ModalKey: ModalCatalog.VariationDraft.ModalKey,
                    BannerLabel: $"Drafting a variation from {record.Reference}",
                    BusyLabel: $"Reading {record.Reference} and the emails tagged to it…",
                    KickoffMessage: null,
                    ProjectId: ProjectId,
                    RecordType: nameof(RecordType.Request),
                    RecordId: record.RequestId,
                    RecordReference: record.Reference),
                SerialiseDraft());
            Chat.Open();
        }

        // Cost centres feed the scope lines' cost-code selects. Awaited, not fire-and-forget: the
        // select renders disabled until this lands, and nothing was repainting it before.
        try { await CostCenters.RefreshAsync(CancellationToken.None); }
        catch { /* the select stays disabled; a ticked line without a code still blocks the create. */ }
    }

    private void CancelVariationDraft()
    {
        if (busy) return;
        // The task and the draft survive: this closes a window, it does not abandon the work. The
        // assistant panel stays open beside the page and reopening restores everything.
        variationDraftOpen = false;
        Chat.SetCoexistence(false);
    }

    private async Task ConfirmVariationDraft()
    {
        if (record is null || busy) return;
        variationDraftError = null;

        if (string.IsNullOrWhiteSpace(draftVariationTitle))
        {
            variationDraftError = "A title is required.";
            return;
        }

        decimal? estimatedValue = null;
        if (!string.IsNullOrWhiteSpace(draftVariationValue))
        {
            var raw = draftVariationValue.Replace("£", "").Replace(",", "").Trim();
            if (!decimal.TryParse(raw, out var parsedValue) || parsedValue < 0)
            {
                variationDraftError = "Estimated value must be a number.";
                return;
            }
            estimatedValue = parsedValue;
        }

        // Accepted scope lines become a standalone (draft) bid package on the project — bid packages
        // are separate records from the variation (separation 2026-08-12), so this is the ordinary
        // project package, not a child of the VO. Every line put out to tender must know its
        // cost-centre home, so a ticked line without a code blocks the create.
        var acceptedRows = draftVariationLines.Where(row => row.Accepted).ToList();
        if (acceptedRows.Any(row => string.IsNullOrWhiteSpace(row.CostCode)))
        {
            variationDraftError = "Every ticked scope line needs a cost code — pick a cost centre for each, or untick it.";
            return;
        }

        try
        {
            busy = true;
            variation = await Variations.CreateFromRfqAsync(
                record.RequestId, draftVariationTitle.Trim(), draftVariationDescription.Trim(), estimatedValue);

            if (acceptedRows.Count > 0)
            {
                var package = await Commands.SendAsync(
                    new CreateBidPackage(ProjectId, variation.Title, DraftPackageTrade, Auth.CurrentUser?.Email ?? ""),
                    CancellationToken.None);
                var inputs = acceptedRows
                    .Select(row => new BidPackageLineItemInput(
                        row.Line.Description, row.Line.Unit, row.Line.Quantity,
                        string.IsNullOrWhiteSpace(row.Line.Trade) ? DraftPackageTrade : row.Line.Trade,
                        row.CostCode.Trim()))
                    .ToList();
                await Commands.SendAsync(new AddBidPackageLineItems(package.BidPackageId, inputs), CancellationToken.None);
            }

            variationDraftOpen = false;
            Chat.SetCoexistence(false);
            // The work is done: end the task so the panel drops its banner and goes back to being
            // the general assistant. The conversation itself is already persisted server-side, so
            // nothing evidential is lost by clearing the client's handle on it.
            AiTasks.End();
            Nav.NavigateTo($"/projects/{ProjectId}/variations/{variation.VariationOrderId}");
        }
        catch
        {
            variationDraftError = variation is null
                ? "Couldn't raise the variation. Please try again."
                : "The variation was raised, but creating the bid package for its scope failed. Add one from the Bid Package Invites tab instead.";
        }
        finally
        {
            busy = false;
        }
    }

    // ---- The dialog ⇄ assistant pipe -----------------------------------------------------------
    //
    // Out: every edit republishes the form so the model always reasons from what is on screen NOW.
    // In: the assistant's proposals arrive as raw JSON and are MERGED, never swapped in wholesale.

    private void PublishDraft() => AiTasks.UpdateDraft(SerialiseDraft());

    private void OnDraftTitleChanged(string value)
    {
        draftVariationTitle = value;
        PublishDraft();
    }

