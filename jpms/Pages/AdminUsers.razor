@page "/admin/users"
@using Jewel.JPMS.Features.Directory
@inject AuthService Auth
@inject SessionService Session
@inject DirectoryReadModel Directory
@inject IUserDirectory UserDirectory
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Users · JPMS</PageTitle>

@*
    Admin → Users: everyone who can sign in, with invites and role administration. This panel
    lived on the administrator's homepage until 2026-07-30 — user administration outgrew a
    homepage, and revocation gained a list of its own (the Revoked tab), so the pair moved here
    behind an administrator-only sidebar folder.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (Session.ActiveRole != Role.Admin)
{
    <section class="px-6 md:px-8 py-12 max-w-2xl">
        <div class="panel p-6">
            <p class="text-sm text-content-muted">
                This area is for administrators. If you hold the Administrator role, switch to it to manage users.
            </p>
        </div>
    </section>
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12 max-w-4xl">
        <WorkspaceSectionNav />
        <header class="mb-6 md:mb-8">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · Admin</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Users</h1>
            <p class="text-sm text-content-muted mt-1">
                Everyone who can sign in, and the roles that decide what they see.
                Revoking a user moves them to the Revoked tab, where they can be restored or permanently deleted.
            </p>
        </header>

        @if (dataFailed && !UserDirectory.IsLoaded)
        {
            <div class="panel p-5">
                <p class="text-sm text-negative">
                    The user list couldn't be loaded. The error banner above has the detail — fix or retry, then reload this page.
                </p>
            </div>
        }
        else
        {
            <ApprovedUsersPanel CurrentUserEmail="@Auth.CurrentUser!.Email" />
        }
    </section>
}

@code {
    private bool sessionReady;
    private bool dataFailed;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        Session.OnChange += StateHasChanged;
        sessionReady = true;

        if (Session.ActiveRole == Role.Admin)
        {
            // Stale-while-revalidate: an already-loaded list paints immediately and refreshes
            // behind itself; a cold one is awaited so the panel's gate opens onto real data.
            if (Directory.Current is null)
            {
                try { await Directory.RefreshAsync(CancellationToken.None); }
                catch { dataFailed = true; }
            }
            else
            {
                _ = RevalidateAsync();
            }
        }
    }

    private async Task RevalidateAsync()
    {
        try { await Directory.RefreshAsync(CancellationToken.None); }
        catch { /* background revalidation — the toast already reported it and the stale list stands */ }
    }

    public void Dispose() => Session.OnChange -= StateHasChanged;
}
