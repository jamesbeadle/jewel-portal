@page "/architects"
@using Jewel.JPMS.Contracts.Architects
@inject AuthService Auth
@inject SessionService Session
@inject IArchitectStore ArchitectStore
@inject NavigationManager Nav

<PageTitle>Architects · JPMS</PageTitle>

<Page CanAccess="CanManage" AccessDeniedMessage="You don't have access to architect practices.">
    <PageHeader>
        <SubtitleContent>
            @if (architects is not null)
            {
                <text>@architects.Count architect@(architects.Count == 1 ? "" : "s") · </text>
            }
            when an architect is a project's party, RFIs and other request documents go to the contact email here.
        </SubtitleContent>
        <Primary>
            <button type="button" class="btn-primary" @onclick="OpenCreate">New architect</button>
        </Primary>
        <Actions>
            <div class="flex items-center gap-4 shrink-0">
                <ExportToExcelButton FileName="Architects"
                                     Disabled="@(AllArchitects.Count == 0)"
                                     BuildWorkbook="BuildExportWorkbook" />

            </div>
        </Actions>
    </PageHeader>

    @if (loadError is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-4">@loadError</Notice>
    }

    <LoadGate IsLoading="@(!ArchitectsReady)" Prominent="true" Label="Loading architect practices">
    @if (architects is null)
    {
        <p class="text-sm text-negative">Couldn't load the architect practices. The reason is in the red bar above — reload to try again.</p>
    }
    else if (architects.Count == 0)
    {
        <EmptyState Message="No architect practices yet. Create one to select it as the party on a project or request when Jewel works through an architect." />
    }
    else
    {
        <RecordsTable>
            <thead>
                <tr>
                    <th>Practice</th>
                    <th>Contact</th>
                    <th>Contact email</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var architect in architects)
                {
                    <tr>
                        <td class="font-medium text-content">@architect.Name</td>
                        <td>@Dash(architect.ContactName)</td>
                        <td>@Dash(architect.ContactEmail)</td>
                        <td class="text-right whitespace-nowrap">
                            <button type="button" class="text-sm font-medium text-content-muted hover:text-content mr-3" @onclick="() => OpenContacts(architect)">Contacts</button>
                            <button type="button" class="text-sm font-medium text-content-muted hover:text-content" @onclick="() => OpenEdit(architect)">Edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </RecordsTable>
    }
    </LoadGate>

    <PartyContactsEditor @ref="contactsEditor" Kind="PartyKind.Architect" OnChanged="ReloadAsync" />

    <Modal IsOpen="creating"
           Title="New architect practice"
           ConfirmLabel="@(busy ? "Creating…" : "Create architect")"
           OnCancel="() => creating = false"
           OnConfirm="CreateArchitectAsync"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Practice name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Contact name" Value="@formContactName" OnChange="v => formContactName = v" />
                <FormField Label="Contact email" Value="@formContactEmail" OnChange="v => formContactEmail = v" />
            </div>
        </div>
    </Modal>

    <Modal IsOpen="editing"
           Title="Edit architect"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="() => editing = false"
           OnConfirm="SaveEditAsync"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Practice name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Contact name" Value="@formContactName" OnChange="v => formContactName = v" />
                <FormField Label="Contact email" Value="@formContactEmail" OnChange="v => formContactEmail = v" />
            </div>
        </div>
    </Modal>
</Page>

@code {
    // Session checked and the user signed in. This is NOT "the data is here" — keeping the two
    // apart is what lets the page show its chrome at once and hold the table until the list lands.
    private bool busy;
    private string? loadError;
    private string? formError;
    // Nullable on purpose. "No architect practices yet" is a real answer, so "not fetched" needs
    // to be a distinct state — otherwise the empty state is shown before anything was asked.
    private IReadOnlyList<Architect>? architects;

    private IReadOnlyList<Architect> AllArchitects => architects ?? Array.Empty<Architect>();

    // A failed fetch opens the gate too, or the jewel pulses forever; the red bar above says why.
    private bool ArchitectsReady => architects is not null || loadError is not null;

    private bool CanManage => Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.ProjectManager);

    private bool creating;
    private bool editing;
    private PartyContactsEditor? contactsEditor;
    private string? editTargetId;
    private string formName = "";
    private string formContactName = "";
    private string formContactEmail = "";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        // Paint the chrome before the fetch: Blazor re-renders OnInitializedAsync only at its
        // FIRST await, which has already passed, so without this the page waits on the list.
        StateHasChanged();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try { architects = await ArchitectStore.ListAsync(); loadError = null; }
        catch { loadError = "Couldn't load architect practices. Please try again."; }
    }

    private void OpenCreate()
    {
        formError = null;
        formName = formContactName = formContactEmail = "";
        creating = true;
    }

    private async Task OpenContacts(Architect architect)
    {
        if (contactsEditor is not null) await contactsEditor.Open(architect.ArchitectId, architect.Name);
    }

    private void OpenEdit(Architect architect)
    {
        formError = null;
        editTargetId = architect.ArchitectId;
        formName = architect.Name;
        formContactName = architect.ContactName ?? "";
        formContactEmail = architect.ContactEmail ?? "";
        editing = true;
    }

    private async Task CreateArchitectAsync()
    {
        if (busy) return;
        formError = null;
        if (string.IsNullOrWhiteSpace(formName)) { formError = "A practice name is required."; return; }
        try
        {
            busy = true;
            await ArchitectStore.CreateAsync(new CreateArchitect(
                formName.Trim(),
                NullIfBlank(formContactName),
                NullIfBlank(formContactEmail)));
            creating = false;
            await ReloadAsync();
        }
        catch { formError = "Couldn't create the architect. Please try again."; }
        finally { busy = false; }
    }

    private async Task SaveEditAsync()
    {
        if (busy || editTargetId is null) return;
        formError = null;
        if (string.IsNullOrWhiteSpace(formName)) { formError = "A practice name is required."; return; }
        try
        {
            busy = true;
            await ArchitectStore.UpdateAsync(new UpdateArchitect(
                editTargetId,
                formName.Trim(),
                NullIfBlank(formContactName),
                NullIfBlank(formContactEmail)));
            editing = false;
            await ReloadAsync();
        }
        catch { formError = "Couldn't save the changes. Please try again."; }
        finally { busy = false; }
    }

    private ExcelWorkbook? BuildExportWorkbook(bool _)
    {
        if (AllArchitects.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Architects",
            new ExcelColumn("Practice"),
            new ExcelColumn("Contact"),
            new ExcelColumn("Contact email"));

        foreach (var architect in AllArchitects)
        {
            sheet.AddRow(architect.Name, architect.ContactName, architect.ContactEmail);
        }
        return workbook;
    }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
