@page "/projects/{ProjectId}/useful-information"
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav

<PageTitle>Useful Information · JPMS</PageTitle>

@*
    The project's Useful Information tab — titled free-text notes for the office's own use (door
    codes, key safe locations, site access notes). Strictly internal: the API gates reads and
    writes to internal roles, so nothing here can reach a client, architect or subcontractor
    login. The list itself lives in UsefulInformationPanel.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="useful-information">
        <UsefulInformationPanel ProjectId="@ProjectId" />
    </ProjectPageShell>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    // Session checked and signed in — nothing more (the panel gates on its own data).
    private bool sessionReady;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
    }
}
