@page "/projects/{ProjectId}/reconciliation-audit"
@using Jewel.JPMS.Contracts.Audit
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject NavigationManager Nav

<PageTitle>Reconciliation Audit · JPMS</PageTitle>

@*
    The finance reconciliation trail: every cost-centre move on this project's valuation report,
    newest first — who moved which line, from where to where, and the value that moved with it.
    Rows are written by the API when a line is recoded (SetValuationLineCostCentreHandler →
    AuditEventType.CostCentreRecoded) and read back here through the same audit register the
    company-wide Audit Trail page uses, narrowed to this project and that event. Read-only by
    design: the moves themselves happen on the Valuation Report tab (and the cost-centre modals);
    this page is the record finance reconciles against. Gated like the rest of the Financials
    folder (FinanceRoles), mirroring the API's CommercialTeam gate on the filtered audit read.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!CanAccess)
{
    <section class="px-6 md:px-8 py-12">
        <h1 class="text-2xl font-semibold text-content mb-2">Not available</h1>
        <p class="text-content-muted">The reconciliation audit is restricted to the commercial team.</p>
    </section>
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="reconciliation-audit">
        <div class="flex items-center justify-between gap-4 mb-4 flex-wrap">
            <div>
                <h2 class="text-lg font-semibold text-content">Reconciliation Audit</h2>
                <p class="text-sm text-content-muted mt-1">
                    Cost centre moves on the valuation report — who moved which line, from where to
                    where, and when. The moves themselves are made on the Valuation Report tab.
                </p>
            </div>
            @if (loaded && total > 0)
            {
                <span class="text-xs text-content-subtle">Showing @items.Count of @total</span>
            }
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@loadError</p>
        }

        <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading the reconciliation audit">
        @if (loadError is not null && items.Count == 0)
        {
            @* A failed page has nothing to report; saying "no moves recorded" would read as one. *@
            <p class="text-sm text-negative">Couldn't load the reconciliation audit. The reason is in the red bar above — reload to try again.</p>
        }
        else if (items.Count == 0)
        {
            <div class="panel p-8 text-center">
                <p class="text-sm text-content">No cost centre moves recorded yet.</p>
                <p class="text-xs text-content-subtle mt-1">
                    When a valuation report line is recoded to a different cost centre, the move
                    appears here with who made it and the value that moved.
                </p>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-line bg-surface overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-surface-raised border-b border-line">
                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                            <th class="px-4 py-3 whitespace-nowrap">When</th>
                            <th class="px-4 py-3 whitespace-nowrap">Moved by</th>
                            <th class="px-4 py-3 whitespace-nowrap">Line</th>
                            <th class="px-4 py-3 min-w-[320px]">Move</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var item in items)
                        {
                            <tr @key="item.AuditEventId">
                                <td class="px-4 py-3 text-content-muted whitespace-nowrap"
                                    title="@item.OccurredAt.LocalDateTime.ToString("d MMM yyyy, HH:mm:ss")">@Ago(item.OccurredAt)</td>
                                <td class="px-4 py-3 text-content-muted whitespace-nowrap">@Dash(item.ActorEmail)</td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <span class="font-mono text-xs text-content-muted">@Dash(item.RecordReference)</span>
                                </td>
                                <td class="px-4 py-3 text-content">@item.Detail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (nextCursor is not null)
            {
                <div class="mt-4 text-center">
                    <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
        </LoadGate>
    </ProjectPageShell>
}

@code {
    private const int PageSize = 50;

    [Parameter] public string ProjectId { get; set; } = "";

    // Session checked and the user signed in. This is NOT "the trail is here" — that is `loaded`,
    // below; keeping the two apart lets the page chrome show while the first page is in flight.
    private bool sessionReady;
    private bool loaded;
    private bool loadingMore;
    private string? loadError;

    private readonly List<AuditEvent> items = new();
    private string? nextCursor;
    private int total;

    // Mirrors the sidebar's Financials gate (DesktopNavigation.FinanceRoles) and the API's
    // CommercialTeam gate on the recode-filtered audit read (AuditEndpoints).
    private bool CanAccess => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.FinanceDirector
             or Role.ProjectManager or Role.QuantitySurveyor);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        // Paint the chrome before the fetch: Blazor re-renders OnInitializedAsync only at its
        // FIRST await, which has already passed, so without this the page waits on the first page.
        StateHasChanged();
        if (!Session.IsApproved || !CanAccess) { loaded = true; return; }
        await LoadAsync(reset: true);
    }

    private Task LoadMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            loaded = false;
            items.Clear();
            nextCursor = null;
            total = 0;
        }
        loadError = null;
        loadingMore = !reset;
        try
        {
            var page = await Queries.AskAsync(
                new ListAuditEvents(
                    ProjectId,
                    null,
                    AuditEventType.CostCentreRecoded,
                    null,
                    nextCursor,
                    PageSize),
                CancellationToken.None);
            items.AddRange(page.Items);
            nextCursor = page.NextCursor;
            total = page.Total;
        }
        catch
        {
            loadError = "Couldn't load the reconciliation audit. Please try again.";
        }
        finally
        {
            loaded = true;
            loadingMore = false;
        }
    }

    // Compact relative stamp for scanning; the exact moment sits in the cell's hover title.
    private static string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.UtcNow - at;
        if (span < TimeSpan.FromMinutes(1)) return "just now";
        if (span < TimeSpan.FromHours(1)) return $"{(int)span.TotalMinutes}m ago";
        if (span < TimeSpan.FromHours(24)) return $"{(int)span.TotalHours}h ago";
        if (span < TimeSpan.FromDays(30)) return $"{(int)span.TotalDays}d ago";
        return at.LocalDateTime.ToString("d MMM yyyy");
    }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
