@page "/projects/{ProjectId}/architect-instructions"
@using Jewel.JPMS.Contracts.ArchitectInstructions
@inject AuthService Auth
@inject SessionService Session
@inject IArchitectInstructionStore Instructions
@inject IVariationStore Variations
@inject NavigationManager Nav

<PageTitle>Architect's Instructions · JPMS</PageTitle>

@*
    The project's register of Architect's Instructions — the formal written instructions that turn
    "we'd like this changed" into work Jewel is entitled to be paid for. An instruction is what a
    variation sitting at Awaiting AI is waiting for, so each one can be linked to the variations it
    covers: one instruction routinely instructs several, and an instruction can land before the
    variation it will end up justifying exists.

    Instructions arrive two ways and both land here — emailed to the projects mailbox and imported
    from the attachment, or filed straight into this register by the architect or the Jewel team.
*@

@if (!sessionReady)
{
    <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@(Auth.CurrentUser?.Email ?? "")" DisplayName="@(Auth.CurrentUser?.DisplayName ?? "")" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="architect-instructions">
        <div class="flex items-start justify-between gap-3 mb-5">
            <div>
                <h2 class="text-xl font-semibold text-content">Architect's Instructions</h2>
                <p class="text-sm text-content-muted mt-1">
                    The formal instructions authorising varied work, and the variations each one covers.
                </p>
            </div>
            @if (CanManage)
            {
                <button type="button" class="btn-primary shrink-0" disabled="@busy" @onclick="OpenFileDialog">
                    File an instruction
                </button>
            }
        </div>

        @if (error is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @* A failed load must open the panel, or the jewel pulses for ever; the banner above carries
           the reason, and claiming "none recorded" over a fetch that failed would be worse still. *@
        <Panel IsLoading="@(instructions is null && error is null)">
            @if (instructions is null || instructions.Count == 0)
            {
                @if (error is null)
                {
                    <p class="text-sm text-content-subtle">
                        No instructions recorded on this project yet.
                        @if (CanManage)
                        {
                            <text>File one when it arrives — by email or straight from the architect.</text>
                        }
                    </p>
                }
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wider text-content-subtle border-b border-line">
                                <th class="py-2 pr-3 font-semibold">Ref</th>
                                <th class="py-2 pr-3 font-semibold">Title</th>
                                <th class="py-2 pr-3 font-semibold">Instructed</th>
                                <th class="py-2 pr-3 font-semibold">Issued by</th>
                                <th class="py-2 pr-3 font-semibold">Variations</th>
                                <th class="py-2 pr-3 font-semibold">Document</th>
                                <th class="py-2 font-semibold"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in instructions!)
                            {
                                var instruction = item;
                                <tr class="border-b border-line/60 align-top">
                                    <td class="py-2.5 pr-3">
                                        <span class="font-mono text-content">@instruction.DisplayReference</span>
                                        @if (!string.Equals(instruction.DisplayReference, instruction.Reference, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="block text-[11px] text-content-subtle font-mono">@instruction.Reference</span>
                                        }
                                    </td>
                                    <td class="py-2.5 pr-3 text-content">
                                        @instruction.Title
                                        @if (!string.IsNullOrWhiteSpace(instruction.Notes))
                                        {
                                            <span class="block text-xs text-content-subtle">@instruction.Notes</span>
                                        }
                                    </td>
                                    <td class="py-2.5 pr-3 text-content-muted whitespace-nowrap">@Date(instruction.InstructedAt ?? instruction.ReceivedAt)</td>
                                    <td class="py-2.5 pr-3 text-content-muted">
                                        @(string.IsNullOrWhiteSpace(instruction.IssuedByEmail) ? "—" : instruction.IssuedByEmail)
                                        <span class="block text-[11px] text-content-subtle">
                                            @(instruction.Source == ArchitectInstructionSource.Email ? "From email" : "Uploaded")
                                        </span>
                                    </td>
                                    <td class="py-2.5 pr-3">
                                        @if (instruction.Links.Count == 0)
                                        {
                                            <span class="text-content-subtle text-xs">Not linked</span>
                                        }
                                        else
                                        {
                                            <div class="flex flex-wrap gap-1">
                                                @foreach (var link in instruction.Links)
                                                {
                                                    <a href="@($"/projects/{ProjectId}/variations/{link.VariationOrderId}")"
                                                       title="@($"{link.Title} — {link.Status.DisplayName()}")"
                                                       class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-mono bg-surface-raised border border-line text-content-muted hover:text-content">
                                                        @link.DisplayNumber
                                                    </a>
                                                }
                                            </div>
                                        }
                                        @if (CanManage)
                                        {
                                            <button type="button" class="mt-1 text-[11px] text-accent hover:underline"
                                                    disabled="@busy" @onclick="() => OpenLinkDialog(instruction)">Link a variation…</button>
                                        }
                                    </td>
                                    <td class="py-2.5 pr-3">
                                        @if (instruction.HasFile)
                                        {
                                            <a class="text-accent hover:underline text-xs"
                                               href="@Instructions.FileUrl(instruction.ArchitectInstructionId)"
                                               target="_blank" rel="noopener">@(instruction.FileName ?? "Open")</a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-content-subtle" title="No document has been attached yet">Awaited</span>
                                        }
                                    </td>
                                    <td class="py-2.5 text-right">
                                        @if (CanManage)
                                        {
                                            <button type="button" class="text-[11px] text-content-subtle hover:text-negative"
                                                    disabled="@busy" @onclick="() => OpenDeleteDialog(instruction)">Delete…</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Panel>
    </ProjectPageShell>

    <Modal IsOpen="fileDialogOpen"
           Title="File an Architect's Instruction"
           ConfirmLabel="@(busy ? "Filing…" : "File instruction")"
           ConfirmDisabled="@busy"
           OnCancel="() => fileDialogOpen = false"
           OnConfirm="SubmitInstruction"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (dialogError is not null)
            {
                <Notice Tone="Tone.Negative">@dialogError</Notice>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Instruction ref" Value="@formRef" OnChange="v => formRef = v" />
                <FormField Label="Date instructed" Value="@formInstructedAt" OnChange="v => formInstructedAt = v" InputType="date" />
            </div>
            <p class="-mt-2 text-xs text-content-subtle">
                The architect's own number as written on the instruction. The portal always gives it one of ours too.
            </p>

            @* Not marked required: an instruction that arrives as "AI 042" with no covering title is
               a real thing, and the server accepts either a reference or a title. *@
            <FormField Label="Title" Value="@formTitle" OnChange="v => formTitle = v" />
            <FormField Label="Issued by (architect's email)" Value="@formIssuedBy" OnChange="v => formIssuedBy = v" />

            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Notes</label>
                <textarea class="field" rows="3" value="@formNotes"
                          @oninput="e => formNotes = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>

            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Document</label>
                <InputFile OnChange="OnInstructionFileSelected" accept=".pdf,image/*,.doc,.docx" class="text-sm" />
                <p class="mt-1 text-xs text-content-subtle">
                    @(formFile is null
                        ? "Optional — file the row now and attach the document when it arrives."
                        : formFile.Name)
                </p>
            </div>

            @if (VariationOptions.Count > 0)
            {
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Covers these variations</label>
                    <p class="text-xs text-content-subtle mb-2">
                        Variations waiting on an instruction are listed first — linking one here saves going back for it.
                    </p>
                    <ul class="space-y-1 max-h-48 overflow-y-auto">
                        @foreach (var option in VariationOptions)
                        {
                            var variation = option;
                            <li>
                                <label class="flex items-start gap-2 text-sm text-content">
                                    <input type="checkbox" class="mt-0.5"
                                           checked="@formVariationIds.Contains(variation.VariationOrderId)"
                                           @onchange="e => ToggleVariation(variation.VariationOrderId, e.Value is true)" />
                                    <span>
                                        <span class="font-mono">@variation.DisplayNumber</span>
                                        <span class="text-content-subtle"> — @variation.Title (@variation.Status.DisplayName())</span>
                                    </span>
                                </label>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </Modal>

    <Modal IsOpen="@(linking is not null)"
           Title="@(linking is null ? "Link a variation" : $"Link {linking.DisplayReference} to a variation")"
           ShowFooter="false"
           OnCancel="() => linking = null"
           Class="max-w-xl">
        <div class="space-y-3">
            @if (dialogError is not null)
            {
                <Notice Tone="Tone.Negative">@dialogError</Notice>
            }
            @if (VariationOptions.Count == 0)
            {
                <p class="text-sm text-content-subtle">This project has no variations to link to yet.</p>
            }
            else
            {
                <ul class="space-y-1 max-h-80 overflow-y-auto">
                    @foreach (var option in VariationOptions)
                    {
                        var variation = option;
                        var alreadyLinked = linking?.Links.Any(l => l.VariationOrderId == variation.VariationOrderId) == true;
                        <li class="flex items-center justify-between gap-3 text-sm">
                            <span>
                                <span class="font-mono">@variation.DisplayNumber</span>
                                <span class="text-content-subtle"> — @variation.Title (@variation.Status.DisplayName())</span>
                            </span>
                            @if (alreadyLinked)
                            {
                                <button type="button" class="text-xs text-content-subtle hover:text-negative"
                                        disabled="@busy" @onclick="() => Unlink(variation.VariationOrderId)">Unlink</button>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary text-xs"
                                        disabled="@busy" @onclick="() => Link(variation.VariationOrderId)">Link</button>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </Modal>

    <Modal IsOpen="@(confirmingDelete is not null)"
           Title="@(confirmingDelete is null ? "Delete" : $"Delete {confirmingDelete.DisplayReference}?")"
           ConfirmLabel="@(busy ? "Deleting…" : "Delete instruction")"
           CancelLabel="Keep it"
           ConfirmDisabled="@busy"
           OnCancel="() => confirmingDelete = null"
           OnConfirm="ConfirmDelete"
           Class="max-w-md">
        <div class="space-y-3">
            @if (dialogError is not null)
            {
                <Notice Tone="Tone.Negative">@dialogError</Notice>
            }
            <p class="text-sm text-content-subtle">
                Permanently removes the instruction, its stored document and its links to variations. The variations
                themselves are untouched. This can't be undone.
            </p>
        </div>
    </Modal>
}

