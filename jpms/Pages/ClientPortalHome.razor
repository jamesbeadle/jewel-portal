@page "/client"
@using Jewel.JPMS.Contracts.ClientPortal
@using Jewel.JPMS.Features.ClientPortal
@inject AuthService Auth
@inject SessionService Session
@inject IClientPortalStore ClientPortal
@inject NavigationManager Nav

<PageTitle>My projects · JPMS</PageTitle>

<Page>
    @if (!CanAccess)
    {
        <h1 class="text-2xl font-semibold text-content mb-2">Not available</h1>
        <p class="text-content-muted">This page is for client accounts.</p>
    }
    else if (!HasLinkedRecord)
    {
        @* The session has the Client role but no linked account (typically an admin or internal
           user browsing here) — say so immediately instead of firing calls that will 403. *@
        <section class="px-4 md:px-8 py-12">
            <h1 class="text-2xl font-semibold text-content mb-2">No account linked</h1>
            <p class="text-content-muted">
                This page shows a client their projects' requests for information and variation orders.
                Your login isn't linked to a client account — clients are invited from their account on
                the Clients page, which links their login and scopes everything here to their projects.
            </p>
        </section>
    }
    else
    {
        <header>
            <h1 class="text-2xl md:text-3xl font-semibold text-content">Your projects</h1>
            <p class="text-sm text-content-muted mt-1">
                Requests for information and variation orders on your projects. Open one to read
                the thread and add your comments — the project team sees them straight away.
            </p>
        </header>

        @if (loadError is not null)
        {
            <Notice Tone="Tone.Negative">@loadError</Notice>
        }

        <div>
            <h2 class="text-base font-semibold text-content mb-3">Requests for information</h2>
            <LoadGate IsLoading="@(requests is null && loadError is null)" Prominent="true" Label="Loading requests">
                <ClientRequestList Requests="@(requests ?? Array.Empty<ClientPortalRequest>())" />
            </LoadGate>
        </div>

        <div>
            <h2 class="text-base font-semibold text-content mb-3">Variation orders</h2>
            <LoadGate IsLoading="@(orders is null && loadError is null)" Prominent="true" Label="Loading variation orders">
                <ClientVariationList Orders="@(orders ?? Array.Empty<ClientPortalVariationOrder>())" />
            </LoadGate>
        </div>
    }
</Page>

@code {
    private bool sessionReady;
    private string? loadError;
    private IReadOnlyList<ClientPortalRequest>? requests;
    private IReadOnlyList<ClientPortalVariationOrder>? orders;

    private bool CanAccess => Session.AvailableRoles.Contains(Role.Client);
    private bool HasLinkedRecord => !string.IsNullOrEmpty(Auth.CurrentClientId);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        if (!Session.IsApproved || !CanAccess || !HasLinkedRecord) return;
        StateHasChanged();
        try
        {
            requests = await ClientPortal.ListRequestsAsync();
            orders = await ClientPortal.ListVariationOrdersAsync();
        }
        catch
        {
            // A failed fetch must open the gates — the red bar says why.
            loadError = "Couldn't load your projects' records. Reload to try again.";
        }
    }
}
