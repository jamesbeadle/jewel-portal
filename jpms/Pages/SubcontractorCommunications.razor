@page "/subcontractors/communications"
@page "/subcontractors/communications/{Category?}"
@page "/suppliers/communications"
@page "/suppliers/communications/{Category?}"
@page "/internal/communications"
@page "/internal/communications/{Category?}"
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Triage.Panels
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList

<PageTitle>Communications · JPMS</PageTitle>

@*
    The Subcontractor folder's Communications page: every email tagged with the SubComms family —
    general subcontractor correspondence plus its categories (Chaser / Info request / Materials /
    H&S), filed at triage with the Subcontractor tab's communication ticks — read live from the
    mailbox, newest first, in the shared thread list (threads group, any email expands to its full
    body, and every email carries the consistent Reply and Forward widget — sending from here SENDS
    there and then; the sent copy inherits the thread's tags and files back into this list). The
    chip row narrows the list to one category. Tagging (and untagging, from the Control Centre's
    Tagged view) stays in mailbox triage.

    The same page serves Supplier → Communications (2026-08-27) and Internal → Communications
    (2026-08-22): the route picks the family (CommunicationFamily.ForRoute), and everything else —
    chips, copy, the tags read — follows it. A category segment ("…/communications/chaser") is the
    register deep link the sidebar rows and the Control Centre panes' "Full register →" use: the
    page opens with that category's chip preselected.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">@family.Pathway</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Communications</h1>
            @if (loaded && total > 0)
            {
                <p class="text-sm text-content-muted mt-2">
                    @total email@(total == 1 ? "" : "s") @(categoryTagFilter is null ? $"tagged as {family.Label.ToLowerInvariant()}" : $"tagged {ActiveFilterLabel}").
                </p>
            }
        </header>

        @* The category chips — a filter control, so never gated: they render from the contracts
           constant alone, usable before the first page lands, and stay put when a category comes
           back empty. *@
        <div class="flex flex-wrap items-center gap-1.5 mb-4">
            <button type="button" class="@ChipClass(null)" title="@($"Every {family.Label.ToLowerInvariant()}, whatever its category")"
                    @onclick="() => SetCategoryFilterAsync(null)">All</button>
            @foreach (var familyRecord in family.Offered)
            {
                var familyTag = CommunicationFamily.TagFor(familyRecord);
                <button type="button" @key="familyRecord.RecordId" class="@ChipClass(familyTag)" title="@familyRecord.Summary"
                        @onclick="() => SetCategoryFilterAsync(familyTag)">@family.ChipLabel(familyRecord)</button>
            }
        </div>

        @if (loadError is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@loadError</Notice>
        }

        <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading communications">
        @if (items.Count == 0)
        {
            @* A failed fetch leaves the list empty; the banner above says so, and "nothing tagged
               yet" would read as an answer rather than a failure. *@
            @if (loadError is null)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@(categoryTagFilter is null ? $"No {family.Label.ToLowerInvariant()}s yet." : $"Nothing tagged {ActiveFilterLabel} yet.")</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tick "@family.Label" — or one of its categories — in the Control Centre's @family.Pathway pane and the thread appears here.
                    </p>
                </div>
            }
        }
        else
        {
            @if (replySent is not null)
            {
                <div class="rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
                    <p class="text-sm text-content">@replySent</p>
                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                            @onclick="() => replySent = null">✕</button>
                </div>
            }
            @if (replyTo is { } replyingTo)
            {
                <div class="mb-4 space-y-2">
                    <p class="text-sm text-content-muted">
                        @(composeIsForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@(string.IsNullOrWhiteSpace(replyingTo.FromName) ? replyingTo.FromEmail : replyingTo.FromName)</span> —
                        <span class="italic">@replyingTo.Subject</span>
                    </p>
                    <MailReplyComposer @key="@($"{replyingTo.Id}:{composeIsForward}")" ReplyTo="replyingTo" Forward="composeIsForward"
                                       Projects="@(ProjectList.Current ?? Array.Empty<Project>())"
                                       FooterNote="@(composeIsForward
                                           ? "The forward sends now from the projects mailbox and files itself back into this list."
                                           : "The reply sends now from the projects mailbox and files itself back into this list.")"
                                       OnSent="OnReplySent" OnCancel="() => replyTo = null" />
                </div>
            }
            <CorrespondenceThreadList Emails="items" ExcludeTag="@ImpliedTag"
                                      OnReply="email => StartCompose(email, forward: false)"
                                      OnForward="email => StartCompose(email, forward: true)" />

            @if (nextCursor is not null)
            {
                <div class="mt-4 text-center">
                    <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
        </LoadGate>
    </section>
}
