@page "/subcontractors/communications"
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Features.Subcontractors
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake

<PageTitle>Communications · JPMS</PageTitle>

@*
    The Subcontractor folder's Communications page: every email tagged "JPMS/SubComms" — general
    subcontractor correspondence filed at triage with the Subcontractor tab's communication tick —
    read live from the mailbox, newest first. Informational only: tagging (and untagging, from the
    Control Centre's Tagged view) stays in mailbox triage.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">Subcontractor</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Communications</h1>
            @if (loaded && total > 0)
            {
                <p class="text-sm text-content-muted mt-2">
                    @total email@(total == 1 ? "" : "s") tagged as subcontractor communication.
                </p>
            }
        </header>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@loadError</p>
        }

        <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading communications">
        @if (items.Count == 0)
        {
            @* A failed fetch leaves the list empty; the banner above says so, and "nothing tagged
               yet" would read as an answer rather than a failure. *@
            @if (loadError is null)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No subcontractor communications yet.</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tick "Subcontractor communication" in the Control Centre's System Tags and the thread appears here.
                    </p>
                </div>
            }
        }
        else
        {
            <ul class="space-y-2">
                @foreach (var message in items)
                {
                    <SubcontractorCommunicationRow @key="message.Id" Message="message" />
                }
            </ul>

            @if (nextCursor is not null)
            {
                <div class="mt-4 text-center">
                    <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
        </LoadGate>
    </section>
}
