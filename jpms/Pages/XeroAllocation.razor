@page "/finance/allocation"
@using Jewel.JPMS.Features.Projects
@using Jewel.JPMS.Features.Xero
@inject AuthService Auth
@inject SessionService Session
@inject IXeroLedgerStore Ledger
@inject IQueryClient Queries
@inject ICostCenterStore CostCenters
@inject ILabourStore Labour
@inject ISubcontractorStore Subcontractors
@inject ProjectListReadModel ProjectsReadModel
@inject AllocationTabStorage TabStorage
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Cost allocation · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="w-full px-6 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    @* Full-width (no max-w cap): the allocation table is the whole page. A capped,
       centred container left growing side margins when zooming out instead of giving
       the columns the reclaimed space. *@
    <section class="w-full px-6 py-8 md:py-12">
        <WorkspaceSectionNav />
        <header class="mb-6 md:mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · Financials · Xero</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Cost allocation</h1>
                <p class="text-sm text-content-muted mt-2">
                    Reconcile the accounts system with the projects: every Xero cost-of-sales purchase line
                    (nominal accounts starting 3) is allocated to a project and master cost centre — or split
                    across several centres. Suggestions come from the line's Xero tracking — you confirm.
                    Once every line of a draft bill (published from Dext) is allocated, its Sites and Cost Code
                    tracking are confirmed back to Xero and the bill is approved automatically.
                </p>
            </div>
            <div class="flex items-center gap-4 whitespace-nowrap">
                <button class="text-sm font-medium text-content-muted hover:text-content underline underline-offset-4 disabled:opacity-50"
                        disabled="@isBusy" @onclick="RecheckMatchesAsync">
                    @(isRechecking ? "Re-checking…" : "Re-check matches")
                </button>
                <button class="text-sm font-medium text-content-muted hover:text-content underline underline-offset-4 disabled:opacity-50"
                        disabled="@isBusy" @onclick="SyncAsync">
                    @(isSyncing ? "Syncing…" : "Sync from Xero")
                </button>
            </div>
        </header>

        @if (syncMessage is not null)
        {
            <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-sm text-content-muted mb-6">@syncMessage</div>
        }
        @if (errorMessage is not null)
        {
            <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-sm text-content mb-6">@errorMessage</div>
        }

        @* This gate asks about the LEDGER, not about the open tab. It has to: the tab bar lives
           inside the else branch, so gating on the open tab's own emptiness would hide the tab bar
           whenever someone returned to a tab that happens to be empty — and the tab is remembered
           between sessions, so they would have had no way to get back out. The counts come from the
           server and cover every status. *@
        @if (!tabRestored || Ledger.Counts() is not { } counts)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading the stored ledger" />
        }
        else if (LedgerTotal(counts) == 0)
        {
            <p class="text-sm text-content-subtle py-8">
                Nothing stored yet — press “Sync from Xero” to pull the purchase ledger in for allocation.
            </p>
        }
        else
        {
            @if (activeTab == XeroAllocationStatus.Unallocated && !labourTab && FullyMatchedCount > 0)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
                    <span class="text-content-muted">
                        <span class="text-content font-medium">@FullyMatchedCount lines</span> have both a project and a
                        cost centre matched from their Xero tracking.
                    </span>
                    @if (!confirmAllocateMatched)
                    {
                        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                                disabled="@isBusy" @onclick="() => confirmAllocateMatched = true">
                            Allocate all matched…
                        </button>
                    }
                    else
                    {
                        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                                disabled="@isBusy" @onclick="AllocateMatchedAsync">
                            @(isBusy ? "Allocating…" : $"Confirm — allocate {FullyMatchedCount} lines")
                        </button>
                        <button class="text-xs text-content-subtle underline underline-offset-4"
                                @onclick="() => confirmAllocateMatched = false">Cancel</button>
                    }
                    <span class="text-xs text-content-subtle">Noted as auto-matched; each line stays reversible via Undo.</span>
                </div>
            }

            <div class="mb-4 flex items-center justify-between gap-4 flex-wrap">
                @* The incoming queue is split by project: a line whose project is real —
                   saved via Set, or suggested by its Xero tracking — sits in that
                   project's tab, so people working a specific project approve just their
                   own costs. Dropdown picks alone don't move rows; Set/Allocate do.
                   "Unallocated" keeps only the lines nothing points at a project yet. *@
                @* Every count in the bar is counted here, out of the unallocated queue and the
                   project list — a bar drawn before those land offers "Unallocated (0)" and no
                   project tabs at all. *@
                <LoadGate IsLoading="@(!TabBarReady)" Height="min-h-[38px]" Label="Loading tabs">
                <div class="inline-flex flex-wrap rounded-lg border border-line overflow-hidden">
                    <button class="@TabClass(XeroAllocationStatus.Unallocated)" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated)">
                        Unallocated (@UnassignedCount)
                    </button>
                    @foreach (var tab in ProjectTabs)
                    {
                        var projectId = tab.ProjectId;
                        <button class="@ProjectTabClass(projectId)" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated, projectId)">
                            @tab.Name (@tab.Count)
                        </button>
                    }
                    @* Labour recognition (scope §6): bills whose supplier is a worker on the
                       labour registry are settlement of timesheets, not costs to allocate — they
                       fall in this section instead of the queue. The count is the outstanding
                       (unmarked) lines, the actionable number, like every other tab. *@
                    @if (LabourTotalCount > 0 || labourTab)
                    {
                        <button class="@LabourTabClass()" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated, labour: true)">
                            Labour (@LabourOutstandingCount)
                        </button>
                    }
                    <button class="@TabClass(XeroAllocationStatus.Allocated)" @onclick="() => SwitchTab(XeroAllocationStatus.Allocated)">
                        Allocated (@CountOf(XeroAllocationStatus.Allocated))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Bucketed)" @onclick="() => SwitchTab(XeroAllocationStatus.Bucketed)">
                        Buckets (@CountOf(XeroAllocationStatus.Bucketed))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Disputed)" @onclick="() => SwitchTab(XeroAllocationStatus.Disputed)">
                        Disputed (@CountOf(XeroAllocationStatus.Disputed))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Ignored)" @onclick="() => SwitchTab(XeroAllocationStatus.Ignored)">
                        Ignored (@CountOf(XeroAllocationStatus.Ignored))
                    </button>
                </div>
                </LoadGate>
                <div class="flex items-center gap-4">
                    <ExportToExcelButton FileName="Cost allocation"
                                         Disabled="@(Visible.Count == 0)"
                                         ShowIncludeAllRows="@(PageCount > 1)"
                                         BuildWorkbook="BuildExportWorkbook" />
                    @if (activeTab == XeroAllocationStatus.Allocated)
                    {
                        @* Narrow to one project first, then search within it — the
                           recode workflow: isolate what's coded where, select, resend. *@
                        <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="All projects"
                                      Value="@allocatedProjectFilter" ValueChanged="OnAllocatedProjectFilterChanged" />
                    }
                    <input class="text-sm bg-surface border border-line rounded-lg px-3 py-1.5 text-content placeholder:text-content-subtle w-64"
                           placeholder="@(activeTab == XeroAllocationStatus.Allocated
                                          ? "Search supplier, cost centre, number…"
                                          : "Search supplier, description, number…")"
                           value="@search" @oninput="OnSearchChanged" />
                </div>
            </div>

            @* The Labour section's own strip: what it is, and the covered fold. Sits where the
               matched banner sits on the plain queue — the section IS the explanation. *@
            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 text-sm text-content-muted flex items-start justify-between gap-4 flex-wrap">
                    <p class="max-w-3xl">
                        These bills' suppliers are workers on the labour registry, so each is
                        <span class="text-content font-medium">settlement of timesheets</span>, not a cost to
                        allocate — the approved time already carries the cost per project.
                        Mark a bill against its month and the
                        <a class="underline underline-offset-4 hover:text-content" href="/labour/overview">Labour overview's Settlement view</a>
                        reconciles it and codes it into Xero, split by site and cost code.
                    </p>
                    @if (LabourCoveredCount > 0)
                    {
                        <button class="text-xs text-content-subtle underline underline-offset-4 hover:text-content whitespace-nowrap"
                                @onclick="() => showCoveredLabour = !showCoveredLabour">
                            @(showCoveredLabour ? "Hide covered" : $"Show covered ({LabourCoveredCount})")
                        </button>
                    }
                </div>
            }

            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab && selectedIds.Count > 0)
            {
                <BulkSelectionBar Count="selectedIds.Count" OnClear="() => selectedIds.Clear()">
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            title="Mark every selected line as settlement of its worker's month — lines without a linked subcontractor company or a bill date are skipped and reported"
                            disabled="@isBusy" @onclick="BulkMarkCoverAsync">Mark selected as settlement</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@isBusy" @onclick="BulkUnmarkCoverAsync">Un-mark selected</button>
                </BulkSelectionBar>
            }

            @if (activeTab == XeroAllocationStatus.Unallocated && !labourTab && selectedIds.Count > 0)
            {
                <BulkSelectionBar Count="selectedIds.Count" OnClear="() => selectedIds.Clear()">
                    <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="Project…"
                                  @bind-Value="bulkProjectId" />
                    <SearchSelect Options="@CostCenterOptions" WidthClass="w-52" Placeholder="Cost centre…"
                                  @bind-Value="bulkCostCenterCode" />
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkProjectId) || string.IsNullOrEmpty(bulkCostCenterCode))"
                            @onclick="BulkAllocateAsync">Allocate selected</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            title="Save the project and set its Xero site on every selected line — moves them to that project's tab, cost centres to follow"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkProjectId))"
                            @onclick="BulkSetProjectAsync">Set selected</button>
                    <span class="text-content-subtle">·</span>
                    <select class="bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm" @bind="bulkBucket">
                        <option value="">Bucket…</option>
                        @foreach (var bucket in XeroBuckets.All)
                        {
                            <option value="@bucket">@bucket</option>
                        }
                    </select>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkBucket))" @onclick="BulkBucketAsync">Bucket selected</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@isBusy" @onclick="BulkIgnoreAsync">Ignore selected</button>
                </BulkSelectionBar>
            }

            @if (activeTab == XeroAllocationStatus.Allocated && selectedIds.Count > 0)
            {
                <BulkSelectionBar Count="selectedIds.Count" OnClear="() => selectedIds.Clear()">
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            disabled="@isBusy" @onclick="OpenSendToCostCentre">Send to cost centre…</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            title="Move the selected lines to another project — each keeps its cost centre, and the Xero site is rewritten"
                            disabled="@isBusy" @onclick="OpenSendToProject">Send to project…</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            title="Return the selected lines to the unallocated queue"
                            disabled="@isBusy" @onclick="BulkUndoAsync">Undo selected</button>
                </BulkSelectionBar>
            }

            @* One panel: the bucket totals, the rows and the footer's line count and net are all
               read off the open tab's lines, named through the project and cost-centre masters. *@
            <LoadGate IsLoading="@(!QueueReady)" Prominent="true" Label="Loading lines">
            @if (activeTab == XeroAllocationStatus.Bucketed)
            {
                <div class="mb-4 flex flex-wrap gap-2">
                    @foreach (var bucket in XeroBuckets.All)
                    {
                        <button class="@BucketChipClass(bucket)" @onclick="() => ToggleBucketFilter(bucket)">
                            @bucket · @Money(BucketTotal(bucket))
                        </button>
                    }
                </div>
            }

            @* The table used to run 82rem wide — date, supplier and description each had a
               column, and the queue row carried three dropdowns plus seven buttons — so on a
               laptop the actions sat off the right edge behind a scrollbar. Now the line's
               identity (supplier, description, date, invoice number, Xero site and code)
               stacks in ONE cell that flexes to whatever width is left, the coding dropdowns
               keep their fixed widths, and each row ends in one primary button plus a menu.
               While a row's menu is open the overflow cap is lifted: the menu positions
               absolutely inside this container, and with the overflow active its bottom
               entries would be clipped at the container's edge. *@
            <div class="rounded-xl border border-line bg-surface @(IsRowMenuOpen ? "" : "overflow-x-auto overflow-y-auto max-h-[85vh]")">
                <table class="w-full text-sm">
                    <thead class="bg-surface-raised border-b border-line">
                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                            @if (activeTab is XeroAllocationStatus.Unallocated or XeroAllocationStatus.Allocated)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-8">
                                    <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                                </th>
                            }
                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3">Line</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right">Net</th>
                            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Worker</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else if (activeTab == XeroAllocationStatus.Unallocated)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Project</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-52">Cost centre</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else if (activeTab == XeroAllocationStatus.Disputed)
                            {
                                @* The dispute workbench: the coding both sides are converging on is
                                   edited and SAVED here (visible to the other party), the thread is a
                                   click away, and either side returns the line to allocation. *@
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Project</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-52">Cost centre</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3">
                                    @(activeTab == XeroAllocationStatus.Allocated ? "Allocated to"
                                      : activeTab == XeroAllocationStatus.Bucketed ? "Bucket" : "Reason")
                                </th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 hidden md:table-cell">By</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var line in Paged)
                        {
                            @* Keyed so a row's component state (an open menu, a dropdown's
                               filter text) stays with its line when paging or searching
                               re-orders the rows, instead of migrating to whichever line
                               now sits at that index. *@
                            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
                            {
                                <LabourLineRow @key="line.XeroLedgerLineId"
                                               Line="line"
                                               Selected="@selectedIds.Contains(line.XeroLedgerLineId)"
                                               OnToggleSelected="() => ToggleSelected(line.XeroLedgerLineId)"
                                               OnOpenInvoice="OpenInvoiceView"
                                               Busy="isBusy"
                                               DirectoryOptions="@DirectoryOptions"
                                               DirectoryLoaded="Subcontractors.IsLoaded"
                                               LinkPick="@InlineLinkPickFor(line)"
                                               OnLinkPickChanged="value => inlineLinkPicks[line.XeroLedgerLineId] = value"
                                               OnLinkWorker="() => LinkWorkerInlineAsync(line)"
                                               OnMarkSoleTrader="() => MarkSoleTraderInlineAsync(line)"
                                               OnMarkCover="() => MarkCoverAsync(line)"
                                               OnUnmarkCover="() => UnmarkCoverAsync(line)"
                                               MenuItems="LabourRowMenuItems(line)"
                                               OnMenuOpenChanged="open => TrackRowMenu(line.XeroLedgerLineId, open)" />
                            }
                            else if (activeTab == XeroAllocationStatus.Unallocated)
                            {
                                <QueueLineRow @key="line.XeroLedgerLineId"
                                              Line="line"
                                              Selected="@selectedIds.Contains(line.XeroLedgerLineId)"
                                              OnToggleSelected="() => ToggleSelected(line.XeroLedgerLineId)"
                                              OnOpenInvoice="OpenInvoiceView"
                                              Busy="isBusy"
                                              ProjectValue="@SelectedProjectFor(line)"
                                              ProjectOptions="@ProjectOptions"
                                              OnProjectPicked="value => SetProject(line.XeroLedgerLineId, value)"
                                              CostCenterValue="@SelectedCostCenterFor(line)"
                                              CostCenterOptions="@CostCenterOptions"
                                              OnCostCenterPicked="value => SetCostCenter(line.XeroLedgerLineId, value)"
                                              ArmedBucket="@SelectedBucketFor(line)"
                                              CanAllocate="CanAllocate(line)"
                                              OnAllocate="() => AllocateAsync(line)"
                                              OnBucket="bucket => BucketAsync(line, bucket)"
                                              CanSetProject="CanSetProject(line)"
                                              OnSetProject="() => SetProjectAsync(line)"
                                              MenuItems="QueueRowMenuItems(line)"
                                              OnMenuOpenChanged="open => TrackRowMenu(line.XeroLedgerLineId, open)" />
                            }
                            else if (activeTab == XeroAllocationStatus.Disputed)
                            {
                                <DisputedLineRow @key="line.XeroLedgerLineId"
                                                 Line="line"
                                                 OnOpenInvoice="OpenInvoiceView"
                                                 Busy="isBusy"
                                                 ProjectValue="@SelectedProjectFor(line)"
                                                 ProjectOptions="@ProjectOptions"
                                                 OnProjectPicked="value => SetProject(line.XeroLedgerLineId, value)"
                                                 CostCenterValue="@SelectedCostCenterFor(line)"
                                                 CostCenterOptions="@CostCenterOptions"
                                                 OnCostCenterPicked="value => SetCostCenter(line.XeroLedgerLineId, value)"
                                                 OnOpenDiscussion="() => OpenDiscussion(line)"
                                                 OnSaveCoding="() => SaveDisputedCodingAsync(line)"
                                                 OnResolve="() => ResolveDisputeAsync(line)" />
                            }
                            else
                            {
                                <AllocatedSummaryRow @key="line.XeroLedgerLineId"
                                                     Line="line"
                                                     Mode="activeTab"
                                                     ShowCheckbox="@(activeTab == XeroAllocationStatus.Allocated)"
                                                     Selected="@selectedIds.Contains(line.XeroLedgerLineId)"
                                                     OnToggleSelected="() => ToggleSelected(line.XeroLedgerLineId)"
                                                     OnOpenInvoice="OpenInvoiceView"
                                                     Busy="isBusy"
                                                     ProjectName="ProjectName"
                                                     CostCenterText="CostCenterText"
                                                     OnRetryWriteBack="() => RetryWriteBackAsync(line)"
                                                     OnUndo="() => ResetAsync(line)"
                                                     OnOpenDispute="() => OpenDispute(line)" />
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Tabs load independently now, so a tab can be mid-fetch or genuinely empty while the
               ledger as a whole is neither. Say which. *@
            @if (Visible.Count == 0)
            {
                <p class="text-sm text-content-subtle py-6 text-center">
                    @(HasTabFilters
                        ? "No lines match the current filters on this tab."
                        : "Nothing on this tab.")
                </p>
            }

            <div class="mt-3 flex items-center justify-between gap-4 flex-wrap">
                <p class="text-xs text-content-subtle">
                    @Visible.Count lines · @Money(Visible.Sum(SignedNet)) net.
                    Allocating every line of a draft bill writes its Sites / Cost Code tracking back to Xero
                    and approves it. Moving a line between projects (Set, or Send to project) rewrites its
                    Xero Sites tracking on draft and approved bills alike; paid bills are locked in Xero
                    and move in JPMS only. A disputed line waits on the Disputed tab — its bill is never
                    auto-approved — until either side returns it to allocation.
                </p>
                @if (PageCount > 1)
                {
                    <div class="flex items-center gap-3 text-xs text-content-muted">
                        <button class="underline underline-offset-4 disabled:opacity-40 disabled:no-underline"
                                disabled="@(page == 0)" @onclick="() => page--">‹ Prev</button>
                        <span>Page @(page + 1) of @PageCount</span>
                        <button class="underline underline-offset-4 disabled:opacity-40 disabled:no-underline"
                                disabled="@(page >= PageCount - 1)" @onclick="() => page++">Next ›</button>
                    </div>
                }
            </div>
            </LoadGate>
        }

        @* Hidden while the invoice document modal is open — a split started from
           the document viewer renders inline there instead, so the invoice stays
           readable while the amounts are keyed in. *@
        <Modal IsOpen="@(splitLine is not null && viewLine is null)" Title="Split across projects and cost centres"
               ConfirmLabel="@(isApplying ? "Allocating…" : "Allocate split")" CancelLabel="Cancel"
               ConfirmDisabled="@isBusy" OnConfirm="ApplySplitAsync" OnCancel="CloseSplit" Class="max-w-3xl">
            @if (splitLine is not null)
            {
                <div class="space-y-4">
                    <LedgerLineSummary Line="splitLine">
                        @(splitLine.InvoiceNumber ?? "—") · @Money(splitLine.Net) net
                    </LedgerLineSummary>
                    <SplitEditorForm Rows="splitRows" Net="@(splitLine?.Net ?? 0m)" Error="@splitError"
                                     ProjectOptions="@ProjectOptions" CostCenterOptions="@CostCenterOptions" />
                </div>
            }
        </Modal>

        @* Bulk recode from the Allocated tab: every selected line moves to the
           chosen cost centre, each keeping the project it's already allocated
           to. Re-allocating replaces any previous split (the API clears the
           split rows), so a line once shared across centres moves whole. *@
        <SendLinesModal IsOpen="@sendToCostCentreOpen" Title="Send to cost centre"
                        Error="@sendError" Busy="@isBusy" Applying="@isApplying"
                        SendableCount="SendableSelected.Count"
                        SendableNet="SendableSelected.Sum(SignedNet)"
                        SkippedCount="@(SelectedAllocated.Count - SendableSelected.Count)"
                        SkippedReason="split across more than one project, so there's no single project to keep"
                        DestinationNoun="cost centre"
                        KeepNote="Each line keeps its project — only the cost centre changes; a line previously split across centres moves whole."
                        XeroNote="Bills still awaiting approval have their new coding confirmed back to Xero; bills already approved in Xero are re-coded in JPMS only."
                        Options="@CostCenterOptions" Placeholder="Cost centre…"
                        @bind-Value="sendCostCenterCode"
                        OnConfirm="SendToCostCentreAsync" OnCancel="CloseSendToCostCentre" />

        @* Bulk re-site from the Allocated tab: the change-of-mind move — the Xero Sites
           tracking is rewritten to the new project's site (paid bills are locked in Xero
           and move in JPMS only). *@
        <SendLinesModal IsOpen="@sendToProjectOpen" Title="Send to project"
                        Error="@sendProjectError" Busy="@isBusy" Applying="@isApplying"
                        SendableCount="ProjectSendableSelected.Count"
                        SendableNet="ProjectSendableSelected.Sum(SignedNet)"
                        SkippedCount="@(SelectedAllocated.Count - ProjectSendableSelected.Count)"
                        SkippedReason="split across cost centres, so there's no single centre to keep"
                        DestinationNoun="project"
                        KeepNote="Each line keeps its cost centre — only the project changes."
                        XeroNote="The Xero Sites tracking is rewritten to the new project's site on draft and approved bills alike; paid bills are locked in Xero and move in JPMS only."
                        Options="@ProjectOptions" Placeholder="Project…"
                        @bind-Value="sendProjectId"
                        OnConfirm="SendToProjectAsync" OnCancel="CloseSendToProject" />

        @* Hidden while the invoice document modal is open — a dispute started from
           the viewer composes inline there, like a split. *@
        <DisputeLineModal Line="@(viewLine is null ? disputeLine : null)"
                          Error="@disputeError" Busy="@isBusy" Applying="@isApplying"
                          @bind-Message="disputeMessage"
                          OnConfirm="ConfirmDisputeAsync" OnCancel="CloseDispute" />

        <DisputeDiscussionModal IsOpen="@(discussLineId is not null)"
                                Line="DiscussLine"
                                @bind-Message="discussMessage"
                                Busy="isBusy" Error="@discussError"
                                OnSend="SendDiscussionMessageAsync" OnClose="CloseDiscussion" />

        <Modal IsOpen="@(viewLine is not null)" Title="Invoice document" ShowFooter="false"
               OnCancel="CloseInvoiceView" Class="max-w-4xl">
            @if (viewLine is not null)
            {
                <div class="space-y-3">
                    <LedgerLineSummary Line="viewLine">
                        @(viewLine.InvoiceNumber ?? "—") · @DateText(viewLine.Date) · @Money(SignedNet(viewLine)) net
                    </LedgerLineSummary>

                    @* Allocate without leaving the document: the reader identifies the
                       site and cost centre from the invoice itself, so the row's choices
                       render here too, over the same page state as the line's row. *@
                    @if (viewLine.AllocationStatus == XeroAllocationStatus.Unallocated)
                    {
                        var docLine = viewLine;
                        <InvoiceViewerActions Busy="@isBusy" Applying="@isApplying"
                                              SplitOpen="@(splitLine?.XeroLedgerLineId == docLine.XeroLedgerLineId)"
                                              SplitRows="splitRows" SplitNet="@(splitLine?.Net ?? 0m)" SplitError="@splitError"
                                              OnApplySplit="ApplySplitAsync" OnCloseSplit="CloseSplit"
                                              DisputeOpen="@(disputeLine?.XeroLedgerLineId == docLine.XeroLedgerLineId)"
                                              DisputeError="@disputeError"
                                              @bind-DisputeMessage="disputeMessage"
                                              OnConfirmDispute="ConfirmDisputeAsync" OnCloseDispute="CloseDispute"
                                              ProjectValue="@SelectedProjectFor(docLine)"
                                              ProjectOptions="@ProjectOptions"
                                              OnProjectPicked="value => SetProject(docLine.XeroLedgerLineId, value)"
                                              CostCenterValue="@SelectedCostCenterFor(docLine)"
                                              CostCenterOptions="@CostCenterOptions"
                                              OnCostCenterPicked="value => SetCostCenter(docLine.XeroLedgerLineId, value)"
                                              ArmedBucket="@SelectedBucketFor(docLine)"
                                              OnBucketPicked="bucket => SetBucket(docLine.XeroLedgerLineId, bucket)"
                                              CanAllocate="CanAllocate(docLine)"
                                              OnAllocate="AllocateFromViewAsync"
                                              OnBucketAllocate="BucketFromViewAsync"
                                              CanSetProject="CanSetProject(docLine)"
                                              OnSetProject="SetProjectFromViewAsync"
                                              OnOpenSplit="() => OpenSplit(docLine)"
                                              OnIgnore="IgnoreFromViewAsync"
                                              OnOpenDispute="() => OpenDispute(docLine)" />
                    }

                    <InvoiceDocumentPreview InvoiceId="@viewLine.XeroInvoiceId"
                                            IsCreditNote="@(viewLine.Type == "ACCPAYCREDIT")"
                                            Error="@viewError" />
                </div>
            }
        </Modal>
    </section>
}
