@page "/finance/allocation"
@using Jewel.JPMS.Features.Projects
@using Jewel.JPMS.Features.Xero
@inject AuthService Auth
@inject SessionService Session
@inject IXeroLedgerStore Ledger
@inject IQueryClient Queries
@inject ICostCenterStore CostCenters
@inject ILabourStore Labour
@inject ISubcontractorStore Subcontractors
@inject ProjectListReadModel ProjectsReadModel
@inject AllocationTabStorage TabStorage
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Cost allocation · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="w-full px-6 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    @* Full-width (no max-w cap): the allocation table is the whole page. A capped,
       centred container left growing side margins when zooming out instead of giving
       the columns the reclaimed space. *@
    <section class="w-full px-6 py-8 md:py-12">
        <WorkspaceSectionNav />
        <header class="mb-6 md:mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · Financials · Xero</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Cost allocation</h1>
                <p class="text-sm text-content-muted mt-2">
                    Reconcile the accounts system with the projects: every Xero cost-of-sales purchase line
                    (nominal accounts starting 3) is allocated to a project and master cost centre — or split
                    across several centres. Suggestions come from the line's Xero tracking — you confirm.
                    Once every line of a draft bill (published from Dext) is allocated, its Sites and Cost Code
                    tracking are confirmed back to Xero and the bill is approved automatically.
                </p>
            </div>
            <div class="flex items-center gap-4 whitespace-nowrap">
                <button class="text-sm font-medium text-content-muted hover:text-content underline underline-offset-4 disabled:opacity-50"
                        disabled="@isBusy" @onclick="RecheckMatchesAsync">
                    @(isRechecking ? "Re-checking…" : "Re-check matches")
                </button>
                <button class="text-sm font-medium text-content-muted hover:text-content underline underline-offset-4 disabled:opacity-50"
                        disabled="@isBusy" @onclick="SyncAsync">
                    @(isSyncing ? "Syncing…" : "Sync from Xero")
                </button>
            </div>
        </header>

        @if (syncMessage is not null)
        {
            <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-sm text-content-muted mb-6">@syncMessage</div>
        }
        @if (errorMessage is not null)
        {
            <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-sm text-content mb-6">@errorMessage</div>
        }

        @* This gate asks about the LEDGER, not about the open tab. It has to: the tab bar lives
           inside the else branch, so gating on the open tab's own emptiness would hide the tab bar
           whenever someone returned to a tab that happens to be empty — and the tab is remembered
           between sessions, so they would have had no way to get back out. The counts come from the
           server and cover every status. *@
        @if (!tabRestored || Ledger.Counts() is not { } counts)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading the stored ledger" />
        }
        else if (LedgerTotal(counts) == 0)
        {
            <p class="text-sm text-content-subtle py-8">
                Nothing stored yet — press “Sync from Xero” to pull the purchase ledger in for allocation.
            </p>
        }
        else
        {
            @if (activeTab == XeroAllocationStatus.Unallocated && !labourTab && FullyMatchedCount > 0)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
                    <span class="text-content-muted">
                        <span class="text-content font-medium">@FullyMatchedCount lines</span> have both a project and a
                        cost centre matched from their Xero tracking.
                    </span>
                    @if (!confirmAllocateMatched)
                    {
                        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                                disabled="@isBusy" @onclick="() => confirmAllocateMatched = true">
                            Allocate all matched…
                        </button>
                    }
                    else
                    {
                        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                                disabled="@isBusy" @onclick="AllocateMatchedAsync">
                            @(isBusy ? "Allocating…" : $"Confirm — allocate {FullyMatchedCount} lines")
                        </button>
                        <button class="text-xs text-content-subtle underline underline-offset-4"
                                @onclick="() => confirmAllocateMatched = false">Cancel</button>
                    }
                    <span class="text-xs text-content-subtle">Noted as auto-matched; each line stays reversible via Undo.</span>
                </div>
            }

            <div class="mb-4 flex items-center justify-between gap-4 flex-wrap">
                @* The incoming queue is split by project: a line whose project is real —
                   saved via Set, or suggested by its Xero tracking — sits in that
                   project's tab, so people working a specific project approve just their
                   own costs. Dropdown picks alone don't move rows; Set/Allocate do.
                   "Unallocated" keeps only the lines nothing points at a project yet. *@
                @* Every count in the bar is counted here, out of the unallocated queue and the
                   project list — a bar drawn before those land offers "Unallocated (0)" and no
                   project tabs at all. *@
                <LoadGate IsLoading="@(!TabBarReady)" Height="min-h-[38px]" Label="Loading tabs">
                <div class="inline-flex flex-wrap rounded-lg border border-line overflow-hidden">
                    <button class="@TabClass(XeroAllocationStatus.Unallocated)" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated)">
                        Unallocated (@UnassignedCount)
                    </button>
                    @foreach (var tab in ProjectTabs)
                    {
                        var projectId = tab.ProjectId;
                        <button class="@ProjectTabClass(projectId)" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated, projectId)">
                            @tab.Name (@tab.Count)
                        </button>
                    }
                    @* Labour recognition (scope §6): bills whose supplier is a worker on the
                       labour registry are settlement of timesheets, not costs to allocate — they
                       fall in this section instead of the queue. The count is the outstanding
                       (unmarked) lines, the actionable number, like every other tab. *@
                    @if (LabourTotalCount > 0 || labourTab)
                    {
                        <button class="@LabourTabClass()" @onclick="() => SwitchTab(XeroAllocationStatus.Unallocated, labour: true)">
                            Labour (@LabourOutstandingCount)
                        </button>
                    }
                    <button class="@TabClass(XeroAllocationStatus.Allocated)" @onclick="() => SwitchTab(XeroAllocationStatus.Allocated)">
                        Allocated (@CountOf(XeroAllocationStatus.Allocated))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Bucketed)" @onclick="() => SwitchTab(XeroAllocationStatus.Bucketed)">
                        Buckets (@CountOf(XeroAllocationStatus.Bucketed))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Disputed)" @onclick="() => SwitchTab(XeroAllocationStatus.Disputed)">
                        Disputed (@CountOf(XeroAllocationStatus.Disputed))
                    </button>
                    <button class="@TabClass(XeroAllocationStatus.Ignored)" @onclick="() => SwitchTab(XeroAllocationStatus.Ignored)">
                        Ignored (@CountOf(XeroAllocationStatus.Ignored))
                    </button>
                </div>
                </LoadGate>
                <div class="flex items-center gap-4">
                    <ExportToExcelButton FileName="Cost allocation"
                                         Disabled="@(Visible.Count == 0)"
                                         ShowIncludeAllRows="@(PageCount > 1)"
                                         BuildWorkbook="BuildExportWorkbook" />
                    @if (activeTab == XeroAllocationStatus.Allocated)
                    {
                        @* Narrow to one project first, then search within it — the
                           recode workflow: isolate what's coded where, select, resend. *@
                        <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="All projects"
                                      Value="@allocatedProjectFilter" ValueChanged="OnAllocatedProjectFilterChanged" />
                    }
                    <input class="text-sm bg-surface border border-line rounded-lg px-3 py-1.5 text-content placeholder:text-content-subtle w-64"
                           placeholder="@(activeTab == XeroAllocationStatus.Allocated
                                          ? "Search supplier, cost centre, number…"
                                          : "Search supplier, description, number…")"
                           value="@search" @oninput="OnSearchChanged" />
                </div>
            </div>

            @* The Labour section's own strip: what it is, and the covered fold. Sits where the
               matched banner sits on the plain queue — the section IS the explanation. *@
            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 text-sm text-content-muted flex items-start justify-between gap-4 flex-wrap">
                    <p class="max-w-3xl">
                        These bills' suppliers are workers on the labour registry, so each is
                        <span class="text-content font-medium">settlement of timesheets</span>, not a cost to
                        allocate — the approved time already carries the cost per project.
                        Mark a bill against its month and the
                        <a class="underline underline-offset-4 hover:text-content" href="/labour/overview">Labour overview's Settlement view</a>
                        reconciles it and codes it into Xero, split by site and cost code.
                    </p>
                    @if (LabourCoveredCount > 0)
                    {
                        <button class="text-xs text-content-subtle underline underline-offset-4 hover:text-content whitespace-nowrap"
                                @onclick="() => showCoveredLabour = !showCoveredLabour">
                            @(showCoveredLabour ? "Hide covered" : $"Show covered ({LabourCoveredCount})")
                        </button>
                    }
                </div>
            }

            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab && selectedIds.Count > 0)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
                    <span class="text-content font-medium">@selectedIds.Count selected</span>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            title="Mark every selected line as settlement of its worker's month — lines without a linked subcontractor company or a bill date are skipped and reported"
                            disabled="@isBusy" @onclick="BulkMarkCoverAsync">Mark selected as settlement</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@isBusy" @onclick="BulkUnmarkCoverAsync">Un-mark selected</button>
                    <button class="text-xs text-content-subtle underline underline-offset-4" @onclick="() => selectedIds.Clear()">Clear</button>
                </div>
            }

            @if (activeTab == XeroAllocationStatus.Unallocated && !labourTab && selectedIds.Count > 0)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
                    <span class="text-content font-medium">@selectedIds.Count selected</span>
                    <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="Project…"
                                  @bind-Value="bulkProjectId" />
                    <SearchSelect Options="@CostCenterOptions" WidthClass="w-52" Placeholder="Cost centre…"
                                  @bind-Value="bulkCostCenterCode" />
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkProjectId) || string.IsNullOrEmpty(bulkCostCenterCode))"
                            @onclick="BulkAllocateAsync">Allocate selected</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            title="Save the project and set its Xero site on every selected line — moves them to that project's tab, cost centres to follow"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkProjectId))"
                            @onclick="BulkSetProjectAsync">Set selected</button>
                    <span class="text-content-subtle">·</span>
                    <select class="bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm" @bind="bulkBucket">
                        <option value="">Bucket…</option>
                        @foreach (var bucket in XeroBuckets.All)
                        {
                            <option value="@bucket">@bucket</option>
                        }
                    </select>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@(isBusy || string.IsNullOrEmpty(bulkBucket))" @onclick="BulkBucketAsync">Bucket selected</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            disabled="@isBusy" @onclick="BulkIgnoreAsync">Ignore selected</button>
                    <button class="text-xs text-content-subtle underline underline-offset-4" @onclick="() => selectedIds.Clear()">Clear</button>
                </div>
            }

            @if (activeTab == XeroAllocationStatus.Allocated && selectedIds.Count > 0)
            {
                <div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
                    <span class="text-content font-medium">@selectedIds.Count selected</span>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            disabled="@isBusy" @onclick="OpenSendToCostCentre">Send to cost centre…</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                            title="Move the selected lines to another project — each keeps its cost centre, and the Xero site is rewritten"
                            disabled="@isBusy" @onclick="OpenSendToProject">Send to project…</button>
                    <button class="text-sm font-medium rounded-lg px-3 py-1.5 border border-line text-content-muted hover:text-content disabled:opacity-50"
                            title="Return the selected lines to the unallocated queue"
                            disabled="@isBusy" @onclick="BulkUndoAsync">Undo selected</button>
                    <button class="text-xs text-content-subtle underline underline-offset-4" @onclick="() => selectedIds.Clear()">Clear</button>
                </div>
            }

            @* One panel: the bucket totals, the rows and the footer's line count and net are all
               read off the open tab's lines, named through the project and cost-centre masters. *@
            <LoadGate IsLoading="@(!QueueReady)" Prominent="true" Label="Loading lines">
            @if (activeTab == XeroAllocationStatus.Bucketed)
            {
                <div class="mb-4 flex flex-wrap gap-2">
                    @foreach (var bucket in XeroBuckets.All)
                    {
                        <button class="@BucketChipClass(bucket)" @onclick="() => ToggleBucketFilter(bucket)">
                            @bucket · @Money(BucketTotal(bucket))
                        </button>
                    }
                </div>
            }

            @* The table used to run 82rem wide — date, supplier and description each had a
               column, and the queue row carried three dropdowns plus seven buttons — so on a
               laptop the actions sat off the right edge behind a scrollbar. Now the line's
               identity (supplier, description, date, invoice number, Xero site and code)
               stacks in ONE cell that flexes to whatever width is left, the coding dropdowns
               keep their fixed widths, and each row ends in one primary button plus a menu.
               While a row's menu is open the overflow cap is lifted: the menu positions
               absolutely inside this container, and with the overflow active its bottom
               entries would be clipped at the container's edge. *@
            <div class="rounded-xl border border-line bg-surface @(IsRowMenuOpen ? "" : "overflow-x-auto overflow-y-auto max-h-[85vh]")">
                <table class="w-full text-sm">
                    <thead class="bg-surface-raised border-b border-line">
                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                            @if (activeTab is XeroAllocationStatus.Unallocated or XeroAllocationStatus.Allocated)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-8">
                                    <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                                </th>
                            }
                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3">Line</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 text-right">Net</th>
                            @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Worker</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else if (activeTab == XeroAllocationStatus.Unallocated)
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Project</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-52">Cost centre</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else if (activeTab == XeroAllocationStatus.Disputed)
                            {
                                @* The dispute workbench: the coding both sides are converging on is
                                   edited and SAVED here (visible to the other party), the thread is a
                                   click away, and either side returns the line to allocation. *@
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-44">Project</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 w-52">Cost centre</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                            else
                            {
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3">
                                    @(activeTab == XeroAllocationStatus.Allocated ? "Allocated to"
                                      : activeTab == XeroAllocationStatus.Bucketed ? "Bucket" : "Reason")
                                </th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3 hidden md:table-cell">By</th>
                                <th class="sticky top-0 z-20 bg-surface-raised px-3 py-3"></th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @foreach (var line in Paged)
                        {
                            @* Keyed so a row's component state (an open menu, a dropdown's
                               filter text) stays with its line when paging or searching
                               re-orders the rows, instead of migrating to whichever line
                               now sits at that index. *@
                            <tr @key="line.XeroLedgerLineId">
                                @if (activeTab is XeroAllocationStatus.Unallocated or XeroAllocationStatus.Allocated)
                                {
                                    <td class="px-3 py-2.5">
                                        <input type="checkbox" checked="@selectedIds.Contains(line.XeroLedgerLineId)"
                                               @onchange="() => ToggleSelected(line.XeroLedgerLineId)" />
                                    </td>
                                }
                                <td class="px-3 py-2.5 max-w-0">
                                    @* max-w-0 lets the cell shrink below its content so the truncated
                                       description wraps the column instead of forcing the table wider. *@
                                    <span class="text-content font-medium">@(line.ContactName ?? "—")</span>
                                    @if (line.Type == "ACCPAYCREDIT")
                                    {
                                        <span class="ml-1.5 text-[10px] uppercase tracking-wider font-semibold border border-line rounded px-1 py-0.5">Credit</span>
                                    }
                                    @if (IsAwaitingApproval(line))
                                    {
                                        <span class="ml-1.5 text-[10px] uppercase tracking-wider font-semibold border border-line rounded px-1 py-0.5"
                                              title="Awaiting approval in Xero — allocating every line of this bill confirms its cost codes to Xero and approves it">Draft</span>
                                    }
                                    <span class="block truncate text-content-muted" title="@line.Description">@(line.Description ?? "—")</span>
                                    <span class="flex items-center gap-1 text-xs text-content-subtle">
                                        @if (line.HasAttachments)
                                        {
                                            @* The supplier's document as Xero holds it (published by Dext) —
                                               previewed in place without leaving the queue. *@
                                            <button type="button" title="View the invoice document"
                                                    class="inline-flex items-center justify-center w-5 h-5 -ml-1 rounded text-content-subtle hover:text-content hover:bg-surface-raised"
                                                    @onclick="() => OpenInvoiceView(line)">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48" />
                                                </svg>
                                            </button>
                                        }
                                        <span class="truncate" title="@LineMetaText(line)">@LineMetaText(line)</span>
                                    </span>
                                    @if (activeTab == XeroAllocationStatus.Disputed)
                                    {
                                        @* The dispute's state travels with the line rather than in its
                                           own column — who raised it, when, and the latest word. *@
                                        <span class="block text-xs text-content-subtle mt-1">
                                            Disputed by @(line.AllocatedBy ?? "—")
                                            @(line.AllocatedAtUtc is { } at ? $" · {at.ToLocalTime():d MMM yyyy}" : "")
                                        </span>
                                        @if (line.DisputeMessages?.LastOrDefault() is { } latest)
                                        {
                                            <span class="block text-xs text-content-subtle truncate" title="@latest.Body">
                                                “@latest.Body”
                                            </span>
                                        }
                                    }
                                </td>
                                <td class="px-3 py-2.5 text-right text-content font-medium whitespace-nowrap align-top">@Money(SignedNet(line))</td>

                                @if (activeTab == XeroAllocationStatus.Unallocated && labourTab)
                                {
                                    <td class="px-3 py-2.5 align-top">
                                        @if (line.MatchedWorkerName is not null)
                                        {
                                            <span class="text-content font-medium whitespace-nowrap">@line.MatchedWorkerName</span>
                                            @if (line.MatchedSubcontractorId is null)
                                            {
                                                @* The month-end doc's exact dead end (2026-08-31): the gap
                                                   used to be reported here and fixable only on the Workers
                                                   page, one modal at a time. The fix now lives where the
                                                   error is: link a directory company inline, or flag the
                                                   worker a sole trader — both audited, both re-checked
                                                   against the ledger immediately. *@
                                                <span class="block text-xs text-negative mt-0.5"
                                                      title="Covering reconciles by settlement counterparty: a linked subcontractor company, or the worker themself when flagged a sole trader.">
                                                    ⚠ No settlement identity
                                                </span>
                                                <div class="flex items-center gap-1.5 mt-1.5">
                                                    <SearchSelect Options="@DirectoryOptions" WidthClass="w-44"
                                                                  Placeholder="Link company…"
                                                                  Disabled="@(isBusy || !Subcontractors.IsLoaded)"
                                                                  Value="@InlineLinkPickFor(line)"
                                                                  ValueChanged="value => inlineLinkPicks[line.XeroLedgerLineId] = value" />
                                                    <button class="text-xs font-medium rounded-lg px-2 py-1 border border-line text-content-muted hover:text-content disabled:opacity-40"
                                                            disabled="@(isBusy || InlineLinkPickFor(line) == "")"
                                                            title="Link the worker to the picked directory company — audited; settlement then reconciles through it"
                                                            @onclick="() => LinkWorkerInlineAsync(line)">Link</button>
                                                    <button class="text-xs font-medium rounded-lg px-2 py-1 border border-line text-content-muted hover:text-content disabled:opacity-40"
                                                            disabled="@isBusy"
                                                            title="They bill under their own name — becomes their own settlement counterparty; no directory company is created"
                                                            @onclick="() => MarkSoleTraderInlineAsync(line)">Sole trader</button>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            @* Covered, but the supplier no longer matches anyone on the
                                               registry (worker renamed or deactivated). The cover stands;
                                               only re-marking would need a match. *@
                                            <span class="text-xs text-content-subtle">No current registry match</span>
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 text-right whitespace-nowrap align-top">
                                        @if (line.CoveredByTimesheets)
                                        {
                                            <span class="inline-block text-[11px] font-semibold rounded-full px-2 py-0.5 bg-surface text-content-subtle border border-line align-middle"
                                                  title="Marked as settlement — the covered value is excluded from cost-of-sales aggregations; the worker-month verdict lives on the Labour overview's Settlement view">
                                                Covered · @(line.CoveredPeriodStart?.ToString("MMM yyyy") ?? "")
                                            </span>
                                            <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content ml-2 disabled:opacity-40 align-middle"
                                                    title="Remove the settlement mark — the line goes back to the outstanding labour list"
                                                    disabled="@isBusy" @onclick="() => UnmarkCoverAsync(line)">Un-mark</button>
                                        }
                                        else
                                        {
                                            <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40 align-middle"
                                                    title="@MarkCoverHint(line)"
                                                    disabled="@(isBusy || !CanMarkCover(line))"
                                                    @onclick="() => MarkCoverAsync(line)">Mark as settlement@(SettlementMonthOf(line) is { } month ? $" · {month:MMM yyyy}" : "")</button>
                                        }
                                        <DropdownMenu Label="More" WidthClass="w-72" Disabled="@isBusy"
                                                      ToggleClass="inline-flex items-center gap-1 rounded-lg border border-line bg-surface px-2.5 py-1 text-xs text-content-muted hover:text-content transition"
                                                      Class="inline-block text-left ml-2 align-middle whitespace-normal"
                                                      Items="LabourRowMenuItems(line)"
                                                      OnOpenChanged="open => TrackRowMenu(line.XeroLedgerLineId, open)" />
                                    </td>
                                }
                                else if (activeTab == XeroAllocationStatus.Unallocated)
                                {
                                    <td class="px-3 py-2.5">
                                        <SearchSelect Options="@ProjectOptions" WidthClass="w-44"
                                                      Value="@SelectedProjectFor(line)"
                                                      ValueChanged="value => SetProject(line.XeroLedgerLineId, value)" />
                                        @if (line.WriteBackStatus == XeroWriteBackStatus.Failed)
                                        {
                                            <span class="block w-44 truncate text-xs text-negative mt-0.5"
                                                  title="@($"{line.WriteBackError} Press Set to retry.")">⚠ Xero write failed</span>
                                        }
                                    </td>
                                    <td class="px-3 py-2.5">
                                        <SearchSelect Options="@CostCenterOptions" WidthClass="w-52"
                                                      Value="@SelectedCostCenterFor(line)"
                                                      ValueChanged="value => SetCostCenter(line.XeroLedgerLineId, value)" />
                                    </td>
                                    <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                        @* One primary button per row. Project + cost centre arms Allocate; a
                                           bucket (suggested from the Xero code, or chosen in the menu or the
                                           document viewer) arms "Allocate to <bucket>" instead — and wins if
                                           both are set, since picking a bucket was the later, deliberate act. *@
                                        @if (CanBucket(line))
                                        {
                                            <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40 max-w-[11rem] truncate align-middle"
                                                    title="@($"Allocate to the {SelectedBucketFor(line)} bucket — no project, no cost centre")"
                                                    disabled="@isBusy"
                                                    @onclick="() => BucketAsync(line, SelectedBucketFor(line))">Allocate to @SelectedBucketFor(line)</button>
                                        }
                                        else
                                        {
                                            <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40 align-middle"
                                                    disabled="@(isBusy || !CanAllocate(line))"
                                                    @onclick="() => AllocateAsync(line)">Allocate</button>
                                        }
                                        @* The half-step: project decided, allocation not yet. Saves the
                                           project — which is when the row moves to that project's tab —
                                           and writes the Xero site without approving. This is also the
                                           change-of-mind move: pick a different project on a line the
                                           accountant coded and Set re-sites it in Xero and re-tabs it
                                           here. Pressing it again is the Xero retry. Unset (in the menu,
                                           only on lines with a saved project) reverses an accidental Set:
                                           project cleared here and the site removed in Xero. *@
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content ml-2 disabled:opacity-40 align-middle"
                                                title="Save the project and set its Xero site now — moves the line to that project's tab, cost centre to follow"
                                                disabled="@(isBusy || !CanSetProject(line))"
                                                @onclick="() => SetProjectAsync(line)">Set</button>
                                        @* Everything else — the seven buckets, Split, Ignore, Dispute and
                                           Unset — lives in the row's menu, so the row stays one line wide. *@
                                        @* whitespace-normal: the cell's nowrap would otherwise reach the
                                           menu panel and clip its longer bucket names. *@
                                        <DropdownMenu Label="More" WidthClass="w-72" Disabled="@isBusy"
                                                      ToggleClass="inline-flex items-center gap-1 rounded-lg border border-line bg-surface px-2.5 py-1 text-xs text-content-muted hover:text-content transition"
                                                      Class="inline-block text-left ml-2 align-middle whitespace-normal"
                                                      Items="QueueRowMenuItems(line)"
                                                      OnOpenChanged="open => TrackRowMenu(line.XeroLedgerLineId, open)" />
                                    </td>
                                }
                                else if (activeTab == XeroAllocationStatus.Disputed)
                                {
                                    <td class="px-3 py-2.5">
                                        <SearchSelect Options="@ProjectOptions" WidthClass="w-44"
                                                      Value="@SelectedProjectFor(line)"
                                                      ValueChanged="value => SetProject(line.XeroLedgerLineId, value)" />
                                    </td>
                                    <td class="px-3 py-2.5">
                                        <SearchSelect Options="@CostCenterOptions" WidthClass="w-52"
                                                      Value="@SelectedCostCenterFor(line)"
                                                      ValueChanged="value => SetCostCenter(line.XeroLedgerLineId, value)" />
                                    </td>
                                    <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                        @* Save persists the coding both sides are converging on — the
                                           line STAYS disputed, but the other party sees the proposal.
                                           Return to allocation is the resolution: back to the queue
                                           with the agreed coding kept, so a fully coded line lands on
                                           its project's tab armed for Allocate. Either side may press
                                           either button. Who disputed it and the latest word sit in
                                           the Line cell; the thread itself opens from here. *@
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content align-middle"
                                                @onclick="() => OpenDiscussion(line)">
                                            Discussion (@(line.DisputeMessages?.Count ?? 0))…
                                        </button>
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content ml-2 disabled:opacity-40 align-middle"
                                                title="Save the proposed project and cost centre on the line — it stays disputed"
                                                disabled="@(isBusy || string.IsNullOrEmpty(SelectedProjectFor(line)))"
                                                @onclick="() => SaveDisputedCodingAsync(line)">Save</button>
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface ml-2 disabled:opacity-40 align-middle"
                                                title="Resolve the dispute — the line returns to the allocation queue keeping the coding set here"
                                                disabled="@isBusy"
                                                @onclick="() => ResolveDisputeAsync(line)">Return to allocation</button>
                                    </td>
                                }
                                else
                                {
                                    <td class="px-3 py-2.5 text-content-muted">
                                        @if (activeTab == XeroAllocationStatus.Allocated)
                                        {
                                            @if (line.Splits is { Count: > 0 })
                                            {
                                                var multiProject = line.Splits.Select(split => split.ProjectId ?? line.ProjectId)
                                                    .Distinct().Count() > 1;
                                                <span class="text-content">@(multiProject ? "Multiple projects" : ProjectName(line.ProjectId ?? line.Splits[0].ProjectId))</span>
                                                foreach (var split in line.Splits)
                                                {
                                                    <span class="block text-xs text-content-subtle">
                                                        @if (multiProject)
                                                        {
                                                            <span class="text-content-muted">@ProjectName(split.ProjectId ?? line.ProjectId) · </span>
                                                        }
                                                        @CostCenterText(split.CostCenterCode) · @Money(line.Type == "ACCPAYCREDIT" ? -split.Net : split.Net)
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-content">@ProjectName(line.ProjectId)</span>
                                                <span class="block text-xs text-content-subtle">@CostCenterText(line.CostCenterCode)</span>
                                            }
                                            @if (WriteBackBadge(line) is { } badge)
                                            {
                                                <span class="block text-xs mt-0.5 @badge.Css" title="@badge.Tooltip">@badge.Text</span>
                                                @* The tooltip is easy to miss — failures need their reason readable at a glance. *@
                                                @if (line.WriteBackStatus == XeroWriteBackStatus.Failed
                                                     && !string.IsNullOrWhiteSpace(line.WriteBackError))
                                                {
                                                    <span class="block text-xs mt-0.5 text-content-subtle whitespace-normal max-w-md">@line.WriteBackError</span>
                                                }
                                            }
                                        }
                                        else if (activeTab == XeroAllocationStatus.Bucketed)
                                        {
                                            <span class="text-content">@(line.Bucket ?? "—")</span>
                                        }
                                        else
                                        {
                                            @(line.Note ?? "—")
                                        }
                                    </td>
                                    <td class="px-3 py-2.5 text-content-subtle text-xs hidden md:table-cell">
                                        @(line.AllocatedBy ?? "—")
                                        <span class="block">@(line.AllocatedAtUtc?.ToLocalTime().ToString("d MMM yyyy") ?? "")</span>
                                    </td>
                                    <td class="px-3 py-2.5 text-right whitespace-nowrap">
                                        @if (activeTab == XeroAllocationStatus.Allocated && line.WriteBackStatus == XeroWriteBackStatus.Failed)
                                        {
                                            <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40"
                                                    disabled="@isBusy" title="@line.WriteBackError"
                                                    @onclick="() => RetryWriteBackAsync(line)">Retry Xero</button>
                                        }
                                        <button class="text-xs text-content-subtle underline underline-offset-4 ml-2"
                                                disabled="@isBusy" @onclick="() => ResetAsync(line)">Undo</button>
                                        @if (activeTab == XeroAllocationStatus.Allocated)
                                        {
                                            <button class="text-xs text-content-subtle underline underline-offset-4 ml-2"
                                                    title="Contest this cost — un-allocates it into the Disputed tab and opens a discussion with the accountant"
                                                    disabled="@isBusy" @onclick="() => OpenDispute(line)">Dispute…</button>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Tabs load independently now, so a tab can be mid-fetch or genuinely empty while the
               ledger as a whole is neither. Say which. *@
            @if (Visible.Count == 0)
            {
                <p class="text-sm text-content-subtle py-6 text-center">
                    @(HasTabFilters
                        ? "No lines match the current filters on this tab."
                        : "Nothing on this tab.")
                </p>
            }

            <div class="mt-3 flex items-center justify-between gap-4 flex-wrap">
                <p class="text-xs text-content-subtle">
                    @Visible.Count lines · @Money(Visible.Sum(SignedNet)) net.
                    Allocating every line of a draft bill writes its Sites / Cost Code tracking back to Xero
                    and approves it. Moving a line between projects (Set, or Send to project) rewrites its
                    Xero Sites tracking on draft and approved bills alike; paid bills are locked in Xero
                    and move in JPMS only. A disputed line waits on the Disputed tab — its bill is never
                    auto-approved — until either side returns it to allocation.
                </p>
                @if (PageCount > 1)
                {
                    <div class="flex items-center gap-3 text-xs text-content-muted">
                        <button class="underline underline-offset-4 disabled:opacity-40 disabled:no-underline"
                                disabled="@(page == 0)" @onclick="() => page--">‹ Prev</button>
                        <span>Page @(page + 1) of @PageCount</span>
                        <button class="underline underline-offset-4 disabled:opacity-40 disabled:no-underline"
                                disabled="@(page >= PageCount - 1)" @onclick="() => page++">Next ›</button>
                    </div>
                }
            </div>
            </LoadGate>
        }

        @* Hidden while the invoice document modal is open — a split started from
           the document viewer renders inline there instead, so the invoice stays
           readable while the amounts are keyed in. *@
        <Modal IsOpen="@(splitLine is not null && viewLine is null)" Title="Split across projects and cost centres"
               ConfirmLabel="@(isApplying ? "Allocating…" : "Allocate split")" CancelLabel="Cancel"
               ConfirmDisabled="@isBusy" OnConfirm="ApplySplitAsync" OnCancel="CloseSplit" Class="max-w-3xl">
            @if (splitLine is not null)
            {
                <div class="space-y-4">
                    <LedgerLineSummary Line="splitLine">
                        @(splitLine.InvoiceNumber ?? "—") · @Money(splitLine.Net) net
                    </LedgerLineSummary>
                    <SplitEditorForm Rows="splitRows" Net="@(splitLine?.Net ?? 0m)" Error="@splitError"
                                     ProjectOptions="@ProjectOptions" CostCenterOptions="@CostCenterOptions" />
                </div>
            }
        </Modal>

        @* Bulk recode from the Allocated tab: every selected line moves to the
           chosen cost centre, each keeping the project it's already allocated
           to. Re-allocating replaces any previous split (the API clears the
           split rows), so a line once shared across centres moves whole. *@
        <Modal IsOpen="@sendToCostCentreOpen" Title="Send to cost centre"
               ConfirmLabel="@(isApplying ? "Sending…" : $"Send {SendableSelected.Count} {(SendableSelected.Count == 1 ? "line" : "lines")}")" CancelLabel="Cancel"
               ConfirmDisabled="@(isBusy || string.IsNullOrEmpty(sendCostCenterCode) || SendableSelected.Count == 0)"
               OnConfirm="SendToCostCentreAsync" OnCancel="CloseSendToCostCentre" Class="max-w-lg">
            @if (sendToCostCentreOpen)
            {
                <div class="space-y-4">
                    @if (sendError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@sendError</p>
                    }
                    <p class="text-sm text-content-muted">
                        <span class="text-content font-medium">@SendableSelected.Count @(SendableSelected.Count == 1 ? "line" : "lines")</span>
                        · @Money(SendableSelected.Sum(SignedNet)) net move to the chosen cost centre.
                        Each line keeps its project — only the cost centre changes; a line previously
                        split across centres moves whole.
                    </p>
                    @if (SelectedAllocated.Count > SendableSelected.Count)
                    {
                        <p class="text-xs text-content-subtle">
                            @(SelectedAllocated.Count - SendableSelected.Count) of the selected lines are split across
                            more than one project, so there's no single project to keep — they'll be left unchanged.
                            Undo and re-split those lines individually.
                        </p>
                    }
                    <SearchSelect Options="@CostCenterOptions" WidthClass="w-full" Placeholder="Cost centre…"
                                  @bind-Value="sendCostCenterCode" />
                    <p class="text-xs text-content-subtle">
                        Bills still awaiting approval have their new coding confirmed back to Xero;
                        bills already approved in Xero are re-coded in JPMS only.
                    </p>
                </div>
            }
        </Modal>

        @* Bulk re-site from the Allocated tab: the change-of-mind move. Every
           selected line moves to the chosen project, each keeping the cost
           centre it's already coded to, and the bill's Sites tracking in Xero
           is rewritten to the new project's site — draft or approved (paid
           bills are locked in Xero and move in JPMS only). Re-allocating
           replaces any stored split, so lines split across cost centres have
           no single centre to keep and are left unchanged. *@
        <Modal IsOpen="@sendToProjectOpen" Title="Send to project"
               ConfirmLabel="@(isApplying ? "Sending…" : $"Send {ProjectSendableSelected.Count} {(ProjectSendableSelected.Count == 1 ? "line" : "lines")}")" CancelLabel="Cancel"
               ConfirmDisabled="@(isBusy || string.IsNullOrEmpty(sendProjectId) || ProjectSendableSelected.Count == 0)"
               OnConfirm="SendToProjectAsync" OnCancel="CloseSendToProject" Class="max-w-lg">
            @if (sendToProjectOpen)
            {
                <div class="space-y-4">
                    @if (sendProjectError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@sendProjectError</p>
                    }
                    <p class="text-sm text-content-muted">
                        <span class="text-content font-medium">@ProjectSendableSelected.Count @(ProjectSendableSelected.Count == 1 ? "line" : "lines")</span>
                        · @Money(ProjectSendableSelected.Sum(SignedNet)) net move to the chosen project.
                        Each line keeps its cost centre — only the project changes.
                    </p>
                    @if (SelectedAllocated.Count > ProjectSendableSelected.Count)
                    {
                        <p class="text-xs text-content-subtle">
                            @(SelectedAllocated.Count - ProjectSendableSelected.Count) of the selected lines are split across
                            cost centres, so there's no single centre to keep — they'll be left unchanged.
                            Undo and re-split those lines individually.
                        </p>
                    }
                    <SearchSelect Options="@ProjectOptions" WidthClass="w-full" Placeholder="Project…"
                                  @bind-Value="sendProjectId" />
                    <p class="text-xs text-content-subtle">
                        The Xero Sites tracking is rewritten to the new project's site on draft and
                        approved bills alike; paid bills are locked in Xero and move in JPMS only.
                    </p>
                </div>
            }
        </Modal>

        @* Opening a dispute: the line moves to the Disputed tab — which is itself the
           signal to the accountant, like the Unallocated count — with an optional
           opening message starting the thread. Any coding on the line is kept as the
           position under discussion. *@
        @* Hidden while the invoice document modal is open — a dispute started from
           the viewer composes inline there, like a split. *@
        <Modal IsOpen="@(disputeLine is not null && viewLine is null)" Title="Dispute this cost"
               ConfirmLabel="@(isApplying ? "Disputing…" : "Move to Disputed")" CancelLabel="Cancel"
               ConfirmDisabled="@isBusy" OnConfirm="ConfirmDisputeAsync" OnCancel="CloseDispute" Class="max-w-lg">
            @if (disputeLine is not null)
            {
                <div class="space-y-4">
                    @if (disputeError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@disputeError</p>
                    }
                    <LedgerLineSummary Line="disputeLine">
                        @(disputeLine.InvoiceNumber ?? "—") · @DateText(disputeLine.Date) · @Money(SignedNet(disputeLine)) net
                    </LedgerLineSummary>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1.5">
                            Why is this disputed?
                        </label>
                        <textarea class="w-full bg-surface border border-line rounded-lg px-3 py-2 text-sm text-content placeholder:text-content-subtle"
                                  rows="4" placeholder="Optional — starts the discussion, e.g. “This isn't ours / wrong site — should this be on Elm Grove?”"
                                  @bind="disputeMessage" @bind:event="oninput"></textarea>
                    </div>
                    <p class="text-xs text-content-subtle">
                        The line moves to the Disputed tab, where the discussion continues and the agreed
                        project and cost centre can be set. Either side returns it to allocation when settled.
                    </p>
                </div>
            }
        </Modal>

        <DisputeDiscussionModal IsOpen="@(discussLineId is not null)"
                                Line="DiscussLine"
                                @bind-Message="discussMessage"
                                Busy="isBusy" Error="@discussError"
                                OnSend="SendDiscussionMessageAsync" OnClose="CloseDiscussion" />

        <Modal IsOpen="@(viewLine is not null)" Title="Invoice document" ShowFooter="false"
               OnCancel="CloseInvoiceView" Class="max-w-4xl">
            @if (viewLine is not null)
            {
                <div class="space-y-3">
                    <LedgerLineSummary Line="viewLine">
                        @(viewLine.InvoiceNumber ?? "—") · @DateText(viewLine.Date) · @Money(SignedNet(viewLine)) net
                    </LedgerLineSummary>

                    @* Allocate without leaving the document: the reader identifies the
                       site and cost centre from the invoice itself, so the controls live
                       here too. Same state as the line's row — a pick made here shows on
                       the row (and moves it between project tabs) if the modal is closed
                       without allocating. Split… swaps the bar for the split editor,
                       inline so the invoice stays readable while the amounts are keyed. *@
                    @if (viewLine.AllocationStatus == XeroAllocationStatus.Unallocated)
                    {
                        var docLine = viewLine;
                        @if (splitLine?.XeroLedgerLineId == docLine.XeroLedgerLineId)
                        {
                            <div class="rounded-lg border border-line bg-surface-raised px-4 py-3 space-y-4">
                                <div class="flex items-center justify-between gap-2 flex-wrap">
                                    <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Split across cost centres</span>
                                    <span class="flex items-center gap-2">
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40"
                                                disabled="@isBusy" @onclick="ApplySplitAsync">
                                            @(isApplying ? "Allocating…" : "Allocate split")
                                        </button>
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content disabled:opacity-40"
                                                disabled="@isBusy" @onclick="CloseSplit">Cancel</button>
                                    </span>
                                </div>
                                <SplitEditorForm Rows="splitRows" Net="@(splitLine?.Net ?? 0m)" Error="@splitError"
                                     ProjectOptions="@ProjectOptions" CostCenterOptions="@CostCenterOptions" />
                            </div>
                        }
                        else if (disputeLine?.XeroLedgerLineId == docLine.XeroLedgerLineId)
                        {
                            @* Dispute… from the viewer composes inline, like Split…, so the
                               invoice stays readable while the reason is written. *@
                            <div class="rounded-lg border border-line bg-surface-raised px-4 py-3 space-y-3">
                                <div class="flex items-center justify-between gap-2 flex-wrap">
                                    <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Dispute this cost</span>
                                    <span class="flex items-center gap-2">
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40"
                                                disabled="@isBusy" @onclick="ConfirmDisputeAsync">
                                            @(isApplying ? "Disputing…" : "Move to Disputed")
                                        </button>
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content disabled:opacity-40"
                                                disabled="@isBusy" @onclick="CloseDispute">Cancel</button>
                                    </span>
                                </div>
                                @if (disputeError is not null)
                                {
                                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@disputeError</p>
                                }
                                <textarea class="w-full min-h-[4.5rem] rounded-lg bg-surface border border-line px-3 py-2 text-sm text-content placeholder:text-content-subtle"
                                          placeholder="Why is this disputed? (optional — the discussion continues on the Disputed tab)"
                                          @bind="disputeMessage" @bind:event="oninput"></textarea>
                            </div>
                        }
                        else
                        {
                            @* The full set of row choices, in two rows: code the line to a project
                               and cost centre, or send it to a bucket / ignore it / dispute it. *@
                            <div class="rounded-lg border border-line bg-surface-raised px-4 py-3 space-y-2">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold w-16">Allocate</span>
                                    <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="Project…"
                                                  Value="@SelectedProjectFor(docLine)"
                                                  ValueChanged="value => SetProject(docLine.XeroLedgerLineId, value)" />
                                    <SearchSelect Options="@CostCenterOptions" WidthClass="w-52" Placeholder="Cost centre…"
                                                  Value="@SelectedCostCenterFor(docLine)"
                                                  ValueChanged="value => SetCostCenter(docLine.XeroLedgerLineId, value)" />
                                    @* Same rule as the row: an armed bucket takes the primary slot, so
                                       it is visible WHY a coded line isn't offering plain Allocate. *@
                                    @if (CanBucket(docLine))
                                    {
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40 max-w-[11rem] truncate"
                                                title="@($"Allocate to the {SelectedBucketFor(docLine)} bucket — pick a project or cost centre to code it instead")"
                                                disabled="@isBusy" @onclick="BucketFromViewAsync">
                                            @(isApplying ? "Allocating…" : $"Allocate to {SelectedBucketFor(docLine)}")
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="text-xs font-medium rounded-lg px-2.5 py-1 bg-content text-surface disabled:opacity-40"
                                                disabled="@(isBusy || !CanAllocate(docLine))"
                                                @onclick="AllocateFromViewAsync">
                                            @(isApplying ? "Allocating…" : "Allocate")
                                        </button>
                                    }
                                    <button class="text-xs font-medium rounded-lg px-2.5 py-1 border border-line text-content-muted hover:text-content disabled:opacity-40"
                                            title="Save the project and set its Xero site now — cost centre to follow"
                                            disabled="@(isBusy || !CanSetProject(docLine))"
                                            @onclick="SetProjectFromViewAsync">Set</button>
                                    <button class="text-xs text-content-subtle underline underline-offset-4 disabled:opacity-40"
                                            title="Share this line's value across several cost centres (or projects) — one Xero line per share on approval"
                                            disabled="@isBusy" @onclick="() => OpenSplit(docLine)">Split…</button>
                                </div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    @* Choosing a bucket arms the primary button above as "Allocate to
                                       <bucket>"; picking a project or cost centre disarms it again. *@
                                    <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold w-16">Or</span>
                                    <select class="bg-surface border border-line rounded-lg px-2 py-1 text-content text-sm w-52"
                                            title="Send this line to a bucket instead of a project — no project, no cost centre"
                                            value="@SelectedBucketFor(docLine)"
                                            @onchange="e => SetBucket(docLine.XeroLedgerLineId, e.Value?.ToString())">
                                        <option value="">Bucket…</option>
                                        @foreach (var bucket in XeroBuckets.All)
                                        {
                                            <option value="@bucket">@bucket</option>
                                        }
                                    </select>
                                    <span class="text-content-subtle text-xs">·</span>
                                    <button class="text-xs text-content-subtle underline underline-offset-4 disabled:opacity-40"
                                            title="Not a project cost — moves the line to the Ignored tab"
                                            disabled="@isBusy" @onclick="IgnoreFromViewAsync">Ignore</button>
                                    <button class="text-xs text-content-subtle underline underline-offset-4 disabled:opacity-40"
                                            title="Contest this cost — moves it to the Disputed tab and opens a discussion with the accountant"
                                            disabled="@isBusy" @onclick="() => OpenDispute(docLine)">Dispute…</button>
                                </div>
                            </div>
                        }
                    }

                    <InvoiceDocumentPreview InvoiceId="@viewLine.XeroInvoiceId"
                                            IsCreditNote="@(viewLine.Type == "ACCPAYCREDIT")"
                                            Error="@viewError" />
                </div>
            }
        </Modal>
    </section>
}
