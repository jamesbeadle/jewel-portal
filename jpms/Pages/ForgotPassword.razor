@page "/forgot-password"
@layout LandingLayout
@inject AuthService Auth

<PageTitle>Reset your password · JPMS</PageTitle>

@*
    Self-service password reset, step one. The API answers identically whether or not the address
    has an account, and so does this page: the confirmation below is shown on every submission that
    reaches the server, so nobody can use this form to find out who has a JPMS login.
*@

<div class="min-h-dvh flex flex-col md:flex-row">

    <div class="order-1 md:order-2 w-full md:w-1/2 h-[25vh] md:h-auto bg-surface overflow-hidden">
        <img src="about-team.png" alt="" class="w-full h-full object-cover" />
    </div>

    <div class="order-2 md:order-1 w-full md:w-1/2 flex-1 flex flex-col p-8 md:p-10">

        <div class="flex items-center gap-2.5 shrink-0 justify-center md:justify-start">
            <JewelIcon Class="w-6 h-6 text-content" />
            <span class="font-semibold text-content">Jewel Project Management System</span>
        </div>

        <div class="flex-1 flex flex-col items-center justify-center w-full max-w-sm mx-auto py-10">

            @if (sent)
            {
                <div class="w-14 h-14 grid place-items-center mb-5">
                    <JewelIcon Class="w-9 h-9 text-accent" />
                </div>
                <h1 class="text-3xl font-semibold text-content leading-tight mb-3 text-center">Check your email</h1>
                <p class="text-base text-content-muted leading-relaxed mb-8 text-center">@acknowledgement</p>
                <a href="/" class="text-sm font-medium text-accent hover:text-accent-hover">Back to sign in</a>
            }
            else
            {
                <h1 class="text-4xl font-semibold text-content leading-tight mb-3 text-center">Reset your password</h1>
                <p class="text-base text-content-muted leading-relaxed mb-8 text-center">
                    Enter the email address you sign in with and we'll send you a link to choose a new password.
                </p>

                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="w-full space-y-4">
                    <div>
                        <label for="email" class="block eyebrow mb-1">Email</label>
                        <input id="email" type="email" autocomplete="username"
                               value="@email" @oninput="e => email = e.Value?.ToString() ?? string.Empty"
                               class="field" />
                    </div>

                    <button type="submit" disabled="@(busy || !CanSubmit)"
                            class="w-full rounded-lg bg-accent text-accent-ink font-medium px-4 py-2.5 hover:bg-accent-hover disabled:opacity-50 disabled:cursor-not-allowed transition">
                        @(busy ? "Sending…" : "Send reset link")
                    </button>
                </form>

                <a href="/" class="mt-6 text-sm font-medium text-content-subtle hover:text-content underline underline-offset-4">
                    Back to sign in
                </a>

                <p class="mt-6 text-xs text-content-subtle leading-relaxed text-center">
                    Never set a password? Your account needs an invite rather than a reset —
                    ask a Jewel administrator to send you one.
                </p>
            }

        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool busy;
    private bool sent;
    private string acknowledgement = "";

    private bool CanSubmit => !string.IsNullOrWhiteSpace(email) && email.Contains('@');

    private async Task HandleSubmit()
    {
        if (!CanSubmit || busy) return;
        busy = true;
        acknowledgement = await Auth.RequestPasswordResetAsync(email.Trim());
        busy = false;
        sent = true;
    }
}
