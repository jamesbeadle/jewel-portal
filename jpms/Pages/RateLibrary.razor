@page "/rate-library"
@inject AuthService Auth
@inject SessionService Session
@inject IRateLibrary Rates
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Rate library · JPMS</PageTitle>

<Page>
        <WorkspaceSectionNav />
        <PageHeader>
            <SubtitleContent>
                @Rates.All().Count rates · @StaleCount stale.
            </SubtitleContent>
            <Actions>
                <div class="flex items-center gap-4">
                    <ExportToExcelButton FileName="Rate library"
                                         Disabled="@(Rates.All().Count == 0)"
                                         BuildWorkbook="BuildExportWorkbook" />
                    <a href="/rate-library/stale"
                       class="text-sm font-medium text-content-muted hover:text-content underline underline-offset-4">
                        View stale rates →
                    </a>
                </div>
            </Actions>
        </PageHeader>

        <RateTable Rates="Rates.All()" />
</Page>

@code {
    private const int StaleDayThreshold = 60;

    private int StaleCount => Rates.Stale(StaleDayThreshold).Count;

    private ExcelWorkbook? BuildExportWorkbook(bool _)
    {
        var rates = Rates.All();
        if (rates.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Rates",
            new ExcelColumn("Trade"),
            new ExcelColumn("Description"),
            new ExcelColumn("Supplier"),
            new ExcelColumn("Unit"),
            new ExcelColumn("Rate", ExcelFormat.Currency),
            new ExcelColumn("Last priced", ExcelFormat.Date));

        foreach (var rate in rates)
        {
            sheet.AddRow(
                rate.Trade,
                rate.Description,
                rate.SupplierName,
                rate.Unit,
                rate.Value,
                rate.LastPricedAt.LocalDateTime);
        }
        return workbook;
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        Rates.OnChange += StateHasChanged;
    }

    public void Dispose() => Rates.OnChange -= StateHasChanged;
}
