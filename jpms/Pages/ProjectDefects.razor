@page "/projects/{ProjectId}/defects"
@using Jewel.JPMS.Contracts.Closeout
@using Jewel.JPMS.Features.Closeout
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject DefectsReadModel Defects
@inject ICommandSender Commands
@inject IQueryClient Queries
@implements IDisposable

<PageTitle>Defects · JPMS</PageTitle>

@*
    The project's defect register. A defect is raised here directly or from a subcontractor email
    in the Control Centre (System Tags → Subcontractor → Create new → Defect); either way it
    carries a sequential DEF-#### reference, which is also its mailbox tag stem — so every email
    filed to the defect reads back live under it here, exactly like a work order or bid package.
    Status walks Open → In progress → Resolved → Verified (UpdateDefect stamps ResolvedAt).
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="defects">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-content">Defects</h2>
            <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition"
                    @onclick="() => raiseOpen = !raiseOpen">
                @(raiseOpen ? "Close" : "Raise defect")
            </button>
        </div>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @if (raiseOpen)
        {
            <section class="rounded-xl border border-line bg-surface p-5 mb-5">
                <h3 class="text-sm font-medium text-content-muted mb-3">Raise a defect</h3>
                <div class="space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <FormField Label="Location">
                            <input type="text" class="field" maxlength="256" placeholder="Room, area or feature"
                                   value="@newLocation" @oninput="e => newLocation = e.Value?.ToString() ?? string.Empty" />
                            </FormField>
                        </div>
                        <div>
                            <FormField Label="Assigned to">
                            <input type="text" class="field" maxlength="256" placeholder="Who the fix is chased with — an email address"
                                   value="@newAssignedTo" @oninput="e => newAssignedTo = e.Value?.ToString() ?? string.Empty" />
                            </FormField>
                        </div>
                    </div>
                    <div>
                        <FormField Label="Description" Required>
                        <textarea class="field" rows="3" maxlength="1024" placeholder="What's wrong and what putting it right needs"
                                  value="@newDescription" @oninput="e => newDescription = e.Value?.ToString() ?? string.Empty"></textarea>
                        </FormField>
                    </div>
                    <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition disabled:opacity-50"
                            disabled="@(string.IsNullOrWhiteSpace(newDescription) || busy)"
                            @onclick="RaiseAsync">
                        Raise defect
                    </button>
                </div>
            </section>
        }

        @if (!Defects.LoadedFor(ProjectId) && !dataFailed)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading defects" />
        }
        else if (dataFailed && !Defects.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">The defects couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else if (Rows.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No defects on this project. Raise one here, or file a subcontractor email to a new defect from the Control Centre.</p>
        }
        else
        {
            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-line text-left">
                            <th class="px-4 py-2.5 eyebrow">Ref</th>
                            <th class="px-4 py-2.5 eyebrow">Location</th>
                            <th class="px-4 py-2.5 eyebrow">Description</th>
                            <th class="px-4 py-2.5 eyebrow">Assigned to</th>
                            <th class="px-4 py-2.5 eyebrow">Raised</th>
                            <th class="px-4 py-2.5 eyebrow">Status</th>
                            <th class="px-4 py-2.5"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var defect in Rows)
                        {
                            var isExpanded = expandedDefectId == defect.DefectId;
                            <tr @key="defect.DefectId" class="border-b border-line last:border-0 align-top">
                                <td class="px-4 py-2.5 font-mono text-xs text-content-muted whitespace-nowrap">@defect.Reference</td>
                                <td class="px-4 py-2.5 text-content">@defect.Location</td>
                                <td class="px-4 py-2.5 text-content-muted max-w-md">
                                    <span title="@defect.Description">@defect.Description</span>
                                </td>
                                <td class="px-4 py-2.5 text-content-muted">@defect.AssignedToEmail</td>
                                <td class="px-4 py-2.5 text-content-muted whitespace-nowrap" title="@defect.RaisedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")">
                                    @defect.RaisedAt.ToLocalTime().ToString("d MMM yyyy")
                                </td>
                                <td class="px-4 py-2.5 whitespace-nowrap">
                                    <select class="field py-1" value="@((int)defect.Status)" disabled="@busy"
                                            @onchange="e => SetStatusAsync(defect, e)">
                                        @foreach (var status in Enum.GetValues<DefectStatus>())
                                        {
                                            <option value="@((int)status)">@status.DisplayName()</option>
                                        }
                                    </select>
                                </td>
                                <td class="px-4 py-2.5 whitespace-nowrap text-right">
                                    <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                            @onclick="() => ToggleEmailsAsync(defect.DefectId)">
                                        @(isExpanded ? "Hide emails" : "Emails")
                                    </button>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr class="border-b border-line last:border-0 bg-surface-raised/50">
                                    <td colspan="7" class="px-4 py-3">
                                        <FiledEmailList Emails="@(emailsByDefect.TryGetValue(defect.DefectId, out var filedEmails) ? filedEmails : null)"
                                            EmptyMessage="@($"No emails filed to {defect.Reference} yet — file one from the Control Centre (System Tags → Subcontractor → Defect).")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </ProjectPageShell>
</Page>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private bool sessionReady;
    private bool dataFailed;
    private bool busy;
    private string? actionError;

    private bool raiseOpen;
    private string newLocation = "";
    private string newDescription = "";
    private string newAssignedTo = "";

    // One expanded defect at a time; its emails are read live by tag (ListRecordEmails) and cached
    // for the visit so collapsing/expanding doesn't refetch.
    private string? expandedDefectId;
    private readonly Dictionary<string, IReadOnlyList<MailboxMessage>> emailsByDefect = new();

    private IReadOnlyList<Defect> Rows =>
        Defects.Current(ProjectId).OrderByDescending(d => d.Reference, StringComparer.Ordinal).ToList();

    protected override async Task OnInitializedAsync()
    {
        Defects.OnChanged += StateHasChanged;
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        await LoadAsync();
    }

    private string loadedForProjectId = "";

    protected override async Task OnParametersSetAsync()
    {
        // Project switch via the shell's arrows: same page, new key — load the new register
        // (and give a previously failed project a fresh chance).
        if (!sessionReady || loadedForProjectId == ProjectId) return;
        dataFailed = false;
        expandedDefectId = null;
        raiseOpen = false;
        actionError = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loadedForProjectId = ProjectId;
        try { await Defects.RefreshAsync(ProjectId, CancellationToken.None); }
        catch { dataFailed = true; } // the query client has already toasted the detail
    }

    private async Task RaiseAsync()
    {
        if (string.IsNullOrWhiteSpace(newDescription)) return;
        busy = true;
        actionError = null;
        try
        {
            await Commands.SendAsync(new RaiseDefect(
                ProjectId, newDescription.Trim(), newLocation.Trim(), newAssignedTo.Trim()), CancellationToken.None);
            newLocation = ""; newDescription = ""; newAssignedTo = "";
            raiseOpen = false;
            await RefreshAfterWriteAsync();
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    private async Task SetStatusAsync(Defect defect, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var statusValue)) return;
        var status = (DefectStatus)statusValue;
        if (status == defect.Status) return;
        busy = true;
        actionError = null;
        try
        {
            await Commands.SendAsync(new UpdateDefect(
                defect.DefectId, defect.Description, defect.Location, defect.AssignedToEmail, status), CancellationToken.None);
            await RefreshAfterWriteAsync();
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    // Post-write reload: swallow query failures (the toast already reported them) so a 502 on the
    // refetch can't take the page down after a successful write — see post-write-reload rule.
    private async Task RefreshAfterWriteAsync()
    {
        try { await Defects.RefreshAsync(ProjectId, CancellationToken.None); }
        catch (OperationCanceledException) { throw; }
        catch { }
    }

    private async Task ToggleEmailsAsync(string defectId)
    {
        if (expandedDefectId == defectId) { expandedDefectId = null; return; }
        expandedDefectId = defectId;
        if (emailsByDefect.ContainsKey(defectId)) return;
        try
        {
            var emails = await Queries.AskAsync(new ListRecordEmails(RecordType.Defect, defectId), CancellationToken.None);
            emailsByDefect[defectId] = emails;
        }
        catch
        {
            // The toast has the detail; an empty list is the honest fallback for this visit.
            emailsByDefect[defectId] = Array.Empty<MailboxMessage>();
        }
    }

    public void Dispose() => Defects.OnChanged -= StateHasChanged;
}
