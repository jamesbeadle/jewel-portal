@page "/cost-codes"
@using Jewel.JPMS.Contracts.CostCenters
@using Jewel.JPMS.Features.Projects
@inject AuthService Auth
@inject SessionService Session
@inject ICostCenterStore CostCenters
@inject IXeroTrackingCategoriesStore XeroTracking
@inject ProjectListReadModel Projects
@inject NavigationManager Nav
@inject IQueryClient Queries
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Cost codes · JPMS</PageTitle>

<Page CanAccess="CanManage" AccessDeniedMessage="You don't have access to cost codes.">
    <WorkspaceSectionNav />
    <PageHeader>
        <SubtitleContent>
            @if (activeTab == CostCodesTab.Ours)
            {
                <text>The global cost-code master. Every project's financials, valuation report and invoice
                allocations group by these codes. Retired codes keep their historical allocations.</text>
            }
            else if (activeTab == CostCodesTab.XeroSites)
            {
                <text>The options of Xero's Sites tracking category, spelt exactly as Xero holds them —
                the names a project's Xero site mapping must match for its costs to land on the right job.</text>
            }
            else
            {
                <text>The options of Xero's Cost Code tracking category, spelt exactly as Xero holds them,
                side by side with the system's own master list.</text>
            }
        </SubtitleContent>
        <Actions>
            @if (activeTab == CostCodesTab.Ours)
            {
                <button type="button" class="btn-primary shrink-0" @onclick="OpenAdd">New cost code</button>
            }
            else
            {
                <Toolbar>
                    <ToolbarButton Icon="refresh" Label="Refresh from Xero"
                                   Busy="@xeroRefreshing" OnClick="ForceRefreshXeroAsync" />
                </Toolbar>
            }
        </Actions>
    </PageHeader>

    <div class="mb-6 inline-flex flex-wrap rounded border border-line overflow-hidden">
        <button class="@TabCss(activeTab == CostCodesTab.Ours)" @onclick="() => SwitchTab(CostCodesTab.Ours)">
            Our cost codes
        </button>
        <button class="@TabCss(activeTab == CostCodesTab.XeroSites)" @onclick="() => SwitchTab(CostCodesTab.XeroSites)">
            Xero sites
        </button>
        <button class="@TabCss(activeTab == CostCodesTab.XeroCostCodes)" @onclick="() => SwitchTab(CostCodesTab.XeroCostCodes)">
            Xero cost codes
        </button>
    </div>

    @if (loadError is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-4">@loadError</Notice>
    }

    @if (activeTab == CostCodesTab.Ours)
    {
    @* One gate over the whole body: the "Show retired" toggle and the export button are read
       off the master list too, so they belong with the table rather than ahead of it. *@
    <LoadGate IsLoading="@(!CostCodesReady)" Prominent="true" Label="Loading cost codes">
    @if (costCodes is null)
    {
        <p class="text-sm text-negative">Couldn't load the cost codes. The reason is in the red bar above — reload to try again.</p>
    }
    else if (costCodes.Count == 0)
    {
        <EmptyState Message="No cost codes yet. Add one to start allocating costs." />
    }
    else
    {
        <div class="mb-3 flex items-center justify-end gap-4">
            <label class="flex items-center gap-2 text-sm text-content-muted cursor-pointer select-none">
                <input type="checkbox" checked="@showRetired" @onchange="e => showRetired = (bool)e.Value!" />
                <span>Show retired</span>
            </label>
            <ExportToExcelButton FileName="Cost codes"
                                 Disabled="@(AllCostCodes.Count == 0)"
                                 ShowIncludeAllRows="@(!showRetired)"
                                 IncludeAllLabel="Include retired"
                                 BuildWorkbook="BuildExportWorkbook" />
        </div>

        @if (VisibleCostCodes.Count == 0)
        {
            <div class="panel p-8 text-center text-sm text-content-subtle">
                No active cost codes. Turn on "Show retired" to see retired codes.
            </div>
        }
        else
        {
        <RecordsTable>
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th class="text-right hidden md:table-cell">Sort order</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var costCode in VisibleCostCodes)
                {
                    <tr class="border-b border-line last:border-0 @(costCode.IsActive ?"" : "opacity-60")">
                        <td class="font-medium text-content whitespace-nowrap">@costCode.Code</td>
                        <td>@costCode.Name</td>
                        <td class="text-right text-content-subtle hidden md:table-cell">@costCode.SortOrder</td>
                        <td>
                            @if (costCode.IsActive)
                            {
                                <Pill Tone="Tone.Positive">Active</Pill>
                            }
                            else
                            {
                                <Pill Tone="Tone.Muted">Retired</Pill>
                            }
                        </td>
                        <td class="text-right whitespace-nowrap">
                            <button type="button" class="text-sm font-medium text-content-muted hover:text-content mr-3" @onclick="() => OpenEdit(costCode)">Edit</button>
                            <button type="button" class="text-sm font-medium text-content-muted hover:text-content" @onclick="() => ToggleActiveAsync(costCode)">
                                @(costCode.IsActive ? "Retire" : "Reinstate")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </RecordsTable>
        }
    }
    </LoadGate>
    }
    else
    {
    @* Both Xero tabs wait on the tracking snapshot in one piece; the sites tab additionally
       waits on the project list so option rows and their linked projects land together. A
       failed projects fetch opens the gate too (projectsFailed), or it would pulse forever. *@
    <LoadGate IsLoading="@(!XeroTabReady)" Prominent="true" Label="Loading from Xero">
    @{ var snapshot = XeroTracking.Snapshot(); }
    @if (snapshot is null)
    {
        <p class="text-sm text-negative">Couldn't reach the API for Xero's tracking categories. The reason is in the red bar above — reload to try again.</p>
    }
    else if (!snapshot.IsConfigured)
    {
        <div class="panel-raised px-5 py-4 text-sm text-content-muted">
            Xero isn't connected yet. Add the custom connection's credentials as the
            <span class="font-mono text-content">Xero__ClientId</span> and
            <span class="font-mono text-content">Xero__ClientSecret</span> app settings on the API, then reload.
        </div>
    }
    else if (snapshot.Error is not null)
    {
        <div class="panel-raised px-5 py-4 text-sm text-content-muted">
            <p class="text-content font-medium mb-1">Xero returned an error</p>
            <p>@snapshot.Error</p>
        </div>
    }
    else
    {
        var sites = activeTab == CostCodesTab.XeroSites;
        var category = sites
            ? snapshot.Categories.FirstOrDefault(c => c.IsSiteCategory)
            : snapshot.Categories.FirstOrDefault(c => c.IsCostCodeCategory);

        @if (category is null)
        {
            <div class="panel-raised px-5 py-4 text-sm text-content-muted">
                <p class="text-content font-medium mb-1">
                    Xero has no tracking category matching the configured @(sites ? "Sites" : "Cost Code") name
                </p>
                @if (snapshot.Categories.Count == 0)
                {
                    <p>Xero returned no tracking categories at all.</p>
                }
                else
                {
                    <p>
                        The categories Xero does have:
                        @string.Join(" · ", snapshot.Categories.Select(c => $"\"{c.Name}\"")).
                        Point the API's Xero settings at one of these if it is the right one.
                    </p>
                }
            </div>
        }
        else
        {
            <div class="mb-3 flex items-center justify-between gap-4 flex-wrap">
                <p class="text-xs text-content-subtle">
                    Xero's tracking category is named "<span class="font-medium text-content">@category.Name</span>"
                    · @category.Options.Count @(category.Options.Count == 1 ? "option" : "options")
                    · fetched @FetchedText(snapshot)
                </p>
                @if (sites && projectsFailed)
                {
                    <p class="text-xs text-negative">Couldn't load the project list — the "Linked project" column can't be filled in.</p>
                }
            </div>

            @if (category.Options.Count == 0)
            {
                <div class="panel p-8 text-center text-sm text-content-subtle">
                    The "@category.Name" category has no options in Xero yet.
                </div>
            }
            else
            {
            <RecordsTable>
                <thead>
                    <tr>
                        <th>@(sites ? "Xero site" : "Xero cost code")</th>
                        <th>Status</th>
                        <th>@(sites ? "Linked project" : "System cost code")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var option in SortedOptions(category))
                    {
                        <tr class="border-b border-line last:border-0 @(option.IsArchived ?"opacity-60" : "")">
                            @* whitespace-pre so a stray leading/trailing space in Xero's
                               spelling stays visible rather than being swallowed — exact
                               phrasing is what this tab is for. *@
                            <td class="font-medium text-content whitespace-pre">@option.Name</td>
                            <td>
                                @if (option.IsArchived)
                                {
                                    <Pill Tone="Tone.Muted">Archived</Pill>
                                }
                                else
                                {
                                    <Pill Tone="Tone.Positive">Active</Pill>
                                }
                            </td>
                            <td>
                                @if (sites)
                                {
                                    var linked = ProjectsMappedTo(option.Name);
                                    @if (linked.Count == 0)
                                    {
                                        <span class="text-content-subtle">—</span>
                                    }
                                    else
                                    {
                                        @string.Join(", ", linked.Select(p => p.Name))
                                    }
                                }
                                else
                                {
                                    var match = SystemCodeFor(option.Name);
                                    @if (match is null)
                                    {
                                        <span class="text-content-subtle">—</span>
                                    }
                                    else
                                    {
                                        <span class="font-medium text-content">@match.Code</span>
                                        <span> · @match.Name</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </RecordsTable>

            @if (sites && !projectsFailed && UnmatchedSiteMappings(category) is { Count: > 0 } unmatched)
            {
                <div class="panel-raised px-5 py-4 text-sm text-content-muted mt-4">
                    <p class="text-content font-medium mb-1">Project mappings that match no Xero site option</p>
                    <p class="mb-2">
                        These projects have a Xero site set that Xero's "@category.Name" category doesn't contain —
                        their write-back will refuse until the mapping matches an option above, letter for letter.
                    </p>
                    <ul class="space-y-1">
                        @foreach (var project in unmatched)
                        {
                            <li><span class="font-medium text-content">@project.Name</span> — mapped to "<span class="whitespace-pre">@project.XeroSiteName</span>"</li>
                        }
                    </ul>
                </div>
            }
            @if (!sites && SystemCodesWithoutXeroOption(category) is { Count: > 0 } missing)
            {
                <div class="panel-raised px-5 py-4 text-sm text-content-muted mt-4">
                    <div class="flex items-start justify-between gap-4 flex-wrap">
                        <div>
                            <p class="text-content font-medium mb-1">Active system codes with no Xero option yet (@missing.Count)</p>
                            <p class="mb-2">
                                The portal doesn't create tracking options in Xero (by decision — it holds no settings
                                write access). A bill approved or coded against one of these is refused until the option
                                exists, so create them in Xero under Settings → Tracking categories, spelt exactly.
                                "List for Xero" gives the exact names, mappings applied, ready to copy.
                            </p>
                        </div>
                        @if (CanManage)
                        {
                            <button type="button" class="btn-primary shrink-0" @onclick="OpenListForXeroAsync">List for Xero…</button>
                        }
                    </div>
                    <p>@string.Join(" · ", missing.Select(c => c.Code))</p>
                </div>
            }
            }
        }
    }
    </LoadGate>
    }

    <Modal IsOpen="adding"
           Title="New cost code"
           ConfirmLabel="@(busy ? "Adding…" : "Add cost code")"
           OnCancel="() => adding = false"
           OnConfirm="AddAsync"
           Class="max-w-lg">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Code" Value="@formCode" OnChange="v => formCode = v" Required="true" />
            <FormField Label="Name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <FormField Label="Sort order (blank to add at the end)" Value="@formSortOrder" OnChange="v => formSortOrder = v" InputType="number" />
        </div>
    </Modal>

    <Modal IsOpen="listingForXero"
           Title="Cost Code options to create in Xero"
           ConfirmLabel="@(copied ? "Copied" : "Copy names")"
           ConfirmDisabled="@(gaps is null || gaps.Error is not null || gaps.Missing.Count == 0)"
           CancelLabel="Close"
           OnCancel="() => listingForXero = false"
           OnConfirm="CopyMissingNamesAsync"
           Class="max-w-2xl">
        <div class="space-y-3 text-sm">
            @if (gaps is null)
            {
                <p class="text-content-muted">Reading Xero's "Cost Code" options…</p>
            }
            else if (gaps.Error is not null)
            {
                <Notice Tone="Tone.Negative">@gaps.Error</Notice>
            }
            else
            {
                <p class="text-content-muted">
                    Xero's "@gaps.CategoryName" category holds <span class="font-medium text-content">@gaps.ActiveOptionCount active</span>
                    option@(gaps.ActiveOptionCount == 1 ? "" : "s") (@gaps.ArchivedOptionCount archived).
                    Xero has historically capped active options per category — if it refuses one, that is the cap, not a typo.
                </p>
                @if (gaps.Missing.Count == 0)
                {
                    <p class="text-content font-medium">Nothing to create — every active code already has an option.</p>
                }
                else
                {
                    <p class="text-content font-medium">
                        Create these @gaps.Missing.Count option@(gaps.Missing.Count == 1 ? "" : "s") in Xero under
                        Settings → Tracking categories → "@gaps.CategoryName", spelt exactly as shown (one per line, ready to paste):
                    </p>
                    <textarea readonly class="field h-48 font-mono text-xs">@MissingNamesText(gaps)</textarea>
                    <div class="max-h-48 overflow-y-auto rounded border border-line">
                        <table class="data-table data-table-dense">
                            <tbody>
                                @foreach (var gap in gaps.Missing)
                                {
                                    <tr>
                                        <td class="font-mono font-medium text-content whitespace-pre">@gap.OptionName</td>
                                        <td>@gap.Name@(gap.OptionName != gap.Code ? $" (code {gap.Code}, mapped)" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (gaps.Archived.Count > 0)
                {
                    <p class="text-content-muted">
                        Archived in Xero — restore them there if still in use:
                        @string.Join(" · ", gaps.Archived.Select(g => g.OptionName))
                    </p>
                }
                <p class="text-content-subtle">Once created, press "Refresh from Xero" on this tab to see them land.</p>
            }
        </div>
    </Modal>

    <Modal IsOpen="editing"
           Title="Edit cost code"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="() => editing = false"
           OnConfirm="SaveEditAsync"
           Class="max-w-lg">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Code" Value="@formCode" OnChange="v => formCode = v" Required="true" />
            <FormField Label="Name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <FormField Label="Sort order" Value="@formSortOrder" OnChange="v => formSortOrder = v" InputType="number" />
        </div>
    </Modal>
</Page>

