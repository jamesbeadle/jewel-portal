@page "/projects/{ProjectId}/work-orders"
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Procurement
@using static Jewel.JPMS.Features.Procurement.WorkOrderDisplay
@using Jewel.JPMS.Features.Projects
@using Jewel.JPMS.Features.Subcontractors
@inject AuthService Auth
@inject SessionService Session
@inject CostCentersReadModel CostCenters
@inject ProjectWorkOrdersReadModel WorkOrders
@inject SubcontractorsReadModel Subcontractors
@inject ProjectListReadModel Projects
@inject WorkOrderGroupingStorage GroupingStorage
@inject ICommandSender Commands
@inject IQueryClient Queries
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Work Orders · JPMS</PageTitle>

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="work-orders">
        <SectionHeader>
            <TitleContent>Work orders by @(groupBySupplier ? "supplier" : "cost centre")</TitleContent>
            <Actions>
            <div class="inline-flex gap-2"
                 title="Group the table by cost centre or by supplier — your choice is remembered">
                <button type="button" @onclick="() => SetGroupingAsync(bySupplier: false)"
                        class="chip @(!groupBySupplier ?"chip-active" : "")">
                    Cost centre
                </button>
                <button type="button" @onclick="() => SetGroupingAsync(bySupplier: true)"
                        class="chip @(groupBySupplier ?"chip-active" : "")">
                    Supplier
                </button>
            </div>
            <SearchInput @bind-Value="supplierSearch" Placeholder="Search by supplier…" Width="w-52" />
            <ExportToExcelButton FileName="Work orders"
                                 Disabled="@(LiveOrders.Count == 0)"
                                 ShowIncludeAllRows="@Searching"
                                 IncludeAllLabel="Ignore search"
                                 BuildWorkbook="BuildExportWorkbook" />
            <button type="button" class="btn-secondary text-sm"
                    title="Raise a work order directly — no bid package — and optionally package it against the valuation lines that priced its scope"
                    @onclick="OpenAdd">
                Add work order
            </button>
            </Actions>
        </SectionHeader>

        @* What happened to the automatic purchase-order email after a release (creation or
           approval) — sent, saved as a mailbox draft, or skipped and why. *@
        @if (poEmailNote is not null)
        {
            <Notice Tone="Tone.Positive" Class="mb-3">
                @poEmailNote
                <button type="button" class="text-xs text-content-subtle underline underline-offset-4 ml-2"
                        @onclick="() => poEmailNote = null">Dismiss</button>
            </Notice>
        }

        @* One panel. The summary line, the table and its footer are the same arithmetic over the
           orders, their cost-centre master names and the per-order invoiced balances — and "no
           work orders recorded" is a real answer, not something to guess at while they load. *@
        <LoadGate IsLoading="@(!OrdersReady && !dataFailed)" Prominent="true" Label="Loading work orders">
        @if (dataFailed)
        {
            <p class="text-sm text-negative">Couldn't load the work orders. The details are in the red bar at the top — reload to try again.</p>
        }
        else if (Orders.Count == 0)
        {
            <EmptyState Message="No work orders recorded for this project yet." />
        }
        else
        {
            <p class="text-sm text-content-subtle mb-4">
                @LiveOrders.Count work order@(LiveOrders.Count == 1 ? "" : "s") issued ·
                <span class="text-content font-medium">@Money(TotalCommitted)</span> committed ·
                @Money(TotalPaid) paid · @Money(KnownRemainingOf(AllLines)) remaining
                @if (UnknownCommittedOf(AllLines) > 0m)
                {
                    <text> · </text><span title="@UnknownCommittedHint">@Money(UnknownCommittedOf(AllLines)) on orders with no bill linked</span>
                }
                @if (DraftOrders.Count > 0)
                {
                    <text> · </text><span class="text-content font-medium">@Money(DraftOrders.Sum(detail => detail.Order.Value))</span><text> in @DraftOrders.Count draft@(DraftOrders.Count == 1 ? "" : "s") awaiting approval</text>
                    <span title="Drafts count in the Financials tab's committed figures but not in this tab's issued totals"> †</span>
                }
                @if (SummariesByOrder.Count > 0)
                {
                    <text> · </text><span class="text-content font-medium">@Money(TotalInvoiced)</span><text> invoiced against orders · @Money(TotalCommitted - TotalInvoiced) left to invoice — see the </text><a class="underline underline-offset-4 hover:text-content" href="@($"/projects/{ProjectId}/work-order-allocation")">WO Allocation tab</a>
                }
                @if (LedgerSyncedAtUtc is { } syncedAt)
                {
                    <span class="block text-xs text-content-subtle mt-1"
                          title="Paid comes from Xero and is only ever as current as this. The ledger sync is a button on the Xero allocation page, not a schedule.">
                        Xero synced @Ago(syncedAt)
                    </span>
                }
            </p>

            @if (DraftOrders.Count > 0)
            {
                <DraftWorkOrdersPanel ProjectId="@ProjectId" Drafts="DraftOrders"
                                      OnEdit="OpenEdit" OnDelete="detail => deleteModal.Open(detail)"
                                      OnPoEmailNote="ShowPoEmailNote" />
            }

            @if (RejectedOrders.Count > 0)
            {
                <RejectedWorkOrdersList ProjectId="@ProjectId" Orders="RejectedOrders" Busy="deleteBusy"
                                        OnDelete="detail => deleteModal.Open(detail)" />
            }

            @if (CancelledOrders.Count > 0)
            {
                <CancelledWorkOrdersList Orders="CancelledOrders" />
            }

            @if (Rows.Count == 0 && OrdersWithoutLines.Count == 0)
            {
                @* Searching: nothing issued matched (drafts that matched are already listed
                   above, so say "issued" when they are). Not searching: every order is still
                   a draft, so an empty table of zeros would say nothing true. *@
                <p class="text-sm text-content-subtle italic">
                    @(Searching
                        ? $"No {(DraftOrders.Count > 0 ? "issued " : "")}work orders match “{supplierSearch.Trim()}”."
                        : "Nothing stands issued — every work order on this project is still awaiting approval, or was rejected or cancelled.")
                </p>
            }
            else
            {
            <WorkOrdersTable Rows="Rows" Total="VisibleTotal" GroupBySupplier="groupBySupplier" Searching="Searching"
                             IsExpanded="IsExpanded" OnToggle="Toggle" LinesFor="LinesFor"
                             CodeOf="CodeOf" CostCentreNameFor="CostCentreNameFor"
                             Summaries="SummariesByOrder" PaymentKnown="PaymentKnown"
                             CancelPendingFor="CancelPendingFor" CancelBusy="cancelBusy" CancelError="@cancelError"
                             OnCancel="CancelAsync" OnKeep="ClearCancelPending"
                             LineMenuItems="LineMenuItems" />
            }

            @if (OrdersWithoutLines.Count > 0)
            {
                <UnpricedWorkOrdersList Orders="OrdersWithoutLines" GroupBySupplier="groupBySupplier"
                                        CancelPendingFor="CancelPendingFor" CancelBusy="cancelBusy" MenuItems="OrderMenuItems"
                                        OnCancel="CancelAsync" OnKeep="ClearCancelPending" />
            }

            <p class="text-xs text-content-subtle mt-3">
                @(groupBySupplier
                    ? "Committed is the sum of work-order line totals per supplier."
                    : "Committed is the sum of work-order line totals per cost centre; one order can span several cost centres, so its value may appear split across rows.")
                Paid is what Xero has settled against the bills linked to each order, spread
                across its lines by value. An order with no bill linked to it shows “–” rather
                than £0.00 — nothing is known about it either way until its bills are linked on
                the WO Allocation tab, and its committed value counts in neither the paid nor
                the remaining totals, so the Remaining column always sums to its total.
                A credit order — value below £0.00 — is the exception: no supplier bill is ever
                due on it, so it reads a factual £0.00 paid and its full credit counts in the
                remaining figure, netting off the order it was raised against.
                Click a row to see the orders behind it. Re-code a line to move it to
                another cost centre, or to split its amount across several — for orders priced wholesale
                under one code whose lines belong to different centres. The parts must total the line
                exactly, so the order's value never changes; the Financials tab, invoice re-attribution
                and reconciliation packages all follow the new coding automatically.
            </p>

            <WorkOrderLineRecodeModal IsOpen="@(recoding is not null)"
                                      ProjectId="@ProjectId"
                                      LineId="@(recoding?.Line.WorkOrderLineId ?? "")"
                                      LineLabel="@(recoding is null ? "" : $"{Reference(recoding.Detail.Order)} · {recoding.Line.Title}")"
                                      LineTotal="@(recoding?.Line.LineTotal ?? 0m)"
                                      CurrentCostCode="@(recoding?.Line.CostCode ?? "")"
                                      CostCenters="CostCenters.Current"
                                      OnClose="CloseRecode"
                                      OnSaved="HandleRecodedAsync" />
        }
        </LoadGate>

        <ManualWorkOrderModal IsOpen="@manualOrderOpen"
                              ProjectId="@ProjectId"
                              Editing="@editingOrder"
                              OnClose="CloseManualOrder"
                              OnSaved="HandleManualOrderSavedAsync"
                              OnPoEmailNote="ShowPoEmailNote" />

        <DeleteWorkOrderModal @ref="deleteModal" ProjectId="@ProjectId" BusyChanged="busy => deleteBusy = busy" />
    </ProjectPageShell>
</Page>

