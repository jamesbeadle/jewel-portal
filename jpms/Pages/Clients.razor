@page "/clients"
@using Jewel.JPMS.Contracts.Clients
@inject AuthService Auth
@inject SessionService Session
@inject IClientStore ClientStore
@inject UserInviteService Invites
@inject NavigationManager Nav

<PageTitle>Clients · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!CanManage)
{
    <section class="px-6 md:px-8 py-12 text-content-subtle text-sm">You don't have access to client accounts.</section>
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6 md:mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Client accounts</h1>
                @* The count waits for the list. Rendering "0 clients" while the fetch is in flight
                   states a fact the page does not yet have; the sentence itself is chrome. *@
                <p class="text-sm text-content-muted mt-2">
                    @if (clients is not null)
                    {
                        <text>@clients.Count client@(clients.Count == 1 ? "" : "s") · </text>
                    }
                    when a client is a project's party, request documents go to the primary contact here. Architects are managed on the <a class="underline hover:text-content" href="/architects">Architects</a> page.
                </p>
            </div>
            <div class="flex items-center gap-4 shrink-0">
                <ExportToExcelButton FileName="Clients"
                                     Disabled="@(AllClients.Count == 0)"
                                     BuildWorkbook="BuildExportWorkbook" />
                <button type="button" class="btn-primary" @onclick="OpenCreate">New client</button>
            </div>
        </header>

        @if (loadError is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@loadError</Notice>
        }

        <LoadGate IsLoading="@(!ClientsReady)" Prominent="true" Label="Loading client accounts">
        @if (clients is null)
        {
            <p class="text-sm text-negative">Couldn't load the client accounts. The reason is in the red bar above — reload to try again.</p>
        }
        else if (clients.Count == 0)
        {
            <div class="panel p-8 text-center text-sm text-content-subtle">No client accounts yet. Create one to link projects and requests to the client.</div>
        }
        else
        {
            <div class="panel overflow-x-auto overflow-y-auto max-h-[85vh]">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-content-subtle border-b border-line">
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Client</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Primary contact</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 font-medium">Contact email</th>
                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in clients)
                        {
                            <tr class="border-b border-line last:border-0">
                                <td class="px-4 py-3 font-medium text-content">@client.Name</td>
                                <td class="px-4 py-3 text-content-muted">@Dash(client.PrimaryContactName)</td>
                                <td class="px-4 py-3 text-content-muted">@Dash(client.PrimaryContactEmail)</td>
                                <td class="px-4 py-3 text-right whitespace-nowrap">
                                    <button type="button" class="text-sm font-medium text-content-muted hover:text-content mr-3" @onclick="() => OpenContacts(client)">Contacts</button>
                                    <button type="button" class="text-sm font-medium text-content-muted hover:text-content mr-3" @onclick="() => OpenEdit(client)">Edit</button>
                                    <button type="button" class="text-sm font-medium text-content-muted hover:text-content" @onclick="() => OpenInvite(client)">Invite to portal</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </LoadGate>
    </section>

    <PartyContactsEditor @ref="contactsEditor" Kind="PartyKind.Client" OnChanged="ReloadAsync" />

    <Modal IsOpen="creating"
           Title="New client account"
           ConfirmLabel="@(busy ? "Creating…" : "Create client")"
           OnCancel="() => creating = false"
           OnConfirm="CreateClientAsync"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Client name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Primary contact name" Value="@formPrimaryName" OnChange="v => formPrimaryName = v" />
                <FormField Label="Primary contact email" Value="@formPrimaryEmail" OnChange="v => formPrimaryEmail = v" />
            </div>
            <p class="text-xs text-content-subtle">Working through an architect on this client's behalf? Add the practice on the <a class="underline hover:text-content" href="/architects">Architects</a> page and select it as the party on the project or request.</p>
        </div>
    </Modal>

    <Modal IsOpen="inviting"
           Title="Invite to the client portal"
           ConfirmLabel="@(inviteBusy ? "Inviting…" : inviteResult is null ? "Send invite" : "Re-send invite")"
           OnCancel="CloseInvite"
           OnConfirm="SendInviteAsync"
           Class="max-w-2xl">
        <div class="space-y-4">
            <p class="text-sm text-content-muted">
                Invites <span class="font-medium text-content">@(inviteTarget?.PrimaryContactName ?? inviteTarget?.Name)</span>
                (@(inviteTarget?.PrimaryContactEmail ?? "no contact email")) to the client portal, where they can follow
                their projects' RFIs and variation orders and join the shared conversation on each. The login is linked
                to this account, so they only ever see their own projects — and never internal notes or email.
            </p>
            @if (inviteError is not null)
            {
                <Notice Tone="Tone.Negative">@inviteError</Notice>
            }
            @if (inviteResult is not null)
            {
                <Notice Tone="Tone.Positive">
                    <p class="mb-1">Invite sent to <span class="font-medium">@inviteResult.Email</span>. If the email doesn't arrive, share this link (valid until @inviteResult.ExpiresAt.LocalDateTime.ToString("d MMM yyyy")):</p>
                    <code class="block break-all text-xs bg-white/60 rounded px-2 py-1">@inviteResult.InviteLink</code>
                </Notice>
            }
        </div>
    </Modal>

    <Modal IsOpen="editing"
           Title="Edit client"
           ConfirmLabel="@(busy ? "Saving…" : "Save changes")"
           OnCancel="() => editing = false"
           OnConfirm="SaveEditAsync"
           Class="max-w-2xl">
        <div class="space-y-4">
            @if (formError is not null)
            {
                <Notice Tone="Tone.Negative">@formError</Notice>
            }
            <FormField Label="Client name" Value="@formName" OnChange="v => formName = v" Required="true" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <FormField Label="Primary contact name" Value="@formPrimaryName" OnChange="v => formPrimaryName = v" />
                <FormField Label="Primary contact email" Value="@formPrimaryEmail" OnChange="v => formPrimaryEmail = v" />
            </div>
        </div>
    </Modal>
}

@code {
    // Session checked and the user signed in. This is NOT "the data is here" — keeping the two
    // apart is what lets the page show its chrome at once and hold the table until the list lands.
    private bool sessionReady;
    private bool busy;
    private string? loadError;
    private string? formError;
    // Nullable on purpose. "No client accounts yet" is a real answer, so "not fetched" needs to be
    // a distinct state — otherwise the empty state is shown before anything was asked.
    private IReadOnlyList<Client>? clients;

    private IReadOnlyList<Client> AllClients => clients ?? Array.Empty<Client>();

    // A failed fetch opens the gate too, or the jewel pulses forever; the red bar above says why.
    private bool ClientsReady => clients is not null || loadError is not null;

    private bool CanManage => Session.AvailableRoles.Any(role => role is Role.Admin or Role.ManagingDirector or Role.ProjectManager);

    private bool creating;
    private bool editing;
    private PartyContactsEditor? contactsEditor;
    private string? editTargetId;
    private string formName = "";
    private string formPrimaryName = "";
    private string formPrimaryEmail = "";

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        // Paint the chrome before the fetch: Blazor re-renders OnInitializedAsync only at its
        // FIRST await, which has already passed, so without this the page waits on the list.
        StateHasChanged();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try { clients = await ClientStore.ListAsync(); loadError = null; }
        catch { loadError = "Couldn't load client accounts. Please try again."; }
    }

    private void OpenCreate()
    {
        formError = null;
        formName = formPrimaryName = formPrimaryEmail = "";
        creating = true;
    }

    // ---- Portal access ----

    private bool inviting;
    private bool inviteBusy;
    private Client? inviteTarget;
    private string? inviteError;
    private Contracts.Auth.InviteResult? inviteResult;

    private void OpenInvite(Client client)
    {
        inviteTarget = client;
        inviteError = null;
        inviteResult = null;
        inviting = true;
    }

    private void CloseInvite() => inviting = false;

    private async Task SendInviteAsync()
    {
        if (inviteBusy || inviteTarget is null) return;
        inviteError = null;
        try
        {
            inviteBusy = true;
            var outcome = await Invites.InviteClientAsync(inviteTarget.ClientId);
            if (outcome.Success) inviteResult = outcome.Result;
            else inviteError = outcome.Error;
        }
        finally { inviteBusy = false; }
    }

    private async Task OpenContacts(Client client)
    {
        if (contactsEditor is not null) await contactsEditor.Open(client.ClientId, client.Name);
    }

    private void OpenEdit(Client client)
    {
        formError = null;
        editTargetId = client.ClientId;
        formName = client.Name;
        formPrimaryName = client.PrimaryContactName ?? "";
        formPrimaryEmail = client.PrimaryContactEmail ?? "";
        editing = true;
    }

    private async Task CreateClientAsync()
    {
        if (busy) return;
        formError = null;
        if (string.IsNullOrWhiteSpace(formName)) { formError = "A client name is required."; return; }
        try
        {
            busy = true;
            await ClientStore.CreateAsync(new CreateClient(
                formName.Trim(),
                NullIfBlank(formPrimaryName),
                NullIfBlank(formPrimaryEmail)));
            creating = false;
            await ReloadAsync();
        }
        catch { formError = "Couldn't create the client. Please try again."; }
        finally { busy = false; }
    }

    private async Task SaveEditAsync()
    {
        if (busy || editTargetId is null) return;
        formError = null;
        if (string.IsNullOrWhiteSpace(formName)) { formError = "A client name is required."; return; }
        try
        {
            busy = true;
            await ClientStore.UpdateContactAsync(new UpdateClientContact(
                editTargetId,
                formName.Trim(),
                NullIfBlank(formPrimaryName),
                NullIfBlank(formPrimaryEmail)));
            editing = false;
            await ReloadAsync();
        }
        catch { formError = "Couldn't save the changes. Please try again."; }
        finally { busy = false; }
    }

    private ExcelWorkbook? BuildExportWorkbook(bool _)
    {
        if (AllClients.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Clients",
            new ExcelColumn("Client"),
            new ExcelColumn("Primary contact"),
            new ExcelColumn("Contact email"));

        foreach (var client in AllClients)
        {
            sheet.AddRow(client.Name, client.PrimaryContactName, client.PrimaryContactEmail);
        }
        return workbook;
    }

    private static string Dash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
