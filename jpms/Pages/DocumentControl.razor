@page "/document-triage"
@* The old route stays routable so pre-rename bookmarks still land. *@
@page "/document-control"
@using Jewel.JPMS.Models
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IDocumentControlStore Store
@inject IIntakeQueue Intake
@inject IDrawingStore DrawingStore
@inject IValuationReportStore ValuationReport
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel Subcontractors
@implements IDisposable

<PageTitle>Document Triage · JPMS</PageTitle>

@*
    Document Triage (renamed from Document Control 2026-08-17; code identifiers, API routes and DB
    tables keep the DocumentControl name) — the attachment triage queue for ALL projects, fed by the
    Control Centre's "Send to document triage" ticks. Emails are triaged there; DOCUMENTS are triaged here: each
    item is a point-in-time copy of one attachment with its email's envelope snapshotted beside it,
    waiting to be filed to a destination — a project's Drawings, the Payment Certificates register,
    or a subcontractor's compliance documents — or discarded (restorable, never deleted).

    Two panes, the email-workbench shape: the document list left, the open document right —
    preview (PDFs and images; everything else downloads), the source email for context, and the
    filing form. Filed and Discarded views keep the history, each filed row saying where it went.
*@

<ApprovedSessionGate>
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · projects@@jewelbb.co.uk</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Document Triage</h1>
            @* A count, not a description, so it waits for its own list — it simply does not
               render until the count is known (see the loading-states notes). *@
            @if (items is not null)
            {
                <p class="text-sm text-content-muted mt-2">
                    @PendingItems.Count document@(PendingItems.Count == 1 ? "" : "s") waiting to be filed.
                </p>
            }
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-6 items-start">

            @* ---- Left: the document list ---- *@
            <div class="space-y-4">
                <div class="sticky top-0 z-10 bg-canvas flex items-center gap-2 border-b border-line">
                    <button type="button" class="@ViewTabClass(DocView.Queue)" @onclick="() => SwitchView(DocView.Queue)">Queue</button>
                    <button type="button" class="@ViewTabClass(DocView.Filed)" @onclick="() => SwitchView(DocView.Filed)">Filed</button>
                    <button type="button" class="@ViewTabClass(DocView.Discarded)" @onclick="() => SwitchView(DocView.Discarded)">Discarded</button>
                </div>

                @if (loadError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@loadError</p>
                }

                @* The gate opens on failure too (dataFailed pattern) — the banner above says why. *@
                <LoadGate IsLoading="@(items is null && loadError is null)" Prominent="true" Label="Loading documents">
                    @if (VisibleItems.Count == 0)
                    {
                        @if (loadError is null)
                        {
                            <div class="panel p-8 text-center">
                                <p class="text-sm text-content">@EmptyText</p>
                                @if (view == DocView.Queue)
                                {
                                    <p class="text-xs text-content-subtle mt-1">
                                        Tick "Send to document triage" on an email's attachments in the Control Centre and they appear here.
                                    </p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @foreach (var item in VisibleItems)
                            {
                                var isOpen = item.DocumentControlItemId == selectedId;
                                <button type="button" @key="item.DocumentControlItemId"
                                        @onclick="() => Select(item.DocumentControlItemId)"
                                        class="w-full text-left rounded-lg border px-3 py-2.5 transition @(isOpen ? "border-accent bg-accent/5" : "border-line bg-surface hover:bg-surface-raised")">
                                    <div class="flex items-baseline justify-between gap-3">
                                        <span class="text-sm font-medium text-content truncate">@item.FileName</span>
                                        <span class="text-xs text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                    </div>
                                    <p class="text-xs text-content-subtle truncate mt-0.5">
                                        @DisplaySender(item)@(string.IsNullOrWhiteSpace(item.Subject) ? "" : $" — {item.Subject}")
                                    </p>
                                    <div class="flex flex-wrap items-center gap-1.5 mt-1">
                                        @if (item.FileSizeBytes > 0)
                                        {
                                            <span class="text-[10px] text-content-subtle">@FormatSize(item.FileSizeBytes)</span>
                                        }
                                        @if (ProjectNameFor(item.ProjectIdHint) is { } hintName)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@hintName</span>
                                        }
                                        @if (item.Status == DocumentControlStatus.Filed)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[10px] font-medium px-2 py-0.5">@item.FiledLabel</span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </LoadGate>
            </div>

            @* ---- Right: the open document ---- *@
            <div>
                @if (Selected is not { } item)
                {
                    <div class="panel p-8 text-center text-sm text-content-subtle">
                        Select a document to preview it, read its email and file it.
                    </div>
                }
                else
                {
                    <div class="panel p-5 space-y-4 relative">
                        @if (busy)
                        {
                            <JewelSpinner Overlay="true" Label="@busyLabel" />
                        }

                        <div>
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="text-lg font-semibold text-content break-all">@item.FileName</h2>
                                <a class="text-xs text-accent hover:underline underline-offset-2 shrink-0 mt-1.5"
                                   href="@Store.FileUrl(item.DocumentControlItemId)" target="_blank" rel="noopener">Download</a>
                            </div>
                            <p class="text-xs text-content-subtle mt-1">
                                @(item.FileSizeBytes > 0 ? $"{FormatSize(item.FileSizeBytes)} · " : "")Received @Date(item.ReceivedAt)
                                · Sent to Document Triage by @item.SentBy, @Date(item.SentAt)
                            </p>
                        </div>

                        @if (actionError is not null)
                        {
                            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                        }
                        @if (fileNote is not null)
                        {
                            <p class="rounded-lg bg-positive/10 border border-positive/30 px-3 py-2 text-sm text-content">@fileNote</p>
                        }

                        @if (item.Status == DocumentControlStatus.Filed)
                        {
                            <div class="rounded-lg border border-positive/30 bg-positive/5 p-3 space-y-1">
                                <p class="text-[11px] uppercase tracking-wider text-positive font-semibold">Filed</p>
                                <p class="text-sm text-content">
                                    @item.FiledLabel — by @item.ResolvedBy, @(item.ResolvedAt is { } filedAt ? Date(filedAt) : "")
                                </p>
                                @if (DestinationHref(item) is { } destination)
                                {
                                    <a class="text-xs text-accent hover:underline underline-offset-2" href="@destination">Open the destination record</a>
                                }
                            </div>
                        }
                        else if (item.Status == DocumentControlStatus.Discarded)
                        {
                            <div class="rounded-lg border border-line bg-surface-raised p-3 space-y-2">
                                <p class="text-sm text-content-muted">
                                    Discarded by @item.ResolvedBy, @(item.ResolvedAt is { } discardedAt ? Date(discardedAt) : "") —
                                    the file and its email context are kept. Restore it to file it after all.
                                </p>
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="DoRestore">Restore to queue</button>
                            </div>
                        }

                        @* ---- Preview: same previewable set as the Control Centre — PDFs and
                              images; Excel and everything else are Download-only. ---- *@
                        @if (IsPdf(item))
                        {
                            <PdfViewer FileUrl="@Store.FileUrl(item.DocumentControlItemId, inline: true)"
                                       DownloadUrl="@Store.FileUrl(item.DocumentControlItemId)"
                                       Caption="@item.FileName" HeightClass="h-[50vh]" />
                        }
                        else if (IsImage(item))
                        {
                            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                                <img src="@Store.FileUrl(item.DocumentControlItemId, inline: true)" alt="@item.FileName"
                                     class="max-h-[50vh] w-auto mx-auto" />
                            </div>
                        }
                        else if (IsZip(item) && item.Status == DocumentControlStatus.Pending)
                        {
                            <div class="rounded-xl border border-line bg-surface-raised p-4 space-y-2">
                                <p class="text-sm text-content">
                                    This is a zip archive. Extract it to split its contents into separate
                                    queue items — each file can then be previewed and filed on its own.
                                </p>
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="DoExtractArchive">
                                    @(busy ? "Extracting…" : "Extract archive")
                                </button>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-content-subtle italic">
                                No inline preview for this file type — use Download to open it.
                            </p>
                        }

                        @* ---- The source email, for context. Read live from the mailbox while the
                              message exists; the snapshot taken at send time is the fallback, so
                              the context never goes blank. ---- *@
                        <div class="rounded-lg bg-surface-raised border border-line p-3 space-y-2">
                            <div class="flex items-center justify-between gap-3">
                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Source email</p>
                                <button type="button" class="text-xs text-accent hover:underline"
                                        @onclick="ToggleSourceEmail">@(sourceEmailOpen ? "Hide" : "Show")</button>
                            </div>
                            <p class="text-sm text-content">
                                <span class="font-medium">@DisplaySender(item)</span>
                                <span class="text-content-subtle"> — @Date(item.ReceivedAt)</span>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Subject))
                            {
                                <p class="text-sm text-content">@item.Subject</p>
                            }
                            @if (sourceEmailOpen)
                            {
                                @if (sourceEmailLoading)
                                {
                                    <p class="text-sm text-content-subtle italic">Loading message…</p>
                                }
                                else if (sourceEmail is { } detail && !string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                                {
                                    <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto max-h-[24rem] overflow-y-auto">@((MarkupString)detail.BodyHtml)</div>
                                }
                                else if (sourceEmail is { } plain && !string.IsNullOrWhiteSpace(plain.BodyHtml))
                                {
                                    <p class="text-sm text-content whitespace-pre-wrap max-h-[24rem] overflow-y-auto">@plain.BodyHtml</p>
                                }
                                else
                                {
                                    <p class="text-sm text-content-subtle italic">
                                        The email couldn't be read from the mailbox (it may have been moved or deleted) —
                                        the sender, date and subject above were captured when the document was sent here.
                                    </p>
                                }
                            }
                        </div>

                        @* ---- Filing: pending documents only — one destination, its own fields. ---- *@
                        @if (item.Status == DocumentControlStatus.Pending)
                        {
                            <div class="pt-3 border-t border-line space-y-3">
                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">File this document</p>

                                <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
                                    <button type="button" @onclick="() => SetDestination(FileDestination.Drawing)"
                                            class="@DestinationTabClass(FileDestination.Drawing)">Drawings</button>
                                    <button type="button" @onclick="() => SetDestination(FileDestination.PaymentCertificate)"
                                            class="@DestinationTabClass(FileDestination.PaymentCertificate)">Payment certificate</button>
                                    <button type="button" @onclick="() => SetDestination(FileDestination.Subcontractor)"
                                            class="@DestinationTabClass(FileDestination.Subcontractor)">Subcontractor document</button>
                                </div>

                                @if (destination == FileDestination.Drawing)
                                {
                                    <p class="text-xs text-content-muted">
                                        The file lands as an <span class="font-medium text-content">unapproved revision</span> —
                                        a new (or blank) code registers a new drawing, named by its file until it is given a code or title; approval follows the normal drawings workflow.
                                    </p>
                                    <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
                                        <button type="button" @onclick="() => SetDrawingMode(isRevision: false)"
                                                class="rounded-md text-xs px-2.5 py-1.5 transition @(!drawingIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                            New drawing
                                        </button>
                                        <button type="button" @onclick="() => SetDrawingMode(isRevision: true)"
                                                class="rounded-md text-xs px-2.5 py-1.5 transition @(drawingIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                            Revision of existing drawing
                                        </button>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                            <select class="field" value="@filingProjectId" @onchange="OnFilingProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptions)
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>
                                        @if (drawingIsRevision)
                                        {
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Existing drawing *</label>
                                                <select class="field" @bind="drawingId" disabled="@string.IsNullOrWhiteSpace(filingProjectId)">
                                                    @if (string.IsNullOrWhiteSpace(filingProjectId))
                                                    {
                                                        <option value="">Select a project first…</option>
                                                    }
                                                    else if (!DrawingStore.DrawingsLoadedFor(filingProjectId))
                                                    {
                                                        <option value="">Loading drawings…</option>
                                                    }
                                                    else if (DrawingOptions.Count == 0)
                                                    {
                                                        <option value="">No drawings on this project yet</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">Select a drawing…</option>
                                                        @foreach (var drawing in DrawingOptions)
                                                        {
                                                            <option value="@drawing.DrawingId">@DrawingNaming.Label(drawing)</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <FormField Label="Drawing code" Value="@drawingCode" OnChange="v => drawingCode = v" />
                                        }
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (!drawingIsRevision)
                                        {
                                            <FormField Label="Title" Value="@drawingTitle" OnChange="v => drawingTitle = v" />
                                        }
                                        <FormField Label="Revision label" Value="@drawingRevision" OnChange="v => drawingRevision = v" />
                                        @if (!drawingIsRevision)
                                        {
                                            <DrawingFolderPicker @ref="drawingFolderPicker" ProjectId="@filingProjectId" />
                                        }
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(filingProjectId) || (drawingIsRevision && string.IsNullOrWhiteSpace(drawingId)))"
                                                @onclick="DoFileAsDrawing">@(busy ? "Filing…" : "File to drawings")</button>
                                        @DiscardControl
                                    </div>
                                }
                                else if (destination == FileDestination.PaymentCertificate)
                                {
                                    <p class="text-xs text-content-muted">
                                        Lands in <span class="font-medium text-content">Finance → Payment Certificates</span>, viewable by project.
                                    </p>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                            <select class="field" value="@filingProjectId" @onchange="OnFilingProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptions)
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Valuation claim</label>
                                            <select class="field" @bind="certificateClaimId" disabled="@string.IsNullOrWhiteSpace(filingProjectId)">
                                                @if (string.IsNullOrWhiteSpace(filingProjectId))
                                                {
                                                    <option value="">Select a project first…</option>
                                                }
                                                else if (!ValuationReport.ReportLoadedFor(filingProjectId))
                                                {
                                                    <option value="">Loading claims…</option>
                                                }
                                                else if (ClaimOptions.Count == 0)
                                                {
                                                    <option value="">No claims on this project yet</option>
                                                }
                                                else
                                                {
                                                    <option value="">Not tied to a claim</option>
                                                    @foreach (var claim in ClaimOptions)
                                                    {
                                                        <option value="@claim.ValuationClaimId">@claim.DisplayName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <FormField Label="Certificate number" Value="@certificateNumber" OnChange="v => certificateNumber = v" Required="true" />
                                        <FormField Label="Certified amount (£)" Value="@certificateAmountText" OnChange="v => certificateAmountText = v" />
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Issued date *</label>
                                            <input type="date" class="field" @bind="certificateIssuedDate" />
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(filingProjectId) || string.IsNullOrWhiteSpace(certificateNumber) || certificateIssuedDate is null)"
                                                @onclick="DoFileAsPaymentCertificate">@(busy ? "Filing…" : "File as payment certificate")</button>
                                        @DiscardControl
                                    </div>
                                }
                                else
                                {
                                    <p class="text-xs text-content-muted">
                                        Lands on the subcontractor's record as the current version of its kind —
                                        superseding, never replacing, exactly like a portal upload.
                                    </p>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subcontractor *</label>
                                            <SearchSelect Options="SubcontractorOptions" Value="@subcontractorId"
                                                          ValueChanged="v => subcontractorId = v"
                                                          Placeholder="Search subcontractors…" WidthClass="w-full"
                                                          InputClass="field" />
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Kind *</label>
                                            @* Free text with suggestions — the same shape as the portal upload, so
                                               "Insurance" filed here and "Public liability insurance" uploaded there
                                               can be steered to ONE spelling per kind (matching is case-insensitive
                                               server-side; a different spelling starts a separate version history). *@
                                            <input class="field" list="doc-control-subbie-kinds" placeholder="RAMS, Insurance, Drawings / Specifications…"
                                                   @bind="subcontractorKind" @bind:event="oninput" />
                                            <datalist id="doc-control-subbie-kinds">
                                                @foreach (var kind in SubcontractorDocumentKinds)
                                                {
                                                    <option value="@kind" />
                                                }
                                            </datalist>
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Expiry date</label>
                                            <input type="date" class="field" @bind="subcontractorExpiry" />
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(subcontractorId) || string.IsNullOrWhiteSpace(subcontractorKind))"
                                                @onclick="DoFileToSubcontractor">@(busy ? "Filing…" : "File to subcontractor")</button>
                                        @DiscardControl
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</ApprovedSessionGate>


@code {
    private RenderFragment DiscardControl =>
        @<button type="button" class="text-sm text-content-muted hover:text-negative" disabled="@busy"
                 @onclick="DoDiscard">Discard</button>;
}
