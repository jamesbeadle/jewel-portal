@page "/document-triage"
@* The old route stays routable so pre-rename bookmarks still land. *@
@page "/document-control"
@using Jewel.JPMS.Models
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IDocumentControlStore Store
@inject IIntakeQueue Intake
@inject IDrawingStore DrawingStore
@inject IValuationReportStore ValuationReport
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel Subcontractors
@implements IDisposable

<PageTitle>Document Triage · JPMS</PageTitle>

@*
    Document Triage (renamed from Document Control 2026-08-17; code identifiers, API routes and DB
    tables keep the DocumentControl name) — the attachment triage queue for ALL projects, fed by the
    Control Centre's "Send to document triage" ticks. Emails are triaged there; DOCUMENTS are triaged here: each
    item is a point-in-time copy of one attachment with its email's envelope snapshotted beside it,
    waiting to be filed to a destination — a project's Drawings, the Payment Certificates register,
    or a subcontractor's compliance documents — or discarded (restorable, never deleted).

    Two panes, the email-workbench shape: the document list left, the open document right —
    preview (PDFs and images; everything else downloads), the source email for context, and the
    filing form. Filed and Discarded views keep the history, each filed row saying where it went.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · projects@@jewelbb.co.uk</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Document Triage</h1>
            @* A count, not a description, so it waits for its own list — it simply does not
               render until the count is known (see the loading-states notes). *@
            @if (items is not null)
            {
                <p class="text-sm text-content-muted mt-2">
                    @PendingItems.Count document@(PendingItems.Count == 1 ? "" : "s") waiting to be filed.
                </p>
            }
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-6 items-start">

            @* ---- Left: the document list ---- *@
            <div class="space-y-4">
                <div class="sticky top-0 z-10 bg-canvas flex items-center gap-2 border-b border-line">
                    <button type="button" class="@ViewTabClass(DocView.Queue)" @onclick="() => SwitchView(DocView.Queue)">Queue</button>
                    <button type="button" class="@ViewTabClass(DocView.Filed)" @onclick="() => SwitchView(DocView.Filed)">Filed</button>
                    <button type="button" class="@ViewTabClass(DocView.Discarded)" @onclick="() => SwitchView(DocView.Discarded)">Discarded</button>
                </div>

                @if (loadError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@loadError</p>
                }

                @* The gate opens on failure too (dataFailed pattern) — the banner above says why. *@
                <LoadGate IsLoading="@(items is null && loadError is null)" Prominent="true" Label="Loading documents">
                    @if (VisibleItems.Count == 0)
                    {
                        @if (loadError is null)
                        {
                            <div class="panel p-8 text-center">
                                <p class="text-sm text-content">@EmptyText</p>
                                @if (view == DocView.Queue)
                                {
                                    <p class="text-xs text-content-subtle mt-1">
                                        Tick "Send to document triage" on an email's attachments in the Control Centre and they appear here.
                                    </p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            @foreach (var item in VisibleItems)
                            {
                                var isOpen = item.DocumentControlItemId == selectedId;
                                <button type="button" @key="item.DocumentControlItemId"
                                        @onclick="() => Select(item.DocumentControlItemId)"
                                        class="w-full text-left rounded-lg border px-3 py-2.5 transition @(isOpen ? "border-accent bg-accent/5" : "border-line bg-surface hover:bg-surface-raised")">
                                    <div class="flex items-baseline justify-between gap-3">
                                        <span class="text-sm font-medium text-content truncate">@item.FileName</span>
                                        <span class="text-xs text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                    </div>
                                    <p class="text-xs text-content-subtle truncate mt-0.5">
                                        @DisplaySender(item)@(string.IsNullOrWhiteSpace(item.Subject) ? "" : $" — {item.Subject}")
                                    </p>
                                    <div class="flex flex-wrap items-center gap-1.5 mt-1">
                                        @if (item.FileSizeBytes > 0)
                                        {
                                            <span class="text-[10px] text-content-subtle">@FormatSize(item.FileSizeBytes)</span>
                                        }
                                        @if (ProjectNameFor(item.ProjectIdHint) is { } hintName)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@hintName</span>
                                        }
                                        @if (item.Status == DocumentControlStatus.Filed)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-[10px] font-medium px-2 py-0.5">@item.FiledLabel</span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </LoadGate>
            </div>

            @* ---- Right: the open document ---- *@
            <div>
                @if (Selected is not { } item)
                {
                    <div class="panel p-8 text-center text-sm text-content-subtle">
                        Select a document to preview it, read its email and file it.
                    </div>
                }
                else
                {
                    <div class="panel p-5 space-y-4 relative">
                        @if (busy)
                        {
                            <JewelSpinner Overlay="true" Label="@busyLabel" />
                        }

                        <div>
                            <div class="flex items-start justify-between gap-3">
                                <h2 class="text-lg font-semibold text-content break-all">@item.FileName</h2>
                                <a class="text-xs text-accent hover:underline underline-offset-2 shrink-0 mt-1.5"
                                   href="@Store.FileUrl(item.DocumentControlItemId)" target="_blank" rel="noopener">Download</a>
                            </div>
                            <p class="text-xs text-content-subtle mt-1">
                                @(item.FileSizeBytes > 0 ? $"{FormatSize(item.FileSizeBytes)} · " : "")Received @Date(item.ReceivedAt)
                                · Sent to Document Triage by @item.SentBy, @Date(item.SentAt)
                            </p>
                        </div>

                        @if (actionError is not null)
                        {
                            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                        }
                        @if (fileNote is not null)
                        {
                            <p class="rounded-lg bg-positive/10 border border-positive/30 px-3 py-2 text-sm text-content">@fileNote</p>
                        }

                        @if (item.Status == DocumentControlStatus.Filed)
                        {
                            <div class="rounded-lg border border-positive/30 bg-positive/5 p-3 space-y-1">
                                <p class="text-[11px] uppercase tracking-wider text-positive font-semibold">Filed</p>
                                <p class="text-sm text-content">
                                    @item.FiledLabel — by @item.ResolvedBy, @(item.ResolvedAt is { } filedAt ? Date(filedAt) : "")
                                </p>
                                @if (DestinationHref(item) is { } destination)
                                {
                                    <a class="text-xs text-accent hover:underline underline-offset-2" href="@destination">Open the destination record</a>
                                }
                            </div>
                        }
                        else if (item.Status == DocumentControlStatus.Discarded)
                        {
                            <div class="rounded-lg border border-line bg-surface-raised p-3 space-y-2">
                                <p class="text-sm text-content-muted">
                                    Discarded by @item.ResolvedBy, @(item.ResolvedAt is { } discardedAt ? Date(discardedAt) : "") —
                                    the file and its email context are kept. Restore it to file it after all.
                                </p>
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="DoRestore">Restore to queue</button>
                            </div>
                        }

                        @* ---- Preview: same previewable set as the Control Centre — PDFs and
                              images; Excel and everything else are Download-only. ---- *@
                        @if (IsPdf(item))
                        {
                            <PdfViewer FileUrl="@Store.FileUrl(item.DocumentControlItemId, inline: true)"
                                       DownloadUrl="@Store.FileUrl(item.DocumentControlItemId)"
                                       Caption="@item.FileName" HeightClass="h-[50vh]" />
                        }
                        else if (IsImage(item))
                        {
                            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                                <img src="@Store.FileUrl(item.DocumentControlItemId, inline: true)" alt="@item.FileName"
                                     class="max-h-[50vh] w-auto mx-auto" />
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-content-subtle italic">
                                No inline preview for this file type — use Download to open it.
                            </p>
                        }

                        @* ---- The source email, for context. Read live from the mailbox while the
                              message exists; the snapshot taken at send time is the fallback, so
                              the context never goes blank. ---- *@
                        <div class="rounded-lg bg-surface-raised border border-line p-3 space-y-2">
                            <div class="flex items-center justify-between gap-3">
                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Source email</p>
                                <button type="button" class="text-xs text-accent hover:underline"
                                        @onclick="ToggleSourceEmail">@(sourceEmailOpen ? "Hide" : "Show")</button>
                            </div>
                            <p class="text-sm text-content">
                                <span class="font-medium">@DisplaySender(item)</span>
                                <span class="text-content-subtle"> — @Date(item.ReceivedAt)</span>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(item.Subject))
                            {
                                <p class="text-sm text-content">@item.Subject</p>
                            }
                            @if (sourceEmailOpen)
                            {
                                @if (sourceEmailLoading)
                                {
                                    <p class="text-sm text-content-subtle italic">Loading message…</p>
                                }
                                else if (sourceEmail is { } detail && !string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                                {
                                    <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto max-h-[24rem] overflow-y-auto">@((MarkupString)detail.BodyHtml)</div>
                                }
                                else if (sourceEmail is { } plain && !string.IsNullOrWhiteSpace(plain.BodyHtml))
                                {
                                    <p class="text-sm text-content whitespace-pre-wrap max-h-[24rem] overflow-y-auto">@plain.BodyHtml</p>
                                }
                                else
                                {
                                    <p class="text-sm text-content-subtle italic">
                                        The email couldn't be read from the mailbox (it may have been moved or deleted) —
                                        the sender, date and subject above were captured when the document was sent here.
                                    </p>
                                }
                            }
                        </div>

                        @* ---- Filing: pending documents only — one destination, its own fields. ---- *@
                        @if (item.Status == DocumentControlStatus.Pending)
                        {
                            <div class="pt-3 border-t border-line space-y-3">
                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">File this document</p>

                                <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
                                    <button type="button" @onclick="() => SetDestination(FileDestination.Drawing)"
                                            class="@DestinationTabClass(FileDestination.Drawing)">Drawings</button>
                                    <button type="button" @onclick="() => SetDestination(FileDestination.PaymentCertificate)"
                                            class="@DestinationTabClass(FileDestination.PaymentCertificate)">Payment certificate</button>
                                    <button type="button" @onclick="() => SetDestination(FileDestination.Subcontractor)"
                                            class="@DestinationTabClass(FileDestination.Subcontractor)">Subcontractor document</button>
                                </div>

                                @if (destination == FileDestination.Drawing)
                                {
                                    <p class="text-xs text-content-muted">
                                        The file lands as an <span class="font-medium text-content">unapproved revision</span> —
                                        a new (or blank) code registers a new drawing, named by its file until it is given a code or title; approval follows the normal drawings workflow.
                                    </p>
                                    <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
                                        <button type="button" @onclick="() => SetDrawingMode(isRevision: false)"
                                                class="rounded-md text-xs px-2.5 py-1.5 transition @(!drawingIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                            New drawing
                                        </button>
                                        <button type="button" @onclick="() => SetDrawingMode(isRevision: true)"
                                                class="rounded-md text-xs px-2.5 py-1.5 transition @(drawingIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                            Revision of existing drawing
                                        </button>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                            <select class="field" value="@filingProjectId" @onchange="OnFilingProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptions)
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>
                                        @if (drawingIsRevision)
                                        {
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Existing drawing *</label>
                                                <select class="field" @bind="drawingId" disabled="@string.IsNullOrWhiteSpace(filingProjectId)">
                                                    @if (string.IsNullOrWhiteSpace(filingProjectId))
                                                    {
                                                        <option value="">Select a project first…</option>
                                                    }
                                                    else if (!DrawingStore.DrawingsLoadedFor(filingProjectId))
                                                    {
                                                        <option value="">Loading drawings…</option>
                                                    }
                                                    else if (DrawingOptions.Count == 0)
                                                    {
                                                        <option value="">No drawings on this project yet</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="">Select a drawing…</option>
                                                        @foreach (var drawing in DrawingOptions)
                                                        {
                                                            <option value="@drawing.DrawingId">@DrawingNaming.Label(drawing)</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        }
                                        else
                                        {
                                            <FormField Label="Drawing code" Value="@drawingCode" OnChange="v => drawingCode = v" />
                                        }
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        @if (!drawingIsRevision)
                                        {
                                            <FormField Label="Title" Value="@drawingTitle" OnChange="v => drawingTitle = v" />
                                        }
                                        <FormField Label="Revision label" Value="@drawingRevision" OnChange="v => drawingRevision = v" />
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(filingProjectId) || (drawingIsRevision && string.IsNullOrWhiteSpace(drawingId)))"
                                                @onclick="DoFileAsDrawing">@(busy ? "Filing…" : "File to drawings")</button>
                                        @DiscardControl
                                    </div>
                                }
                                else if (destination == FileDestination.PaymentCertificate)
                                {
                                    <p class="text-xs text-content-muted">
                                        Lands in <span class="font-medium text-content">Finance → Payment Certificates</span>, viewable by project.
                                    </p>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                            <select class="field" value="@filingProjectId" @onchange="OnFilingProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptions)
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Valuation claim</label>
                                            <select class="field" @bind="certificateClaimId" disabled="@string.IsNullOrWhiteSpace(filingProjectId)">
                                                @if (string.IsNullOrWhiteSpace(filingProjectId))
                                                {
                                                    <option value="">Select a project first…</option>
                                                }
                                                else if (!ValuationReport.ReportLoadedFor(filingProjectId))
                                                {
                                                    <option value="">Loading claims…</option>
                                                }
                                                else if (ClaimOptions.Count == 0)
                                                {
                                                    <option value="">No claims on this project yet</option>
                                                }
                                                else
                                                {
                                                    <option value="">Not tied to a claim</option>
                                                    @foreach (var claim in ClaimOptions)
                                                    {
                                                        <option value="@claim.ValuationClaimId">@claim.DisplayName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <FormField Label="Certificate number" Value="@certificateNumber" OnChange="v => certificateNumber = v" Required="true" />
                                        <FormField Label="Certified amount (£)" Value="@certificateAmountText" OnChange="v => certificateAmountText = v" />
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Issued date *</label>
                                            <input type="date" class="field" @bind="certificateIssuedDate" />
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(filingProjectId) || string.IsNullOrWhiteSpace(certificateNumber) || certificateIssuedDate is null)"
                                                @onclick="DoFileAsPaymentCertificate">@(busy ? "Filing…" : "File as payment certificate")</button>
                                        @DiscardControl
                                    </div>
                                }
                                else
                                {
                                    <p class="text-xs text-content-muted">
                                        Lands on the subcontractor's record as the current version of its kind —
                                        superseding, never replacing, exactly like a portal upload.
                                    </p>
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subcontractor *</label>
                                            <SearchSelect Options="SubcontractorOptions" Value="@subcontractorId"
                                                          ValueChanged="v => subcontractorId = v"
                                                          Placeholder="Search subcontractors…" WidthClass="w-full"
                                                          InputClass="field" />
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Kind *</label>
                                            @* Free text with suggestions — the same shape as the portal upload, so
                                               "Insurance" filed here and "Public liability insurance" uploaded there
                                               can be steered to ONE spelling per kind (matching is case-insensitive
                                               server-side; a different spelling starts a separate version history). *@
                                            <input class="field" list="doc-control-subbie-kinds" placeholder="RAMS, Insurance, Drawings / Specifications…"
                                                   @bind="subcontractorKind" @bind:event="oninput" />
                                            <datalist id="doc-control-subbie-kinds">
                                                @foreach (var kind in SubcontractorDocumentKinds)
                                                {
                                                    <option value="@kind" />
                                                }
                                            </datalist>
                                        </div>
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Expiry date</label>
                                            <input type="date" class="field" @bind="subcontractorExpiry" />
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <button type="button" class="btn-primary"
                                                disabled="@(busy || string.IsNullOrWhiteSpace(subcontractorId) || string.IsNullOrWhiteSpace(subcontractorKind))"
                                                @onclick="DoFileToSubcontractor">@(busy ? "Filing…" : "File to subcontractor")</button>
                                        @DiscardControl
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    private enum DocView { Queue, Filed, Discarded }
    private enum FileDestination { Drawing, PaymentCertificate, Subcontractor }

    // Suggested kinds — the three Document Triage groupings first (RAMS, insurance,
    // drawings/specs), then the portal upload's own insurance spellings so a filing here lands
    // in the same version history as a portal upload of the same document.
    private static readonly string[] SubcontractorDocumentKinds =
    {
        "RAMS", "Insurance", "Drawings / Specifications",
        "Public liability insurance", "Employers liability insurance"
    };

    private bool sessionReady;

    // Nullable backing field: null is the honest "not fetched yet" (the section renders a gate,
    // never a confident empty state, until the fetch lands or fails).
    private IReadOnlyList<DocumentControlItem>? items;
    private string? loadError;

    private DocView view = DocView.Queue;
    private string? selectedId;
    private bool busy;
    private string busyLabel = "Working";
    private string? actionError;
    private string? fileNote;

    // ---- The source email: fetched live per item on first open; null after a failed fetch,
    //      which the pane renders as the snapshot-only fallback. ----
    private bool sourceEmailOpen;
    private bool sourceEmailLoading;
    private MailboxMessageDetail? sourceEmail;

    // ---- Filing form state — reset whenever the selection changes. ----
    private FileDestination destination = FileDestination.Drawing;
    private string filingProjectId = "";
    private bool drawingIsRevision;
    private string drawingId = "";
    private string drawingCode = "";
    private string drawingTitle = "";
    private string drawingRevision = "";
    private string certificateNumber = "";
    private string certificateAmountText = "";
    private DateTime? certificateIssuedDate;
    private string certificateClaimId = "";
    private string subcontractorId = "";
    private string subcontractorKind = "";
    private DateTime? subcontractorExpiry;

    private RenderFragment DiscardControl =>
        @<button type="button" class="text-sm text-content-muted hover:text-negative" disabled="@busy"
                 @onclick="DoDiscard">Discard</button>;

    private IReadOnlyList<DocumentControlItem> AllItems => items ?? Array.Empty<DocumentControlItem>();
    private IReadOnlyList<DocumentControlItem> PendingItems =>
        AllItems.Where(item => item.Status == DocumentControlStatus.Pending).ToList();
    private IReadOnlyList<DocumentControlItem> VisibleItems =>
        AllItems.Where(item => item.Status == StatusFor(view)).ToList();

    private DocumentControlItem? Selected =>
        selectedId is null ? null : AllItems.FirstOrDefault(item => item.DocumentControlItemId == selectedId);

    private static DocumentControlStatus StatusFor(DocView view) => view switch
    {
        DocView.Filed => DocumentControlStatus.Filed,
        DocView.Discarded => DocumentControlStatus.Discarded,
        _ => DocumentControlStatus.Pending
    };

    private string EmptyText => view switch
    {
        DocView.Filed => "Nothing has been filed yet.",
        DocView.Discarded => "Nothing has been discarded.",
        _ => "No documents waiting."
    };

    private IReadOnlyList<Project> ProjectOptions =>
        (ProjectList.Current ?? Array.Empty<Project>()).InWorkOrder().ToList();

    private IReadOnlyList<Drawing> DrawingOptions =>
        string.IsNullOrWhiteSpace(filingProjectId) ? Array.Empty<Drawing>() : DrawingStore.DrawingsFor(filingProjectId);

    private IReadOnlyList<ValuationClaim> ClaimOptions =>
        string.IsNullOrWhiteSpace(filingProjectId)
            ? Array.Empty<ValuationClaim>()
            : ValuationReport.ClaimsFor(filingProjectId).OrderByDescending(claim => claim.ClaimNumber).ToList();

    private IReadOnlyList<SearchSelect.Option> SubcontractorOptions =>
        (Subcontractors.Current ?? Array.Empty<Subcontractor>())
            .OrderBy(sub => sub.CompanyName, StringComparer.OrdinalIgnoreCase)
            .Select(sub => new SearchSelect.Option(sub.SubcontractorId, sub.CompanyName))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        StateHasChanged();

        DrawingStore.OnChange += StateHasChanged;
        ValuationReport.OnChange += StateHasChanged;
        ProjectList.OnChanged += StateHasChanged;
        Subcontractors.OnChanged += StateHasChanged;

        // The pickers' sources load in the background — losing one costs a picker its options,
        // not the page; each control says "Loading…" in its own language, never a gate.
        _ = LoadPickerSourcesAsync();
        await LoadItemsAsync();
    }

    private async Task LoadPickerSourcesAsync()
    {
        try { await Task.WhenAll(ProjectList.RefreshAsync(CancellationToken.None), Subcontractors.RefreshAsync(CancellationToken.None)); }
        catch { /* reported by the query client; the pickers render empty */ }
    }

    private async Task LoadItemsAsync()
    {
        try
        {
            loadError = null;
            items = await Store.ListAsync();
        }
        catch
        {
            // The error toast carries the reference and the detail; this opens the gate honestly.
            loadError = "Couldn't load Document Triage. Refresh to try again.";
        }
        StateHasChanged();
    }

    private void SwitchView(DocView next)
    {
        if (view == next) return;
        view = next;
        // The open document stays open only if it lives in the new view.
        if (Selected is { } open && open.Status != StatusFor(next)) selectedId = null;
    }

    private void Select(string itemId)
    {
        if (selectedId == itemId) return;
        selectedId = itemId;
        actionError = null;
        fileNote = null;
        sourceEmailOpen = false;
        sourceEmailLoading = false;
        sourceEmail = null;
        ResetFilingForm();
    }

    private void ResetFilingForm()
    {
        var item = Selected;
        destination = FileDestination.Drawing;
        drawingIsRevision = false;
        drawingId = "";
        certificateNumber = "";
        certificateAmountText = "";
        certificateIssuedDate = null;
        certificateClaimId = "";
        subcontractorId = "";
        subcontractorKind = "";
        subcontractorExpiry = null;
        // The email's triage project is the hint; the drawing fields prefill from the file name
        // ("PRO-064-(WD)-P-800 Rev I Site set out.pdf" → code / revision / title).
        filingProjectId = item?.ProjectIdHint ?? "";
        PrefillDrawingFieldsFromFileName(item?.FileName ?? "");
        if (!string.IsNullOrWhiteSpace(filingProjectId)) RefreshProjectScopedSources();
    }

    private void RefreshProjectScopedSources()
    {
        DrawingStore.Refresh(filingProjectId);
        ValuationReport.Refresh(filingProjectId);
    }

    private void OnFilingProjectChanged(ChangeEventArgs e)
    {
        filingProjectId = e.Value?.ToString() ?? "";
        drawingId = "";
        certificateClaimId = "";
        if (!string.IsNullOrWhiteSpace(filingProjectId)) RefreshProjectScopedSources();
    }

    private void SetDestination(FileDestination next)
    {
        destination = next;
        actionError = null;
    }

    private void SetDrawingMode(bool isRevision)
    {
        drawingIsRevision = isRevision;
        actionError = null;
        if (isRevision && !string.IsNullOrWhiteSpace(filingProjectId)) DrawingStore.Refresh(filingProjectId);
    }

    // "PRO-064-(WD)-P-800 Rev I Site set out.pdf" → code "PRO-064-(WD)-P-800", revision "I",
    // title "Site set out". With no "Rev X" the fields stay blank — the register then names the
    // drawing by its file, which beats a file name masquerading as a code. Moved from the Control
    // Centre's retired save-to-drawings form (2026-08-12).
    private void PrefillDrawingFieldsFromFileName(string fileName)
    {
        var name = System.IO.Path.GetFileNameWithoutExtension(fileName ?? "").Trim();
        var match = System.Text.RegularExpressions.Regex.Match(
            name, @"^(?<code>.+?)[\s\-–—]+Rev(?:ision)?\.?\s*(?<rev>[A-Za-z0-9]{1,3})\b[\s\-–—]*(?<title>.*)$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (match.Success)
        {
            drawingCode = match.Groups["code"].Value.Trim();
            drawingRevision = match.Groups["rev"].Value.Trim().ToUpperInvariant();
            drawingTitle = match.Groups["title"].Value.Trim();
        }
        else
        {
            drawingCode = "";
            drawingRevision = "";
            drawingTitle = "";
        }
    }

    private async Task ToggleSourceEmail()
    {
        sourceEmailOpen = !sourceEmailOpen;
        if (!sourceEmailOpen || sourceEmail is not null || sourceEmailLoading) return;
        var item = Selected;
        if (item is null) return;
        try
        {
            sourceEmailLoading = true;
            sourceEmail = await Intake.GetMessageDetailAsync(item.MessageId, item.InternetMessageId);
        }
        catch
        {
            // Null renders the snapshot-only fallback — the context never goes blank.
            sourceEmail = null;
        }
        finally { sourceEmailLoading = false; }
    }

    // ---- Filing actions: each runs its command, swaps the returned item into the list (so the
    //      row moves view without a refetch) and says where the document went. ----

    private async Task DoFileAsDrawing()
    {
        var item = Selected;
        if (item is null || busy) return;
        var code = drawingCode.Trim();
        var title = drawingTitle.Trim();
        string? targetDrawingId = null;
        if (drawingIsRevision)
        {
            // The revision joins the picked drawing by id — its code may be blank.
            var target = DrawingOptions.FirstOrDefault(d => d.DrawingId == drawingId);
            if (target is null) { actionError = "Select the drawing this revision belongs to."; return; }
            targetDrawingId = target.DrawingId;
            code = target.DrawingCode;
            title = target.Title;
        }
        await RunFiling("Filing to drawings", () =>
            Store.FileAsDrawingAsync(item.DocumentControlItemId, filingProjectId, code, title, drawingRevision.Trim(), targetDrawingId));
    }

    private async Task DoFileAsPaymentCertificate()
    {
        var item = Selected;
        if (item is null || busy) return;
        decimal? amount = null;
        if (!string.IsNullOrWhiteSpace(certificateAmountText))
        {
            if (!decimal.TryParse(certificateAmountText.Replace("£", "").Replace(",", "").Trim(),
                    System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                actionError = "The certified amount isn't a number — clear it or correct it.";
                return;
            }
            amount = parsed;
        }
        if (certificateIssuedDate is null)
        {
            actionError = "Set the certificate's issued date.";
            return;
        }
        // Date-only, pinned to UTC so the stored day never drifts with the browser's timezone
        // (the same rule as the portal upload's expiry date).
        var issued = new DateTimeOffset(DateTime.SpecifyKind(certificateIssuedDate.Value.Date, DateTimeKind.Utc));
        await RunFiling("Filing payment certificate", () =>
            Store.FileAsPaymentCertificateAsync(
                item.DocumentControlItemId, filingProjectId, certificateNumber.Trim(), amount,
                issued, string.IsNullOrWhiteSpace(certificateClaimId) ? null : certificateClaimId));
    }

    private async Task DoFileToSubcontractor()
    {
        var item = Selected;
        if (item is null || busy) return;
        // Date-only, pinned to UTC — the same conversion the portal upload applies to its expiry.
        DateTimeOffset? expires = subcontractorExpiry is null
            ? null
            : new DateTimeOffset(DateTime.SpecifyKind(subcontractorExpiry.Value.Date, DateTimeKind.Utc));
        await RunFiling("Filing to subcontractor", () =>
            Store.FileToSubcontractorAsync(item.DocumentControlItemId, subcontractorId, subcontractorKind, expires));
    }

    private Task DoDiscard()
    {
        var item = Selected;
        if (item is null || busy) return Task.CompletedTask;
        return RunFiling("Discarding", () => Store.DiscardAsync(item.DocumentControlItemId));
    }

    private Task DoRestore()
    {
        var item = Selected;
        if (item is null || busy) return Task.CompletedTask;
        return RunFiling("Restoring", () => Store.RestoreAsync(item.DocumentControlItemId));
    }

    private async Task RunFiling(string label, Func<Task<DocumentControlItem>> action)
    {
        actionError = null;
        fileNote = null;
        try
        {
            busyLabel = label;
            busy = true;
            var updated = await action();
            items = AllItems
                .Select(existing => existing.DocumentControlItemId == updated.DocumentControlItemId ? updated : existing)
                .ToList();
            fileNote = updated.Status switch
            {
                DocumentControlStatus.Filed => $"Filed as {updated.FiledLabel}.",
                DocumentControlStatus.Discarded => "Discarded — restorable from the Discarded view.",
                _ => "Back in the queue."
            };
        }
        catch (Jewel.JPMS.Cqrs.CommandFailedException ex) { actionError = ex.Message; }
        catch { actionError = "That didn't complete. Please try again."; }
        finally { busy = false; }
    }

    // ---- Display helpers ----

    private string? DestinationHref(DocumentControlItem item) => item.FiledAs switch
    {
        DocumentFiledAs.Drawing when item.FiledRecordId is not null =>
            ProjectFor(item) is { } drawingProject ? $"/projects/{drawingProject}/drawings/{item.FiledRecordId}" : null,
        DocumentFiledAs.PaymentCertificate => "/finance/payment-certificates",
        DocumentFiledAs.SubcontractorDocument => null, // the compliance row's home is the subcontractor record —
                                                       // but the record id is the document, so no deep link yet.
        _ => null
    };

    // Filed drawings know their project only through the label's project name — the hint is the
    // best cheap answer. (Good enough for the link; the drawing page itself is authoritative.)
    private string? ProjectFor(DocumentControlItem item) =>
        !string.IsNullOrWhiteSpace(item.ProjectIdHint) ? item.ProjectIdHint : null;

    private string? ProjectNameFor(string? projectId) =>
        string.IsNullOrWhiteSpace(projectId) ? null : ProjectList.Find(projectId)?.Name;

    private static string DisplaySender(DocumentControlItem item) =>
        !string.IsNullOrWhiteSpace(item.FromName) ? item.FromName
        : !string.IsNullOrWhiteSpace(item.FromEmail) ? item.FromEmail
        : "Unknown sender";

    private static bool IsPdf(DocumentControlItem item) =>
        (item.ContentType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase)
        || item.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    private static bool IsImage(DocumentControlItem item) =>
        (item.ContentType ?? "").StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private string ViewTabClass(DocView tab) =>
        "px-3 py-2 text-sm border-b-2 -mb-px transition "
        + (view == tab
            ? "border-accent text-content font-medium"
            : "border-transparent text-content-muted hover:text-content");

    private string DestinationTabClass(FileDestination tab) =>
        "rounded-md text-xs px-2.5 py-1.5 transition "
        + (destination == tab
            ? "bg-accent text-accent-ink font-medium"
            : "text-content-muted hover:bg-surface-raised");

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    private static string Date(DateTimeOffset value) => value.LocalDateTime.ToString("d MMM yyyy, HH:mm");

    private static string ListDate(DateTimeOffset value)
    {
        var local = value.LocalDateTime;
        var today = DateTime.Today;
        if (local.Date == today) return local.ToString("HH:mm");
        if (local.Date == today.AddDays(-1)) return $"Yesterday {local:HH:mm}";
        if (local.Date > today.AddDays(-6)) return local.ToString("ddd HH:mm");
        return local.ToString("d MMM yyyy");
    }

    public void Dispose()
    {
        DrawingStore.OnChange -= StateHasChanged;
        ValuationReport.OnChange -= StateHasChanged;
        ProjectList.OnChanged -= StateHasChanged;
        Subcontractors.OnChanged -= StateHasChanged;
    }
}
