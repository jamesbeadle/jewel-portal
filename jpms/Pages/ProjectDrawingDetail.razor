@page "/projects/{ProjectId}/drawings/{DrawingId}"
@inject AuthService Auth
@inject SessionService Session
@inject IDrawingStore DrawingStore
@inject BluebeamStatusStore Bluebeam
@inject NavigationManager Nav
@implements IDisposable
@using Jewel.JPMS.Features.Drawings

<PageTitle>Drawing · JPMS</PageTitle>

<ApprovedSessionGate>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="drawings">
        @* Register fetch still in flight — don't flash "not found" before it lands. A FAILED
           fetch opens the gate too (loading-states rule): without that the page pulsed forever. *@
        <LoadGate IsLoading="@(!DrawingStore.DrawingsLoadedFor(ProjectId) && !DrawingStore.DrawingsFailedFor(ProjectId))" Prominent="true" Label="Loading drawing">
        @if (drawing is null)
        {
            @if (DrawingStore.DrawingsFailedFor(ProjectId))
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 flex flex-wrap items-center justify-between gap-3">
                    <span>The drawing register couldn't be loaded just then.</span>
                    <button type="button" class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100 transition"
                            @onclick="() => DrawingStore.RetryDrawings(ProjectId)">Try again</button>
                </div>
            }
            else
            {
                <p class="text-sm text-content-subtle italic">Drawing not found.</p>
            }
        }
        else
        {
            <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
                <a href="@($"/projects/{ProjectId}/drawings")"
                   class="text-sm text-content-subtle hover:text-content underline underline-offset-4">← Back to register</a>
                <div class="flex items-center gap-2">
                    @if (PreviousDrawing is not null)
                    {
                        <a href="@DrawingHref(PreviousDrawing)"
                           class="rounded-lg border border-line-strong text-sm px-3 py-1.5 text-content-muted hover:bg-surface-raised transition">← Previous</a>
                    }
                    @if (Position is not null)
                    {
                        <span class="text-xs text-content-subtle tabular-nums">@Position.Value.index of @Position.Value.total</span>
                    }
                    @if (NextDrawing is not null)
                    {
                        <a href="@DrawingHref(NextDrawing)"
                           class="rounded-lg border border-line-strong text-sm px-3 py-1.5 text-content-muted hover:bg-surface-raised transition">Next →</a>
                    }
                </div>
            </div>

            <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <DrawingDetailsEditor Drawing="drawing" ProjectId="@ProjectId" CanEdit="CanManage" />
                    <p class="text-sm text-content-muted mt-1">
                        Latest approved:
                        @if (DrawingNaming.ApprovedRevisionText(drawing) is { } approvedText)
                        {
                            <span class="font-mono">@approvedText</span>
                        }
                        else
                        {
                            <span class="italic text-content-subtle">none yet</span>
                        }
                    </p>
                    <div class="mt-2 flex items-center gap-2 text-sm text-content-muted">
                        <ActionIcon Name="folder" Class="w-4 h-4 text-content-subtle" />
                        @if (CanManage)
                        {
                            @* Moving is a single act — pick a folder, the drawing moves. Disabled with a
                               loading placeholder until the folder list has landed (never gate a control). *@
                            <select value="@(drawing.DrawingFolderId ?? "")" disabled="@(!FoldersReady || moveBusy)"
                                    @onchange="MoveToFolderAsync"
                                    class="rounded-lg border border-line-strong bg-surface px-2 py-1 text-sm text-content focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent disabled:opacity-60">
                                @if (!FoldersReady)
                                {
                                    <option value="">Loading…</option>
                                }
                                else
                                {
                                    <option value="">No folder (ungrouped)</option>
                                    <DrawingFolderOptions Folders="Folders" />
                                }
                            </select>
                            @* The select saves the moment a folder is picked — there is no confirm
                               button — so say so while it happens and confirm when it has: without
                               this the only sign was a briefly greyed control, and users went
                               looking for a Save button that doesn't exist. *@
                            @if (moveBusy)
                            {
                                <span class="text-xs text-content-subtle">Moving…</span>
                            }
                            else if (moveConfirmation is not null)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-xs font-medium text-emerald-800">
                                    ✓ @moveConfirmation
                                </span>
                            }
                        }
                        else
                        {
                            <span>@(FolderPath ?? "Ungrouped")</span>
                        }
                    </div>
                    @if (moveError is not null)
                    {
                        <p class="mt-2 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg px-3 py-2">@moveError</p>
                    }
                </div>
                @if (CanManage)
                {
                    <div class="flex items-center gap-2">
                        @* Manual pipeline trigger — extraction is deliberately NOT automatic on
                           upload. Queues the previewed revision through Bluebeam (markups) +
                           PdfPig (text layer); the Extracted data panel below shows the run. *@
                        @if (CanExtract)
                        {
                            <button type="button" disabled="@extractBusy" @onclick="DoExtractData"
                                    class="rounded-lg border border-line-strong text-content font-medium text-sm px-3 py-2 hover:bg-surface-raised transition disabled:opacity-60">
                                @(extractBusy ? "Queueing…" : "Extract data")
                            </button>
                        }
                        else
                        {
                            <button type="button" disabled title="@ExtractDisabledReason"
                                    class="rounded-lg border border-line-strong text-content-subtle font-medium text-sm px-3 py-2 cursor-not-allowed opacity-60">
                                Extract data
                            </button>
                        }
                        <button type="button" @onclick="() => isUploading = !isUploading"
                                class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition">
                            @(isUploading ? "Cancel" : "+ Upload new version")
                        </button>
                        <button type="button" disabled="@deleteBusy" @onclick="() => confirmingDelete = true"
                                class="rounded-lg border border-red-300 text-red-700 font-medium text-sm px-3 py-2 hover:bg-red-50 transition disabled:opacity-60">
                            Delete drawing
                        </button>
                    </div>
                }
            </header>

            @if (deleteError is not null)
            {
                <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700">@deleteError</p>
            }

            @if (extractError is not null)
            {
                <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-sm text-red-700">@extractError</p>
            }

            <Modal IsOpen="confirmingDelete"
                   Title="Delete drawing?"
                   ConfirmLabel="@(deleteBusy ? "Deleting…" : "Delete drawing")"
                   OnCancel="() => confirmingDelete = false"
                   OnConfirm="DeleteDrawingAsync">
                <p class="text-sm text-content-muted">
                    This permanently deletes <strong>@DrawingNaming.Label(drawing)</strong>,
                    including all @DrawingStore.RevisionsFor(drawing.DrawingId).Count revision(s) and their files.
                    This cannot be undone.
                </p>
            </Modal>

            @if (isUploading)
            {
                <div class="mb-6">
                    <DrawingRevisionUploadForm ProjectId="@ProjectId" DrawingId="@drawing.DrawingId"
                                               OnUploaded="() => isUploading = false" />
                </div>
            }

            @* Preview and revision list both read the revision set — one gate, so neither can
               announce "no file to preview yet" while the fetch is still running. A FAILED fetch
               opens the gate with the retry below — "Loading revisions" pulsing forever with no
               way out is exactly what the loading-states rules forbid (reported 2026-08-28). *@
            <LoadGate IsLoading="@(!RevisionsReady && !RevisionsFailed)" Prominent="true" Label="Loading revisions">
            @if (!RevisionsReady && RevisionsFailed)
            {
                <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 flex flex-wrap items-center justify-between gap-3">
                    <span>The revisions couldn't be loaded just then.</span>
                    <button type="button" class="rounded-lg border border-red-300 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-100 transition"
                            @onclick="() => DrawingStore.RetryRevisions(DrawingId)">Try again</button>
                </div>
            }
            else
            {
            <div class="grid gap-6 lg:grid-cols-5">
                <div class="lg:col-span-3">
                    @if (PreviewRevision is null)
                    {
                        <div class="rounded-xl border border-line bg-surface p-8 text-center text-sm text-content-subtle italic">
                            No file to preview yet.
                        </div>
                    }
                    else if (IsPdf(PreviewRevision))
                    {
                        @* The in-app pdf.js viewer (zoom, pan, fit, rotate, fullscreen) — the old
                           bare <iframe> left drawings at the mercy of the browser's own viewer. *@
                        <PdfViewer FileUrl="@FileUrl(PreviewRevision, inline: true)"
                                   DownloadUrl="@FileUrl(PreviewRevision, inline: false)"
                                   Caption="@($"Showing {DrawingNaming.RevisionText(PreviewRevision.RevisionLabel)} · {PreviewRevision.FileName}")" />
                    }
                    else if (IsImage(PreviewRevision))
                    {
                        <div class="rounded-xl border border-line bg-surface overflow-hidden">
                            <header class="px-4 py-2.5 border-b border-line bg-surface-raised flex items-center justify-between gap-3">
                                <span class="text-xs text-content-muted font-medium truncate">
                                    Showing @DrawingNaming.RevisionText(PreviewRevision.RevisionLabel) · @PreviewRevision.FileName
                                </span>
                                <a href="@FileUrl(PreviewRevision, inline: false)" target="_blank" rel="noopener"
                                   class="text-xs text-accent hover:underline underline-offset-2 shrink-0">Open / download</a>
                            </header>
                            <img src="@FileUrl(PreviewRevision, inline: true)" alt="Drawing preview"
                                 class="w-full max-h-[70vh] object-contain bg-surface-raised" />
                        </div>
                    }
                    else
                    {
                        <div class="rounded-xl border border-line bg-surface p-8 text-center text-sm text-content-subtle">
                            This file type can't be previewed inline.
                            <a href="@FileUrl(PreviewRevision, inline: false)" target="_blank" rel="noopener"
                               class="text-accent hover:underline underline-offset-2">Download @PreviewRevision.FileName</a>.
                        </div>
                    }
                </div>
                <div class="lg:col-span-2">
                    <DrawingRevisionList Revisions="DrawingStore.RevisionsFor(drawing.DrawingId)"
                                         ProjectId="@ProjectId" DrawingId="@drawing.DrawingId" />
                </div>
            </div>

            <DrawingExtractionPanel @ref="extractionPanel"
                                    ProjectId="@ProjectId" DrawingId="@drawing.DrawingId"
                                    RevisionId="@PreviewRevision?.DrawingRevisionId" CanManage="CanManage" />
            }
            </LoadGate>
        }
        </LoadGate>
    </ProjectPageShell>
</ApprovedSessionGate>

