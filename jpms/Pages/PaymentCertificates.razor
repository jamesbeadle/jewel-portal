@page "/finance/payment-certificates"
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IPaymentCertificateStore Store
@inject IValuationReportStore ValuationReport
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@implements IDisposable

<PageTitle>Payment Certificates · JPMS</PageTitle>

@*
    The payment certificate register — what the client is paying, certified, filed from Document
    Control. Company-wide with a project filter; rows group by project in the standing live-work
    order. Each row: certificate number, issued date, the valuation claim it certifies (when tied),
    the certified amount, and the file (Preview for PDFs, Download for everything).
*@

<ApprovedSessionGate>
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">Finance</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Payment Certificates</h1>
            @if (certificates is not null)
            {
                <p class="text-sm text-content-muted mt-2">
                    @certificates.Count certificate@(certificates.Count == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(projectFilter) ? " across all projects" : "") on record.
                </p>
            }
        </header>

        <div class="mb-4">
            @* SearchSelect's placeholder blank row IS the "All projects" clear — never prepend
               another (the Xero allocation filter's double row is the cautionary tale). *@
            <SearchSelect Options="ProjectFilterOptions" Value="@projectFilter"
                          ValueChanged="OnProjectFilterChanged" Placeholder="All projects" />
        </div>

        @if (loadError is not null)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@loadError</Notice>
        }

        <LoadGate IsLoading="@(certificates is null && loadError is null)" Prominent="true" Label="Loading certificates">
            @if (Certificates.Count == 0)
            {
                @if (loadError is null)
                {
                    <div class="panel p-8 text-center">
                        <p class="text-sm text-content">No payment certificates@(string.IsNullOrWhiteSpace(projectFilter) ? " yet" : " on this project").</p>
                        <p class="text-xs text-content-subtle mt-1">
                            File one from Document Triage — "Payment certificate" — and it appears here.
                        </p>
                    </div>
                }
            }
            else
            {
                <div class="space-y-6">
                    @foreach (var group in GroupedCertificates)
                    {
                        <div class="panel overflow-hidden">
                            <div class="px-4 py-3 bg-surface-raised border-b border-line flex items-baseline justify-between gap-3">
                                <p class="text-sm font-semibold text-content">@group.Title</p>
                                <p class="text-xs text-content-subtle">
                                    @group.Rows.Count certificate@(group.Rows.Count == 1 ? "" : "s")@(group.Total is { } total ? $" · {WholeMoney(total)} certified" : "")
                                </p>
                            </div>
                            <table class="w-full text-sm">
                                <thead class="border-b border-line">
                                    <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                        <th class="px-4 py-2.5">Certificate</th>
                                        <th class="px-4 py-2.5 whitespace-nowrap">Issued</th>
                                        <th class="px-4 py-2.5">Valuation claim</th>
                                        <th class="px-4 py-2.5 text-right whitespace-nowrap">Certified amount</th>
                                        <th class="px-4 py-2.5 text-right">File</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                    @foreach (var certificate in group.Rows)
                                    {
                                        <tr @key="certificate.PaymentCertificateId">
                                            <td class="px-4 py-2.5">
                                                <span class="font-medium text-content">@certificate.CertificateNumber</span>
                                                <span class="block text-xs text-content-subtle truncate max-w-[18rem]" title="@certificate.FileName">@certificate.FileName</span>
                                            </td>
                                            <td class="px-4 py-2.5 whitespace-nowrap text-content">@certificate.IssuedDate.LocalDateTime.ToString("d MMM yyyy")</td>
                                            <td class="px-4 py-2.5 text-content">@ClaimLabel(certificate)</td>
                                            <td class="px-4 py-2.5 text-right tabular-nums text-content">
                                                @(certificate.CertifiedAmount is { } amount ? WholeMoney(amount) : "—")
                                            </td>
                                            <td class="px-4 py-2.5 text-right whitespace-nowrap">
                                                @if (IsPdf(certificate))
                                                {
                                                    <button type="button" class="text-xs text-accent hover:underline mr-3"
                                                            @onclick="() => TogglePreview(certificate.PaymentCertificateId)">
                                                        @(previewId == certificate.PaymentCertificateId ? "Hide preview" : "Preview")
                                                    </button>
                                                }
                                                <a class="text-xs text-accent hover:underline" href="@Store.FileUrl(certificate.PaymentCertificateId)"
                                                   target="_blank" rel="noopener">Download</a>
                                            </td>
                                        </tr>
                                        @if (previewId == certificate.PaymentCertificateId)
                                        {
                                            <tr>
                                                <td colspan="5" class="px-4 py-3 bg-surface-raised">
                                                    <PdfViewer FileUrl="@Store.FileUrl(certificate.PaymentCertificateId, inline: true)"
                                                               DownloadUrl="@Store.FileUrl(certificate.PaymentCertificateId)"
                                                               Caption="@certificate.FileName" HeightClass="h-[60vh]" />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </LoadGate>
    </section>
</ApprovedSessionGate>

@code {

    // Nullable backing field: null is the honest "not fetched yet".
    private IReadOnlyList<PaymentCertificate>? certificates;
    private string? loadError;
    private string projectFilter = "";
    private string? previewId;

    private IReadOnlyList<PaymentCertificate> Certificates => certificates ?? Array.Empty<PaymentCertificate>();

    private sealed record CertificateGroup(string Title, IReadOnlyList<PaymentCertificate> Rows, decimal? Total);

    // Groups follow the standing project order — live work first — with unknown projects last.
    private IReadOnlyList<CertificateGroup> GroupedCertificates
    {
        get
        {
            var projects = (ProjectList.Current ?? Array.Empty<Project>()).InWorkOrder().ToList();
            var byProject = Certificates.GroupBy(certificate => certificate.ProjectId)
                .ToDictionary(group => group.Key, group => group.ToList());
            var groups = new List<CertificateGroup>();
            foreach (var project in projects)
            {
                if (!byProject.Remove(project.ProjectId, out var rows)) continue;
                groups.Add(MakeGroup($"{project.Reference} — {project.Name}", rows));
            }
            // Certificates whose project isn't in the visible list (deleted, or not yet loaded)
            // still render — a register must never quietly drop rows.
            foreach (var (projectId, rows) in byProject)
                groups.Add(MakeGroup(projectId, rows));
            return groups;
        }
    }

    private static CertificateGroup MakeGroup(string title, IReadOnlyList<PaymentCertificate> rows)
    {
        var amounts = rows.Where(row => row.CertifiedAmount is not null).Select(row => row.CertifiedAmount!.Value).ToList();
        return new CertificateGroup(title, rows, amounts.Count > 0 ? amounts.Sum() : null);
    }

    private IReadOnlyList<SearchSelect.Option> ProjectFilterOptions =>
        (ProjectList.Current ?? Array.Empty<Project>()).InWorkOrder()
            .Select(project => new SearchSelect.Option(project.ProjectId, $"{project.Reference} — {project.Name}"))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        StateHasChanged();

        ProjectList.OnChanged += StateHasChanged;
        ValuationReport.OnChange += StateHasChanged;
        _ = LoadProjectListAsync();
        await LoadCertificatesAsync();
    }

    private async Task LoadProjectListAsync()
    {
        try { await ProjectList.RefreshAsync(CancellationToken.None); }
        catch { /* reported by the query client; groups fall back to bare project ids */ }
    }

    private async Task LoadCertificatesAsync()
    {
        try
        {
            loadError = null;
            certificates = await Store.ListAsync(string.IsNullOrWhiteSpace(projectFilter) ? null : projectFilter);
            // Claim labels resolve from each certificate's project report (loaded on demand).
            foreach (var projectId in Certificates.Select(certificate => certificate.ProjectId).Distinct())
                _ = ValuationReport.ClaimsFor(projectId);
        }
        catch
        {
            loadError = "Couldn't load the payment certificates. Refresh to try again.";
        }
        StateHasChanged();
    }

    private async Task OnProjectFilterChanged(string value)
    {
        projectFilter = value;
        previewId = null;
        certificates = null;
        await LoadCertificatesAsync();
    }

    private void TogglePreview(string certificateId) =>
        previewId = previewId == certificateId ? null : certificateId;

    private string ClaimLabel(PaymentCertificate certificate)
    {
        if (string.IsNullOrWhiteSpace(certificate.ValuationClaimId)) return "—";
        var claim = ValuationReport.ClaimsFor(certificate.ProjectId)
            .FirstOrDefault(row => row.ValuationClaimId == certificate.ValuationClaimId);
        // Until the claims land the honest answer is a dash-less blank, not a wrong name.
        return claim?.DisplayName ?? "";
    }

    private static bool IsPdf(PaymentCertificate certificate) =>
        (certificate.ContentType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase)
        || certificate.FileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);


    public void Dispose()
    {
        ProjectList.OnChanged -= StateHasChanged;
        ValuationReport.OnChange -= StateHasChanged;
    }
}
