@page "/rate-library/stale"
@inject AuthService Auth
@inject SessionService Session
@inject IRateLibrary RateLibrary
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Stale rates · JPMS</PageTitle>

<Page>
        <nav class="mb-4 text-sm">
            <a href="/rate-library" class="text-content-subtle hover:text-content underline underline-offset-4">Rate library</a>
            <span class="text-content-subtle mx-2">/</span>
            <span class="text-content-muted font-medium">Stale rates</span>
        </nav>

        <PageHeader>
            <SubtitleContent>
                Rates not priced in over @StaleDayThreshold days. Re-price before next tender.
            </SubtitleContent>
        </PageHeader>

        <div class="mb-3 flex items-center justify-end">
            <ExportToExcelButton FileName="Stale rates"
                                 Disabled="@(Stale.Count == 0)"
                                 BuildWorkbook="BuildExportWorkbook" />
        </div>

        @if (Stale.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No rates currently stale.</p>
        }
        else
        {
            <RateTable Rates="Stale" />
        }
</Page>

@code {
    private const int StaleDayThreshold = 60;

    private IReadOnlyList<Rate> Stale => RateLibrary.Stale(StaleDayThreshold);

    private ExcelWorkbook? BuildExportWorkbook(bool _)
    {
        var rates = Stale;
        if (rates.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Rates",
            new ExcelColumn("Trade"),
            new ExcelColumn("Description"),
            new ExcelColumn("Supplier"),
            new ExcelColumn("Unit"),
            new ExcelColumn("Rate", ExcelFormat.Currency),
            new ExcelColumn("Last priced", ExcelFormat.Date));

        foreach (var rate in rates)
        {
            sheet.AddRow(
                rate.Trade,
                rate.Description,
                rate.SupplierName,
                rate.Unit,
                rate.Value,
                rate.LastPricedAt.LocalDateTime);
        }
        return workbook;
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        RateLibrary.OnChange += StateHasChanged;
    }

    public void Dispose() => RateLibrary.OnChange -= StateHasChanged;
}
