@page "/todos/{TodoItemId}"
@using Jewel.JPMS.Features.Todos
@using Jewel.JPMS.Features.Todos.Detail
@inject AuthService Auth
@inject SessionService Session
@inject ITodoStore TodoStore
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects

<PageTitle>@(item is null ? "To-do" : item.Reference) · JPMS</PageTitle>

@*
    One to-do item's own page — where a click on any to-do list lands (the detail modal retired,
    decision 2026-08-10: the item's surface outgrew a dialog). Everything about the item in one
    place: its facts (with the reassign / move editors), the to-dos LINKED to it by shared tagged
    mail, and its communications — the "JPMS/TODO-####"-tagged emails read live, each answerable
    right here, plus a new outbound email filed to the item. Completing, reopening and deleting
    live here too. The router keys pages by route value, so following a linked to-do re-runs the
    whole load for the new item.
*@

<Page>
    @if (!HasInternalRole)
    {
        <PageHeader Title="Not available" />
        <p class="text-content-muted">To-dos are an internal Jewel surface.</p>
    }
    else
    {
        <a href="/todos" class="text-xs text-content-subtle hover:text-content underline underline-offset-2">← All to-dos</a>

        <LoadGate IsLoading="@itemLoading" Prominent="true" Label="Loading the to-do">
        @if (loadFailed)
        {
            <p class="mt-4 text-sm text-negative">Couldn't load this to-do. The reason is in the red bar above — reload to try again.</p>
        }
        else if (item is null)
        {
            <div class="mt-4">
                <PageHeader Title="This to-do is gone" />
                <p class="text-content-muted">It may have been deleted. The <a class="underline underline-offset-2" href="/todos">To-dos list</a> has everything current.</p>
            </div>
        }
        else
        {
            <PageHeader Eyebrow="@item.Reference">
                <TitleContent>
                    <span class="@(item.IsComplete ? "text-content-subtle line-through" : "")">@item.Title</span>
                    <Pill Tone="@TodoStatus.Tone(item)" Class="shrink-0 ml-3 align-middle">@TodoStatus.Label(item)</Pill>
                </TitleContent>
                <Actions>
                    @if (CanManage)
                    {
                        @* Two-step delete, confirmed in place: the first click arms the button —
                           it restyles and asks — and only the second click actually deletes. *@
                        <button type="button" disabled="@busy" @onclick="DeleteAsync"
                                class="btn-ghost text-negative @(deleteArmed ? "bg-negative/10 font-semibold" : "")">
                            @(deleteArmed ? "Delete this item? Click again to confirm" : "Delete")
                        </button>
                    }
                    @if (CanComplete && !item.IsComplete && !item.IsInProgress)
                    {
                        @* Open → In progress without a note: "I've picked this up." Chases and
                           emails sent from this page move it along on their own. *@
                        <button type="button" class="btn-secondary" disabled="@busy" @onclick="StartAsync">Working on it</button>
                    }
                </Actions>
                <Primary>
                    @if (CanComplete)
                    {
                        <button type="button" class="btn-primary" disabled="@busy" @onclick="ToggleCompleteAsync">
                            @(item.IsComplete ? "Reopen" : "Mark done")
                        </button>
                    }
                </Primary>
            </PageHeader>

            @if (error is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
            }

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
                <div class="lg:col-span-2">
                    <TodoCommunicationsPanel Todo="@item" CanSend="@HasInternalRole" CanFile="@CanTriage" Projects="@ProjectPool" />
                </div>
                <div class="space-y-6">
                    <TodoFactsPanel Item="@item" ScopeLabel="@ScopeLabel(item)" Busy="@busy"
                                    CanReassign="@CanManage" AssigneeOptions="@assigneeOptions" Reassign="@ReassignAsync"
                                    CanMove="@CanManage" MoveOptions="@MoveOptions" Move="@MoveAsync" />
                    <TodoActivityPanel TodoItemId="@TodoItemId" Version="@activityVersion" Busy="@busy"
                                       CanLog="@(CanComplete && !item.IsComplete)" LogProgress="@LogProgressAsync" />
                    <LinkedTodosPanel TodoItemId="@TodoItemId" />
                </div>
            </div>
        }
        </LoadGate>
    }
</Page>
