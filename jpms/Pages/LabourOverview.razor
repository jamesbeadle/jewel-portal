                                    }
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="py-1.5 pr-3 text-content-subtle text-right">CIS @schedule.CisRatePercent.ToString("0")% on labour @schedule.GrossLabour.ToString("N2")</td>
                            <td class="py-1.5 pr-3 text-right tabular-nums text-content-muted">− @schedule.CisDeduction.ToString("N2")</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td colspan="3" class="py-1.5 pr-3 font-medium text-content text-right">Net payable</td>
                            <td class="py-1.5 pr-3 text-right tabular-nums font-semibold text-content">@schedule.NetPayable.ToString("N2")</td>
                            <td></td>
