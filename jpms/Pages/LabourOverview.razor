@page "/labour/overview"
@using Jewel.JPMS.Contracts.Labour
@using Jewel.JPMS.Contracts.Ai
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Projects
@inject AuthService Auth
@inject SessionService Session
@inject ILabourStore Labour
@inject CostCentersReadModel CostCenters
@inject ProjectListReadModel Projects
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Labour overview · JPMS</PageTitle>

@*
    The company-wide Labour overview (docs/Labour-Overview-Forecast-and-Xero-Mapping-Scope.md §4):
    projected labour spend for the month with the submission-confidence bar, the workers × days
    placement grid, by-site and by-cost-code cuts, the chase list and weekly sign-off. Money rides
    on everything here — the endpoint is gated to the managing roles, so nothing needs stripping
    in the view.
*@

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    var snapshot = Labour.Overview(year, month);

    <section class="px-6 md:px-8 py-8 max-w-7xl">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-1">
            <h2 class="text-lg font-semibold text-content">Labour overview</h2>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 text-sm">
                    <button type="button" class="btn-secondary" disabled="@Loading" @onclick="() => MoveMonth(-1)">‹ Prev</button>
                    <span class="text-content-subtle w-28 text-center">@MonthLabel</span>
                    <button type="button" class="btn-secondary" disabled="@Loading" @onclick="() => MoveMonth(1)">Next ›</button>
                </div>
                <Toolbar>
                    <ToolbarButton Icon="refresh" Label="Refresh" Busy="@refreshing" OnClick="RefreshAsync" />
                    <ExportToExcelButton FileName="Labour-overview"
                                         Disabled="@(snapshot is null)"
                                         BuildWorkbook="BuildExportWorkbook" />
                </Toolbar>
                <button type="button" class="btn-primary" @onclick="OpenWeekEntryAsync">Enter a week</button>
            </div>
        </div>
        <p class="text-sm text-content-subtle mb-5 max-w-3xl">
            Every JBB project in one view — this page ignores the project picked in the sidebar.
            Projected cost across every worker for the month, and where each day actually went.
            Contracted days multiplied by day rate, less every day recorded as holiday, a half day
            or not worked. Days not yet submitted stay at the full rate, so the figure is only as
            accurate as the submission rate below.
        </p>

        @if (actionError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@actionError</p>
        }
        @if (weekSummaryLines is not null)
        {
            <div class="rounded-lg bg-positive/10 border border-positive/30 px-3 py-2 text-sm text-positive mb-3">
                @foreach (var line in weekSummaryLines)
                {
                    <p>@line</p>
                }
            </div>
        }

        @* ---- Forecast header: one leading figure, quiet secondaries, the confidence bar. ---- *@
        <Panel Class="mb-6" BodyClass="p-5" IsLoading="@(Loading && !dataFailed)" LoadingLabel="Loading forecast">
            @if (snapshot is null)
            {
                <p class="text-sm text-negative">Couldn't load the overview. The details are in the red bar at the top — refresh to try again.</p>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-start">
                    <MetricStat Label="Projected labour spend" Value="@Pounds(snapshot.Totals.ProjectedSpend)" Class="md:col-span-2" />
                    <article>
                        <p class="text-sm text-content-subtle">Time off logged</p>
                        <p class="mt-1 text-xl font-semibold text-content tracking-tight tabular-nums">− @Pounds(snapshot.Totals.TimeOffCost)</p>
                        <p class="text-[11px] text-content-subtle">holiday and days not worked</p>
                    </article>
                    <article>
                        <p class="text-sm text-content-subtle">Amount due after CIS</p>
                        <p class="mt-1 text-xl font-semibold text-content tracking-tight tabular-nums">@Pounds(snapshot.Totals.AmountDueTotal)</p>
                        <p class="text-[11px] text-content-subtle">net payable this month</p>
                    </article>
                </div>

                @* The confidence bar is an instrument, not a progress bar: one segment per week. *@
                <div class="mt-5">
                    <div class="flex items-baseline justify-between text-xs text-content-subtle mb-1">
                        <span>@ConfidenceLabel(snapshot.Totals) of elapsed days confirmed by timesheet</span>
                        @if (snapshot.Totals.UnconfirmedCost > 0m)
                        {
                            <span class="tabular-nums">@Pounds(snapshot.Totals.UnconfirmedCost) unconfirmed</span>
                        }
                    </div>
                    <div class="flex gap-1 h-2">
                        @foreach (var week in snapshot.Totals.Weeks)
                        {
                            var share = week.ElapsedWorkerDays == 0 ? 0 : (double)week.ConfirmedWorkerDays / week.ElapsedWorkerDays;
                            <div class="flex-1 rounded-full bg-surface-field overflow-hidden"
                                 title="@($"w/c {week.WeekStart:dd MMM} — {week.ConfirmedWorkerDays}/{week.ElapsedWorkerDays} days confirmed{(week.UnconfirmedCost > 0m ? $", {Pounds(week.UnconfirmedCost)} unconfirmed" : "")}")">
                                <div class="h-full bg-accent" style="width: @($"{share * 100:0}%")"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        </Panel>

        @* ---- View selector: local panes, not routes. ---- *@
        <div class="flex items-center gap-1 mb-4">
            @foreach (var (key, label) in Views)
            {
                <button type="button"
                        class="@(view == key ? "btn-secondary bg-surface-raised text-content" : "btn-secondary text-content-subtle")"
                        @onclick="() => view = key">@label</button>
            }
        </div>

        @if (view == "workers")
        {
            <Panel Title="By worker" Class="mb-6" BodyClass="p-0" IsLoading="@(Loading && !dataFailed)" LoadingLabel="Loading workers">
                @if (snapshot is null)
                {
                    <p class="p-5 text-sm text-negative">Couldn't load the overview — refresh to try again.</p>
                }
                else if (snapshot.Workers.Count == 0)
                {
                    <p class="p-5 text-sm text-content-subtle italic">No active workers. Add them on the Workers page.</p>
                }
                else
                {
                    @* The hero: the placement grid — who was where, day by day. *@
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                                    <th class="px-5 py-3">Name</th>
                                    <th class="px-2 py-3 text-right">Rate</th>
                                    <th class="px-2 py-3 text-right">Contracted</th>
                                    <th class="px-2 py-3 text-right">Worked</th>
                                    <th class="px-2 py-3 text-right">Off</th>
                                    <th class="px-2 py-3">Month</th>
                                    <th class="px-5 py-3 text-right">Projected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var worker in snapshot.Workers)
                                {
                                    <tr class="border-b border-line/60 hover:bg-surface-raised/40 cursor-pointer"
                                        @onclick="() => ToggleWorker(worker.WorkerId)">
                                        <td class="px-5 py-2.5 font-medium text-content whitespace-nowrap">@worker.Name</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted whitespace-nowrap">@Pounds(worker.DayRate)</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(worker.ContractedDays)</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(worker.DaysWorked)</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(worker.DaysOff)</td>
                                        <td class="px-2 py-2.5">@PlacementStrip(worker)</td>
                                        <td class="px-5 py-2.5 text-right tabular-nums font-semibold text-content">@Pounds(worker.ProjectedCost)</td>
                                    </tr>
                                    @if (expandedWorkerId == worker.WorkerId)
                                    {
                                        <tr class="border-b border-line/60 bg-surface-raised/30">
                                            <td colspan="8" class="px-5 py-4">@WorkerDetail(worker)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="px-5 py-3 text-[11px] text-content-subtle border-t border-line">
                        Chips are coloured by site; hatched = recorded absence, hollow = elapsed day with nothing recorded yet.
                        Weekdays always show; round chips are weekend days, drawn only when something was recorded on them.
                        Select a row for the day-by-day detail, absence recording and contract settings.
                    </p>
                }
            </Panel>
        }
        else if (view == "sites")
        {
            <Panel Title="By site" Class="mb-6" BodyClass="p-0" IsLoading="@(Loading && !dataFailed)" LoadingLabel="Loading sites">
                @if (snapshot is null)
                {
                    <p class="p-5 text-sm text-negative">Couldn't load the overview — refresh to try again.</p>
                }
                else if (snapshot.Sites.Count == 0)
                {
                    <p class="p-5 text-sm text-content-subtle italic">No labour recorded on any site this month yet.</p>
                }
                else
                {
                    var maxSiteCost = snapshot.Sites.Max(site => site.CostRecorded);
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                                <th class="px-5 py-3">Site</th>
                                <th class="px-2 py-3 w-1/3"></th>
                                <th class="px-2 py-3 text-right">Days</th>
                                <th class="px-5 py-3 text-right">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var site in snapshot.Sites)
                            {
                                <tr class="border-b border-line/60 hover:bg-surface-raised/40 cursor-pointer"
                                    @onclick="() => siteDetailProjectId = siteDetailProjectId == site.ProjectId ? null : site.ProjectId">
                                    <td class="px-5 py-2.5 font-medium text-content">
                                        <span class="inline-block w-2.5 h-2.5 rounded-sm mr-2 align-middle" style="background:@ColourOf(site.ProjectId)"></span>@site.ProjectName
                                    </td>
                                    <td class="px-2 py-2.5">
                                        <div class="h-1.5 rounded-full bg-surface-field overflow-hidden">
                                            <div class="h-full bg-accent/70" style="width:@BarWidth(site.CostRecorded, maxSiteCost)"></div>
                                        </div>
                                    </td>
                                    <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(site.DaysRecorded)</td>
                                    <td class="px-5 py-2.5 text-right tabular-nums font-semibold text-content">@Pounds(site.CostRecorded)</td>
                                </tr>
                                @if (siteDetailProjectId == site.ProjectId)
                                {
                                    <tr class="border-b border-line/60 bg-surface-raised/30">
                                        <td colspan="4" class="px-5 py-4">@SiteDetail(snapshot, site)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </Panel>
        }
        else if (view == "costcodes")
        {
            <Panel Title="By cost code" Class="mb-6" BodyClass="p-0" IsLoading="@(Loading && !dataFailed)" LoadingLabel="Loading cost codes">
                @if (snapshot is null)
                {
                    <p class="p-5 text-sm text-negative">Couldn't load the overview — refresh to try again.</p>
                }
                else if (snapshot.CostCodes.Count == 0)
                {
                    <p class="p-5 text-sm text-content-subtle italic">No labour recorded against any cost code this month yet.</p>
                }
                else
                {
                    var maxCodeCost = snapshot.CostCodes.Max(code => code.CostRecorded);
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                                <th class="px-5 py-3">Cost code</th>
                                <th class="px-2 py-3">Trade</th>
                                <th class="px-2 py-3 w-1/3"></th>
                                <th class="px-2 py-3 text-right">Days</th>
                                <th class="px-5 py-3 text-right">Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var centre in snapshot.CostCodes)
                            {
                                <tr class="border-b border-line/60">
                                    <td class="px-5 py-2.5 font-medium text-content tabular-nums">@centre.CostCode</td>
                                    <td class="px-2 py-2.5 text-content-muted">@centre.Trade</td>
                                    <td class="px-2 py-2.5">
                                        <div class="h-1.5 rounded-full bg-surface-field overflow-hidden">
                                            <div class="h-full bg-accent/70" style="width:@BarWidth(centre.CostRecorded, maxCodeCost)"></div>
                                        </div>
                                    </td>
                                    <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(centre.DaysRecorded)</td>
                                    <td class="px-5 py-2.5 text-right tabular-nums font-semibold text-content">@Pounds(centre.CostRecorded)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </Panel>
        }
        else if (view == "signoff")
        {
            @* ---- Weekly sign-off: a view over approval, never a second state machine. ---- *@
            <Panel Title="Weekly sign-off" Class="mb-6" BodyClass="p-0" IsLoading="@(Loading && !dataFailed)" LoadingLabel="Loading sign-off">
                @if (snapshot is null)
                {
                    <p class="p-5 text-sm text-negative">Couldn't load the overview — refresh to try again.</p>
                }
                else
                {
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                                <th class="px-5 py-3">Name</th>
                                @foreach (var weekStart in MonthWeeks())
                                {
                                    <th class="px-2 py-3 text-center">w/c @weekStart.ToString("dd MMM")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in snapshot.Workers)
                            {
                                <tr class="border-b border-line/60">
                                    <td class="px-5 py-2.5 font-medium text-content whitespace-nowrap">@worker.Name</td>
                                    @foreach (var weekStart in MonthWeeks())
                                    {
                                        <td class="px-2 py-2.5 text-center">@WeekCell(worker, weekStart)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="px-5 py-3 text-[11px] text-content-subtle border-t border-line">
                        A week signs off only when every elapsed weekday is approved, rejected with a
                        reason, or covered by a recorded absence. Approvals themselves live on each
                        project's Labour tab — this marker records that the week was looked at whole.
                    </p>
                }
            </Panel>
        }
        else
        {
            @* ---- Settlement: the per-worker monthly schedule, its verdict, and the §6a run. ---- *@
            var schedules = Labour.Schedules(year, month);
            <Panel Title="Settlement schedules" Class="mb-6" BodyClass="p-0"
                   IsLoading="@(!Labour.SchedulesLoadedFor(year, month) && !dataFailed)" LoadingLabel="Loading schedules">
                @if (schedules is null)
                {
                    <p class="p-5 text-sm text-negative">Couldn't load the schedules — refresh to try again.</p>
                }
                else
                {
                    <div class="flex flex-wrap items-center gap-3 px-5 py-3 border-b border-line">
                        @if (schedules.InvoicesToChase > 0)
                        {
                            <span class="text-[11px] font-semibold rounded-full px-2 py-0.5 bg-negative/10 text-negative">Invoices to chase: @schedules.InvoicesToChase</span>
                        }
                        @if (schedules.WorkersToReconcile > 0)
                        {
                            <span class="text-[11px] font-semibold rounded-full px-2 py-0.5 bg-surface-raised text-content-subtle">To reconcile: @schedules.WorkersToReconcile</span>
                        }
                        <span class="flex-1"></span>
                        <button type="button" class="btn-primary" disabled="@isRunningCoding"
                                @onclick="RunCodingAsync">@(isRunningCoding ? "Coding into Xero…" : "Code month into Xero")</button>
                    </div>
                    <p class="px-5 pt-3 text-xs text-content-subtle">
                        Each worker's signed-off month, split by site × cost code × nature — the exact
                        totals the covering bill is coded to in Dext. The run writes DRAFT bills only:
                        it recodes the covered bill (or stages one if none has arrived), and approval
                        stays with the accountant in Xero. Anything unsigned, unmapped or in variance
                        is skipped and reported, never guessed.
                    </p>
                    @if (codingResults is not null)
                    {
                        <div class="mx-5 mt-3 rounded-lg border border-line bg-surface-raised p-3 text-sm">
                            <p class="font-medium text-content mb-1">Coding run finished:</p>
                            @foreach (var result in codingResults)
                            {
                                <p class="text-content-muted">· <span class="font-medium text-content">@result.WorkerName</span> — @CodingOutcomeLabel(result.Outcome): @result.Detail</p>
                            }
                        </div>
                    }
                    @if (schedules.Workers.Count == 0)
                    {
                        <p class="p-5 text-sm text-content-subtle italic">No approved time or settlement lines this month yet.</p>
                    }
                    else
                    {
                        <table class="w-full text-sm mt-3">
                            <thead>
                                <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                                    <th class="px-5 py-3">Worker</th>
                                    <th class="px-2 py-3 text-right">Gross</th>
                                    <th class="px-2 py-3 text-right">CIS</th>
                                    <th class="px-2 py-3 text-right">Net payable</th>
                                    <th class="px-2 py-3 text-right">Covered bill</th>
                                    <th class="px-2 py-3">Verdict</th>
                                    <th class="px-5 py-3">Coding</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var schedule in schedules.Workers)
                                {
                                    <tr class="border-b border-line/60 hover:bg-surface-raised/40 cursor-pointer"
                                        @onclick="() => expandedScheduleWorkerId = expandedScheduleWorkerId == schedule.WorkerId ? null : schedule.WorkerId">
                                        <td class="px-5 py-2.5 font-medium text-content whitespace-nowrap">
                                            @schedule.WorkerName
                                            @if (!schedule.FullySignedOff)
                                            {
                                                <span class="ml-2 text-[11px] font-semibold rounded-full px-2 py-0.5 bg-surface-raised text-content-subtle" title="Weeks with approved time are not all signed off">not signed off</span>
                                            }
                                        </td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content">@schedule.GrossTotal.ToString("N2")</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">− @schedule.CisDeduction.ToString("N2")</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums font-semibold text-content">@schedule.NetPayable.ToString("N2")</td>
                                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@(schedule.CoveredBillTotal == 0m ? "—" : schedule.CoveredBillTotal.ToString("N2"))</td>
                                        <td class="px-2 py-2.5">@VerdictPill(schedule)</td>
                                        <td class="px-5 py-2.5 text-content-subtle text-xs whitespace-nowrap">
                                            @(schedule.LastCodingOutcome == "" ? "—" : $"{schedule.LastCodingOutcome} · {schedule.LastCodedAt:dd MMM HH:mm}")
                                        </td>
                                    </tr>
                                    @if (expandedScheduleWorkerId == schedule.WorkerId)
                                    {
                                        <tr class="border-b border-line/60 bg-surface-raised/30">
                                            <td colspan="7" class="px-5 py-4">@ScheduleDetail(schedule)</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                }
            </Panel>
        }

        @* ---- Chase list: conditional panel — absent while loading, absent when clear. ---- *@
        @if (snapshot is not null && snapshot.Chase.Count > 0)
        {
            <Panel Title="@($"Chase list ({snapshot.Chase.Count})")" Class="mb-6" BodyClass="p-0">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                            <th class="px-5 py-3">Name</th>
                            <th class="px-2 py-3">Date</th>
                            <th class="px-2 py-3">Why</th>
                            <th class="px-5 py-3 text-right"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in snapshot.Chase.Take(chaseShowAll ? int.MaxValue : 8))
                        {
                            <tr class="border-b border-line/60">
                                <td class="px-5 py-2 font-medium text-content whitespace-nowrap">@item.WorkerName</td>
                                <td class="px-2 py-2 text-content-muted whitespace-nowrap">@item.Date.ToString("ddd dd MMM")</td>
                                <td class="px-2 py-2 text-content-muted">
                                    @(item.Reason == LabourChaseReason.OpenAttendance
                                        ? $"Signed in at {item.ProjectName} — never signed out"
                                        : "No timesheet and no recorded absence")
                                </td>
                                <td class="px-5 py-2 text-right whitespace-nowrap">
                                    @if (dismissingKey == ChaseKey(item))
                                    {
                                        @* Reason inline, where the decision is being made — a dismissal
                                           is a recorded judgement (audited), not a swipe-away. *@
                                        <input class="field w-56 mr-1 text-xs" placeholder="Why does this day need nothing?"
                                               @bind="dismissReason" @bind:event="oninput" />
                                        <button type="button" class="btn-secondary mr-1" disabled="@(chaseBusy || string.IsNullOrWhiteSpace(dismissReason))"
                                                @onclick="() => ConfirmDismissAsync(item)">Dismiss</button>
                                        <button type="button" class="btn-ghost" @onclick="() => dismissingKey = null">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="text-xs text-content-subtle hover:text-content underline mr-3"
                                                @onclick="() => OpenAbsence(item.WorkerId, item.WorkerName, item.Date)">Record absence</button>
                                        <button type="button" class="text-xs text-content-subtle hover:text-content underline"
                                                title="The day was reviewed and needs no timesheet and no absence — dismissed with a reason, audited; it leaves the list and the unconfirmed figures together"
                                                @onclick="() => StartDismiss(item)">Dismiss</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (chaseError is not null)
                {
                    <p class="px-5 py-2 text-sm text-negative">@chaseError</p>
                }
                @if (snapshot.Chase.Count > 8 && !chaseShowAll)
                {
                    <button type="button" class="px-5 py-3 text-xs text-content-subtle hover:text-content underline"
                            @onclick="() => chaseShowAll = true">Show all @snapshot.Chase.Count</button>
                }
                @if (snapshot.DismissedThisMonth > 0)
                {
                    <p class="px-5 py-2 text-xs text-content-subtle border-t border-line/60">
                        @snapshot.DismissedThisMonth day@(snapshot.DismissedThisMonth == 1 ? "" : "s") dismissed this month —
                        the audit trail holds who and why.
                    </p>
                }
            </Panel>
        }
        @* A month whose chase list is empty but carries dismissals still says so — a clean list
           should read as "reviewed", never "unchecked". *@
        @if (snapshot is not null && snapshot.Chase.Count == 0 && snapshot.DismissedThisMonth > 0)
        {
            <p class="text-xs text-content-subtle mb-6">
                Chase list clear — @snapshot.DismissedThisMonth day@(snapshot.DismissedThisMonth == 1 ? "" : "s")
                dismissed this month (audited).
            </p>
        }
    </section>

    @* ---- Absence modal ---- *@
    <Modal IsOpen="@absenceOpen"
           Title="@(string.IsNullOrWhiteSpace(absenceWorkerName) ? "Record absence" : $"Record absence — {absenceWorkerName}")"
           ConfirmLabel="Record" ConfirmDisabled="@(absenceSaving || string.IsNullOrWhiteSpace(absenceWorkerId))"
           OnCancel="CloseAbsence" OnConfirm="SaveAbsenceAsync"
           DismissOnOverlayClick="false">
        <div class="space-y-3">
            <label class="block text-sm text-content-muted">Worker
                <select class="field mt-1" @bind="absenceWorkerId" @bind:after="AbsenceWorkerChanged">
                    <option value="">Worker…</option>
                    @foreach (var worker in Labour.Workers().Where(worker => worker.IsActive).OrderBy(worker => worker.Name))
                    {
                        <option value="@worker.WorkerId">@worker.Name</option>
                    }
                </select>
            </label>
            <div class="grid grid-cols-2 gap-3">
                <label class="block text-sm text-content-muted">From
                    <input class="field mt-1" type="date" @bind="absenceDate" />
                </label>
                <label class="block text-sm text-content-muted">To
                    <input class="field mt-1" type="date" @bind="absenceEndDate" />
                </label>
            </div>
            <p class="text-xs text-content-subtle">Leave To as the same day for a single day off. A longer
                range records each weekday in it — "off all week" is one entry, Monday to Friday.</p>
            <label class="block text-sm text-content-muted">Kind
                <select class="field mt-1" @bind="absenceKind">
                    <option value="@AbsenceKind.Holiday">Holiday</option>
                    <option value="@AbsenceKind.HalfDay">Half day</option>
                    <option value="@AbsenceKind.NotWorked">Not worked</option>
                    <option value="@AbsenceKind.Sick">Sick</option>
                </select>
            </label>
            <label class="block text-sm text-content-muted">Note (optional)
                <input class="field mt-1" @bind="absenceNote" placeholder="e.g. booked leave" />
            </label>
        </div>
    </Modal>

    @* ---- Add materials / travel settlement line ---- *@
    <Modal IsOpen="@settleLineOpen" Title="@($"Add materials / travel — {settleLineWorkerName}")"
           ConfirmLabel="Add line" ConfirmDisabled="@settleLineSaving"
           OnCancel="() => settleLineOpen = false" OnConfirm="SaveSettlementLineAsync">
        <p class="text-xs text-content-subtle mb-3">Labour comes from approved timesheets only. This adds a non-labour line to the worker's month — it changes the Xero account and is never CIS-deducted.</p>
        <div class="space-y-3">
            <label class="block text-sm text-content-muted">Nature
                <select class="field mt-1" @bind="settleLineNature">
                    <option value="@SettlementLineNature.CisMaterials">Materials</option>
                    <option value="@SettlementLineNature.Travel">Travel</option>
                </select>
            </label>
            <label class="block text-sm text-content-muted">Site (project id)
                <input class="field mt-1" @bind="settleLineProjectId" placeholder="Project id" />
            </label>
            <label class="block text-sm text-content-muted">Cost code
                <input class="field mt-1" @bind="settleLineCostCode" placeholder="e.g. 00010" />
            </label>
            <label class="block text-sm text-content-muted">Amount (£, net)
                <input class="field mt-1 w-32" type="number" step="0.01" min="0" @bind="settleLineAmount" />
            </label>
            <label class="block text-sm text-content-muted">Note (optional)
                <input class="field mt-1" @bind="settleLineNote" />
            </label>
            @if (settleLineError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@settleLineError</p>
            }
        </div>
    </Modal>

    @* ---- Enter a week: the accountant's weekly entry. Also the chat's worker_week proposal
           card — the assistant fills the whole week in one update, the user reads and presses
           Save. Each day lands as a Submitted timesheet on its site; the MD codes and approves
           on that project's Labour tab. ---- *@
    <Modal IsOpen="@weekOpen" Title="Enter a worker's week" Class="max-w-2xl"
           ConfirmLabel="@(weekSaving ? "Saving…" : "Save week")" ConfirmDisabled="@weekSaving"
           OnCancel="CloseWeekEntry" OnConfirm="SaveWeekAsync"
           DismissOnOverlayClick="false">
        <p class="text-xs text-content-subtle mb-3">
            A site per day, straight from how the crews report. Every filled day lands as a
            Submitted timesheet in that site's approval queue — the MD codes the cost code and
            approves on the project's Labour tab. Days already recorded are locked here.
        </p>
        <div class="flex flex-wrap items-end gap-3 mb-4">
            <label class="block text-sm text-content-muted">Worker
                <select class="field mt-1" @bind="weekWorkerId" @bind:after="WeekWorkerChangedAsync">
                    <option value="">Worker…</option>
                    @foreach (var worker in Labour.Workers().Where(worker => worker.IsActive).OrderBy(worker => worker.Name))
                    {
                        <option value="@worker.WorkerId">@worker.Name</option>
                    }
                </select>
            </label>
            <div class="flex items-center gap-2 text-sm pb-0.5">
                <button type="button" class="btn-secondary" disabled="@weekSaving" @onclick="() => MoveEntryWeekAsync(-7)">‹ Prev</button>
                <span class="text-content-subtle w-36 text-center">w/c @entryWeekStart.ToString("ddd dd MMM yyyy")</span>
                <button type="button" class="btn-secondary" disabled="@weekSaving" @onclick="() => MoveEntryWeekAsync(7)">Next ›</button>
            </div>
            <span class="flex-1"></span>
            <button type="button" class="btn-secondary" title="Copies the first filled day's site, hours and cost code over the other unlocked weekdays."
                    @onclick="CopyFirstDayDown">Copy down (Mon–Fri)</button>
        </div>
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                    <th class="py-2 pr-3">Day</th>
                    <th class="py-2 pr-3">Site</th>
                    <th class="py-2 pr-3 w-20">Hours</th>
                    <th class="py-2">Cost code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in weekRows)
                {
                    var isWeekend = row.Date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    <tr class="border-b border-line/40 align-middle">
                        <td class="py-1.5 pr-3 whitespace-nowrap @(isWeekend ? "text-content-subtle" : "text-content-muted")">@row.Date.ToString("ddd dd MMM")</td>
                        @if (row.Locked)
                        {
                            <td colspan="3" class="py-1.5 text-content-subtle">
                                <span class="text-[11px] font-semibold rounded-full px-2 py-0.5 bg-surface-raised mr-2">recorded</span>@row.LockedDetail
                            </td>
                        }
                        else
                        {
                            <td class="py-1.5 pr-3">
                                @if (Projects.Current is null)
                                {
                                    <select class="field w-full" disabled><option>Loading projects…</option></select>
                                }
                                else
                                {
                                    <select class="field w-full" value="@row.ProjectId"
                                            @onchange="@(args => SetRowProject(row, (string)args.Value!))">
                                        <option value="">— not on site</option>
                                        @foreach (var project in Projects.Current.InWorkOrder())
                                        {
                                            <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                        }
                                    </select>
                                }
                                @if (row.UnmatchedSite != "")
                                {
                                    <p class="text-[11px] text-negative mt-0.5">Couldn't match "@row.UnmatchedSite" to a project — pick it from the list.</p>
                                }
                            </td>
                            <td class="py-1.5 pr-3">
                                <input class="field w-20" type="number" step="0.5" min="0.5" max="24"
                                       @bind="row.Hours" />
                            </td>
                            <td class="py-1.5">
                                <select class="field w-full" @bind="row.CostCode"
                                        disabled="@(!CostCenters.IsLoaded)">
                                    <option value="">MD codes at approval…</option>
                                    @foreach (var centre in CostCenters.Alphabetical.Where(centre => centre.IsActive))
                                    {
                                        <option value="@centre.Code">@centre.Code — @centre.Name</option>
                                    }
                                </select>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
        @if (weekError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mt-3">@weekError</p>
        }
        <p class="text-xs text-content-subtle mt-3">
            Hours in half-hour steps — a whole day is 8. Leave a day's site as "— not on site" to
            skip it; record holidays and sick days with Record absence instead.
        </p>
    </Modal>
}

@code {
    private RenderFragment PlacementStrip(LabourOverviewWorker worker) => __builder =>
    {
        var byDate = worker.Days.ToLookup(day => day.Date.UtcDateTime.Date);
        var today = DateTime.Today;
        // Weekdays always; weekend days only when this worker has something recorded on them
        // (Jack's ask 2026-08-29: 16 worked days but 14 chips — his two Saturdays were invisible).
        // Worked weekends render as ROUND chips so the Mon–Fri rhythm still reads at a glance.
        var workedWeekends = byDate.Select(group => group.Key)
            .Where(date => date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday);
        var stripDates = MonthWeekdays().Concat(workedWeekends).Distinct().OrderBy(date => date);
        <div class="flex gap-[3px]">
            @foreach (var date in stripDates)
            {
                var isWeekend = date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                var shape = isWeekend ? "rounded-full" : "rounded-[3px]";
                var entries = byDate[date].ToList();
                var absence = entries.FirstOrDefault(entry => entry.Absence is not null);
                var sheet = entries.FirstOrDefault(entry => entry.Status is not null);
                @if (absence is not null)
                {
                    <span class="inline-block w-3 h-3 @shape"
                          title="@($"{date:ddd dd MMM} — {AbsenceLabel(absence.Absence!.Value)}")"
                          style="background: repeating-linear-gradient(45deg, #34373B 0 2px, transparent 2px 4px); border: 1px solid #34373B;"></span>
                }
                else if (sheet is not null)
                {
                    <span class="inline-block w-3 h-3 @shape @(sheet.Status == TimesheetStatus.Rejected ? "ring-1 ring-negative" : "")"
                          title="@($"{date:ddd dd MMM} — {sheet.ProjectName}, {sheet.Hours:0.#} h ({StatusLabel(sheet.Status!.Value)})")"
                          style="background:@ColourOf(sheet.ProjectId)"></span>
                }
                else if (date <= today)
                {
                    <span class="inline-block w-3 h-3 @shape border border-line-strong"
                          title="@($"{date:ddd dd MMM} — nothing recorded")"></span>
                }
                else
                {
                    <span class="inline-block w-3 h-3 @shape bg-surface-field/60"
                          title="@date.ToString("ddd dd MMM")"></span>
                }
            }
        </div>
    };

