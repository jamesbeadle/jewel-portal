@page "/policies"
@using Jewel.JPMS.Contracts.Forms
@using Jewel.JPMS.Contracts.Registers
@using Jewel.JPMS.Features.Forms.Office
@using Jewel.JPMS.Features.Registers
@using Jewel.JPMS.Features.Registers.Policies
@implements IDisposable

<PageTitle>Policies & sign-off · JPMS</PageTitle>

@*
    Staff sign-off forms (docs/Labour-Overview-Forecast-and-Xero-Mapping-Scope.md §8): NDAs,
    staff policies, H&S documents. An admin publishes a revision — its PDF and its declaration —
    to named users, who sign on their own login, and the office sends anyone else a Policy sign-off
    form link; either way a typed name + timestamp against the exact revision. A new revision
    re-triggers the cycle. Deliberately no e-signature integration: the audit row is the record.
*@

<Page OpenTo="JpmsRoleSets.Everyone" Class="max-w-5xl">
    <SectionHeader Title="Policies & sign-off">
        <Actions>
        @if (CanPublish)
        {
            <button type="button" class="btn-primary" @onclick="() => isPublishing = true">Publish for signing</button>
        }
        </Actions>
    </SectionHeader>
    <TableNote IsLead="true" Class="mb-5">
        Documents that need everyone's signature — NDAs, staff policies, H&S. Signing records the
        typed name and the time against the exact revision read, on a portal login or by form link.
    </TableNote>

    <SentLinkNotice Sent="sent" OnDismiss="() => sent = null" />
    @if (note is not null)
    {
        <Notice Tone="Tone.Warning" Class="mb-3" Dismissible OnDismiss="() => note = null">@note</Notice>
    }

    <MyPoliciesPanel />

    @if (CanReadTheRegister && PolicyDocs.Current is { } documents)
    {
        <PublishedPoliciesPanel @ref="published" Documents="documents" CanPublish="CanPublish" CanSend="CanSend"
                                ChasingId="@chasingId" OnSendByLink="document => sendingFor = document"
                                OnChase="ChaseAsync" OnChanged="RefreshAsync" />
    }

    <PolicyPublishModal IsOpen="isPublishing" OnClose="() => isPublishing = false" OnPublished="PublishedAsync" />
    <SendFormInviteModal IsOpen="@(sendingFor is not null)" PresetPolicyDocumentId="@sendingFor?.PolicyDocumentId"
                         OnSent="LinkSentAsync" OnClose="() => sendingFor = null" />
</Page>
