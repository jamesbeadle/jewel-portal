@page "/projects/{ProjectId}/site-instructions"
@using Jewel.JPMS.Contracts.SiteInstructions
@using Jewel.JPMS.Features.SiteInstructions
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject SiteInstructionReadModel SiteInstructions
@inject ICommandSender Commands
@inject IQueryClient Queries
@implements IDisposable

<PageTitle>Site Instructions · JPMS</PageTitle>

@*
    The project's site-instruction register (2026-09-03) — written instructions to site: a short
    title, the instruction itself, and where on site it applies. An instruction is raised here
    directly or from an email in the Control Centre (Internal pathway → Raise Site Instruction —
    the email alone is rarely the instruction, so the triager writes it while filing the email);
    either way it carries a sequential SI-#### reference, which is also its mailbox tag stem — so
    every email filed to the instruction reads back live under it here, exactly like a defect or
    an inventory item.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="site-instructions">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-content">Site Instructions</h2>
            <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition"
                    @onclick="ToggleForm">
                @(formOpen ? "Close" : "Raise instruction")
            </button>
        </div>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @if (formOpen)
        {
            <section class="rounded-xl border border-line bg-surface p-5 mb-5">
                <h3 class="text-sm font-medium text-content-muted mb-3">@(editingId is null ? "Raise a site instruction" : $"Edit {EditingReference}")</h3>
                <div class="space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title *</label>
                            <input type="text" class="field" maxlength="256" placeholder="What the instruction is about"
                                   value="@formTitle" @oninput="e => formTitle = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Location</label>
                            <input type="text" class="field" maxlength="256" placeholder="Where on site it applies — room, area, level, elevation"
                                   value="@formLocation" @oninput="e => formLocation = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Instruction *</label>
                        <textarea class="field" rows="6" maxlength="4000" placeholder="What site is to do — as the instruction should read on site"
                                  value="@formInstruction" @oninput="e => formInstruction = e.Value?.ToString() ?? string.Empty"></textarea>
                    </div>
                    <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition disabled:opacity-50"
                            disabled="@(!FormReady || busy)"
                            @onclick="SaveAsync">
                        @(editingId is null ? "Raise instruction" : "Save changes")
                    </button>
                </div>
            </section>
        }

        @if (!SiteInstructions.LoadedFor(ProjectId) && !dataFailed)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading site instructions" />
        }
        else if (dataFailed && !SiteInstructions.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">The site instructions couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else if (Rows.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No site instructions on this project. Raise one here, or write one from an email in the Control Centre (Internal pathway → Raise Site Instruction).</p>
        }
        else
        {
            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-line text-left">
                            <th class="px-4 py-2.5 text-xs uppercase tracking-wider text-content-subtle font-semibold">Ref</th>
                            <th class="px-4 py-2.5 text-xs uppercase tracking-wider text-content-subtle font-semibold">Title</th>
                            <th class="px-4 py-2.5 text-xs uppercase tracking-wider text-content-subtle font-semibold">Instruction</th>
                            <th class="px-4 py-2.5 text-xs uppercase tracking-wider text-content-subtle font-semibold">Location</th>
                            <th class="px-4 py-2.5 text-xs uppercase tracking-wider text-content-subtle font-semibold">Raised</th>
                            <th class="px-4 py-2.5"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Rows)
                        {
                            var isExpanded = expandedId == row.SiteInstructionId;
                            <tr @key="row.SiteInstructionId" class="border-b border-line last:border-0 align-top">
                                <td class="px-4 py-2.5 font-mono text-xs text-content-muted whitespace-nowrap">@row.Reference</td>
                                <td class="px-4 py-2.5 text-content">@row.Title</td>
                                <td class="px-4 py-2.5 text-content-muted max-w-lg whitespace-pre-wrap">@row.Instruction</td>
                                <td class="px-4 py-2.5 text-content-muted max-w-xs">@row.Location</td>
                                <td class="px-4 py-2.5 text-content-muted whitespace-nowrap" title="@row.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")">
                                    @row.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                                </td>
                                <td class="px-4 py-2.5 whitespace-nowrap text-right">
                                    <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4 mr-3"
                                            @onclick="() => StartEdit(row)">
                                        Edit
                                    </button>
                                    <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                            @onclick="() => ToggleEmailsAsync(row.SiteInstructionId)">
                                        @(isExpanded ? "Hide emails" : "Emails")
                                    </button>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr class="border-b border-line last:border-0 bg-surface-raised/50">
                                    <td colspan="6" class="px-4 py-3">
                                        <FiledEmailList Emails="@(emailsByRow.TryGetValue(row.SiteInstructionId, out var filedEmails) ? filedEmails : null)"
                                            EmptyMessage="@($"No emails filed to {row.Reference} yet — file one from the Control Centre (Internal pathway → Site instructions).")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </ProjectPageShell>
</Page>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private bool sessionReady;
    private bool dataFailed;
    private bool busy;
    private string? actionError;

    // One form for both raise and edit: editingId null = raising.
    private bool formOpen;
    private string? editingId;
    private string formTitle = "";
    private string formInstruction = "";
    private string formLocation = "";

    // One expanded instruction at a time; its emails are read live by tag (ListRecordEmails) and
    // cached for the visit so collapsing/expanding doesn't refetch.
    private string? expandedId;
    private readonly Dictionary<string, IReadOnlyList<MailboxMessage>> emailsByRow = new();

    private IReadOnlyList<SiteInstruction> Rows => SiteInstructions.Current(ProjectId);

    // Same rule as the server (AddSiteInstructionValidation): title AND the instruction itself.
    private bool FormReady => !string.IsNullOrWhiteSpace(formTitle) && !string.IsNullOrWhiteSpace(formInstruction);

    private string EditingReference =>
        Rows.FirstOrDefault(row => row.SiteInstructionId == editingId)?.Reference ?? "instruction";

    protected override async Task OnInitializedAsync()
    {
        SiteInstructions.OnChanged += StateHasChanged;
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        await LoadAsync();
    }

    private string loadedForProjectId = "";

    protected override async Task OnParametersSetAsync()
    {
        // Project switch via the shell's arrows: same page, new key — load the new register
        // (and give a previously failed project a fresh chance).
        if (!sessionReady || loadedForProjectId == ProjectId) return;
        dataFailed = false;
        expandedId = null;
        formOpen = false;
        editingId = null;
        actionError = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loadedForProjectId = ProjectId;
        try { await SiteInstructions.RefreshAsync(ProjectId, CancellationToken.None); }
        catch { dataFailed = true; } // the query client has already toasted the detail
    }

    private void ToggleForm()
    {
        if (formOpen) { formOpen = false; editingId = null; return; }
        editingId = null;
        formTitle = ""; formInstruction = ""; formLocation = "";
        formOpen = true;
    }

    private void StartEdit(SiteInstruction row)
    {
        editingId = row.SiteInstructionId;
        formTitle = row.Title;
        formInstruction = row.Instruction;
        formLocation = row.Location;
        formOpen = true;
    }

    private async Task SaveAsync()
    {
        if (!FormReady) return;
        busy = true;
        actionError = null;
        try
        {
            if (editingId is { } id)
            {
                await Commands.SendAsync(new UpdateSiteInstruction(
                    id, formTitle.Trim(), formInstruction.Trim(), formLocation.Trim()), CancellationToken.None);
            }
            else
            {
                await Commands.SendAsync(new AddSiteInstruction(
                    ProjectId, formTitle.Trim(), formInstruction.Trim(), formLocation.Trim()), CancellationToken.None);
            }
            formTitle = ""; formInstruction = ""; formLocation = "";
            formOpen = false;
            editingId = null;
            await RefreshAfterWriteAsync();
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    // Post-write reload: swallow query failures (the toast already reported them) so a 502 on the
    // refetch can't take the page down after a successful write — see post-write-reload rule.
    private async Task RefreshAfterWriteAsync()
    {
        try { await SiteInstructions.RefreshAsync(ProjectId, CancellationToken.None); }
        catch (OperationCanceledException) { throw; }
        catch { }
    }

    private async Task ToggleEmailsAsync(string id)
    {
        if (expandedId == id) { expandedId = null; return; }
        expandedId = id;
        if (emailsByRow.ContainsKey(id)) return;
        try
        {
            var emails = await Queries.AskAsync(new ListRecordEmails(RecordType.SiteInstruction, id), CancellationToken.None);
            emailsByRow[id] = emails;
        }
        catch
        {
            // The toast has the detail; an empty list is the honest fallback for this visit.
            emailsByRow[id] = Array.Empty<MailboxMessage>();
        }
    }

    public void Dispose() => SiteInstructions.OnChanged -= StateHasChanged;
}
