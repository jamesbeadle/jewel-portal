@page "/projects"
@using Jewel.JPMS.Features.Projects
@inject AuthService Auth
@inject SessionService Session
@inject ProjectListReadModel ProjectsReadModel
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Projects · JPMS</PageTitle>

<Page OpenTo="JpmsRoleSets.AllInternal">
    <PageHeader>
        <SubtitleContent>
            @ActiveProjects.Count(p => p.Stage != ProjectStage.Completed) active.
            @if (CanCreateProjects)
            {
                <span>Projects are created from a won lead, or add one directly.</span>
            }
            else
            {
                <span>New projects are created from a won lead.</span>
            }
        </SubtitleContent>
        <Actions>
            @if (CanCreateProjects)
            {
                <button type="button" @onclick="OpenForm" class="btn-primary shrink-0">+ New project</button>
            }
        </Actions>
    </PageHeader>

    <div class="mb-3 flex items-center justify-end gap-4">
        @* Where the dashboard's "Valuations overdue" tile lands: the same rows it counted — its
           red count on the first tick, its orange "due soon" line on the second. One filter, so
           ticking one clears the other. *@
        <label class="flex items-center gap-2 text-sm cursor-pointer select-none @(overdueValuationsOnly ?"text-negative font-medium" : "text-content-muted")">
            <input type="checkbox" checked="@overdueValuationsOnly" @onchange="e => SetValuationFilter((bool)e.Value!, ValuationDue.Status.Overdue)" />
            <span>Overdue valuations only@(OverdueValuationCount > 0 ? $" ({OverdueValuationCount})" : "")</span>
        </label>
        <label class="flex items-center gap-2 text-sm cursor-pointer select-none @(dueSoonValuationsOnly ?"text-warning font-medium" : "text-content-muted")">
            <input type="checkbox" checked="@dueSoonValuationsOnly" @onchange="e => SetValuationFilter((bool)e.Value!, ValuationDue.Status.DueSoon)" />
            <span>Due soon only@(DueSoonValuationCount > 0 ? $" ({DueSoonValuationCount})" : "")</span>
        </label>
        <label class="flex items-center gap-2 text-sm text-content-muted cursor-pointer select-none">
            <input type="checkbox" checked="@showCompleted" @onchange="e => showCompleted = (bool)e.Value!" />
            <span>Show completed</span>
        </label>
        <ExportToExcelButton FileName="Projects"
                             Disabled="@(ActiveProjects.Count == 0)"
                             ShowIncludeAllRows="@(!showCompleted)"
                             IncludeAllLabel="Include completed"
                             BuildWorkbook="BuildExportWorkbook" />
    </div>

    @if (overdueValuationsOnly && VisibleProjects.Count == 0)
    {
        <p class="text-sm text-content-subtle italic mb-3">No live project has an overdue valuation date. Dates are set on each project's Settings tab.</p>
    }
    @if (dueSoonValuationsOnly && VisibleProjects.Count == 0)
    {
        <p class="text-sm text-content-subtle italic mb-3">No live project has a valuation due in the next week. Dates are set on each project's Settings tab.</p>
    }
    @* Filtered to overdue or due-soon valuations, a row is a claim to raise — it lands on the
       project's Valuation Report. Unfiltered, the row keeps the role's default project tab. *@
    <ProjectsTable Projects="VisibleProjects"
                   RowHref="@(IsFilteredByValuation ? ValuationRowHref : null)" />

    <Modal IsOpen="showForm" Title="New project" ShowFooter="false" OnCancel="CloseForm">
        <NewProjectForm OnCreated="HandleCreated" OnClosed="CloseForm" />
    </Modal>
</Page>

@code {
    private bool showForm;
    private bool showCompleted;

    // The one valuation filter: null is unfiltered; Overdue or DueSoon narrows to that status.
    private ValuationDue.Status? valuationFilter;

    private bool overdueValuationsOnly => valuationFilter == ValuationDue.Status.Overdue;
    private bool dueSoonValuationsOnly => valuationFilter == ValuationDue.Status.DueSoon;
    private bool IsFilteredByValuation => valuationFilter is not null;

    private void SetValuationFilter(bool isTicked, ValuationDue.Status status) =>
        valuationFilter = isTicked ? status : null;

    private IReadOnlyList<Project> ActiveProjects =>
        ProjectsReadModel.Current ?? Array.Empty<Project>();

    private IReadOnlyList<Project> VisibleProjects =>
        (showCompleted ? ActiveProjects : ActiveProjects.Where(p => p.Stage != ProjectStage.Completed))
            .Where(p => valuationFilter is null || ValuationDue.Of(p) == valuationFilter)
            .ToList();

    private int OverdueValuationCount => ActiveProjects.Count(ValuationDue.IsOverdue);
    private int DueSoonValuationCount => ActiveProjects.Count(ValuationDue.IsDueSoon);

    private static readonly Func<Project, string> ValuationRowHref =
        project => ValuationDue.ProjectRoute(project.ProjectId);

    // Mirrors the server-side authorisation (CreateProjectShellAuthorisation):
    // Managing Director and Project Manager. Master admins hold every role and so qualify too.
    private bool CanCreateProjects =>
        Session.AvailableRoles.Any(role => role is Role.ManagingDirector or Role.ProjectManager);

    private void OpenForm() => showForm = true;

    private void CloseForm() => showForm = false;

    private ExcelWorkbook? BuildExportWorkbook(bool includeCompleted)
    {
        // "Include completed" exports the whole portfolio even while the table hides
        // completed projects — the Stage column tells them apart.
        var projects = includeCompleted ? ActiveProjects : VisibleProjects;
        if (projects.Count == 0) return null;

        var workbook = new ExcelWorkbook();
        var sheet = workbook.AddSheet("Projects",
            new ExcelColumn("Reference"),
            new ExcelColumn("Name"),
            new ExcelColumn("Client"),
            new ExcelColumn("Entity"),
            new ExcelColumn("Stage"),
            new ExcelColumn("Next valuation"));

        foreach (var project in projects)
        {
            sheet.AddRow(
                project.Reference,
                project.Name,
                project.ClientName,
                project.Organisation.ShortCode(),
                project.Stage.DisplayName(),
                project.NextExpectedValuationDate?.ToString("d MMM yyyy") ?? "");
        }
        return workbook;
    }

    private void HandleCreated(Project project)
    {
        // The form has already refreshed the read model; just close and surface the new project.
        showForm = false;
        Nav.NavigateTo($"/projects/{project.ProjectId}");
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        // ?valuations=overdue / ?valuations=due-soon (the dashboard tile and its due-soon line)
        // open the page already filtered. Read once at load; the tick boxes are the source of
        // truth thereafter.
        valuationFilter = FilterFromQuery(new Uri(Nav.Uri).Query);
        ProjectsReadModel.OnChanged += StateHasChanged;
        Session.OnChange += StateHasChanged;
        if (!Session.CanOpen(JpmsRoleSets.AllInternal)) return;
        await ProjectsReadModel.RefreshAsync(CancellationToken.None);
    }

    private static ValuationDue.Status? FilterFromQuery(string query)
    {
        if (query.Contains(ValuationDue.OverdueFilterQuery, StringComparison.OrdinalIgnoreCase)) return ValuationDue.Status.Overdue;
        if (query.Contains(ValuationDue.DueSoonFilterQuery, StringComparison.OrdinalIgnoreCase)) return ValuationDue.Status.DueSoon;
        return null;
    }

    public void Dispose()
    {
        ProjectsReadModel.OnChanged -= StateHasChanged;
        Session.OnChange -= StateHasChanged;
    }
}
