@page "/sales/leads/{LeadId}/estimates/{EstimateId}"
@using Jewel.JPMS.Contracts.Sales
@using Jewel.JPMS.Features.Sales
@using Jewel.JPMS.Features.CostCenters
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject LeadDetailReadModel Detail
@inject CostCentersReadModel CostCenters
@inject ICommandSender Commands
@implements IDisposable

<PageTitle>@(Estimate?.Reference ?? "Estimate") · JPMS</PageTitle>

@*
    One estimate (2026-09-15, Nigel: the estimate document in the tender's shape). The breakdown
    is a full-record save: what is on the page is what the estimate becomes. Details and the
    status move stay in their modals. Everything here is the sales team's; readers see it read-only.
*@

<Page>
    @if (!Detail.LoadedFor(LeadId) && !dataFailed)
    {
        <LoadGate IsLoading="true" Prominent="true" Label="Loading estimate" />
    }
    else if (Lead is null || Estimate is null)
    {
        <WorkspaceSectionNav />
        <div class="panel p-6">
            <p class="text-sm text-content-muted">
                @(dataFailed ? "The estimate couldn't be loaded — the error banner has the detail. Reload the page to retry." : "There is no estimate with that id on this lead.")
                <a href="/sales/leads/@LeadId" class="text-info underline underline-offset-4 ml-1">Back to the lead</a>
            </p>
        </div>
    }
    else
    {
        var lead = Lead;
        var estimate = Estimate;
        <div>
            <WorkspaceSectionNav />
            <PageHeader>
                <TitleContent>
                    <span>@estimate.Reference</span>
                    <EstimateStatusPill Status="@estimate.Status" />
                </TitleContent>
                <EyebrowContent>
                    <a href="/sales/leads" class="hover:text-content">Leads</a> ·
                    <a href="/sales/leads/@LeadId" class="hover:text-content">@lead.Reference</a> · Estimate
                </EyebrowContent>
                <SubtitleContent>@estimate.Scope</SubtitleContent>
                <Actions>
                    <div class="flex flex-wrap items-center gap-2 shrink-0">
                        @if (CanWork && estimate.Status.IsOpen())
                        {
                            <button type="button" class="btn-primary" disabled="@(busy || !dirty)" title="@(dirty ? "Saves every section and line as shown" : "Nothing changed")" @onclick="SaveBreakdownAsync">
                                @(busy ? "Saving…" : "Save breakdown")
                            </button>
                        }
                        <DropdownMenu Label="Actions" WidthClass="w-64" Disabled="@busy" Items="ActionMenuItems" />
                    </div>
                </Actions>
            </PageHeader>

            @if (actionNote is not null)
            {
                <Notice Tone="Tone.Positive" Class="mb-4">@actionNote</Notice>
            }
            @if (actionError is not null)
            {
                <Notice Tone="Tone.Negative" Class="mb-4">@actionError</Notice>
            }

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 space-y-6">
                    <EstimateBreakdownEditor Breakdown="@breakdown" Editable="@Editable" OnTouched="() => dirty = true" />
                </div>

                <div class="space-y-6">
                    <EstimateDetailsPanel Lead="@lead" Estimate="@estimate" />
                    <EstimateNarrativePanel Estimate="@estimate" Editable="@Editable" IsBusy="@busy" Seeding="@seeding" OnSave="SaveNarrativeAsync" />
                </div>
            </div>
        </div>

        <EstimateFormModal IsOpen="@editOpen" LeadId="@LeadId" Existing="@estimate" OnSaved="OnEditedAsync" OnCancel="() => editOpen = false" />
        <EstimateStatusMoveDialog Estimate="@moving" OnMoved="OnMovedAsync" OnCancel="() => moving = null" />
    }
</Page>
