@page "/tender-enquiries"
@using Jewel.JPMS.Contracts.TenderEnquiries
@using Jewel.JPMS.Features.TenderEnquiries
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@implements IDisposable

<PageTitle>Tender Enquiries · JPMS</PageTitle>

@*
    The company's bid pipeline — every invitation to tender, wherever it came from (James,
    2026-08-25: an enquiry isn't a project yet, so it lives under Internal, not in the project
    folder). Each enquiry still sits on a Lead-stage project behind the scenes — that is where its
    drawings, correspondence and document control have a home — but nobody needs to pick a project
    to see the pipeline. Live enquiries lead, soonest deadline first; ended ones fold away.
*@

<ApprovedSessionGate>
    <section class="px-6 py-6 md:px-8">
        <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
            <div>
                <p class="eyebrow mb-1">JPMS · Internal</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Tender enquiries</h1>
                <p class="text-sm text-content-muted mt-1">
                    Every invitation to tender — from the architect's first email through the PQQ to the priced tender and the decision.
                </p>
            </div>
            @if (CanManage)
            {
                <button type="button" class="btn-primary text-xs px-3 py-2" @onclick="OpenLogModal">Log enquiry</button>
            }
        </header>

        @if (error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@error</p>
        }

        <LoadGate IsLoading="@(enquiries is null && !loadFailed)" Prominent="true" Label="Loading tender enquiries">
        @if (Enquiries.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No tender enquiries yet.
                @(CanManage ? "Log one here, or from the architect's email in the Control Centre with “Log Tender Enquiry”." : "")
            </p>
        }
        else
        {
            <div class="flex items-center justify-end mb-2">
                <label class="inline-flex items-center gap-1.5 text-xs text-content-muted">
                    <input type="checkbox" checked="@showEnded" @onchange="e => showEnded = e.Value is true" />
                    Show ended (@EndedCount)
                </label>
            </div>
            <TenderEnquiriesTable Enquiries="@Visible" Projects="@(Projects.Current ?? Array.Empty<Project>())" />
        }
        </LoadGate>
    </section>

    <Modal IsOpen="showLogModal" Title="Log tender enquiry" ShowFooter="true"
           ConfirmLabel="@(busy ? "Logging…" : "Log enquiry")" ConfirmDisabled="@(busy || Problem is not null)"
           CancelLabel="Cancel" OnCancel="() => showLogModal = false" OnConfirm="ConfirmLogAsync" Class="max-w-2xl w-full">
        <div class="space-y-4">
            <TenderEnquiryDetailsForm Draft="@draft" OnChanged="OnDetailsChanged" />
            <div>
                <p class="text-xs font-semibold text-content-subtle mb-2">The new job's project (created at Lead stage)</p>
                <TenderEnquiryNewProjectFields Draft="@newProject" OnChanged="StateHasChanged" />
            </div>
            <p class="text-xs text-content-subtle">
                The enquiry starts as Received. Answer the PQQ, add the documents and move it along from its own page.
            </p>
        </div>
    </Modal>
</ApprovedSessionGate>

@code {
    private bool busy;
    private bool loadFailed;
    private bool showLogModal;
    private bool showEnded;
    private string? error;
    private IReadOnlyList<TenderEnquiry>? enquiries;
    private TenderEnquiryDetailsDraft draft = new();
    private TenderEnquiryNewProjectDraft newProject = new();

    private IReadOnlyList<TenderEnquiry> Enquiries => enquiries ?? Array.Empty<TenderEnquiry>();
    private IReadOnlyList<TenderEnquiry> Visible => showEnded ? Enquiries : Enquiries.Where(enquiry => enquiry.Status.IsOpen()).ToList();
    private int EndedCount => Enquiries.Count(enquiry => !enquiry.Status.IsOpen());
    private string? Problem => draft.Problem ?? newProject.Problem;

    private bool CanManage => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.ProjectManager or Role.QuantitySurveyor
            or Role.OfficeComplianceCoordinator or Role.OfficeAdmin);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        Projects.OnChanged += StateHasChanged;
        if (Projects.Current is null) _ = Projects.RefreshAsync(CancellationToken.None);
        try { enquiries = await Queries.AskAsync(new ListTenderEnquiries(), CancellationToken.None); }
        catch
        {
            loadFailed = true;
            error = "Couldn't load the tender enquiries.";
        }
    }

    private void OpenLogModal()
    {
        draft = new TenderEnquiryDetailsDraft();
        newProject = new TenderEnquiryNewProjectDraft();
        error = null;
        showLogModal = true;
    }

    // The project is usually named after the job: the name follows the title until someone
    // types a project name of their own.
    private void OnDetailsChanged()
    {
        if (newProject.Name == "" || newProject.Name == lastTitle) newProject.Name = draft.Title;
        lastTitle = draft.Title;
    }

    private string lastTitle = "";

    public void Dispose() => Projects.OnChanged -= StateHasChanged;

    private async Task ConfirmLogAsync()
    {
        if (busy || Problem is not null) return;
        busy = true;
        try
        {
            var enquiry = await Commands.SendAsync(
                new LogTenderEnquiry(null, newProject.ToDraft(), draft.ToDetails()), CancellationToken.None);
            showLogModal = false;
            Nav.NavigateTo($"/tender-enquiries/{enquiry.TenderEnquiryId}");
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
