@page "/projects/{ProjectId}/programme"
@using Jewel.JPMS.Contracts.Lads
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Contracts.Requests
@using Jewel.JPMS.Contracts.Site
@implements IDisposable
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands
@inject IRequestRegister RequestRegister
@inject NavigationManager Nav

<PageTitle>Programme · JPMS</PageTitle>

@*
    The project Programme tab. Three views: the programme itself (not built yet — placeholder), Claims
    — the formal time/notice documents around the programme: Jewel's own Notices of Delay (NOD) and
    the Extensions of Time (EOT) they give rise to, plus the Liquidated Damages (LADs) claims the
    client can make against Jewel — and Relevant Events, which lists every email tagged to this
    project's scheduling bucket ("JPMS/SCH-<projectRef>") live from the mailbox. Emails get here from
    the Control Centre — tick "Relevant Event for Programme" on the email (or link it deeper to a
    specific claims document) — and an email can carry other workflow tags at the same time, so
    the same message can feed a request AND appear here.
*@

<ApprovedSessionGate>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="programme">
        <div class="mb-5">
            <h2 class="text-lg font-semibold text-content">Programme</h2>
            <p class="text-sm text-content-muted">The project programme, its formal claims documents and related correspondence.</p>
        </div>

        <div class="flex gap-2 mb-6 border-b border-line">
            <button type="button" class="@SubTabClass(SubView.Programme)" @onclick="() => SwitchView(SubView.Programme)">Programme</button>
            <button type="button" class="@SubTabClass(SubView.Claims)" @onclick="() => SwitchView(SubView.Claims)">
                Claims
                @if (ClaimsCount > 0)
                {
                    <span class="ml-1.5 inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@ClaimsCount</span>
                }
            </button>
            <button type="button" class="@SubTabClass(SubView.CriticalRfis)" @onclick="() => SwitchView(SubView.CriticalRfis)">
                Critical Path RFIs
                @if (OpenCriticalRfiCount > 0)
                {
                    <span class="ml-1.5 inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@OpenCriticalRfiCount</span>
                }
            </button>
            <button type="button" class="@SubTabClass(SubView.RelevantEvents)" @onclick="() => SwitchView(SubView.RelevantEvents)">
                Relevant Events
                @if (emailsLoaded && emails.Count > 0)
                {
                    <span class="ml-1.5 inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@emails.Count</span>
                }
            </button>
        </div>

        @if (view == SubView.Programme)
        {
            @if (programmeError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@programmeError</p>
            }

            <LoadGate IsLoading="@(!programmeLoaded)" Prominent="true" Label="Loading programme">
            @* The banner above carries the reason a failed fetch gives; rendering the body anyway
               would turn "couldn't load the programme" into "no programme tasks yet". *@
            @if (programmeError is null)
            {
                @* Movement banner — the programme measured against its latest baseline. *@
                @if (programme?.Baseline is { } baseline)
                {
                    var movement = Movement;
                    @if (movement.CompletionSlipDays > 0)
                    {
                        <div class="rounded-lg bg-negative/10 border border-negative/30 px-4 py-3 mb-5">
                            <p class="text-sm font-semibold text-negative">
                                Completion has moved @movement.CompletionSlipDays day(s) against baseline “@baseline.Label”
                                <span class="font-normal">(@(movement.BaselineCompletion?.LocalDateTime.ToString("d MMM yyyy")) → @(movement.CurrentCompletion?.LocalDateTime.ToString("d MMM yyyy")))</span>
                            </p>
                            <ul class="mt-2 space-y-1">
                                @foreach (var delayEvent in movement.DelayEvents)
                                {
                                    <li class="flex flex-wrap items-center gap-2 text-xs text-content-muted">
                                        <span>@delayEvent.Title — end moved @delayEvent.BaselineEnd.LocalDateTime.ToString("d MMM") → @delayEvent.PlannedEnd.LocalDateTime.ToString("d MMM yyyy") (+@delayEvent.SlipDays d)@(delayEvent.DrivesCompletion ? " · drives completion" : "")</span>
                                        <button type="button" class="text-accent hover:underline" @onclick="() => RaiseNodFromDelay(delayEvent)">Raise NOD</button>
                                    </li>
                                }
                            </ul>
                            @if (!HasNodSinceBaseline)
                            {
                                <p class="text-xs text-content-subtle mt-2">No Notice of Delay has been raised since this baseline — under JCT ICD 2024 cl. 2.19 notice is due forthwith once delay is apparent.</p>
                            }
                        </div>
                    }
                    else if (movement.HasSlippage)
                    {
                        <div class="rounded-lg bg-surface border border-line px-4 py-3 mb-5">
                            <p class="text-sm text-content">@movement.DelayEvents.Count task(s) have slipped against baseline “@baseline.Label”, but completion is holding.</p>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg bg-accent/10 border border-accent/30 px-4 py-3 mb-5">
                            <p class="text-sm text-content">Programme holding against baseline “@baseline.Label” (taken @baseline.TakenAt.LocalDateTime.ToString("d MMM yyyy")).</p>
                        </div>
                    }
                }
                else if (Tasks.Count > 0)
                {
                    <div class="rounded-lg bg-info/10 border border-info/30 px-4 py-3 mb-5">
                        <p class="text-sm text-content">No baseline yet — take one so movement can be measured and delay notices evidenced.</p>
                    </div>
                }

                <div class="flex flex-wrap gap-2 mb-5">
                    <button type="button" class="btn-secondary" @onclick="() => ToggleProgrammeForm(ProgrammeForm.AddTask)">Add task</button>
                    <button type="button" class="btn-secondary" disabled="@(Tasks.Count < 2)" @onclick="() => ToggleProgrammeForm(ProgrammeForm.AddLink)">Add dependency</button>
                    <button type="button" class="btn-secondary" disabled="@(Tasks.Count == 0 && Baselines.Count == 0)" @onclick="() => ToggleProgrammeForm(ProgrammeForm.Baseline)">Baselines</button>
                </div>

                @if (openProgrammeForm == ProgrammeForm.AddTask)
                {
                    <div class="panel p-4 mb-5 space-y-3">
                        <p class="text-sm font-semibold text-content">Add a programme task</p>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <div class="md:col-span-1">
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                                <input class="field" @bind="newTaskTitle" placeholder="e.g. Groundworks — main house" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Planned start</label>
                                <input type="date" class="field" @bind="newTaskStart" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Planned end</label>
                                <input type="date" class="field" @bind="newTaskEnd" />
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="btn-primary" disabled="@(programmeBusy || string.IsNullOrWhiteSpace(newTaskTitle) || newTaskStart is null || newTaskEnd is null)" @onclick="AddTaskAsync">Add task</button>
                            <button type="button" class="btn-neutral" @onclick="() => ToggleProgrammeForm(ProgrammeForm.None)">Cancel</button>
                        </div>
                    </div>
                }
                else if (openProgrammeForm == ProgrammeForm.AddLink)
                {
                    <div class="panel p-4 mb-5 space-y-3">
                        <p class="text-sm font-semibold text-content">Add a dependency <span class="font-normal text-content-subtle">— finish-to-start: the successor starts after the predecessor finishes (plus lag)</span></p>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Predecessor</label>
                                <select class="field" @bind="linkPredecessorId">
                                    <option value="">Select task…</option>
                                    @foreach (var task in Tasks)
                                    {
                                        <option value="@task.ProgrammeTaskId">@task.Title</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Successor</label>
                                <select class="field" @bind="linkSuccessorId">
                                    <option value="">Select task…</option>
                                    @foreach (var task in Tasks)
                                    {
                                        <option value="@task.ProgrammeTaskId">@task.Title</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Lag (days)</label>
                                <input type="number" class="field" @bind="linkLagDays" />
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="btn-primary" disabled="@(programmeBusy || string.IsNullOrWhiteSpace(linkPredecessorId) || string.IsNullOrWhiteSpace(linkSuccessorId) || linkPredecessorId == linkSuccessorId)" @onclick="AddLinkAsync">Add dependency</button>
                            <button type="button" class="btn-neutral" @onclick="() => ToggleProgrammeForm(ProgrammeForm.None)">Cancel</button>
                        </div>
                    </div>
                }
                else if (openProgrammeForm == ProgrammeForm.Baseline)
                {
                    <div class="panel p-4 mb-5 space-y-3">
                        <p class="text-sm font-semibold text-content">Take a baseline <span class="font-normal text-content-subtle">— snapshots every task's dates as the yardstick movement is measured against</span></p>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Label</label>
                            <input class="field" @bind="baselineLabel" placeholder="e.g. Contract programme rev A" />
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="btn-primary" disabled="@(programmeBusy || Tasks.Count == 0 || string.IsNullOrWhiteSpace(baselineLabel))" @onclick="TakeBaselineAsync">Take baseline</button>
                            <button type="button" class="btn-neutral" @onclick="() => ToggleProgrammeForm(ProgrammeForm.None)">Cancel</button>
                        </div>
                        @if (Baselines.Count > 0)
                        {
                            <div class="pt-3 border-t border-line">
                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">Baselines taken</p>
                                <ul class="space-y-1.5">
                                    @foreach (var baselineEntry in Baselines)
                                    {
                                        <li class="flex flex-wrap items-center gap-2">
                                            <span class="text-sm text-content">@baselineEntry.Label</span>
                                            @if (baselineEntry.ProgrammeBaselineId == programme?.Baseline?.ProgrammeBaselineId)
                                            {
                                                <span class="inline-flex items-center rounded bg-accent/10 px-1.5 py-0.5 text-[10px] font-medium text-accent">current yardstick</span>
                                            }
                                            <span class="text-xs text-content-subtle">taken @baselineEntry.TakenAt.LocalDateTime.ToString("d MMM yyyy, HH:mm") by @baselineEntry.TakenByEmail</span>
                                            @if (confirmingRemoveBaselineId == baselineEntry.ProgrammeBaselineId)
                                            {
                                                <button type="button" class="text-xs font-semibold text-negative hover:underline" disabled="@programmeBusy" @onclick="() => RemoveBaselineAsync(baselineEntry.ProgrammeBaselineId)">Confirm remove</button>
                                                <button type="button" class="text-xs text-content-subtle hover:underline" @onclick="() => confirmingRemoveBaselineId = null">Keep</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="text-xs text-negative hover:underline" title="Remove this baseline" @onclick="() => confirmingRemoveBaselineId = baselineEntry.ProgrammeBaselineId">Remove</button>
                                            }
                                        </li>
                                    }
                                </ul>
                                <p class="text-xs text-content-subtle mt-2">Movement is measured against the latest baseline — removing it makes the previous one the yardstick again.</p>
                            </div>
                        }
                    </div>
                }

                @if (Tasks.Count == 0)
                {
                    <div class="panel p-8 text-center">
                        <p class="text-sm text-content">No programme tasks yet.</p>
                        <p class="text-xs text-content-subtle mt-1">Add the first task to start building the programme, then take a baseline so movement can be tracked.</p>
                    </div>
                }
                else
                {
                    <div class="panel p-4 overflow-x-auto">
                        <div class="min-w-[720px]">
                            @* Month header *@
                            <div class="grid grid-cols-[240px_1fr] border-b border-line-strong pb-1 mb-1">
                                <div class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Task</div>
                                <div class="relative h-5">
                                    @foreach (var month in MonthMarks)
                                    {
                                        <span class="absolute top-0 text-[10px] text-content-subtle border-l border-line pl-1" style="@month.Style">@month.Label</span>
                                    }
                                </div>
                            </div>

                            @foreach (var task in Tasks)
                            {
                                var slip = SlipDaysFor(task.ProgrammeTaskId);
                                <div class="grid grid-cols-[240px_1fr] items-center border-b border-line/60">
                                    <div class="py-1.5 pr-3">
                                        <div class="flex items-center gap-1.5">
                                            <button type="button" class="text-sm text-content text-left truncate hover:text-accent" title="Edit task" @onclick="() => BeginEditTask(task)">@task.Title</button>
                                            @if (slip > 0)
                                            {
                                                <span class="inline-flex items-center rounded bg-negative/15 px-1.5 py-0.5 text-[10px] text-negative shrink-0">+@slip d</span>
                                            }
                                        </div>
                                        @if (PredecessorsOf(task.ProgrammeTaskId).Any())
                                        {
                                            <div class="flex flex-wrap gap-1 mt-0.5">
                                                @foreach (var link in PredecessorsOf(task.ProgrammeTaskId))
                                                {
                                                    <span class="inline-flex items-center gap-1 rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">
                                                        after @TaskTitle(link.PredecessorTaskId)@(link.LagDays != 0 ? $" {(link.LagDays > 0 ? "+" : "")}{link.LagDays}d" : "")
                                                        <button type="button" class="text-content-faint hover:text-negative" title="Remove dependency" @onclick="() => RemoveLinkAsync(link.ProgrammeTaskLinkId)">×</button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="relative h-9">
                                        @if (TodayStyle is { } todayStyle)
                                        {
                                            <div class="absolute inset-y-0 w-px bg-info/60" style="@todayStyle"></div>
                                        }
                                        <div class="absolute top-1.5 h-3.5 rounded @(slip > 0 ? "bg-negative/80" : "bg-accent/80")"
                                             style="@BarStyle(task.PlannedStart, task.PlannedEnd)"
                                             title="@task.Title: @task.PlannedStart.LocalDateTime.ToString("d MMM yyyy") – @task.PlannedEnd.LocalDateTime.ToString("d MMM yyyy") (@((int)task.ProgressPercent)% complete)">
                                            <div class="h-full rounded-l bg-black/35" style="width:@(Pct((double)task.ProgressPercent))"></div>
                                        </div>
                                        @if (BaselineTaskFor(task.ProgrammeTaskId) is { } baselined)
                                        {
                                            <div class="absolute top-[26px] h-1 rounded bg-content-faint/70"
                                                 style="@BarStyle(baselined.PlannedStart, baselined.PlannedEnd)"
                                                 title="Baseline: @baselined.PlannedStart.LocalDateTime.ToString("d MMM yyyy") – @baselined.PlannedEnd.LocalDateTime.ToString("d MMM yyyy")"></div>
                                        }
                                    </div>
                                </div>

                                @if (editingTaskId == task.ProgrammeTaskId)
                                {
                                    <div class="bg-surface-raised border border-line rounded-lg p-4 my-2 space-y-3">
                                        <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                                                <input class="field" @bind="editTitle" />
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Planned start</label>
                                                <input type="date" class="field" @bind="editStart" />
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Planned end</label>
                                                <input type="date" class="field" @bind="editEnd" />
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Progress (%)</label>
                                                <input type="number" min="0" max="100" class="field" @bind="editProgress" />
                                            </div>
                                        </div>
                                        <div class="flex flex-wrap items-center gap-2">
                                            <button type="button" class="btn-primary" disabled="@(programmeBusy || string.IsNullOrWhiteSpace(editTitle) || editStart is null || editEnd is null)" @onclick="SaveEditTaskAsync">Save</button>
                                            <button type="button" class="btn-neutral" @onclick="CancelEditTask">Cancel</button>
                                            @if (confirmingRemoveTask)
                                            {
                                                <span class="ml-auto text-xs text-content-subtle">Removes the task and its dependencies — baseline snapshots are kept.</span>
                                                <button type="button" class="btn-neutral text-negative" disabled="@programmeBusy" @onclick="RemoveTaskAsync">Confirm remove</button>
                                                <button type="button" class="btn-neutral" @onclick="() => confirmingRemoveTask = false">Keep</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn-neutral text-negative ml-auto" disabled="@programmeBusy" @onclick="() => confirmingRemoveTask = true">Remove task…</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <p class="text-xs text-content-subtle mt-2">
                        Green bars are the live programme (red where slipped past baseline); the thin grey bar underneath is the baselined position; the darker fill is progress. Click a task to edit it.
                    </p>
                }
            }
            </LoadGate>
        }
        else if (view == SubView.Claims)
        {
            @if (claimsError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@claimsError</p>
            }

            <div class="flex flex-wrap gap-2 mb-5">
                <button type="button" class="btn-secondary" @onclick="() => ToggleForm(ClaimForm.Nod)">Raise Notice of Delay</button>
                <button type="button" class="btn-secondary" @onclick="() => ToggleForm(ClaimForm.Eot)">Raise Extension of Time</button>
                <button type="button" class="btn-secondary" @onclick="() => ToggleForm(ClaimForm.Lad)">Record LADs claim</button>
            </div>

            @if (openForm == ClaimForm.Nod)
            {
                <div class="panel p-4 mb-5 space-y-3">
                    <p class="text-sm font-semibold text-content">Raise a Notice of Delay</p>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                        <input class="field" @bind="nodTitle" placeholder="e.g. Delay to steel delivery — structural frame" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Description</label>
                        <textarea class="field" rows="3" @bind="nodDescription" placeholder="The cause of delay, the works affected and the expected programme impact."></textarea>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" class="btn-primary" disabled="@(claimsBusy || string.IsNullOrWhiteSpace(nodTitle))" @onclick="RaiseNodAsync">Raise NOD</button>
                        <button type="button" class="btn-neutral" @onclick="() => ToggleForm(ClaimForm.None)">Cancel</button>
                    </div>
                </div>
            }
            else if (openForm == ClaimForm.Eot)
            {
                <div class="panel p-4 mb-5 space-y-3">
                    <p class="text-sm font-semibold text-content">Raise an Extension of Time</p>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                        <input class="field" @bind="eotTitle" placeholder="e.g. EOT — 10 working days, steel delivery delay" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Description</label>
                        <textarea class="field" rows="3" @bind="eotDescription" placeholder="The extension sought and the grounds for it."></textarea>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Arises from Notice of Delay (optional)</label>
                        <select class="field" @bind="eotRelatedNodId">
                            <option value="">No related NOD</option>
                            @foreach (var nod in Nods)
                            {
                                <option value="@nod.RequestId">@nod.Reference — @nod.Title</option>
                            }
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button type="button" class="btn-primary" disabled="@(claimsBusy || string.IsNullOrWhiteSpace(eotTitle))" @onclick="RaiseEotAsync">Raise EOT</button>
                        <button type="button" class="btn-neutral" @onclick="() => ToggleForm(ClaimForm.None)">Cancel</button>
                    </div>
                </div>
            }
            else if (openForm == ClaimForm.Lad)
            {
                <div class="panel p-4 mb-5 space-y-3">
                    <p class="text-sm font-semibold text-content">Record a Liquidated Damages claim</p>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Title</label>
                        <input class="field" @bind="ladTitle" placeholder="e.g. LADs notice — completion overrun" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Description</label>
                        <textarea class="field" rows="3" @bind="ladDescription" placeholder="The client's notice and the completion date it's claimed against."></textarea>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Period from</label>
                            <input type="date" class="field" @bind="ladPeriodFrom" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Period to</label>
                            <input type="date" class="field" @bind="ladPeriodTo" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Days claimed</label>
                            <input type="number" min="0" class="field" @bind="ladDaysClaimed" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Rate / week (£)</label>
                            <input type="number" min="0" step="0.01" class="field" @bind="ladRatePerWeek" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Amount claimed (£)</label>
                        <input type="number" min="0" step="0.01" class="field" @bind="ladAmount" />
                    </div>
                    <div class="flex gap-2">
                        <button type="button" class="btn-primary" disabled="@(claimsBusy || string.IsNullOrWhiteSpace(ladTitle))" @onclick="RecordLadAsync">Record claim</button>
                        <button type="button" class="btn-neutral" @onclick="() => ToggleForm(ClaimForm.None)">Cancel</button>
                    </div>
                </div>
            }

            <div class="space-y-6">
                <div>
                    <h3 class="text-sm font-semibold text-content mb-2">Notices of Delay <span class="font-normal text-content-subtle">— raised by Jewel (JCT ICD 2024 cl. 2.19)</span></h3>
                    <LoadGate IsLoading="@(!RequestsReady)" Label="Loading notices">
                    @if (Nods.Count == 0)
                    {
                        <div class="panel p-5 text-center"><p class="text-xs text-content-subtle">No Notices of Delay on this project.</p></div>
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var nod in Nods)
                            {
                                <li class="rounded-lg border border-line bg-surface px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs text-content-muted">@nod.Reference</span>
                                            <span class="text-sm font-medium text-content">@nod.Title</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">@nod.Status</span>
                                            <span class="text-xs text-content-subtle">@((nod.IssuedAt ?? nod.RaisedAt).LocalDateTime.ToString("d MMM yyyy"))</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(nod.Description))
                                    {
                                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@nod.Description</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    </LoadGate>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-content mb-2">Extensions of Time <span class="font-normal text-content-subtle">— raised by Jewel (JCT ICD 2024 cl. 2.19/2.20)</span></h3>
                    <LoadGate IsLoading="@(!RequestsReady)" Label="Loading extensions">
                    @if (Eots.Count == 0)
                    {
                        <div class="panel p-5 text-center"><p class="text-xs text-content-subtle">No Extensions of Time on this project.</p></div>
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var eot in Eots)
                            {
                                <li class="rounded-lg border border-line bg-surface px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs text-content-muted">@eot.Reference</span>
                                            <span class="text-sm font-medium text-content">@eot.Title</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            @if (RelatedNodReference(eot) is { } nodRef)
                                            {
                                                <span class="inline-flex items-center rounded bg-accent/10 px-1.5 py-0.5 text-[10px] text-accent" title="Arises from this Notice of Delay">from @nodRef</span>
                                            }
                                            <span class="inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">@eot.Status</span>
                                            <span class="text-xs text-content-subtle">@((eot.IssuedAt ?? eot.RaisedAt).LocalDateTime.ToString("d MMM yyyy"))</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(eot.Description))
                                    {
                                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@eot.Description</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    </LoadGate>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-content mb-2">Liquidated Damages <span class="font-normal text-content-subtle">— claimed by the client against Jewel</span></h3>
                    <LoadGate IsLoading="@(!ladsLoaded)" Label="Loading LADs claims">
                    @if (lads.Count == 0)
                    {
                        @* Only when the fetch actually answered "none" — a failure says so above. *@
                        @if (!ladsFailed)
                        {
                            <div class="panel p-5 text-center"><p class="text-xs text-content-subtle">No LADs claims recorded on this project.</p></div>
                        }
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var lad in lads)
                            {
                                <li class="rounded-lg border border-line bg-surface px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs text-content-muted">@lad.Reference</span>
                                            <span class="text-sm font-medium text-content">@lad.Title</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">@lad.Status.DisplayName()</span>
                                            <span class="text-xs text-content-subtle">@lad.RaisedAt.LocalDateTime.ToString("d MMM yyyy")</span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-content-subtle mt-1">
                                        @ClaimPeriod(lad)@(lad.DaysClaimed > 0 ? $" · {lad.DaysClaimed} days" : "")@(lad.RatePerWeek > 0 ? $" · {Money(lad.RatePerWeek)}/week" : "") · <span class="font-medium text-content">@Money(lad.Amount)</span>
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(lad.Description))
                                    {
                                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@lad.Description</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    </LoadGate>
                </div>
            </div>
        }
        else if (view == SubView.CriticalRfis)
        {
            @* RFIs tagged Critical Path — programme-related requests whose answers gate work on the
               programme's critical path. The tag is set on the RFI itself (detail page → Actions or
               Edit details); this view is the programme-side lens on that subset, open and closed,
               so it doubles as the programme-impact history. *@
            <LoadGate IsLoading="@(!RequestsReady)" Prominent="true" Label="Loading critical path RFIs">
            @if (CriticalRfis.Count == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No critical path RFIs on this project.</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tag an RFI as <span class="font-medium text-content">Critical path</span> from its detail page (Actions → Mark as critical path) and it will appear here.
                    </p>
                </div>
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var rfi in CriticalRfis)
                    {
                        <li>
                            <a href="@($"/projects/{ProjectId}/requests/view/{rfi.RequestId}")"
                               class="block rounded-lg border border-line bg-surface px-4 py-3 hover:border-accent/60 transition">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-xs text-content-muted">@rfi.Reference</span>
                                        <span class="text-sm font-medium text-content">@rfi.Title</span>
                                        <span class="inline-flex items-center rounded bg-rose-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-rose-600">Critical path</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        @if (rfi.DaysOutstanding is int days)
                                        {
                                            <span class="text-xs @(rfi.IsOverdue ? "text-negative font-semibold" : "text-content-subtle")"
                                                  title="Days outstanding since raised">@days d outstanding</span>
                                        }
                                        <span class="inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-[11px] font-medium @RfiStatusClass(rfi.Status)">@RfiStatusLabel(rfi.Status)</span>
                                        <span class="text-xs text-content-subtle">@((rfi.IssuedAt ?? rfi.RaisedAt).LocalDateTime.ToString("d MMM yyyy"))</span>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-xs text-content-subtle">
                                    @if (rfi.ResponseDue is { } due)
                                    {
                                        <span>Response due @due.LocalDateTime.ToString("d MMM yyyy")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(rfi.Description))
                                {
                                    <p class="text-xs text-content-subtle mt-1 line-clamp-2">@rfi.Description</p>
                                }
                            </a>
                        </li>
                    }
                </ul>
            }
            </LoadGate>
        }
        else
        {
            @if (emailsError is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@emailsError</p>
            }

            <LoadGate IsLoading="@(!emailsLoaded)" Prominent="true" Label="Loading programme emails">
            @if (emails.Count == 0)
            {
                @* Only when the mailbox actually answered "none" — a failure says so above. *@
                @if (emailsError is null)
                {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No relevant events yet.</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tick <span class="font-medium text-content">Relevant Event for Programme</span> on an email in the Control Centre and it will appear here.
                    </p>
                </div>
                }
            }
            else
            {
                <ul class="space-y-2">
                    @foreach (var email in emails)
                    {
                        <li class="rounded-lg border border-line bg-surface px-4 py-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <span class="text-sm font-medium text-content">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                                <span class="text-xs text-content-subtle">@email.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
                            </div>
                            <p class="text-sm text-content mt-0.5">
                                @email.Subject
                                @if (email.HasAttachments)
                                {
                                    <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                                }
                            </p>
                            @if (expandedEmails.Contains(email.Id))
                            {
                                @* Expanded email: the full body (incl. the quoted thread), fetched live on
                                   demand. The listed BodyPreview is only Graph's short snippet, so long emails
                                   and their history only appear here. HTML is sanitised server-side. *@
                                <div class="mt-2 rounded-lg bg-surface-raised border border-line p-3 max-h-[28rem] overflow-y-auto">
                                    @if (!emailDetails.TryGetValue(email.Id, out var detail) || detail is null)
                                    {
                                        <p class="text-sm text-content-subtle italic">Loading full email…</p>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
                                    {
                                        <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto">@((MarkupString)detail.BodyHtml)</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(detail.BodyHtml))
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap">@detail.BodyHtml</p>
                                    }
                                    else
                                    {
                                        <p class="text-sm text-content whitespace-pre-wrap">@email.BodyPreview</p>
                                    }
                                </div>
                                @if (emailDetails.TryGetValue(email.Id, out var loadedDetail)
                                     && loadedDetail is { Attachments.Count: > 0 })
                                {
                                    <p class="text-xs text-content-subtle mt-1">
                                        @loadedDetail.Attachments.Count attachment@(loadedDetail.Attachments.Count == 1 ? "" : "s"):
                                        @string.Join(", ", loadedDetail.Attachments.Select(a => a.Name))
                                    </p>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(email.BodyPreview))
                            {
                                <p class="text-xs text-content-subtle mt-1 line-clamp-2">@email.BodyPreview</p>
                            }
                            <div class="mt-2 pt-2 border-t border-line/70 flex flex-wrap items-center gap-4">
                                <button type="button"
                                        class="text-xs font-medium text-accent hover:underline"
                                        @onclick="() => ToggleEmailAsync(email)">
                                    @(expandedEmails.Contains(email.Id) ? "Show summary" : "Show full email")
                                </button>
                                @if (CanDraftReply)
                                {
                                    <button type="button"
                                            class="text-xs font-medium text-accent hover:underline"
                                            @onclick="() => ToggleReply(email)">
                                        @(replyForId == email.Id ? "Cancel reply" : "Reply in thread")
                                    </button>
                                }
                            </div>
                            @if (replyForId == email.Id)
                            {
                                <div class="mt-2 rounded-lg border border-line bg-surface-raised px-4 py-3">
                                    @if (replyError is not null)
                                    {
                                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@replyError</p>
                                    }
                                    <textarea class="field mb-3" rows="4" value="@replyBody" @oninput="OnReplyInput"
                                              placeholder="Write your reply — in the draft it will sit above the quoted thread…"></textarea>
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <p class="text-xs text-content-subtle">
                                            Creates a reply-all draft in the projects mailbox — review and send it from Outlook; nothing is sent from here.
                                        </p>
                                        <button type="button" class="btn-primary"
                                                disabled="@(replyBusy || string.IsNullOrWhiteSpace(replyBody))"
                                                @onclick="() => CreateReplyDraftAsync(email)">
                                            @(replyBusy ? "Creating draft…" : "Create reply draft")
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (replyDraftForId == email.Id && replyDraft is not null)
                            {
                                <div class="mt-2 rounded-lg bg-positive/10 border border-positive/30 px-3 py-2">
                                    <p class="text-sm font-medium text-positive">
                                        Reply draft created in the projects mailbox — in this email's thread.
                                    </p>
                                    <p class="text-xs text-content-subtle mt-1">To: @string.Join(", ", replyDraft.Recipients)</p>
                                    @if (replyDraft.Cc is { Count: > 0 } replyCc)
                                    {
                                        <p class="text-xs text-content-subtle">CC: @string.Join(", ", replyCc)</p>
                                    }
                                    <p class="text-xs text-content-subtle">
                                        Review the recipients and send it from Outlook — nothing has been sent.
                                        The sent copy keeps this thread's Programme tag, so it will appear here.
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(replyDraft.WebLink))
                                    {
                                        <a href="@replyDraft.WebLink" target="_blank" rel="noopener"
                                           class="text-xs text-accent hover:underline underline-offset-2">Open the draft in Outlook</a>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>
            }
            </LoadGate>
        }
    </ProjectPageShell>
</ApprovedSessionGate>

