@page "/projects/{ProjectId}/inventory"
@using Jewel.JPMS.Contracts.Inventory
@using Jewel.JPMS.Features.Inventory
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject InventoryReadModel Inventory
@inject ICommandSender Commands
@inject IQueryClient Queries
@implements IDisposable

<PageTitle>Inventory · JPMS</PageTitle>

@*
    The project's inventory register — goods held for the job: what the product is and where it's
    kept. An item is added here directly or from a supplier email in the Control Centre (Supplier
    pathway → Add Inventory Item); either way it carries a sequential INV-#### reference, which is
    also its mailbox tag stem — so every email filed to the item reads back live under it here,
    exactly like a defect or work order.
*@

<Page>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="inventory">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-content">Inventory</h2>
            <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition"
                    @onclick="ToggleForm">
                @(formOpen ? "Close" : "Add item")
            </button>
        </div>

        @if (actionError is { } error)
        {
            <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
        }

        @if (formOpen)
        {
            <section class="rounded-xl border border-line bg-surface p-5 mb-5">
                <h3 class="text-sm font-medium text-content-muted mb-3">@(editingItemId is null ? "Add an inventory item" : $"Edit {EditingReference}")</h3>
                <div class="space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block eyebrow mb-1">Product name *</label>
                            <input type="text" class="field" maxlength="256" placeholder="What the product is"
                                   value="@formProductName" @oninput="e => formProductName = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div>
                            <label class="block eyebrow mb-1">Location</label>
                            <input type="text" class="field" maxlength="256" placeholder="Where it's kept — site, container, store room"
                                   value="@formLocation" @oninput="e => formLocation = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div>
                    <div>
                        <label class="block eyebrow mb-1">Product details</label>
                        <textarea class="field" rows="3" maxlength="2048" placeholder="Make, spec, sizes, quantities"
                                  value="@formProductDetails" @oninput="e => formProductDetails = e.Value?.ToString() ?? string.Empty"></textarea>
                    </div>
                    <div>
                        <label class="block eyebrow mb-1">Location details</label>
                        <textarea class="field" rows="2" maxlength="2048" placeholder="Anything that helps find it — shelf, bay, who holds the key"
                                  value="@formLocationDetails" @oninput="e => formLocationDetails = e.Value?.ToString() ?? string.Empty"></textarea>
                    </div>
                    <button type="button" class="rounded-lg bg-accent text-accent-ink font-medium text-sm px-3 py-2 hover:bg-accent-hover transition disabled:opacity-50"
                            disabled="@(string.IsNullOrWhiteSpace(formProductName) || busy)"
                            @onclick="SaveAsync">
                        @(editingItemId is null ? "Add item" : "Save changes")
                    </button>
                </div>
            </section>
        }

        @if (!Inventory.LoadedFor(ProjectId) && !dataFailed)
        {
            <LoadGate IsLoading="true" Prominent="true" Label="Loading inventory" />
        }
        else if (dataFailed && !Inventory.LoadedFor(ProjectId))
        {
            <p class="text-sm text-content-muted">The inventory couldn't be loaded just now — the error toast has the detail. Reload the page to retry.</p>
        }
        else if (Rows.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No inventory on this project. Add an item here, or file a supplier email to a new item from the Control Centre.</p>
        }
        else
        {
            <div class="rounded-xl border border-line bg-surface overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-line text-left">
                            <th class="px-4 py-2.5 eyebrow">Ref</th>
                            <th class="px-4 py-2.5 eyebrow">Product</th>
                            <th class="px-4 py-2.5 eyebrow">Details</th>
                            <th class="px-4 py-2.5 eyebrow">Location</th>
                            <th class="px-4 py-2.5 eyebrow">Added</th>
                            <th class="px-4 py-2.5"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Rows)
                        {
                            var isExpanded = expandedItemId == item.InventoryItemId;
                            <tr @key="item.InventoryItemId" class="border-b border-line last:border-0 align-top">
                                <td class="px-4 py-2.5 font-mono text-xs text-content-muted whitespace-nowrap">@item.Reference</td>
                                <td class="px-4 py-2.5 text-content">@item.ProductName</td>
                                <td class="px-4 py-2.5 text-content-muted max-w-md">
                                    <span title="@item.ProductDetails">@item.ProductDetails</span>
                                </td>
                                <td class="px-4 py-2.5 text-content-muted max-w-xs">
                                    <span title="@item.LocationDetails">@item.Location</span>
                                </td>
                                <td class="px-4 py-2.5 text-content-muted whitespace-nowrap" title="@item.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")">
                                    @item.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                                </td>
                                <td class="px-4 py-2.5 whitespace-nowrap text-right">
                                    <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4 mr-3"
                                            @onclick="() => StartEdit(item)">
                                        Edit
                                    </button>
                                    <button type="button" class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4"
                                            @onclick="() => ToggleEmailsAsync(item.InventoryItemId)">
                                        @(isExpanded ? "Hide emails" : "Emails")
                                    </button>
                                </td>
                            </tr>
                            @if (isExpanded)
                            {
                                <tr class="border-b border-line last:border-0 bg-surface-raised/50">
                                    <td colspan="6" class="px-4 py-3">
                                        <FiledEmailList Emails="@(emailsByItem.TryGetValue(item.InventoryItemId, out var filedEmails) ? filedEmails : null)"
                                            EmptyMessage="@($"No emails filed to {item.Reference} yet — file one from the Control Centre (Supplier pathway → Inventory items).")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </ProjectPageShell>
</Page>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private bool sessionReady;
    private bool dataFailed;
    private bool busy;
    private string? actionError;

    // One form for both add and edit: editingItemId null = adding.
    private bool formOpen;
    private string? editingItemId;
    private string formProductName = "";
    private string formProductDetails = "";
    private string formLocation = "";
    private string formLocationDetails = "";

    // One expanded item at a time; its emails are read live by tag (ListRecordEmails) and cached
    // for the visit so collapsing/expanding doesn't refetch.
    private string? expandedItemId;
    private readonly Dictionary<string, IReadOnlyList<MailboxMessage>> emailsByItem = new();

    private IReadOnlyList<InventoryItem> Rows => Inventory.Current(ProjectId);

    private string EditingReference =>
        Rows.FirstOrDefault(item => item.InventoryItemId == editingItemId)?.Reference ?? "item";

    protected override async Task OnInitializedAsync()
    {
        Inventory.OnChanged += StateHasChanged;
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        sessionReady = true;
        await LoadAsync();
    }

    private string loadedForProjectId = "";

    protected override async Task OnParametersSetAsync()
    {
        // Project switch via the shell's arrows: same page, new key — load the new register
        // (and give a previously failed project a fresh chance).
        if (!sessionReady || loadedForProjectId == ProjectId) return;
        dataFailed = false;
        expandedItemId = null;
        formOpen = false;
        editingItemId = null;
        actionError = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loadedForProjectId = ProjectId;
        try { await Inventory.RefreshAsync(ProjectId, CancellationToken.None); }
        catch { dataFailed = true; } // the query client has already toasted the detail
    }

    private void ToggleForm()
    {
        if (formOpen) { formOpen = false; editingItemId = null; return; }
        editingItemId = null;
        formProductName = ""; formProductDetails = ""; formLocation = ""; formLocationDetails = "";
        formOpen = true;
    }

    private void StartEdit(InventoryItem item)
    {
        editingItemId = item.InventoryItemId;
        formProductName = item.ProductName;
        formProductDetails = item.ProductDetails;
        formLocation = item.Location;
        formLocationDetails = item.LocationDetails;
        formOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(formProductName)) return;
        busy = true;
        actionError = null;
        try
        {
            if (editingItemId is { } itemId)
            {
                await Commands.SendAsync(new UpdateInventoryItem(
                    itemId, formProductName.Trim(), formProductDetails.Trim(),
                    formLocation.Trim(), formLocationDetails.Trim()), CancellationToken.None);
            }
            else
            {
                await Commands.SendAsync(new AddInventoryItem(
                    ProjectId, formProductName.Trim(), formProductDetails.Trim(),
                    formLocation.Trim(), formLocationDetails.Trim()), CancellationToken.None);
            }
            formProductName = ""; formProductDetails = ""; formLocation = ""; formLocationDetails = "";
            formOpen = false;
            editingItemId = null;
            await RefreshAfterWriteAsync();
        }
        catch (CommandFailedException ex) { actionError = ex.Message; }
        finally { busy = false; }
    }

    // Post-write reload: swallow query failures (the toast already reported them) so a 502 on the
    // refetch can't take the page down after a successful write — see post-write-reload rule.
    private async Task RefreshAfterWriteAsync()
    {
        try { await Inventory.RefreshAsync(ProjectId, CancellationToken.None); }
        catch (OperationCanceledException) { throw; }
        catch { }
    }

    private async Task ToggleEmailsAsync(string itemId)
    {
        if (expandedItemId == itemId) { expandedItemId = null; return; }
        expandedItemId = itemId;
        if (emailsByItem.ContainsKey(itemId)) return;
        try
        {
            var emails = await Queries.AskAsync(new ListRecordEmails(RecordType.Inventory, itemId), CancellationToken.None);
            emailsByItem[itemId] = emails;
        }
        catch
        {
            // The toast has the detail; an empty list is the honest fallback for this visit.
            emailsByItem[itemId] = Array.Empty<MailboxMessage>();
        }
    }

    public void Dispose() => Inventory.OnChanged -= StateHasChanged;
}
