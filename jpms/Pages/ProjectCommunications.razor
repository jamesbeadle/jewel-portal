@page "/projects/{ProjectId}/communications"
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Features.Triage
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList

<PageTitle>Communications · JPMS</PageTitle>

@*
    The project's Communications tab — every email tagged to one of this project's records, read
    live from the mailbox in one place. Triage stamps "JPMS/<TagReference>" categories on emails
    (cost centres, requests, bid package invites, programme, to-dos, LADs, variations); the per-record
    views read their own tag, and this tab is the cross-cutting roll-up: all of it, newest paged
    first, filterable by pathway (the Client / Subcontractor / Supplier / Internal bucket the thread is filed
    under) and by the type of thing tagged. Each row shows the thread's pathway chip plus WHICH
    record(s) the email is tagged to — an email can feed several records at once (e.g. a request
    AND a cost centre). Every row carries the consistent Reply widget — replying from here SENDS
    there and then; the sent copy inherits the thread's tags and files back into this roll-up.
    Tagging itself stays in mailbox triage.
*@

<ApprovedSessionGate>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="communications">
        @* Pathway first, then type: the segmented control narrows to one side of the client wall
           (the thread's bucket category), the type filter to one kind of record within it. *@
        <div class="flex flex-wrap items-center gap-2 mb-3">
            <button type="button" class="@BucketTabClass(null)" @onclick="() => OnBucketChanged(null)">All</button>
            @foreach (var bucket in BucketLabels)
            {
                var value = bucket;
                <button type="button" class="@BucketTabClass(value)" @onclick="() => OnBucketChanged(value)">@value</button>
            }
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2">
                <label for="comms-type" class="text-sm text-content-subtle">Tagged to</label>
                <select id="comms-type" class="field w-52" value="@typeFilterRaw" @onchange="OnTypeFilterChanged">
                    <option value="">All types</option>
                    @foreach (var option in TypeOptions)
                    {
                        <option value="@option.Type">@option.Label</option>
                    }
                </select>
            </div>
            @* Total == 0 means "count unknown", not "none": both the >10-tags marker-scan path and
               any bucket-filtered read count per page only — hide the tally rather than lie. *@
            @if (loaded && total > 0)
            {
                <p class="text-xs text-content-subtle">Showing @items.Count of @total</p>
            }
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@loadError</p>
        }

        <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading communications">
        @if (items.Count == 0)
        {
            @* A failed fetch leaves the list empty; the banner above says so, and "nothing tagged
               yet" would read as an answer rather than a failure. *@
            @if (loadError is null)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@EmptyHeadline</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tag an email to a record in the Control Centre and it will appear here.
                    </p>
                </div>
            }
        }
        else
        {
            @if (replySent is not null)
            {
                <div class="rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
                    <p class="text-sm text-content">@replySent</p>
                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                            @onclick="() => replySent = null">✕</button>
                </div>
            }
            @if (replyTo is { } replyingTo)
            {
                <div class="mb-4 space-y-2">
                    <p class="text-sm text-content-muted">
                        @(composeIsForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@DisplayFrom(replyingTo)</span> —
                        <span class="italic">@replyingTo.Subject</span>
                    </p>
                    <MailReplyComposer @key="@($"{replyingTo.Id}:{composeIsForward}")" ReplyTo="replyingTo" Forward="composeIsForward"
                                       Projects="@(ProjectList.Current ?? Array.Empty<Project>())" ProjectId="@ProjectId"
                                       FooterNote="@(composeIsForward
                                           ? "The forward sends now from the projects mailbox and files itself back into this list."
                                           : "The reply sends now from the projects mailbox and files itself back into this list.")"
                                       OnSent="OnReplySent" OnCancel="() => replyTo = null" />
                </div>
            }
            <ul class="space-y-2">
                @foreach (var item in items)
                {
                    <li @key="item.Message.Id" class="rounded-lg border border-line bg-surface px-4 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="flex items-center gap-2 min-w-0">
                                <span class="text-sm font-medium text-content truncate">@DisplayFrom(item.Message)</span>
                                @* The thread's pathway (bucket category), when triage has filed it. *@
                                @if (BucketLabel(item.Message.Bucket) is { } pathway)
                                {
                                    <span class="@BucketChipClass(pathway)">@pathway</span>
                                }
                            </span>
                            <span class="text-xs text-content-subtle">@item.Message.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        <p class="text-sm text-content mt-0.5">
                            @item.Message.Subject
                            @if (item.Message.HasAttachments)
                            {
                                <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(item.Message.BodyPreview))
                        {
                            <p class="text-xs text-content-subtle mt-1 line-clamp-2">@item.Message.BodyPreview</p>
                        }
                        <div class="flex flex-wrap items-center gap-1 mt-2">
                            @foreach (var link in item.Links)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-medium text-accent"
                                      title="@link.Tag">
                                    <span class="uppercase tracking-wide">@TypeLabel(link.Type)</span>
                                    <span class="font-mono">@link.Reference</span>
                                    @if (!string.IsNullOrWhiteSpace(link.Title) && link.Title != link.Reference)
                                    {
                                        <span class="font-normal max-w-[16rem] truncate">· @link.Title</span>
                                    }
                                </span>
                            }
                            @* Workflow tags that didn't resolve to one of this project's records —
                               e.g. another project's tag on a shared thread — shown raw so nothing
                               the email carries is hidden. *@
                            @foreach (var tag in UnresolvedTags(item))
                            {
                                <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[10px] text-content-subtle">@TagStem(tag)</span>
                            }
                        </div>
                        <div class="mt-2 flex items-center gap-4">
                            <button type="button" class="text-xs font-medium text-accent hover:underline"
                                    @onclick="() => StartCompose(item.Message, forward: false)">↩ Reply</button>
                            <button type="button" class="text-xs font-medium text-accent hover:underline"
                                    @onclick="() => StartCompose(item.Message, forward: true)">→ Forward</button>
                        </div>
                    </li>
                }
            </ul>

            @if (nextCursor is not null)
            {
                <div class="mt-4 text-center">
                    <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
        </LoadGate>
    </ProjectPageShell>
</ApprovedSessionGate>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    private const int PageSize = 25;

    // Session checked and the user is signed in — the filters and the tab chrome show straight
    // away. `loaded` is the separate question of whether the page of emails has arrived.
    private bool loaded;
    private bool loadingMore;
    private string? loadError;

    private string typeFilterRaw = "";
    private RecordType? TypeFilter =>
        Enum.TryParse<RecordType>(typeFilterRaw, out var parsed) ? parsed : null;

    // The pathway segmented control's selection: a short bucket label ("Client"), or null for all.
    private string? bucketFilter;
    private static readonly string[] BucketLabels = { "Client", "Subcontractor", "Supplier", "Internal" };

    private readonly List<ProjectCommunication> items = new();
    private string? nextCursor;
    private int total;

    // The email a Reply or Forward was pressed on (the shared composer opens above the list;
    // sending from a record page sends immediately), which of the two it was, and the
    // confirmation left behind by the last send.
    private MailboxMessage? replyTo;
    private bool composeIsForward;
    private string? replySent;

    private void StartCompose(MailboxMessage message, bool forward)
    {
        replyTo = message;
        composeIsForward = forward;
    }

    private async Task OnReplySent(Jewel.JPMS.Contracts.MailboxCompose.ComposeOutcome outcome)
    {
        var wasForward = composeIsForward;
        replyTo = null;
        composeIsForward = false;
        replySent = outcome.Sent
            ? $"{(wasForward ? "Forward" : "Reply")} sent to {string.Join("; ", outcome.To)} — it joins the thread and files back into this list."
            : $"The {(wasForward ? "forward" : "reply")} was saved to the mailbox's Drafts — review and send it from Outlook.";
        // The sent copy self-files by the thread's tags; re-read so it appears straight away.
        await LoadAsync(reset: true);
    }

    private async Task LoadProjectListAsync()
    {
        try { await ProjectList.RefreshAsync(CancellationToken.None); }
        catch { /* reported by the query client; the picker's project sources render empty */ }
    }

    // Every linkable record type, labelled in canonical UI terms — RecordType.Scheduling is the
    // programme's bucket, so it reads "Relevant Events" here (never "Scheduling" in UI copy;
    // "Relevant Event" per the 2026-08-07 rename).
    private static readonly (RecordType Type, string Label)[] TypeOptions =
    {
        (RecordType.CostCentre,       "Cost centres"),
        (RecordType.Request,          "Requests (RFI/RFA/…)"),
        (RecordType.BidPackageInvite, "Bid package invites"),
        (RecordType.WorkOrder,        "Work orders"),
        (RecordType.Scheduling,       "Relevant events (Programme)"),
        (RecordType.Todo,             "To-dos"),
        (RecordType.CalendarEvent,    "Calendar events"),
        (RecordType.Lad,              "LADs"),
        (RecordType.Variation,        "Variation orders"),
        (RecordType.VariationQuote,   "VO quotes"),
        (RecordType.Defect,           "Defects"),
        (RecordType.Inventory,        "Inventory"),
        (RecordType.ValuationReportSnapshot, "Valuation snapshots")
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        // The project list only feeds the reply composer's attachment picker — background warm.
        _ = LoadProjectListAsync();
        await LoadAsync(reset: true);
    }

    private async Task OnTypeFilterChanged(ChangeEventArgs e)
    {
        typeFilterRaw = e.Value?.ToString() ?? "";
        await LoadAsync(reset: true);
    }

    private async Task OnBucketChanged(string? bucket)
    {
        if (bucketFilter == bucket) return;
        bucketFilter = bucket;
        await LoadAsync(reset: true);
    }

    private string BucketTabClass(string? bucket) =>
        bucketFilter == bucket
            ? "btn-primary text-xs px-2.5 py-1.5"
            : "btn-secondary text-xs px-2.5 py-1.5";

    private Task LoadMoreAsync() => LoadAsync(reset: false);

    private async Task LoadAsync(bool reset)
    {
        if (reset)
        {
            loaded = false;
            items.Clear();
            nextCursor = null;
            total = 0;
        }
        loadError = null;
        loadingMore = !reset;
        try
        {
            var page = await Queries.AskAsync(
                new ListProjectCommunications(ProjectId, TypeFilter, nextCursor, PageSize, bucketFilter),
                CancellationToken.None);
            items.AddRange(page.Items);
            nextCursor = page.NextCursor;
            total = page.Total;
        }
        catch
        {
            loadError = "Couldn't load the project's communications. Please try again.";
        }
        finally
        {
            loaded = true;
            loadingMore = false;
        }
    }

    private string EmptyHeadline =>
        TypeFilter is { } type
            ? $"No emails tagged to {TypeOptions.First(o => o.Type == type).Label} yet."
            : bucketFilter is { } bucket
                ? $"No tagged emails on the {bucket} pathway yet."
                : "No tagged emails yet.";

    // Short pathway label from the thread's bucket category ("JPMS/Client" → "Client"); null when
    // the thread has no pathway yet. Clients read Message.Bucket, never parse tag strings — this
    // only strips the mailbox prefix for display.
    private static string? BucketLabel(string? bucket) =>
        string.IsNullOrEmpty(bucket) ? null
        : bucket.StartsWith("JPMS/", StringComparison.OrdinalIgnoreCase) ? bucket["JPMS/".Length..]
        : bucket;

    private static string BucketChipClass(string pathway)
    {
        const string baseClass = "inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-medium shrink-0 ";
        return pathway switch
        {
            "Client"        => baseClass + "bg-accent/10 text-accent",
            "Subcontractor" => baseClass + "bg-positive/10 text-positive",
            "Supplier"      => baseClass + "bg-sky-500/10 text-sky-600",
            _               => baseClass + "bg-surface-raised border border-line text-content-muted"
        };
    }

    // Chip label per record type — singular, canonical UI terms.
    private static string TypeLabel(RecordType type) => type switch
    {
        RecordType.Request          => "Request",
        RecordType.BidPackageInvite => "Bid package",
        RecordType.WorkOrder        => "Work order",
        RecordType.CostCentre       => "Cost centre",
        RecordType.Scheduling       => "Relevant Event",
        RecordType.Todo             => "To-do",
        RecordType.CalendarEvent    => "Calendar event",
        RecordType.Lad              => "LADs",
        RecordType.Variation        => "VO",
        RecordType.VariationQuote   => "Variation",
        RecordType.Defect           => "Defect",
        RecordType.Inventory        => "Inventory item",
        RecordType.ValuationReportSnapshot => "Valuation snapshot",
        RecordType.SubcontractorComms => "Subcontractor comms",
        RecordType.SupplierComms    => "Supplier comms",
        RecordType.InternalComms    => "Internal comms",
        _                           => type.ToString()
    };

    private static string DisplayFrom(MailboxMessage message) =>
        string.IsNullOrWhiteSpace(message.FromName) ? message.FromEmail : message.FromName;

    // The email's workflow tags that didn't resolve to one of this project's records (the resolved
    // ones already render as record chips). The bare "JPMS" marker never reaches the client.
    private static IEnumerable<string> UnresolvedTags(ProjectCommunication item) =>
        item.Message.Categories.Where(category =>
            !item.Links.Any(link => string.Equals(link.Tag, category, StringComparison.OrdinalIgnoreCase)));

    private static string TagStem(string tag) =>
        tag.StartsWith("JPMS/", StringComparison.OrdinalIgnoreCase) ? tag["JPMS/".Length..] : tag;
}
