@page "/projects/{ProjectId}/communications"
@using Jewel.JPMS.Features.Triage
@inject AuthService Auth
@inject SessionService Session
@inject IQueryClient Queries
@inject NavigationManager Nav
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList

<PageTitle>Communications · JPMS</PageTitle>

@*
    The project's Communications tab — every email tagged to one of this project's records, read
    live from the mailbox in one place. Triage stamps "JPMS/<TagReference>" categories on emails
    (cost centres, requests, bid package invites, programme, to-dos, LADs, variations); the per-record
    views read their own tag, and this tab is the cross-cutting roll-up: all of it, newest paged
    first, filterable by pathway (the Client / Subcontractor / Supplier / Internal bucket the thread is filed
    under) and by the type of thing tagged. Each row shows the thread's pathway chip plus WHICH
    record(s) the email is tagged to — an email can feed several records at once (e.g. a request
    AND a cost centre). Every row carries the consistent Reply widget — replying from here SENDS
    there and then; the sent copy inherits the thread's tags and files back into this roll-up.
    Tagging itself stays in mailbox triage.
*@

<ApprovedSessionGate>
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="communications">
        @* Pathway first, then type: the segmented control narrows to one side of the client wall
           (the thread's bucket category), the type filter to one kind of record within it. *@
        <div class="flex flex-wrap items-center gap-2 mb-3">
            <button type="button" class="@BucketTabClass(null)" @onclick="() => OnBucketChanged(null)">All</button>
            @foreach (var bucket in BucketLabels)
            {
                var value = bucket;
                <button type="button" class="@BucketTabClass(value)" @onclick="() => OnBucketChanged(value)">@value</button>
            }
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2">
                <label for="comms-type" class="text-sm text-content-subtle">Tagged to</label>
                <select id="comms-type" class="field w-52" value="@typeFilterRaw" @onchange="OnTypeFilterChanged">
                    <option value="">All types</option>
                    @foreach (var option in TypeOptions)
                    {
                        <option value="@option.Type">@option.Label</option>
                    }
                </select>
            </div>
            @* Total == 0 means "count unknown", not "none": both the >10-tags marker-scan path and
               any bucket-filtered read count per page only — hide the tally rather than lie. *@
            @if (loaded && total > 0)
            {
                <p class="text-xs text-content-subtle">Showing @items.Count of @total</p>
            }
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@loadError</p>
        }

        <LoadGate IsLoading="@(!loaded)" Prominent="true" Label="Loading communications">
        @if (items.Count == 0)
        {
            @* A failed fetch leaves the list empty; the banner above says so, and "nothing tagged
               yet" would read as an answer rather than a failure. *@
            @if (loadError is null)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@EmptyHeadline</p>
                    <p class="text-xs text-content-subtle mt-1">
                        Tag an email to a record in the Control Centre and it will appear here.
                    </p>
                </div>
            }
        }
        else
        {
            @if (replySent is not null)
            {
                <div class="rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
                    <p class="text-sm text-content">@replySent</p>
                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                            @onclick="() => replySent = null">✕</button>
                </div>
            }
            @if (replyTo is { } replyingTo)
            {
                <div class="mb-4 space-y-2">
                    <p class="text-sm text-content-muted">
                        @(composeIsForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@DisplayFrom(replyingTo)</span> —
                        <span class="italic">@replyingTo.Subject</span>
                    </p>
                    <MailReplyComposer @key="@($"{replyingTo.Id}:{composeIsForward}")" ReplyTo="replyingTo" Forward="composeIsForward"
                                       Projects="@(ProjectList.Current ?? Array.Empty<Project>())" ProjectId="@ProjectId"
                                       FooterNote="@(composeIsForward
                                           ? "The forward sends now from the projects mailbox and files itself back into this list."
                                           : "The reply sends now from the projects mailbox and files itself back into this list.")"
                                       OnSent="OnReplySent" OnCancel="() => replyTo = null" />
                </div>
            }
            <ul class="space-y-2">
                @foreach (var item in items)
                {
                    <li @key="item.Message.Id" class="rounded-lg border border-line bg-surface px-4 py-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="flex items-center gap-2 min-w-0">
                                <span class="text-sm font-medium text-content truncate">@DisplayFrom(item.Message)</span>
                                @* The thread's pathway (bucket category), when triage has filed it. *@
                                @if (BucketLabel(item.Message.Bucket) is { } pathway)
                                {
                                    <span class="@BucketChipClass(pathway)">@pathway</span>
                                }
                            </span>
                            <span class="text-xs text-content-subtle">@item.Message.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        <p class="text-sm text-content mt-0.5">
                            @item.Message.Subject
                            @if (item.Message.HasAttachments)
                            {
                                <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(item.Message.BodyPreview))
                        {
                            <p class="text-xs text-content-subtle mt-1 line-clamp-2">@item.Message.BodyPreview</p>
                        }
                        <div class="flex flex-wrap items-center gap-1 mt-2">
                            @foreach (var link in item.Links)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-accent/10 px-2 py-0.5 text-[10px] font-medium text-accent"
                                      title="@link.Tag">
                                    <span class="uppercase tracking-wide">@TypeLabel(link.Type)</span>
                                    <span class="font-mono">@link.Reference</span>
                                    @if (!string.IsNullOrWhiteSpace(link.Title) && link.Title != link.Reference)
                                    {
                                        <span class="font-normal max-w-[16rem] truncate">· @link.Title</span>
                                    }
                                </span>
                            }
                            @* Workflow tags that didn't resolve to one of this project's records —
                               e.g. another project's tag on a shared thread — shown raw so nothing
                               the email carries is hidden. *@
                            @foreach (var tag in UnresolvedTags(item))
                            {
                                <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[10px] text-content-subtle">@TagStem(tag)</span>
                            }
                        </div>
                        <div class="mt-2 flex items-center gap-4">
                            <button type="button" class="text-xs font-medium text-accent hover:underline"
                                    @onclick="() => StartCompose(item.Message, forward: false)">↩ Reply</button>
                            <button type="button" class="text-xs font-medium text-accent hover:underline"
                                    @onclick="() => StartCompose(item.Message, forward: true)">→ Forward</button>
                        </div>
                    </li>
                }
            </ul>

            @if (nextCursor is not null)
            {
                <div class="mt-4 text-center">
                    <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                </div>
            }
        }
        </LoadGate>
    </ProjectPageShell>
</ApprovedSessionGate>

