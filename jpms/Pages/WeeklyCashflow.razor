@page "/finance/weekly-cashflow"
@using Jewel.JPMS.Contracts.WeeklyCashflow
@using Jewel.JPMS.Features.WeeklyCashflow
@inject AuthService Auth
@inject SessionService Session
@inject IXeroAgedPayablesStore Payables
@inject IXeroAgedReceivablesStore Receivables
@inject IXeroCashSummaryStore Cash
@inject WeeklyCashflowPlanReadModel Plan
@inject ICommandSender Commands
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Weekly Cashflow · JPMS</PageTitle>

@*
    The Weekly Cashflow (the sidebar's Financial Reports folder) — the accountant's live payment
    plan. The Cash Forecast next door is the rough forward position, monthly to completion; this
    is the NEXT 13 WEEKS as the money will actually move, and it is worked, not just read.

    Three sources, one grid:
      * Every outstanding supplier bill (aged payables read — drafts included, exactly the Aged
        Payables page's rows) seeded into the week of its Xero due date — or of its Xero
        "Planned date" when the accountant has set one.
      * Every outstanding sales invoice (aged receivables read) seeded the same way, honouring
        Xero's "Expected date" over the due date — the cash coming in that decides what is
        affordable each week. Retention held back or an agreed late payment is recorded ONCE,
        in Xero, and this grid follows; a move here remains the portal-only alternative.
      * Manual items — subcontractors, staff, subscriptions, anything that isn't a project cost —
        one-off or recurring, kept on this page because Xero can't see them coming.

    The one moving part: any entry can be MOVED to the week it will really be paid (the ‹ › on
    its cell; ↺ returns it to its natural week — Xero's expected/planned date when set, the due
    week otherwise). A move is a stored placement — who, when, which
    week — so the plan is one shared truth, not a per-browser scratchpad. Moving changes WHEN,
    never HOW MUCH: the grid's total always equals the payables, receivables and items that went
    in — WeeklyCashflowMaths (pure, unit-tested) owns that arithmetic.

    The bank-anchored line (closing balance per week, lowest week flagged) is directors-only,
    mirroring the API's gate on the Xero cash summary. Accounts sees the movements — that is the
    working surface — without the bank position.
*@

<ApprovedSessionGate>
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6 md:mb-8 flex items-end justify-between gap-4 flex-wrap">
            <div>
                <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · Company</p>
                <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Weekly Cashflow</h1>
                <p class="text-sm text-content-muted mt-1">
                    The next @WeeklyCashflowMaths.DefaultWeekCount weeks, week by week — every outstanding bill and invoice from Xero, plus the
                    outgoings it can't see. Move any entry to the week it will really be paid.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <Toolbar>
                    <ExportToExcelButton FileName="Weekly cashflow"
                                         Disabled="@(!GridReady || !XeroReady)"
                                         BuildWorkbook="BuildExportWorkbook" />
                    <ToolbarDivider />
                    <ToolbarButton Icon="folder" Label="Group suppliers"
                                   Disabled="@(!GridReady || planFailed)" OnClick="OpenGroupsDialog" />
                    <ToolbarButton Icon="refresh" Label="Refresh from Xero"
                                   Busy="@isRefreshing" OnClick="ForceRefreshAsync" />
                </Toolbar>
                @* A control, so never gated — disabled until the plan has landed, in its own language. *@
                <button type="button" class="btn-primary" disabled="@(!GridReady || planFailed)" @onclick="OpenAddDialog">Add item</button>
            </div>
        </header>

        @{
            // Computed ONCE per render and threaded through — the tiles, the bands and the
            // export must all describe the same grid.
            var view = GridReady && XeroReady ? BuildView() : null;
        }

        @* ── KPI strip. The movement tiles are everyone's; the bank-anchored tiles are the
           directors', mirroring the API's gate. Tiles keep their shape while loading: label
           stays, figure pulses. ── *@
        <div class="grid gap-4 sm:grid-cols-2 @(IsDirector ? "lg:grid-cols-4" : "lg:grid-cols-3") mb-8">
            @if (IsDirector)
            {
                <div class="rounded-xl border border-line bg-surface px-5 py-4">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Cash in bank</p>
                    @if (BankSnapshot is null)
                    {
                        @LoadingFigure("Loading cash in bank")
                    }
                    else if (!BankReady)
                    {
                        <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
                    }
                    else
                    {
                        <p class="text-2xl font-semibold text-content">@Money(BankSnapshot!.TotalCash)</p>
                        <p class="text-xs text-content-subtle mt-1">Xero, as of @FetchedText</p>
                    }
                </div>
            }
            <div class="rounded-xl border border-line bg-surface px-5 py-4"
                 title="Cash out planned for the current week — bills and manual items placed (or due) this week.">
                <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">To pay this week</p>
                @if (view is null)
                {
                    @LoadingFigure("Loading this week's payments")
                }
                else
                {
                    <p class="text-2xl font-semibold text-content">@Money(view.CashOut[0])</p>
                    <p class="text-xs text-content-subtle mt-1">incl. everything overdue</p>
                }
            </div>
            @if (IsDirector)
            {
                <div class="rounded-xl border border-line bg-surface px-5 py-4"
                     title="The running bank balance's low point across the visible weeks — the week to plan for.">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Lowest week</p>
                    @if (view is null || BankSnapshot is null)
                    {
                        @LoadingFigure("Loading the lowest week")
                    }
                    else if (view.Closing is null)
                    {
                        <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
                    }
                    else
                    {
                        var low = view.Closing[view.MinClosingIndex];
                        <p class="text-2xl font-semibold @(low < 0m ? "text-negative" : "text-content")">@Money(low)</p>
                        <p class="text-xs text-content-subtle mt-1">@WeekLabel(view.WeekStarts[view.MinClosingIndex], view.MinClosingIndex)</p>
                    }
                </div>
                <div class="rounded-xl border border-line bg-surface px-5 py-4"
                     title="The running bank balance after the last visible week. Entries in Later are beyond the horizon and not yet counted.">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Balance at horizon end</p>
                    @if (view is null || BankSnapshot is null)
                    {
                        @LoadingFigure("Loading the horizon-end balance")
                    }
                    else if (view.Closing is null)
                    {
                        <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
                    }
                    else
                    {
                        var horizonEnd = view.Closing[^1];
                        <p class="text-2xl font-semibold @(horizonEnd < 0m ? "text-negative" : "text-content")">@Money(horizonEnd)</p>
                        <p class="text-xs text-content-subtle mt-1">after @WeekLabel(view.WeekStarts[^1], view.WeekStarts.Count - 1)</p>
                    }
                </div>
            }
            else
            {
                <div class="rounded-xl border border-line bg-surface px-5 py-4">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Cash out, @WeeklyCashflowMaths.DefaultWeekCount weeks</p>
                    @if (view is null)
                    {
                        @LoadingFigure("Loading cash out")
                    }
                    else
                    {
                        <p class="text-2xl font-semibold text-content">@Money(VisibleTotal(view.CashOut))</p>
                        <p class="text-xs text-content-subtle mt-1">bills and manual items in the visible weeks</p>
                    }
                </div>
                <div class="rounded-xl border border-line bg-surface px-5 py-4">
                    <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Cash in, @WeeklyCashflowMaths.DefaultWeekCount weeks</p>
                    @if (view is null)
                    {
                        @LoadingFigure("Loading cash in")
                    }
                    else
                    {
                        <p class="text-2xl font-semibold text-content">@Money(VisibleTotal(view.CashIn))</p>
                        <p class="text-xs text-content-subtle mt-1">outstanding invoices due in the visible weeks</p>
                    }
                </div>
            }
        </div>

        @if (moveError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">
                @moveError
                <button type="button" class="underline underline-offset-2 ml-1" @onclick="() => moveError = null">Dismiss</button>
            </p>
        }

        @* One gate for the whole grid: every cell is arithmetic over all three sources, so it
           reveals in one piece. A failed fetch opens the gate to a message — the toast carries
           the reference and the detail. *@
        <LoadGate IsLoading="@(!GridReady)" Prominent="true" Label="Loading the weekly cashflow">
            @if (planFailed)
            {
                <p class="text-sm text-negative">Couldn't load the weekly plan. The details are in the red bar at the top — reload to try again.</p>
            }
            else if (PayablesSnapshot is { IsConfigured: false } || ReceivablesSnapshot is { IsConfigured: false })
            {
                <div class="rounded-xl border border-line bg-surface-raised px-5 py-4 text-sm text-content-muted">
                    Xero isn't connected yet. Add the custom connection's credentials as the
                    <span class="font-mono text-content">Xero__ClientId</span> and
                    <span class="font-mono text-content">Xero__ClientSecret</span> app settings on the API, then reload.
                </div>
            }
            else if (PayablesSnapshot?.Error is { } payablesError)
            {
                <div class="rounded-xl border border-line bg-surface-raised px-5 py-4 text-sm text-content-muted">
                    <p class="text-content font-medium mb-1">Xero returned an error reading the bills</p>
                    <p>@payablesError</p>
                </div>
            }
            else if (ReceivablesSnapshot?.Error is { } receivablesError)
            {
                <div class="rounded-xl border border-line bg-surface-raised px-5 py-4 text-sm text-content-muted">
                    <p class="text-content font-medium mb-1">Xero returned an error reading the invoices</p>
                    <p>@receivablesError</p>
                </div>
            }
            else if (view is not null)
            {
                @if (PayablesSnapshot!.Truncated || ReceivablesSnapshot!.Truncated)
                {
                    <div class="rounded-xl border border-line bg-surface-raised px-5 py-3 text-sm text-content-muted mb-6">
                        Xero holds more outstanding documents than the read's page cap could fetch — these totals are
                        incomplete. Raise the <span class="font-mono text-content">Xero__MaxPages</span> app setting.
                    </div>
                }

                <p class="text-xs text-content-subtle mb-3 max-w-4xl">
                    <span class="font-medium text-content-muted">No signs to decode:</span> the band carries the
                    direction — Cash in adds, Cash out subtracts. Anything overdue sits in the current week, never
                    the past. An <span class="font-medium text-content-muted">Expected</span> (invoices) or
                    <span class="font-medium text-content-muted">Planned</span> (bills) date set in Xero places the
                    entry at that week instead of its due week — set it there once and this grid follows.
                    Use ‹ › on an entry's cell to move it to the week it will really be paid — the
                    <span class="text-accent">‣</span> marks a moved entry, and ↺ returns it to its due (or
                    Xero-expected) week.
                    Moves are shared: everyone sees the same plan. <span class="font-medium text-content-muted">Group
                    suppliers</span> (toolbar) pulls chosen suppliers into one line; ⊘ on a Xero row excludes an
                    entry that's already covered elsewhere — a direct debit, say — and parks it, struck through
                    and uncounted, at the foot of its band.
                </p>

                <div class="rounded-xl border border-line bg-surface overflow-x-auto mb-6">
                    <table class="w-full text-sm border-collapse">
                        <thead class="bg-surface-raised border-b border-line">
                            <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                <th class="px-4 py-3 min-w-[260px]"></th>
                                @for (var index = 0; index < view.WeekStarts.Count; index++)
                                {
                                    <th class="px-3 py-3 text-right whitespace-nowrap">@WeekLabel(view.WeekStarts[index], index)</th>
                                }
                                <th class="px-3 py-3 text-right whitespace-nowrap border-l border-line"
                                    title="Due beyond the visible weeks. Entries here roll into view as the weeks advance.">Later</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-line">
                                <td colspan="@(view.WeekStarts.Count + 2)" class="px-4 pt-4 pb-2 text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Cash in</td>
                            </tr>
                            @BandSection((view, WeeklyCashflowBand.ClientReceipts, "Client invoices outstanding", "one line per outstanding sales invoice in Xero, at its due week — or at the Expected date when one is set in Xero"))
                            <tr class="border-b border-line">
                                <td colspan="@(view.WeekStarts.Count + 2)" class="px-4 pt-4 pb-2 text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Cash out</td>
                            </tr>
                            @BandSection((view, WeeklyCashflowBand.SupplierBills, "Supplier bills", "one line per outstanding bill in Xero — drafts included, as Aged Payables counts them; a Planned date set in Xero picks the week"))
                            @foreach (var category in WeeklyCashflowCategories.All)
                            {
                                var band = WeeklyCashflowMaths.BandFor(category);
                                if (view.Entries.Any(entry => entry.Band == band))
                                {
                                    @BandSection((view, band, WeeklyCashflowCategories.BandLabel(category), "manual items — added on this page"))
                                }
                            }
                            @* ── The running answer ── *@
                            <tr class="border-t-2 border-line border-b border-line font-semibold">
                                <td class="px-4 py-3 text-content">
                                    Net movement
                                    <span class="block text-[11px] text-content-faint font-normal">cash in less cash out, per week</span>
                                </td>
                                @for (var index = 0; index < view.WeekStarts.Count; index++)
                                {
                                    var net = view.Net[index];
                                    <td class="px-3 py-3 text-right whitespace-nowrap @(net < 0m ? "text-negative" : "text-positive")">@Signed(net)</td>
                                }
                                <td class="px-3 py-3 text-right whitespace-nowrap border-l border-line @(view.Net[^1] < 0m ? "text-negative" : "text-positive")">@Signed(view.Net[^1])</td>
                            </tr>
                            @if (IsDirector && view.Closing is not null)
                            {
                                <tr class="bg-surface-raised font-semibold">
                                    <td class="px-4 py-3 text-content">
                                        Closing bank balance
                                        <span class="block text-[11px] text-content-faint font-normal">directors only · seeded from Xero</span>
                                    </td>
                                    @for (var index = 0; index < view.WeekStarts.Count; index++)
                                    {
                                        var balance = view.Closing[index];
                                        <td class="px-3 py-3 text-right whitespace-nowrap @(balance < 0m ? "text-negative" : "text-content") @(index == view.MinClosingIndex ? "ring-2 ring-inset ring-negative rounded" : "")"
                                            title="@(index == view.MinClosingIndex ? "The low point — the week to plan for" : null)">@Money(balance)</td>
                                    }
                                    <td class="px-3 py-3 text-right border-l border-line text-content-faint font-normal"
                                        title="Later entries are beyond the horizon and not in the balance until they roll into view.">—</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-xs text-content-subtle mb-10 max-w-4xl">
                    Every figure is an outstanding Xero document or an item added on this page — nothing is
                    invented, and moving an entry changes <span class="font-medium text-content-muted">when</span>,
                    never <span class="font-medium text-content-muted">how much</span>. Excluded entries are the
                    one deliberate exception: parked, visible and uncounted, so a direct debit isn't paid twice
                    on paper. Bills tie to
                    <a class="underline underline-offset-2" href="/finance/aged-payables">Aged Payables</a>, invoices to
                    <a class="underline underline-offset-2" href="/finance/aged-receivables">Aged Receivables</a>, to the penny.
                    Xero read at @XeroFetchedText.
                </p>
            }
        </LoadGate>
    </section>

    @* ── Add / edit a manual item ── *@
    <Modal IsOpen="@itemDialogOpen"
           Title="@(editingItemId is null ? "Add item" : "Edit item")"
           OnCancel="CloseItemDialog">
        <ChildContent>
        <div class="space-y-4">
            <FormField Label="Name" Value="@formName" OnChange="value => formName = value" Required="true" />
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Category</label>
                    <select class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content"
                            value="@((int)formCategory)"
                            @onchange="args => formCategory = (WeeklyCashflowCategory)int.Parse((string)args.Value!)">
                        @foreach (var category in WeeklyCashflowCategories.All)
                        {
                            <option value="@((int)category)">@WeeklyCashflowCategories.Label(category)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Amount (£) *</label>
                    <input type="number" min="0" step="0.01" value="@formAmount"
                           @oninput="args => formAmount = (string)args.Value!"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Repeats</label>
                    <select class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content"
                            value="@((int)formRecurrence)"
                            @onchange="args => formRecurrence = (WeeklyCashflowRecurrence)int.Parse((string)args.Value!)">
                        @foreach (var recurrence in WeeklyCashflowRecurrences.All)
                        {
                            <option value="@((int)recurrence)">@WeeklyCashflowRecurrences.Label(recurrence)</option>
                        }
                    </select>
                    <p class="text-[11px] text-content-faint mt-1">
                        @(formRecurrence switch
                        {
                            WeeklyCashflowRecurrence.Weekly => "Every week on the first date's weekday.",
                            WeeklyCashflowRecurrence.Monthly => "Every month on the first date's day (shorter months clamp).",
                            _ => "A single payment."
                        })
                    </p>
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">
                        @(formRecurrence == WeeklyCashflowRecurrence.OneOff ? "Due on *" : "First due on *")
                    </label>
                    <input type="date" value="@formFirstDue"
                           @onchange="args => formFirstDue = (string)args.Value!"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content" />
                </div>
            </div>
            @if (formRecurrence != WeeklyCashflowRecurrence.OneOff)
            {
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Last payment on</label>
                    <input type="date" value="@formLastDue"
                           @onchange="args => formLastDue = (string)args.Value!"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content" />
                    <p class="text-[11px] text-content-faint mt-1">Leave empty for open-ended.</p>
                </div>
            }
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Notes</label>
                <textarea rows="2" value="@formNotes"
                          @oninput="args => formNotes = (string)args.Value!"
                          class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content"></textarea>
            </div>
            @if (dialogError is not null)
            {
                <p class="text-sm text-negative">@dialogError</p>
            }
        </div>
        </ChildContent>
        <FooterContent>
            @if (editingItemId is not null)
            {
                <button type="button" class="btn-neutral text-negative mr-auto" disabled="@isSavingItem" @onclick="ArchiveItemAsync"
                        title="Remove the item from the grid. Its history is kept.">Archive</button>
            }
            <button type="button" class="btn-neutral" disabled="@isSavingItem" @onclick="CloseItemDialog">Cancel</button>
            <button type="button" class="btn-primary" disabled="@(isSavingItem || !FormLooksComplete)" @onclick="SaveItemAsync">
                @(editingItemId is null ? "Add item" : "Save changes")
            </button>
        </FooterContent>
    </Modal>

    @* ── Supplier groups — pull chosen suppliers into one line under Supplier bills ── *@
    <Modal IsOpen="@groupsDialogOpen"
           Title="@(groupEditorOpen ? (editingGroupId is null ? "New supplier group" : "Edit supplier group") : "Supplier groups")"
           OnCancel="CloseGroupsDialog">
        <ChildContent>
        @if (!groupEditorOpen)
        {
            <div class="space-y-3">
                <p class="text-sm text-content-muted">
                    A group pulls its suppliers' bills together into ONE line under Supplier bills — e.g. a
                    <span class="text-content">Materials</span> group holding Grant &amp; Stone, HSS Hire and Skip IT.
                    Totals never change, only how the rows read; the group line expands to the bills behind it,
                    and its ‹ › move a whole cell's bills at once.
                </p>
                @if (Plan.Current is { SupplierGroups.Count: > 0 } plan)
                {
                    <ul class="divide-y divide-line rounded-lg border border-line">
                        @foreach (var group in plan.SupplierGroups)
                        {
                            <li class="flex items-center gap-3 px-3 py-2">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm text-content font-medium">@group.Name</p>
                                    <p class="text-xs text-content-faint truncate" title="@string.Join(", ", group.ContactNames)">@string.Join(", ", group.ContactNames)</p>
                                </div>
                                <button type="button" class="btn-neutral" @onclick="() => OpenGroupEditor(group.SupplierGroupId)">Edit</button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-content-faint">No groups yet.</p>
                }
            </div>
        }
        else
        {
            <div class="space-y-4">
                <FormField Label="Group name" Value="@groupFormName" OnChange="value => groupFormName = value" Required="true" />
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Suppliers in this group *</label>
                    <input type="text" placeholder="Filter suppliers…" value="@groupMemberFilter"
                           @oninput="args => groupMemberFilter = (string)args.Value!"
                           class="w-full rounded-lg border border-line-strong bg-surface-field px-3 py-2 text-sm text-content mb-2" />
                    <div class="max-h-64 overflow-y-auto rounded-lg border border-line divide-y divide-line/50">
                        @foreach (var supplierName in SupplierNameChoices())
                        {
                            if (groupMemberFilter.Trim() is { Length: > 0 } filter
                                && !supplierName.Contains(filter, StringComparison.OrdinalIgnoreCase))
                            {
                                continue;
                            }
                            var holder = GroupHolding(supplierName);
                            var name = supplierName;
                            <label class="flex items-center gap-2 px-3 py-1.5 text-sm @(holder is null ? "text-content cursor-pointer hover:bg-surface-raised" : "text-content-faint")">
                                <input type="checkbox" checked="@groupFormMembers.Contains(name)" disabled="@(holder is not null)"
                                       @onchange="() => ToggleGroupMember(name)" />
                                <span class="min-w-0 flex-1 truncate">@name</span>
                                @if (holder is not null)
                                {
                                    <span class="text-[11px] text-content-faint whitespace-nowrap">in @holder</span>
                                }
                            </label>
                        }
                    </div>
                    <p class="text-[11px] text-content-faint mt-1">
                        Every supplier with an outstanding bill, plus this group's members. A supplier lives in one group at a time.
                    </p>
                </div>
                @if (groupsDialogError is not null)
                {
                    <p class="text-sm text-negative">@groupsDialogError</p>
                }
            </div>
        }
        </ChildContent>
        <FooterContent>
        @if (!groupEditorOpen)
        {
            <button type="button" class="btn-neutral" @onclick="CloseGroupsDialog">Close</button>
            <button type="button" class="btn-primary" @onclick="() => OpenGroupEditor(null)">New group</button>
        }
        else
        {
            @if (editingGroupId is not null)
            {
                <button type="button" class="btn-neutral text-negative mr-auto" disabled="@isSavingGroup" @onclick="DeleteGroupAsync"
                        title="Dissolve the group — its bills go back to one line per supplier. Nothing else changes.">Delete group</button>
            }
            <button type="button" class="btn-neutral" disabled="@isSavingGroup" @onclick="() => groupEditorOpen = false">Back</button>
            <button type="button" class="btn-primary" disabled="@(isSavingGroup || !GroupFormLooksComplete)" @onclick="SaveGroupAsync">
                @(editingGroupId is null ? "Create group" : "Save changes")
            </button>
        }
        </FooterContent>
    </Modal>
</ApprovedSessionGate>

@code {
    private RenderFragment BandSection((WeeklyCashflowView View, WeeklyCashflowBand Band, string Label, string Sub) args) => __builder =>
    {
        var (view, band, label, sub) = args;
        var totals = BandTotals(view, band);
        var expanded = !collapsedBands.Contains(band);
        var entryCount = view.Entries.Count(entry => entry.Band == band);
        <tr class="border-b border-line">
            <td class="px-4 py-2.5">
                <button type="button" class="flex items-start gap-1.5 text-left w-full" @onclick="() => ToggleBand(band)"
                        title="@(expanded ? "Collapse to the totals row" : $"Expand to the {entryCount} entries behind these totals")">
                    <span class="text-content-subtle mt-0.5 text-xs">@(expanded ? "▾" : "▸")</span>
                    <span>
                        <span class="text-content font-medium">@label</span>
                        <span class="block text-[11px] text-content-faint font-normal">@sub</span>
                    </span>
                </button>
            </td>
            @for (var index = 0; index <= view.WeekStarts.Count; index++)
            {
                <td class="px-3 py-2.5 text-right whitespace-nowrap @(index == view.WeekStarts.Count ? "border-l border-line" : "") @(expanded ? "text-content-subtle" : "text-content")">
                    @CellAmount(totals[index])
                </td>
            }
        </tr>
        @if (expanded)
        {
            // Supplier groups pull their bills out of the flat list and into one combined row
            // each; everything ungrouped renders exactly as before. Excluded entries close the
            // band, struck through and uncounted.
            IReadOnlyList<GroupSlice> grouped = band == WeeklyCashflowBand.SupplierBills
                ? GroupSlicesFor(view)
                : Array.Empty<GroupSlice>();
            var groupedKeys = grouped.SelectMany(slice => slice.Entries)
                .Select(row => row.PlacementKey)
                .ToHashSet(StringComparer.Ordinal);
            @foreach (var slice in grouped)
            {
                @GroupSection((view, slice))
            }
            @foreach (var entry in EntriesFor(view, band).Where(row => !groupedKeys.Contains(row.PlacementKey)))
            {
                @EntryRow((view, entry, false))
            }
            @foreach (var excluded in excludedSeeds.Where(seed => seed.Band == band))
            {
                var restoring = excludingKeys.Contains(excluded.PlacementKey);
                <tr class="border-b border-line/50 text-[13px]">
                    <td class="pl-9 pr-4 py-1.5">
                        <span class="text-content-faint line-through">@excluded.Label</span>
                        <span class="block text-[11px] text-content-faint">
                            @excluded.Detail · excluded — not counted@(ExcludedByFor(excluded.PlacementKey) is { } who ? $" · {who}" : "")
                        </span>
                    </td>
                    <td colspan="@(view.WeekStarts.Count + 1)" class="px-3 py-1.5 text-right whitespace-nowrap text-content-faint">
                        <span class="line-through mr-2">@CellAmount(excluded.Amount)</span>
                        <button type="button" class="text-content-subtle hover:text-content underline underline-offset-2 disabled:opacity-30"
                                title="Count this entry in the plan again" disabled="@restoring"
                                @onclick="() => SetExclusionAsync(excluded.PlacementKey, false)">Count again</button>
                    </td>
                </tr>
            }
        }
    };
    private RenderFragment GroupSection((WeeklyCashflowView View, GroupSlice Slice) args) => __builder =>
    {
        var (view, slice) = args;
        var open = expandedGroups.Contains(slice.Group.SupplierGroupId);
        <tr class="border-b border-line/50 text-[13px] bg-surface-raised/40">
            <td class="pl-9 pr-4 py-1.5">
                <button type="button" class="flex items-start gap-1.5 text-left w-full" @onclick="() => ToggleGroup(slice.Group.SupplierGroupId)"
                        title="@(open ? "Collapse to the group line" : $"Show the {slice.Entries.Count} bills behind this line")">
                    <span class="text-content-subtle mt-0.5 text-[10px]">@(open ? "▾" : "▸")</span>
                    <span>
                        <span class="text-content font-medium">@slice.Group.Name</span>
                        <span class="block text-[11px] text-content-faint font-normal">supplier group · @slice.Entries.Count @(slice.Entries.Count == 1 ? "bill" : "bills") · ‹ › moves the whole cell</span>
                    </span>
                </button>
            </td>
            @for (var index = 0; index <= view.WeekStarts.Count; index++)
            {
                var cellIndex = index;
                var members = slice.Entries.Where(row => row.WeekIndex == cellIndex).ToList();
                <td class="px-1 py-1.5 text-right whitespace-nowrap @(cellIndex == view.WeekStarts.Count ? "border-l border-line" : "")">
                    @if (members.Count > 0)
                    {
                        var busy = movingGroupIds.Contains(slice.Group.SupplierGroupId) || members.Any(row => movingKeys.Contains(row.PlacementKey));
                        var anyMoved = members.Any(row => row.Moved);
                        <span class="inline-flex items-center gap-0.5">
                            @if (anyMoved)
                            {
                                <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                        title="Send this cell's moved bills back to their due weeks" disabled="@busy"
                                        @onclick="() => ResetGroupCellAsync(slice, cellIndex)">↺</button>
                            }
                            <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                    title="Pay this cell's bills a week earlier" disabled="@(busy || cellIndex == 0)"
                                    @onclick="() => MoveGroupCellAsync(slice, cellIndex, Math.Min(cellIndex, view.WeekStarts.Count) - 1)">‹</button>
                            <span class="@(anyMoved ? "text-accent font-medium" : "text-content")">@(anyMoved ? "‣ " : "")@CellAmount(members.Sum(row => row.Amount))</span>
                            <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                    title="Pay this cell's bills a week later" disabled="@(busy || cellIndex >= view.WeekStarts.Count - 1)"
                                    @onclick="() => MoveGroupCellAsync(slice, cellIndex, cellIndex + 1)">›</button>
                        </span>
                    }
                </td>
            }
        </tr>
        @if (open)
        {
            @foreach (var entry in slice.Entries)
            {
                @EntryRow((view, entry, true))
            }
        }
    };
    private RenderFragment EntryRow((WeeklyCashflowView View, WeeklyCashflowEntry Entry, bool InGroup) args) => __builder =>
    {
        var (view, entry, inGroup) = args;
        <tr class="border-b border-line/50 text-[13px]">
            <td class="@(inGroup ? "pl-14" : "pl-9") pr-4 py-1.5">
                @if (entry.ItemId is { } itemId)
                {
                    <button type="button" class="text-content-muted hover:text-content underline-offset-2 hover:underline text-left"
                            title="Edit this item" @onclick="() => OpenEditDialog(itemId)">@entry.Label</button>
                }
                else
                {
                    <span class="text-content-muted">@entry.Label</span>
                    <button type="button" class="ml-1.5 text-[11px] text-content-faint hover:text-negative align-middle disabled:opacity-30"
                            title="Don't count this entry — a direct debit or manual item already covers it. It parks, struck through, at the foot of this band."
                            disabled="@excludingKeys.Contains(entry.PlacementKey)"
                            @onclick="() => SetExclusionAsync(entry.PlacementKey, true)">⊘</button>
                }
                <span class="block text-[11px] text-content-faint">
                    @entry.Detail@(entry.NaturalDueOn is { } due ? $" · due {due.UtcDateTime:d MMM}" : " · no due date")@(entry.ExpectedOn is { } expected ? $" · expected {expected.UtcDateTime:d MMM}" : "")
                </span>
            </td>
            @for (var index = 0; index <= view.WeekStarts.Count; index++)
            {
                var cellIndex = index;
                <td class="px-1 py-1.5 text-right whitespace-nowrap @(cellIndex == view.WeekStarts.Count ? "border-l border-line" : "")">
                    @if (entry.WeekIndex == cellIndex)
                    {
                        var busy = movingKeys.Contains(entry.PlacementKey);
                        <span class="inline-flex items-center gap-0.5">
                            @if (entry.Moved)
                            {
                                <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                        title="@(entry.ExpectedOn is null ? "Back to its due week" : "Back to its Xero expected week")" disabled="@busy"
                                        @onclick="() => ResetEntryAsync(entry)">↺</button>
                            }
                            <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                    title="Pay a week earlier" disabled="@(busy || cellIndex == 0)"
                                    @onclick="() => MoveEntryAsync(entry, Math.Min(cellIndex, view.WeekStarts.Count) - 1)">‹</button>
                            <span class="@(entry.Moved ? "text-accent font-medium" : "text-content")"
                                  title="@(entry.Moved ? "Moved here — the " + (entry.ExpectedOn is null ? "due" : "Xero expected") + " week is " + (entry.NaturalOn is { } naturalOn ? naturalOn.UtcDateTime.ToString("d MMM") : "unknown") : null)">@(entry.Moved ? "‣ " : "")@CellAmount(entry.Amount)</span>
                            <button type="button" class="w-5 h-5 inline-flex items-center justify-center rounded text-content-subtle hover:text-content hover:bg-surface-raised disabled:opacity-30"
                                    title="Pay a week later" disabled="@(busy || cellIndex >= view.WeekStarts.Count - 1)"
                                    @onclick="() => MoveEntryAsync(entry, cellIndex + 1)">›</button>
                        </span>
                    }
                </td>
            }
        </tr>
    };
    private static RenderFragment LoadingFigure(string label) => __builder =>
    {
        <p class="text-2xl font-semibold text-content flex items-center h-8" role="status" aria-live="polite" aria-busy="true">
            <JewelIcon Class="w-4 h-4 animate-jewel-pulse" />
            <span class="sr-only">@label</span>
        </p>
    };
}
