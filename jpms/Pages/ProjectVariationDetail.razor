@page "/projects/{ProjectId}/variations/{VariationOrderId}"
@* The old /voq/ route is kept so links already sent out — in mail, to-dos and bookmarks —
   still land here. Blazor matches both to this page; nothing else needs a redirect. *@
@page "/projects/{ProjectId}/voq/{VariationOrderId}"
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Contracts.Variations
@using Jewel.JPMS.Features.RecordLinks
@inject AuthService Auth
@inject SessionService Session
@inject IVariationStore Variations
@inject IArchitectInstructionStore Instructions
@inject ISubcontractorStore Subcontractors
@inject IRequestRegister RequestRegister
@inject RecordActivityReadModel Activity
@inject IQueryClient Queries
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IValuationReportStore Valuation
@implements IDisposable

<PageTitle>Variation · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!orderLoaded)
{
    @* Tab chrome first, the record when it lands — "could not be found" must never flash over a
       fetch that is still running. *@
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading variation" />
    </ProjectPageShell>
}
else if (order is null)
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        @* A failed fetch and a missing record both leave `order` null — say which. *@
        <p class="text-sm text-content-subtle italic">@(error ?? "That variation order could not be found.")</p>
    </ProjectPageShell>
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="requests">
        @* Portal-accepted variation orders (subcontractor variation requests) have no originating request. *@
        @if (!string.IsNullOrWhiteSpace(order.RequestId))
        {
            <a href="@RequestHref" class="text-sm text-content-muted hover:text-content inline-flex items-center gap-1 mb-4">
                &larr; Originating request
            </a>
        }
        else
        {
            <a href="@($"/projects/{ProjectId}/requests/variations")" class="text-sm text-content-muted hover:text-content inline-flex items-center gap-1 mb-4">
                &larr; Variations
            </a>
        }

        <div class="flex flex-wrap items-center gap-3 mb-1">
            <span class="font-mono text-sm font-semibold text-content">@order.DisplayNumber</span>
            @if (CanManage && order.Status != VariationOrderStatus.Rejected)
            {
                @* The status pill doubles as the status control. Direct moves cover the
                   side-effect-free stages (Quoting, Issued, Awaiting AI); the commercial transitions route to
                   their real flows — Approved opens the approve panel (cost code + value), Rejected
                   from Approved reverses the approval's writes, and leaving Approved for Quoting is
                   the "return to quoting" repair. Rejected is terminal — no menu once reached. *@
                <div class="relative">
                    <button type="button"
                            class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium bg-surface-raised text-content-muted"
                            title="Change status"
                            disabled="@busy"
                            @onclick="() => orderStatusMenuOpen = !orderStatusMenuOpen">
                        @order.Status.DisplayName() <span class="text-[9px]" aria-hidden="true">▾</span>
                    </button>
                    @if (orderStatusMenuOpen)
                    {
                        <div class="absolute left-0 mt-2 w-64 rounded-lg border border-line bg-surface shadow-lg z-20 overflow-hidden">
                            <ul class="divide-y divide-line">
                                @foreach (var option in OrderStatusOptions)
                                {
                                    var status = option;
                                    var isCurrent = status == order.Status;
                                    var blocked = order.Status == VariationOrderStatus.Approved && status == VariationOrderStatus.Issued;
                                    var selectable = !isCurrent && !blocked;
                                    <li>
                                        <button type="button"
                                                class="w-full text-left px-3 py-2 text-sm transition @(selectable ? "text-content hover:bg-surface-raised" : "text-content-subtle cursor-default")"
                                                disabled="@(busy || !selectable)"
                                                title="@PillOptionTitle(status)"
                                                @onclick="() => ChangeStatus(status)">
                                            @PillOptionLabel(status)@(isCurrent ? " ✓" : "")
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
            else
            {
                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-medium bg-surface-raised text-content-muted">@order.Status.DisplayName()</span>
            }
        </div>
        @* ---- Title, editable in place ------------------------------------------------------
               Retitling is allowed at EVERY stage, approved ones included: a badly worded title is
               worth fixing whenever it is spotted, and it is the number — not the wording — that the
               client's paperwork is keyed to. What has already been claimed keeps the wording it was
               issued with (the handler rewrites nothing downstream), which is exactly what the note
               under the field promises on an approved record. *@
        @if (renamingOrder)
        {
            <div class="mb-5 max-w-2xl space-y-2">
                <FormField Label="Title" Value="@renameTitle" OnChange="v => renameTitle = v" Required="true" />
                @if (order.Status == VariationOrderStatus.Approved)
                {
                    <p class="text-xs text-content-subtle">
                        Valuation lines and CVR entries already written for
                        <span class="font-mono">@order.VariationRef</span> keep the title they were issued with —
                        this record and anything written from here on read the new one.
                    </p>
                }
                <div class="flex gap-2">
                    <button type="button" class="btn-primary" disabled="@busy" @onclick="SaveTitle">Save title</button>
                    <button type="button" class="btn-secondary" disabled="@busy" @onclick="CancelRename">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="flex items-start gap-2 mb-5">
                <h2 class="text-xl font-semibold text-content">@order.Title</h2>
                @if (CanManage)
                {
                    <button type="button" class="btn-ghost text-xs px-2 py-1 shrink-0 mt-0.5"
                            title="Edit the title" disabled="@busy" @onclick="StartRename">Edit</button>
                }
            </div>
        }

        @* The same tab bar as the request page: the chain's documents as tabs, this record active.
           The Request / RFI tabs land back on the containing request page (the RFI tab straight
           onto its official pane). *@
        <RecordTabBar ProjectId="@ProjectId" ActiveId="variation"
                      Request="request" Variation="order" BidPackages="packages"
                      ActivityFor="TabActivity" />

        @if (error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@error</p>
        }

        @* A variation at Awaiting AI is, by definition, waiting for a document — so say whether it
           has arrived, right here, rather than making someone go and look. Once instructions are
           linked they stay on show at every stage: they are the evidence behind the figures. *@
        @if (linkedInstructions.Count > 0)
        {
            <div class="rounded-lg bg-surface-raised border border-line px-3 py-2 mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Architect's Instruction</span>
                @foreach (var instruction in linkedInstructions)
                {
                    <a href="@($"/projects/{ProjectId}/architect-instructions")"
                       title="@instruction.Title"
                       class="text-sm text-content hover:underline font-mono">@instruction.DisplayReference</a>
                }
                <span class="text-xs text-content-subtle">
                    @(linkedInstructions.Any(instruction => instruction.HasFile)
                        ? "· document on file"
                        : "· document still awaited")
                </span>
            </div>
        }
        else if (order.Status == VariationOrderStatus.AwaitingArchitectInstruction)
        {
            @* "None is linked yet" is the one thing this page must not say before it has looked. *@
            <LoadGate IsLoading="@(!instructionsLoaded)" Label="Loading instructions">
            <div class="rounded-lg bg-surface-raised border border-line px-3 py-2 mb-4 text-sm text-content-subtle">
                Waiting on a formal Architect's Instruction. None is linked yet —
                <a href="@($"/projects/{ProjectId}/architect-instructions")" class="text-accent hover:underline">file or link one</a>
                when it arrives, then approve the variation to write the contract figures.
            </div>
            </LoadGate>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <div class="lg:col-span-2 space-y-5">
                @if (ApprovedOrder is not null && VariationLines.Count > 0)
                {
                    <div class="panel p-5">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="eyebrow">Variation lines</h3>
                            <span class="text-xs text-content-subtle">On the Valuation Report as <span class="font-mono">@ApprovedOrder!.VariationRef</span></span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="text-left text-content-subtle border-b border-line">
                                        <th class="py-2 pr-3 font-medium">Cost centre</th>
                                        <th class="py-2 pr-3 font-medium">Description</th>
                                        <th class="py-2 pr-3 font-medium text-right">Qty</th>
                                        <th class="py-2 pr-3 font-medium text-right">Rate £</th>
                                        <th class="py-2 font-medium text-right">Amount £</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-line">
                                    @foreach (var vline in VariationLines)
                                    {
                                        <tr>
                                            <td class="py-2 pr-3 font-mono text-xs whitespace-nowrap">@vline.CostCode</td>
                                            <td class="py-2 pr-3">@vline.Description</td>
                                            <td class="py-2 pr-3 text-right font-mono">@vline.Quantity.ToString("0.##", Gb)</td>
                                            <td class="py-2 pr-3 text-right font-mono">@vline.Rate.ToString("N2", Gb)</td>
                                            <td class="py-2 text-right font-mono @(vline.LineAmount < 0m ? "text-negative" : "")">@vline.LineAmount.ToString("N2", Gb)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="border-t border-line-strong font-semibold text-content">
                                        <td class="py-2 pr-3" colspan="4">Total</td>
                                        @* whitespace-nowrap: a negative total must never wrap its minus sign onto
                                           its own line and read as positive. *@
                                        <td class="py-2 text-right font-mono whitespace-nowrap @(VariationLines.Sum(vline => vline.LineAmount) < 0m ? "text-negative" : "")">@MoneyPennies(VariationLines.Sum(vline => vline.LineAmount))</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                <div class="panel p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="eyebrow">Bid packages</h3>
                        @if (CanManage)
                        {
                            <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => addingPackage = true">Add bid package</button>
                        }
                    </div>

                    @if (packages.Count == 0)
                    {
                        <p class="text-sm text-content-subtle italic">No bid packages yet. Add one to invite subcontractors to tender.</p>
                    }
                    else
                    {
                        <ul class="divide-y divide-line">
                            @foreach (var package in packages)
                            {
                                <li class="py-2 flex items-center justify-between gap-3">
                                    <div>
                                        <a href="@PackageHref(package.BidPackageId)" class="text-sm font-medium text-content hover:underline">@package.Title</a>
                                        <span class="text-xs text-content-subtle ml-2">@package.Trade</span>
                                        @if (order.SelectedBidPackageId == package.BidPackageId)
                                        {
                                            <span class="ml-2 inline-flex items-center rounded bg-amber-500/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-600">Selected</span>
                                        }
                                    </div>
                                    <a href="@PackageHref(package.BidPackageId)" class="text-xs text-content-muted hover:text-content">Open →</a>
                                </li>
                            }
                        </ul>
                    }

                    @if (addingPackage)
                    {
                        <div class="mt-4 pt-4 border-t border-line space-y-3">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <FormField Label="Package title" Value="@newTitle" OnChange="v => newTitle = v" Required="true" />
                                <FormField Label="Trade" Value="@newTrade" OnChange="v => newTrade = v" Required="true" />
                            </div>
                            <div class="flex gap-2">
                                <button type="button" class="btn-primary" disabled="@busy" @onclick="AddPackage">Create package</button>
                                <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => addingPackage = false">Cancel</button>
                            </div>
                        </div>
                    }
                </div>

                @* ---- Originating request: repair the missing link on the record itself ----
                       Seeded (historic) variations predate the request link, so the lineage
                       bar shows "No request". This is where the missing RFI/request gets attached
                       — one deliberate pick on the record, not squeezed into the register. *@
                @if (string.IsNullOrWhiteSpace(order.RequestId))
                {
                    <div class="panel p-5">
                        <h3 class="eyebrow mb-2">Originating request</h3>
                        @if (CanManage)
                        {
                            <p class="text-sm text-content-muted mb-3">
                                This variation isn't linked to the request (RFI) it was raised from — its history
                                can't be traced yet. Pick the right one to complete the chain; the lineage bar
                                above fills in as soon as it's linked.
                            </p>
                            <div class="flex flex-wrap items-center gap-2">
                                <SearchSelect Options="@LinkCandidateOptions"
                                              Value="@linkTargetRequestId"
                                              ValueChanged="v => linkTargetRequestId = v"
                                              Placeholder="Choose a request…"
                                              WidthClass="w-full sm:w-96"
                                              InputClass="bg-surface border border-line px-3 py-2"
                                              Disabled="@linkBusy" />
                                <button type="button" class="btn-primary"
                                        disabled="@(linkBusy || string.IsNullOrWhiteSpace(linkTargetRequestId))"
                                        @onclick="LinkToRequest">
                                    @(linkBusy ? "Linking…" : "Link request")
                                </button>
                            </div>
                            @if (linkError is not null)
                            {
                                <p class="text-xs text-negative mt-2">@linkError</p>
                            }
                            <p class="text-xs text-content-subtle mt-3">
                                RFIs are listed first — the stage a variation order is normally raised from. Requests
                                already carrying a variation order aren't offered (a request has at most one).
                            </p>
                        }
                        else
                        {
                            <p class="text-sm text-content-subtle italic">
                                This variation isn't linked to an originating request. A project manager or QS can
                                attach the right RFI here.
                            </p>
                        }
                    </div>
                }

                @* ---- Communications: the mail behind this record, read live by tag ----
                       Emails tagged to the record's quoting reference or (once approved) its V-ref
                       in mailbox triage appear here, so the correspondence behind the variation is
                       visible where the record lives — not only on the project's Communications tab. *@
                <div class="panel p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="eyebrow">Communications</h3>
                        @if (emailsLoaded && emails.Count > 0)
                        {
                            <span class="inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@emails.Count</span>
                        }
                    </div>

                    @if (emailsError is not null)
                    {
                        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@emailsError</p>
                    }

                    <LoadGate IsLoading="@(!emailsLoaded)" Prominent="true" Label="Loading emails">
                    @if (emails.Count == 0)
                    {
                        @* Only when the mailbox actually answered "none" — a failure says so above. *@
                        @if (emailsError is null)
                        {
                        <p class="text-sm text-content-subtle italic">
                            No emails are tagged to this variation yet. Tag an email to
                            <span class="font-medium not-italic text-content">@order.Reference</span>@(ApprovedOrder is not null ? $" or {order.VariationRef}" : "")
                            in mailbox triage and it appears here.
                        </p>
                        }
                    }
                    else
                    {
                        <ul class="space-y-2">
                            @foreach (var email in emails)
                            {
                                <li class="rounded-lg border border-line bg-surface px-4 py-3">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <span class="text-sm font-medium text-content">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                                        <span class="text-xs text-content-subtle">@email.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</span>
                                    </div>
                                    <p class="text-sm text-content mt-0.5">
                                        @email.Subject
                                        @if (email.HasAttachments)
                                        {
                                            <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(email.BodyPreview))
                                    {
                                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@email.BodyPreview</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    </LoadGate>
                </div>
            </div>

            <div class="space-y-5">
                <div class="panel p-5 space-y-3 text-sm">
                    @* One panel, one arrival: the selected sub's name comes from the subcontractor
                       directory, so the rows wait for it rather than showing a raw id first. *@
                    <LoadGate IsLoading="@(!Subcontractors.IsLoaded)" Label="Loading details">
                    <div class="flex justify-between"><span class="text-content-subtle">Reference</span><span class="font-mono">@order.Reference</span></div>
                    <div class="flex justify-between"><span class="text-content-subtle">Status</span><span>@order.Status.DisplayName()</span></div>
                    <div class="flex justify-between"><span class="text-content-subtle">Estimated value</span><span>@(order.EstimatedValue is null ? "—" : Money(order.EstimatedValue.Value))</span></div>
                    <div class="flex justify-between"><span class="text-content-subtle">Selected sub</span><span>@SelectedSubName()</span></div>
                    @* Issued is the official date the client was notified (stamped when the status
                       enters Issued); Created is the system's own stamp for when the record was
                       raised. Both shown here — the register lists lead with Issued. *@
                    <div class="flex justify-between"><span class="text-content-subtle">Issued</span><span>@(order.IssuedAt is null ? "—" : order.IssuedAt.Value.LocalDateTime.ToString("d MMM yyyy"))</span></div>
                    @if (order.ApprovedAt is not null)
                    {
                        <div class="flex justify-between"><span class="text-content-subtle">Approved</span><span>@order.ApprovedAt.Value.LocalDateTime.ToString("d MMM yyyy")</span></div>
                    }
                    @if (order.RejectedAt is not null)
                    {
                        <div class="flex justify-between"><span class="text-content-subtle">Rejected</span><span>@order.RejectedAt.Value.LocalDateTime.ToString("d MMM yyyy")</span></div>
                    }
                    <div class="flex justify-between"><span class="text-content-subtle">Created</span><span>@order.CreatedAt.LocalDateTime.ToString("d MMM yyyy")</span></div>
                    </LoadGate>
                </div>

                @if (ApprovedOrder is not null)
                {
                    var approved = ApprovedOrder!;
                    @* The approved-state section of this one record — not a second document.
                       The id anchors the pill's Reject / Return-to-quoting routes, which scroll here
                       and flash the panel (jpmsFocusElement) so the click lands visibly. *@
                    <div id="variation-order" class="panel p-5 space-y-3">
                        <h3 class="eyebrow">Approved figures</h3>
                        <div class="text-sm text-content flex items-center">
                            <span class="font-mono font-semibold">@(approved.VariationRef ?? approved.DisplayNumber)</span>
                        </div>
                        <div class="flex justify-between text-sm"><span class="text-content-subtle">Value</span><span>@Money(approved.Value)</span></div>
                        @* The cost-centre split is read off the valuation report's lines, so it waits
                           for them: one centre that quietly becomes three is the same lie as a £0. *@
                        <LoadGate IsLoading="@(!ValuationLinesReady)" Label="Loading cost centres">
                        @{ var centres = ApprovedCostCentres; }
                        <div class="flex justify-between text-sm gap-3">
                            <span class="text-content-subtle whitespace-nowrap">Cost @(centres.Count > 1 ? "centres" : "centre")</span>
                            <span class="font-mono text-right">@(centres.Count == 0 ? "—" : string.Join(", ", centres))</span>
                        </div>
                        @if (VariationLines.Count > 1)
                        {
                            <p class="text-xs text-content-subtle">@VariationLines.Count lines across @centres.Count cost centres — the full build-up is under “Variation lines” on the left.</p>
                        }
                        else
                        {
                            <p class="text-xs text-content-subtle">Added to the Valuation Report and committed to the cost centre.</p>
                        }
                        </LoadGate>
                        @if (CanManage)
                        {
                            <button type="button" class="btn-secondary w-full" disabled="@busy" @onclick="IssueWorkOrder">Issue work order</button>
                        }
                        @if (CanManage)
                        {
                            @* Add / edit / remove the priced lines without un-approving — the report,
                               CVR and per-centre budgets move by the difference. *@
                            @* Held shut until the report lines are in: the dialog seeds itself from
                               them, so opening it early would offer an empty build-up and saving
                               that would read as "the user deleted every line". *@
                            <button type="button" class="btn-secondary w-full"
                                    disabled="@(busy || !ValuationLinesReady)" @onclick="OpenEditLines">Edit lines</button>
                        }
                        @* Same reason as Edit lines: before the report lines land, "one line" is
                           indistinguishable from "none loaded yet", and revising against none would
                           move the CVR and the budget with no line to show for it. *@
                        @if (CanManage && ValuationLinesReady && VariationLines.Count <= 1)
                        {
                            @if (!revisingValue)
                            {
                                <button type="button" class="btn-secondary w-full" disabled="@busy" @onclick="StartReviseValue">Revise value</button>
                            }
                            else
                            {
                                <div class="pt-3 border-t border-line space-y-3">
                                    <FormField Label="Revised value (£)" Value="@reviseValue" OnChange="v => reviseValue = v" InputType="number" Required="true" />
                                    <p class="text-xs text-content-subtle">
                                        Re-prices the @(approved.VariationRef ?? approved.DisplayNumber) line on the Valuation Report, records the
                                        difference on the CVR and moves the committed cost-centre budget.
                                    </p>
                                    <div class="flex gap-2">
                                        <button type="button" class="btn-primary" disabled="@busy" @onclick="ReviseVoValue">Save revised value</button>
                                        <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => revisingValue = false">Cancel</button>
                                    </div>
                                </div>
                            }
                        }
                        @if (CanManage)
                        {
                            <div class="pt-3 border-t border-line space-y-2">
                                @if (!returningToQuoting)
                                {
                                    <button type="button" class="w-full text-xs text-content-subtle hover:text-negative underline underline-offset-2"
                                            disabled="@busy" @onclick="() => returningToQuoting = true">
                                        Approved in error? Return to quoting…
                                    </button>
                                }
                                else
                                {
                                    <p class="text-xs text-content-subtle">
                                        Un-approves this variation: <span class="font-mono">@(approved.VariationRef ?? approved.DisplayNumber)</span> is removed
                                        (its number is freed for a future approval), its value comes off the Valuation Report,
                                        CVR and cost-centre budget, and @order.Reference returns to <span class="font-medium text-content">Quoting</span>.
                                        For approvals that shouldn't have happened — a real rejection should use Reject so
                                        the record stays on the register. Blocked once work orders instruct it or value has been claimed.
                                    </p>
                                    <div class="flex gap-2">
                                        <button type="button" class="btn-secondary w-full text-negative" disabled="@busy" @onclick="ReturnToQuoting">
                                            @(busy ? "Returning…" : "Confirm — return to quoting")
                                        </button>
                                        <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => returningToQuoting = false">Keep</button>
                                    </div>
                                }
                            </div>
                        }
                        @if (CanManage && rejectingOrder)
                        {
                            <div class="pt-3 border-t border-line space-y-2">
                                <p class="text-xs text-content-subtle">
                                    Rejecting <span class="font-mono">@(approved.VariationRef ?? approved.DisplayNumber)</span> is a real commercial
                                    event: the order stays on the register as Rejected, its line comes off the
                                    Valuation Report, an offsetting omit is recorded on the CVR and the committed
                                    cost-centre budget is released. If the approval itself was a data error, use
                                    Return to quoting instead so the V-ref is freed.
                                </p>
                                <div class="flex gap-2">
                                    <button type="button" class="btn-secondary w-full text-negative" disabled="@busy" @onclick="RejectOrder">
                                        @(busy ? "Rejecting…" : "Confirm — reject variation order")
                                    </button>
                                    <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => rejectingOrder = false">Keep</button>
                                </div>
                            </div>
                        }
                    </div>

                    <Modal IsOpen="editLinesModalOpen"
                           Title="@($"Edit lines — {order.Reference}")"
                           ShowFooter="false"
                           OnCancel="@(() => { editLinesModalOpen = false; editLinesError = null; })"
                           Class="max-w-3xl">
                        <VariationApprovePanel ShowHeading="false"
                                               InitialLines="@CurrentLineInputs"
                                               SubmitLabel="Save lines"
                                               HelpOverride="Editing re-prices these lines on the Valuation Report and moves the CVR and cost-centre budgets by the difference. Nothing else changes."
                                               Busy="@busy"
                                               SubmitError="@editLinesError"
                                               OnApprove="SaveLinesEdit" />
                    </Modal>
                }
                else if (CanManage && order.Status is VariationOrderStatus.Quoting or VariationOrderStatus.Issued or VariationOrderStatus.AwaitingArchitectInstruction)
                {
                    @* Approval runs from either pre-approved status. With a selected tender this is
                       the normal end of the pipeline; without one it is a MANUAL approval — the
                       route for historic (seeded) and client-instructed variations that never
                       tendered through the app. The write-through (Valuation Report, CVR,
                       cost-centre budgets) is identical either way. The build-up itself is captured
                       in a modal (VariationApprovePanel) — the sidebar is too narrow for the line table. *@
                    var isManualApproval = string.IsNullOrEmpty(order.SelectedBidPackageId);
                    <div class="panel p-5 space-y-3">
                        <h3 class="eyebrow">@(isManualApproval ? "Approve manually & raise Variation Order" : "Approve & raise Variation Order")</h3>
                        <p class="text-xs text-content-subtle">
                            Build the variation up from priced lines — one per cost centre — then approve. Each line writes onto
                            the Valuation Report and commits its own cost centre's budget.
                        </p>
                        <button type="button" class="btn-primary w-full" disabled="@busy" @onclick="() => approveModalOpen = true">
                            @(isManualApproval ? "Approve manually & raise VO…" : "Approve & raise VO…")
                        </button>
                    </div>

                    <Modal IsOpen="approveModalOpen"
                           Title="@($"Approve {order.Reference} — {order.Title}")"
                           ShowFooter="false"
                           OnCancel="@(() => approveModalOpen = false)"
                           Class="max-w-3xl">
                        <VariationApprovePanel IsManual="@isManualApproval"
                                               ShowHeading="false"
                                               EstimatedValue="order.EstimatedValue"
                                               DefaultDescription="@order.Title"
                                               Busy="@busy"
                                               OnApprove="ApproveWithLines" />
                    </Modal>
                }

                @if (CanManage && packages.Count > 0 && ApprovedOrder is null)
                {
                    <div class="panel p-5 space-y-3">
                        <h3 class="eyebrow">Select winning tender</h3>
                        <div>
                            <label class="eyebrow block mb-1">Bid package</label>
                            <select class="field" value="@selBidPackageId" @onchange="OnBidPackageChanged">
                                <option value="">— Choose —</option>
                                @foreach (var package in packages)
                                {
                                    <option value="@package.BidPackageId">@package.Title</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="eyebrow block mb-1">Subcontractor</label>
                            <select class="field" value="@selSubId" @onchange="OnSubChanged">
                                <option value="">— Choose —</option>
                                @foreach (var sub in Subs)
                                {
                                    <option value="@sub.SubcontractorId">@sub.CompanyName</option>
                                }
                            </select>
                        </div>
                        <FormField Label="Agreed value (£)" Value="@selValue" OnChange="v => selValue = v" InputType="number" />
                        <button type="button" class="btn-primary w-full" disabled="@busy" @onclick="SelectTender">Record selection</button>
                    </div>
                }

                @if (CanManage && ApprovedOrder is null)
                {
                    <div class="panel p-5">
                        @if (!deletingOrder)
                        {
                            <button type="button" class="w-full text-xs text-content-subtle hover:text-negative underline underline-offset-2"
                                    disabled="@busy" @onclick="() => deletingOrder = true">
                                Wrong variation? Delete it…
                            </button>
                        }
                        else
                        {
                            <p class="text-xs text-content-subtle mb-2">
                                Permanently deletes <span class="font-mono">@order.Reference</span> and any bid packages raised under it.
                                Nothing is on the Valuation Report yet, so no commercial records change — but this can't be undone.
                            </p>
                            <div class="flex gap-2">
                                <button type="button" class="btn-secondary w-full text-negative" disabled="@busy" @onclick="DeleteOrder">
                                    @(busy ? "Deleting…" : "Confirm — delete variation")
                                </button>
                                <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => deletingOrder = false">Keep</button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Declining a variation the client never approved is a plain status move — nothing comes
           off the Valuation Report, no omit is recorded, no budget is released — but it IS terminal:
           Rejected has no way back, so the pill disappears once it is reached. That deserves a
           deliberate confirm rather than a one-click move, which is what this modal is. The
           post-approval reject keeps its own inline panel, because it reverses real commercial
           writes and needs to say so next to the figures it will change. *@
        <Modal IsOpen="decliningOrder"
               Title="@($"Decline {order.DisplayNumber}?")"
               ConfirmLabel="@(busy ? "Declining…" : "Decline variation")"
               CancelLabel="Keep it open"
               ConfirmDisabled="@busy"
               OnCancel="() => decliningOrder = false"
               OnConfirm="RejectOrder"
               Class="max-w-md">
            <div class="space-y-3">
                @if (error is not null)
                {
                    <div class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@error</div>
                }
                <p class="text-sm text-content">
                    <span class="font-mono">@order.DisplayNumber</span> — @order.Title
                </p>
                <p class="text-sm text-content-subtle">
                    Closes the variation as <span class="text-content font-medium">Rejected</span>: the client
                    declined it, or it has been withdrawn. It stays on the register for the record, but nothing
                    commercial is written — no line reaches the Valuation Report and no budget is committed.
                </p>
                <p class="text-xs text-content-subtle">
                    Rejected is the end of the road for this variation — it can't be reopened. If the work is
                    still live, leave it where it is instead.
                </p>
            </div>
        </Modal>
    </ProjectPageShell>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string VariationOrderId { get; set; } = "";

    // Session checked and the user is signed in — not "the record is here". The tab chrome shows
    // straight away; the record and each panel's own sources arrive behind their gates.
    private bool sessionReady;
    // The record's fetch has answered, one way or the other. Distinct from `order is not null`,
    // which is also how "no such variation" looks.
    private bool orderLoaded;
    private bool busy;
    private string? error;
    private VariationOrder? order;
    private IReadOnlyList<BidPackage> packages = Array.Empty<BidPackage>();
    private Request? request; // originating request, for the lineage bar


    private bool revisingValue;
    private string reviseValue = "";

    // ---- Retitle -------------------------------------------------------------------------------
    // Editing the title in place, at any stage. Held apart from the approve/revise flows on purpose:
    // this moves the wording and nothing else, so it can never be the thing that quietly shifted a
    // figure. Cancelling simply drops the draft — the record is untouched until Save.
    private bool renamingOrder;
    private string renameTitle = "";

    // The Architect's Instructions that cover this variation — the evidence behind its figures, and
    // the thing an Awaiting-AI variation is waiting for.
    private List<ArchitectInstruction> linkedInstructions = new();
    private bool instructionsLoaded;

    private bool returningToQuoting;
    private bool rejectingOrder;   // post-approval reject (reverses commercial writes) — inline panel
    private bool decliningOrder;   // pre-approval decline (plain status move) — confirm modal
    private bool deletingOrder;
    private bool editLinesModalOpen;

    // The approved variation's current lines, shaped for the edit panel to seed its rows.
    // Each row carries the report line it came from, so a save says "re-price this line" rather
    // than "delete them all and add these" — that is what keeps a claimed line's history attached.
    private IReadOnlyList<VariationLineInput> CurrentLineInputs =>
        VariationLines
            .Select(line => new VariationLineInput(
                line.CostCode, line.Description, line.Quantity, line.Rate, line.ValuationLineItemId))
            .ToList();

    // Status pill dropdown — same dismiss pattern as the request page's Actions dropdown: every
    // item closes it before running, the toggle is the dismiss.
    private bool orderStatusMenuOpen;

    private static readonly VariationOrderStatus[] OrderStatusOptions =
    {
        VariationOrderStatus.Quoting, VariationOrderStatus.Issued,
        VariationOrderStatus.AwaitingArchitectInstruction,
        VariationOrderStatus.Approved, VariationOrderStatus.Rejected
    };

    private bool addingPackage;
    private string newTitle = "";
    private string newTrade = "";

    private string selBidPackageId = "";
    private string selSubId = "";
    private string selValue = "";

    // ---- Originating-request repair (the register's old inline Link… UI now lives here) ----
    private string linkTargetRequestId = "";
    private bool linkBusy;
    private string? linkError;
    private IReadOnlyList<VariationOrder> projectQuotes = Array.Empty<VariationOrder>();

    // ---- Communications: emails tagged to the record's quoting reference and (once approved) its V-ref ----
    private bool emailsLoaded;
    private string? emailsError;
    private IReadOnlyList<MailboxMessage> emails = Array.Empty<MailboxMessage>();

    // The record only carries commercial figures (V-ref, value, cost code) once approved — this is
    // the "VO" the old two-record model kept separately; here it's just the current record, or null.
    private VariationOrder? ApprovedOrder => order is { Status: VariationOrderStatus.Approved } ? order : null;

    // The approve build-up is captured in a modal (the sidebar is too narrow for the line table).
    private bool approveModalOpen;

    // Why a line edit was refused. Held apart from the page's `error` because it has to render
    // inside the open dialog — the page's banner sits behind the overlay, where a reader who is
    // mid-edit never sees it, and the dialog staying put with no explanation reads as a hang.
    private string? editLinesError;

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    private static string MoneyPennies(decimal value) => value.ToString("C2", Gb);

    // The approved variation's lines on the valuation report — its priced build-up, newest cost
    // centre split included. Empty until approved (no V-ref) or until the store's lines land.
    private IReadOnlyList<ValuationLineItem> VariationLines =>
        order?.VariationRef is { Length: > 0 } vref
            ? Valuation.LinesFor(ProjectId)
                .Where(line => line.ElementType == ValuationElementType.Variation && line.VariationRef == vref)
                .OrderBy(line => line.DisplayOrder)
                .ToList()
            : Array.Empty<ValuationLineItem>();

    // Distinct cost centres the approved variation touches — from its report lines, falling back to
    // the order's primary code before the lines have loaded.
    private IReadOnlyList<string> ApprovedCostCentres =>
        VariationLines.Count > 0
            ? VariationLines.Select(line => line.CostCode).Where(code => !string.IsNullOrWhiteSpace(code)).Distinct().ToList()
            : (string.IsNullOrWhiteSpace(order?.CostCode) ? Array.Empty<string>() : new[] { order!.CostCode! });

    private string RequestHref => order is null ? $"/projects/{ProjectId}/requests" : $"/projects/{ProjectId}/requests/view/{order.RequestId}";
    private string PackageHref(string bidPackageId) => $"/projects/{ProjectId}/bid-package-invites/{bidPackageId}";

    private bool CanManage => Session.AvailableRoles.Any(role =>
        role is Role.Admin or Role.ManagingDirector or Role.ProjectManager or Role.QuantitySurveyor);

    private IReadOnlyList<Subcontractor> Subs => Subcontractors.All();

    // The approved variation's build-up lives on the valuation report; until its lines land,
    // ApprovedCostCentres falls back to the order's single primary code.
    private bool ValuationLinesReady => Valuation.ReportLoadedFor(ProjectId);

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Auth.IsSignedIn) { Nav.NavigateTo("/login", forceLoad: true); return; }
        Subcontractors.OnChange += StateHasChanged;
        _ = Subcontractors.All(); // warm the directory cache for the tender dropdown
        // Revalidate the request register in the background (stale-while-revalidate) — it feeds
        // the originating-request picker for unlinked (seeded) variation orders.
        RequestRegister.Refresh(ProjectId);
        RequestRegister.OnChange += StateHasChanged;
        // The approved variation's line breakdown reads from the valuation report store — warm it
        // and re-render when the lines land (stale-while-revalidate).
        Valuation.OnChange += StateHasChanged;
        Valuation.Refresh(ProjectId);
        // Activity dots on the tab bar land in the background — absent until then (never gated).
        Activity.OnChanged += StateHasChanged;
        Activity.Refresh(ProjectId);
        sessionReady = true;
        await ReloadAsync();
    }

    // Scrolls to and flashes the approved-figures panel. The lineage bar no longer needs this —
    // there is one variation chip now, rather than a quote chip pointing at an order chip on the
    // same page — but the status pill still uses it when routing Reject / Return-to-quoting from
    // Approved, so the confirmation the user has to give lands visibly instead of the click
    // appearing to do nothing.
    private async Task FocusVariationOrderPanel()
    {
        try { await Js.InvokeVoidAsync("jpmsFocusElement", "variation-order"); }
        catch { /* purely cosmetic — never let a scroll failure break the page */ }
    }

    public void Dispose()
    {
        Subcontractors.OnChange -= StateHasChanged;
        RequestRegister.OnChange -= StateHasChanged;
        Valuation.OnChange -= StateHasChanged;
        Activity.OnChanged -= StateHasChanged;
    }

    // The tab bar's per-record activity dots (the containing request's linked mail, this
    // variation's, each bid package's) — one lookup shared by every tab.
    private RecordActivitySummary? TabActivity(RecordType type, string recordId) =>
        Activity.For(ProjectId, type, recordId);

    // Best-effort: the instruction register is context on this page, never the point of it, so a
    // failure (or a role without access to it) leaves the banner off rather than the page broken.
    private async Task LoadLinkedInstructionsAsync()
    {
        try
        {
            var all = await Instructions.ListAsync(ProjectId);
            linkedInstructions = all
                .Where(instruction => instruction.Links.Any(link => link.VariationOrderId == VariationOrderId))
                .ToList();
        }
        catch
        {
            linkedInstructions = new List<ArchitectInstruction>();
        }
        finally { instructionsLoaded = true; }
    }

    private async Task ReloadAsync()
    {
        try
        {
            order = await Variations.GetByIdAsync(VariationOrderId);
            packages = await Variations.ListBidPackagesAsync(VariationOrderId);
            // Originating request for the lineage bar — best-effort, the bar shows a placeholder
            // without it. Portal-accepted variation orders have no request at all (RequestId is empty).
            if (order is not null && !string.IsNullOrWhiteSpace(order.RequestId))
            {
                try { request = await RequestRegister.GetAsync(order.RequestId); }
                catch { request = null; }
            }
            // The originating-request picker must not offer requests already carrying a variation
            // order (a request has at most one), so it needs the project's other orders to exclude.
            if (order is not null && string.IsNullOrWhiteSpace(order.RequestId))
                projectQuotes = await Variations.ListForProjectAsync(ProjectId);
            error = null;
        }
        catch { error = "Couldn't load the variation order. Please try again."; }
        finally { orderLoaded = true; }

        await LoadLinkedInstructionsAsync();
        await LoadEmailsAsync();
    }

    // The mail behind this record: everything tagged to its quoting reference plus, once approved,
    // everything tagged to its V-ref — one merged, newest-first list (an email tagged to both, e.g.
    // a whole thread synced across the approval, appears once).
    private async Task LoadEmailsAsync()
    {
        emailsError = null;
        try
        {
            var tagged = new List<MailboxMessage>(
                await Queries.AskAsync(new ListRecordEmails(RecordType.VariationQuote, VariationOrderId), CancellationToken.None));
            if (ApprovedOrder is { } approved)
                tagged.AddRange(await Queries.AskAsync(new ListRecordEmails(RecordType.Variation, approved.VariationOrderId), CancellationToken.None));
            emails = tagged
                .GroupBy(email => string.IsNullOrEmpty(email.InternetMessageId) ? email.Id : email.InternetMessageId)
                .Select(group => group.First())
                .OrderByDescending(email => email.ReceivedAt)
                .ToList();
        }
        catch
        {
            emails = Array.Empty<MailboxMessage>();
            emailsError = "Couldn't load this variation's emails. Please try again.";
        }
        finally { emailsLoaded = true; }
    }

    // ---- Originating-request repair --------------------------------------------------------

    // RFIs first — the stage a variation order is normally raised from — then the rest of the
    // register; requests already carrying a variation order are out (a request has at most one).
    private IReadOnlyList<SearchSelect.Option> LinkCandidateOptions
    {
        get
        {
            var taken = projectQuotes
                .Where(quote => !string.IsNullOrWhiteSpace(quote.RequestId) && quote.VariationOrderId != VariationOrderId)
                .Select(quote => quote.RequestId)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            return RequestRegister.ForProject(ProjectId)
                .Where(r => !taken.Contains(r.RequestId))
                .OrderBy(r => r.Kind == RequestType.Rfi ? 0 : 1)
                .ThenBy(r => r.Reference, StringComparer.OrdinalIgnoreCase)
                .Select(r => new SearchSelect.Option(r.RequestId, $"{RefLabel(r)} — {r.Title}"))
                .ToList();
        }
    }

    private static string RefLabel(Request record) =>
        string.IsNullOrWhiteSpace(record.Reference) ? record.DisplayNumber : record.Reference;

    private async Task LinkToRequest()
    {
        if (linkBusy || string.IsNullOrWhiteSpace(linkTargetRequestId)) return;
        linkError = null;
        try
        {
            linkBusy = true;
            await Variations.LinkToRequestAsync(VariationOrderId, linkTargetRequestId);
            linkTargetRequestId = "";
            await ReloadAsync(); // the lineage bar re-renders with the request chip in place
        }
        catch (CommandFailedException ex) { linkError = ex.Message; }
        catch { linkError = "Couldn't link the request. Please try again."; }
        finally { linkBusy = false; }
    }

    private void StartRename()
    {
        renameTitle = order?.Title ?? "";
        // Open on a clean slate: a banner left over from an earlier failed save reads as a fresh
        // refusal of the edit that has only just been started.
        error = null;
        renamingOrder = true;
    }

    private void CancelRename()
    {
        renamingOrder = false;
        // The banner belongs to the edit being abandoned — it must not outlive it.
        error = null;
    }

    private async Task SaveTitle()
    {
        if (busy || order is null) return;
        error = null;
        var title = renameTitle.Trim();
        if (title.Length == 0) { error = "A title is required."; return; }
        // An unchanged title is a cancel by another name — no round-trip, no audit noise.
        if (string.Equals(title, order.Title, StringComparison.Ordinal)) { renamingOrder = false; return; }
        try
        {
            busy = true;
            order = await Variations.RenameAsync(VariationOrderId, title);
            renamingOrder = false;
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't save the new title. Please try again."; }
        finally { busy = false; }
    }

    private async Task AddPackage()
    {
        if (busy) return;
        error = null;
        if (string.IsNullOrWhiteSpace(newTitle) || string.IsNullOrWhiteSpace(newTrade)) { error = "A title and trade are required."; return; }
        try
        {
            busy = true;
            await Variations.AddBidPackageAsync(VariationOrderId, newTitle.Trim(), newTrade.Trim());
            newTitle = newTrade = "";
            addingPackage = false;
            await ReloadAsync();
        }
        catch { error = "Couldn't add the bid package. Please try again."; }
        finally { busy = false; }
    }

    private void OnBidPackageChanged(ChangeEventArgs e) => selBidPackageId = e.Value?.ToString() ?? "";
    private void OnSubChanged(ChangeEventArgs e) => selSubId = e.Value?.ToString() ?? "";

    private async Task ApproveWithLines(VariationApprovePanel.ApproveRequest request)
    {
        if (busy) return;
        error = null;
        try
        {
            busy = true;
            // The panel supplies the priced build-up; the value and primary cost code are derived
            // from it. The server writes one report line per entry under this variation's V-ref.
            order = await Variations.ApproveAsync(VariationOrderId, request.PrimaryCostCode, request.Total, request.Lines);
            approveModalOpen = false;
            Valuation.Refresh(ProjectId); // pull the freshly written variation lines for the breakdown
            await ReloadAsync();
        }
        catch (System.Exception ex)
        {
            error = string.IsNullOrWhiteSpace(ex.Message) ? "Couldn't approve the variation order. Please try again." : ex.Message;
        }
        finally { busy = false; }
    }

    private async Task IssueWorkOrder()
    {
        if (busy || ApprovedOrder is not { } approved) return;
        error = null;
        try
        {
            busy = true;
            await Variations.IssueWorkOrderForVariationOrderAsync(approved.VariationOrderId);
            await ReloadAsync();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't issue the work order. Please try again."; }
        finally { busy = false; }
    }

    // ---- Status pill dropdown ---------------------------------------------------------------

    private string PillOptionLabel(VariationOrderStatus status)
    {
        var needsConfirm = status == VariationOrderStatus.Approved
            || status == VariationOrderStatus.Rejected
            || (order?.Status == VariationOrderStatus.Approved && status == VariationOrderStatus.Quoting);
        return needsConfirm ? $"{status.DisplayName()}…" : status.DisplayName();
    }

    private string? PillOptionTitle(VariationOrderStatus status)
    {
        if (status == VariationOrderStatus.Approved)
            return "Approving writes the contract figures — opens the approve panel";
        if (order?.Status == VariationOrderStatus.Approved && status == VariationOrderStatus.Quoting)
            return "Un-approves the variation order — reverses the approval's valuation / CVR / budget writes";
        if (status == VariationOrderStatus.Rejected && order?.Status == VariationOrderStatus.Approved)
            return "Rejecting an approved order reverses the valuation / CVR / budget writes";
        if (order?.Status == VariationOrderStatus.Approved && status == VariationOrderStatus.Issued)
            return "Not allowed directly from Approved — return to quoting first";
        if (status == VariationOrderStatus.AwaitingArchitectInstruction)
            return "Issued and waiting on a formal Architect's Instruction — no commercial effect yet";
        return null;
    }

    // Routes the pill's chosen target per the unified transition rules: Approved always opens the
    // approve panel (it needs a cost code and value, and writes the contract figures); Rejected
    // reverses the approval's writes when leaving Approved (routed through the inline confirm) and
    // is a plain move otherwise; leaving Approved for Quoting is the "return to quoting" repair
    // (also routed through an inline confirm); Approved -> Issued is never allowed; everything else
    // between Quoting, Issued and Awaiting AI moves directly.
    private async Task ChangeStatus(VariationOrderStatus target)
    {
        orderStatusMenuOpen = false;
        if (busy || order is null || target == order.Status) return;
        error = null;

        if (order.Status == VariationOrderStatus.Approved && target == VariationOrderStatus.Issued)
            return; // not a valid transition

        if (target == VariationOrderStatus.Approved)
        {
            await FocusApprovePanel();
            return;
        }

        if (target == VariationOrderStatus.Rejected)
        {
            if (order.Status == VariationOrderStatus.Approved)
            {
                rejectingOrder = true;
                await FocusVariationOrderPanel();
            }
            else
            {
                // Quoting / Issued / Awaiting AI: a plain move, but a terminal one — confirm first.
                decliningOrder = true;
            }
            return;
        }

        if (order.Status == VariationOrderStatus.Approved && target == VariationOrderStatus.Quoting)
        {
            returningToQuoting = true;
            await FocusVariationOrderPanel();
            return;
        }

        // Direct moves between the side-effect-free stages (Quoting, Issued, Awaiting AI).
        try
        {
            busy = true;
            order = await Variations.SetStatusAsync(VariationOrderId, target);
            await ReloadAsync();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't change the status. Please try again."; }
        finally { busy = false; }
    }

    private async Task RejectOrder()
    {
        if (busy || order is null) return;
        error = null;
        try
        {
            busy = true;
            order = await Variations.RejectAsync(VariationOrderId);
            rejectingOrder = false;
            decliningOrder = false;
            await ReloadAsync();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't reject the variation order. Please try again."; }
        finally { busy = false; }
    }

    private async Task DeleteOrder()
    {
        if (busy || order is null) return;
        error = null;
        try
        {
            busy = true;
            await Variations.DeleteAsync(VariationOrderId);
            // The record is gone — return to the variations register rather than a dead page.
            Nav.NavigateTo($"/projects/{ProjectId}/requests/variations");
        }
        catch (CommandFailedException ex) { error = ex.Message; busy = false; }
        catch { error = "Couldn't delete the variation order. Please try again."; busy = false; }
    }

    // A fresh attempt starts clean: last time's refusal must not read as this time's.
    private void OpenEditLines()
    {
        editLinesError = null;
        editLinesModalOpen = true;
    }

    private async Task SaveLinesEdit(VariationApprovePanel.ApproveRequest request)
    {
        if (busy || order is null) return;
        editLinesError = null;
        try
        {
            busy = true;
            order = await Variations.ReviseVariationOrderLinesAsync(VariationOrderId, request.Lines);
            editLinesModalOpen = false;
            Valuation.Refresh(ProjectId); // pull the re-priced lines for the breakdown
            await ReloadAsync();
        }
        // The endpoint answers a refused revision with 400 and its own words (no toast, by
        // convention) — so they have to land in the dialog the user is still standing in.
        catch (CommandFailedException ex) { editLinesError = ex.Message; }
        catch { editLinesError = "Couldn't save the variation lines. Please try again."; }
        finally { busy = false; }
    }

    // The status pill's "Approved…" pick opens the approve modal — the build-up (cost centres, lines)
    // needs the room a modal gives, not the narrow sidebar.
    private Task FocusApprovePanel()
    {
        approveModalOpen = true;
        return Task.CompletedTask;
    }

    private async Task ReturnToQuoting()
    {
        if (busy) return;
        error = null;
        try
        {
            busy = true;
            order = await Variations.ReturnToQuotingAsync(VariationOrderId);
            returningToQuoting = false;
            await ReloadAsync(); // the approved section drops away; the approve panel reappears
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't return the variation order to quoting. Please try again."; }
        finally { busy = false; }
    }

    private void StartReviseValue()
    {
        reviseValue = order?.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
        revisingValue = true;
        error = null;
    }

    private async Task ReviseVoValue()
    {
        if (busy || order is null) return;
        error = null;
        if (!decimal.TryParse(reviseValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            error = "Enter a valid revised value.";
            return;
        }
        try
        {
            busy = true;
            order = await Variations.ReviseVariationOrderValueAsync(VariationOrderId, value);
            revisingValue = false;
            await ReloadAsync();
        }
        catch { error = "Couldn't revise the variation order value. Please try again."; }
        finally { busy = false; }
    }

    private async Task SelectTender()
    {
        if (busy) return;
        error = null;
        if (string.IsNullOrWhiteSpace(selBidPackageId) || string.IsNullOrWhiteSpace(selSubId)) { error = "Choose a bid package and a subcontractor."; return; }
        decimal? value = decimal.TryParse(selValue, out var parsed) ? parsed : null;
        try
        {
            busy = true;
            order = await Variations.SelectTenderAsync(VariationOrderId, selBidPackageId, selSubId, value);
            await ReloadAsync();
        }
        catch { error = "Couldn't record the selection. Please try again."; }
        finally { busy = false; }
    }

    private string SelectedSubName()
    {
        if (order?.SelectedSubcontractorId is null) return "—";
        return Subcontractors.Find(order.SelectedSubcontractorId)?.CompanyName ?? order.SelectedSubcontractorId;
    }


    private static string Money(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));
}
