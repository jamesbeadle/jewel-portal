    // ---- The assistant's route in: open_modal → ?openModal=variation_edit_lines | variation_build_up
    //
    // Two dialogs, one per side of approval (docs/ai/06-context-retrieval.md, Phase 2 and the
    // rebuilt build-up): "update the draft VO to the agreed details" on an Issued variation opens
    // the Agreed build-up dialog; "update V01 to the V01 tab" on an Approved one opens Edit lines.
    // Each is the same modal the user opens by hand; opened by hand it attaches its task silently.

    private VariationApprovePanel? editLinesPanel;
    private bool editLinesDraftPublished;
    private VariationApprovePanel? buildUpPanel;
    private bool buildUpModalOpen;
    private bool buildUpDraftPublished;
    private bool buildUpNarrativesOpen;
    private string? buildUpError;
    private string buildUpCommercialBasis = "";
    private string buildUpProgrammeImpact = "";
    private string buildUpExclusions = "";
    private string? assistantRouteError;
    private Func<string?>? pageNoteProvider;

    // history.replaceState does not raise LocationChanged, so Nav.Uri keeps the stripped-out query
    // for the life of this component. This is what stops a later repaint re-honouring it.
    private bool modalRequestHonoured;

    private bool TaskActiveFor(string modalKey) =>
        AiTasks.Active?.ModalKey == modalKey && AiTasks.Active.RecordId == VariationOrderId;

    private bool EditLinesTaskActive => TaskActiveFor(ModalCatalog.VariationEditLines.ModalKey);
    private bool BuildUpTaskActive => TaskActiveFor(ModalCatalog.VariationBuildUp.ModalKey);

    /// <summary>Which of this page's dialogs the route asks for, or null.</summary>
    private ModalDescriptor? RequestedModalFromRoute()
    {
        if (modalRequestHonoured) return null;
        var query = new Uri(Nav.Uri).Query;
        if (query.Contains($"openModal={ModalCatalog.VariationEditLines.ModalKey}", StringComparison.OrdinalIgnoreCase))
            return ModalCatalog.VariationEditLines;
        if (query.Contains($"openModal={ModalCatalog.VariationBuildUp.ModalKey}", StringComparison.OrdinalIgnoreCase))
            return ModalCatalog.VariationBuildUp;
        return null;
    }

    private AiTask TaskFor(ModalDescriptor modal, VariationOrder target, string? kickoff) =>
        new(
            TaskKey: modal == ModalCatalog.VariationBuildUp ? "variation-build-up" : "variation-edit-lines",
            ModalKey: modal.ModalKey,
            BannerLabel: modal == ModalCatalog.VariationBuildUp
                ? $"Staging {target.DisplayNumber}'s agreed build-up"
                : $"Editing {target.DisplayNumber}'s lines",
            BusyLabel: $"Reading {target.DisplayNumber} and the evidence…",
            KickoffMessage: kickoff,
            ProjectId: ProjectId,
            RecordType: nameof(RecordType.Variation),
            RecordId: target.VariationOrderId,
            RecordReference: target.DisplayNumber);

    /// <summary>
    /// Honoured only where this user could have opened the dialog by clicking — the assistant can
    /// route somebody to a page; it cannot get them past a gate. The query is cleared first,
    /// through history rather than the router, so F5 does not reopen the dialog and re-bill a
    /// kick-off turn. Every refusal is said out loud in the banner.
    /// </summary>
    private async Task HonourRequestedModalAsync()
    {
        if (RequestedModalFromRoute() is not { } modal) return;

        // Latched BEFORE the first await: OnParametersSetAsync and LocationChanged can both enter
        // this method for one navigation — two AiTasks.Start calls, two billed kick-off turns.
        modalRequestHonoured = true;

        try { await Js.InvokeVoidAsync("history.replaceState", null, "", new Uri(Nav.Uri).GetLeftPart(UriPartial.Path)); }
        catch { /* Address bar cosmetics. Never worth failing the page over. */ }

        var name = modal.DisplayName;
        if (order is null)
        {
            assistantRouteError = $"The assistant tried to open the {name} dialog, but this variation could not be loaded.";
            StateHasChanged();
            return;
        }
        if (!CanManage)
        {
            assistantRouteError = $"The assistant tried to open the {name} dialog, but the role you are viewing as can't edit variations.";
            StateHasChanged();
            return;
        }

        var isBuildUp = modal == ModalCatalog.VariationBuildUp;
        if (isBuildUp && order.Status is VariationOrderStatus.Approved or VariationOrderStatus.Rejected)
        {
            assistantRouteError = $"The assistant tried to open the {name} dialog, but {order.DisplayNumber} is "
                + $"{order.Status.DisplayName()} — a build-up is staged before approval.";
            StateHasChanged();
            return;
        }
        if (!isBuildUp && order.Status != VariationOrderStatus.Approved)
        {
            assistantRouteError = $"The assistant tried to open the {name} dialog, but {order.DisplayNumber} is "
                + $"{order.Status.DisplayName()} — lines exist only once a variation is approved.";
            StateHasChanged();
            return;
        }
        if (!isBuildUp && !ValuationLinesReady)
        {
            // The dialog seeds itself from the report lines; opening it before they land would
            // offer an empty build-up. Wait for the store — bounded.
            for (var i = 0; i < 30 && !ValuationLinesReady; i++) await Task.Delay(100);
            if (!ValuationLinesReady)
            {
                assistantRouteError = $"The assistant tried to open the {name} dialog, but the Valuation Report's lines have not loaded yet — try again in a moment.";
                StateHasChanged();
                return;
            }
        }

        if (isBuildUp)
        {
            buildUpError = null;
            SeedBuildUpNarratives();
            buildUpModalOpen = true;
            buildUpDraftPublished = false;
        }
        else
        {
            editLinesError = null;
            editLinesModalOpen = true;
            editLinesDraftPublished = false;
        }

        if (Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role))
        {
            // A user turn, so it outranks the system prompt — it has to say the same thing.
            var kickoff = isBuildUp
                ? $"The \"Agreed build-up\" dialog for {order.DisplayNumber} is open beside me. Stage the client-agreed "
                  + "build-up from the evidence we were working with — the attached file or the tagged emails above all "
                  + "(get_variation_context for the variation as it stands, find_in_source and read_source for the "
                  + "evidence). Send the whole agreed schedule in ONE update — one line per cost centre, only figures "
                  + "the evidence states — and the narrative sections if the evidence gives them, and tell me in one "
                  + "line what you staged and what you could not establish."
                : $"The \"Edit variation lines\" dialog for {order.DisplayNumber} is open beside me, "
                  + "pre-filled with its current build-up. Correct the schedule from the evidence we were "
                  + "working with — the attached file or the tagged emails above all (get_variation_context "
                  + "for the lines as they stand, find_in_source and read_source for the evidence). Send the "
                  + "whole schedule in ONE update: keep every line that is still right with its "
                  + "valuationLineItemId, change what the evidence changes, add only lines it actually "
                  + "prices, and tell me in one line what you changed and what you could not establish.";
            AiTasks.Start(TaskFor(modal, order, kickoff), "{}");
            Chat.Open();
            Chat.SetCoexistence(true);
        }
        StateHasChanged();
    }

