    private void OpenBuildUp()
    {
        buildUpError = null;
        SeedBuildUpNarratives();
        buildUpModalOpen = true;
        buildUpDraftPublished = false;
        // Opened by hand: the task attaches SILENTLY — no kick-off, no billed turn — so the
        // assistant knows the dialog is open and can fill it when asked.
        if (!BuildUpTaskActive && order is not null && Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role))
        {
            AiTasks.Start(TaskFor(ModalCatalog.VariationBuildUp, order, kickoff: null), "{}");
            Chat.SetCoexistence(true);
        }
    }

    private void CloseBuildUp()
    {
        buildUpModalOpen = false;
        buildUpError = null;
        EndBuildUpTask();
    }

    private async Task StageBuildUp(VariationApprovePanel.ApproveRequest request)
    {
        if (busy || order is null) return;
        buildUpError = null;
        try
        {
            busy = true;
            order = await Variations.StageBuildUpAsync(
                VariationOrderId, request.Lines,
                buildUpCommercialBasis, buildUpProgrammeImpact, buildUpExclusions);
            buildUpModalOpen = false;
            EndBuildUpTask(); // Staged: the dialog is gone, so its task goes with it.
            await ReloadAsync();
        }
        // The endpoint answers a refused staging with 400 and its own words (no toast, by
        // convention) — so they land in the dialog the user is still standing in.
        catch (CommandFailedException ex) { buildUpError = ex.Message; }
        catch { buildUpError = "Couldn't stage the build-up. Please try again."; }
        finally { busy = false; }
    }

    /// <summary>The build-up dialog's live state as the task carries it: the panel's rows plus the
    /// three narrative fields — the dialog's schema exactly.</summary>
    private string BuildUpDraftJson()
    {
        var root = System.Text.Json.Nodes.JsonNode.Parse(buildUpPanel?.SnapshotLines() ?? "{}") as System.Text.Json.Nodes.JsonObject
                   ?? new System.Text.Json.Nodes.JsonObject();
        root["commercialBasis"] = buildUpCommercialBasis;
        root["programmeImpact"] = buildUpProgrammeImpact;
        root["exclusions"] = buildUpExclusions;
        return root.ToJsonString();
    }

    private void PublishBuildUpDraft()
    {
        if (!BuildUpTaskActive) return;
        AiTasks.UpdateDraft(BuildUpDraftJson());
    }

    /// <summary>The model's update_open_modal, landing in whichever of this page's dialogs is
    /// open: the schedule replaces the rows (and, for the build-up, a narrative it sent replaces
    /// the field — whitespace-only counts as not sent), the live state is republished, the modal
    /// repaints.</summary>
    private void HandleAssistantLinesDraft(string fieldsJson)
    {
        if (editLinesModalOpen && EditLinesTaskActive && editLinesPanel is not null)
        {
            editLinesPanel.ReplaceLines(fieldsJson);
            AiTasks.UpdateDraft(editLinesPanel.SnapshotLines());
            StateHasChanged();
            return;
        }
        if (buildUpModalOpen && BuildUpTaskActive && buildUpPanel is not null)
        {
            buildUpPanel.ReplaceLines(fieldsJson);
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(fieldsJson);
                var root = document.RootElement;
                if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    if (ProposedText(root, "commercialBasis") is { } basis) { buildUpCommercialBasis = basis; buildUpNarrativesOpen = true; }
                    if (ProposedText(root, "programmeImpact") is { } impact) { buildUpProgrammeImpact = impact; buildUpNarrativesOpen = true; }
                    if (ProposedText(root, "exclusions") is { } exclusions) { buildUpExclusions = exclusions; buildUpNarrativesOpen = true; }
                }
            }
            catch (System.Text.Json.JsonException) { /* the rows were already applied; the fields stand */ }
            AiTasks.UpdateDraft(BuildUpDraftJson());
            StateHasChanged();
        }
    }

    private static string? ProposedText(System.Text.Json.JsonElement root, string name) =>
        root.TryGetProperty(name, out var value) && value.ValueKind == System.Text.Json.JsonValueKind.String
        && !string.IsNullOrWhiteSpace(value.GetString())
            ? value.GetString()
            : null;

    /// <summary>Every human edit republishes the live rows, so the model reasons from the
    /// schedule as it stands NOW.</summary>
    private void PublishEditLinesDraft()
    {
        if (!EditLinesTaskActive || editLinesPanel is null) return;
        AiTasks.UpdateDraft(editLinesPanel.SnapshotLines());
    }

    /// <summary>
    /// Braces: the case the lifecycle hooks MISS. When the panel's open_modal fires while the user
    /// is ALREADY on this variation, the navigation changes only the query string — the route
    /// parameter values are identical, so neither OnInitializedAsync nor OnParametersSetAsync
    /// runs. This event is the one signal that always fires; history.replaceState does not raise
    /// it, so honouring cannot loop.
    /// </summary>
    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(async () =>
        {
            if (!sessionReady || !orderLoaded) return;
            modalRequestHonoured = false; // a fresh navigation is a fresh request
            await HonourRequestedModalAsync();
        });

    /// <summary>What this page reports to the assistant every hop, beyond the route: the
    /// variation's status and value, its staged build-up, how many report lines it has, and
    /// which of its dialogs is open — so "update it" resolves to the right act without a guess.</summary>
    private string? PageNote()
    {
        if (order is null) return null;
        var lines = VariationLines;
        var note = $"Variation {order.DisplayNumber} «{order.Title}» is {order.Status.DisplayName()}"
                   + (order.Status == VariationOrderStatus.Approved
                       ? $", approved value {MoneyPennies(order.Value)} across {lines.Count} report line{(lines.Count == 1 ? "" : "s")}"
                       : order.EstimatedValue is { } estimate ? $", estimate {MoneyPennies(estimate)}" : "")
                   + ".";
        if (order.Status != VariationOrderStatus.Approved && order.Status != VariationOrderStatus.Rejected)
        {
            note += order.DraftLines is { Count: > 0 } staged
                ? $" An agreed build-up of {staged.Count} line{(staged.Count == 1 ? "" : "s")} is staged (its total is the estimate)."
                : " No agreed build-up is staged yet.";
        }
        if (editLinesModalOpen)
            note += " The Edit lines dialog is open" + (EditLinesTaskActive ? " (its rows are in the task state)." : ".");
        else if (buildUpModalOpen)
            note += " The Agreed build-up dialog is open" + (BuildUpTaskActive ? " (its rows are in the task state)." : ".");
        else if (order.Status == VariationOrderStatus.Approved && CanManage)
            note += " Edit lines (variation_edit_lines) can be opened here.";
        else if (order.Status != VariationOrderStatus.Rejected && CanManage)
            note += " The agreed build-up (variation_build_up) can be staged here.";
        return note;
    }
}
