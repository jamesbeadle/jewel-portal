    // ---- Draft supplier reply: the assistant answers an incomplete tender ---------------------
    //
    // The extraction names the gaps; this opens the Emails tab's own Reply composer on the tender
    // email (it sends from the projects mailbox and files back under the package by tag) and
    // starts a tender_reply task so the assistant writes the ask-for-what's-missing reply into
    // it. Same contract as every task dialog: filling writes nothing — the user reads the reply
    // and presses Send themselves.

    private MailReplyComposer? commsComposer;

    private bool CanUseAssistantForReply =>
        Session.ActiveRole is { } role && DesktopNavigation.CanUseAssistant(role);

    private void StartTenderReplyTask()
    {
        if (package is null || extractSourceEmail is not { } email) return;
        if (!CanUseAssistantForReply) return;

        var issues = extractIssues.ToList();
        showExtractModal = false;
        activeTab = "emails";
        StartCommsCompose(email, forward: false);

        var sender = string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName;
        AiTasks.Start(
            new AiTask(
                TaskKey: "tender-reply",
                ModalKey: ModalCatalog.TenderReply.ModalKey,
                BannerLabel: $"Replying about the {package.Reference} tender",
                BusyLabel: "Reading the tender and drafting the reply…",
                // A user turn, so it outranks the system prompt — it has to say the same thing.
                KickoffMessage:
                    $"{sender}'s tender submission on this bid package is missing information. The "
                    + "Reply composer open beside me is anchored to their email with the recipients "
                    + "and subject prefilled. Draft the reply body: thank them for their tender, list "
                    + "exactly what's missing so they can complete it, and ask them to return the "
                    + "completed pricing schedule workbook. The gaps found when extracting their tender:\n"
                    + string.Join("\n", issues.Select(issue => $"- {issue}"))
                    + "\nRead get_bid_package_context and the tagged emails (read_record_emails, "
                    + "record_type bid_package) if you need the line schedule or their exact wording. "
                    + "Then send the reply as PLAIN TEXT in ONE update_open_modal — body only, unless a "
                    + "prefilled field is blank. I review it and press Send myself.",
                ProjectId: ProjectId,
                RecordType: "bid_package",
                RecordId: BidPackageId,
                RecordReference: package.Reference),
            "{}");
        Chat.Open();
        Chat.SetCoexistence(true);
    }

    private string CurrentDetailsDraftJson() => JsonSerializer.Serialize(new
    {
        summary = specDraft,
        lines = lineDrafts.Select(draft => new
        {
            trade = draft.Trade,
            description = draft.Description,
            unit = draft.Unit,
            quantity = draft.Quantity,
            costCode = draft.CostCode
        })
    });

    /// <summary>
    /// The assistant's update_open_modal proposal, raw fields JSON. Summary and schedule arrive
    /// together (the dialog holds both); either alone still applies, so a partial proposal keeps
    /// what the user has. Anything malformed costs the model its update, never the page.
    /// </summary>
    private void ApplyAssistantDraft(string fieldsJson)
    {
        // tender_reply: the proposal belongs to the Reply composer, not the details dialog. The
        // composer owns its state; the page only forwards and mirrors the result into the task's
        // draft so the model sees what the form now says.
        if (AiTasks.Active?.ModalKey == ModalCatalog.TenderReply.ModalKey)
        {
            if (commsComposer is { } composer && composer.ApplyAssistantFields(fieldsJson))
            {
                AiTasks.UpdateDraft(composer.CurrentFieldsJson());
                StateHasChanged();
            }
            return;
        }

        if (!showDetailsModal) return;
        try
        {
            using var document = JsonDocument.Parse(fieldsJson);
            var root = document.RootElement;
            if (root.ValueKind != JsonValueKind.Object) return;
            var changed = false;

            if (root.TryGetProperty("lines", out var lines) && lines.ValueKind == JsonValueKind.Array)
            {
                var drafts = new List<LineDraft>();
                foreach (var item in lines.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object) continue;
                    var description = ReadJsonString(item, "description");
                    if (string.IsNullOrWhiteSpace(description)) continue;
                    drafts.Add(new LineDraft
                    {
                        Description = description,
                        Trade = ReadJsonString(item, "trade") ?? package?.Trade ?? "",
                        Unit = ReadJsonString(item, "unit") ?? "",
                        Quantity = item.TryGetProperty("quantity", out var quantity)
                                   && quantity.ValueKind == JsonValueKind.Number
                                   && quantity.TryGetDecimal(out var parsed) ? parsed : 1m,
                        CostCode = ReadJsonString(item, "costCode") ?? ""
                    });
                }
                if (drafts.Count > 0) { lineDrafts = drafts; changed = true; }
            }

            if (root.TryGetProperty("summary", out var summary) && summary.ValueKind == JsonValueKind.String)
            {
                specDraft = summary.GetString() ?? "";
                changed = true;
            }

            if (changed)
            {
                AiTasks.UpdateDraft(CurrentDetailsDraftJson());
                _ = InvokeAsync(StateHasChanged);
            }
        }
        catch (JsonException) { }
    }

    private static string? ReadJsonString(JsonElement element, string name) =>
        element.TryGetProperty(name, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString() : null;

    // ---- The assistant's route in: open_modal → ?openModal=bid_package_details ----------------

    // history.replaceState does not raise LocationChanged, so Nav.Uri keeps the stripped-out query
    // for the life of this component — the flag stops a later repaint re-honouring it. A REAL
    // navigation carrying openModal= (the assistant's second dialog in one conversation) resets it
    // in HandleLocationChanged.
    private bool modalRequestHonoured;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!e.Location.Contains("openModal=", StringComparison.OrdinalIgnoreCase)) return;
        modalRequestHonoured = false;
        _ = InvokeAsync(async () =>
        {
            await HonourRequestedModalAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Honoured only where this user could have opened the dialog by clicking — the assistant can
    /// route somebody to a page; it cannot get them past a gate. The query is cleared first,
    /// through history rather than the router, so F5 does not reopen the dialog and re-bill a
    /// kick-off turn.
    /// </summary>
    private async Task HonourRequestedModalAsync()
    {
        if (modalRequestHonoured || package is null) return;
        if (!new Uri(Nav.Uri).Query.Contains(
                $"openModal={ModalCatalog.BidPackageDetails.ModalKey}", StringComparison.OrdinalIgnoreCase))
            return;

        try { await JS.InvokeVoidAsync("history.replaceState", null, "", new Uri(Nav.Uri).GetLeftPart(UriPartial.Path)); }
        catch { /* Address bar cosmetics. Never worth failing the page over. */ }
        modalRequestHonoured = true;

        if (!CanEdit)
        {
            // Said out loud — a silent no-op leaves the user (and the model) certain something
            // deeper is broken.
            error = "The assistant tried to open the package-details dialog, but the role you are viewing as "
                + (IsClosed ? "can't edit a closed package — reopen it first." : "can't edit this package.");
            StateHasChanged();
            return;
        }

        activeTab = "details";
        EditDetails();
        StartDetailsTask(userInitiated: false);
        StateHasChanged();
    }
    // Every query in LoadAsync has had its turn. Some may have failed — that is the point: a gate
    // held open by a fetch that is never coming back is worse than an empty panel.
