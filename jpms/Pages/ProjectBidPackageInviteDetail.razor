    private IReadOnlyList<BidPackageLineItem> lineItems => fetchedLineItems ?? Array.Empty<BidPackageLineItem>();
    private IReadOnlyList<MailboxMessage> emails => fetchedEmails ?? Array.Empty<MailboxMessage>();
