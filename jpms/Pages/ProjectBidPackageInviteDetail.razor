@page "/projects/{ProjectId}/bid-package-invites/{BidPackageId}"
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Contracts.Subcontractors
@using Jewel.JPMS.Contracts.Boq
@using Jewel.JPMS.Contracts.Drawings
@using Jewel.JPMS.Contracts.Variations
@using Jewel.JPMS.Contracts.Commercial
@using Jewel.JPMS.Contracts.Ai
@using System.Text.Json
@using Jewel.JPMS.Cqrs
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Triage.Panels
@inject AuthService Auth
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands
@inject CostCentersReadModel CostCenters
@inject ISubcontractorStore Subs
@inject IBidPackageAttachmentStore PackageAttachments
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel SubsReadModel
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Bid Package Invite · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="bid-package-invites">
        <nav class="mb-4 text-sm">
            <a href="@($"/projects/{ProjectId}/bid-package-invites")" class="text-content-subtle hover:text-content underline underline-offset-4">Bid package invites</a>
        </nav>

        @if (error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4 whitespace-pre-wrap">@error</p>
        }

        <LoadGate IsLoading="@(package is null && !loadAttempted)" Prominent="true" Label="Loading bid package">
        @if (package is null)
        {
            <p class="text-sm text-content-subtle italic">That bid package could not be loaded.</p>
        }
        else
        {
            <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
                <div>
                    @if (!string.IsNullOrWhiteSpace(package.Reference))
                    {
                        <p class="text-xs font-mono tracking-wide text-content-subtle mb-0.5">@package.Reference</p>
                    }
                    <div class="flex items-center gap-3">
                        <h2 class="text-lg font-semibold text-content">@package.Title</h2>
                        <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">@package.Status</span>
                    </div>
                    <p class="text-sm text-content-muted">@package.Trade</p>
                    @if (CanEdit)
                    {
                        <label class="mt-1.5 flex items-center gap-2 text-xs text-content-muted cursor-pointer"
                               title="When ticked, the tender-invite email asks each subcontractor to state whether they will supply their own materials or price labour-only.">
                            <input type="checkbox" checked="@package.MaterialsApplicable" disabled="@busy"
                                   @onchange="e => ToggleMaterialsApplicable(e.Value is true)" />
                            Materials apply — ask tenderers whether they supply their own
                        </label>
                    }
                    else if (package.MaterialsApplicable)
                    {
                        <p class="text-xs text-content-subtle mt-1.5">Materials apply — the invite asks tenderers whether they supply their own.</p>
                    }
                </div>
                @if (CanManage && package.Status != BidPackageStatus.Awarded)
                {
                    @* The record's actions in one place — the same DropdownMenu the request page's
                       Actions uses. Create with AI leads: the assistant reads the package's context
                       (spec, lines, documents, tagged emails) and fills the editing dialogs for
                       review — nothing saves until the user presses the dialog's own button. *@
                    <DropdownMenu Label="Actions" Disabled="@busy" Items="@HeaderActions()" />
                }
            </header>

            @if (IsClosed)
            {
                <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-sm text-content-muted mb-6">
                    Closed@(package.ClosedAt is { } closedAt ? $" on {closedAt.LocalDateTime:d MMM yyyy}" : "") — the tender ended with no winner selected. Reopen it to continue.
                </p>
            }

            @* ---- Section tabs — the chip pattern the RFIs register uses; Details leads.
                   Local panes like the request page's tabs: one section renders at a time,
                   nothing about each section's markup changes. ---- *@
            <div class="flex flex-wrap items-center gap-2 mb-5 text-sm">
                @foreach (var tab in SectionTabs)
                {
                    var key = tab.Key;
                    <button type="button" class="@TabClass(key)" @onclick="() => activeTab = key">@tab.Label</button>
                }
            </div>

            @if (activeTab == "tender-list")
            {
            @* ---- Invited subcontractors ---- *@
            <section class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Invited to tender</h3>
                    @if (CanEdit)
                    {
                        <div class="flex items-center gap-4">
                            @if (recipients.Count > 0)
                            {
                                <button type="button" class="text-xs text-accent hover:underline" @onclick="OpenComposeModal">Invite email</button>
                            }
                            @if (PackageReadyForInvites)
                            {
                                <button type="button" class="text-xs text-accent hover:underline" @onclick="OpenFindModal">Find subcontractors</button>
                                <button type="button" class="text-xs text-accent hover:underline" @onclick="OpenInviteModal">+ Add subcontractor</button>
                            }
                            else
                            {
                                @* Inviting is gated on the package saying what it is: the details are what
                                   the invite, the pricing schedule and the trade match all work from. *@
                                <span class="text-xs text-content-subtle italic"
                                      title="A title plus a specification summary or line items — set under Details — are what the invite email, the pricing schedule and the trade match all work from.">
                                    Add the package's details to invite subcontractors
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (sendNote is not null)
                {
                    <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-sm text-content mb-3">
                        @sendNote
                        @if (draftWebLink is not null)
                        {
                            <a class="text-accent underline ml-1" href="@draftWebLink" target="_blank" rel="noopener">Open it in Outlook on the web</a>
                        }
                    </p>
                }

                <LoadGate IsLoading="@(!RecipientsReady)" Prominent="true" Label="Loading invited subcontractors">
                @if (recipients.Count == 0)
                {
                    @* Only once the fetch has answered — the banner above carries a failure. *@
                    @if (fetchedRecipients is not null)
                    {
                        <p class="text-sm text-content-subtle italic">No subcontractors invited yet.</p>
                    }
                }
                else
                {
                    <div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
                        <table class="w-full text-sm">
                            <thead class="bg-surface-raised border-b border-line">
                                <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Subcontractor</th>
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden sm:table-cell">Trade</th>
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Added</th>
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Status</th>
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line">
                                @foreach (var recipient in recipients)
                                {
                                    var sub = Subs.Find(recipient.SubcontractorId);
                                    <tr>
                                        <td class="px-4 py-3">
                                            <span class="text-content font-medium">@(sub?.CompanyName ?? recipient.SubcontractorId)</span>
                                            @if (sub is { IsProspect: true })
                                            {
                                                @* Tender-only prospect: on this list but deliberately NOT in the
                                                   Directory — promotion happens from their submitted tender. *@
                                                <span class="ml-2 inline-flex items-center rounded-full bg-surface border border-line px-1.5 py-0.5 text-[10px] font-medium text-content-subtle"
                                                      title="Only on tender lists — not in the Directory. Add them from their submitted tender if they're worth keeping.">Not in directory</span>
                                            }
                                            @if (sub is not null && string.IsNullOrWhiteSpace(sub.ContactEmail))
                                            {
                                                <span class="ml-2 inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-1.5 py-0.5 text-[10px] font-medium text-amber-800">No email address</span>
                                            }
                                            else if (sub is not null)
                                            {
                                                <span class="block text-xs text-content-subtle">@sub.ContactEmail</span>
                                            }
                                            @if (sub is not null && !string.IsNullOrWhiteSpace(sub.Website))
                                            {
                                                @* Their site in a new tab — the quickest sanity-check on who a
                                                   search-found company actually is before the invite drafts. *@
                                                <a class="block text-xs text-accent hover:underline truncate max-w-xs"
                                                   href="@WebsiteHref(sub.Website)" target="_blank" rel="noopener">@WebsiteLabel(sub.Website)</a>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-content-muted hidden sm:table-cell">@(sub?.TradesLabel ?? "")</td>
                                        <td class="px-4 py-3 text-content-subtle">@recipient.InvitedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</td>
                                        @* "Invited" as a word implies an email went out, which the system can't know
                                           (sends happen in Outlook) — "On list" says exactly what is true. The other
                                           statuses read fine as-is. *@
                                        <td class="px-4 py-3 @(recipient.Status == BidPackageRecipientStatus.Declined ? "text-content-subtle" : "text-content-muted")">@(recipient.Status == BidPackageRecipientStatus.Invited ? "On list" : recipient.Status.ToString())</td>
                                        <td class="px-4 py-3 text-right">
                                            @if (CanEdit)
                                            {
                                                @* Row actions follow the button colour rule: acts are green
                                                   (btn-secondary), the destructive one warns (btn-neutral +
                                                   negative text/border) — compact paddings for a table row. *@
                                                <span class="inline-flex items-center gap-2">
                                                    @if (recipient.Status == BidPackageRecipientStatus.Responded
                                                        && sub is { IsProspect: true } && CanAddToDirectory)
                                                    {
                                                        <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@busy"
                                                                title="Their tender is in and this company isn't in the Directory yet — add it if they're worth keeping for future work."
                                                                @onclick="() => AddToDirectory(sub!.SubcontractorId)">Add to directory</button>
                                                    }
                                                    @if (recipient.Status == BidPackageRecipientStatus.Declined)
                                                    {
                                                        <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@busy"
                                                                title="Put them back in the running — restores Responded if they have a tender in, otherwise back on the list."
                                                                @onclick="() => SetDeclined(recipient, false)">Undo decline</button>
                                                    }
                                                    else if (recipient.Status != BidPackageRecipientStatus.Won)
                                                    {
                                                        <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@busy"
                                                                title="Record that they've declined to tender (e.g. told you by phone). Keeps them on the list for the record."
                                                                @onclick="() => SetDeclined(recipient, true)">Mark declined</button>
                                                    }
                                                    <button type="button" class="btn-neutral px-2 py-1 text-xs text-negative border-negative/40" disabled="@busy"
                                                            @onclick="() => RemoveRecipient(recipient)">Remove</button>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="text-xs text-content-subtle mt-2">
                        Adding a subcontractor only builds the invite list — nothing is emailed until you
                        compose the “Invite email” above and press Send there. It sends from the projects
                        mailbox, with everyone in BCC; a half-written invite is saved on the package.
                    </p>
                }
                </LoadGate>
            </section>
            }

            @if (activeTab == "details")
            {
            @* ---- Specification summary: the "what this package covers" bullets printed at the
                   top of the pricing schedule workbook that travels with the invite. One Edit for
                   the whole tab — summary and line items are edited together in one dialog. ---- *@
            <section class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Specification summary</h3>
                    @if (CanEdit)
                    {
                        <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@busy" @onclick="EditDetails">Edit details</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(package.SpecificationSummary))
                {
                    <ul class="space-y-1">
                        @foreach (var line in package.SpecificationSummary.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li class="text-sm text-content-muted">• @line.Trim().TrimStart('•', '-', ' ')</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-content-subtle italic">
                        No summary yet. One line per point — it prints at the top of the pricing schedule
                        each tenderer receives, so say what the package covers and to what standard.
                    </p>
                }
            </section>

            @* ---- Line items, grouped by trade — same tab, same Edit details dialog.
                   "Select line items" is the fast path: tick the valuation report's priced rows
                   and they arrive as lines carrying their cost code, so every cost-centre home
                   put out to tender is one that exists on the sale side. ---- *@
            <section class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Line items</h3>
                    @if (CanEdit)
                    {
                        <button type="button" class="btn-secondary px-2 py-1 text-xs" disabled="@busy"
                                title="Tick lines from the valuation report — each becomes a line item on this package, carrying its cost code."
                                @onclick="OpenValuationPicker">Select line items</button>
                    }
                </div>

                <LoadGate IsLoading="@(!LineItemsReady)" Prominent="true" Label="Loading line items">
                @if (lineItems.Count == 0)
                {
                    @* Only once the fetch has answered — the banner above carries a failure. *@
                    @if (fetchedLineItems is not null)
                    {
                        <p class="text-sm text-content-subtle italic">No line items on this package yet.</p>
                    }
                }
                else
                {
                    @foreach (var group in lineItems.GroupBy(item => item.Trade).OrderBy(g => g.Key))
                    {
                        <div class="mb-4">
                            <p class="text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">@(string.IsNullOrWhiteSpace(group.Key) ? "Unspecified" : group.Key)</p>
                            <div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
                                <table class="w-full text-sm">
                                    <thead class="bg-surface-raised border-b border-line">
                                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2">Description</th>
                                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2 hidden sm:table-cell">Unit</th>
                                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2">Qty</th>
                                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2">Cost code</th>
                                            <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2">Covered by</th>
                                            @if (CanEdit)
                                            {
                                                <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2"></th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line">
                                        @foreach (var item in group)
                                        {
                                            <tr>
                                                <td class="px-4 py-2 text-content">@item.Description</td>
                                                <td class="px-4 py-2 text-content-muted hidden sm:table-cell">@item.Unit</td>
                                                <td class="px-4 py-2 text-content-muted">@item.Quantity</td>
                                                <td class="px-4 py-2">
                                                    @if (string.IsNullOrWhiteSpace(item.CostCode))
                                                    {
                                                        <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-1.5 py-0.5 text-[10px] font-medium text-amber-800"
                                                              title="This line predates the cost-code rule — edit the line items to set one.">No cost code</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-content-muted" title="@CostCentreLabel(item.CostCode)">@item.CostCode</span>
                                                    }
                                                </td>
                                                <td class="px-4 py-2">
                                                    @if (item.Coverage == BidPackageLineCoverage.Unassigned)
                                                    {
                                                        <span class="text-xs text-content-subtle italic">Not linked</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-medium @(item.Coverage == BidPackageLineCoverage.Variation ? "border-accent/30 bg-accent/10 text-accent" : "border-line bg-surface-raised text-content-muted")">@CoverageLabel(item)</span>
                                                    }
                                                </td>
                                                @if (CanEdit)
                                                {
                                                    <td class="px-4 py-2 text-right">
                                                        <button type="button" class="text-xs text-accent hover:underline" disabled="@busy" @onclick="() => OpenCoverageModal(item)">@(item.Coverage == BidPackageLineCoverage.Unassigned ? "Link" : "Change")</button>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                </LoadGate>
            </section>

            }

            @if (activeTab == "submissions")
            {
            @* ---- Tender submissions: quotes compared line by line ---- *@
            <section class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Tender submissions</h3>
                    @if (CanEdit && recipients.Count > 0)
                    {
                        <button type="button" class="text-xs text-accent hover:underline" disabled="@busy"
                                title="Key in a tender received outside email — phoned through, posted, or from a message that wasn't tagged."
                                @onclick="OpenManualTenderModal">Record tender manually</button>
                    }
                </div>

                @* ---- Tender responses: the filed tender emails, each one click from a reviewable
                       submission. Filed from the Control Centre (System actions → File Bid Package
                       Tender) or tagged by hand — the package tag is what lists them here. ---- *@
                @if (emails.Count > 0)
                {
                    <div class="rounded-xl border border-line bg-surface mb-3">
                        <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-2 border-b border-line">
                            <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Tender responses</p>
                            <span class="text-[11px] text-content-subtle">Extract a tender to review it against the line schedule and save it as a submission.</span>
                        </div>
                        <ul class="divide-y divide-line">
                            @foreach (var email in emails)
                            {
                                <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5">
                                    <div class="min-w-0">
                                        <p class="text-sm text-content truncate">
                                            <span class="font-medium">@(string.IsNullOrWhiteSpace(email.FromName) ? email.FromEmail : email.FromName)</span>
                                            <span class="text-content-subtle"> — @email.Subject</span>
                                            @if (email.HasAttachments)
                                            {
                                                <span class="ml-2 inline-flex items-center rounded bg-surface-raised border border-line px-1.5 py-0.5 text-[10px] text-content-subtle">attachment</span>
                                            }
                                        </p>
                                        <p class="text-xs text-content-subtle">@email.ReceivedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</p>
                                    </div>
                                    @if (CanEdit)
                                    {
                                        <button type="button" class="btn-secondary px-2 py-1 text-xs shrink-0" disabled="@(busy || extractBusy)"
                                                title="Read this email and its returned pricing schedule with AI, mapped against the package's line items, ready to review and save as a submission."
                                                @onclick="() => OpenExtractFromEmail(email)">Extract information</button>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (awardNote is not null)
                {
                    <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-sm text-content mb-3">@awardNote</p>
                }

                @* Persistent award summary — who won, for how much, and the purchase-order it raised. *@
                @if (package.Status == BidPackageStatus.Awarded && AwardedOrder is { } awarded)
                {
                    <div class="rounded-xl border border-positive/30 bg-positive/10 px-4 py-3 mb-3 flex flex-wrap items-center justify-between gap-3">
                        <p class="text-sm text-content">
                            <span class="font-semibold">Awarded</span> to
                            <span class="font-medium">@awarded.SubcontractorName</span>
                            at @awarded.Order.Value.ToString("£#,##0.00")
                            on @awarded.Order.AwardedAt.LocalDateTime.ToString("d MMM yyyy") —
                            <a class="text-accent hover:underline" href="@($"/projects/{ProjectId}/work-orders")"
                               title="Open the project's Work Orders tab, where this order's cost-coded lines feed the cost-centre totals.">
                                work order WO-@awarded.Order.Number.ToString("0000")</a>
                            raised as the purchase order.
                        </p>
                        @if (CanEdit)
                        {
                            <button type="button" class="text-xs text-accent hover:underline" disabled="@busy"
                                    title="Draft the work-order email to the winning subcontractor in the shared mailbox — reviewed and sent from Outlook, nothing sends from here."
                                    @onclick="OpenWorkOrderEmailModal">Email work order to winner</button>
                        }
                    </div>
                    @if (woEmailNote is not null)
                    {
                        <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-sm text-content mb-3">
                            @woEmailNote
                            @if (woEmailLink is not null)
                            {
                                <a class="text-accent underline ml-1" href="@woEmailLink" target="_blank" rel="noopener">Open the draft in Outlook</a>
                            }
                        </p>
                    }
                }

                <LoadGate IsLoading="@(!QuotesReady)" Prominent="true" Label="Loading tender submissions">
                @if (quotes.Count == 0)
                {
                    @* Only once the fetch has answered — the banner above carries a failure. *@
                    @if (fetchedQuotes is not null)
                    {
                        <p class="text-sm text-content-subtle italic">
                            No tender submissions yet. File each returned tender email from the Control
                            Centre (System actions → File Bid Package Tender) and it appears above ready
                            to extract — or use “Record tender manually” for a tender phoned through or
                            posted.
                        </p>
                    }
                }
                else
                {
                    <div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
                        <table class="w-full text-sm">
                            <thead class="bg-surface-raised border-b border-line">
                                <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2">Line item</th>
                                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2 hidden sm:table-cell">Qty</th>
                                    @foreach (var quote in quotes)
                                    {
                                        var sub = Subs.Find(quote.SubcontractorId);
                                        var won = recipients.Any(r =>
                                            string.Equals(r.SubcontractorId, quote.SubcontractorId, StringComparison.OrdinalIgnoreCase)
                                            && r.Status == BidPackageRecipientStatus.Won);
                                        <th class="sticky top-0 z-20 bg-surface-raised px-4 py-2 text-right">
                                            @(sub?.CompanyName ?? quote.SubcontractorId)
                                            @if (won)
                                            {
                                                <span class="ml-1.5 inline-flex items-center rounded-full bg-positive/10 border border-positive/30 px-1.5 py-0.5 text-[10px] font-medium text-positive normal-case tracking-normal">Won</span>
                                            }
                                            @if (sub is { IsProspect: true } && CanAddToDirectory)
                                            {
                                                @* A submitted tender is the moment to judge quality — this is the
                                                   deliberate act that puts a tender-only prospect in the Directory. *@
                                                <span class="block mt-1">
                                                    <button type="button" class="btn-secondary px-2 py-0.5 text-[11px] normal-case tracking-normal font-medium" disabled="@busy"
                                                            title="This company isn't in the Directory — it was only added to this tender list. Add it if the tender's worth keeping them for."
                                                            @onclick="() => AddToDirectory(sub!.SubcontractorId)">Add to directory</button>
                                                </span>
                                            }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line">
                                @foreach (var item in lineItems)
                                {
                                    <tr>
                                        <td class="px-4 py-2 text-content">@item.Description</td>
                                        <td class="px-4 py-2 text-content-muted hidden sm:table-cell">@item.Quantity @item.Unit</td>
                                        @foreach (var quote in quotes)
                                        {
                                            var line = quoteLines.FirstOrDefault(l => l.QuoteId == quote.QuoteId && l.BidPackageLineItemId == item.LineItemId);
                                            <td class="px-4 py-2 text-right text-content-muted">
                                                @(line is null ? "—" : line.Total.ToString("£#,##0.00"))
                                            </td>
                                        }
                                    </tr>
                                }
                                @{ var extras = quoteLines.Where(l => l.BidPackageLineItemId is null).ToList(); }
                                @if (extras.Count > 0)
                                {
                                    <tr>
                                        <td class="px-4 py-2 text-content-subtle italic">Outside package scope</td>
                                        <td class="px-4 py-2 hidden sm:table-cell"></td>
                                        @foreach (var quote in quotes)
                                        {
                                            var sum = extras.Where(l => l.QuoteId == quote.QuoteId).Sum(l => l.Total);
                                            <td class="px-4 py-2 text-right text-content-subtle italic">@(sum == 0 ? "—" : sum.ToString("£#,##0.00"))</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-surface-raised border-t border-line">
                                <tr class="font-semibold text-content">
                                    <td class="px-4 py-2">Total</td>
                                    <td class="px-4 py-2 hidden sm:table-cell"></td>
                                    @foreach (var quote in quotes)
                                    {
                                        <td class="px-4 py-2 text-right">@quote.Value.ToString("£#,##0.00")</td>
                                    }
                                </tr>
                                @if (CanEdit && package.Status != BidPackageStatus.Awarded)
                                {
                                    <tr>
                                        <td class="px-4 py-2"></td>
                                        <td class="px-4 py-2 hidden sm:table-cell"></td>
                                        @foreach (var quote in quotes)
                                        {
                                            <td class="px-4 py-2 text-right">
                                                <button type="button" class="text-xs text-accent hover:underline" disabled="@busy"
                                                        @onclick="() => AwardTo(quote)">Award</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>

                    @foreach (var quote in quotes.Where(q => !string.IsNullOrWhiteSpace(q.Notes)))
                    {
                        var sub = Subs.Find(quote.SubcontractorId);
                        <p class="text-xs text-content-subtle mt-2"><span class="font-medium text-content-muted">@(sub?.CompanyName ?? quote.SubcontractorId):</span> @quote.Notes</p>
                    }
                }
                </LoadGate>
            </section>

            }

            @if (activeTab == "documents")
            {
            @* ---- Documents: project drawings linked to this package ---- *@
            <section class="mb-8">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Documents</h3>
                    @if (CanEdit)
                    {
                        <div class="flex items-center gap-4">
                            <label class="text-xs text-accent hover:underline cursor-pointer @(busy ? "opacity-50 pointer-events-none" : "")">
                                + Add files
                                <InputFile OnChange="OnAttachmentFilesSelected" multiple class="hidden" />
                            </label>
                            <button type="button" class="text-xs text-accent hover:underline" @onclick="OpenDrawingsModal">Link drawings</button>
                        </div>
                    }
                </div>

                <LoadGate IsLoading="@(!DrawingsReady)" Label="Loading documents">
                @if (packageAttachments.Count > 0)
                {
                    <ul class="space-y-2 mb-3">
                        @foreach (var attachment in packageAttachments)
                        {
                            <li class="rounded-lg border border-line bg-surface px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <a class="text-sm font-medium text-content hover:underline"
                                       href="@PackageAttachments.FileUrl(BidPackageId, attachment.BidPackageAttachmentId)" download>@attachment.DisplayName</a>
                                    <span class="text-xs text-content-subtle ml-2">@FormatFileSize(attachment.FileSizeBytes)</span>
                                </div>
                                @if (CanEdit)
                                {
                                    <button type="button" class="text-xs text-content-muted hover:text-negative" disabled="@busy"
                                            @onclick="() => RemoveAttachment(attachment)">Remove</button>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (packageDrawings.Count == 0 && packageAttachments.Count == 0)
                {
                    @* Only once the fetch has answered — the banner above carries a failure. *@
                    @if (fetchedPackageDrawings is not null)
                    {
                        <div class="rounded-xl border border-dashed border-line bg-surface-raised px-4 py-5 text-sm text-content-subtle">
                            No tender documents yet. Upload files with “+ Add files”, or link drawings from the
                            project's Drawings section — everything here is attached to the invite email when it's
                            drafted, along with the generated pricing schedule (files too large for one email go
                            out as 7-day download links instead).
                        </div>
                    }
                }
                else if (packageDrawings.Count > 0)
                {
                    <ul class="space-y-2">
                        @foreach (var drawing in packageDrawings)
                        {
                            <li class="rounded-lg border border-line bg-surface px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                                <div>
                                    <span class="text-sm font-medium text-content">@DrawingNaming.Code(drawing)</span>
                                    <span class="text-sm text-content-muted ml-2">@DrawingNaming.Name(drawing)</span>
                                </div>
                                <div class="flex items-center gap-3">
                                    <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium @(drawing.HasApprovedRevision ? "border-line bg-surface-raised text-content-muted" : "border-amber-200 bg-amber-50 text-amber-800")">
                                        @(DrawingNaming.ApprovedRevisionText(drawing) ?? "No approved revision")
                                    </span>
                                    <a class="text-xs text-accent hover:underline" href="@($"/projects/{ProjectId}/drawings/{drawing.DrawingId}")">Open</a>
                                </div>
                            </li>
                        }
                    </ul>
                }
                </LoadGate>
            </section>

            }

            @if (activeTab == "emails")
            {
            @* ---- Tender responses & related emails (read live by the package's tag) ----
                   The shared thread list carries the consistent communications widget — threads,
                   full email on demand, attachments with preview/download, tag chips, and the
                   Reply/Forward affordance: replying from here SENDS there and then from the
                   projects mailbox, and the sent copy inherits the thread's tags, so it files
                   straight back into this list. *@
            <section>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="eyebrow">Tender responses & related emails</h3>
                    <div class="flex items-center gap-3">
                        @if (fetchedEmails is not null && emails.Count > 0)
                        {
                            <span class="inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@emails.Count</span>
                        }
                        @* Search the whole mailbox and tag what belongs here — the list below AND
                           the assistant's read_record_emails both get richer with each tag. *@
                        <EmailFinder Type="RecordType.BidPackageInvite" RecordId="@BidPackageId"
                                     RecordReference="@package.Reference" ExcludeTag="@($"JPMS/{package.Reference}")"
                                     OnLinked="ReloadEmailsAsync" />
                    </div>
                </div>
                <LoadGate IsLoading="@(!EmailsReady)" Prominent="true" Label="Loading related emails">
                @if (commsReplySent is not null)
                {
                    <div class="rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
                        <p class="text-sm text-content">@commsReplySent</p>
                        <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                @onclick="() => commsReplySent = null">✕</button>
                    </div>
                }
                @if (commsReplyTo is { } replyingTo)
                {
                    <div class="mb-3 space-y-2">
                        <p class="text-sm text-content-muted">
                            @(commsComposeIsForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@(string.IsNullOrWhiteSpace(replyingTo.FromName) ? replyingTo.FromEmail : replyingTo.FromName)</span> —
                            <span class="italic">@replyingTo.Subject</span>
                        </p>
                        <MailReplyComposer @ref="commsComposer" @key="@($"{replyingTo.Id}:{commsComposeIsForward}")" ReplyTo="replyingTo" Forward="commsComposeIsForward"
                                           Projects="@(ProjectList.Current ?? Array.Empty<Project>())" ProjectId="@ProjectId"
                                           FooterNote="@(commsComposeIsForward
                                               ? "The forward sends now from the projects mailbox and files itself back into this list."
                                               : "The reply sends now from the projects mailbox and files itself back into this list.")"
                                           OnSent="OnCommsReplySent" OnCancel="CancelCommsCompose"
                                           />
                    </div>
                }
                @if (emails.Count == 0)
                {
                    @* Only once the fetch has answered — the banner above carries a failure. *@
                    @if (fetchedEmails is not null)
                    {
                        <p class="text-sm text-content-subtle italic">
                            No emails tagged to this bid package. Replies to the invite land in Triage —
                            tag them with @package.Reference and they appear here.
                        </p>
                    }
                }
                else
                {
                    <CorrespondenceThreadList Emails="emails" ExcludeTag="@($"JPMS/{package.Reference}")"
                                              OnReply="email => StartCommsCompose(email, forward: false)"
                                              OnForward="email => StartCommsCompose(email, forward: true)"
                                              OnUntagged="_ => ReloadEmailsAsync()" />
                }
                </LoadGate>
            </section>
            }
        }
        </LoadGate>
    </ProjectPageShell>

    @* ---- Add-subcontractor modal: the directory, searchable ---- *@
    <Modal IsOpen="showInviteModal" Title="Add subcontractors to the tender list" ShowFooter="true"
           ConfirmLabel="@(InviteCount() == 0 ? "Add to tender list" : $"Add {InviteCount()} to tender list")" ConfirmDisabled="@(busy || InviteCount() == 0)" CancelLabel="Cancel"
           OnCancel="CloseInviteModal" OnConfirm="ConfirmInvite" Class="max-w-lg w-full">
        <div class="mb-3 flex gap-2">
            <input class="field flex-1" placeholder="Search by company, trade or contact…"
                   value="@subSearch" @oninput="OnSearchInput" />
            @* Trade filter — a compact dropdown (the full chip list overwhelmed the modal). *@
            @if (InvitableTrades().Count > 1)
            {
                <select class="field w-44 shrink-0" value="@(tradeFilter ?? "")"
                        @onchange="e => tradeFilter = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                    <option value="">All trades</option>
                    @foreach (var trade in InvitableTrades())
                    {
                        <option value="@trade">@trade</option>
                    }
                </select>
            }
        </div>
        @if (Invitable().Count == 0)
        {
            <p class="text-sm text-content-subtle italic">No matching subcontractors in the directory.</p>
        }
        else
        {
            <div class="space-y-1 max-h-80 overflow-y-auto">
                @foreach (var sub in Invitable())
                {
                    <label class="flex items-center gap-2 text-sm text-content py-1">
                        <input type="checkbox" checked="@selected.Contains(sub.SubcontractorId)"
                               @onchange="e => Toggle(sub.SubcontractorId, e)" />
                        <span class="font-medium">@sub.CompanyName</span>
                        <span class="text-content-subtle">· @sub.TradesLabel</span>
                        @if (string.IsNullOrWhiteSpace(sub.ContactEmail))
                        {
                            <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-1.5 py-0.5 text-[10px] font-medium text-amber-800">No email</span>
                        }
                    </label>
                }
            </div>
        }

        @* Ad-hoc invite: saved as a tender-only prospect, then included in this invite list.
           They only reach the Directory if promoted from a submitted tender (or by winning). *@
        <div class="mt-4 pt-4 border-t border-line">
            <p class="text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Not in the directory?</p>
            <p class="text-xs text-content-subtle mb-2">Add their details — they're included in this invite without joining the Directory. If their tender's good, add them to the Directory from it.</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                <input class="field" placeholder="Company or name *" @bind="quickAddName" @bind:event="oninput" />
                <input class="field" type="email" placeholder="Email address *" @bind="quickAddEmail" @bind:event="oninput" />
                <select class="field" @bind="quickAddTradeId">
                    <option value="">Trade…</option>
                    @foreach (var trade in Subs.Trades())
                    {
                        <option value="@trade.TradeId">@trade.Name</option>
                    }
                </select>
            </div>
            @if (quickAddPartial)
            {
                <p class="text-xs text-amber-800 mt-1">Enter both a name and a valid email address to include them.</p>
            }
        </div>
    </Modal>

    @* ---- Find local subcontractors: Google Places search near the project's site.
         The finder owns the trade resolution, the search and the selection; ticked
         companies come back with the trade term and are saved + invited here. ---- *@
    <LocalSubcontractorFinderModal IsOpen="showFindModal"
                                   BidPackageId="@BidPackageId"
                                   ProjectId="@ProjectId"
                                   FallbackTrade="@(package?.Trade ?? "")"
                                   Busy="busy"
                                   OnCancel="CloseFindModal"
                                   OnConfirm="ConfirmFindInvite" />

    @* ---- Line-item coverage modal: link to a contract BoQ line OR a variation ---- *@
    <Modal IsOpen="showCoverageModal" Title="Link line item" ShowFooter="true"
           ConfirmLabel="Save" CancelLabel="Cancel"
           OnCancel="CloseCoverageModal" OnConfirm="ConfirmCoverage" Class="max-w-lg w-full">
        @if (linkingLine is not null)
        {
            <p class="text-sm text-content mb-1 font-medium">@linkingLine.Description</p>
            <p class="text-xs text-content-subtle mb-4">A line is covered by a cost centre (the contract-side home its committed value charges to) or a variation order — never both.</p>

            <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Covered by</label>
            <select class="field" @bind="coverageChoice">
                <option value="@BidPackageLineCoverage.Unassigned">Not linked</option>
                <option value="@BidPackageLineCoverage.ContractLine">Cost centre</option>
                <option value="@BidPackageLineCoverage.Variation">Variation order</option>
            </select>

            @if (coverageChoice == BidPackageLineCoverage.ContractLine)
            {
                <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mt-3 mb-1">Cost centre</label>
                <select class="field" @bind="coverageCostCode">
                    <option value="">Select a cost centre…</option>
                    @foreach (var centre in CostCenters.Alphabetical)
                    {
                        <option value="@centre.Code">@($"{centre.Code} — {centre.Name}")</option>
                    }
                </select>
            }
            else if (coverageChoice == BidPackageLineCoverage.Variation)
            {
                <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mt-3 mb-1">Variation order</label>
                @if (variations.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">No variation orders on this project yet.</p>
                }
                else
                {
                    <select class="field" @bind="coverageVariationId">
                        <option value="">Select a variation…</option>
                        @foreach (var v in variations)
                        {
                            <option value="@v.VariationOrderId">@v.DisplayNumber — @v.Title</option>
                        }
                    </select>
                }
            }
        }
    </Modal>

    @* ---- Link project drawings to the package (the tender documents) ---- *@
    <Modal IsOpen="showDrawingsModal" Title="Link drawings" ShowFooter="true"
           ConfirmLabel="@(busy ? "Saving…" : $"Link {selectedDrawingIds.Count}")" CancelLabel="Cancel"
           OnCancel="CloseDrawingsModal" OnConfirm="ConfirmDrawings" Class="max-w-lg w-full">
        @if (projectDrawings.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No drawings on this project yet. Upload them in the Drawings tab, or send an email's
                attachment to Document Triage and file it to drawings from there.
            </p>
        }
        else
        {
            <p class="text-xs text-content-subtle mb-3">Linked drawings are attached to the invite email (latest approved revision, or the newest upload when none is approved). Files that would push the email over the 25&nbsp;MB limit are sent as download links that expire after 7 days.</p>
            <div class="space-y-1 max-h-80 overflow-y-auto">
                @foreach (var drawing in projectDrawings)
                {
                    <label class="flex items-center gap-2 text-sm text-content py-1">
                        <input type="checkbox" checked="@selectedDrawingIds.Contains(drawing.DrawingId)"
                               @onchange="e => ToggleDrawing(drawing.DrawingId, e)" />
                        <span class="font-medium">@DrawingNaming.Code(drawing)</span>
                        <span class="text-content-subtle truncate">· @DrawingNaming.Name(drawing)</span>
                        @if (DrawingNaming.ApprovedRevisionText(drawing) is { } approvedText)
                        {
                            <span class="text-content-subtle">· @approvedText</span>
                        }
                    </label>
                }
            </div>
        }
    </Modal>

    @* ---- The invite composer: compose, persist, SEND — all in here, like a triage reply.
         The tender list is pre-filled into BCC (subcontractors never see each other) and the
         whole envelope stays editable. The draft persists ON the package (Save draft, and
         quietly on Cancel), so a half-written invite survives for anyone on the team.
         Overlay-dismiss off: a stray click must not lose a composed email. ---- *@
    <Modal IsOpen="showComposeModal" Title="Tender invite email" DismissOnOverlayClick="false"
           OnCancel="CloseComposeModal" Class="max-w-3xl w-full">
        <FooterContent>
            <button type="button" class="btn-secondary" disabled="@(busy || savingDraft)" @onclick="SaveInviteDraft">
                @(savingDraft ? "Saving…" : "Save draft")
            </button>
            <button type="button" class="btn-neutral" disabled="@busy" @onclick="CloseComposeModal">Close</button>
            <button type="button" class="btn-primary" disabled="@(busy || ComposeRecipientCount() == 0)" @onclick="ConfirmSendInvite">
                @(busy ? "Sending…" : ComposeRecipientCount() == 0 ? "No recipients" : $"Send to {ComposeRecipientCount()} recipient{(ComposeRecipientCount() == 1 ? "" : "s")}")
            </button>
        </FooterContent>
        <ChildContent>
        <p class="text-xs text-content-subtle mb-3">
            Sends now, from the projects mailbox — no trip to Outlook. Recipients are pre-filled into
            BCC so subcontractors never see each other; the whole envelope is editable. The email is
            tagged to this package, and tagged replies appear under Tender responses.
            <span> Attached automatically: the pricing schedule (@(package?.Reference ?? "BPI")&nbsp;- Pricing Schedule.xlsx, generated from the line items) and the company terms &amp; conditions (when uploaded in Admin → System).</span>
            @if (packageAttachments.Count > 0 || packageDrawings.Count > 0)
            {
                <span> Plus @(packageAttachments.Count + packageDrawings.Count) tender document@(packageAttachments.Count + packageDrawings.Count == 1 ? "" : "s") — any that would push the email over the 25&nbsp;MB limit go out as 7-day download links instead.</span>
            }
        </p>

        @if (composeDraftSavedAt is { } savedAt)
        {
            <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-xs text-content mb-3">
                Picked up the saved draft from @savedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm").
            </p>
        }
        @if (MissingEmail().Count > 0)
        {
            <p class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800 mb-3">
                Won't receive it (no email address in the directory): @string.Join(", ", MissingEmail()).
                Add their email in the <a class="underline" href="/directory">Directory</a> and reopen this window.
            </p>
        }
        @if (lineItems.Count == 0)
        {
            <p class="rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800 mb-3">
                This package has no line items yet, so the pricing schedule has nothing to price.
                You can still send — or close, add line items, and come back (the draft keeps).
            </p>
        }

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">To</label>
        <input class="field mb-1" @bind="composeTo" placeholder="Leave empty — the projects mailbox addresses itself, recipients stay in BCC" />
        <p class="text-[11px] text-content-subtle mb-3">Semicolon-separated addresses. Empty means the projects mailbox is the visible addressee — the norm for a BCC'd invite.</p>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Cc</label>
        <input class="field mb-3" @bind="composeCc" placeholder="Optional — internal people to copy in" />

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Bcc — the tender list</label>
        <textarea class="field mb-3" rows="2" @bind="composeBcc"></textarea>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Subject</label>
        <input class="field mb-3" @bind="composeSubject" />

        <div class="flex items-center justify-between mb-1">
            <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle">Message</label>
            <button type="button" class="text-xs text-accent hover:underline" @onclick="() => editingBody = !editingBody">
                @(editingBody ? "Back to preview" : "Edit message (HTML)")
            </button>
        </div>
        @if (editingBody)
        {
            <textarea class="field font-mono text-xs" rows="14" @bind="composeBody"></textarea>
            <p class="text-[11px] text-content-subtle mt-1">Sent as HTML — the pre-filled message includes the package's line items for pricing, when there are any.</p>
        }
        else
        {
            <div class="rounded-lg border border-line bg-white text-gray-900 p-4 text-sm max-h-80 overflow-y-auto">
                @((MarkupString)composeBody)
            </div>
            <p class="text-[11px] text-content-subtle mt-1">This is how the email will look to a tenderer.</p>
        }
        </ChildContent>
    </Modal>

    @* ---- Record a tender submission and save it as a quote ---- *@
    <Modal IsOpen="showExtractModal" Title="Tender submission" ShowFooter="true"
           ConfirmLabel="@(busy ? "Saving…" : "Save submission")" ConfirmDisabled="@(busy || extractBusy)" CancelLabel="Cancel"
           OnCancel="CloseExtractModal" OnConfirm="ConfirmSaveExtracted" Class="max-w-3xl w-full">
        @if (extractSourceEmail is { } sourceEmail)
        {
            <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
                Extracted from <span class="font-medium text-content">@(string.IsNullOrWhiteSpace(sourceEmail.FromName) ? sourceEmail.FromEmail : sourceEmail.FromName)</span>'s
                email of @sourceEmail.ReceivedAt.LocalDateTime.ToString("d MMM yyyy") — the figures below are
                THEIR submission as the AI read it. Review every line (and correct it where the read is
                wrong) before saving; nothing is recorded until you do.
            </p>
        }
        else
        {
            <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
                Recording a tender as the subcontractor gave it — the package's line items are pre-filled;
                enter the rates from their submission.
            </p>
        }

        @if (extractBusy)
        {
            <div class="flex items-center gap-3 rounded-lg border border-line bg-surface-raised px-3 py-4 mb-3">
                <JewelSpinner />
                <p class="text-sm text-content-muted">Reading the tender — the email, its pricing schedule and the package's line items…</p>
            </div>
        }
        else
        {
        @if (extractIssues.Count > 0)
        {
            <div class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 text-sm text-content mb-3">
                <p class="font-medium mb-1">@(extractProposed ? "The extraction found gaps in this tender:" : "This tender couldn't be read automatically:")</p>
                <ul class="list-disc pl-5 space-y-0.5">
                    @foreach (var issue in extractIssues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
        }
        else if (extractSourceEmail is not null && extractComplete)
        {
            <p class="rounded-lg bg-positive/10 border border-positive/40 px-3 py-2 text-sm text-content mb-3">
                The tender reads complete — every line item is priced and the sums reconcile. Review the
                figures and save it as a submission.
            </p>
        }

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Subcontractor</label>
        <select class="field mb-3" @bind="extractSubcontractorId">
            <option value="">Select the subcontractor…</option>
            @foreach (var recipient in recipients)
            {
                var sub = Subs.Find(recipient.SubcontractorId);
                <option value="@recipient.SubcontractorId">@(sub?.CompanyName ?? recipient.SubcontractorId)</option>
            }
        </select>
        @if (extractSourceEmail is not null && !string.IsNullOrWhiteSpace(extractSubcontractorNote))
        {
            <p class="text-xs text-content-subtle -mt-2 mb-3">@extractSubcontractorNote</p>
        }

        <div class="rounded-xl border border-line bg-surface mb-3">
            <table class="w-full text-sm">
                <thead class="bg-surface-raised border-b border-line">
                    <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2">Description</th>
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2 hidden sm:table-cell">Unit</th>
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2">Qty</th>
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2">Rate</th>
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2">Total</th>
                        <th class="sticky top-0 z-20 bg-surface-raised px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @foreach (var draft in extractDrafts)
                    {
                        <tr class="@(draft.BidPackageLineItemId is null ? "bg-accent/5" : "")">
                            <td class="px-3 py-2"><input class="field" @bind="draft.Description" /></td>
                            <td class="px-3 py-2 hidden sm:table-cell"><input class="field w-16" @bind="draft.Unit" /></td>
                            <td class="px-3 py-2"><input class="field w-20" type="number" step="any" @bind="draft.Quantity" /></td>
                            <td class="px-3 py-2"><input class="field w-24" type="number" step="any" @bind="draft.Rate" @onblur="() => RecalcTotal(draft)" /></td>
                            <td class="px-3 py-2"><input class="field w-28" type="number" step="any" @bind="draft.Total" /></td>
                            <td class="px-3 py-2 text-right">
                                <button type="button" class="text-xs text-content-muted hover:text-negative" @onclick="() => extractDrafts.Remove(draft)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center justify-between mb-3">
            <button type="button" class="btn-secondary" @onclick="AddExtractLine">Add line</button>
            <p class="text-sm text-content font-medium">Total: @extractDrafts.Sum(d => d.Total).ToString("£#,##0.00")</p>
        </div>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Notes (exclusions, caveats, lead times)</label>
        <textarea class="field" rows="3" @bind="extractNotes"></textarea>
        }
    </Modal>

    @* ---- Work-order email to the winning subcontractor (drafted, sent from Outlook) ---- *@
    <Modal IsOpen="showWoEmailModal" Title="Email work order to winner" ShowFooter="true"
           ConfirmLabel="@(busy ? "Drafting…" : "Create draft in mailbox")" ConfirmDisabled="@busy" CancelLabel="Cancel"
           OnCancel="CloseWorkOrderEmailModal" OnConfirm="ConfirmWorkOrderEmailDraft" Class="max-w-3xl w-full">
        <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Nothing sends from here — this creates a draft in the shared mailbox, addressed to the winning
            subcontractor and tagged @package?.Reference, for you to review and send from Outlook.
        </p>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Subject</label>
        <input class="field mb-3" @bind="woEmailSubject" />

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Body (HTML)</label>
        <textarea class="field font-mono text-xs" rows="14" @bind="woEmailBody"></textarea>
    </Modal>

    @* ---- Delete: for packages raised in error (or unwanted AI suggestions). Awarded packages
         are refused server-side — the work order carries the committed money. ---- *@
    <Modal IsOpen="showDeleteModal" Title="Delete bid package"
           OnCancel="CloseDeleteModal" Class="max-w-lg w-full">
        <FooterContent>
            <button type="button" class="btn-neutral" disabled="@busy" @onclick="CloseDeleteModal">Keep it</button>
            <button type="button" class="btn-neutral text-negative border-negative/40" disabled="@busy" @onclick="ConfirmDelete">
                @(busy ? "Deleting…" : "Delete package")
            </button>
        </FooterContent>
        <ChildContent>
            <p class="text-sm text-content-muted mb-3">
                This deletes <span class="font-medium text-content">@package?.Title</span> for good, along with
                everything on it: invited subcontractors (the invites, not their directory entries), line items,
                tender submissions, attachments and drawing links. Emails tagged to the package stay in the mailbox.
            </p>
            <p class="text-xs text-content-subtle">
                If the tender simply ended with no winner, Close is the right record — deletion is for a package
                that shouldn't exist at all. This can't be undone.
            </p>
        </ChildContent>
    </Modal>

    @* ---- Edit package details (modal): summary + line schedule together, one Save.
         DismissOnOverlayClick off: a stray click must not throw away a half-keyed schedule. ---- *@
    <Modal IsOpen="showDetailsModal" Title="Edit package details" DismissOnOverlayClick="false"
           OnCancel="CancelDetails" Class="max-w-4xl w-full">
        <FooterContent>
            <button type="button" class="btn-secondary" disabled="@busy" @onclick="AddLine">Add line</button>
            <button type="button" class="btn-neutral" disabled="@busy" @onclick="CancelDetails">Cancel</button>
            <button type="button" class="btn-primary" disabled="@busy" @onclick="SaveDetails">@(busy ? "Saving…" : "Save details")</button>
        </FooterContent>
        <ChildContent>
            @if (error is not null)
            {
                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@error</p>
            }

            <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Specification summary</label>
            <p class="text-xs text-content-subtle mb-2">
                One point per line — it prints at the top of the pricing schedule each tenderer receives,
                so say what the package covers and to what standard.
            </p>
            <textarea class="field w-full min-h-28 mb-4" rows="6"
                      placeholder="One point per line — e.g. All flat roofing to BS 6229:2018."
                      @bind="specDraft"></textarea>

            <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Line items</label>
            <div class="rounded-xl border border-line bg-surface overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-surface-raised border-b border-line">
                        <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                            <th class="px-3 py-2">Trade</th>
                            <th class="px-3 py-2">Description</th>
                            <th class="px-3 py-2 hidden sm:table-cell">Unit</th>
                            <th class="px-3 py-2">Qty</th>
                            <th class="px-3 py-2">Cost code</th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line">
                        @for (var i = 0; i < lineDrafts.Count; i++)
                        {
                            var draft = lineDrafts[i];
                            <tr>
                                <td class="px-3 py-2"><input class="field" @bind="draft.Trade" placeholder="e.g. Electrical" /></td>
                                <td class="px-3 py-2"><input class="field" @bind="draft.Description" placeholder="Description" /></td>
                                <td class="px-3 py-2 hidden sm:table-cell"><input class="field" @bind="draft.Unit" placeholder="e.g. m²" /></td>
                                <td class="px-3 py-2"><input class="field" type="number" step="any" @bind="draft.Quantity" /></td>
                                <td class="px-3 py-2">
                                    <select class="field min-w-[14rem]" @bind="draft.CostCode">
                                        <option value="">Cost centre…</option>
                                        @foreach (var centre in CostCenters.Alphabetical)
                                        {
                                            <option value="@centre.Code">@($"{centre.Code} — {centre.Name}")</option>
                                        }
                                    </select>
                                </td>
                                <td class="px-3 py-2 text-right">
                                    <button type="button" class="btn-neutral px-2 py-1 text-xs text-negative border-negative/40" @onclick="() => RemoveLine(draft)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ChildContent>
    </Modal>

    @* ---- Select line items from the valuation report: the fast path onto the package.
         The picker owns its own read of the live report; confirmed rows come back as
         package line inputs and are appended through AddBidPackageLineItems. ---- *@
    <ValuationLinePickerModal IsOpen="showValuationPicker"
                              ProjectId="@ProjectId"
                              DefaultTrade="@(package?.Trade ?? "")"
                              Busy="busy"
                              OnCancel="CloseValuationPicker"
                              OnConfirm="AppendValuationLinesAsync" />
}

