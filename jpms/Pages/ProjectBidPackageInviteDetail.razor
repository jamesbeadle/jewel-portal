@page "/projects/{ProjectId}/bid-package-invites/{BidPackageId}"
@using Jewel.JPMS.Contracts.Subcontractors
@using Jewel.JPMS.Contracts.Boq
@using Jewel.JPMS.Contracts.Drawings
@using Jewel.JPMS.Contracts.Variations
@using System.Text.Json
@using Jewel.JPMS.Features.CostCenters
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Procurement
@inject AuthService Auth
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList
@inject SessionService Session
@inject IQueryClient Queries
@inject ICommandSender Commands
@inject CostCentersReadModel CostCenters
@inject ISubcontractorStore Subs
@inject IBidPackageAttachmentStore PackageAttachments
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel SubsReadModel
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Bid Package Invite · JPMS</PageTitle>

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else
{
    <ProjectPageShell ProjectId="@ProjectId" ActiveTab="bid-package-invites">
        <nav class="mb-4 text-sm">
            <a href="@($"/projects/{ProjectId}/bid-package-invites")" class="text-content-subtle hover:text-content underline underline-offset-4">Bid package invites</a>
        </nav>

        @if (error is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4 whitespace-pre-wrap">@error</p>
        }

        <LoadGate IsLoading="@(package is null && !loadAttempted)" Prominent="true" Label="Loading bid package">
        @if (package is null)
        {
            <p class="text-sm text-content-subtle italic">That bid package could not be loaded.</p>
        }
        else
        {
            <header class="mb-6 flex flex-wrap items-start justify-between gap-3">
                <div>
                    @if (!string.IsNullOrWhiteSpace(package.Reference))
                    {
                        <p class="text-xs font-mono tracking-wide text-content-subtle mb-0.5">@package.Reference</p>
                    }
                    <div class="flex items-center gap-3">
                        <h2 class="text-lg font-semibold text-content">@package.Title</h2>
                        <span class="inline-flex items-center rounded-full bg-surface-raised border border-line px-2 py-0.5 text-[11px] font-medium text-content-muted">@package.Status</span>
                    </div>
                    <p class="text-sm text-content-muted">@package.Trade</p>
                    @if (CanEdit)
                    {
                        <label class="mt-1.5 flex items-center gap-2 text-xs text-content-muted cursor-pointer"
                               title="When ticked, the tender-invite email asks each subcontractor to state whether they will supply their own materials or price labour-only.">
                            <input type="checkbox" checked="@package.MaterialsApplicable" disabled="@busy"
                                   @onchange="e => ToggleMaterialsApplicable(e.Value is true)" />
                            Materials apply — ask tenderers whether they supply their own
                        </label>
                    }
                    else if (package.MaterialsApplicable)
                    {
                        <p class="text-xs text-content-subtle mt-1.5">Materials apply — the invite asks tenderers whether they supply their own.</p>
                    }
                </div>
                @if (CanManage && package.Status != BidPackageStatus.Awarded)
                {
                    @* The record's actions in one place — the same DropdownMenu the request page's
                       Actions uses. Create with AI leads: the assistant reads the package's context
                       (spec, lines, documents, tagged emails) and fills the editing dialogs for
                       review — nothing saves until the user presses the dialog's own button. *@
                    <DropdownMenu Label="Actions" Disabled="@busy" Items="@HeaderActions()" />
                }
            </header>

            @if (IsClosed)
            {
                <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-sm text-content-muted mb-6">
                    Closed@(package.ClosedAt is { } closedAt ? $" on {closedAt.LocalDateTime:d MMM yyyy}" : "") — the tender ended with no winner selected. Reopen it to continue.
                </p>
            }

            @* ---- Section tabs — the chip pattern the RFIs register uses; Details leads.
                   Local panes like the request page's tabs: one section renders at a time,
                   nothing about each section's markup changes. ---- *@
            <div class="flex flex-wrap items-center gap-2 mb-5 text-sm">
                @foreach (var tab in SectionTabs)
                {
                    var key = tab.Key;
                    <button type="button" class="@TabClass(key)" @onclick="() => activeTab = key">@tab.Label</button>
                }
            </div>

            @if (activeTab == "tender-list")
            {
                <InvitedSubcontractorsSection Recipients="recipients"
                                              Loaded="RecipientsReady" Fetched="@(fetchedRecipients is not null)"
                                              CanEdit="CanEdit" CanAddToDirectory="CanAddToDirectory" Busy="busy"
                                              ReadyForInvites="PackageReadyForInvites"
                                              SendNote="@sendNote" DraftWebLink="@draftWebLink"
                                              OnComposeInvite="OpenComposeModal"
                                              OnFindSubcontractors="OpenFindModal"
                                              OnAddSubcontractor="OpenInviteModal"
                                              OnAddToDirectory="AddToDirectory"
                                              OnSetDeclined="pick => SetDeclined(pick.Recipient, pick.Declined)"
                                              OnRemove="RemoveRecipient" />
            }

            @if (activeTab == "details")
            {
                <PackageDetailsSections SpecificationSummary="@(package.SpecificationSummary ?? "")"
                                        LineItems="lineItems"
                                        Loaded="LineItemsReady" Fetched="@(fetchedLineItems is not null)"
                                        CanEdit="CanEdit" Busy="busy"
                                        CostCentreLabel="CostCentreLabel" CoverageLabel="CoverageLabel"
                                        OnEditDetails="EditDetails"
                                        OnSelectLineItems="OpenValuationPicker"
                                        OnLinkCoverage="OpenCoverageModal" />
            }

            @if (activeTab == "submissions")
            {
                <TenderSubmissionsSection ProjectId="@ProjectId"
                                          CanEdit="CanEdit" CanAddToDirectory="CanAddToDirectory" Busy="busy"
                                          HasRecipients="@(recipients.Count > 0)"
                                          Emails="emails"
                                          AwardNote="@awardNote"
                                          Awarded="@(package.Status == BidPackageStatus.Awarded ? AwardedOrder : null)"
                                          WorkOrderEmailNote="@woEmailNote" WorkOrderEmailLink="@woEmailLink"
                                          Quotes="quotes" QuoteLines="quoteLines" LineItems="lineItems" Recipients="recipients"
                                          Loaded="QuotesReady" Fetched="@(fetchedQuotes is not null)"
                                          AwardEnabled="@(CanEdit && package.Status != BidPackageStatus.Awarded)"
                                          OnRecordManually="OpenManualTenderModal"
                                          OnExtractFromEmail="OpenExtractFromEmail"
                                          OnEmailWorkOrder="OpenWorkOrderEmailModal"
                                          OnAward="AwardTo"
                                          OnAddToDirectory="AddToDirectory" />
            }

            @if (activeTab == "documents")
            {
                <PackageDocumentsSection BidPackageId="@BidPackageId" ProjectId="@ProjectId"
                                         Attachments="packageAttachments" Drawings="packageDrawings"
                                         Loaded="DrawingsReady" Fetched="@(fetchedPackageDrawings is not null)"
                                         CanEdit="CanEdit" Busy="busy"
                                         OnFilesSelected="OnAttachmentFilesSelected"
                                         OnLinkDrawings="OpenDrawingsModal"
                                         OnRemoveAttachment="RemoveAttachment" />
            }

            @if (activeTab == "emails")
            {
            @* ---- Tender responses & related emails (read live by the package's tag) ---- *@
            <section>
                <RecordCorrespondencePanel Type="RecordType.BidPackageInvite" RecordId="@BidPackageId"
                                           RecordReference="@package.Reference" ProjectId="@ProjectId"
                                           Title="Tender responses & related emails" LoadingLabel="Loading related emails"
                                           Emails="emails" Loaded="EmailsReady"
                                           Error="@(EmailsReady && fetchedEmails is null ? "Couldn't load the related emails — the reason is in the banner above." : null)"
                                           OnReload="ReloadEmailsAsync">
                    <EmptyMessage>
                        No emails tagged to this bid package. Replies to the invite land in Triage —
                        tag them with @package.Reference and they appear here.
                    </EmptyMessage>
                </RecordCorrespondencePanel>
            </section>
            }
        }
        </LoadGate>
    </ProjectPageShell>

    @* ---- Add-subcontractor modal: the directory, searchable. The picker owns the search,
         filter, ticks and quick-add row; the ticked ids (and any quick-add contact) come back
         here to be saved and invited. ---- *@
    <SubcontractorInvitePickerModal IsOpen="showInviteModal"
                                    InvitedIds="@recipients.Select(r => r.SubcontractorId).ToList()"
                                    DefaultTrade="@(package?.Trade ?? "")"
                                    DefaultTradeId="@(CuratedTradeIdFor(package?.Trade) ?? "")"
                                    Busy="busy"
                                    OnCancel="CloseInviteModal"
                                    OnConfirm="ConfirmInvite" />

    @* ---- Find local subcontractors: Google Places search near the project's site.
         The finder owns the trade resolution, the search and the selection; ticked
         companies come back with the trade term and are saved + invited here. ---- *@
    <LocalSubcontractorFinderModal IsOpen="showFindModal"
                                   BidPackageId="@BidPackageId"
                                   ProjectId="@ProjectId"
                                   FallbackTrade="@(package?.Trade ?? "")"
                                   Busy="busy"
                                   OnCancel="CloseFindModal"
                                   OnConfirm="ConfirmFindInvite" />

    @* ---- Line-item coverage modal: link to a contract BoQ line OR a variation ---- *@
    <Modal IsOpen="showCoverageModal" Title="Link line item" ShowFooter="true"
           ConfirmLabel="Save" CancelLabel="Cancel"
           OnCancel="CloseCoverageModal" OnConfirm="ConfirmCoverage" Class="max-w-lg w-full">
        @if (linkingLine is not null)
        {
            <p class="text-sm text-content mb-1 font-medium">@linkingLine.Description</p>
            <p class="text-xs text-content-subtle mb-4">A line is covered by a cost centre (the contract-side home its committed value charges to) or a variation order — never both.</p>

            <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Covered by</label>
            <select class="field" @bind="coverageChoice">
                <option value="@BidPackageLineCoverage.Unassigned">Not linked</option>
                <option value="@BidPackageLineCoverage.ContractLine">Cost centre</option>
                <option value="@BidPackageLineCoverage.Variation">Variation order</option>
            </select>

            @if (coverageChoice == BidPackageLineCoverage.ContractLine)
            {
                <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mt-3 mb-1">Cost centre</label>
                <select class="field" @bind="coverageCostCode">
                    <option value="">Select a cost centre…</option>
                    @foreach (var centre in CostCenters.Alphabetical)
                    {
                        <option value="@centre.Code">@($"{centre.Code} — {centre.Name}")</option>
                    }
                </select>
            }
            else if (coverageChoice == BidPackageLineCoverage.Variation)
            {
                <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mt-3 mb-1">Variation order</label>
                @if (variations.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">No variation orders on this project yet.</p>
                }
                else
                {
                    <select class="field" @bind="coverageVariationId">
                        <option value="">Select a variation…</option>
                        @foreach (var v in variations)
                        {
                            <option value="@v.VariationOrderId">@v.DisplayNumber — @v.Title</option>
                        }
                    </select>
                }
            }
        }
    </Modal>

    @* ---- Link project drawings to the package (the tender documents) ---- *@
    <Modal IsOpen="showDrawingsModal" Title="Link drawings" ShowFooter="true"
           ConfirmLabel="@(busy ? "Saving…" : $"Link {selectedDrawingIds.Count}")" CancelLabel="Cancel"
           OnCancel="CloseDrawingsModal" OnConfirm="ConfirmDrawings" Class="max-w-lg w-full">
        @if (projectDrawings.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No drawings on this project yet. Upload them in the Drawings tab, or send an email's
                attachment to Document Triage and file it to drawings from there.
            </p>
        }
        else
        {
            <p class="text-xs text-content-subtle mb-3">Linked drawings are attached to the invite email (latest approved revision, or the newest upload when none is approved). Files that would push the email over the 25&nbsp;MB limit are sent as download links that expire after 7 days.</p>
            <div class="space-y-1 max-h-80 overflow-y-auto">
                @foreach (var drawing in projectDrawings)
                {
                    <label class="flex items-center gap-2 text-sm text-content py-1">
                        <input type="checkbox" checked="@selectedDrawingIds.Contains(drawing.DrawingId)"
                               @onchange="e => ToggleDrawing(drawing.DrawingId, e)" />
                        <span class="font-medium">@DrawingNaming.Code(drawing)</span>
                        <span class="text-content-subtle truncate">· @DrawingNaming.Name(drawing)</span>
                        @if (DrawingNaming.ApprovedRevisionText(drawing) is { } approvedText)
                        {
                            <span class="text-content-subtle">· @approvedText</span>
                        }
                    </label>
                }
            </div>
        }
    </Modal>

    @* ---- The invite composer: compose, persist on the package, SEND — the modal owns the
         whole flow, like a triage reply; each send's outcome comes back here for the banner,
         the package record and the email list. ---- *@
    <TenderInviteComposerModal @ref="inviteComposer"
                               BidPackageId="@BidPackageId"
                               Package="package"
                               LineItems="lineItems"
                               Recipients="recipients"
                               AttachedDocumentCount="@(packageAttachments.Count + packageDrawings.Count)"
                               CanEdit="CanEdit"
                               OnSent="OnInviteSent" />

    @* ---- Record a tender submission and save it as a quote — the modal owns the whole
         review flow; the page reloads when it reports a save. ---- *@
    <TenderSubmissionModal @ref="tenderSubmissionModal"
                           BidPackageId="@BidPackageId"
                           Recipients="recipients"
                           LineItems="lineItems"
                           Busy="busy"
                           CanEdit="CanEdit"
                           OnSaved="LoadAsync" />

    @* ---- Work-order email to the winning subcontractor (drafted, sent from Outlook) ---- *@
    <Modal IsOpen="showWoEmailModal" Title="Email work order to winner" ShowFooter="true"
           ConfirmLabel="@(busy ? "Drafting…" : "Create draft in mailbox")" ConfirmDisabled="@busy" CancelLabel="Cancel"
           OnCancel="CloseWorkOrderEmailModal" OnConfirm="ConfirmWorkOrderEmailDraft" Class="max-w-3xl w-full">
        <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Nothing sends from here — this creates a draft in the shared mailbox, addressed to the winning
            subcontractor and tagged @package?.Reference, for you to review and send from Outlook.
        </p>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Subject</label>
        <input class="field mb-3" @bind="woEmailSubject" />

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Body (HTML)</label>
        <textarea class="field font-mono text-xs" rows="14" @bind="woEmailBody"></textarea>
    </Modal>

    @* ---- Delete: for packages raised in error (or unwanted AI suggestions). Awarded packages
         are refused server-side — the work order carries the committed money. ---- *@
    <Modal IsOpen="showDeleteModal" Title="Delete bid package"
           OnCancel="CloseDeleteModal" Class="max-w-lg w-full">
        <FooterContent>
            <button type="button" class="btn-neutral" disabled="@busy" @onclick="CloseDeleteModal">Keep it</button>
            <button type="button" class="btn-neutral text-negative border-negative/40" disabled="@busy" @onclick="ConfirmDelete">
                @(busy ? "Deleting…" : "Delete package")
            </button>
        </FooterContent>
        <ChildContent>
            <p class="text-sm text-content-muted mb-3">
                This deletes <span class="font-medium text-content">@package?.Title</span> for good, along with
                everything on it: invited subcontractors (the invites, not their directory entries), line items,
                tender submissions, attachments and drawing links. Emails tagged to the package stay in the mailbox.
            </p>
            <p class="text-xs text-content-subtle">
                If the tender simply ended with no winner, Close is the right record — deletion is for a package
                that shouldn't exist at all. This can't be undone.
            </p>
        </ChildContent>
    </Modal>

    @* ---- Edit package details: summary + line schedule together, one Save. The dialog owns
         the drafts and the every-line-needs-a-cost-code rule; the trimmed schedule comes back
         here for the two save commands. ---- *@
    <PackageDetailsEditorModal IsOpen="showDetailsModal"
                               SpecificationSummary="@(package?.SpecificationSummary ?? "")"
                               LineItems="lineItems"
                               Busy="busy"
                               Error="@error"
                               OnCancel="CancelDetails"
                               OnSave="SaveDetails" />

    @* ---- Select line items from the valuation report: the fast path onto the package.
         The picker owns its own read of the live report; confirmed rows come back as
         package line inputs and are appended through AddBidPackageLineItems. ---- *@
    <ValuationLinePickerModal IsOpen="showValuationPicker"
                              ProjectId="@ProjectId"
                              DefaultTrade="@(package?.Trade ?? "")"
                              Busy="busy"
                              OnCancel="CloseValuationPicker"
                              OnConfirm="AppendValuationLinesAsync" />
}

