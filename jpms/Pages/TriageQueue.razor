    private void DiscardReplyDraft()
    {
        replyOpen = false;
        replyBody = "";
        replyAttachments = Array.Empty<ComposeDraftAttachment>();
    }

    // A contenteditable's "empty" is markup like <div><br></div>: strip tags before judging —
    // except an inline image, which is real content with no text at all.
    private static bool HtmlHasContent(string html)
    {
        if (string.IsNullOrWhiteSpace(html)) return false;
        if (html.Contains("<img", StringComparison.OrdinalIgnoreCase)) return true;
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", "");
        return !string.IsNullOrWhiteSpace(System.Net.WebUtility.HtmlDecode(text));
    }

    private void OnReplyAttachmentsChanged(IReadOnlyList<ComposeDraftAttachment> attachments) =>
        replyAttachments = attachments;

    private static IReadOnlyList<(string PartName, Microsoft.AspNetCore.Components.Forms.IBrowserFile File)> UploadPartsOf(
        IReadOnlyList<ComposeDraftAttachment> attachments) =>
        attachments
            .Where(a => a.File is not null)
            .Select(a => (a.Key, a.File!))
            .ToList();

    // "a@x; B <b@y>, c@z" → addresses. Display names in angle brackets are tolerated and stripped.
    private static List<ComposeRecipient> ParseRecipients(string field) =>
        (field ?? "")
        .Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(part =>
        {
            var open = part.LastIndexOf('<');
            var close = part.LastIndexOf('>');
            return open >= 0 && close > open ? part[(open + 1)..close].Trim() : part;
        })
        .Where(a => a.Contains('@'))
        .Select(a => new ComposeRecipient(a))
        .ToList();

    // ONE Send: applies whatever filing is set up in the panes above (record links, a new
    // record, to-dos), then sends the reply. Filing and replying are two halves of dealing with
    // an email — deliberately combinable, never forced apart. Filing runs first (each command
    // verifies its tags before saving); the send comes last so a filing failure stops everything
    // with the email still queued, and a send failure leaves the thread filed with the reply
    // safe in Drafts (the outcome banner says exactly which).
    private async Task DoSendReply(bool saveAsDraftOnly)
    {
        if (selected is null || busy) return;
        var to = ParseRecipients(replyToField);
        if (to.Count == 0) { actionError = "Add a To recipient."; return; }
        if (string.IsNullOrWhiteSpace(replySubject)) { actionError = "Write a subject."; return; }
        if (!HtmlHasContent(replyBody)) { actionError = "Write the reply first."; return; }
        // A half-filled Create form is a decision not yet made — finish it or clear it, rather
        // than have Send quietly skip it.
        if (mode == TriageMode.Create
            && (!string.IsNullOrWhiteSpace(createTitle) || !string.IsNullOrWhiteSpace(createProjectId))
            && (string.IsNullOrWhiteSpace(createTitle) || string.IsNullOrWhiteSpace(createProjectId)))
        {
            actionError = "Finish the new-record form above (project and subject/title) or clear it, then Send.";
            return;
        }

        var anchor = selected;
        var uploadParts = UploadPartsOf(replyAttachments);

        await RunAction(saveAsDraftOnly ? "Saving draft" : "Sending reply", async () =>
        {
            var filed = false;

            // 1. To-dos — the To-dos pane's own batch (with its project / request link), or the
            //    "Also add to-dos" section another pane opened.
            if (mode == TriageMode.GeneralTodo)
            {
                var drafts = CurrentTodoDrafts();
                if (drafts.Count > 0)
                {
                    busyLabel = "Creating to-dos";
                    var linkRequestId = string.IsNullOrWhiteSpace(createProjectId) ? null : NullIfBlank(createTodoLinkRequestId);
                    await Intake.CreateTodoItemsFromMessageAsync(new CreateTodoItemsFromMessage(
                        anchor.Id,
                        NullIfBlank(createProjectId),
                        drafts,
                        LinkRequestId: linkRequestId,
                        InternetMessageId: anchor.InternetMessageId,
                        Pathway: linkRequestId is null && pathway is { } chosenForTodos ? PathwayLabel(chosenForTodos) : null));
                    createTodoRows = new List<TodoDraftRow> { new() };
                    filed = true;
                }
            }
            else
            {
                filed |= await CreateRideAlongTodosAsync(ComposeContextProjectId) > 0;
            }

            // 2. Record filing chosen above: link every pick / create the new record, tag-first.
            if (mode == TriageMode.Link && linkRecordIds.Count > 0)
            {
                busyLabel = "Linking";
                foreach (var record in linkRecords.Where(r => linkRecordIds.Contains(r.RecordId)).ToList())
                {
                    await Intake.LinkMessageToRecordAsync(
                        anchor.Id, anchor.InternetMessageId, record.Type, record.RecordId,
                        pathway: CostCentrePathwayFor(record));
                    filed = true;
                }
            }
            else if (mode == TriageMode.Create
                && !string.IsNullOrWhiteSpace(createProjectId) && !string.IsNullOrWhiteSpace(createTitle))
            {
                if (pathway == TriagePathway.Subcontractor)
                {
                    busyLabel = "Creating bid package";
                    await Intake.CreateBidPackageFromMessageAsync(new CreateBidPackageFromMessage(
                        anchor.Id, createProjectId, createTitle.Trim(), createTrade?.Trim() ?? "",
                        InternetMessageId: anchor.InternetMessageId));
                }
                else
                {
                    busyLabel = "Creating request";
                    await Intake.CreateRequestFromMessageAsync(new CreateRequestFromMessage(
                        anchor.Id, createProjectId, createKind, "", createTitle.Trim(),
                        createDescription?.Trim() ?? "",
                        RaisedTo: NullIfBlank(createRaisedTo),
                        DrawingRef: NullIfBlank(createDrawingRef),
                        ResponseDue: ParseDate(createResponseDue),
                        InternetMessageId: anchor.InternetMessageId,
                        AddToProgramme: createAddToProgramme));
                }
                filed = true;
            }

            // 3. Send — last, so nothing above can be lost to a send failure. When a filing already
            //    dealt with the thread its record tag says more than Replied, so skip the stamp.
            busyLabel = saveAsDraftOnly ? "Saving draft" : "Sending reply";
            var command = new SendMailboxEmail(
                ReplyToMessageId: anchor.Id,
                ReplyToInternetMessageId: anchor.InternetMessageId,
                To: to,
                Cc: ParseRecipients(replyCcField),
                Bcc: ParseRecipients(replyBccField),
                Subject: replySubject.Trim(),
                Body: replyBody,
                BodyIsHtml: true,
                Attachments: replyAttachments.Select(a => a.ToRef()).ToList(),
                SaveAsDraftOnly: saveAsDraftOnly,
                Pathway: pathway?.ToString(),
                MarkThreadHandled: !filed);
            composeOutcome = await Intake.SendComposedEmailAsync(command, uploadParts);
            replyBody = "";
            replyOpen = false;
            replyAttachments = Array.Empty<ComposeDraftAttachment>();
        });
    }

