@page "/requests/triage"
@using Jewel.JPMS.Contracts.Audit
@using Jewel.JPMS.Contracts.Drawings
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Contracts.Requests
@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake
@inject TriageSortStorage SortStorage
@inject ITodoStore Todos
@inject IRequestRegister RequestRegister
@inject IDrawingStore DrawingStore
@inject ICommandSender Commands
@inject IQueryClient Queries
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@implements IDisposable

<PageTitle>Triage · JPMS</PageTitle>

@*
    Live-read triage. The mailbox is the single source of truth and nothing ever moves — triage just
    adds/removes category tags on the email. The Queue is Inbox messages with no JPMS tag (read live);
    the Discarded tab is messages tagged "JPMS/Discarded". Discard/restore/assign add or remove tags,
    each verified by reading the categories back. Nothing about un-triaged mail is stored in the database.
*@

@*
    Shared message body + attachments, used by both the Queue and Discarded detail panes. Declared
    before first use; reads the live `detail` / `selected` fields each time it is rendered.
*@
@{
    // Small paperclip glyph flagging an email as carrying attachments — shown on list rows
    // (queue / discarded / tagged) and thread panel rows. Inherits the row's text colour.
    RenderFragment PaperclipIcon =
        @<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="w-3 h-3 shrink-0" aria-hidden="true">
            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
        </svg>;

    // The to-do drafts editor (rows of Title / assignees / due / detail with per-assignee
    // fan-out), shared between the standalone To-dos action and the "Also add to-dos" section
    // every other action pane carries — capturing follow-ups is part of dealing with an email,
    // whatever else is done with it.
    RenderFragment TodoRowsEditor =@<text>
                @for (var i = 0; i < createTodoRows.Count; i++)
                {
                    var row = createTodoRows[i];
                    var rowNumber = i + 1;
                    <div @key="row" class="rounded-lg border border-line p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Item @rowNumber</p>
                            @if (createTodoRows.Count > 1)
                            {
                                <button type="button" class="text-xs text-content-subtle hover:text-negative" @onclick="() => RemoveTodoRow(row)">Remove</button>
                            }
                        </div>

                        <FormField Label="Title" Value="@row.Title" OnChange="v => row.Title = v" Required="true" />

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @* Assignees: pick as many as the item needs — a role, or a named person
                               within one. Each pick becomes its own TODO-#### on save (see
                               DoCreateTodos), so two assignees here means two independent items
                               rather than one shared between them. Picked assignees show as
                               removable chips and drop out of the picker so they can't be added
                               twice. *@
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Assigned to</label>
                                @if (row.Assignees.Count > 0)
                                {
                                    <div class="flex flex-wrap gap-1 mb-1.5">
                                        @foreach (var assigneeValue in row.Assignees.ToList())
                                        {
                                            var picked = assigneeValue;
                                            <span class="inline-flex items-center gap-1 rounded-full border border-line bg-surface-raised pl-2 pr-1 py-0.5 text-xs text-content">
                                                @TodoRoleLabel(picked)
                                                <button type="button" title="Remove assignee"
                                                        class="leading-none px-1 text-content-subtle hover:text-negative"
                                                        @onclick="() => RemoveTodoRole(row, picked)">&times;</button>
                                            </span>
                                        }
                                    </div>
                                }
                                @{ var roleOptions = AvailableTodoRoleOptions(row); }
                                <SearchSelect Options="@roleOptions" Value=""
                                              ValueChanged="v => AddTodoRole(row, v)"
                                              Placeholder="@TodoRolePlaceholder(row)"
                                              Disabled="@(roleOptions.Count == 0)"
                                              WidthClass="w-full" />
                                @if (row.Assignees.Count > 1)
                                {
                                    <p class="text-xs text-content-subtle mt-1">Raised as @row.Assignees.Count separate to-dos, one per assignee.</p>
                                }
                            </div>
                            <FormField Label="Due" Value="@row.Due" OnChange="v => row.Due = v" InputType="date" />
                        </div>

                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Detail</label>
                            <textarea class="field" rows="6" value="@row.Notes" @oninput="e => OnTodoNotesInput(row, e)"></textarea>
                        </div>
                    </div>
                }

                <button type="button" class="btn-secondary text-xs" @onclick="AddTodoRow">+ Add another item</button>
    </text>;

    // The collapsible "Also add to-dos" section carried by the Link / Create / Reply / Discard
    // panes: whatever else this action does, follow-up items can be captured in the same click.
    // The to-dos are created FIRST (their command verifies its tags before saving), then the
    // primary action runs — per-step feedback rather than a pretend transaction.
    RenderFragment RideAlongTodos =@<div class="rounded-lg border border-line p-3 space-y-3">
        <label class="flex items-center gap-2 text-sm text-content cursor-pointer select-none">
            <input type="checkbox" checked="@alsoTodos" @onchange="e => alsoTodos = e.Value is true" />
            Also add to-dos from this email
            <span class="text-xs text-content-subtle">— created first, then the action above runs</span>
        </label>
        @if (alsoTodos)
        {
            @TodoRowsEditor
        }
    </div>;

    RenderFragment MessageBody =@<text>
        @if (threadNote is not null)
        {
            <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-xs text-content">@threadNote</p>
        }
        <div class="rounded-lg bg-surface-raised border border-line p-3 max-h-[28rem] overflow-y-auto">
            @if (detailLoading)
            {
                <p class="text-sm text-content-subtle italic">Loading message…</p>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
            {
                <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto">@((MarkupString)detail.BodyHtml)</div>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml))
            {
                <p class="text-sm text-content whitespace-pre-wrap">@detail.BodyHtml</p>
            }
            else
            {
                <p class="text-sm text-content-subtle italic">@(selected is null ? "" : Dash(selected.BodyPreview))</p>
            }
        </div>

        @*
            Attachments: names, preview, download and save-to-drawings for the open email.
            Rendered directly under the body — above the thread panel — so a long thread
            never pushes the attachment names out of sight.
        *@
        @if (detail is not null && detail.Attachments.Count > 0)
        {
            <div class="rounded-lg bg-surface-raised border border-line p-3">
                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                    @detail.Attachments.Count attachment@(detail.Attachments.Count == 1 ? "" : "s")
                </p>
                <ul class="space-y-1">
                    @foreach (var att in detail.Attachments)
                    {
                        <li class="flex items-center justify-between gap-3 text-sm text-content">
                            <span class="truncate">@att.Name</span>
                            <span class="flex items-center gap-3 whitespace-nowrap">
                                @if (att.Size > 0)
                                {
                                    <span class="text-xs text-content-subtle">@FormatSize(att.Size)</span>
                                }
                                @if (!string.IsNullOrEmpty(att.Id))
                                {
                                    @if (IsPreviewable(att))
                                    {
                                        <button type="button" class="text-xs text-accent hover:underline"
                                                @onclick="() => ToggleAttachmentPreview(att)">
                                            @(previewAttachment == att ? "Hide preview" : "Preview")
                                        </button>
                                    }
                                    <a href="@AttachmentUrl(att, inline: false)" target="_blank" rel="noopener"
                                       class="text-xs text-accent hover:underline">Download</a>
                                    <button type="button" class="text-xs text-accent hover:underline" disabled="@busy"
                                            @onclick="() => OpenDrawingImport(att)">Save to drawings</button>
                                }
                            </span>
                        </li>
                    }
                </ul>

                @* Inline preview: check a PDF/image without leaving triage. The iframe hits the same
                   endpoint the Download link does, with ?inline=1 so the browser renders it in place. *@
                @if (previewAttachment is not null)
                {
                    <div class="mt-3 rounded-lg border border-line bg-surface overflow-hidden">
                        <header class="px-3 py-2 border-b border-line bg-surface-raised flex items-center justify-between gap-3">
                            <span class="text-xs text-content-muted font-medium truncate">@previewAttachment.Name</span>
                            <span class="flex items-center gap-3 shrink-0">
                                <a href="@AttachmentUrl(previewAttachment, inline: false)" target="_blank" rel="noopener"
                                   class="text-xs text-accent hover:underline underline-offset-2">Open / download</a>
                                <button type="button" class="text-xs text-content-muted hover:text-content"
                                        @onclick="() => previewAttachment = null">Close</button>
                            </span>
                        </header>
                        <iframe src="@AttachmentUrl(previewAttachment, inline: true)"
                                class="w-full h-[60vh] bg-white" title="Attachment preview"></iframe>
                    </div>
                }

                @if (importNote is not null)
                {
                    <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-xs text-content mt-3">@importNote</p>
                }
                @if (importError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-xs text-negative mt-3">@importError</p>
                }

                @* Inline import form: any email's attachment can become a drawing revision on a project. *@
                @if (importAttachment is not null)
                {
                    <div class="mt-3 rounded-lg border border-line bg-surface p-3 space-y-3">
                        <p class="text-xs text-content-muted">
                            Save <span class="font-medium text-content">@importAttachment.Name</span> into a project's drawings.
                            The file lands as an <span class="font-medium text-content">unapproved revision</span>.
                        </p>
                        <div class="inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5">
                            <button type="button" @onclick="() => SetImportMode(isRevision: false)"
                                    class="rounded-md text-xs px-2.5 py-1.5 transition @(!importIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                New drawing
                            </button>
                            <button type="button" @onclick="() => SetImportMode(isRevision: true)"
                                    class="rounded-md text-xs px-2.5 py-1.5 transition @(importIsRevision ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                                Revision of existing drawing
                            </button>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                <select class="field" value="@importProjectId" @onchange="OnImportProjectChanged">
                                    <option value="">Select a project…</option>
                                    @foreach (var project in ProjectOptionsFor(importProjectId))
                                    {
                                        <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                    }
                                </select>
                            </div>
                            @if (importIsRevision)
                            {
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Existing drawing *</label>
                                    <select class="field" @bind="importDrawingId" disabled="@string.IsNullOrWhiteSpace(importProjectId)">
                                        @if (string.IsNullOrWhiteSpace(importProjectId))
                                        {
                                            <option value="">Select a project first…</option>
                                        }
                                        else if (!DrawingStore.DrawingsLoadedFor(importProjectId))
                                        {
                                            <option value="">Loading drawings…</option>
                                        }
                                        else if (ImportDrawingOptions.Count == 0)
                                        {
                                            <option value="">No drawings on this project yet</option>
                                        }
                                        else
                                        {
                                            <option value="">Select a drawing…</option>
                                            @foreach (var drawing in ImportDrawingOptions)
                                            {
                                                <option value="@drawing.DrawingId">@drawing.DrawingCode — @drawing.Title</option>
                                            }
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <FormField Label="Drawing code" Value="@importCode" OnChange="v => importCode = v" Required="true" />
                            }
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            @if (!importIsRevision)
                            {
                                <FormField Label="Title" Value="@importTitle" OnChange="v => importTitle = v" />
                            }
                            <FormField Label="Revision label" Value="@importRevision" OnChange="v => importRevision = v" />
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="button" class="btn-primary"
                                    disabled="@(busy || string.IsNullOrWhiteSpace(importProjectId) || (importIsRevision ? string.IsNullOrWhiteSpace(importDrawingId) : string.IsNullOrWhiteSpace(importCode)))"
                                    @onclick="DoImportDrawing">@(busy ? "Saving…" : "Save to drawings")</button>
                            <button type="button" class="text-sm text-content-muted hover:text-content" @onclick="() => importAttachment = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (selected is not null && selected.HasAttachments && detail is not null)
        {
            <p class="text-xs text-content-subtle italic">This email has attachments, but their names couldn't be retrieved.</p>
        }

        @*
            Thread panel: the rest of this email's conversation, read live and regardless of tags.
            Later replies often say how the older messages should be triaged (e.g. "ignore my last —
            resolved on site"), so triaging oldest-first still shows the newest context. Click a
            member to open it. Linking or discarding already applies to the whole thread server-side.
        *@
        @if (selected is not null && !string.IsNullOrEmpty(selected.ConversationId))
        {
            @if (threadLoading)
            {
                <p class="text-xs text-content-subtle italic">Checking the thread for replies…</p>
            }
            else if (thread.Count > 1)
            {
                <div class="rounded-lg bg-surface-raised border border-line p-3">
                    <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                        Thread · @thread.Count emails
                    </p>
                    <div class="space-y-1">
                        @foreach (var member in thread)
                        {
                            var isCurrent = member.Id == selected.Id;
                            var isLatest = member.Id == thread[^1].Id;
                            <button type="button" @key="member.Id" disabled="@isCurrent"
                                    @onclick="() => Select(member, jumpToLatest: false)" class="@ThreadRowClass(isCurrent)">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-xs font-medium text-content truncate">@DisplayFrom(member)</span>
                                    <span class="flex items-center gap-1.5 whitespace-nowrap">
                                        @if (member.HasAttachments)
                                        {
                                            <span title="Has attachments" class="inline-flex items-center text-content-subtle">@PaperclipIcon</span>
                                        }
                                        @if (isLatest)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">Latest</span>
                                        }
                                        @if (isCurrent)
                                        {
                                            <span class="inline-flex items-center rounded-full border border-accent text-accent text-[10px] font-medium px-2 py-0.5">Viewing</span>
                                        }
                                        else if (member.Categories.Count == 0)
                                        {
                                            <span class="inline-flex items-center rounded-full border border-line text-content-subtle text-[10px] font-medium px-2 py-0.5">In queue</span>
                                        }
                                        @if (PathwayFromBucket(member.Bucket) is { } memberPathway)
                                        {
                                            <span class="inline-flex items-center rounded-full @PathwayChipColour(memberPathway) text-[10px] font-medium px-2 py-0.5">@PathwayLabel(memberPathway)</span>
                                        }
                                        @foreach (var tag in member.Categories)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                        }
                                    </span>
                                </div>
                                <p class="text-xs text-content-muted truncate mt-0.5">@Dash(member.BodyPreview)</p>
                                <p class="text-[11px] text-content-subtle mt-0.5">@Date(member.ReceivedAt)</p>
                            </button>
                        }
                    </div>
                    <p class="text-[11px] text-content-subtle mt-2">
                        Read the latest reply before triaging the oldest — linking or discarding any email here applies to the whole thread.
                    </p>
                </div>
            }
        }

    </text>;
}

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!CanTriage)
{
    <section class="px-6 md:px-8 py-12">
        <div class="panel p-8 text-center">
            <p class="text-sm text-content">You don't have access to mailbox triage.</p>
            <p class="text-xs text-content-subtle mt-1">Triage is available to administrators and project managers.</p>
        </div>
    </section>
}
else
{
    <section class="px-6 md:px-8 py-8 md:py-12">
        <header class="mb-6">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium mb-1">JPMS · projects@@jewelbb.co.uk</p>
            <h1 class="text-2xl md:text-3xl font-semibold text-content leading-tight">Mailbox triage</h1>
            @* Each strapline is a count, not a description, so it waits for its own list —
               "0 emails in the inbox" is the one sentence a triager must never be told wrongly.
               It simply does not render until the count is known: a line of muted text that
               arrives a moment late is invisible, whereas a spinner in its place is an event. *@
            @if (view == QueueView.Active && queueArrived)
            {
                <p class="text-sm text-content-muted mt-2">
                    @total email@(total == 1 ? "" : "s") in the inbox waiting to be assigned to a request.
                </p>
            }
            else if (view == QueueView.Discarded && discardedArrived)
            {
                <p class="text-sm text-content-muted mt-2">
                    @discardedTotal discarded email@(discardedTotal == 1 ? "" : "s") — restore one to put it back in the queue.
                </p>
            }
            else if (view == QueueView.Tagged && taggedArrived)
            {
                <p class="text-sm text-content-muted mt-2">
                    @taggedTotal tagged email@(taggedTotal == 1 ? "" : "s") — add or remove tags to manage which processes use them.
                </p>
            }
        </header>

        <div class="flex items-center gap-2 mb-6 border-b border-line">
            <button type="button" class="@ViewTabClass(QueueView.Active)" @onclick="() => SwitchView(QueueView.Active)">Queue</button>
            <button type="button" class="@ViewTabClass(QueueView.Tagged)" @onclick="() => SwitchView(QueueView.Tagged)">Tagged</button>
            @* One toggle for the whole page: every project picker below (import a drawing, link to
               a record, create a request or bid package, raise a to-do, reply in thread) hides
               completed projects unless this is ticked. No gate — it is a control, not a figure,
               so it renders straight away and holds the layout; only the count on the label waits
               until the project list has actually landed. *@
            <label class="ml-auto mb-1.5 flex items-center gap-2 text-sm text-content-muted cursor-pointer select-none"
                   title="Completed projects are kept out of the project pickers below until you ask for them">
                <input type="checkbox" checked="@showCompletedProjects"
                       @onchange="e => showCompletedProjects = (bool)e.Value!" />
                <span>Show completed projects@(HiddenCompletedCount > 0 ? $" ({HiddenCompletedCount})" : "")</span>
            </label>
            <div class="mb-1.5 inline-flex rounded-lg border border-line-strong p-0.5 gap-0.5"
                 title="Show the oldest or the newest emails first — your choice is remembered">
                <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: false)"
                        class="rounded-md text-xs px-2.5 py-1.5 transition @(!newestFirst ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                    Oldest first
                </button>
                <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: true)"
                        class="rounded-md text-xs px-2.5 py-1.5 transition @(newestFirst ? "bg-accent text-accent-ink font-medium" : "text-content-muted hover:bg-surface-raised")">
                    Newest first
                </button>
            </div>
            <button type="button" class="btn-primary mb-1.5" @onclick="OpenNewEmail">New email</button>
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@loadError</p>
        }

        @if (view == QueueView.Active)
        {
        @* No gate: this panel only exists when there ARE unassigned requests, so on most loads it
           is absent before the register answers and absent after it — announcing that wait would
           promise something that never arrives. It appears if and when there is something to say. *@
        @if (unassignedArrived && unassigned.Count > 0)
        {
            <div class="panel p-5 mb-6 border-amber-500/40">
                <div class="flex items-start gap-2 mb-1">
                    <h2 class="text-sm font-semibold text-amber-700">Unassigned requests</h2>
                    <span class="inline-flex items-center rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600">@unassigned.Count</span>
                </div>
                <p class="text-xs text-content-subtle mb-3">
                    These requests aren't tied to a live project, so they don't appear in any register. Return one to triage to process its emails again and pick the right project.
                </p>
                @if (unassignedError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@unassignedError</p>
                }
                <div class="space-y-2">
                    @foreach (var request in unassigned)
                    {
                        <div @key="request.RequestId" class="flex items-center justify-between gap-3 rounded-lg border border-line px-3 py-2">
                            <div class="min-w-0">
                                <p class="text-sm text-content truncate">
                                    <span class="font-mono text-xs text-content-muted mr-2">@Dash(request.Reference)</span>@Dash(request.Title)
                                </p>
                                <p class="text-[11px] text-content-subtle mt-0.5">Issued @Date(request.IssuedAt ?? request.RaisedAt) · @Dash(request.RaisedByEmail)</p>
                            </div>
                            <button type="button" class="btn-secondary text-xs whitespace-nowrap"
                                    disabled="@busy" @onclick="() => ReturnUnassigned(request)">
                                Return to triage
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <LoadGate IsLoading="@(!queueArrived)" Prominent="true" Label="Loading the inbox">
        @if (loadError is not null && items.Count == 0)
        {
            @* A failed page has no queue to report; "nothing in the queue" would read as one. *@
            <p class="text-sm text-negative">Couldn't load the inbox. The reason is in the red bar above — reload to try again.</p>
        }
        else if (total == 0)
        {
            <div class="panel p-8 text-center">
                <p class="text-sm text-content">Nothing in the queue.</p>
                <p class="text-xs text-content-subtle mt-1">Every email in the requests mailbox has been dealt with.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <div class="relative space-y-2 lg:col-span-1">
                    @if (listLoading)
                    {
                        <JewelSpinner Overlay="true" Label="Loading" />
                    }
                    @foreach (var item in items)
                    {
                        <button type="button" @key="item.Id" @onclick="() => Select(item)"
                                class="@RowClass(item)">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-sm font-medium text-content truncate">@DisplayFrom(item)</span>
                            </div>
                            <p class="text-sm text-content-muted truncate mt-0.5">@Dash(item.Subject)</p>
                            @* Thread hint: this email is untriaged, but other messages in its
                               conversation already carry record tags. Surfacing them here tells the
                               triager it's a reply to an already-linked thread, so re-linking is one
                               step — outline chips, so they don't read as this email's own tags. *@
                            @if (item.ThreadTags is { Count: > 0 } threadTags)
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    <span class="text-[10px] text-content-subtle">Thread:</span>
                                    @foreach (var tag in threadTags)
                                    {
                                        <span class="inline-flex items-center rounded-full border border-accent/40 text-accent/90 text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                    }
                                </div>
                            }
                            <div class="flex items-center gap-2 mt-1 text-[11px] text-content-subtle">
                                <span>@Date(item.ReceivedAt)</span>
                                @if (item.HasAttachments)
                                {
                                    <span title="Has attachments" class="inline-flex items-center">@PaperclipIcon</span>
                                }
                            </div>
                        </button>
                    }

                    @if (QueuePageCount > 1)
                    {
                        <div class="flex items-center justify-between gap-2 pt-2">
                            @if (queueIndex > 0)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousPage">Previous</button>
                            }
                            else
                            {
                                <span></span>
                            }
                            <span class="text-[11px] text-content-subtle">Page @(queueIndex + 1) / @QueuePageCount</span>
                            @if (queueNext is not null)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextPage">Next</button>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                </div>

                <div class="lg:col-span-2">
                    @if (selected is null)
                    {
                        @if (composeOutcome is { } outcome)
                        {
                            <div class="panel p-5 mb-4 @(outcome.Sent ? "border-positive/40" : "border-amber-500/40") space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider font-semibold @(outcome.Sent ? "text-positive" : "text-amber-600")">
                                        @(outcome.Sent ? "Email sent" : "Saved as draft")
                                    </p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => composeOutcome = null">✕</button>
                                </div>
                                <p class="text-sm text-content">
                                    <span class="font-medium">@outcome.Subject</span>
                                    — @(outcome.Sent ? "sent to" : "addressed to") @(string.Join("; ", outcome.To))@(outcome.Cc.Count > 0 ? $" (cc {string.Join("; ", outcome.Cc)})" : "").
                                    @if (outcome.RaisedRequest is { } raised)
                                    {
                                        <span> <span class="font-mono text-xs text-content-muted">@raised.Reference</span> was raised from the email.</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(outcome.FailureNote))
                                {
                                    <p class="text-sm text-amber-600">@outcome.FailureNote</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(outcome.WebLink))
                                {
                                    <a class="text-accent underline text-sm" href="@outcome.WebLink" target="_blank" rel="noopener">Open in Outlook</a>
                                }
                            </div>
                        }
                        @if (linkNote is not null)
                        {
                            <div class="panel p-5 mb-4 border-amber-500/40 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider text-amber-600 font-semibold">Partially linked</p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => linkNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@linkNote</p>
                            </div>
                        }
                        <div class="panel p-8 text-center text-sm text-content-subtle">
                            Select an email to triage it.
                        </div>
                    }
                    else
                    {
                        <div class="panel p-5 space-y-4 relative">
                            @if (busy)
                            {
                                <JewelSpinner Overlay="true" Label="@busyLabel" />
                            }
                            @if (actionError is not null)
                            {
                                <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                            }

                            <div>
                                <h2 class="text-lg font-semibold text-content">@Dash(selected.Subject)</h2>
                                <p class="text-sm text-content-muted mt-1">
                                    From @DisplayFrom(selected) · @Date(selected.ReceivedAt)
                                </p>
                            </div>

                            @MessageBody

                            <div class="pt-3 border-t border-line">
                                @*
                                    PATHWAY FIRST (docs/Pathway-Split-Platform-Flow-Plan.md §2.2): the first triage
                                    decision is who the correspondence is with — the chosen pathway then decides which
                                    action tabs (and record types) are offered. A thread that already carries a pathway
                                    shows it as a fixed badge: its routing was decided when it was first filed, so the
                                    triager acts within it rather than re-choosing. Discard is offered regardless —
                                    discarding is pathway-less.
                                *@
                                <div class="mb-4">
                                    <p class="text-sm font-semibold text-content mb-2">Who is this correspondence with?</p>
                                    @if (FixedPathway is { } filedPathway)
                                    {
                                        <span class="inline-flex items-center rounded-full @PathwayChipColour(filedPathway) text-xs font-medium px-2.5 py-1">Filed under @PathwayLabel(filedPathway)</span>
                                        <p class="text-xs text-content-subtle mt-2">This thread is already filed — the actions below work within its pathway.</p>
                                    }
                                    else
                                    {
                                        @* The first triage decision, rendered as the panel's main event: one of these
                                           MUST be taken (or Discard) before any action is offered, so the choices are
                                           full-size cards rather than the small segmented toggle the sort control uses. *@
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                            @foreach (var option in PathwayOptions)
                                            {
                                                <button type="button" @onclick="() => SetPathway(option)" class="@PathwayCardClass(option)">
                                                    <span class="block text-sm font-semibold">@PathwayLabel(option)</span>
                                                    <span class="block text-xs mt-0.5 opacity-80">@PathwayDescription(option)</span>
                                                </button>
                                            }
                                        </div>
                                        @if (pathway is null)
                                        {
                                            <p class="text-xs text-content-subtle mt-2">Choose who this correspondence is with to see the actions.</p>
                                        }
                                        else if (mode != TriageMode.Discard)
                                        {
                                            @* The quiet consequence line: what the pending action does to the thread's
                                               filing. A to-do LINK is the one neutral case — it never files a thread. *@
                                            @if (PendingActionIsNeutral)
                                            {
                                                <p class="text-xs text-content-subtle mt-2">To-dos are neutral — this won't file the thread under a pathway.</p>
                                            }
                                            else
                                            {
                                                <p class="text-xs text-content-subtle mt-2">This thread will be filed under <span class="font-semibold text-content">@PathwayLabel(pathway.Value)</span>.</p>
                                            }
                                        }
                                    }
                                </div>

                                <div class="flex flex-wrap gap-2 mb-4">
                                    @foreach (var tab in AvailableModes)
                                    {
                                        <button type="button" @key="tab" class="@ModeTabClass(tab)" @onclick="() => SetMode(tab)">@ModeLabel(tab)</button>
                                    }
                                </div>

                                @if (mode == TriageMode.Link)
                                {
                                    <div class="space-y-3">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Record type</label>
                                            @* Only the chosen pathway's record types are offered — the pathway filters
                                               the actions, so a client record can't be reached from Subcontractor and
                                               vice versa. Internal narrows to existing to-do items. *@
                                            <select class="field" value="@((int)linkRecordType)" @onchange="OnLinkRecordTypeChanged">
                                                @foreach (var recordType in QueueLinkTypeOptions)
                                                {
                                                    <option value="@((int)recordType)">@RecordTypeLabel(recordType)</option>
                                                }
                                            </select>
                                        </div>

                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project</label>
                                            <select class="field" value="@linkProjectId" @onchange="OnLinkProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptionsFor(linkProjectId))
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(linkProjectId))
                                        {
                                            if (linkRecordsLoading)
                                            {
                                                <p class="text-sm text-content-subtle italic">Loading @(RecordTypeLabelPlural(linkRecordType))…</p>
                                            }
                                            else
                                            {
                                                var candidates = DuplicateCandidates();
                                                var others = ProjectRecords().Except(candidates).ToList();

                                                @if (candidates.Count > 0)
                                                {
                                                    <div>
                                                        <p class="text-xs font-semibold text-amber-600 mb-1">Possible matches for this email</p>
                                                        <div class="space-y-1">
                                                            @foreach (var record in candidates)
                                                            {
                                                                <button type="button" @onclick="() => ToggleLinkRecord(record.RecordId)" class="@RecordPickClass(record, true)">
                                                                    <span class="flex items-center gap-2">
                                                                        <span class="font-mono text-xs text-content-muted">@record.Reference</span>
                                                                        @if (!string.IsNullOrWhiteSpace(record.StatusLabel))
                                                                        {
                                                                            <span class="text-[10px] uppercase tracking-wider text-content-subtle">@record.StatusLabel</span>
                                                                        }
                                                                    </span>
                                                                    <span class="text-sm text-content">@record.Title</span>
                                                                    @if (!string.IsNullOrWhiteSpace(record.Summary))
                                                                    {
                                                                        <span class="text-xs text-content-subtle line-clamp-2">@record.Summary</span>
                                                                    }
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (others.Count > 0)
                                                {
                                                    <div>
                                                        <p class="text-xs font-semibold text-content-subtle mb-1">Other @(RecordTypeLabelPlural(linkRecordType)) on this project</p>
                                                        <div class="space-y-1 max-h-56 overflow-y-auto">
                                                            @foreach (var record in others)
                                                            {
                                                                <button type="button" @onclick="() => ToggleLinkRecord(record.RecordId)" class="@RecordPickClass(record, false)">
                                                                    <span class="flex items-center gap-2">
                                                                        <span class="font-mono text-xs text-content-muted">@record.Reference</span>
                                                                        @if (!string.IsNullOrWhiteSpace(record.StatusLabel))
                                                                        {
                                                                            <span class="text-[10px] uppercase tracking-wider text-content-subtle">@record.StatusLabel</span>
                                                                        }
                                                                    </span>
                                                                    <span class="text-sm text-content">@record.Title</span>
                                                                    @if (!string.IsNullOrWhiteSpace(record.Summary))
                                                                    {
                                                                        <span class="text-xs text-content-subtle line-clamp-2">@record.Summary</span>
                                                                    }
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }

                                                @if (candidates.Count == 0 && others.Count == 0)
                                                {
                                                    <p class="text-sm text-content-subtle italic">No @(RecordTypeLabelPlural(linkRecordType)) on this project yet.</p>
                                                }
                                            }
                                        }

                                        <p class="text-xs text-content-subtle">
                                            Pick one or more records — the email is tagged to each of them, so it feeds every record it belongs to. Click a record again to unpick it.
                                        </p>

                                        @RideAlongTodos

                                        <button type="button" class="btn-primary" disabled="@(busy || linkRecordIds.Count == 0 || ReplyDraftPending)" title="@(ReplyDraftPending ? "You have written a reply — press Send reply below and this is applied with it" : null)" @onclick="DoLink">
                                            @(linkRecordIds.Count <= 1 ? "Link email to selected record" : $"Link email to {linkRecordIds.Count} selected records")
                                        </button>

                                        @* The lane confirm: the server asked for explicit consent to a Subcontractor↔
                                           Internal dual filing. Wall rejections never reach here — they surface as a
                                           plain error above, with no retry. *@
                                        @if (crossFileMessage is not null)
                                        {
                                            <div class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 space-y-2">
                                                <p class="text-sm text-content">@crossFileMessage</p>
                                                <button type="button" class="btn-secondary text-xs" disabled="@busy" @onclick="DoLinkConfirmCross">File under both anyway</button>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (mode == TriageMode.Create)
                                {
                                    @* The pathway decides WHAT is created — Client → a General request (the client
                                       pathway's default container), Subcontractor → a bid package — so the old
                                       record-type picker is gone: the pathway already made that choice. *@
                                    <div class="space-y-4">
                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project *</label>
                                            <select class="field" value="@createProjectId" @onchange="OnCreateProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptionsFor(createProjectId))
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>

                                        @if (pathway == TriagePathway.Client)
                                        {
                                            <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
                                                Created as a <span class="font-medium text-content">General</span> request and auto-numbered REQ-####. Promote it to an official RFI from the request page.
                                            </p>

                                            <FormField Label="Raised to" Value="@createRaisedTo" OnChange="v => createRaisedTo = v" />

                                            <FormField Label="Subject" Value="@createTitle" OnChange="v => createTitle = v" Required="true" />

                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Detail</label>
                                                <textarea class="field" rows="4" value="@createDescription" @oninput="OnCreateDescriptionInput"></textarea>
                                            </div>

                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                <FormField Label="Drawing / detail ref" Value="@createDrawingRef" OnChange="v => createDrawingRef = v" />
                                                <FormField Label="Response due" Value="@createResponseDue" OnChange="v => createResponseDue = v" InputType="date" />
                                            </div>

                                            <label class="flex items-start gap-2 cursor-pointer">
                                                <input type="checkbox" class="mt-0.5" @bind="createAddToProgramme" />
                                                <span class="text-sm text-content">
                                                    Also add to Programme
                                                    <span class="block text-xs text-content-subtle">The email (and its thread) is also tagged to the project's <span class="font-medium">programme communications</span>, so it appears under the Programme tab as well as on the new request.</span>
                                                </span>
                                            </label>

                                            @RideAlongTodos

                                            <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(createProjectId) || ReplyDraftPending)" title="@(ReplyDraftPending ? "You have written a reply — press Send reply below and this is applied with it" : null)" @onclick="DoCreate">Create request from email</button>
                                        }
                                        else
                                        {
                                            <FormField Label="Title" Value="@createTitle" OnChange="v => createTitle = v" Required="true" />
                                            <FormField Label="Trade" Value="@createTrade" OnChange="v => createTrade = v" />

                                            <p class="text-xs text-content-subtle">A draft bid package is created and this email is linked to it. Invite subcontractors and add line items from the bid package page.</p>

                                            @RideAlongTodos

                                            <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(createProjectId) || string.IsNullOrWhiteSpace(createTitle) || ReplyDraftPending)" title="@(ReplyDraftPending ? "You have written a reply — press Send reply below and this is applied with it" : null)" @onclick="DoCreateBidPackage">Create bid package from email</button>
                                        }
                                    </div>
                                }
                                else if (mode == TriageMode.GeneralTodo)
                                {
                                    @* To-dos (Internal, and Subcontractor for "chase them for X"): capture the email as one or
                                       more to-do items. The project is
                                       OPTIONAL — chosen, the items land on that project's To-do tab (and the email can
                                       also feed one of its open requests); left blank they are GENERAL (company-wide)
                                       items that live on the To-dos browser page and the dashboards of everyone
                                       holding the assigned role. One row editor serves both. *@
                                    <div class="space-y-4">
                                        <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
                                            Each item is numbered TODO-#### and this email is tagged to <span class="font-medium text-content">every item</span> you add here, so one email can feed several to-dos. An item is assigned to a role — or to a <span class="font-medium text-content">named person</span> within one — and giving it <span class="font-medium text-content">more than one assignee</span> raises it once per assignee: separate items, each ticked off on its own. Choose a project to put the items on its To-do tab, or leave it blank for <span class="font-medium text-content">company-wide</span> items that appear on the To-dos page and the dashboard of everyone holding the assigned role.
                                        </p>

                                        <div>
                                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Project (optional)</label>
                                            <select class="field" value="@createProjectId" @onchange="OnCreateProjectChanged">
                                                <option value="">No project — company-wide</option>
                                                @foreach (var project in ProjectOptionsFor(createProjectId))
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(createProjectId) && TodoRequestLinkOffered)
                                        {
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Link to an open request (optional)</label>
                                                @if (createTodoLinkRequestsLoading)
                                                {
                                                    <p class="text-sm text-content-subtle italic">Loading requests…</p>
                                                }
                                                else if (createTodoLinkRequests.Count == 0)
                                                {
                                                    <p class="text-xs text-content-subtle italic">No open requests on this project.</p>
                                                }
                                                else
                                                {
                                                    <select class="field" value="@createTodoLinkRequestId" @onchange="OnCreateTodoLinkRequestChanged">
                                                        <option value="">No request link</option>
                                                        @foreach (var record in createTodoLinkRequests)
                                                        {
                                                            <option value="@record.RecordId">@record.Reference — @record.Title</option>
                                                        }
                                                    </select>
                                                    @if (!string.IsNullOrWhiteSpace(createTodoLinkRequestId))
                                                    {
                                                        <p class="text-xs text-content-subtle mt-1">
                                                            This email is tagged to the request as well as to every item below, so it appears in the request's conversation too — and because a request is a client record, the thread's filing follows the request rather than Internal.
                                                        </p>
                                                    }
                                                }
                                            </div>
                                        }

                                        @TodoRowsEditor


                                        <button type="button" class="btn-primary" disabled="@(busy || !createTodoRows.Any(r => !string.IsNullOrWhiteSpace(r.Title)) || ReplyDraftPending)" title="@(ReplyDraftPending ? "You have written a reply — press Send reply below and this is applied with it" : null)" @onclick="DoCreateTodos">
                                            Create @(TodoRowCountLabel) from email
                                        </button>
                                    </div>
                                }
                                else if (mode == TriageMode.Discard)
                                {
                                    <div class="space-y-3">
                                        <p class="text-sm text-content-muted">Discard this email if it isn’t a request (spam, an auto-reply, or sent to the wrong place). This adds a “discarded” category tag to it — the email stays put in the mailbox — and removes it from the queue. You can restore it from the Discarded tab.</p>

                                        @RideAlongTodos

                                        <button type="button" class="btn-secondary border-negative/40 text-negative hover:border-negative" disabled="@(busy || ReplyDraftPending)" title="@(ReplyDraftPending ? "You've written a reply — send it below, or discard the draft first" : null)" @onclick="DoDiscard">Discard email</button>
                                    </div>
                                }

                                @* ---- Reply — its own section, deliberately OUTSIDE the filing tabs above. Filing an
                                       email and answering it are two different halves of dealing with it, and the team
                                       usually does both: pick records / a new record / to-dos above, write the reply
                                       here, and ONE Send applies the lot. A reply on its own is also a complete triage
                                       decision (the thread leaves the queue as Replied). *@
                                <div class="mt-5 border-t border-line pt-4">
                                    @if (!replyOpen)
                                    {
                                        <div class="flex items-center gap-3">
                                            <button type="button" class="btn-secondary" @onclick="() => replyOpen = true">↩ Reply</button>
                                            <p class="text-xs text-content-subtle">Reply-all is prefilled. You can reply on its own, or alongside anything selected above — one Send does both.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between">
                                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Reply — sends from the projects mailbox</p>
                                                <button type="button" class="text-xs text-content-subtle hover:text-negative underline" @onclick="DiscardReplyDraft">Discard draft</button>
                                            </div>

                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">To *</label>
                                                <input class="field" type="text" placeholder="name@example.com; other@example.com"
                                                       value="@replyToField" @oninput="OnReplyToInput" />
                                            </div>
                                            <div>
                                                <div class="flex items-center justify-between">
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Cc</label>
                                                    @if (!replyShowBcc)
                                                    {
                                                        <button type="button" class="text-xs text-content-subtle hover:text-content underline" @onclick="() => replyShowBcc = true">Bcc</button>
                                                    }
                                                </div>
                                                <input class="field" type="text" placeholder="Copied recipients — separated by ;"
                                                       value="@replyCcField" @oninput="OnReplyCcInput" />
                                            </div>
                                            @if (replyShowBcc)
                                            {
                                                <div>
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Bcc</label>
                                                    <input class="field" type="text" placeholder="Blind-copied recipients — separated by ;"
                                                           value="@replyBccField" @oninput="OnReplyBccInput" />
                                                </div>
                                            }
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subject *</label>
                                                <input class="field" type="text" value="@replySubject" @oninput="OnReplySubjectInput" />
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Your reply *</label>
                                                <RichTextEditor @bind-Value="replyBody" MinHeight="180"
                                                                Placeholder="Write the reply — the whole thread is quoted behind it…" />
                                            </div>

                                            <AttachmentPicker Attachments="replyAttachments" AttachmentsChanged="OnReplyAttachmentsChanged"
                                                              Projects="ProjectOptionsFor(ComposeContextProjectId)" ProjectId="@ComposeContextProjectId"
                                                              OriginalAttachments="detail?.Attachments" OriginalMessageId="@selected?.Id" />

                                            @if (PendingFilingSummary is { } pendingSummary)
                                            {
                                                <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-xs text-content">
                                                    Send will also @pendingSummary — one action does both.
                                                </p>
                                            }

                                            <div class="flex items-center gap-2">
                                                <button type="button" class="btn-primary" disabled="@(busy || !ReplyIsSendable)" @onclick="() => DoSendReply(saveAsDraftOnly: false)">
                                                    @SendButtonLabel
                                                </button>
                                                <button type="button" class="btn-secondary" disabled="@(busy || !ReplyIsSendable)" @onclick="() => DoSendReply(saveAsDraftOnly: true)">
                                                    Save as draft
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        </LoadGate>

        @* Recently triaged — the audit register's latest link/create decisions, newest first, so
           the triager can jump straight to the document an email was just filed against. Same
           no-gate pattern as the unassigned panel above: it renders if and when there is something
           to show. (The register records client-pathway triage today; subcontractor/internal rows
           appear here automatically once the audit scope widens.) *@
        @if (RecentTriage.Count > 0)
        {
            <div class="panel p-5 mt-6">
                <div class="flex items-baseline justify-between gap-3 mb-3">
                    <h2 class="text-sm font-semibold text-content">Recently triaged</h2>
                    <a href="/audit" class="text-xs text-content-muted hover:text-content underline underline-offset-2">Full audit trail</a>
                </div>
                <div class="divide-y divide-line">
                    @foreach (var entry in RecentTriage)
                    {
                        <div @key="entry.AuditEventId" class="flex items-center gap-3 py-2">
                            <span class="text-[11px] text-content-subtle whitespace-nowrap w-16 shrink-0"
                                  title="@entry.OccurredAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")">@Ago(entry.OccurredAt)</span>
                            @if (RecentHref(entry) is { } href)
                            {
                                <a class="font-mono text-xs text-content underline underline-offset-2 hover:text-accent whitespace-nowrap" href="@href">@Dash(entry.RecordReference)</a>
                            }
                            else
                            {
                                <span class="font-mono text-xs text-content-muted whitespace-nowrap">@Dash(entry.RecordReference)</span>
                            }
                            <span class="text-xs text-content-muted truncate">@entry.Detail</span>
                            <span class="text-[11px] text-content-subtle whitespace-nowrap ml-auto hidden md:inline">@RecentMeta(entry)</span>
                        </div>
                    }
                </div>
            </div>
        }
        }
        else if (view == QueueView.Discarded)
        {
            <LoadGate IsLoading="@(!discardedArrived)" Prominent="true" Label="Loading discarded emails">
            @if (loadError is not null && discardedItems.Count == 0)
            {
                @* A failed page has nothing to report; "no discarded emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the discarded emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (discardedTotal == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No discarded emails.</p>
                    <p class="text-xs text-content-subtle mt-1">Emails you discard from the queue show up here, and can be restored.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                    <div class="relative space-y-2 lg:col-span-1">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in discardedItems)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm font-medium text-content truncate">@DisplayFrom(item)</span>
                                </div>
                                <p class="text-sm text-content-muted truncate mt-0.5">@Dash(item.Subject)</p>
                                <div class="flex items-center gap-2 mt-1 text-[11px] text-content-subtle">
                                    <span>@Date(item.ReceivedAt)</span>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center">@PaperclipIcon</span>
                                    }
                                </div>
                            </button>
                        }

                        @if (DiscardedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (discardedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousDiscarded">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(discardedIndex + 1) / @DiscardedPageCount</span>
                                @if (discardedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextDiscarded">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>

                    <div class="lg:col-span-2">
                        @if (selected is null)
                        {
                            <div class="panel p-8 text-center text-sm text-content-subtle">
                                Select a discarded email to view it.
                            </div>
                        }
                        else
                        {
                            <div class="panel p-5 space-y-4 relative">
                                @if (busy)
                                {
                                    <JewelSpinner Overlay="true" Label="@busyLabel" />
                                }
                                @if (actionError is not null)
                                {
                                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                                }

                                <div>
                                    <h2 class="text-lg font-semibold text-content">@Dash(selected.Subject)</h2>
                                    <p class="text-sm text-content-muted mt-1">
                                        From @DisplayFrom(selected) · @Date(selected.ReceivedAt)
                                    </p>
                                </div>

                                @MessageBody

                                <div class="pt-3 border-t border-line">
                                    <p class="text-sm text-content-muted mb-3">
                                        This email was discarded. Restore it to remove the “discarded” tag and put it back in the triage queue.
                                    </p>
                                    <button type="button" class="btn-primary" disabled="@busy" @onclick="DoRestore">Restore to triage</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            </LoadGate>
        }
        else
        {
            @* Pathway filter: one chip per pathway, read server-side as an exact bucket-category
               filter. Kept separate from (and mutually exclusive with) the tag filter below — Graph
               composes category filters with OR only, so combining them would show a union, not the
               intersection the combination looks like. *@
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Pathway</span>
                <button type="button" class="@PathwayFilterChipClass(null)" @onclick="() => SetPathwayFilter(null)">All</button>
                <button type="button" class="@PathwayFilterChipClass(ClientBucket)" @onclick="() => SetPathwayFilter(ClientBucket)">Client</button>
                <button type="button" class="@PathwayFilterChipClass(SubcontractorBucket)" @onclick="() => SetPathwayFilter(SubcontractorBucket)">Subcontractor</button>
                <button type="button" class="@PathwayFilterChipClass(InternalBucket)" @onclick="() => SetPathwayFilter(InternalBucket)">Internal</button>
            </div>

            @* The tag list accrues from the emails that have loaded, so before the first page lands
               the dropdown offers only "Discarded" — a short list that looks like the whole list. *@
            @if (taggedArrived)
            {
            <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Filter</span>
                <div class="relative">
                    <button type="button"
                            class="rounded-full border border-line px-3 py-1 text-xs font-medium text-content-muted hover:text-content hover:border-line-strong transition inline-flex items-center gap-1.5"
                            @onclick="ToggleFilterMenu">
                        @FilterButtonLabel
                        <span class="text-[9px] leading-none">▾</span>
                    </button>
                    @if (filterOpen)
                    {
                        <div class="absolute z-20 mt-1 w-60 max-h-72 overflow-y-auto rounded-lg border border-line bg-surface-raised shadow-lg p-1">
                            <button type="button"
                                    class="w-full text-left rounded px-3 py-1.5 text-sm text-content-muted hover:bg-surface hover:text-content"
                                    @onclick="ClearTagFilters">
                                All tags
                            </button>
                            <div class="my-1 border-t border-line"></div>
                            @foreach (var tag in knownTags)
                            {
                                <label class="flex items-center gap-2 rounded px-3 py-1.5 text-sm text-content hover:bg-surface cursor-pointer">
                                    <input type="checkbox" checked="@selectedTags.Contains(tag)" @onchange="() => ToggleTag(tag)" />
                                    <span>@TagLabel(tag)</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                @foreach (var tag in selectedTags)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent bg-surface-raised px-2.5 py-1 text-xs text-content">
                        @TagLabel(tag)
                        <button type="button" class="text-content-subtle hover:text-negative" @onclick="() => ToggleTag(tag)" title="Remove filter">✕</button>
                    </span>
                }
            </div>
            }

            <LoadGate IsLoading="@(!taggedArrived)" Prominent="true" Label="Loading tagged emails">
            @if (loadError is not null && taggedItems.Count == 0)
            {
                @* A failed page has nothing to report; "no tagged emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the tagged emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (taggedTotal == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@(selectedTags.Count == 0 ? "No tagged emails." : "No emails with the selected tags.")</p>
                    <p class="text-xs text-content-subtle mt-1">Emails linked to a request (or discarded) appear here. Open one to add it to another request or remove a tag.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                    <div class="relative space-y-2 lg:col-span-1">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in taggedItems)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-sm font-medium text-content truncate">@DisplayFrom(item)</span>
                                </div>
                                <p class="text-sm text-content-muted truncate mt-0.5">@Dash(item.Subject)</p>
                                @if (item.Bucket is not null || item.Categories.Count > 0)
                                {
                                    <div class="flex flex-wrap items-center gap-1 mt-1">
                                        @* The pathway badge leads the chip row: the thread's filing is the first thing
                                           to know about a tagged email, before which records it feeds. *@
                                        @if (PathwayFromBucket(item.Bucket) is { } rowPathway)
                                        {
                                            <span class="inline-flex items-center rounded-full @PathwayChipColour(rowPathway) text-[10px] font-medium px-2 py-0.5">@PathwayLabel(rowPathway)</span>
                                        }
                                        @foreach (var tag in item.Categories)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                        }
                                    </div>
                                }
                                <div class="flex items-center gap-2 mt-1 text-[11px] text-content-subtle">
                                    <span>@Date(item.ReceivedAt)</span>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center">@PaperclipIcon</span>
                                    }
                                </div>
                            </button>
                        }

                        @if (TaggedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (taggedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousTagged">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(taggedIndex + 1) / @TaggedPageCount</span>
                                @if (taggedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextTagged">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>

                    <div class="lg:col-span-2">
                        @if (selected is null)
                        {
                            <div class="panel p-8 text-center text-sm text-content-subtle">
                                Select a tagged email to manage its tags.
                            </div>
                        }
                        else
                        {
                            <div class="panel p-5 space-y-4 relative">
                                @if (busy)
                                {
                                    <JewelSpinner Overlay="true" Label="@busyLabel" />
                                }
                                @if (actionError is not null)
                                {
                                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                                }

                                <div>
                                    <h2 class="text-lg font-semibold text-content">@Dash(selected.Subject)</h2>
                                    <p class="text-sm text-content-muted mt-1">
                                        From @DisplayFrom(selected) · @Date(selected.ReceivedAt)
                                    </p>
                                </div>

                                @MessageBody

                                <div class="pt-3 border-t border-line space-y-4">
                                    <div>
                                        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">Tags on this email</p>
                                        @* The pathway badge is shown apart from the tag chips: it isn't removable here —
                                           the server drops the bucket itself when the last record tag goes. *@
                                        @if (FixedPathway is { } taggedPathway)
                                        {
                                            <div class="mb-2">
                                                <span class="inline-flex items-center rounded-full @PathwayChipColour(taggedPathway) text-xs font-medium px-2.5 py-1">Filed under @PathwayLabel(taggedPathway)</span>
                                            </div>
                                        }
                                        @if (selected.Categories.Count == 0)
                                        {
                                            <p class="text-sm text-content-subtle italic">No workflow tags. (Refresh if you just changed them.)</p>
                                        }
                                        else
                                        {
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var tag in selected.Categories)
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-raised px-2.5 py-1 text-xs text-content">
                                                        @TagLabel(tag)
                                                        <button type="button" class="text-content-subtle hover:text-negative" disabled="@busy" @onclick="() => DoRemoveTag(tag)" title="Remove this tag">✕</button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div>
                                        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">Link to another record</p>
                                        <div class="space-y-3">
                                            @* Each type shows the pathway it files under, and the pool is cut by the
                                               thread's own pathway so the client wall can't even be expressed here: a
                                               Client thread is never offered subcontract-side types and vice versa.
                                               Todo is always offered — to-do links are neutral. *@
                                            <select class="field" value="@((int)linkRecordType)" @onchange="OnLinkRecordTypeChanged">
                                                @foreach (var recordType in TaggedLinkTypeOptions)
                                                {
                                                    <option value="@((int)recordType)">@RecordTypeLabel(recordType) — @RecordTypePathwayLabel(recordType)</option>
                                                }
                                            </select>

                                            <select class="field" value="@linkProjectId" @onchange="OnLinkProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptionsFor(linkProjectId))
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>

                                            @if (!string.IsNullOrWhiteSpace(linkProjectId))
                                            {
                                                @if (linkRecordsLoading)
                                                {
                                                    <p class="text-sm text-content-subtle italic">Loading @(RecordTypeLabelPlural(linkRecordType))…</p>
                                                }
                                                else
                                                {
                                                    <select class="field" value="@linkRecordId" @onchange="OnTaggedRecordChanged">
                                                        <option value="">Select a @(RecordTypeLabelSingular(linkRecordType))…</option>
                                                        @foreach (var record in ProjectRecords())
                                                        {
                                                            <option value="@record.RecordId">@record.Reference — @record.Title</option>
                                                        }
                                                    </select>
                                                }
                                            }

                                            @* The lane heads-up: a bid package on an Internal thread would file it under
                                               both non-client pathways, which the server asks to confirm. (No client-side
                                               type can appear here on a non-client thread, so this is the only case.) *@
                                            @if (FixedPathway == TriagePathway.Internal && linkRecordType == RecordType.BidPackageInvite)
                                            {
                                                <p class="text-xs text-amber-600">This would file the thread under Subcontractor as well as Internal — you'll be asked to confirm.</p>
                                            }

                                            <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(linkRecordId))" @onclick="DoAddTagLink">
                                                Link to selected record
                                            </button>

                                            @if (crossFileMessage is not null)
                                            {
                                                <div class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 space-y-2">
                                                    <p class="text-sm text-content">@crossFileMessage</p>
                                                    <button type="button" class="btn-secondary text-xs" disabled="@busy" @onclick="DoAddTagLinkConfirmCross">File under both anyway</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            </LoadGate>
        }
    </section>
}

@* ---- New email (compose a fresh outbound thread from the projects mailbox) ---- *@
<Modal IsOpen="@newEmailOpen" Title="New email" Class="max-w-3xl" DismissOnOverlayClick="false"
       ShowFooter="false" OnCancel="CloseNewEmail">
    <div class="space-y-3">
        <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
            Sends from the <span class="font-medium text-content">projects mailbox</span>. Optionally file it to a record so the sent copy shows in that record's correspondence — replies will arrive in the queue either way.
        </p>

        @if (newEmailError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@newEmailError</p>
        }

        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">To *</label>
            <input class="field" type="text" placeholder="name@example.com; other@example.com"
                   value="@newEmailTo" @oninput="OnNewEmailToInput" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Cc</label>
                <input class="field" type="text" placeholder="Separated by ;"
                       value="@newEmailCc" @oninput="OnNewEmailCcInput" />
            </div>
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Bcc</label>
                <input class="field" type="text" placeholder="Separated by ;"
                       value="@newEmailBcc" @oninput="OnNewEmailBccInput" />
            </div>
        </div>
        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subject *</label>
            <input class="field" type="text" value="@newEmailSubject" @oninput="OnNewEmailSubjectInput" />
        </div>
        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Message *</label>
            <RichTextEditor @bind-Value="newEmailBody" MinHeight="200" Placeholder="Write the email…" />
        </div>

        <AttachmentPicker Attachments="newEmailAttachments" AttachmentsChanged="OnNewEmailAttachmentsChanged"
                          Projects="ProjectOptionsFor(newEmailProjectId)" ProjectId="@newEmailProjectId" />

        <div class="rounded-lg border border-line p-3 space-y-2">
            <label class="flex items-center gap-2 text-sm text-content">
                <input type="checkbox" checked="@newEmailFile" @onchange="OnNewEmailFileToggled" />
                File this email to a record (the sent copy shows in its correspondence)
            </label>
            @if (newEmailFile)
            {
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <select class="field" value="@newEmailProjectId" @onchange="OnNewEmailProjectChanged">
                        <option value="">Select a project…</option>
                        @foreach (var project in ProjectOptionsFor(newEmailProjectId))
                        {
                            <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                        }
                    </select>
                    <select class="field" value="@((int)newEmailRecordType)" @onchange="OnNewEmailRecordTypeChanged">
                        @foreach (var recordType in RecordTypeOptions)
                        {
                            <option value="@((int)recordType)">@RecordTypeLabel(recordType)</option>
                        }
                    </select>
                    <select class="field" value="@newEmailRecordId" @onchange="OnNewEmailRecordChanged" disabled="@(string.IsNullOrEmpty(newEmailProjectId))">
                        <option value="">@(string.IsNullOrEmpty(newEmailProjectId) ? "Select a project first…" : newEmailRecordsLoading ? "Loading…" : "Select a record…")</option>
                        @foreach (var record in newEmailRecords)
                        {
                            <option value="@record.RecordId">@record.Reference — @record.Title</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
            <button type="button" class="btn-ghost" disabled="@newEmailBusy" @onclick="CloseNewEmail">Cancel</button>
            <button type="button" class="btn-secondary" disabled="@(newEmailBusy || !NewEmailIsSendable)" @onclick="() => DoSendNewEmail(saveAsDraftOnly: true)">Save as draft</button>
            <button type="button" class="btn-primary" disabled="@(newEmailBusy || !NewEmailIsSendable)" @onclick="() => DoSendNewEmail(saveAsDraftOnly: false)">@(newEmailBusy ? "Sending…" : "Send")</button>
        </div>
    </div>
</Modal>

@code {
    private enum TriageMode { None, Link, Create, GeneralTodo, Discard }

    // The communication pathway — WHO the correspondence is with (docs/Pathway-Split-Platform-Flow-
    // Plan.md §2). Triage is pathway-FIRST: the pathway is chosen (or already fixed on the thread)
    // before any action, and it decides which action tabs and record types are offered.
    private enum TriagePathway { Client, Subcontractor, Internal }
    private static readonly TriagePathway[] PathwayOptions =
    {
        TriagePathway.Client, TriagePathway.Subcontractor, TriagePathway.Internal
    };

    // The triager's pathway choice for the SELECTED email. Pre-set from the thread's own bucket when
    // it already carries one (then shown as a fixed badge — the routing decision was made when the
    // thread was first filed); otherwise null until chosen, and only Discard is offered until it is
    // (discarding is pathway-less).
    private TriagePathway? pathway;

    // The pathway bucket categories exactly as the server stamps them — MailboxMessage.Bucket carries
    // one of these verbatim. Literals here because the WASM app references contracts only; the API's
    // TriageCategories constants aren't visible to it.
    private const string ClientBucket = "JPMS/Client";
    private const string SubcontractorBucket = "JPMS/Subcontractor";
    private const string InternalBucket = "JPMS/Internal";

    private static TriagePathway? PathwayFromBucket(string? bucket)
    {
        if (string.IsNullOrEmpty(bucket)) return null;
        if (bucket.Equals(ClientBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Client;
        if (bucket.Equals(SubcontractorBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Subcontractor;
        if (bucket.Equals(InternalBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Internal;
        return null;
    }

    // The selected thread's already-decided pathway (null = not filed yet). When set, the selector
    // renders as a fixed "Filed under …" badge and the pathway can't be switched — the triager still
    // acts within it.
    private TriagePathway? FixedPathway => PathwayFromBucket(selected?.Bucket);

    // Enum names double as the user-facing labels AND the short pathway strings the server's
    // commands accept ("Client" / "Subcontractor" / "Internal") — keep them in sync with MapPathway.
    private static string PathwayLabel(TriagePathway p) => p.ToString();

    // Pathway chip colours: green-ish Client, orange-ish Subcontractor, purple-ish Internal — the
    // same rounded-pill shape as the tag chips, but distinct hues so rows can be scanned by pathway.
    private static string PathwayChipColour(TriagePathway p) => p switch
    {
        TriagePathway.Client        => "bg-emerald-500/10 text-emerald-600",
        TriagePathway.Subcontractor => "bg-orange-500/10 text-orange-600",
        TriagePathway.Internal      => "bg-purple-500/10 text-purple-600",
        _                           => "bg-accent/10 text-accent"
    };

