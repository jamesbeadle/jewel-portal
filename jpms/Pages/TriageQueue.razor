@page "/control-centre"
@page "/requests/triage"
@* The second route is the legacy alias: the page lived at /requests/triage before the section
   became the Control Centre (2026-08-07); old bookmarks and links still land here. *@
@using Jewel.JPMS.Contracts.Audit
@using Jewel.JPMS.Contracts.DocumentControl
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Features.Procurement
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Contracts.Requests
@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@using Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage.Workspace
@using Jewel.JPMS.Contracts.Ai
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake
@inject ProjectStageFilter StageFilter
@inject TriageSortStorage SortStorage
@inject ITodoStore Todos
@inject IRequestRegister RequestRegister
@inject ICommandSender Commands
@inject IWorkOrderAttachmentStore WorkOrderAttachments
@inject IQueryClient Queries
@inject ControlCentreOpenEmail OpenEmail
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel Subcontractors
@inject Jewel.JPMS.Features.CostCenters.CostCentersReadModel CostCenters
@inject AiTaskState AiTasks
@inject ChatPanelState Chat
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Control Centre · JPMS</PageTitle>

@*
    Live-read triage. The mailbox is the single source of truth and nothing ever moves — triage just
    adds/removes category tags on the email. The Queue is Inbox messages with no JPMS tag (read live);
    the Discarded tab is messages tagged "JPMS/Discarded". Discard/restore/assign add or remove tags,
    each verified by reading the categories back. Nothing about un-triaged mail is stored in the database.
*@

@*
    Shared message body + attachments, used by both the Queue and Discarded detail panes. Declared
    before first use; reads the live `detail` / `selected` fields each time it is rendered.
*@
@{
    // Small paperclip glyph flagging an email as carrying attachments — shown on list rows
    // (queue / discarded / tagged) and thread panel rows. Inherits the row's text colour.
    RenderFragment PaperclipIcon =
        @<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="w-3 h-3 shrink-0" aria-hidden="true">
            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
        </svg>;

    RenderFragment MessageHeader =@<div>
        <h2 class="text-lg font-semibold text-content">@Dash(selected!.Subject)</h2>
        <div class="flex items-start gap-3 mt-3">
            <div class="h-9 w-9 shrink-0 rounded-full bg-accent/15 text-accent flex items-center justify-center text-sm font-semibold select-none"
                 aria-hidden="true">@SenderInitials(selected)</div>
            <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm text-content truncate">
                        <span class="font-semibold">@DisplayFrom(selected)</span>
                        @if (!string.IsNullOrWhiteSpace(selected.FromName) && !string.IsNullOrWhiteSpace(selected.FromEmail))
                        {
                            <span class="text-content-subtle"> &lt;@selected.FromEmail&gt;</span>
                        }
                    </p>
                    <span class="text-xs text-content-subtle shrink-0">@Date(selected.ReceivedAt)</span>
                </div>
                @if (detail?.To is { Count: > 0 } headerTo)
                {
                    <p class="text-xs text-content-subtle truncate mt-0.5">To: @string.Join("; ", headerTo)</p>
                }
                @if (detail?.Cc is { Count: > 0 } headerCc)
                {
                    <p class="text-xs text-content-subtle truncate mt-0.5">Cc: @string.Join("; ", headerCc)</p>
                }
            </div>
        </div>
    </div>;

    @*
        Attachments: names, preview, download and the "Send to document triage" tick for the
        open email. Rendered at the TOP of the email pane — above the body — so the attachments
        are dealt with first and can never scroll out of sight (decision 2026-08-12; the routing
        itself — drawings, payment certificates, subcontractor documents — lives in Document
        Control, where each file is triaged on its own).
    *@
    RenderFragment MessageAttachments =@<text>
        @if (detail is not null && detail.Attachments.Count > 0)
        {
            <div class="rounded-lg bg-surface-raised border border-line p-3">
                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                    @detail.Attachments.Count attachment@(detail.Attachments.Count == 1 ? "" : "s")
                </p>
                <ul class="space-y-1">
                    @foreach (var att in detail.Attachments)
                    {
                        <li class="flex items-center justify-between gap-3 text-sm text-content">
                            <span class="truncate">@att.Name</span>
                            <span class="flex items-center gap-3 whitespace-nowrap">
                                @if (att.Size > 0)
                                {
                                    <span class="text-xs text-content-subtle">@FormatSize(att.Size)</span>
                                }
                                @if (!string.IsNullOrEmpty(att.Id))
                                {
                                    @if (IsPreviewable(att))
                                    {
                                        <button type="button" class="text-xs text-accent hover:underline"
                                                @onclick="() => OpenEmailAttachmentPreview(att)">
                                            Preview
                                        </button>
                                    }
                                    <a href="@AttachmentUrl(att, inline: false)" target="_blank" rel="noopener"
                                       class="text-xs text-accent hover:underline">Download</a>
                                    @if (view == QueueView.Active)
                                    {
                                        <label class="flex items-center gap-1.5 text-xs text-content-muted hover:text-content cursor-pointer select-none"
                                               title="Copy this file into the Document Triage queue when Apply runs — the email itself stays here">
                                            <input type="checkbox" checked="@stagedDocControlIds.Contains(att.Id)"
                                                   disabled="@busy"
                                                   @onchange="e => ToggleDocControl(att.Id, e.Value is true)" />
                                            <span>Send to document triage</span>
                                        </label>
                                    }
                                }
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
        else if (selected is not null && selected.HasAttachments && detail is not null)
        {
            <p class="text-xs text-content-subtle italic">This email has attachments, but their names couldn't be retrieved.</p>
        }
    </text>;

    RenderFragment MessageBody =@<text>
        <div class="rounded-lg bg-surface-raised border border-line p-3 max-h-[28rem] overflow-y-auto">
            @if (detailLoading)
            {
                <p class="text-sm text-content-subtle italic">Loading message…</p>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
            {
                <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto">@((MarkupString)detail.BodyHtml)</div>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml))
            {
                <p class="text-sm text-content whitespace-pre-wrap">@detail.BodyHtml</p>
            }
            else
            {
                <p class="text-sm text-content-subtle italic">@(selected is null ? "" : Dash(selected.BodyPreview))</p>
            }
        </div>

        @* Replies already sent from the projects mailbox on this thread — shown right under the
           email so "did we answer this?" never needs Outlook, and another reply can follow. *@
        @if (SentReplies.Count > 0)
        {
            <div class="rounded-lg border border-positive/30 bg-positive/5 p-3 space-y-1.5">
                <p class="text-[11px] uppercase tracking-wider text-positive font-semibold">Replies sent · @SentReplies.Count</p>
                @foreach (var sent in SentReplies)
                {
                    <button type="button" @key="sent.Id" class="w-full text-left text-xs hover:bg-surface-raised rounded px-1.5 py-1"
                            title="Open this reply" @onclick="() => Select(sent)">
                        <span class="text-content-subtle">@ListDate(sent.ReceivedAt)</span>
                        <span class="text-content ml-2">@FirstLineOf(sent.BodyPreview)</span>
                    </button>
                }
            </div>
        }

        @*
            Thread panel: the rest of this email's conversation, read live and regardless of tags.
            Later replies often say how the older messages should be triaged (e.g. "ignore my last —
            resolved on site"), so triaging oldest-first still shows the newest context. Click a
            member to open it. Linking or discarding already applies to the whole thread server-side.
        *@
        @if (selected is not null && !string.IsNullOrEmpty(selected.ConversationId))
        {
            @if (threadLoading)
            {
                <p class="text-xs text-content-subtle italic">Checking the thread for replies…</p>
            }
            else if (threadError is { } threadProblem)
            {
                <p class="text-xs text-amber-600">
                    @threadProblem
                    <button type="button" class="ml-2 underline" @onclick="() => LoadThreadAsync(selected!)">Retry</button>
                </p>
            }
            else if (thread.Count > 1)
            {
                @* The thread as TABS, not a stacked list: one numbered chip per email (oldest →
                   newest), the open one highlighted — click a tab and the content above switches
                   to that email. A row of chips carries an 11-email thread in one line. *@
                <div class="rounded-lg bg-surface-raised border border-line px-3 py-2">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mr-1">
                            Thread · email @(ThreadPositionOfSelected) of @thread.Count
                        </span>
                        @for (var i = 0; i < thread.Count; i++)
                        {
                            var member = thread[i];
                            var isCurrent = member.Id == selected.Id;
                            var isLatest = i == thread.Count - 1;
                            <button type="button" @key="member.Id" disabled="@isCurrent"
                                    title="@($"{DisplayFrom(member)} — {Date(member.ReceivedAt)}{(member.HasAttachments ? " · has attachments" : "")}")"
                                    @onclick="() => Select(member)"
                                    class="@ThreadTabClass(isCurrent, isLatest)">
                                @(i + 1)@(isLatest ? " ·" : "")
                            </button>
                        }
                        @if (thread[^1].Id != selected.Id)
                        {
                            <span class="text-[11px] text-content-subtle">· read the latest (@thread.Count) before triaging — actions apply to the whole thread</span>
                        }
                        @if (threadMatchedBySubject)
                        {
                            <span class="text-[11px] text-amber-600"
                                  title="Outlook gave this email a different conversation id from the rest of the chain, so its members were found by subject. Apply's whole-thread sweep follows Outlook's id — emails matched here by subject keep their own queue entries and are triaged from those.">
                                · thread matched by subject — Entire thread = Yes sweeps only the emails sharing this one's Outlook id
                            </span>
                        }
                    </div>
                </div>
            }
        }

    </text>;

    @*
        The four page-owned pane contents for the workspace (the other four panes own their own
        data). Declared here as fragments — like MessageHeader/MessageBody above — so every one
        reads the page's live fields and the page stays the single orchestrator it always was.
    *@

    RenderFragment InboxPaneContent =@<div class="space-y-4 lg:pr-1">
        <header>
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium">JPMS · projects@@jewelbb.co.uk</p>
            @* Each strapline is a count, not a description, so it waits for its own list — it
               simply does not render until the count is known (see the loading-states notes). *@
            @if (view == QueueView.Active && queueArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @total email@(total == 1 ? "" : "s") in the inbox waiting to be assigned to a request.
                </p>
            }
            else if (view == QueueView.Discarded && discardedArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @discardedTotal discarded email@(discardedTotal == 1 ? "" : "s") — restore one to put it back in the queue.
                </p>
            }
            else if (view == QueueView.Tagged && taggedArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @taggedTotal tagged email@(taggedTotal == 1 ? "" : "s") — add or remove tags to manage which processes use them.
                </p>
            }
        </header>

        @* Sticky, so the pane's navigation stays in reach however far the list is scrolled
           (bg-canvas so rows vanish behind it). *@
        <div class="sticky top-0 z-10 bg-canvas flex items-center gap-2 border-b border-line">
            <button type="button" class="@ViewTabClass(QueueView.Active)" @onclick="() => SwitchView(QueueView.Active)">Queue</button>
            <button type="button" class="@ViewTabClass(QueueView.Tagged)" @onclick="() => SwitchView(QueueView.Tagged)">Tagged</button>
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@loadError</p>
        }

        @if (view == QueueView.Active)
        {
        @* No gate: this panel only exists when there ARE unassigned requests, so on most loads it
           is absent before the register answers and absent after it — announcing that wait would
           promise something that never arrives. It appears if and when there is something to say. *@
        @if (unassignedArrived && unassigned.Count > 0)
        {
            <div class="panel p-5 mb-6 border-amber-500/40">
                <div class="flex items-start gap-2 mb-1">
                    <h2 class="text-sm font-semibold text-amber-700">Unassigned requests</h2>
                    <span class="inline-flex items-center rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600">@unassigned.Count</span>
                </div>
                <p class="text-xs text-content-subtle mb-3">
                    These requests aren't tied to a live project, so they don't appear in any register. Return one to the Control Centre to process its emails again and pick the right project.
                </p>
                @if (unassignedError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@unassignedError</p>
                }
                <div class="space-y-2">
                    @foreach (var request in unassigned)
                    {
                        <div @key="request.RequestId" class="flex items-center justify-between gap-3 rounded-lg border border-line px-3 py-2">
                            <div class="min-w-0">
                                <p class="text-sm text-content truncate">
                                    <span class="font-mono text-xs text-content-muted mr-2">@Dash(request.Reference)</span>@Dash(request.Title)
                                </p>
                                <p class="text-[11px] text-content-subtle mt-0.5">Issued @Date(request.IssuedAt ?? request.RaisedAt) · @Dash(request.RaisedByEmail)</p>
                            </div>
                            <button type="button" class="btn-secondary text-xs whitespace-nowrap"
                                    disabled="@busy" @onclick="() => ReturnUnassigned(request)">
                                Return to Control Centre
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        <LoadGate IsLoading="@(!queueArrived)" Prominent="true" Label="Loading the inbox">
        @if (loadError is not null && items.Count == 0)
        {
            @* A failed page has no queue to report; "nothing in the queue" would read as one. *@
            <p class="text-sm text-negative">Couldn't load the inbox. The reason is in the red bar above — reload to try again.</p>
        }
        else if (total == 0)
        {
            <div class="panel p-8 text-center">
                <p class="text-sm text-content">Nothing in the queue.</p>
                <p class="text-xs text-content-subtle mt-1">Every email in the requests mailbox has been dealt with.</p>
            </div>
        }
        else
        {
            <div class="relative space-y-2">
                    @* Sort is a light, rarely-used view preference — small muted text under the
                       header, not an action button. The choice is remembered per user. *@
                    <div class="flex items-center gap-3 text-xs px-1">
                        <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: false)" class="@SortLinkClass(false)">Oldest first</button>
                        <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: true)" class="@SortLinkClass(true)">Newest first</button>
                    </div>
                    @if (listLoading)
                    {
                        <JewelSpinner Overlay="true" Label="Loading" />
                    }
                    @{ string? lastQueueGroup = null; }
                    @foreach (var item in items)
                    {
                        @* Outlook-style date group headers — Today / Yesterday / day names / dates. *@
                        var queueGroup = DateGroupLabel(item.ReceivedAt);
                        @if (queueGroup != lastQueueGroup)
                        {
                            lastQueueGroup = queueGroup;
                            <p class="text-xs font-semibold text-content-muted uppercase tracking-wider pt-2 pb-0.5 px-1">@queueGroup</p>
                        }
                        <button type="button" @key="item.Id" @onclick="() => Select(item)"
                                class="@RowClass(item)">
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                            </div>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                @* Parked work waits on this email — the marker says "open me to carry on". *@
                                @if (parkedTriageByEmailId.ContainsKey(item.Id))
                                {
                                    <span title="Unfinished triage — open the email to carry on where you left off" class="text-[10px] font-semibold text-accent shrink-0">✎ draft</span>
                                }
                                @if (item.HasAttachments)
                                {
                                    <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                }
                            </div>
                            @* The opening line of the email — the Outlook-style preview that lets the
                               list be scanned without opening anything. *@
                            @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                            {
                                <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                            }
                            @* Thread hint: this email is untriaged, but other messages in its
                               conversation already carry record tags. Surfacing them here tells the
                               triager it's a reply to an already-linked thread, so re-linking is one
                               step — outline chips, so they don't read as this email's own tags. *@
                            @if (item.ThreadTags is { Count: > 0 } threadTags)
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    <span class="text-[10px] text-content-subtle">Thread:</span>
                                    @foreach (var tag in threadTags)
                                    {
                                        <span class="inline-flex items-center rounded-full border border-accent/40 text-accent/90 text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                    }
                                </div>
                            }
                            @* A queue email tagged while it stayed open (Create now raised a record
                               from it) carries its filing here, exactly as the Tagged tab's rows do,
                               until Apply reloads the queue and it leaves. Queue reads never return
                               a tagged email, so this only ever lights up for that case. *@
                            @if (item.Bucket is not null || item.Categories.Count > 0)
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    @if (PathwayFromBucket(item.Bucket) is { } queueRowPathway)
                                    {
                                        <span class="inline-flex items-center rounded-full @PathwayChipColour(queueRowPathway) text-[10px] font-medium px-2 py-0.5">@PathwayLabel(queueRowPathway)</span>
                                    }
                                    @foreach (var tag in item.Categories)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                    }
                                </div>
                            }
                        </button>
                    }

                    @if (QueuePageCount > 1)
                    {
                        <div class="flex items-center justify-between gap-2 pt-2">
                            @if (queueIndex > 0)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousPage">Previous</button>
                            }
                            else
                            {
                                <span></span>
                            }
                            <span class="text-[11px] text-content-subtle">Page @(queueIndex + 1) / @QueuePageCount · @total email@(total == 1 ? "" : "s")</span>
                            @if (queueNext is not null)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextPage">Next</button>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                </div>
        }
        </LoadGate>
        }
        else if (view == QueueView.Discarded)
        {
            <LoadGate IsLoading="@(!discardedArrived)" Prominent="true" Label="Loading discarded emails">
            @if (loadError is not null && discardedItems.Count == 0)
            {
                @* A failed page has nothing to report; "no discarded emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the discarded emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (discardedTotal == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No discarded emails.</p>
                    <p class="text-xs text-content-subtle mt-1">Emails you discard from the queue show up here, and can be restored.</p>
                </div>
            }
            else
            {
                <div class="relative space-y-2">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in discardedItems)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                    <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                                {
                                    <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                                }
                            </button>
                        }

                        @if (DiscardedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (discardedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousDiscarded">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(discardedIndex + 1) / @DiscardedPageCount · @discardedTotal email@(discardedTotal == 1 ? "" : "s")</span>
                                @if (discardedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextDiscarded">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>
            }
            </LoadGate>
        }
        else
        {
            @* Search the tagged pile — one box, two answers. A record reference ("WO-0045",
               "TODO-0011", "RFI-012") resolves to its tag (ResolveRecordTags) and becomes the
               server-side tag filter, so the list below IS that record's mail — paging, selection
               and the tags pane all as normal. Anything else free-text searches the whole mailbox
               (SearchMailboxMessages — subjects, senders, bodies, attachment names) and shows the
               tagged matches in the list's place. While a query is live the pathway/tag controls
               render disabled (never hidden): the search owns the one server-side filter slot. *@
            <div class="relative mb-3 max-w-xl">
                <input type="search" class="field w-full text-sm pr-8"
                       placeholder="Search tagged emails — subject or sender, or a record reference (WO-0045)"
                       value="@taggedSearch" @oninput="OnTaggedSearchInput" />
                @if (taggedSearch.Trim().Length > 0)
                {
                    <button type="button" title="Clear search"
                            class="absolute right-2 top-1/2 -translate-y-1/2 text-content-faint hover:text-content-muted text-sm leading-none"
                            @onclick="ClearTaggedSearchAsync">✕</button>
                }
            </div>

            @* Pathway filter: one chip per pathway, read server-side as an exact bucket-category
               filter. Kept separate from (and mutually exclusive with) the tag filter below — Graph
               composes category filters with OR only, so combining them would show a union, not the
               intersection the combination looks like. *@
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Pathway</span>
                <button type="button" class="@PathwayFilterChipClass(null) disabled:opacity-50" disabled="@TaggedSearchActive" title="@PathwayDisabledTitle" @onclick="() => SetPathwayFilter(null)">All</button>
                <button type="button" class="@PathwayFilterChipClass(ClientBucket) disabled:opacity-50" disabled="@TaggedSearchActive" title="@PathwayDisabledTitle" @onclick="() => SetPathwayFilter(ClientBucket)">Client</button>
                <button type="button" class="@PathwayFilterChipClass(SubcontractorBucket) disabled:opacity-50" disabled="@TaggedSearchActive" title="@PathwayDisabledTitle" @onclick="() => SetPathwayFilter(SubcontractorBucket)">Subcontractor</button>
                <button type="button" class="@PathwayFilterChipClass(InternalBucket) disabled:opacity-50" disabled="@TaggedSearchActive" title="@PathwayDisabledTitle" @onclick="() => SetPathwayFilter(InternalBucket)">Internal</button>
            </div>

            @* The tag list accrues from the emails that have loaded, so before the first page lands
               the dropdown offers only "Discarded" — a short list that looks like the whole list. *@
            @if (taggedArrived)
            {
            <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Filter</span>
                <div class="relative">
                    <button type="button"
                            class="rounded-full border border-line px-3 py-1 text-xs font-medium text-content-muted hover:text-content hover:border-line-strong transition inline-flex items-center gap-1.5 disabled:opacity-50"
                            disabled="@TaggedSearchActive" title="@PathwayDisabledTitle"
                            @onclick="ToggleFilterMenu">
                        @FilterButtonLabel
                        <span class="text-[9px] leading-none">▾</span>
                    </button>
                    @if (filterOpen)
                    {
                        <div class="absolute z-20 mt-1 w-60 max-h-72 overflow-y-auto rounded-lg border border-line bg-surface-raised shadow-lg p-1">
                            <button type="button"
                                    class="w-full text-left rounded px-3 py-1.5 text-sm text-content-muted hover:bg-surface hover:text-content"
                                    @onclick="ClearTagFilters">
                                All tags
                            </button>
                            <div class="my-1 border-t border-line"></div>
                            @foreach (var tag in knownTags)
                            {
                                <label class="flex items-center gap-2 rounded px-3 py-1.5 text-sm text-content hover:bg-surface cursor-pointer">
                                    <input type="checkbox" checked="@selectedTags.Contains(tag)" @onchange="() => ToggleTag(tag)" />
                                    <span>@TagLabel(tag)</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                @foreach (var tag in selectedTags)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent bg-surface-raised px-2.5 py-1 text-xs text-content">
                        @TagLabel(tag)
                        <button type="button" class="text-content-subtle hover:text-negative disabled:opacity-50" disabled="@TaggedSearchActive" @onclick="() => ToggleTag(tag)" title="Remove filter">✕</button>
                    </span>
                }
            </div>
            }
            @* What the search box is currently answering — the resolved record, the in-flight
               read, or the free-text match count. A line of text, so it renders only once known. *@
            @if (taggedSearchRecord is LinkableRecord searchRecord)
            {
                <p class="text-xs text-content-subtle mb-3">
                    Showing emails tagged to <span class="font-mono">@searchRecord.Reference</span> — @searchRecord.Title.
                    @if (ExplorerRecordTypes.FullPageHref(searchRecord) is string searchHref)
                    {
                        <a class="underline underline-offset-2 hover:text-content" href="@searchHref">Open @searchRecord.Reference</a>
                    }
                </p>
            }
            else if (taggedSearching)
            {
                <p class="text-xs text-content-subtle mb-3">Searching the mailbox…</p>
            }
            else if (taggedSearchResults is not null)
            {
                <p class="text-xs text-content-subtle mb-3">
                    @taggedSearchResults.Count email@(taggedSearchResults.Count == 1 ? "" : "s") match@(taggedSearchResults.Count == 1 ? "es" : "") "@taggedSearchPending" — best matches first, untagged queue emails included.
                </p>
            }

            <LoadGate IsLoading="@(!taggedArrived)" Prominent="true" Label="Loading tagged emails">
            @if (loadError is not null && taggedItems.Count == 0 && taggedSearchResults is null)
            {
                @* A failed page has nothing to report; "no tagged emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the tagged emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (taggedSearchResults is { Count: 0 })
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No emails match "@taggedSearchPending".</p>
                    <p class="text-xs text-content-subtle mt-1">The search covers subjects, senders, bodies and attachment names across the whole mailbox — or type a record reference like WO-0045 to list that record's mail.</p>
                </div>
            }
            else if (taggedTotal == 0 && taggedSearchResults is null)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@(taggedSearchRecord is not null ? $"No emails are tagged to {taggedSearchRecord.Reference} yet." : selectedTags.Count == 0 ? "No tagged emails." : "No emails with the selected tags.")</p>
                    <p class="text-xs text-content-subtle mt-1">Emails linked to a request (or discarded) appear here. Open one to add it to another request or remove a tag.</p>
                </div>
            }
            else
            {
                var taggedRows = taggedSearchResults ?? taggedItems;
                <div class="relative space-y-2">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in taggedRows)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                    <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                                {
                                    <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                                }
                                @* Parked work waits on this email — the marker says "open me to carry on". *@
                                @if (parkedTriageByEmailId.ContainsKey(item.Id))
                                {
                                    <p class="text-[10px] font-semibold text-accent mt-0.5">✎ draft in progress</p>
                                }
                                @if (item.Bucket is not null || item.Categories.Count > 0)
                                {
                                    <div class="flex flex-wrap items-center gap-1 mt-1">
                                        @* The pathway badge leads the chip row: the thread's filing is the first thing
                                           to know about a tagged email, before which records it feeds. *@
                                        @if (PathwayFromBucket(item.Bucket) is { } rowPathway)
                                        {
                                            <span class="inline-flex items-center rounded-full @PathwayChipColour(rowPathway) text-[10px] font-medium px-2 py-0.5">@PathwayLabel(rowPathway)</span>
                                        }
                                        @foreach (var tag in item.Categories)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @* Only reachable from a free-text search hit — the paged pile is
                                       tagged by definition. Selecting it opens it for tagging. *@
                                    <div class="flex flex-wrap items-center gap-1 mt-1">
                                        <span class="inline-flex items-center rounded-full bg-surface-raised border border-line text-content-subtle text-[10px] font-medium px-2 py-0.5">Untagged — still in the queue</span>
                                    </div>
                                }
                            </button>
                        }

                        @* Free-text results are one relevance-ordered page, not the cursor-paged
                           pile, so the pager stands down while they're up. *@
                        @if (taggedSearchResults is null && TaggedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (taggedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousTagged">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(taggedIndex + 1) / @TaggedPageCount · @taggedTotal email@(taggedTotal == 1 ? "" : "s")</span>
                                @if (taggedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextTagged">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>
            }
            </LoadGate>
        }
    </div>;

    RenderFragment EmailPaneContent =@<div>
        @if (view == QueueView.Active)
        {
            @if (selected is null)
            {
                        @if (composeOutcome is { } outcome)
                        {
                            <div class="panel p-5 mb-4 @(outcome.Sent ? "border-positive/40" : "border-amber-500/40") space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider font-semibold @(outcome.Sent ? "text-positive" : "text-amber-600")">
                                        @(outcome.Sent ? "Email sent" : "Saved as draft")
                                    </p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => composeOutcome = null">✕</button>
                                </div>
                                <p class="text-sm text-content">
                                    <span class="font-medium">@outcome.Subject</span>
                                    — @(outcome.Sent ? "sent to" : "addressed to") @(string.Join("; ", outcome.To))@(outcome.Cc.Count > 0 ? $" (cc {string.Join("; ", outcome.Cc)})" : "").
                                    @if (outcome.RaisedRequest is { } raised)
                                    {
                                        <span> <span class="font-mono text-xs text-content-muted">@raised.Reference</span> was raised from the email.</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(outcome.FailureNote))
                                {
                                    <p class="text-sm text-amber-600">@outcome.FailureNote</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(outcome.WebLink))
                                {
                                    <a class="text-accent underline text-sm" href="@outcome.WebLink" target="_blank" rel="noopener">Open in Outlook</a>
                                }
                            </div>
                        }
                        @if (linkNote is not null)
                        {
                            <div class="panel p-5 mb-4 border-amber-500/40 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider text-amber-600 font-semibold">Partially linked</p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => linkNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@linkNote</p>
                            </div>
                        }
                        @if (poEmailNote is not null)
                        {
                            <div class="panel p-5 mb-4 @(poEmailNoteIsSuccess ? "border-positive/40" : "border-amber-500/40") space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider font-semibold @(poEmailNoteIsSuccess ? "text-positive" : "text-amber-600")">
                                        Purchase-order email
                                    </p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => poEmailNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@poEmailNote</p>
                            </div>
                        }
                        @if (outboxNote is not null)
                        {
                            <div class="panel p-5 mb-4 border-positive/40 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider text-positive font-semibold">Outbox</p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => outboxNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@outboxNote</p>
                            </div>
                        }
                <div class="panel p-8 text-center text-sm text-content-subtle">
                    Select an email to process it.
                </div>
            }
            else
            {
                <div class="panel p-5 space-y-4 relative">
                    @if (busy)
                    {
                        <JewelSpinner Overlay="true" Label="@busyLabel" />
                    }

                    @MessageHeader

                    @* The filing this email already carries — only ever present on a queue email
                       that was tagged while open (Create now), so the triager sees the record
                       tag land without leaving the email. Managing tags stays on the Tagged tab. *@
                    @if (selected.Bucket is not null || selected.Categories.Count > 0)
                    {
                        <div class="flex flex-wrap items-center gap-1.5">
                            <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Tagged</span>
                            @if (FixedPathway is { } openEmailPathway)
                            {
                                <span class="inline-flex items-center rounded-full @PathwayChipColour(openEmailPathway) text-xs font-medium px-2.5 py-1">@PathwayLabel(openEmailPathway)</span>
                            }
                            @foreach (var tag in selected.Categories)
                            {
                                <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-xs font-medium px-2.5 py-1">@TagLabel(tag)</span>
                            }
                        </div>
                    }

                    @MessageAttachments

                    @MessageBody

                            @* Reply (or forward) where the reading ends — you get to the bottom of
                               an email and answer it or pass it on, so the buttons (and the open
                               composer) sit right here. *@
                            @if (!replyOpen)
                            {
                                <div class="flex items-center gap-2">
                                    <button type="button" class="btn-secondary" @onclick="() => OpenReplyComposer(forward: false)">↩ Reply</button>
                                    <button type="button" class="btn-secondary" @onclick="() => OpenReplyComposer(forward: true)">→ Forward</button>
                                </div>
                            }
                            <div>
                                    @if (replyOpen)
                                    {
                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between">
                                                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">@(replyIsForward ? "Forward" : "Reply") — sends from the projects mailbox</p>
                                                <button type="button" class="text-xs text-content-subtle hover:text-negative underline" @onclick="DiscardReplyDraft">Discard draft</button>
                                            </div>

                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">To *</label>
                                                <input class="field" type="text" placeholder="name@example.com; other@example.com"
                                                       value="@replyToField" @oninput="OnReplyToInput" />
                                            </div>
                                            <div>
                                                <div class="flex items-center justify-between">
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Cc</label>
                                                    @if (!replyShowBcc)
                                                    {
                                                        <button type="button" class="text-xs text-content-subtle hover:text-content underline" @onclick="() => replyShowBcc = true">Bcc</button>
                                                    }
                                                </div>
                                                <input class="field" type="text" placeholder="Copied recipients — separated by ;"
                                                       value="@replyCcField" @oninput="OnReplyCcInput" />
                                            </div>
                                            @if (replyShowBcc)
                                            {
                                                <div>
                                                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Bcc</label>
                                                    <input class="field" type="text" placeholder="Blind-copied recipients — separated by ;"
                                                           value="@replyBccField" @oninput="OnReplyBccInput" />
                                                </div>
                                            }
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subject *</label>
                                                <input class="field" type="text" value="@replySubject" @oninput="OnReplySubjectInput" />
                                            </div>
                                            <div>
                                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">@(replyIsForward ? "Your message *" : "Your reply *")</label>
                                                <RichTextEditor @bind-Value="replyBody" @bind-Value:after="PublishReplyDraft" MinHeight="180"
                                                                Placeholder="@(replyIsForward ? "Write the message — the forwarded email is quoted behind it…" : "Write the reply — the whole thread is quoted behind it…")" />
                                            </div>

                                            @* A forward carries the original email's attachments automatically (Graph's
                                               createForward copies them onto the draft), so the picker only offers EXTRA
                                               files — offering the originals again would attach every file twice. *@
                                            <AttachmentPicker Attachments="replyAttachments" AttachmentsChanged="OnReplyAttachmentsChanged"
                                                              Projects="ProjectOptionsFor(ComposeContextProjectId)" ProjectId="@ComposeContextProjectId"
                                                              OriginalAttachments="@(replyIsForward ? null : detail?.Attachments)" OriginalMessageId="@selected?.Id" />
                                            @if (replyIsForward && detail is { Attachments.Count: > 0 } forwardedDetail)
                                            {
                                                <p class="text-xs text-content-subtle">
                                                    The original email's @(forwardedDetail.Attachments.Count == 1 ? "attachment travels" : $"{forwardedDetail.Attachments.Count} attachments travel")
                                                    with the forward automatically.
                                                </p>
                                            }

                                        </div>
                                    }
                                </div>
                </div>
            }
        }
        else if (view == QueueView.Discarded)
        {
            @if (selected is null)
            {
                <div class="panel p-8 text-center text-sm text-content-subtle">
                    Select a discarded email to view it.
                </div>
            }
            else
            {
                            <div class="panel p-5 space-y-4 relative">
                                @if (busy)
                                {
                                    <JewelSpinner Overlay="true" Label="@busyLabel" />
                                }
                                @if (actionError is not null)
                                {
                                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                                }

                                @MessageHeader

                                @MessageAttachments

                                @MessageBody

                                <div class="pt-3 border-t border-line">
                                    <p class="text-sm text-content-muted mb-3">
                                        This email was discarded. Restore it to remove the “discarded” tag and put it back in the queue.
                                    </p>
                                    <button type="button" class="btn-primary" disabled="@busy" @onclick="DoRestore">Restore to queue</button>
                                </div>
                            </div>
            }
        }
        else
        {
            @if (selected is null)
            {
                <div class="panel p-8 text-center text-sm text-content-subtle">
                    Select a tagged email to manage its tags.
                </div>
            }
            else
            {
                            <div class="panel p-5 space-y-4 relative">
                                @if (busy)
                                {
                                    <JewelSpinner Overlay="true" Label="@busyLabel" />
                                }
                                @if (actionError is not null)
                                {
                                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
                                }

                                @MessageHeader

                                @MessageAttachments

                                @MessageBody

                                <div class="pt-3 border-t border-line space-y-4">
                                    <div>
                                        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">Tags on this email</p>
                                        @* The pathway badge is shown apart from the tag chips: it isn't removable here —
                                           the server drops the bucket itself when the last record tag goes. *@
                                        @if (FixedPathway is { } taggedPathway)
                                        {
                                            <div class="mb-2">
                                                <span class="inline-flex items-center rounded-full @PathwayChipColour(taggedPathway) text-xs font-medium px-2.5 py-1">Filed under @PathwayLabel(taggedPathway)</span>
                                            </div>
                                        }
                                        @if (selected.Categories.Count == 0)
                                        {
                                            <p class="text-sm text-content-subtle italic">No workflow tags. (Refresh if you just changed them.)</p>
                                        }
                                        else
                                        {
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var tag in selected.Categories)
                                                {
                                                    <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-raised px-2.5 py-1 text-xs text-content">
                                                        @TagLabel(tag)
                                                        <button type="button" class="text-content-subtle hover:text-negative" disabled="@busy" @onclick="() => DoRemoveTag(tag)" title="Remove this tag">✕</button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div>
                                        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">Link to another record</p>
                                        <div class="space-y-3">
                                            @* Each type shows the pathway it files under. Every type is offered
                                               whatever the thread's pathway (the hard client wall was removed
                                               2026-08-21) — a link that would add a second pathway gets a heads-up
                                               below and the server's cross-filing confirm on submit. *@
                                            <select class="field" value="@((int)linkRecordType)" @onchange="OnLinkRecordTypeChanged">
                                                @foreach (var recordType in TaggedLinkTypeOptions)
                                                {
                                                    <option value="@((int)recordType)">@RecordTypeLabel(recordType) — @RecordTypePathwayLabel(recordType)</option>
                                                }
                                            </select>

                                            <select class="field" value="@triageProjectId" @onchange="OnTriageProjectChanged">
                                                <option value="">Select a project…</option>
                                                @foreach (var project in ProjectOptionsFor(triageProjectId))
                                                {
                                                    <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                                                }
                                            </select>

                                            @if (!string.IsNullOrWhiteSpace(triageProjectId))
                                            {
                                                @if (linkRecordsLoading)
                                                {
                                                    <p class="text-sm text-content-subtle italic">Loading @(RecordTypeLabelPlural(linkRecordType))…</p>
                                                }
                                                else
                                                {
                                                    <select class="field" value="@linkRecordId" @onchange="OnTaggedRecordChanged">
                                                        <option value="">Select a @(RecordTypeLabelSingular(linkRecordType))…</option>
                                                        @foreach (var record in ProjectRecords())
                                                        {
                                                            <option value="@record.RecordId">@record.Reference — @record.Title</option>
                                                        }
                                                    </select>
                                                }
                                            }

                                            @* The cross-filing heads-up: a type whose pathway differs from the thread's
                                               would file it under both, which the server asks to confirm. Applies to any
                                               crossing — Client↔Subcontractor/Internal included, now the wall is gone. *@
                                            @if (FixedPathway is { } fixedPw && ImpliedPathway(linkRecordType) is { } linkPw && linkPw != fixedPw)
                                            {
                                                <p class="text-xs text-amber-600">This would file the thread under @PathwayLabel(linkPw) as well as @PathwayLabel(fixedPw) — you'll be asked to confirm.</p>
                                            }

                                            <button type="button" class="btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(linkRecordId))" @onclick="DoAddTagLink">
                                                Link to selected record
                                            </button>

                                            @if (crossFileMessage is not null)
                                            {
                                                <div class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 space-y-2">
                                                    <p class="text-sm text-content">@crossFileMessage</p>
                                                    <button type="button" class="btn-secondary text-xs" disabled="@busy" @onclick="DoAddTagLinkConfirmCross">File under both anyway</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
            }
        }
    </div>;

    @*
        The email's read-only twin (PanelKind.EmailMirror): the same header, attachments and body
        fragments rendered a SECOND time, so one window can sit on the email while the reply is
        typed at the bottom of the other — copying from the original without scrolling the composer
        out of view. Both copies read the same live page fields, so the thread tabs, document-triage
        ticks and previews stay in step whichever side they're clicked on. The reply composer itself
        deliberately isn't mirrored: one editor, one draft, no two cursors fighting over it.
    *@
    RenderFragment EmailMirrorPaneContent =@<div>
        @if (view != QueueView.Active || selected is null)
        {
            <div class="panel p-8 text-center text-sm text-content-subtle">
                Open a queue email first — this window shows a reading copy of it.
            </div>
        }
        else
        {
            <div class="panel p-5 space-y-4">
                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">
                    Reading copy — the reply is written in the other window
                </p>

                @MessageHeader

                @MessageAttachments

                @MessageBody
            </div>
        }
    </div>;

    @*
        The triage bar — rendered ABOVE the two-window split, because the selected email is the
        one thing global to everything below: whatever the windows are showing, this strip says
        which email is being dealt with, holds the decisions that belong to the email itself
        (project, the staged-work doors, the two Yes/No decisions) and fires the one Apply. Selecting another
        email swaps the bar's subject; the windows carry on where they were.
    *@
    RenderFragment TriageBarContent =@<div class="panel px-4 py-3 mb-3 relative space-y-3">
        @if (busy)
        {
            <JewelSpinner Overlay="true" Label="@busyLabel" />
        }

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <div class="min-w-0 max-w-full xl:max-w-sm">
                <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">Dealing with</p>
                <p class="text-sm font-medium text-content truncate" title="@Dash(selected!.Subject)">@Dash(selected.Subject)</p>
                <p class="text-[11px] text-content-subtle truncate">@DisplayFrom(selected) · @Date(selected.ReceivedAt)</p>
            </div>

            @* PROJECT — the easiest decision, made first; everything staged below uses it.
               Auto-matched from the email text when a single live project's name appears. The
               picker carries the completed-projects toggle inside its own panel (ProjectSelect). *@
            <div class="flex flex-wrap items-center gap-2">
                <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold shrink-0">Project</label>
                <ProjectSelect Projects="@AllProjects" Value="@triageProjectId" ValueChanged="OnTriageProjectPicked"
                               ToggleTitle="The email's project — everything staged files against it" />
            </div>

            @* The email-global decisions, stacked and compact — the full wording lives in the
               hover titles. Each is a Yes/No pair that starts BLANK: neither side is pre-picked,
               and Apply stands down until both are answered, so every apply carries a conscious
               choice rather than an inherited default. The thread row says how many emails a Yes
               would sweep, once the thread has been read (staging tags themselves lives on the
               System Tags window). *@
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between gap-3"
                     title="Yes tags the email to the project's programme — it appears in the Programme tab's Relevant Events. No leaves the programme out of it">
                    <span class="text-sm text-content">Relevant Event for Programme</span>
                    <div class="flex items-center shrink-0">
                        <button type="button" class="@YesNoClass(relevantEventStaged, answer: true, first: true)"
                                @onclick="() => relevantEventStaged = true">Yes</button>
                        <button type="button" class="@YesNoClass(relevantEventStaged, answer: false, first: false)"
                                @onclick="() => relevantEventStaged = false">No</button>
                    </div>
                </div>
                <div class="flex items-center justify-between gap-3"
                     title="Yes means everything you apply also tags every email currently in this conversation, clearing them from the queue together. No deals with just this email">
                    <span class="text-sm text-content">Entire thread@(thread.Count > 1 ? $" · {thread.Count} emails" : "")</span>
                    <div class="flex items-center shrink-0">
                        <button type="button" class="@YesNoClass(triageEntireThread, answer: true, first: true)"
                                @onclick="() => triageEntireThread = true">Yes</button>
                        <button type="button" class="@YesNoClass(triageEntireThread, answer: false, first: false)"
                                @onclick="() => triageEntireThread = false">No</button>
                    </div>
                </div>
            </div>
        </div>

        @if (projectAutoMatched && !string.IsNullOrWhiteSpace(triageProjectId))
        {
            <p class="text-xs text-accent">Project matched from the email — change it if that's wrong.</p>
        }
        @if (actionError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
        }
        @if (discardArmed)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-content">
                Discard this email if it isn't for a record at all — spam, an auto-reply, or sent to the wrong place. It (and its thread) gets a "discarded" tag and leaves the queue; nothing moves in the mailbox, and it can be restored from the Tagged tab. Applied by the Apply button.
            </p>
        }
        @if (crossFileMessage is not null)
        {
            <div class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 space-y-2">
                <p class="text-sm text-content">@crossFileMessage</p>
                @* Re-runs whichever act hit the confirm — the Apply, or System Actions' Create
                   now — with consent. The server pre-flights the check before anything persists,
                   so the re-run creates exactly one record either way. *@
                <button type="button" class="btn-secondary text-xs" disabled="@busy"
                        @onclick="() => crossFileRetryIsCreateNow ? DoCreateStagedNow(allowCrossPathway: true) : DoApplyAll(pendingSaveDraft, allowCrossPathway: true)">
                    File under both anyway
                </button>
            </div>
        }

        @* ---- The one action bar: whatever is set up here and in the windows below — a reply,
               to-dos, a record filing — is applied together, in one click. ---- *@
        <div class="pt-2 border-t border-line flex flex-wrap items-center gap-3">
            @if (PendingSummary is { } pending)
            {
                <p class="text-sm text-content flex-1">This will @pending.</p>
            }
            else
            {
                <p class="text-sm text-content-subtle flex-1">Write a reply in the email window, stage tags in System Tags, or line up new records and to-dos in System Actions — then apply it all in one go here.</p>
            }
            <div class="flex items-center gap-2">
                <button type="button" class="@DiscardTabClass" @onclick="() => discardArmed = !discardArmed">🗑 Discard</button>
                <button type="button" class="btn-primary" disabled="@(busy || PendingSummary is null || TagPickingOpen || TriageDecisionsMissing)"
                        title="@(TagPickingOpen ? "System Tags is still open — press Done to confirm the picks first" : TriageDecisionsMissing ? DecisionsMissingHint : null)"
                        @onclick="() => DoApplyAll(saveAsDraftOnly: false)">
                    @ApplyButtonLabel
                </button>
                @if (OutboxSendCount > 0)
                {
                    <button type="button" class="btn-secondary" disabled="@(busy || TagPickingOpen || TriageDecisionsMissing)" @onclick="() => DoApplyAll(saveAsDraftOnly: true)"
                            title="@(TagPickingOpen ? "System Tags is still open — press Done to confirm the picks first" : TriageDecisionsMissing ? DecisionsMissingHint : "Applies the to-dos, filing and tagging above, but stages every lined-up email as an Outlook draft instead of sending it")">
                        @(OutboxSendCount == 1 ? "Save reply as draft" : "Save replies as drafts")
                    </button>
                }
            </div>
        </div>
    </div>;

    @* The bar's stand-in when NO email is selected but replies are lined up in the Outbox: the
       queue can be applied on its own (decision 2026-08-12) — the one Apply, minus the per-email
       decisions that need a selection. *@
    RenderFragment OutboxOnlyBarContent =@<div class="panel px-4 py-3 mb-3 relative space-y-3">
        @if (busy)
        {
            <JewelSpinner Overlay="true" Label="@busyLabel" />
        }
        @if (actionError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@actionError</p>
        }
        <div class="flex flex-wrap items-center gap-3">
            @if (PendingSummary is { } pending)
            {
                <p class="text-sm text-content flex-1">This will @pending.</p>
            }
            <div class="flex items-center gap-2">
                <button type="button" class="btn-primary" disabled="@(busy || PendingSummary is null)" @onclick="() => DoApplyAll(saveAsDraftOnly: false)">
                    @ApplyButtonLabel
                </button>
                @if (OutboxSendCount > 0)
                {
                    <button type="button" class="btn-secondary" disabled="@busy" @onclick="() => DoApplyAll(saveAsDraftOnly: true)"
                            title="Stages every lined-up email as an Outlook draft instead of sending it">
                        @(OutboxSendCount == 1 ? "Save reply as draft" : "Save replies as drafts")
                    </button>
                }
            </div>
        </div>
    </div>;

    RenderFragment TagsPaneContent =@<div>
        @if (view != QueueView.Active || selected is null)
        {
            <div class="panel p-8 text-center text-sm text-content-subtle">
                Open a queue email first — system tags are staged against the email being triaged,
                then applied all together by the inbox window's Apply.
            </div>
        }
        else
        {
            @* Keyed on the message id so a fresh selection starts a fresh pane (the staged work
               itself is page-owned and already resets per selection). *@
            <SystemTagsPane @key="selected.Id"
                            IsOpen="true"
                            ProjectId="@triageProjectId"
                            EmailSubject="@(selected?.Subject ?? "")"
                            LockedPathway="@(FixedPathway is { } fp ? PathwayLabel(fp) : null)"
                            ActivePathway="@(pathway is { } chosenPathway ? PathwayLabel(chosenPathway) : null)"
                            ActivePathwayChanged="OnModalPathwayChanged"
                            Picked="pickedRecords"
                            OnStagingChanged="StateHasChanged"
                            OnClose="CloseSystemTags" />
        }
    </div>;

    RenderFragment ComposePaneContent =@<div class="panel p-5">
        <h2 class="text-base font-semibold text-content mb-4">New email</h2>
        <div class="space-y-3">
        @if (AiTasks.Active?.ModalKey == ModalCatalog.ComposeEmail.ModalKey && Chat.AssistantBusy)
        {
            <p class="rounded-lg bg-accent/10 border border-accent/30 px-3 py-2 text-sm text-accent animate-pulse">
                The assistant is writing into this form — it merges with anything you type, and nothing sends until you press Send.
            </p>
        }
        <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
            Sends from the <span class="font-medium text-content">projects mailbox</span>. Optionally file it to a record so the sent copy shows in that record's correspondence — replies will arrive in the queue either way.
        </p>

        @if (newEmailError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@newEmailError</p>
        }

        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">To *</label>
            <input class="field" type="text" placeholder="name@example.com; other@example.com"
                   value="@newEmailTo" @oninput="OnNewEmailToInput" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Cc</label>
                <input class="field" type="text" placeholder="Separated by ;"
                       value="@newEmailCc" @oninput="OnNewEmailCcInput" />
            </div>
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Bcc</label>
                <input class="field" type="text" placeholder="Separated by ;"
                       value="@newEmailBcc" @oninput="OnNewEmailBccInput" />
            </div>
        </div>
        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subject *</label>
            <input class="field" type="text" value="@newEmailSubject" @oninput="OnNewEmailSubjectInput" />
        </div>
        <div>
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Message *</label>
            <RichTextEditor Value="@newEmailBody" ValueChanged="OnNewEmailBodyChanged" MinHeight="200" Placeholder="Write the email…" />
        </div>

        <AttachmentPicker Attachments="newEmailAttachments" AttachmentsChanged="OnNewEmailAttachmentsChanged"
                          Projects="ProjectOptionsFor(newEmailProjectId)" ProjectId="@newEmailProjectId" />

        <div class="rounded-lg border border-line p-3 space-y-2">
            <label class="flex items-center gap-2 text-sm text-content">
                <input type="checkbox" checked="@newEmailFile" @onchange="OnNewEmailFileToggled" />
                File this email to a record (the sent copy shows in its correspondence)
            </label>
            @if (newEmailFile)
            {
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <select class="field" value="@newEmailProjectId" @onchange="OnNewEmailProjectChanged">
                        <option value="">Select a project…</option>
                        @foreach (var project in ProjectOptionsFor(newEmailProjectId))
                        {
                            <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                        }
                    </select>
                    <select class="field" value="@((int)newEmailRecordType)" @onchange="OnNewEmailRecordTypeChanged">
                        @foreach (var recordType in RecordTypeOptions)
                        {
                            <option value="@((int)recordType)">@RecordTypeLabel(recordType)</option>
                        }
                    </select>
                    <select class="field" value="@newEmailRecordId" @onchange="OnNewEmailRecordChanged" disabled="@(string.IsNullOrEmpty(newEmailProjectId))">
                        <option value="">@(string.IsNullOrEmpty(newEmailProjectId) ? "Select a project first…" : newEmailRecordsLoading ? "Loading…" : "Select a record…")</option>
                        @foreach (var record in newEmailRecords)
                        {
                            <option value="@record.RecordId">@record.Reference — @record.Title</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="flex items-center justify-end gap-2 pt-1">
            <button type="button" class="btn-ghost" disabled="@newEmailBusy" @onclick="CloseNewEmail">Cancel</button>
            <button type="button" class="btn-secondary" disabled="@(newEmailBusy || !NewEmailIsSendable)" @onclick="() => DoSendNewEmail(saveAsDraftOnly: true)">Save as draft</button>
            <button type="button" class="btn-primary" disabled="@(newEmailBusy || !NewEmailIsSendable)" @onclick="() => DoSendNewEmail(saveAsDraftOnly: false)">@(newEmailBusy ? "Sending…" : "Send")</button>
        </div>
    </div>
    </div>;
}

@if (!sessionReady)
{
    <section class="px-6 md:px-8 py-12">
        <LoadGate IsLoading="true" Prominent="true" Label="Loading" />
    </section>
}
else if (!Session.IsApproved)
{
    <RequestAccessView Email="@Auth.CurrentUser!.Email" DisplayName="@Auth.CurrentUser.DisplayName" />
}
else if (!CanTriage)
{
    <section class="px-6 md:px-8 py-12">
        <div class="panel p-8 text-center">
            <p class="text-sm text-content">You don't have access to the Control Centre.</p>
            <p class="text-xs text-content-subtle mt-1">The Control Centre is available to administrators and project managers.</p>
        </div>
    </section>
}
else
{
    @*
        The Control Centre workspace: two side-by-side windows, each with the same icon rail, split
        by a draggable divider (1/3 : 2/3 until dragged). Any content loads either side and always
        remembers where it was — data is gathered by jumping around windows, side by side, instead
        of through modals. On mobile there is one window; the icons still carry the full context.
    *@
    <section class="px-3 md:px-4 pt-3 pb-4 h-[calc(100dvh-5.25rem)] min-h-[34rem] flex flex-col">
        @* The selected email is global to both windows, so its bar sits above the split. *@
        @if (view == QueueView.Active && selected is not null)
        {
            @TriageBarContent
        }
        else if (view == QueueView.Active && queuedReplies.Count > 0)
        {
            @OutboxOnlyBarContent
        }
        <div class="flex-1 min-h-0">
        <PanelWorkspace State="workspace"
                        EmailAvailable="@(selected is not null)"
                        PreviewAvailable="@(workspace.Preview is not null)"
                        TagsBadge="@StagedTagCount"
                        ActionsBadge="@StagedActionCount"
                        OutboxBadge="@OutboxSendCount">
            <InboxContent>@InboxPaneContent</InboxContent>
            <EmailContent>@EmailPaneContent</EmailContent>
            <EmailMirrorContent>@EmailMirrorPaneContent</EmailMirrorContent>
            <TagsContent>@TagsPaneContent</TagsContent>
            <ActionsContent>
                @if (view != QueueView.Active || selected is null)
                {
                    <div class="panel p-8 text-center text-sm text-content-subtle">
                        Open a queue email first — system actions are lined up against the email
                        being triaged and fire with its Apply.
                    </div>
                }
                else
                {
                    @* Keyed on the message id like the tags pane: a fresh selection starts fresh
                       scratch forms (the staged work itself is page-owned and resets per selection). *@
                    <SystemActionsPane @key="selected.Id"
                                       Projects="@ProjectOptionsFor(null)"
                                       ProjectId="@triageProjectId"
                                       StagedActions="stagedSystemActions"
                                       PickedRecords="pickedRecords"
                                       OnStagingChanged="StateHasChanged"
                                       StagedCreate="@stagedCreate"
                                       StagedCreateChanged="v => stagedCreate = v"
                                       CreatedRecords="createdNowRecords"
                                       OnCreateNow="() => DoCreateStagedNow()"
                                       Busy="@busy"
                                       OnClose="() => workspace.Close(PanelKind.SystemActions)"
                                       QsRecipients="@QsRecipients"
                                       OnForwardToQs="StartForwardToQs"
                                       TodoRows="createTodoRows"
                                       TodoAssigneeOptions="todoAssigneeOptions"
                                       TodoProjectNote="@TodoProjectNote"
                                       EmailAttachments="@(detail?.Attachments ?? Array.Empty<IntakeAttachment>())"
                                       SenderEmail="@(selected?.FromEmail ?? "")"
                                       EmailSubject="@(selected?.Subject ?? "")" />
                }
            </ActionsContent>
            <RecordsContent>
                <RecordExplorerPane Projects="@ProjectOptionsFor(null)" OnPreview="OpenRecordPreview"
                                    OnReply="message => StartOutboxReply(message, PanelKind.Records)"
                                    OnForward="message => StartOutboxForward(message, PanelKind.Records)" />
            </RecordsContent>
            <PreviewContent>
                <PreviewPane Request="@workspace.Preview" OnClose="() => workspace.ClosePreview()" />
            </PreviewContent>
            <XeroContent><XeroExplorerPane OnPreview="OpenXeroPreview" /></XeroContent>
            <ComposeContent>@ComposePaneContent</ComposeContent>
            <SubcontractorCommsContent><SubcontractorCommsPane OnPreview="OpenSubcontractorCommsPreview"
                                                               OnReply="message => StartOutboxReply(message, PanelKind.SubcontractorComms)"
                                                               OnForward="message => StartOutboxForward(message, PanelKind.SubcontractorComms)"
                                                               EmailSubject="@OpenQueueEmailSubject"
                                                               ProjectName="@TriageProjectName"
                                                               Picked="pickedRecords"
                                                               OnStagingChanged="StateHasChanged" /></SubcontractorCommsContent>
            <OutboxContent>
                <OutboxPane QueuedReplies="queuedReplies"
                            OnChanged="StateHasChanged"
                            @bind-ComposeAnchor="outboxComposeAnchor"
                            ComposeAnchorIsForward="@outboxComposeAnchorIsForward"
                            ComposeForwardTo="@outboxForwardTo"
                            CurrentReplyPending="@ReplyDraftPending"
                            CurrentReplyIsForward="@replyIsForward"
                            CurrentReplySubject="@replySubject"
                            OnEditCurrentReply="ShowCurrentReplyComposer"
                            OnDiscardCurrentReply="DiscardReplyDraft"
                            Projects="@ProjectOptionsFor(null)"
                            ProjectId="@NullIfBlank(triageProjectId)" />
            </OutboxContent>
        </PanelWorkspace>
        </div>
    </section>

    @* Recently processed — the audit register's latest link/create decisions, newest first, so the
       triager can jump straight to the document an email was just filed against. Its own section
       beneath the whole workspace (reached by scrolling past it), full width — not squeezed into
       the inbox pane under the queue. Closed by default — a native <details> fold, the same
       pattern as the rejected-work-orders pile: it is a reference list, not live work, so the
       header line with its count is enough until the triager actually wants to look. Same no-gate
       pattern as the unassigned panel: it renders if and when there is something to show. (The
       register records client-pathway triage today; subcontractor/internal rows appear here
       automatically once the audit scope widens.) *@
    @if (RecentTriage.Count > 0)
    {
        <section class="px-3 md:px-4 pb-6">
            <div class="panel p-5">
                <details>
                    <summary class="cursor-pointer select-none">
                        <h2 class="inline text-sm font-semibold text-content">Recently processed (@RecentTriage.Count)</h2>
                    </summary>
                    <div class="divide-y divide-line mt-3">
                        @foreach (var entry in RecentTriage)
                        {
                            <div @key="entry.AuditEventId" class="flex items-center gap-3 py-2">
                                <span class="text-[11px] text-content-subtle whitespace-nowrap w-16 shrink-0"
                                      title="@entry.OccurredAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")">@Ago(entry.OccurredAt)</span>
                                @if (RecentHref(entry) is { } href)
                                {
                                    <a class="font-mono text-xs text-content underline underline-offset-2 hover:text-accent whitespace-nowrap" href="@href">@Dash(entry.RecordReference)</a>
                                }
                                else
                                {
                                    <span class="font-mono text-xs text-content-muted whitespace-nowrap">@Dash(entry.RecordReference)</span>
                                }
                                <span class="text-xs text-content-muted truncate">@entry.Detail</span>
                                <span class="text-[11px] text-content-subtle whitespace-nowrap ml-auto hidden md:inline">@RecentMeta(entry)</span>
                            </div>
                        }
                    </div>
                    <div class="mt-3 text-right">
                        <a href="/audit" class="text-xs text-content-muted hover:text-content underline underline-offset-2">Full audit trail</a>
                    </div>
                </details>
            </div>
        </section>
    }
}

@code {
    // The communication pathway — WHO the correspondence is with (docs/Pathway-Split-Platform-Flow-
    // Plan.md §2). Triage is pathway-FIRST: the pathway is chosen (or already fixed on the thread)
    // before any action, and it decides which action tabs and record types are offered.
    private enum TriagePathway { Client, Subcontractor, Internal }
    private static readonly TriagePathway[] PathwayOptions =
    {
        TriagePathway.Client, TriagePathway.Subcontractor, TriagePathway.Internal
    };

    // The triager's pathway choice for the SELECTED email. Pre-set from the thread's own bucket when
    // it already carries one (then shown as a fixed badge — the routing decision was made when the
    // thread was first filed); otherwise null until chosen, and only Discard is offered until it is
    // (discarding is pathway-less).
    private TriagePathway? pathway;

    // The pathway bucket categories exactly as the server stamps them — MailboxMessage.Bucket carries
    // one of these verbatim. Literals here because the WASM app references contracts only; the API's
    // TriageCategories constants aren't visible to it.
    private const string ClientBucket = "JPMS/Client";
    private const string SubcontractorBucket = "JPMS/Subcontractor";
    private const string InternalBucket = "JPMS/Internal";

    private static TriagePathway? PathwayFromBucket(string? bucket)
    {
        if (string.IsNullOrEmpty(bucket)) return null;
        if (bucket.Equals(ClientBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Client;
        if (bucket.Equals(SubcontractorBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Subcontractor;
        if (bucket.Equals(InternalBucket, StringComparison.OrdinalIgnoreCase)) return TriagePathway.Internal;
        return null;
    }

    // The selected thread's already-decided pathway (null = not filed yet). When set, the selector
    // renders as a fixed "Filed under …" badge and the pathway can't be switched — the triager still
    // acts within it.
    private TriagePathway? FixedPathway => PathwayFromBucket(selected?.Bucket);

    // Enum names double as the user-facing labels AND the short pathway strings the server's
    // commands accept ("Client" / "Subcontractor" / "Internal") — keep them in sync with MapPathway.
    private static string PathwayLabel(TriagePathway p) => p.ToString();

    // Pathway chip colours: green-ish Client, orange-ish Subcontractor, purple-ish Internal — the
    // same rounded-pill shape as the tag chips, but distinct hues so rows can be scanned by pathway.
    private static string PathwayChipColour(TriagePathway p) => p switch
    {
        TriagePathway.Client        => "bg-emerald-500/10 text-emerald-600",
        TriagePathway.Subcontractor => "bg-orange-500/10 text-orange-600",
        TriagePathway.Internal      => "bg-purple-500/10 text-purple-600",
        _                           => "bg-accent/10 text-accent"
    };

    // The page shows the live queue (untagged Inbox), the discarded pile, or every tagged email (the
    // management surface for adding/removing workflow tags). The detail pane is shared.
    private enum QueueView { Active, Discarded, Tagged }
    private QueueView view = QueueView.Active;

    // Every record type an email can be LINKED to. Driven by the providers registered server-side;
    // adding a type here surfaces it once its provider exists. Under the pathway-first UI this full
    // list is only the fallback for a tagged thread that has no pathway yet — the pathway-filtered
    // subsets below are what the pickers normally offer.
    // Cost Centre was removed as a link target 2026-08-04 (it never earned its place as a filing
    // destination; existing CC-tagged mail keeps reading fine). VariationQuote is folded into
    // Variation — one record, one number, per the 2026-07-23 unification.
    private static readonly RecordType[] RecordTypeOptions =
    {
        RecordType.Request, RecordType.BidPackageInvite, RecordType.WorkOrder, RecordType.Scheduling, RecordType.Lad, RecordType.Variation, RecordType.Todo
    };

    // What each pathway's "Link to existing" offers (the pathway filters the actions — the plan's
    // §2.2): client-side records only under Client, subcontract-side only under Subcontractor, and
    // Internal links to existing to-do items. CostCentre appears on BOTH sides of the wall because
    // cost-centre mail can be valuation-side or subcontract-side — the pathway choice decides, and
    // travels with the link command.
    private static readonly RecordType[] ClientLinkTypes =
    {
        RecordType.Request, RecordType.Variation, RecordType.Lad, RecordType.Scheduling
    };
    // Subcontractor covers the whole subcontract lifecycle, not just the tender: an email can land
    // before a package exists (a chase, an H&S request), against the order that followed the award
    // (WorkOrder — the plan's §2.2 "link work order"), or onto a to-do that tracks something the
    // supplier owes us. Todo is offered here because to-do links are pathway-neutral, so tagging one
    // never re-files the thread — the same reason the Tagged picker offers it on every pathway.
    private static readonly RecordType[] SubcontractorLinkTypes =
    {
        RecordType.BidPackageInvite, RecordType.WorkOrder
    };
    private static readonly RecordType[] InternalLinkTypes = { RecordType.Todo };

    // The Tagged tab's "link to another record" pool: since the hard client wall was removed
    // (2026-08-21) every type is offered whatever the thread's pathway. Each option's label shows
    // the pathway it files under, and a link that would file the thread under a second pathway
    // goes through the server's cross-filing confirm ("File under both anyway").

    private IReadOnlyList<RecordType> QueueLinkTypeOptions => pathway switch
    {
        TriagePathway.Client        => ClientLinkTypes,
        TriagePathway.Subcontractor => SubcontractorLinkTypes,
        TriagePathway.Internal      => InternalLinkTypes,
        _                           => Array.Empty<RecordType>()
    };

    private IReadOnlyList<RecordType> TaggedLinkTypeOptions => RecordTypeOptions;

    // The pathway a record type files a thread under, as a TriagePathway — mirrors the server's
    // TriageCategories.BucketFor. Null = pathway-neutral (Todo) or per-email choice (CostCentre).
    // Drives the Tagged picker's cross-filing heads-up.
    private static TriagePathway? ImpliedPathway(RecordType type) => type switch
    {
        RecordType.Request or RecordType.Variation or RecordType.VariationQuote
            or RecordType.Scheduling or RecordType.Lad or RecordType.TenderEnquiry => TriagePathway.Client,
        RecordType.BidPackageInvite or RecordType.WorkOrder
            or RecordType.SubcontractorComms => TriagePathway.Subcontractor,
        RecordType.InternalComms => TriagePathway.Internal,
        _ => null
    };

    // The pathway a record type files a thread under, for the Tagged picker's labels — mirrors the
    // server's TriageCategories.BucketFor so the triager sees where a link would put the thread.
    private static string RecordTypePathwayLabel(RecordType type) => type switch
    {
        RecordType.Request or RecordType.Variation or RecordType.VariationQuote
            or RecordType.Scheduling or RecordType.Lad or RecordType.TenderEnquiry => "Client",
        RecordType.BidPackageInvite or RecordType.WorkOrder
            or RecordType.SubcontractorComms => "Subcontractor",
        RecordType.InternalComms    => "Internal",
        RecordType.CostCentre       => "Client or Subcontractor",
        RecordType.Todo             => "Neutral",
        _ => ""
    };

