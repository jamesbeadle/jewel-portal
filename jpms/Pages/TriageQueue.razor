        await LoadTaggedAsync();
    }

    private string PathwayFilterChipClass(string? bucket)
    {
        var baseClass = "rounded-full border px-3 py-1 text-xs font-medium transition";
        return pathwayBucketFilter == bucket
            ? $"{baseClass} border-accent bg-surface-raised text-content"
            : $"{baseClass} border-line text-content-muted hover:text-content hover:border-line-strong";
    }

    private async Task PreviousTagged()
    {
        if (taggedIndex <= 0) return;
        taggedIndex--;
        await LoadTaggedAsync();
    }

    private async Task NextTagged()
    {
        if (taggedNext is null) return;
        taggedIndex++;
        await LoadTaggedAsync();
    }

    private async Task LoadUnassignedAsync()
    {
        unassignedError = null;
        try { unassigned = await RequestRegister.ListUnassignedAsync(); }
        catch { unassigned = Array.Empty<Request>(); }
        finally { unassignedArrived = true; }
    }

    private async Task ReturnUnassigned(Request request)
    {
        if (busy) return;
        unassignedError = null;
        try
        {
            busy = true;
            await RequestRegister.ReturnToTriageAsync(request.RequestId, request.ProjectId);
            await LoadAsync();
            await LoadUnassignedAsync();
        }
        catch
        {
            unassignedError = "Couldn't return that request to triage. Please try again.";
        }
        finally { busy = false; }
    }

    // Point the detail pane at an email: set the selection and reset the create forms. Loading
    // the body and thread is the caller's job — Select does both; the jump-to-latest inside
    // LoadThreadAsync reuses this directly so it doesn't re-fetch the thread it already has.
    private void ApplySelection(MailboxMessage item)
    {
        selected = item;
        // Pathway-first: pre-select the thread's own pathway when it already carries one (rendered as
        // a fixed badge); otherwise the triager chooses before any action beyond Discard is offered.
        pathway = PathwayFromBucket(item.Bucket);
        mode = TriageMode.None;
        actionError = null;
        crossFileMessage = null;
        crossFilePicks.Clear();
        previewAttachment = null;
        threadNote = null;
        ResetLinkState();
        composeOutcome = null;
        linkNote = null;
        replyBody = "";
        replyToField = replyCcField = replyBccField = replySubject = "";
        replyShowBcc = false;
        replyOpen = false;
        replyEnvelopePrefilled = false;
        replyAttachments = Array.Empty<ComposeDraftAttachment>();
        createProjectId = "";
        // Deliberately blank rather than copied from the email — the subject/body of the email is
        // rarely the right subject/detail for the record, so the triager writes their own.
        createTitle = "";
        createDescription = "";
        createRaisedTo = createDrawingRef = "";
        createResponseDue = RequestDefaults.ResponseDue();
        createAddToProgramme = false;
        createTrade = "";
        createTodoRows = new List<TodoDraftRow> { new() };
        createTodoLinkRequestId = "";
        createTodoLinkRequests = Array.Empty<LinkableRecord>();
        alsoTodos = false;
    }

    // jumpToLatest: clicking an email in the QUEUE list triages its thread from the newest member —
    // if later replies exist, the selection moves onto the latest one (the reply that says what to
    // do with the rest; every action applies thread-wide anyway). Clicks inside the thread panel
    // pass false so any member can still be read without being bounced back to the latest.
    private async Task Select(MailboxMessage item, bool jumpToLatest = true)
    {
        ApplySelection(item);
        // Body and thread are independent live reads — fetch them side by side.
        await Task.WhenAll(LoadDetailAsync(item), LoadThreadAsync(item, jumpToLatest));
        // Both reads have landed (including any jump onto the thread's latest reply), so the whole
        // chain is available to search for a project name to pre-fill the pickers with.
        await TryPrefillProjectFromEmailAsync();
    }

    // Fetch the full body + attachment names on demand when an email is opened. Cancels any in-flight
    // fetch so rapid clicking can't race a stale result onto the newly selected email.
    private async Task LoadDetailAsync(MailboxMessage item)
    {
        detailCts?.Cancel();
        var cts = new CancellationTokenSource();
        detailCts = cts;

        detail = null;
        detailLoading = true;
        try
        {
            var loaded = await Intake.GetMessageDetailAsync(item.Id, item.InternetMessageId, cts.Token);
            if (!cts.IsCancellationRequested && selected?.Id == item.Id)
            {
                detail = loaded;
                PrefillReplyEnvelope(item, loaded);
            }
        }
        catch (OperationCanceledException) { /* superseded by a newer selection */ }
        catch { /* leave detail null so the view falls back to the preview */ }
        finally
        {
            if (selected?.Id == item.Id)
                detailLoading = false;
        }
    }

    // Fetch the selected email's whole conversation for the thread panel. Same cancellation shape as
    // LoadDetailAsync: rapid clicking can't race a stale thread onto the newly selected email. The
    // list is cleared up front so a previous selection's thread never flashes against this one.
    private async Task LoadThreadAsync(MailboxMessage item, bool jumpToLatest = false)
    {
        threadCts?.Cancel();
        var cts = new CancellationTokenSource();
        threadCts = cts;

        thread = Array.Empty<MailboxMessage>();
        if (string.IsNullOrEmpty(item.ConversationId)) { threadLoading = false; return; }

        threadLoading = true;
        var jumped = false;
        try
        {
            var page = await Intake.ListConversationLiveAsync(item.ConversationId, cts.Token);
            if (cts.IsCancellationRequested || selected?.Id != item.Id)
                return;
            thread = page.Items;

            // Triage the thread from its newest member: when the clicked email has later replies,
            // move the selection onto the latest one and note where the user came from. Queue view
            // only — the Discarded/Tagged panes are management surfaces where the clicked email is
            // the one being managed.
            if (jumpToLatest && view == QueueView.Active && thread.Count > 1 && thread[^1].Id != item.Id)
            {
                var latest = thread[^1];
                jumped = true;
                threadLoading = false;
                ApplySelection(latest);
                threadNote = $"This email has newer replies, so the latest ({Date(latest.ReceivedAt)}) is shown — triage from here. "
                    + $"The one you clicked ({Date(item.ReceivedAt)}) is in the thread below.";
                await LoadDetailAsync(latest);
            }
        }
        catch (OperationCanceledException) { /* superseded by a newer selection */ }
        catch { /* leave empty: the panel simply doesn't render */ }
        finally
        {
            if (jumped || selected?.Id == item.Id)
                threadLoading = false;
        }
    }

    // ---- Project auto-match ----
    // A simple lower-case search of the email chain for a project's name: when exactly one live
    // project's name appears verbatim (case-insensitive) in the selected email's subject, body or
    // thread, the project pickers are pre-filled with it. The triager still sees — and can change —
    // the choice; an ambiguous chain (two project names in one thread) pre-fills nothing, and a
    // choice already made is never overridden.
    private async Task TryPrefillProjectFromEmailAsync()
    {
        if (view != QueueView.Active || selected is null) return;
        if (!string.IsNullOrWhiteSpace(linkProjectId)
            || !string.IsNullOrWhiteSpace(createProjectId)) return;

        var haystack = BuildEmailSearchText();
        if (haystack.Length == 0) return;

        // Live projects only (the pickers hide completed ones by default), and names under four
        // characters are skipped — too short to be an honest match rather than a coincidence.
        var matches = AllProjects
            .Where(project => project.Stage != ProjectStage.Completed)
            .Where(project => project.Name.Trim() is { Length: >= 4 } name
                && haystack.Contains(name.ToLowerInvariant(), StringComparison.Ordinal))
            .ToList();
        if (matches.Count != 1) return;

        var projectId = matches[0].ProjectId;
        linkProjectId = projectId;
        createProjectId = projectId;
        // The link panel shows records for its chosen project, so the pre-fill loads them too —
        // otherwise it would claim "no records on this project yet" without having looked.
        await LoadLinkRecordsAsync();
    }

    // Everything searchable about the selected email's chain, joined and lower-cased once: subject,
    // preview, the fetched body (tags stripped when HTML) and every thread member's subject/preview.
    private string BuildEmailSearchText()
    {
        var parts = new List<string?> { selected?.Subject, selected?.BodyPreview };
        if (detail is not null)
            parts.Add(detail.BodyIsHtml ? StripHtml(detail.BodyHtml) : detail.BodyHtml);
        foreach (var member in thread)
        {
            parts.Add(member.Subject);
            parts.Add(member.BodyPreview);
        }
        return string.Join("\n", parts.Where(part => !string.IsNullOrWhiteSpace(part))).ToLowerInvariant();
    }

    private static string StripHtml(string html) =>
        System.Text.RegularExpressions.Regex.Replace(html ?? "", "<[^>]*>", " ");

    private static string ThreadRowClass(bool current)
    {
        var baseClass = "w-full text-left rounded-lg border px-3 py-2 transition";
        return current
            ? $"{baseClass} border-accent bg-surface"
            : $"{baseClass} border-line hover:border-line-strong hover:bg-surface";
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:0.#} MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes} B";
    }

    private async Task SetMode(TriageMode next)
    {
        mode = next;
        actionError = null;
        crossFileMessage = null;
        crossFilePicks.Clear();
        // Entering the to-do form with a project already chosen loads its open requests for the
        // optional request link; leaving it clears the pick (the loader guards on the mode).
        await LoadCreateTodoLinkRequestsAsync();
    }

    // Choose the pathway for a not-yet-filed thread. Resets the action state so nothing chosen under
    // one pathway (a record type, picked records) can leak into another; a thread that already
    // carries a pathway ignores this — its routing decision is fixed at first filing.
    private void SetPathway(TriagePathway next)
    {
        if (FixedPathway is not null || pathway == next) return;
        pathway = next;
        mode = TriageMode.None;
        actionError = null;
        crossFileMessage = null;
        crossFilePicks.Clear();
        ResetLinkState();
    }

    // The pathway choice cards: the mandatory first decision, so full-size and impossible to miss —
    // the chosen card fills with the accent, the rest invite the click.
    private string PathwayCardClass(TriagePathway p) =>
        pathway == p
            ? "rounded-xl border-2 border-accent bg-accent text-accent-ink px-4 py-3 text-left transition shadow-sm"
            : "rounded-xl border-2 border-line-strong bg-surface-raised text-content px-4 py-3 text-left transition hover:border-accent hover:bg-surface";

    // One line under each pathway name saying who that side of the wall actually is.
    private static string PathwayDescription(TriagePathway p) => p switch
    {
        TriagePathway.Client        => "The client, or their architect and team",
        TriagePathway.Subcontractor => "A subcontractor or supplier",
        TriagePathway.Internal      => "Jewel staff — company admin",
        _                           => ""
    };

    private async Task OnLinkRecordTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<RecordType>(e.Value?.ToString(), out var type)) linkRecordType = type;
        linkRecordId = "";
        linkRecordIds.Clear();
        await LoadLinkRecordsAsync();
    }

    private async Task OnLinkProjectChanged(ChangeEventArgs e)
    {
        linkProjectId = e.Value?.ToString() ?? "";
        linkRecordId = "";
        linkRecordIds.Clear();
        await LoadLinkRecordsAsync();
    }

    // Load the chosen project's records of the chosen type for the picker. Record-agnostic: the same
    // call backs both the Link panel and the Tagged tab's "link to another record" control.
    private async Task LoadLinkRecordsAsync()
    {
        if (string.IsNullOrWhiteSpace(linkProjectId))
        {
            linkRecords = Array.Empty<LinkableRecord>();
            return;
        }
        try
        {
            linkRecordsLoading = true;
            linkRecordId = "";
            linkRecordIds.Clear();
            StateHasChanged(); // show the loading state while the fetch is in flight
            linkRecords = await Intake.ListLinkableRecordsAsync(linkProjectId, linkRecordType);
        }
        catch
        {
            linkRecords = Array.Empty<LinkableRecord>();
        }
        finally
        {
            linkRecordsLoading = false;
        }
    }

    // The first record type the current context offers (the chosen pathway on the queue, the thread's
    // bucket on the Tagged tab) — what the link picker resets to, so a type from another pathway can
    // never survive a pathway or selection change.
    private RecordType DefaultLinkRecordType => view == QueueView.Tagged
        ? TaggedLinkTypeOptions[0]
        : (QueueLinkTypeOptions.Count > 0 ? QueueLinkTypeOptions[0] : RecordType.Request);

    // Clear the link picker back to the current context's defaults after a selection or pathway
    // changes, or a link action completes.
    private void ResetLinkState()
    {
        linkRecordType = DefaultLinkRecordType;
        linkProjectId = "";
        linkRecordId = "";
        linkRecordIds.Clear();
        linkRecords = Array.Empty<LinkableRecord>();
    }

    private async Task OnCreateProjectChanged(ChangeEventArgs e)
    {
        createProjectId = e.Value?.ToString() ?? "";
        await LoadCreateTodoLinkRequestsAsync();
    }

    private void OnCreateTodoLinkRequestChanged(ChangeEventArgs e) => createTodoLinkRequestId = e.Value?.ToString() ?? "";

    // Load the chosen project's open requests for the To-do form's optional request link. A failed
    // load leaves the picker empty rather than blocking triage — the to-dos can still be created,
    // the email just isn't linked to a request. Any change of project or record type clears the
    // current pick: a request selected against one project must never survive into another.
    private async Task LoadCreateTodoLinkRequestsAsync()
    {
        createTodoLinkRequestId = "";
        // Never offered on the Subcontractor pathway: a request is a client record, so tagging one
        // would file a subcontract thread under Client — the wall crossing the whole design forbids.
        // To-dos raised from subcontract mail stay pathway-neutral (see TodoRequestLinkOffered).
        if (mode != TriageMode.GeneralTodo || !TodoRequestLinkOffered || string.IsNullOrWhiteSpace(createProjectId))
        {
            createTodoLinkRequests = Array.Empty<LinkableRecord>();
            return;
        }
        try
        {
            createTodoLinkRequestsLoading = true;
            StateHasChanged(); // show the loading state while the fetch is in flight
            createTodoLinkRequests = await Intake.ListLinkableRecordsAsync(createProjectId, RecordType.Request);
        }
        catch
        {
            createTodoLinkRequests = Array.Empty<LinkableRecord>();
        }
        finally
        {
            createTodoLinkRequestsLoading = false;
        }
    }

    private void OnCreateDescriptionInput(ChangeEventArgs e) => createDescription = e.Value?.ToString() ?? "";

    // Toggle a record in the queue panel's multi-pick — clicking a picked record unpicks it.
    private void ToggleLinkRecord(string recordId)
    {
        if (!linkRecordIds.Add(recordId)) linkRecordIds.Remove(recordId);
    }

    // Link the email to EVERY picked record — one LinkMessageToRecord per pick, applied sequentially
    // (each tags the whole conversation, verified server-side; the mailbox message never moves, so
    // the same message id keeps working for the second and later tags). Not routed through RunAction
    // because partial failure needs its own handling: once the first tag sticks the email has left
    // the queue, so the queue must refresh regardless, and any picks that didn't take are reported
    // via linkNote with a pointer to the Tagged view, where "add another tag" finishes the job.
    private async Task DoLink() => await DoLinkCore(allowCrossPathway: false);

    // "File under both anyway": retry just the picks the server asked to confirm, consenting to the
    // Subcontractor↔Internal dual filing (the lane, never the wall — see crossFileMessage).
    private async Task DoLinkConfirmCross() => await DoLinkCore(allowCrossPathway: true);

    private async Task DoLinkCore(bool allowCrossPathway)
    {
        if (selected is null || busy) return;
        var picks = allowCrossPathway
            ? crossFilePicks.ToList()
            : linkRecords.Where(r => linkRecordIds.Contains(r.RecordId)).ToList();
        if (picks.Count == 0) return;

        actionError = null;
        linkNote = null;
        crossFileMessage = null;
        busyLabel = "Linking";
        busy = true;
        var succeeded = new List<LinkableRecord>();
        var failed = new List<LinkableRecord>();
        var needsConfirm = new List<LinkableRecord>();
        string? confirmMessage = null;
        string? firstFailure = null;
        try
        {
            // Ride-along to-dos first (same order as every pane): their command verifies its tags
            // before saving, so a failure here stops the whole action with the email still queued.
            try
            {
                await CreateRideAlongTodosAsync(linkProjectId);
            }
            catch (CommandFailedException ex)
            {
                actionError = ex.Message;
                return;
            }

            foreach (var record in picks)
            {
                try
                {
                    // The type to link as is the picked RECORD's own type, not the dropdown's: the
                    // Scheduling picker lists the bucket alongside the programme's claims documents
                    // (NOD/EOT requests, LADs claims), and each of those must link through its owning
                    // provider so the tag stem resolves correctly. Cost-centre links carry the
                    // triager's pathway choice — the record type alone can't say which side of the
                    // wall a cost centre's mail belongs to.
                    await Intake.LinkMessageToRecordAsync(
                        selected.Id, selected.InternetMessageId, record.Type, record.RecordId,
                        pathway: CostCentrePathwayFor(record),
                        allowCrossPathway: allowCrossPathway);
                    succeeded.Add(record);
                }
                catch (CommandFailedException ex) when (!allowCrossPathway && IsCrossFilePrompt(ex.Message))
                {
                    // The lane, not the wall: the server wants explicit consent to file the thread
                    // under both non-client pathways. Held back for the inline confirm button.
                    needsConfirm.Add(record);
                    confirmMessage ??= ex.Message;
                }
                catch (CommandFailedException ex)
                {
                    failed.Add(record);
                    firstFailure ??= ex.Message;
                }
                catch
                {
                    failed.Add(record);
                    firstFailure ??= "That action didn't complete. Please try again.";
                }
            }

            if (succeeded.Count == 0)
            {
                // Nothing stuck — the email is still in the queue, so keep the selection and the
                // picks. Confirmable rejections surface as the inline confirm; anything else shows
                // the first error in place, exactly like a single-link failure.
                if (needsConfirm.Count > 0)
                {
                    crossFilePicks.Clear();
                    crossFilePicks.AddRange(needsConfirm);
                    crossFileMessage = confirmMessage;
                }
                actionError = firstFailure;
                return;
            }

            var unfinished = failed.Concat(needsConfirm).ToList();
            if (unfinished.Count > 0)
            {
                linkNote = $"The email was linked to {References(succeeded)}, but couldn't be linked to {References(unfinished)}. "
                    + "It has left the queue — open it on the Tagged tab and use “add another tag” to finish.";
            }

            // At least one tag stuck, so the email (thread) has left the Inbox queue: refresh and
            // clear the selection, mirroring RunAction's success path.
            ResetQueuePaging();
            // The queue and the recently-triaged panel move together: the action that consumed
            // this email is the newest row of the panel.
            await Task.WhenAll(LoadAsync(), LoadRecentTriageAsync());
            selected = null;
            detail = null;
            detailLoading = false;
            mode = TriageMode.None;
        }
        finally { busy = false; }
    }

    private static string References(IReadOnlyList<LinkableRecord> records) =>
        string.Join(", ", records.Select(r => r.Reference));

    // The pathway label sent with a link command. Only pathway-neutral COST-CENTRE links carry one —
    // the record type implies the pathway everywhere else, and a Todo link must stay neutral (sending
    // a pathway with it would file the thread, which a to-do never does). On the queue it is the
    // triager's selection; on the Tagged tab it is the thread's own side. Internal never applies —
    // cost-centre mail is valuation-side (Client) or subcontract-side (Subcontractor) only.
    private string? CostCentrePathwayFor(LinkableRecord record)
    {
        if (record.Type != RecordType.CostCentre) return null;
        var side = view == QueueView.Tagged ? FixedPathway : pathway;
        return side is TriagePathway.Client or TriagePathway.Subcontractor ? PathwayLabel(side.Value) : null;
    }

