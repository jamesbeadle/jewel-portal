                                        <span> <span class="font-mono text-xs text-content-muted">@raised.Reference</span> was raised from the email.</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(outcome.FailureNote))
                                {
                                    <p class="text-sm text-amber-600">@outcome.FailureNote</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(outcome.WebLink))
                                {
                                    <a class="text-accent underline text-sm" href="@outcome.WebLink" target="_blank" rel="noopener">Open in Outlook</a>
                                }
                            </div>
                        }
                        @if (linkNote is not null)
                        {
                            <div class="panel p-5 mb-4 border-amber-500/40 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider text-amber-600 font-semibold">Partially linked</p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => linkNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@linkNote</p>
