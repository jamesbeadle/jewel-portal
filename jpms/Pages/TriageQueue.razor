@page "/control-centre"
@page "/requests/triage"
@* The second route is the legacy alias: the page lived at /requests/triage before the section
   became the Control Centre (2026-08-07); old bookmarks and links still land here. *@
@using Jewel.JPMS.Contracts.Audit
@using Jewel.JPMS.Contracts.DocumentControl
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Features.Procurement
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Contracts.Requests
@using Jewel.JPMS.Contracts.Todos
@using Jewel.JPMS.Features.Todos
@using Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage.Workspace
@using Jewel.JPMS.Contracts.Ai
@inject AuthService Auth
@inject SessionService Session
@inject NavigationManager Nav
@inject IIntakeQueue Intake
@inject ProjectStageFilter StageFilter
@inject TriageSortStorage SortStorage
@inject ITodoStore Todos
@inject IRequestRegister RequestRegister
@inject ICommandSender Commands
@inject IWorkOrderAttachmentStore WorkOrderAttachments
@inject IQueryClient Queries
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel Projects
@inject Jewel.JPMS.Features.Subcontractors.SubcontractorsReadModel Subcontractors
@inject AiTaskState AiTasks
@inject ChatPanelState Chat
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Control Centre · JPMS</PageTitle>

@*
    Live-read triage. The mailbox is the single source of truth and nothing ever moves — triage just
    adds/removes category tags on the email. The Queue is Inbox messages with no JPMS tag (read live);
    the Discarded tab is messages tagged "JPMS/Discarded". Discard/restore/assign add or remove tags,
    each verified by reading the categories back. Nothing about un-triaged mail is stored in the database.
*@

@*
    Shared message body + attachments, used by both the Queue and Discarded detail panes. Declared
    before first use; reads the live `detail` / `selected` fields each time it is rendered.
*@
@{
    // Small paperclip glyph flagging an email as carrying attachments — shown on list rows
    // (queue / discarded / tagged) and thread panel rows. Inherits the row's text colour.
    RenderFragment PaperclipIcon =
        @<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="w-3 h-3 shrink-0" aria-hidden="true">
            <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
        </svg>;

    RenderFragment MessageHeader =@<div>
        <h2 class="text-lg font-semibold text-content">@Dash(selected!.Subject)</h2>
        <div class="flex items-start gap-3 mt-3">
            <div class="h-9 w-9 shrink-0 rounded-full bg-accent/15 text-accent flex items-center justify-center text-sm font-semibold select-none"
                 aria-hidden="true">@SenderInitials(selected)</div>
            <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm text-content truncate">
                        <span class="font-semibold">@DisplayFrom(selected)</span>
                        @if (!string.IsNullOrWhiteSpace(selected.FromName) && !string.IsNullOrWhiteSpace(selected.FromEmail))
                        {
                            <span class="text-content-subtle"> &lt;@selected.FromEmail&gt;</span>
                        }
                    </p>
                    <span class="text-xs text-content-subtle shrink-0">@Date(selected.ReceivedAt)</span>
                </div>
                @if (detail?.To is { Count: > 0 } headerTo)
                {
                    <p class="text-xs text-content-subtle truncate mt-0.5">To: @string.Join("; ", headerTo)</p>
                }
                @if (detail?.Cc is { Count: > 0 } headerCc)
                {
                    <p class="text-xs text-content-subtle truncate mt-0.5">Cc: @string.Join("; ", headerCc)</p>
                }
            </div>
        </div>
    </div>;

    @*
        Attachments: names, preview, download and the "Send to document triage" tick for the
        open email. Rendered at the TOP of the email pane — above the body — so the attachments
        are dealt with first and can never scroll out of sight (decision 2026-08-12; the routing
        itself — drawings, payment certificates, subcontractor documents — lives in Document
        Control, where each file is triaged on its own).
    *@
    RenderFragment MessageAttachments =@<text>
        @if (detail is not null && detail.Attachments.Count > 0)
        {
            <div class="rounded-lg bg-surface-raised border border-line p-3">
                <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                    @detail.Attachments.Count attachment@(detail.Attachments.Count == 1 ? "" : "s")
                </p>
                <ul class="space-y-1">
                    @foreach (var att in detail.Attachments)
                    {
                        <li class="flex items-center justify-between gap-3 text-sm text-content">
                            <span class="truncate">@att.Name</span>
                            <span class="flex items-center gap-3 whitespace-nowrap">
                                @if (att.Size > 0)
                                {
                                    <span class="text-xs text-content-subtle">@FormatSize(att.Size)</span>
                                }
                                @if (!string.IsNullOrEmpty(att.Id))
                                {
                                    @if (IsPreviewable(att))
                                    {
                                        <button type="button" class="text-xs text-accent hover:underline"
                                                @onclick="() => OpenEmailAttachmentPreview(att)">
                                            Preview
                                        </button>
                                    }
                                    <a href="@AttachmentUrl(att, inline: false)" target="_blank" rel="noopener"
                                       class="text-xs text-accent hover:underline">Download</a>
                                    @if (view == QueueView.Active)
                                    {
                                        <label class="flex items-center gap-1.5 text-xs text-content-muted hover:text-content cursor-pointer select-none"
                                               title="Copy this file into the Document Triage queue when Apply runs — the email itself stays here">
                                            <input type="checkbox" checked="@stagedDocControlIds.Contains(att.Id)"
                                                   disabled="@busy"
                                                   @onchange="e => ToggleDocControl(att.Id, e.Value is true)" />
                                            <span>Send to document triage</span>
                                        </label>
                                    }
                                }
                            </span>
                        </li>
                    }
                </ul>
            </div>
        }
        else if (selected is not null && selected.HasAttachments && detail is not null)
        {
            <p class="text-xs text-content-subtle italic">This email has attachments, but their names couldn't be retrieved.</p>
        }
    </text>;

    RenderFragment MessageBody =@<text>
        <div class="rounded-lg bg-surface-raised border border-line p-3 max-h-[28rem] overflow-y-auto">
            @if (detailLoading)
            {
                <p class="text-sm text-content-subtle italic">Loading message…</p>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml) && detail.BodyIsHtml)
            {
                <div class="rounded bg-white text-gray-900 p-3 text-sm overflow-x-auto">@((MarkupString)detail.BodyHtml)</div>
            }
            else if (detail is not null && !string.IsNullOrWhiteSpace(detail.BodyHtml))
            {
                <p class="text-sm text-content whitespace-pre-wrap">@detail.BodyHtml</p>
            }
            else
            {
                <p class="text-sm text-content-subtle italic">@(selected is null ? "" : Dash(selected.BodyPreview))</p>
            }
        </div>

        @* Replies already sent from the projects mailbox on this thread — shown right under the
           email so "did we answer this?" never needs Outlook, and another reply can follow. *@
        @if (SentReplies.Count > 0)
        {
            <div class="rounded-lg border border-positive/30 bg-positive/5 p-3 space-y-1.5">
                <p class="text-[11px] uppercase tracking-wider text-positive font-semibold">Replies sent · @SentReplies.Count</p>
                @foreach (var sent in SentReplies)
                {
                    <button type="button" @key="sent.Id" class="w-full text-left text-xs hover:bg-surface-raised rounded px-1.5 py-1"
                            title="Open this reply" @onclick="() => Select(sent)">
                        <span class="text-content-subtle">@ListDate(sent.ReceivedAt)</span>
                        <span class="text-content ml-2">@FirstLineOf(sent.BodyPreview)</span>
                    </button>
                }
            </div>
        }

        @*
            Thread panel: the rest of this email's conversation, read live and regardless of tags.
            Later replies often say how the older messages should be triaged (e.g. "ignore my last —
            resolved on site"), so triaging oldest-first still shows the newest context. Click a
            member to open it. Linking or discarding already applies to the whole thread server-side.
        *@
        @if (selected is not null && !string.IsNullOrEmpty(selected.ConversationId))
        {
            @if (threadLoading)
            {
                <p class="text-xs text-content-subtle italic">Checking the thread for replies…</p>
            }
            else if (thread.Count > 1)
            {
                @* The thread as TABS, not a stacked list: one numbered chip per email (oldest →
                   newest), the open one highlighted — click a tab and the content above switches
                   to that email. A row of chips carries an 11-email thread in one line. *@
                <div class="rounded-lg bg-surface-raised border border-line px-3 py-2">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mr-1">
                            Thread · email @(ThreadPositionOfSelected) of @thread.Count
                        </span>
                        @for (var i = 0; i < thread.Count; i++)
                        {
                            var member = thread[i];
                            var isCurrent = member.Id == selected.Id;
                            var isLatest = i == thread.Count - 1;
                            <button type="button" @key="member.Id" disabled="@isCurrent"
                                    title="@($"{DisplayFrom(member)} — {Date(member.ReceivedAt)}{(member.HasAttachments ? " · has attachments" : "")}")"
                                    @onclick="() => Select(member)"
                                    class="@ThreadTabClass(isCurrent, isLatest)">
                                @(i + 1)@(isLatest ? " ·" : "")
                            </button>
                        }
                        @if (thread[^1].Id != selected.Id)
                        {
                            <span class="text-[11px] text-content-subtle">· read the latest (@thread.Count) before triaging — actions apply to the whole thread</span>
                        }
                    </div>
                </div>
            }
        }

    </text>;

    @*
        The four page-owned pane contents for the workspace (the other four panes own their own
        data). Declared here as fragments — like MessageHeader/MessageBody above — so every one
        reads the page's live fields and the page stays the single orchestrator it always was.
    *@

    RenderFragment InboxPaneContent =@<div class="space-y-4 lg:pr-1">
        <header>
            <p class="text-xs uppercase tracking-wider text-content-subtle font-medium">JPMS · projects@@jewelbb.co.uk</p>
            @* Each strapline is a count, not a description, so it waits for its own list — it
               simply does not render until the count is known (see the loading-states notes). *@
            @if (view == QueueView.Active && queueArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @total email@(total == 1 ? "" : "s") in the inbox waiting to be assigned to a request.
                </p>
            }
            else if (view == QueueView.Discarded && discardedArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @discardedTotal discarded email@(discardedTotal == 1 ? "" : "s") — restore one to put it back in the queue.
                </p>
            }
            else if (view == QueueView.Tagged && taggedArrived)
            {
                <p class="text-sm text-content-muted mt-1">
                    @taggedTotal tagged email@(taggedTotal == 1 ? "" : "s") — add or remove tags to manage which processes use them.
                </p>
            }
        </header>

        @* Sticky, so the pane's navigation stays in reach however far the list is scrolled
           (bg-canvas so rows vanish behind it). *@
        <div class="sticky top-0 z-10 bg-canvas flex items-center gap-2 border-b border-line">
            <button type="button" class="@ViewTabClass(QueueView.Active)" @onclick="() => SwitchView(QueueView.Active)">Queue</button>
            <button type="button" class="@ViewTabClass(QueueView.Tagged)" @onclick="() => SwitchView(QueueView.Tagged)">Tagged</button>
        </div>

        @if (loadError is not null)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@loadError</p>
        }

        @if (view == QueueView.Active)
        {
        @* No gate: this panel only exists when there ARE unassigned requests, so on most loads it
           is absent before the register answers and absent after it — announcing that wait would
           promise something that never arrives. It appears if and when there is something to say. *@
        @if (unassignedArrived && unassigned.Count > 0)
        {
            <div class="panel p-5 mb-6 border-amber-500/40">
                <div class="flex items-start gap-2 mb-1">
                    <h2 class="text-sm font-semibold text-amber-700">Unassigned requests</h2>
                    <span class="inline-flex items-center rounded-full bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-600">@unassigned.Count</span>
                </div>
                <p class="text-xs text-content-subtle mb-3">
                    These requests aren't tied to a live project, so they don't appear in any register. Return one to the Control Centre to process its emails again and pick the right project.
                </p>
                @if (unassignedError is not null)
                {
                    <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@unassignedError</p>
                }
                <div class="space-y-2">
                    @foreach (var request in unassigned)
                    {
                        <div @key="request.RequestId" class="flex items-center justify-between gap-3 rounded-lg border border-line px-3 py-2">
                            <div class="min-w-0">
                                <p class="text-sm text-content truncate">
                                    <span class="font-mono text-xs text-content-muted mr-2">@Dash(request.Reference)</span>@Dash(request.Title)
                                </p>
                                <p class="text-[11px] text-content-subtle mt-0.5">Issued @Date(request.IssuedAt ?? request.RaisedAt) · @Dash(request.RaisedByEmail)</p>
                            </div>
                            <button type="button" class="btn-secondary text-xs whitespace-nowrap"
                                    disabled="@busy" @onclick="() => ReturnUnassigned(request)">
                                Return to Control Centre
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        <LoadGate IsLoading="@(!queueArrived)" Prominent="true" Label="Loading the inbox">
        @if (loadError is not null && items.Count == 0)
        {
            @* A failed page has no queue to report; "nothing in the queue" would read as one. *@
            <p class="text-sm text-negative">Couldn't load the inbox. The reason is in the red bar above — reload to try again.</p>
        }
        else if (total == 0)
        {
            <div class="panel p-8 text-center">
                <p class="text-sm text-content">Nothing in the queue.</p>
                <p class="text-xs text-content-subtle mt-1">Every email in the requests mailbox has been dealt with.</p>
            </div>
        }
        else
        {
            <div class="relative space-y-2">
                    @* Sort is a light, rarely-used view preference — small muted text under the
                       header, not an action button. The choice is remembered per user. *@
                    <div class="flex items-center gap-3 text-xs px-1">
                        <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: false)" class="@SortLinkClass(false)">Oldest first</button>
                        <button type="button" disabled="@listLoading" @onclick="() => SetSortAsync(newest: true)" class="@SortLinkClass(true)">Newest first</button>
                    </div>
                    @if (listLoading)
                    {
                        <JewelSpinner Overlay="true" Label="Loading" />
                    }
                    @{ string? lastQueueGroup = null; }
                    @foreach (var item in items)
                    {
                        @* Outlook-style date group headers — Today / Yesterday / day names / dates. *@
                        var queueGroup = DateGroupLabel(item.ReceivedAt);
                        @if (queueGroup != lastQueueGroup)
                        {
                            lastQueueGroup = queueGroup;
                            <p class="text-xs font-semibold text-content-muted uppercase tracking-wider pt-2 pb-0.5 px-1">@queueGroup</p>
                        }
                        <button type="button" @key="item.Id" @onclick="() => Select(item)"
                                class="@RowClass(item)">
                            <div class="flex items-baseline justify-between gap-2">
                                <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                            </div>
                            <div class="flex items-center gap-1.5 mt-0.5">
                                <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                @* Parked work waits on this email — the marker says "open me to carry on". *@
                                @if (parkedTriageByEmailId.ContainsKey(item.Id))
                                {
                                    <span title="Unfinished triage — open the email to carry on where you left off" class="text-[10px] font-semibold text-accent shrink-0">✎ draft</span>
                                }
                                @if (item.HasAttachments)
                                {
                                    <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                }
                            </div>
                            @* The opening line of the email — the Outlook-style preview that lets the
                               list be scanned without opening anything. *@
                            @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                            {
                                <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                            }
                            @* Thread hint: this email is untriaged, but other messages in its
                               conversation already carry record tags. Surfacing them here tells the
                               triager it's a reply to an already-linked thread, so re-linking is one
                               step — outline chips, so they don't read as this email's own tags. *@
                            @if (item.ThreadTags is { Count: > 0 } threadTags)
                            {
                                <div class="flex flex-wrap items-center gap-1 mt-1">
                                    <span class="text-[10px] text-content-subtle">Thread:</span>
                                    @foreach (var tag in threadTags)
                                    {
                                        <span class="inline-flex items-center rounded-full border border-accent/40 text-accent/90 text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                    }
                                </div>
                            }
                        </button>
                    }

                    @if (QueuePageCount > 1)
                    {
                        <div class="flex items-center justify-between gap-2 pt-2">
                            @if (queueIndex > 0)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousPage">Previous</button>
                            }
                            else
                            {
                                <span></span>
                            }
                            <span class="text-[11px] text-content-subtle">Page @(queueIndex + 1) / @QueuePageCount · @total email@(total == 1 ? "" : "s")</span>
                            @if (queueNext is not null)
                            {
                                <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextPage">Next</button>
                            }
                            else
                            {
                                <span></span>
                            }
                        </div>
                    }
                </div>
        }
        </LoadGate>
        }
        else if (view == QueueView.Discarded)
        {
            <LoadGate IsLoading="@(!discardedArrived)" Prominent="true" Label="Loading discarded emails">
            @if (loadError is not null && discardedItems.Count == 0)
            {
                @* A failed page has nothing to report; "no discarded emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the discarded emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (discardedTotal == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">No discarded emails.</p>
                    <p class="text-xs text-content-subtle mt-1">Emails you discard from the queue show up here, and can be restored.</p>
                </div>
            }
            else
            {
                <div class="relative space-y-2">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in discardedItems)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                    <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                                {
                                    <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                                }
                            </button>
                        }

                        @if (DiscardedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (discardedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousDiscarded">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(discardedIndex + 1) / @DiscardedPageCount · @discardedTotal email@(discardedTotal == 1 ? "" : "s")</span>
                                @if (discardedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextDiscarded">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>
            }
            </LoadGate>
        }
        else
        {
            @* Pathway filter: one chip per pathway, read server-side as an exact bucket-category
               filter. Kept separate from (and mutually exclusive with) the tag filter below — Graph
               composes category filters with OR only, so combining them would show a union, not the
               intersection the combination looks like. *@
            <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Pathway</span>
                <button type="button" class="@PathwayFilterChipClass(null)" @onclick="() => SetPathwayFilter(null)">All</button>
                <button type="button" class="@PathwayFilterChipClass(ClientBucket)" @onclick="() => SetPathwayFilter(ClientBucket)">Client</button>
                <button type="button" class="@PathwayFilterChipClass(SubcontractorBucket)" @onclick="() => SetPathwayFilter(SubcontractorBucket)">Subcontractor</button>
                <button type="button" class="@PathwayFilterChipClass(InternalBucket)" @onclick="() => SetPathwayFilter(InternalBucket)">Internal</button>
            </div>

            @* The tag list accrues from the emails that have loaded, so before the first page lands
               the dropdown offers only "Discarded" — a short list that looks like the whole list. *@
            @if (taggedArrived)
            {
            <div class="flex flex-wrap items-center gap-2 mb-5">
                <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold mr-1">Filter</span>
                <div class="relative">
                    <button type="button"
                            class="rounded-full border border-line px-3 py-1 text-xs font-medium text-content-muted hover:text-content hover:border-line-strong transition inline-flex items-center gap-1.5"
                            @onclick="ToggleFilterMenu">
                        @FilterButtonLabel
                        <span class="text-[9px] leading-none">▾</span>
                    </button>
                    @if (filterOpen)
                    {
                        <div class="absolute z-20 mt-1 w-60 max-h-72 overflow-y-auto rounded-lg border border-line bg-surface-raised shadow-lg p-1">
                            <button type="button"
                                    class="w-full text-left rounded px-3 py-1.5 text-sm text-content-muted hover:bg-surface hover:text-content"
                                    @onclick="ClearTagFilters">
                                All tags
                            </button>
                            <div class="my-1 border-t border-line"></div>
                            @foreach (var tag in knownTags)
                            {
                                <label class="flex items-center gap-2 rounded px-3 py-1.5 text-sm text-content hover:bg-surface cursor-pointer">
                                    <input type="checkbox" checked="@selectedTags.Contains(tag)" @onchange="() => ToggleTag(tag)" />
                                    <span>@TagLabel(tag)</span>
                                </label>
                            }
                        </div>
                    }
                </div>
                @foreach (var tag in selectedTags)
                {
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-accent bg-surface-raised px-2.5 py-1 text-xs text-content">
                        @TagLabel(tag)
                        <button type="button" class="text-content-subtle hover:text-negative" @onclick="() => ToggleTag(tag)" title="Remove filter">✕</button>
                    </span>
                }
            </div>
            }
            <LoadGate IsLoading="@(!taggedArrived)" Prominent="true" Label="Loading tagged emails">
            @if (loadError is not null && taggedItems.Count == 0)
            {
                @* A failed page has nothing to report; "no tagged emails" would read as an answer. *@
                <p class="text-sm text-negative">Couldn't load the tagged emails. The reason is in the red bar above — reload to try again.</p>
            }
            else if (taggedTotal == 0)
            {
                <div class="panel p-8 text-center">
                    <p class="text-sm text-content">@(selectedTags.Count == 0 ? "No tagged emails." : "No emails with the selected tags.")</p>
                    <p class="text-xs text-content-subtle mt-1">Emails linked to a request (or discarded) appear here. Open one to add it to another request or remove a tag.</p>
                </div>
            }
            else
            {
                <div class="relative space-y-2">
                        @if (listLoading)
                        {
                            <JewelSpinner Overlay="true" Label="Loading" />
                        }
                        @foreach (var item in taggedItems)
                        {
                            <button type="button" @key="item.Id" @onclick="() => Select(item)" class="@RowClass(item)">
                                <div class="flex items-baseline justify-between gap-2">
                                    <span class="text-sm font-semibold text-content truncate">@DisplayFrom(item)</span>
                                    <span class="text-[11px] text-content-subtle shrink-0">@ListDate(item.ReceivedAt)</span>
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <p class="text-sm text-content-muted truncate flex-1">@Dash(item.Subject)</p>
                                    @if (item.HasAttachments)
                                    {
                                        <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">@PaperclipIcon</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.BodyPreview))
                                {
                                    <p class="text-xs text-content-subtle truncate mt-0.5">@FirstLineOf(item.BodyPreview)</p>
                                }
                                @* Parked work waits on this email — the marker says "open me to carry on". *@
                                @if (parkedTriageByEmailId.ContainsKey(item.Id))
                                {
                                    <p class="text-[10px] font-semibold text-accent mt-0.5">✎ draft in progress</p>
                                }
                                @if (item.Bucket is not null || item.Categories.Count > 0)
                                {
                                    <div class="flex flex-wrap items-center gap-1 mt-1">
                                        @* The pathway badge leads the chip row: the thread's filing is the first thing
                                           to know about a tagged email, before which records it feeds. *@
                                        @if (PathwayFromBucket(item.Bucket) is { } rowPathway)
                                        {
                                            <span class="inline-flex items-center rounded-full @PathwayChipColour(rowPathway) text-[10px] font-medium px-2 py-0.5">@PathwayLabel(rowPathway)</span>
                                        }
                                        @foreach (var tag in item.Categories)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-accent/10 text-accent text-[10px] font-medium px-2 py-0.5">@TagLabel(tag)</span>
                                        }
                                    </div>
                                }
                            </button>
                        }

                        @if (TaggedPageCount > 1)
                        {
                            <div class="flex items-center justify-between gap-2 pt-2">
                                @if (taggedIndex > 0)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="PreviousTagged">Previous</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                                <span class="text-[11px] text-content-subtle">Page @(taggedIndex + 1) / @TaggedPageCount · @taggedTotal email@(taggedTotal == 1 ? "" : "s")</span>
                                @if (taggedNext is not null)
                                {
                                    <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="NextTagged">Next</button>
                                }
                                else
                                {
                                    <span></span>
                                }
                            </div>
                        }
                    </div>
            }
            </LoadGate>
        }
    </div>;

    RenderFragment EmailPaneContent =@<div>
        @if (view == QueueView.Active)
        {
            @if (selected is null)
            {
                        @if (composeOutcome is { } outcome)
                        {
                            <div class="panel p-5 mb-4 @(outcome.Sent ? "border-positive/40" : "border-amber-500/40") space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider font-semibold @(outcome.Sent ? "text-positive" : "text-amber-600")">
                                        @(outcome.Sent ? "Email sent" : "Saved as draft")
                                    </p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => composeOutcome = null">✕</button>
                                </div>
                                <p class="text-sm text-content">
                                    <span class="font-medium">@outcome.Subject</span>
