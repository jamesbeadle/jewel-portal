    // Internal → "To-dos": create every row with a title in one command. With a project chosen the
    // items land on that project's To-do tab — and an open request on it can optionally be tagged too
    // (server-verified before anything is created), so one action feeds the request's conversation
    // AND captures its follow-up to-dos. With no project the items are GENERAL (company-wide)
    // entries for mail that belongs to no project, surfacing on the /todos browser and the assigned
    // roles' dashboards. Either way the email is tagged "JPMS/TODO-####" once per created item, so
    // each item reads this email back live by its own tag — one email can feed several to-dos.
    //
    // Pathway: the pathway the triager actually chose rides along, so a not-yet-filed thread is filed
    // where they said — Internal for company admin, Subcontractor for a supplier chase. EXCEPT when a
    // request link is picked: the request tag makes the thread feed a client-side record, so the
    // pathway is withheld and the thread's filing follows the request instead. (The request picker is
    // hidden on Subcontractor, so that exception only ever applies to an Internal batch.)
    // Creates the ride-along to-dos (if the section is open and any row has a title) BEFORE the
    // pane's primary action. Their command verifies every tag before saving, so a failure here
    // stops the whole action with nothing half-done; if the primary action fails afterwards, the
    // items exist and the email is findable in the Tagged view under its TODO chips — per-step
    // honesty over a pretend transaction. Returns how many items were raised.
    private async Task<int> CreateRideAlongTodosAsync(string? projectId)
    {
        if (!alsoTodos || selected is null) return 0;
        var drafts = CurrentTodoDrafts();
        if (drafts.Count == 0) return 0;

        var created = await Intake.CreateTodoItemsFromMessageAsync(new CreateTodoItemsFromMessage(
            selected.Id,
            NullIfBlank(projectId ?? ""),
            drafts,
            LinkRequestId: null,
            InternetMessageId: selected.InternetMessageId,
            Pathway: pathway is { } chosen ? PathwayLabel(chosen) : null));
        // One batch per action: clear the rows so a retry of the primary action can't double-raise.
        createTodoRows = new List<TodoDraftRow> { new() };
        alsoTodos = false;
        return created.Count;
    }

    private async Task DoCreateTodos()
    {
        if (selected is null || busy) return;

        var drafts = CurrentTodoDrafts();
        if (drafts.Count == 0) { actionError = "At least one to-do item needs a title."; return; }

        var linkRequestId = string.IsNullOrWhiteSpace(createProjectId) ? null : NullIfBlank(createTodoLinkRequestId);
        var command = new CreateTodoItemsFromMessage(
            selected.Id,
            NullIfBlank(createProjectId),
            drafts,
            LinkRequestId: linkRequestId,
            InternetMessageId: selected.InternetMessageId,
            Pathway: linkRequestId is null && pathway is { } chosen ? PathwayLabel(chosen) : null);

        await RunAction("Creating to-dos", async () => await Intake.CreateTodoItemsFromMessageAsync(command));
    }

    // "Reply in thread": the reply written here is staged as an Outlook draft on the email
    // (projects mailbox, thread quoted behind it) AND becomes the description of a General request
    // created from it in the background — one write-up answers the email and papers the request, so
    // the email is triaged by the act of replying. The outcome (request + draft weblink) is kept
    // for the success banner; the pre-filled draft is reviewed and sent from Outlook itself.
    // ---- Reply compose (send for real — decision 2026-08-04) ----

    // Reply-all prefill, computed once per selection from the opened email's envelope: the sender
    // (or their Reply-To) goes in To; the original To + Cc — minus whoever is now in To — go in Cc.
    // The projects mailbox is auto-copied server-side, so it's filtered out of the visible Cc here.
    private void PrefillReplyEnvelope(MailboxMessage item, MailboxMessageDetail loaded)
    {
        if (replyEnvelopePrefilled) return;

        var toAddress = loaded.ReplyTo ?? loaded.FromEmail ?? item.FromEmail;
        replyToField = toAddress ?? "";

        var ccAddresses = (loaded.To ?? Array.Empty<string>())
            .Concat(loaded.Cc ?? Array.Empty<string>())
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Where(a => !a.Equals(toAddress, StringComparison.OrdinalIgnoreCase))
            // The projects mailbox is auto-copied on every send server-side — showing it here
            // would only invite someone to delete it or double it.
            .Where(a => loaded.MailboxAddress is null || !a.Equals(loaded.MailboxAddress, StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        replyCcField = string.Join("; ", ccAddresses);

        var subject = loaded.Subject ?? item.Subject;
        replySubject = string.IsNullOrWhiteSpace(subject) ? "RE: (no subject)"
            : subject.TrimStart().StartsWith("RE:", StringComparison.OrdinalIgnoreCase) ? subject.Trim()
            : $"RE: {subject.Trim()}";

        replyEnvelopePrefilled = true;
    }

    private bool ReplyIsSendable =>
        ParseRecipients(replyToField).Count > 0
        && !string.IsNullOrWhiteSpace(replySubject)
        && HtmlHasContent(replyBody);

    // True while a reply is drafted but unsent — the filing panes' own buttons stand down so a
    // written reply can't be silently left behind by a tag-only action; Send applies both.
    private bool ReplyDraftPending => replyOpen && HtmlHasContent(replyBody);

    // The project the open filing pane is working on, giving the attachment picker its context.
    private string ComposeContextProjectId => mode switch
    {
        TriageMode.Link => linkProjectId,
        TriageMode.Create or TriageMode.GeneralTodo => createProjectId,
        _ => ""
    };

    // What Send will do besides sending, phrased for the note above the button. Null = nothing.
    private string? PendingFilingSummary
    {
        get
        {
            var parts = new List<string>();
            if (mode == TriageMode.Link && linkRecordIds.Count > 0)
                parts.Add(linkRecordIds.Count == 1 ? "link this email to the selected record" : $"link this email to {linkRecordIds.Count} records");
            if (mode == TriageMode.Create && !string.IsNullOrWhiteSpace(createProjectId) && !string.IsNullOrWhiteSpace(createTitle))
                parts.Add(pathway == TriagePathway.Subcontractor ? "create the bid package" : "create the request");
            var todoCount = CurrentTodoDrafts().Count;
            if (todoCount > 0 && (mode == TriageMode.GeneralTodo || alsoTodos))
                parts.Add(todoCount == 1 ? "raise the to-do" : $"raise {todoCount} to-dos");
            return parts.Count == 0 ? null : string.Join(" and ", parts);
        }
    }

