    private sealed class TodoDraftRow
    {
        public string Title { get; set; } = "";
        public string Notes { get; set; } = "";
        // The ASSIGNEES, each held as the SearchSelect's TodoAssigneePicker value — a role,
        // optionally pinned to a named holder. Empty = unassigned. A row with several assignees is
        // raised as one to-do PER ASSIGNEE — same title, detail and due date, separate TODO-####
        // references and separate tick-boxes — so an email that needs two people to act becomes
        // two items in one triage action.
        public List<string> Assignees { get; } = new();
        public string Due { get; set; } = "";
    }
