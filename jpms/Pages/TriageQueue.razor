                        @if (poEmailNote is not null)
                        {
                            <div class="panel p-5 mb-4 @(poEmailNoteIsSuccess ? "border-positive/40" : "border-amber-500/40") space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider font-semibold @(poEmailNoteIsSuccess ? "text-positive" : "text-amber-600")">
                                        Purchase-order email
                                    </p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => poEmailNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@poEmailNote</p>
                            </div>
                        }
                        @if (outboxNote is not null)
                        {
                            <div class="panel p-5 mb-4 border-positive/40 space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <p class="text-xs uppercase tracking-wider text-positive font-semibold">Outbox</p>
                                    <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss"
                                            @onclick="() => outboxNote = null">✕</button>
                                </div>
                                <p class="text-sm text-content">@outboxNote</p>
                            </div>
                        }
                <div class="panel p-8 text-center text-sm text-content-subtle">
                    Select an email to process it.
                </div>
            }
            else
            {
                <div class="panel p-5 space-y-4 relative">
                    @if (busy)
                    {
                        <JewelSpinner Overlay="true" Label="@busyLabel" />
                    }

                    @MessageHeader

                    @MessageAttachments

                    @MessageBody

                            @* Reply (or forward) where the reading ends — you get to the bottom of
                               an email and answer it or pass it on, so the buttons (and the open
                               composer) sit right here. *@
                            @if (!replyOpen)
                            {
                                <div class="flex items-center gap-2">
                                    <button type="button" class="btn-secondary" @onclick="() => OpenReplyComposer(forward: false)">↩ Reply</button>
                                    <button type="button" class="btn-secondary" @onclick="() => OpenReplyComposer(forward: true)">→ Forward</button>
                                </div>
