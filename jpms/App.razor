<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* KeyedPageRouteView (not the stock RouteView) so navigating between two URLs of the
           same route template — e.g. the project prev/next arrows — recreates the page and
           re-runs OnInitializedAsync (loading state + store refresh) instead of silently
           reusing the old project's component. *@
        @* Every page renders inside the boundary, so an exception in one becomes a report in the
           error toast and a "Try again" rather than a blank screen with nothing to send on. *@
        <ReportingErrorBoundary @ref="boundary">
            <KeyedPageRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        </ReportingErrorBoundary>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found · JPMS</PageTitle>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <section class="max-w-3xl mx-auto px-4 py-12">
                <h1 class="text-2xl font-semibold text-content mb-2">Page not found</h1>
                <p class="text-content-muted">There's nothing at this address. <a class="text-content underline" href="/">Back to sign in</a>.</p>
            </section>
        </LayoutView>
    </NotFound>
</Router>

@implements IDisposable

@code {
    private ReportingErrorBoundary? boundary;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnInitialized() => Navigation.LocationChanged += ResetBoundary;

    private void ResetBoundary(object? sender, LocationChangedEventArgs args) => boundary?.Reset();

    public void Dispose() => Navigation.LocationChanged -= ResetBoundary;
}
