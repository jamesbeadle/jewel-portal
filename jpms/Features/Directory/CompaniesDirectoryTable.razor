@namespace Jewel.JPMS.Features.Directory
@using Jewel.JPMS.Features.Subcontractors

@* The company directory's table — one CompanyDirectoryRow per company that matches the search
   and type filter, with the consolidation tick column for managers. *@
@if (Companies.Count == 0)
{
    <p class="text-sm text-content-subtle italic">No companies match.</p>
}
else
{
    <div class="rounded-xl border border-line bg-surface overflow-x-auto overflow-y-auto max-h-[85vh]">
        <table class="w-full text-sm">
            <thead class="bg-surface-raised border-b border-line">
                <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                    @if (CanManage)
                    {
                        <th class="sticky top-0 z-20 bg-surface-raised pl-4 pr-1 py-3 w-8" title="Tick records to consolidate"></th>
                    }
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Company</th>
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Type</th>
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden sm:table-cell">Trade</th>
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden md:table-cell">Primary contact</th>
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3 hidden lg:table-cell">Location</th>
                    <th class="sticky top-0 z-20 bg-surface-raised px-4 py-3">Compliance</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-line">
                @foreach (var company in Companies)
                {
                    <CompanyDirectoryRow Company="company" Compliance="Compliance" CanManage="CanManage"
                                         Selected="SelectedIds.Contains(company.SubcontractorId)"
                                         OnSelectedChanged="ticked => OnSelectedChanged.InvokeAsync((company.SubcontractorId, ticked))"
                                         OnOpen="OnOpen" />
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Subcontractor> Companies { get; set; } = default!;
    [Parameter, EditorRequired] public ComplianceOverviewReadModel Compliance { get; set; } = default!;
    [Parameter] public bool CanManage { get; set; }
    /// <summary>The records ticked for consolidation — the page owns the set.</summary>
    [Parameter] public IReadOnlyCollection<string> SelectedIds { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<(string SubcontractorId, bool Ticked)> OnSelectedChanged { get; set; }
    [Parameter] public EventCallback<string> OnOpen { get; set; }
}
