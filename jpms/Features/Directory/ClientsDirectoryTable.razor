@namespace Jewel.JPMS.Features.Directory
@using static Jewel.JPMS.Features.Directory.DirectoryDisplay

@* The Clients group: first-class client accounts, read-only here — creating, editing and the
   contacts live on their own page, which the note beneath links to. *@
@if (Error is not null)
{
    <p class="text-sm text-content-subtle italic">@Error</p>
}
else if (Clients.Count == 0)
{
    <LoadGate IsLoading="@(!Loaded)" Label="Loading">
        <p class="text-sm text-content-subtle italic">No client accounts yet.</p>
    </LoadGate>
}
else
{
    <RecordsTable>
        <thead>
            <tr>
                <th>Client</th>
                <th>Primary contact</th>
                <th>Contact email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Clients)
            {
                <tr>
                    <td class="font-medium text-content">@client.Name</td>
                    <td>@Dash(client.PrimaryContactName)</td>
                    <td>@Dash(client.PrimaryContactEmail)</td>
                </tr>
            }
        </tbody>
    </RecordsTable>
}
<p class="text-xs text-content-subtle mt-3">
    Create, edit and manage contacts on the
    <a class="underline hover:text-content" href="/clients">Client accounts</a> page.
</p>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Client> Clients { get; set; } = default!;
    [Parameter] public bool Loaded { get; set; }
    /// <summary>The group's API keeps its own gate — a role that can't read it sees this note instead of rows.</summary>
    [Parameter] public string? Error { get; set; }
}
