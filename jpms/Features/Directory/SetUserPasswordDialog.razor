@namespace Jewel.JPMS.Features.Directory
@using Jewel.JPMS.Contracts.Auth

<Modal IsOpen="IsOpen"
       Title="@Title"
       ShowFooter="@(!isSet)"
       ConfirmLabel="@(busy ? "Setting…" : "Set password")"
       ConfirmDisabled="@(busy || !IsReadyToSet)"
       DismissOnOverlayClick="false"
       OnCancel="CloseAsync"
       OnConfirm="SetAsync">
    @if (!isSet)
    {
        <div class="space-y-3">
            <p class="text-sm text-content-muted">
                @DisplayName signs in with it straight away. Every session, connected tool and emailed link
                they have is ended, so this password is the only way in. It is not emailed — tell them yourself.
            </p>
            <FormField Label="New password" Id="set-user-password-new" Required
                       Hint="@PasswordPolicy.Requirements" Error="@passwordProblem">
                <input id="set-user-password-new" type="password" autocomplete="new-password" class="field" required
                       minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength"
                       @bind="password" @bind:event="oninput" />
            </FormField>
            <FormField Label="Confirm password" Id="set-user-password-confirm" Required Error="@confirmationProblem">
                <input id="set-user-password-confirm" type="password" autocomplete="new-password" class="field" required
                       minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength"
                       @bind="confirmation" @bind:event="oninput" />
            </FormField>
            @if (error is not null)
            {
                <Notice Tone="Tone.Negative">@error</Notice>
            }
        </div>
    }
    @if (isSet)
    {
        <div class="space-y-4">
            <Notice Tone="Tone.Positive" Title="@($"{DisplayName} can sign in with the new password now.")">
                Every session, connected tool and emailed link they had has been ended. Tell them the
                password yourself — it has not been emailed and is not shown again.
            </Notice>
            <div class="flex justify-end">
                <button type="button" class="btn-secondary" @onclick="CloseAsync">Done</button>
            </div>
        </div>
    }
</Modal>
