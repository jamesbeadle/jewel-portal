@*
    The client's RFIs, one row per request across their projects. Rows open the request's own
    client page, where the shared conversation lives.
*@

@if (Requests.Count == 0)
{
    <EmptyState Message="No requests for information yet. When the project team raises one on your project, it appears here." />
}
else
{
    <RecordsTable MaxHeight="">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Title</th>
                <th>Project</th>
                <th>Status</th>
                <th>Raised</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Requests)
            {
                <tr class="border-b border-line last:border-0 hover:bg-surface-raised cursor-pointer"
                    @onclick="() => Open(request.RequestId)">
                    <td class="font-medium text-content whitespace-nowrap">@request.Reference</td>
                    <td class="text-content">@request.Title</td>
                    <td>@request.ProjectName</td>
                    <td class="whitespace-nowrap">@request.Status.DisplayName()</td>
                    <td class="whitespace-nowrap">@DateText(request.RaisedAt)</td>
                </tr>
            }
        </tbody>
    </RecordsTable>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Jewel.JPMS.Contracts.ClientPortal.ClientPortalRequest> Requests { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private void Open(string requestId) => Nav.NavigateTo($"/client/requests/{requestId}");
}
