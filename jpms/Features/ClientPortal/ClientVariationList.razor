@*
    The client's variation orders — everything that has been issued to them, across their
    projects. Rows open the order's own client page, where the shared conversation lives.
*@

@if (Orders.Count == 0)
{
    <div class="panel p-8 text-center text-sm text-content-subtle">
        No variation orders yet. When one is issued on your project, it appears here.
    </div>
}
else
{
    <RecordsTable MaxHeight="">
        <thead>
            <tr>
                <th>Reference</th>
                <th>Title</th>
                <th>Project</th>
                <th>Status</th>
                <th class="text-right">Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Orders)
            {
                <tr class="border-b border-line last:border-0 hover:bg-surface-raised cursor-pointer"
                    @onclick="() => Open(order.VariationOrderId)">
                    <td class="font-medium text-content whitespace-nowrap">@(order.VariationRef ?? order.Reference)</td>
                    <td class="text-content">@order.Title</td>
                    <td>@order.ProjectName</td>
                    <td class="whitespace-nowrap">@order.Status.DisplayName()</td>
                    <td class="whitespace-nowrap text-right">@(ClientPortalDisplay.ValueLabel(order) ?? "—")</td>
                </tr>
            }
        </tbody>
    </RecordsTable>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Jewel.JPMS.Contracts.ClientPortal.ClientPortalVariationOrder> Orders { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private void Open(string variationOrderId) => Nav.NavigateTo($"/client/variations/{variationOrderId}");
}
