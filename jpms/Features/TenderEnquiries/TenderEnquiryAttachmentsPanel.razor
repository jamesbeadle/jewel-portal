@namespace Jewel.JPMS.Features.TenderEnquiries
@inject ITenderEnquiryAttachmentStore Attachments

@* The files kept on the enquiry — the questionnaire and drawings copied off the architect's email
   when it was logged, plus anything added here. Drawings that should live in the project's
   register go through Document Control / the Drawings tab as usual; this is the enquiry's own
   bundle. *@

<div class="panel p-5">
    <div class="flex items-center justify-between mb-3">
        <h3 class="eyebrow">Documents</h3>
        @if (CanEdit)
        {
            <label class="text-xs text-accent hover:underline cursor-pointer @(busy ? "opacity-50 pointer-events-none" : "")">
                + Add files
                <InputFile OnChange="OnFilesSelected" multiple class="hidden" />
            </label>
        }
    </div>
    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@error</p>
    }
    <LoadGate IsLoading="@(files is null && !loadFailed)" Label="Loading documents">
    @if (Files.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-line bg-surface-raised px-4 py-5 text-sm text-content-subtle">
            No documents on this enquiry yet.
        </div>
    }
    else
    {
        <ul class="space-y-2">
            @foreach (var file in Files)
            {
                <li class="rounded-lg border border-line bg-surface px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                    <div class="min-w-0">
                        <a class="text-sm font-medium text-content hover:underline"
                           href="@Attachments.FileUrl(TenderEnquiryId, file.TenderEnquiryAttachmentId)" download>@file.DisplayName</a>
                        <span class="text-xs text-content-subtle ml-2">@FormatSize(file.FileSizeBytes)</span>
                        <span class="text-xs text-content-subtle ml-2">· @SourceLabel(file.Source) @file.AddedAt.LocalDateTime.ToString("d MMM yyyy")</span>
                    </div>
                    @if (CanEdit)
                    {
                        <button type="button" class="text-xs text-content-muted hover:text-negative" disabled="@busy"
                                @onclick="() => RemoveAsync(file)">Remove</button>
                    }
                </li>
            }
        </ul>
    }
    </LoadGate>
</div>

@code {
    private const int MaxFilesPerPick = 20;

    [Parameter, EditorRequired] public string TenderEnquiryId { get; set; } = "";
    [Parameter] public bool CanEdit { get; set; }

    private IReadOnlyList<TenderEnquiryAttachment>? files;
    private IReadOnlyList<TenderEnquiryAttachment> Files => files ?? Array.Empty<TenderEnquiryAttachment>();
    private bool busy;
    private bool loadFailed;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try { files = await Attachments.ListAsync(TenderEnquiryId); }
        catch { loadFailed = true; }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        if (busy) return;
        busy = true;
        error = null;
        try { files = await Attachments.UploadFilesAsync(TenderEnquiryId, e.GetMultipleFiles(MaxFilesPerPick)); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task RemoveAsync(TenderEnquiryAttachment file)
    {
        if (busy) return;
        busy = true;
        error = null;
        try { files = await Attachments.RemoveAsync(TenderEnquiryId, file.TenderEnquiryAttachmentId); }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private static string SourceLabel(TenderEnquiryAttachmentSource source) =>
        source == TenderEnquiryAttachmentSource.Email ? "from the enquiry email," : "uploaded";

}
