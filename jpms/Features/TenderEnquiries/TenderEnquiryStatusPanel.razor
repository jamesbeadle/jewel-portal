@namespace Jewel.JPMS.Features.TenderEnquiries
@using Jewel.JPMS.Contracts.TenderEnquiries
@inject ICommandSender Commands

@* Where the enquiry stands. Logging it IS accepting it (James, 2026-08-25), so a fresh enquiry is
   simply Received and in hand. The status is a picker, not a ladder: any move goes, forwards or
   back — a wrong press is undone by choosing the right one. An ending (declined, not shortlisted,
   won, lost) asks for the reason first; that note is the surviving record of why. *@

<div class="panel p-5 space-y-3">
    <div class="flex items-center justify-between gap-3">
        <h3 class="eyebrow">Status</h3>
        <TenderEnquiryStatusBadge Status="@Enquiry.Status" />
    </div>
    <dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-sm">
        <dt class="text-content-subtle">Received</dt><dd class="text-content">@Date(Enquiry.ReceivedAt)</dd>
        <dt class="text-content-subtle">PQQ return by</dt><dd class="@DueClass(Enquiry.PqqDueAt, Enquiry.PqqSubmittedAt)">@Date(Enquiry.PqqDueAt)</dd>
        <dt class="text-content-subtle">PQQ submitted</dt><dd class="text-content">@Date(Enquiry.PqqSubmittedAt)</dd>
        <dt class="text-content-subtle">Tender return by</dt><dd class="@DueClass(Enquiry.TenderDueAt, Enquiry.TenderSubmittedAt)">@Date(Enquiry.TenderDueAt)</dd>
        <dt class="text-content-subtle">Tender submitted</dt><dd class="text-content">@Date(Enquiry.TenderSubmittedAt)</dd>
        @if (Enquiry.DecidedAt is { } decidedAt)
        {
            <dt class="text-content-subtle">Decided</dt><dd class="text-content">@Date(decidedAt)</dd>
        }
    </dl>
    @if (!string.IsNullOrWhiteSpace(Enquiry.DecisionNote))
    {
        <p class="text-sm text-content-muted whitespace-pre-wrap">@Enquiry.DecisionNote</p>
    }
    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@error</p>
    }
    @if (CanMove)
    {
        <div class="space-y-2 pt-1 border-t border-line">
            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold pt-2">Change status</label>
            <select class="field" value="@((int)chosen)" disabled="@busy" @onchange="OnChosen">
                @foreach (var status in TenderEnquiryStatusExtensions.Choices)
                {
                    <option value="@((int)status)" disabled="@(status == Enquiry.Status)">@status.DisplayName()@(status == Enquiry.Status ? " (current)" : "")</option>
                }
            </select>
            @if (chosen != Enquiry.Status && !chosen.IsOpen())
            {
                <textarea class="field" rows="2" value="@note" placeholder="Why — for the record…"
                          @oninput="e => note = e.Value?.ToString() ?? string.Empty"></textarea>
            }
            <button type="button" class="btn-secondary text-xs" disabled="@(busy || chosen == Enquiry.Status || (!chosen.IsOpen() && string.IsNullOrWhiteSpace(note)))"
                    @onclick="MoveAsync">@(busy ? "Saving…" : $"Mark as {chosen.DisplayName()}")</button>
            <p class="text-xs text-content-subtle">
                Any move goes, forwards or back. PQQ submitted and Tender submitted stamp today's date; an ending asks why.
            </p>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TenderEnquiry Enquiry { get; set; } = default!;
    [Parameter] public bool CanMove { get; set; }
    [Parameter] public EventCallback<TenderEnquiry> OnChanged { get; set; }

    private TenderEnquiryStatus chosen;
    private TenderEnquiryStatus? shownFor;
    private string note = "";
    private bool busy;
    private string? error;

    // The picker rests on the enquiry's own status and follows it after every move.
    protected override void OnParametersSet()
    {
        if (shownFor == Enquiry.Status) return;
        shownFor = Enquiry.Status;
        chosen = Enquiry.Status;
    }

    private void OnChosen(ChangeEventArgs e)
    {
        if (Enum.TryParse<TenderEnquiryStatus>(e.Value?.ToString(), out var parsed)) chosen = parsed;
        error = null;
    }

    private async Task MoveAsync()
    {
        if (busy || chosen == Enquiry.Status) return;
        busy = true;
        try
        {
            var updated = await Commands.SendAsync(new SetTenderEnquiryStatus(Enquiry.TenderEnquiryId, chosen, note), CancellationToken.None);
            note = "";
            await OnChanged.InvokeAsync(updated);
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private static string Date(DateTimeOffset? value) => value?.LocalDateTime.ToString("d MMM yyyy") ?? "—";

    // A return date still ahead of us reads normally; one that has passed without the submission
    // it was for reads as overdue.
    private static string DueClass(DateTimeOffset? dueAt, DateTimeOffset? submittedAt) =>
        dueAt is { } due && submittedAt is null && due < DateTimeOffset.UtcNow ? "text-negative font-medium" : "text-content";
}
