@namespace Jewel.JPMS.Features.TenderEnquiries

@* The enquiry's editable face — shared by "Log enquiry" on the list page, the detail page's
   edit dialog and the Control Centre's Log Tender Enquiry action, so the three can never ask
   for different things. Binds to the caller's draft and reports every edit. *@

<div class="space-y-3">
    <FormField Label="Title" Value="@Draft.Title" Required="true"
               OnChange="v => Set(draft => draft.Title = v)" />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <FormField Label="Architect practice" Value="@Draft.ArchitectPracticeName" Required="true"
                   OnChange="v => Set(draft => draft.ArchitectPracticeName = v)" />
        <FormField Label="Contract form" Value="@Draft.ContractForm"
                   OnChange="v => Set(draft => draft.ContractForm = v)" />
        <FormField Label="Contact name" Value="@Draft.ArchitectContactName"
                   OnChange="v => Set(draft => draft.ArchitectContactName = v)" />
        <FormField Label="Contact email" Value="@Draft.ArchitectContactEmail" InputType="email"
                   OnChange="v => Set(draft => draft.ArchitectContactEmail = v)" />
    </div>
    <div>
        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Scope of works</label>
        <textarea class="field" rows="3" value="@Draft.ScopeSummary"
                  placeholder="What the works principally comprise, as the architect describes them…"
                  @oninput="e => Set(draft => draft.ScopeSummary = e.Value?.ToString() ?? string.Empty)"></textarea>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <FormField Label="Received on" Value="@Draft.ReceivedOn" InputType="date" Required="true"
                   OnChange="v => Set(draft => draft.ReceivedOn = v)" />
        <FormField Label="PQQ return by" Value="@Draft.PqqDueOn" InputType="date"
                   OnChange="v => Set(draft => draft.PqqDueOn = v)" />
        <FormField Label="Tender return by" Value="@Draft.TenderDueOn" InputType="date"
                   OnChange="v => Set(draft => draft.TenderDueOn = v)" />
    </div>
    @if (ShowProblem && Draft.Problem is { } problem)
    {
        <p class="text-xs text-amber-600">@problem</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public TenderEnquiryDetailsDraft Draft { get; set; } = new();

    /// <summary>Raised after every edit so a host that stages the draft elsewhere stays current.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Whether the inline "what's missing" hint shows — off until the host wants it.</summary>
    [Parameter] public bool ShowProblem { get; set; } = true;

    private Task Set(Action<TenderEnquiryDetailsDraft> edit)
    {
        edit(Draft);
        return OnChanged.InvokeAsync();
    }
}
