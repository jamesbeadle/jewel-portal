@namespace Jewel.JPMS.Features.TenderEnquiries

@* The register's rows: reference + title, the project it sits on, the architect, status, when it
   arrived and the next date it is working towards (red once missed). *@

<div class="rounded-xl border border-line bg-surface overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="bg-surface-raised border-b border-line">
            <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                <th class="px-4 py-3">Enquiry</th>
                <th class="px-4 py-3 hidden md:table-cell">Project</th>
                <th class="px-4 py-3 hidden sm:table-cell">Architect</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3 hidden md:table-cell">Received</th>
                <th class="px-4 py-3 hidden lg:table-cell">Next due</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line">
            @foreach (var enquiry in Enquiries)
            {
                <tr class="hover:bg-surface-raised @(enquiry.Status.IsOpen() ? "" : "opacity-60")">
                    <td class="px-4 py-3">
                        <span class="text-xs font-mono text-content-subtle mr-2">@enquiry.Reference</span>
                        <a class="text-content font-medium hover:underline underline-offset-4"
                           href="@($"/tender-enquiries/{enquiry.TenderEnquiryId}")">@enquiry.Title</a>
                    </td>
                    <td class="px-4 py-3 text-content-subtle hidden md:table-cell font-mono text-xs">@ProjectReference(enquiry.ProjectId)</td>
                    <td class="px-4 py-3 text-content-muted hidden sm:table-cell">@enquiry.ArchitectPracticeName</td>
                    <td class="px-4 py-3"><TenderEnquiryStatusBadge Status="@enquiry.Status" /></td>
                    <td class="px-4 py-3 text-content-subtle hidden md:table-cell">@enquiry.ReceivedAt.LocalDateTime.ToString("d MMM yyyy")</td>
                    <td class="px-4 py-3 hidden lg:table-cell @(enquiry.IsOverdue ? "text-negative font-medium" : "text-content-subtle")">
                        @(enquiry.NextDueAt?.LocalDateTime.ToString("d MMM yyyy") ?? "—")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TenderEnquiry> Enquiries { get; set; } = Array.Empty<TenderEnquiry>();
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    // The reference (JBB-2026-014) rather than the name — the name is usually the enquiry's title
    // again. Blank until the project list has landed; a line of text arriving late is invisible.
    private string ProjectReference(string projectId) =>
        Projects.FirstOrDefault(project => project.ProjectId == projectId)?.Reference ?? "";
}
