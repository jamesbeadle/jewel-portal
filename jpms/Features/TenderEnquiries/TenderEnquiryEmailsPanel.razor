@namespace Jewel.JPMS.Features.TenderEnquiries
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Triage.Panels
@inject IQueryClient Queries
@inject Jewel.JPMS.Features.Projects.ProjectListReadModel ProjectList

@* The enquiry's correspondence, read live by its JPMS/TEQ-#### tag: the architect's invitation,
   Jewel's PQQ reply, the shortlist letter, the tender return. Replying from here sends from the
   projects mailbox and files itself back into this list; the composer's System documents picker
   offers the PQQ response PDF, so the reply that carries it is one act. *@

<section>
    <div class="flex items-center justify-between mb-3">
        <h3 class="eyebrow">Correspondence</h3>
        <div class="flex items-center gap-3">
            @if (emails is not null && Emails.Count > 0)
            {
                <span class="inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[11px] font-medium text-accent">@Emails.Count</span>
            }
            <EmailFinder Type="RecordType.TenderEnquiry" RecordId="@Enquiry.TenderEnquiryId"
                         RecordReference="@Enquiry.Reference" ExcludeTag="@OwnTag" OnLinked="ReloadAsync" />
        </div>
    </div>
    <LoadGate IsLoading="@(emails is null && !loadFailed)" Prominent="true" Label="Loading correspondence">
    @if (sentNote is not null)
    {
        <div class="rounded-lg border border-positive/40 bg-positive/5 px-3 py-2 mb-3 flex items-center justify-between gap-2">
            <p class="text-sm text-content">@sentNote</p>
            <button type="button" class="text-content-subtle hover:text-content text-xs" title="Dismiss" @onclick="() => sentNote = null">✕</button>
        </div>
    }
    @if (replyingTo is { } anchor)
    {
        <div class="mb-3 space-y-2">
            <p class="text-sm text-content-muted">
                @(isForward ? "Forwarding" : "Replying to") <span class="text-content font-medium">@(string.IsNullOrWhiteSpace(anchor.FromName) ? anchor.FromEmail : anchor.FromName)</span> —
                <span class="italic">@anchor.Subject</span>
            </p>
            <MailReplyComposer @key="@($"{anchor.Id}:{isForward}")" ReplyTo="anchor" Forward="isForward"
                               Projects="@(ProjectList.Current ?? Array.Empty<Project>())" ProjectId="@Enquiry.ProjectId"
                               FooterNote="The email sends now from the projects mailbox and files itself back into this list. Attach the PQQ response from the System documents picker."
                               OnSent="OnSent" OnCancel="() => replyingTo = null" />
        </div>
    }
    @if (Emails.Count == 0)
    {
        @if (emails is not null)
        {
            <p class="text-sm text-content-subtle italic">
                No emails tagged to this enquiry. Tag them with @Enquiry.Reference in Triage and they appear here.
            </p>
        }
    }
    else
    {
        <CorrespondenceThreadList Emails="Emails" ExcludeTag="@OwnTag"
                                  OnReply="email => StartCompose(email, forward: false)"
                                  OnForward="email => StartCompose(email, forward: true)"
                                  OnUntagged="_ => ReloadAsync()" />
    }
    </LoadGate>
</section>

@code {
    [Parameter, EditorRequired] public TenderEnquiry Enquiry { get; set; } = default!;

    private IReadOnlyList<MailboxMessage>? emails;
    private IReadOnlyList<MailboxMessage> Emails => emails ?? Array.Empty<MailboxMessage>();
    private bool loadFailed;
    private MailboxMessage? replyingTo;
    private bool isForward;
    private string? sentNote;

    private string OwnTag => $"JPMS/{Enquiry.Reference}";

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try { emails = await Queries.AskAsync(new ListRecordEmails(RecordType.TenderEnquiry, Enquiry.TenderEnquiryId), CancellationToken.None); }
        catch { loadFailed = true; }
    }

    private void StartCompose(MailboxMessage email, bool forward)
    {
        sentNote = null;
        isForward = forward;
        replyingTo = email;
    }

    private async Task OnSent(ComposeOutcome outcome)
    {
        replyingTo = null;
        sentNote = outcome.Sent ? $"Sent: {outcome.Subject}" : $"Saved as a draft in Outlook: {outcome.Subject}";
        await ReloadAsync();
    }
}
