@namespace Jewel.JPMS.Features.TenderEnquiries

@* The questionnaire being edited: one card per question, reorderable, plus a paste box that turns
   one-question-per-line text into rows (numbering stripped). Every edit reports up so a live
   assistant task sees the form as it actually stands. *@

<div class="space-y-4">
    @for (var index = 0; index < Draft.Count; index++)
    {
        var position = index;
        var row = Draft[position];
        <div class="rounded-lg border border-line p-3 space-y-2">
            <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-content-subtle">Question @(position + 1)</span>
                <div class="flex gap-2 text-xs">
                    <button type="button" class="text-content-subtle hover:text-content" disabled="@(position == 0)" @onclick="() => Move(position, -1)">↑</button>
                    <button type="button" class="text-content-subtle hover:text-content" disabled="@(position == Draft.Count - 1)" @onclick="() => Move(position, 1)">↓</button>
                    <button type="button" class="text-content-subtle hover:text-negative" @onclick="() => Remove(position)">Remove</button>
                </div>
            </div>
            <input class="field" value="@row.Question" placeholder="The question as the architect asked it…"
                   @oninput="e => Set(() => row.Question = e.Value?.ToString() ?? string.Empty)" />
            <textarea class="field" rows="4" value="@row.Answer" placeholder="Jewel's answer…"
                      @oninput="e => Set(() => row.Answer = e.Value?.ToString() ?? string.Empty)"></textarea>
        </div>
    }
    <div class="flex flex-wrap gap-2">
        <button type="button" class="btn-secondary text-xs" @onclick="() => Set(() => Draft.Add(new TenderEnquiryAnswerRow()))">+ Add question</button>
        <button type="button" class="btn-secondary text-xs" @onclick="() => showPaste = !showPaste">Paste questions</button>
    </div>
    @if (showPaste)
    {
        <div class="space-y-2">
            <textarea class="field" rows="6" value="@pasteText" placeholder="One question per line — numbering is stripped."
                      @oninput="e => pasteText = e.Value?.ToString() ?? string.Empty"></textarea>
            <button type="button" class="btn-secondary text-xs" @onclick="AddPastedQuestions">Add these questions</button>
        </div>
    }
    <div class="flex gap-2 pt-2">
        <button type="button" class="btn-primary" disabled="@Busy" @onclick="() => OnSave.InvokeAsync()">@(Busy ? "Saving…" : "Save answers")</button>
        <button type="button" class="btn-neutral" disabled="@Busy" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<TenderEnquiryAnswerRow> Draft { get; set; } = new();
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool showPaste;
    private string pasteText = "";

    private Task Set(Action edit)
    {
        edit();
        return OnChanged.InvokeAsync();
    }

    private Task Move(int position, int direction)
    {
        var target = position + direction;
        if (target < 0 || target >= Draft.Count) return Task.CompletedTask;
        return Set(() => (Draft[position], Draft[target]) = (Draft[target], Draft[position]));
    }

    private Task Remove(int position) => Set(() => Draft.RemoveAt(position));

    // "1. Full company name…" → "Full company name…": leading numbering and bullets are stripped
    // so the sheet numbers itself.
    private Task AddPastedQuestions()
    {
        var questions = pasteText.Split('\n')
            .Select(line => line.Trim().TrimStart('-', '•', '·', ' '))
            .Select(line => System.Text.RegularExpressions.Regex.Replace(line, @"^\(?\d+[\.\)]\s*", ""))
            .Where(line => line.Length > 0)
            .ToList();
        pasteText = "";
        showPaste = false;
        return Set(() =>
        {
            Draft.RemoveAll(row => row.IsBlank);
            Draft.AddRange(questions.Select(question => new TenderEnquiryAnswerRow { Question = question }));
        });
    }
}
