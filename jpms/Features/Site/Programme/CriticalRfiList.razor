@namespace Jewel.JPMS.Features.Site

@* RFIs tagged Critical Path — programme-related requests whose answers gate work on the
   programme's critical path. The tag is set on the RFI itself (detail page → Actions or Edit
   details); this view is the programme-side lens on that subset, open and closed, so it doubles
   as the programme-impact history. *@
<LoadGate IsLoading="@(!Loaded)" Prominent="true" Label="Loading critical path RFIs">
@if (Rfis.Count == 0)
{
    <div class="panel p-8 text-center">
        <p class="text-sm text-content">No critical path RFIs on this project.</p>
        <p class="text-xs text-content-subtle mt-1">
            Tag an RFI as <span class="font-medium text-content">Critical path</span> from its detail page (Actions → Mark as critical path) and it will appear here.
        </p>
    </div>
}
else
{
    <ul class="space-y-2">
        @foreach (var rfi in Rfis)
        {
            <li>
                <a href="@($"/projects/{ProjectId}/requests/view/{rfi.RequestId}")"
                   class="btn-secondary">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs text-content-muted">@rfi.Reference</span>
                            <span class="text-sm font-medium text-content">@rfi.Title</span>
                            <Pill Tone="Tone.Negative">Critical path</Pill>
                        </div>
                        <div class="flex items-center gap-2">
                            @if (rfi.DaysOutstanding is int days)
                            {
                                <span class="text-xs @(rfi.IsOverdue ?"text-negative font-semibold" : "text-content-subtle")"
                                      title="Days outstanding since raised">@days d outstanding</span>
                            }
                            <Pill Tone="@rfi.Status.ToTone()">@rfi.Status.DisplayName()</Pill>
                            <span class="text-xs text-content-subtle">@(DateText(rfi.IssuedAt ?? rfi.RaisedAt))</span>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-xs text-content-subtle">
                        @if (rfi.ResponseDue is { } due)
                        {
                            <span>Response due @DateText(due)</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(rfi.Description))
                    {
                        <p class="text-xs text-content-subtle mt-1 line-clamp-2">@rfi.Description</p>
                    }
                </a>
            </li>
        }
    </ul>
}
</LoadGate>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter] public IReadOnlyList<Request> Rfis { get; set; } = Array.Empty<Request>();
    [Parameter] public bool Loaded { get; set; }

    // Mirrors the request detail page's colouring so an RFI reads the same on both sides.
}
