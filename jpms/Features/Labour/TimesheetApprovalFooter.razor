@namespace Jewel.JPMS.Features.Labour

@* Coding is the step before approval — uncoded rows hard-block. Code the whole selection in
   one go, then approve; the selection survives the coding pass. *@
<div class="flex flex-wrap items-center gap-3 px-5 py-3 border-t border-line">
    <div class="flex items-center gap-2">
        <SearchSelect Options="@CostCodeOptions" WidthClass="w-56" Placeholder="Cost code…"
                      Value="@BulkCostCode" ValueChanged="BulkCostCodeChanged" />
        <button type="button" class="btn-secondary" disabled="@(SelectedCount == 0 || IsCoding || IsApproving)" @onclick="() => OnCode.InvokeAsync()">
            @(IsCoding ? "Coding…" : $"Code {CountText}selected")
        </button>
    </div>
    <button type="button" class="btn-primary" disabled="@(SelectedCount == 0 || IsApproving || IsCoding)" @onclick="() => OnApprove.InvokeAsync()">
        Approve @(CountText)selected
    </button>
    <span class="text-xs text-content-subtle">Uncoded rows? Pick a cost code and Code selected first, then approve. Only approved time posts to Financials as cost. Budget hard-block applies per cost code.</span>
</div>

@code {
    [Parameter] public int SelectedCount { get; set; }
    [Parameter] public IReadOnlyList<SearchSelect.Option> CostCodeOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    /// <summary>Page-owned: the coding pass reads it when it fires.</summary>
    [Parameter] public string BulkCostCode { get; set; } = "";
    [Parameter] public EventCallback<string> BulkCostCodeChanged { get; set; }
    [Parameter] public bool IsCoding { get; set; }
    [Parameter] public bool IsApproving { get; set; }
    [Parameter] public EventCallback OnCode { get; set; }
    [Parameter] public EventCallback OnApprove { get; set; }

    private string CountText => SelectedCount > 0 ? $"{SelectedCount} " : "";
}
