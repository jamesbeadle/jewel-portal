@namespace Jewel.JPMS.Features.Labour
@inject ILabourStore Labour

@* Add a materials / travel settlement line. Labour comes from approved timesheets only; this
   adds a non-labour line to the worker's month — it changes the Xero account and is never
   CIS-deducted. Opened by the page with Open(schedule); the dialog owns the fields. *@
<Modal IsOpen="@open" Title="@($"Add materials / travel — {workerName}")"
       ConfirmLabel="Add line" ConfirmDisabled="@saving"
       OnCancel="() => open = false" OnConfirm="SaveAsync">
    <p class="text-xs text-content-subtle mb-3">Labour comes from approved timesheets only. This adds a non-labour line to the worker's month — it changes the Xero account and is never CIS-deducted.</p>
    <div class="space-y-3">
        <label class="block text-sm text-content-muted">Nature
            <select class="field mt-1" @bind="nature">
                <option value="@SettlementLineNature.CisMaterials">Materials</option>
                <option value="@SettlementLineNature.Travel">Travel</option>
            </select>
        </label>
        <label class="block text-sm text-content-muted">Site (project id)
            <input class="field mt-1" @bind="projectId" placeholder="Project id" />
        </label>
        <label class="block text-sm text-content-muted">Cost code
            <input class="field mt-1" @bind="costCode" placeholder="e.g. 00010" />
        </label>
        <label class="block text-sm text-content-muted">Amount (£, net)
            <input class="field mt-1 w-32" type="number" step="0.01" min="0" @bind="amount" />
        </label>
        <label class="block text-sm text-content-muted">Note (optional)
            <input class="field mt-1" @bind="note" />
        </label>
        @if (error is not null)
        {
            <Notice Tone="Tone.Negative">@error</Notice>
        }
    </div>
</Modal>

@code {
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }

    private bool open;
    private bool saving;
    private string? error;
    private string workerId = "";
    private string workerName = "";
    private SettlementLineNature nature = SettlementLineNature.CisMaterials;
    private string projectId = "";
    private string costCode = "";
    private decimal amount;
    private string note = "";

    /// <summary>Opens the dialog for a worker's schedule, pre-filled with its first line's site and code.</summary>
    public void Open(WorkerSettlementSchedule schedule)
    {
        workerId = schedule.WorkerId;
        workerName = schedule.WorkerName;
        nature = SettlementLineNature.CisMaterials;
        projectId = schedule.Lines.FirstOrDefault()?.ProjectId ?? "";
        costCode = schedule.Lines.FirstOrDefault()?.CostCode ?? "";
        amount = 0m; note = ""; error = null;
        open = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        error =
            amount <= 0m ? "The amount must be greater than zero."
            : string.IsNullOrWhiteSpace(projectId) ? "Say which site the line lands on."
            : string.IsNullOrWhiteSpace(costCode) ? "Pick the cost code." : null;
        if (error is not null) return;
        saving = true;
        try
        {
            await Labour.AddSettlementLineAsync(Year, Month, workerId, projectId.Trim(), costCode.Trim(), nature, amount, note);
            open = false;
        }
        catch (Exception) { error = "Could not add the line — try again."; }
        finally { saving = false; }
    }
}
