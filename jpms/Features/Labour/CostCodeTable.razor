@namespace Jewel.JPMS.Features.Labour
@using static Jewel.JPMS.Features.Labour.LabourDisplay

@* By cost code: where the month's labour was coded. *@
<Panel Title="By cost code" Class="mb-6" BodyClass="p-0" IsLoading="@Loading" LoadingLabel="Loading cost codes">
    @if (Snapshot is null)
    {
        <p class="p-5 text-sm text-negative">Couldn't load the overview — refresh to try again.</p>
    }
    else if (Snapshot.CostCodes.Count == 0)
    {
        <p class="p-5 text-sm text-content-subtle italic">No labour recorded against any cost code this month yet.</p>
    }
    else
    {
        var maxCodeCost = Snapshot.CostCodes.Max(code => code.CostRecorded);
        <table class="w-full text-sm">
            <thead>
                <tr class="text-left text-xs uppercase tracking-wide text-content-subtle border-b border-line">
                    <th class="px-5 py-3">Cost code</th>
                    <th class="px-2 py-3">Trade</th>
                    <th class="px-2 py-3 w-1/3"></th>
                    <th class="px-2 py-3 text-right">Days</th>
                    <th class="px-5 py-3 text-right">Cost</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var centre in Snapshot.CostCodes)
                {
                    <tr class="border-b border-line/60">
                        <td class="px-5 py-2.5 font-medium text-content tabular-nums">@centre.CostCode</td>
                        <td class="px-2 py-2.5 text-content-muted">@centre.Trade</td>
                        <td class="px-2 py-2.5">
                            <div class="h-1.5 rounded-full bg-surface-field overflow-hidden">
                                <div class="h-full bg-accent/70" style="width:@BarWidth(centre.CostRecorded, maxCodeCost)"></div>
                            </div>
                        </td>
                        <td class="px-2 py-2.5 text-right tabular-nums text-content-muted">@Days(centre.DaysRecorded)</td>
                        <td class="px-5 py-2.5 text-right tabular-nums font-semibold text-content">@Pounds(centre.CostRecorded)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</Panel>

@code {
    [Parameter] public LabourOverviewSnapshot? Snapshot { get; set; }
    [Parameter] public bool Loading { get; set; }
}
