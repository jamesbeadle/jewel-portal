@namespace Jewel.JPMS.Features.Labour

@* A site row expanded: who worked here, day by day — every settled (approved or sent-back)
   day any worker recorded against this project in the open month. *@
<h4 class="text-xs uppercase tracking-wide text-content-subtle mb-2">Who worked here, day by day</h4>
@if (Visits.Count == 0)
{
    <p class="text-sm text-content-subtle italic">No days recorded.</p>
}
else
{
    <table class="w-auto text-sm">
        <tbody>
            @foreach (var (name, day) in Visits)
            {
                <tr class="border-b border-line/40">
                    <td class="py-1.5 pr-6 text-content-muted whitespace-nowrap">@day.Date.ToString("ddd dd MMM")</td>
                    <td class="py-1.5 pr-6 font-medium text-content whitespace-nowrap">@name</td>
                    <td class="py-1.5 pr-6 text-right tabular-nums text-content-muted">@($"{day.Hours:0.#} h")</td>
                    <td class="py-1.5"><StatusPill Status="@day.Status!.Value" /></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired] public LabourOverviewSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public LabourOverviewSite Site { get; set; } = default!;

    private IReadOnlyList<(string Name, LabourOverviewDay Day)> Visits =>
        Snapshot.Workers
            .SelectMany(worker => worker.Days
                .Where(day => day.ProjectId == Site.ProjectId && day.Status is not null)
                .Select(day => (worker.Name, day)))
            .OrderBy(pair => pair.day.Date).ThenBy(pair => pair.Name)
            .ToList();
}
