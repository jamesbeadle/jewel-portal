@namespace Jewel.JPMS.Features.Labour

<Panel Title="Site register" BodyClass="p-0" IsLoading="@Loading" LoadingLabel="Loading the site register">
    @if (LoadFailed)
    {
        <p class="p-5 text-sm text-negative">Couldn't load the site register — reload to try again.</p>
    }
    else if (Rows.Count == 0)
    {
        <p class="p-5 text-sm text-content-subtle italic">No attendance recorded yet.</p>
    }
    else
    {
        <table class="data-table data-table-dense">
            <thead>
                <tr>
                    <th>Date</th><th>Worker</th>
                    <th>In</th><th>Out</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td class="whitespace-nowrap">@row.WorkDate.ToString("ddd dd MMM")</td>
                        <td class="text-content whitespace-nowrap">@row.WorkerName</td>
                        <td class="text-content-subtle tabular-nums">@row.SignedInAt.ToLocalTime().ToString("HH:mm")</td>
                        <td>
                            @if (row.SignedOutAt is { } signedOut)
                            {
                                <span class="text-content-subtle tabular-nums">@signedOut.ToLocalTime().ToString("HH:mm")</span>
                            }
                            else
                            {
                                <Pill Tone="Tone.Negative">no sign-out</Pill>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</Panel>

@code {
    [Parameter] public IReadOnlyList<SiteAttendance> Rows { get; set; } = Array.Empty<SiteAttendance>();
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool LoadFailed { get; set; }
}
