@namespace Jewel.JPMS.Features.Labour

<table class="data-table data-table-dense max-w-3xl">
    <thead>
        <tr>
            <th>Subcontractor</th>
            <th class="text-right">Approved £</th>
            <th class="text-right">Covered invoices £</th>
            <th class="text-right">Posted variances £</th>
            <th class="text-right">Unresolved £</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Rows)
        {
            <tr>
                <td class="text-content">@row.SubcontractorName</td>
                <td class="text-right tabular-nums">@row.ApprovedCost.ToString("N2")</td>
                <td class="text-right tabular-nums">@row.CoveredInvoiceTotal.ToString("N2")</td>
                <td class="text-right tabular-nums">@row.PostedVarianceTotal.ToString("N2")</td>
                <td class="text-right tabular-nums @(row.UnresolvedVariance == 0m ?"text-positive" : "text-negative font-medium")">
                    @row.UnresolvedVariance.ToString("N2")
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public IReadOnlyList<LabourSettlementRow> Rows { get; set; } = Array.Empty<LabourSettlementRow>();
}
