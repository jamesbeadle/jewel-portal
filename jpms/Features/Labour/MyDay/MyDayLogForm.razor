@namespace Jewel.JPMS.Features.Labour.MyDay
@using Jewel.JPMS.Contracts.Labour
@inject ILabourStore Labour
@inject MyDayPhotoUploader Photos

<div class="space-y-4">
    @if (isRestored)
    {
        <Notice Dismissible OnDismiss="() => isRestored = false">We kept what you'd typed before the page reloaded. Take or pick the photos again — a browser can't keep those.</Notice>
    }
    <MyDaySitePicker Projects="Projects" @bind-ProjectId="projectId" @bind-ProjectId:after="KeepCodeOnSite" Disabled="@isBusy" />
    <FormField Label="Hours today" Hint="Half-hour steps for anything in between.">
        <MyDayHoursPicker @bind-Hours="hours" @bind-Hours:after="SaveDraftAsync" Disabled="@isBusy" />
    </FormField>
    <MyDayCostCodePicker Codes="Codes" RecentCodes="RecentCodes" @bind-CostCode="costCode" @bind-CostCode:after="SaveDraftAsync" Disabled="@isBusy" />
    <MyDayWordsBox @bind-Words="description" @bind-Words:after="SaveDraftAsync" Disabled="@isBusy" OnReportWordCaught="OpenDefectBox" />
    <MyDayPhotosField Basket="photos" Disabled="@isBusy" />
    <div class="space-y-2">
        <MyDayInstructionBox @bind-Instruction="instruction" @bind-Instruction:after="SaveDraftAsync" Disabled="@isBusy" />
        <MyDayDefectBox @bind-Defect="defect" @bind-Defect:after="SaveDraftAsync" @bind-IsOpen="isDefectBoxOpen" Disabled="@isBusy" />
    </div>
    <MyDayClock Label="Leaving at" Hint="The time now — change it if you're logging the day later." @bind-Time="leftAt" @bind-Time:after="SaveDraftAsync" Disabled="@isBusy" />
    @if (IsLongDay)
    {
        <p class="text-xs text-warning">Over @LongDayHours hours — fine if it's right, just double-check.</p>
    }
    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }
    <button type="button" class="btn-primary btn-lg w-full" disabled="@isBusy" @onclick="SubmitAsync">@SubmitLabel()</button>
</div>

@code {
    private const decimal LongDayHours = 12m;

    [Parameter, EditorRequired] public MyLabourProject Project { get; set; } = default!;
    /// <summary>Every site the worker is on, so a day signed in on the wrong one is put right at sign-out.</summary>
    [Parameter] public IReadOnlyList<MyLabourProject> Projects { get; set; } = Array.Empty<MyLabourProject>();
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string?> OnPhotoProblem { get; set; }

    private string projectId = "";
    private decimal hours = WorkingDayChunks.FullDay;
    private string costCode = "";
    private string description = "";
    private SiteLogInstruction? instruction;
    private string defect = "";
    private bool isDefectBoxOpen;
    private string leftAt = "";
    private readonly MyDayPhotoBasket photos = new();
    private bool isBusy;
    private bool isUploadingPhotos;
    private string? error;

    private bool HasPhotos => photos.HasAny;
    private bool HasWords => !string.IsNullOrWhiteSpace(description);
    private bool HasHours => hours > WorkingDayChunks.Off;
    private bool IsLongDay => hours > LongDayHours;
    private string PhotoCountText => photos.Count == 1 ? "1 photo" : $"{photos.Count} photos";
    private IReadOnlyList<SiteSheetCostCode> Codes =>
        Projects.FirstOrDefault(project => project.ProjectId == projectId)?.CostCodes ?? Project.CostCodes;

    protected override async Task OnInitializedAsync()
    {
        projectId = Project.ProjectId;
        costCode = RecentCodes.FirstOrDefault(recent => Codes.Any(code => code.Code == recent)) ?? "";
        await RestoreDraftAsync();
    }

    private void KeepCodeOnSite()
    {
        var isCodeOnTheSite = Codes.Any(code => code.Code == costCode);
        if (!isCodeOnTheSite) costCode = "";
    }

    private void OpenDefectBox() => isDefectBoxOpen = true;

    private string SubmitLabel()
    {
        if (isUploadingPhotos) return $"Uploading {PhotoCountText}…";
        if (isBusy) return "Saving your day…";
        return "Submit & sign out";
    }

    private string? Refusal()
    {
        if (!HasHours) return "Give the day its hours — half a day, a full day, or half-hour steps.";
        if (string.IsNullOrWhiteSpace(costCode)) return "Choose what the work was.";
        if (!HasWords) return "Say what was done today — the words are the day's record.";
        var instructionErrors = SiteLogRules.CheckInstruction(instruction);
        if (instructionErrors.Count > 0) return string.Join(" ", instructionErrors);
        return null;
    }

    private async Task SubmitAsync()
    {
        error = Refusal();
        if (error is not null) return;
        isBusy = true;
        try
        {
            var logged = await SaveDayAsync();
            if (logged is null) return;
            await ForgetDraftAsync();
            await UploadPhotosAsync(logged);
            await RefreshQuietlyAsync();
        }
        finally { isBusy = false; isUploadingPhotos = false; }
    }

    private async Task<MySiteDayLogged?> SaveDayAsync()
    {
        var entries = new[] { new SiteSignOutEntry(costCode, hours) };
        var day = new MySiteSignOut(projectId, entries, description.Trim(), MyDayTimes.TodayAt(leftAt), instruction, defect.Trim());
        try { return await Labour.MySignOutAsync(day); }
        catch (CommandFailedException refusal) { error = refusal.Message; }
        catch (Exception) { error = "Your day didn't go through — check your signal and try again."; }
        return null;
    }

    private async Task UploadPhotosAsync(MySiteDayLogged logged)
    {
        if (!HasPhotos) return;
        isUploadingPhotos = true;
        StateHasChanged();
        try { await Photos.UploadAsync(logged.ProgressUpdateId, photos.Photos, CancellationToken.None); }
        catch (Exception exception)
        {
            await OnPhotoProblem.InvokeAsync($"Your day is saved, but the photos didn't upload ({exception.Message}). Add them from today's log below.");
        }
    }

    private async Task RefreshQuietlyAsync()
    {
        try { await Labour.RefreshMyDayAsync(); }
        catch (Exception) { error = "Your day is saved — tap Refresh to see it."; }
    }
}
