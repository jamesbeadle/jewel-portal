@namespace Jewel.JPMS.Features.Labour.MyDay
@inject ILabourStore Labour

@if (!isRecordingDayOff)
{
    <div class="space-y-3">
        <FormField Label="Arrived at" Hint="The time now — change it if you forgot at the gate.">
            <input type="time" class="field h-12 text-lg" value="@arrivedAt" @onchange="args => arrivedAt = args.Value?.ToString() ?? string.Empty" />
        </FormField>
        <button type="button" class="btn-primary w-full py-3.5 text-base font-semibold" disabled="@isBusy" @onclick="SignInAsync">
            @(isBusy ? "Signing in…" : "Sign in")
        </button>
        <button type="button" class="btn-ghost w-full" disabled="@isBusy" @onclick="() => isRecordingDayOff = true">Not on site today</button>
        @if (error is not null)
        {
            <p class="text-sm text-negative" role="alert">@error</p>
        }
    </div>
}
@if (isRecordingDayOff)
{
    <MyDayOffForm ProjectId="@ProjectId" OnCancel="() => isRecordingDayOff = false" />
}

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    private string arrivedAt = MyDayTimes.Now();
    private bool isRecordingDayOff;
    private bool isBusy;
    private string? error;

    private async Task SignInAsync()
    {
        error = null;
        isBusy = true;
        try { await Labour.MySignInAsync(ProjectId, MyDayTimes.TodayAt(arrivedAt)); }
        catch (CommandFailedException refusal) { error = refusal.Message; }
        catch (Exception) { error = "Sign-in didn't go through — check your signal and try again."; }
        finally { isBusy = false; }
    }
}
