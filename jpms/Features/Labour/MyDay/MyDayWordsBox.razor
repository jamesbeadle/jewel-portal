@namespace Jewel.JPMS.Features.Labour.MyDay
@using Jewel.JPMS.Contracts.Progress

<FormField Label="What was done today" Required Hint="In your own words — this is the day's record and goes into the weekly report.">
    <textarea class="field" rows="4" value="@Words" @oninput="OnWordsTyped" disabled="@Disabled" placeholder="Second fix to the plot 3 bathrooms, skirting in the hall…"></textarea>
</FormField>
@if (HasReportWords)
{
    <Notice Tone="Tone.Warning">
        “@CaughtWordsText” can't go in the weekly report. @DefectAdvice The day still saves as written.
    </Notice>
}

@code {
    [Parameter] public string Words { get; set; } = "";
    [Parameter] public EventCallback<string> WordsChanged { get; set; }
    [Parameter] public EventCallback OnReportWordCaught { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool HasDefectBox { get; set; } = true;

    private string DefectAdvice => HasDefectBox
        ? "Put that in the Defect box below — it goes to the defects register instead."
        : "The office will move it to a defect before the report is built.";

    private IReadOnlyList<string> caughtWords = Array.Empty<string>();

    private bool HasReportWords => caughtWords.Count > 0;
    private string CaughtWordsText => string.Join("”, “", caughtWords);

    private async Task OnWordsTyped(ChangeEventArgs change)
    {
        var words = change.Value?.ToString() ?? "";
        var wasCaught = HasReportWords;
        caughtWords = ReportWordingRule.BannedWordsIn(words);
        await WordsChanged.InvokeAsync(words);
        if (HasReportWords && !wasCaught) await OnReportWordCaught.InvokeAsync();
    }
}
