@namespace Jewel.JPMS.Features.Labour.MyDay
@using Jewel.JPMS.Features.Progress

@*
    The photographs picked for a day, kept as they are picked: a phone's camera hands back one
    photo per visit, so each pick is ADDED to the ones already chosen rather than replacing them
    (Jeremy on Jack's phone, 30 Sep 2026: "when you take another one the 1st photo goes missing").
    Each photo's bytes are read the moment it is picked, because the browser hands the input a
    fresh file list on every pick and the earlier list's files can no longer be opened.
    Each chosen photo can be taken off again before the day is saved.
*@

<FormField Label="@Label" Hint="@Hint">
    <InputFile OnChange="AddPhotosAsync" multiple accept="image/*" class="w-full text-sm text-content-muted" disabled="@(Disabled || isReading)" />
    @if (Photos.Count > 0)
    {
        <ul class="mt-2 space-y-1 text-sm">
            @foreach (var photo in Photos)
            {
                <li class="flex items-center justify-between gap-3">
                    <span class="text-content-muted min-w-0 truncate">@photo.Name</span>
                    <button type="button" class="btn-ghost shrink-0" disabled="@Disabled" aria-label="Remove this photo" @onclick="() => RemoveAsync(photo)">Remove</button>
                </li>
            }
        </ul>
    }
</FormField>

@code {
    [Parameter] public string Label { get; set; } = "Photos";
    [Parameter] public string EmptyHint { get; set; } = "";
    [Parameter] public IReadOnlyList<ChosenPhoto> Photos { get; set; } = Array.Empty<ChosenPhoto>();
    [Parameter] public EventCallback<IReadOnlyList<ChosenPhoto>> PhotosChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool isReading;

    private string CountText => Photos.Count == 1 ? "1 photo" : $"{Photos.Count} photos";
    private string Hint => Photos.Count == 0 ? EmptyHint : $"{CountText} · {FormatSize(Photos.Sum(photo => photo.Size))}. Take or pick another and it is added.";

    private async Task AddPhotosAsync(InputFileChangeEventArgs change)
    {
        isReading = true;
        try
        {
            var picked = change.GetMultipleFiles(MyDayPhotoUploader.MaxPerBatch);
            var kept = Photos.ToList();
            foreach (var file in picked.Where(IsNew).Take(MyDayPhotoUploader.MaxPerBatch - kept.Count))
                kept.Add(await ChosenPhoto.ReadAsync(file, CancellationToken.None));
            await PhotosChanged.InvokeAsync(kept);
        }
        finally { isReading = false; }
    }

    private Task RemoveAsync(ChosenPhoto photo) => PhotosChanged.InvokeAsync(Photos.Where(held => held != photo).ToList());

    private bool IsNew(IBrowserFile picked) => !Photos.Any(held => IsSamePhoto(held, picked));

    private static bool IsSamePhoto(ChosenPhoto held, IBrowserFile picked) =>
        held.Name == picked.Name && held.Size == picked.Size && held.LastModified == picked.LastModified;
}
