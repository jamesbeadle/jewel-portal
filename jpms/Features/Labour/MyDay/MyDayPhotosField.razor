@namespace Jewel.JPMS.Features.Labour.MyDay

<FormField Label="Photos" Hint="@Hint">
    <InputFile OnChange="AddAsync" multiple accept="image/*" class="w-full text-sm text-content-muted" disabled="@(Disabled || isReading)" />
    @if (Basket.HasAny)
    {
        <button type="button" class="btn-ghost mt-1" disabled="@Disabled" @onclick="Clear">Remove the photos</button>
    }
</FormField>

@code {
    [Parameter, EditorRequired] public MyDayPhotoBasket Basket { get; set; } = default!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool isReading;

    private string CountText => Basket.Count == 1 ? "1 photo" : $"{Basket.Count} photos";

    private string Hint => Basket.HasAny
        ? $"{CountText} · {FormatSize(Basket.TotalBytes)} — take or choose more and they add on."
        : $"Camera or gallery, up to {MyDayPhotoUploader.MaxPerBatch}. Each go adds to the last; they go onto the day's log.";

    private async Task AddAsync(InputFileChangeEventArgs change)
    {
        isReading = true;
        try { await Basket.AddAsync(change.GetMultipleFiles(MyDayPhotoUploader.MaxPerBatch), CancellationToken.None); }
        finally { isReading = false; }
        await OnChanged.InvokeAsync();
    }

    private Task Clear()
    {
        Basket.Clear();
        return OnChanged.InvokeAsync();
    }
}
