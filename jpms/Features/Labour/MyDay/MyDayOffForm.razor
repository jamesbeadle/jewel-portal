@namespace Jewel.JPMS.Features.Labour.MyDay
@inject ILabourStore Labour

<div class="space-y-3">
    <FormField Label="Why not on site today?" Required Hint="Rain, holiday, no works on site — a recorded day off is never a missing day." Error="@error">
        <textarea class="field" rows="3" @bind="description" placeholder="Rained off"></textarea>
    </FormField>
    <button type="button" class="btn-primary btn-lg w-full" disabled="@isBusy" @onclick="RecordAsync">
        @(isBusy ? "Recording…" : "Record day off")
    </button>
    <button type="button" class="btn-ghost btn-lg w-full" disabled="@isBusy" @onclick="() => OnCancel.InvokeAsync()">Back</button>
</div>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    [Parameter] public EventCallback OnCancel { get; set; }

    private string description = "";
    private bool isBusy;
    private string? error;

    private bool HasWords => !string.IsNullOrWhiteSpace(description);

    private async Task RecordAsync()
    {
        error = HasWords ? null : "Say why — the words are the day's record.";
        if (error is not null) return;
        isBusy = true;
        try
        {
            await Labour.MyDayOffAsync(ProjectId, description.Trim());
            await Labour.RefreshMyDayAsync();
        }
        catch (CommandFailedException refusal) { error = refusal.Message; }
        catch (Exception) { error = "That didn't go through — check your signal and try again."; }
        finally { isBusy = false; }
    }
}
