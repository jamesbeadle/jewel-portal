@namespace Jewel.JPMS.Features.Labour.MyDay

<FormField Label="What the work was" Required Hint="@(Hint ?? DefaultHint)">
    @if (RecentChips.Count > 0)
    {
        <FilterChips Items="RecentChips" Selected="@CostCode" OnSelect="PickAsync" AriaLabel="The codes you used last" Disabled="@Disabled" Large="true" Class="mb-2" />
    }
    <SearchSelect Options="Options" Value="@CostCode" ValueChanged="PickAsync" Placeholder="Search the cost codes…"
                  WidthClass="w-full" InputClass="field h-12 text-base" Disabled="@Disabled" />
</FormField>

@code {
    private const string CodeAndName = "{0} · {1}";
    private const string DefaultHint = "Type a word of the trade, or the code, to find it.";

    [Parameter, EditorRequired] public IReadOnlyList<SiteSheetCostCode> Codes { get; set; } = Array.Empty<SiteSheetCostCode>();
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = Array.Empty<string>();
    [Parameter] public string CostCode { get; set; } = "";
    [Parameter] public EventCallback<string> CostCodeChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Replaces the usual hint — the form says so when the code was suggested from the words.</summary>
    [Parameter] public string? Hint { get; set; }

    private IReadOnlyList<SearchSelect.Option> Options =>
        Codes.Select(code => new SearchSelect.Option(code.Code, string.Format(CodeAndName, code.Code, code.Name))).ToList();

    private IReadOnlyList<TabItem> RecentChips =>
        RecentCodes
            .Select(recent => Codes.FirstOrDefault(code => code.Code == recent))
            .Where(code => code is not null)
            .Select(code => new TabItem(code!.Code, code.Name))
            .ToList();

    private Task PickAsync(string code) => CostCodeChanged.InvokeAsync(code);
}
