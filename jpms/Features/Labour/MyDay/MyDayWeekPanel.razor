@namespace Jewel.JPMS.Features.Labour.MyDay

<Panel Title="This week" Class="mb-4" BodyClass="p-4" Prominent="false">
    @if (amending is { } day)
    {
        <MyDayAmendForm Day="day" Projects="Projects" RecentCodes="RecentCodes" OnDone="CloseAsync" />
    }
    else if (adding is { } missed)
    {
        <MyDayMissedDayForm Day="missed" Codes="CodesFor(missed)" RecentCodes="RecentCodes" OnDone="CloseAsync" />
    }
    else
    {
        @foreach (var row in Week)
        {
            <MyDayWeekRow Row="row" IsBeforeToday="@(row.Date < Today)" OnAmend="() => amending = row" OnAdd="() => adding = row" />
        }
        <p class="text-xs text-content-subtle mt-2">A day can be amended, or a missed one filled in, until the office has approved it. A day filed after the date is shown to the office as late.</p>
    }
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MyWeekDay> Week { get; set; } = Array.Empty<MyWeekDay>();
    [Parameter, EditorRequired] public IReadOnlyList<MyLabourProject> Projects { get; set; } = Array.Empty<MyLabourProject>();
    [Parameter, EditorRequired] public DateTimeOffset Today { get; set; }
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = Array.Empty<string>();

    private MyWeekDay? amending;
    private MyWeekDay? adding;

    private IReadOnlyList<SiteSheetCostCode> CodesFor(MyWeekDay day) =>
        Projects.FirstOrDefault(project => project.ProjectId == day.ProjectId)?.CostCodes ?? Array.Empty<SiteSheetCostCode>();

    private Task CloseAsync()
    {
        amending = null;
        adding = null;
        return Task.CompletedTask;
    }
}
