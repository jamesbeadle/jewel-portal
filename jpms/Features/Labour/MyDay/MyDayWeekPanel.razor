@namespace Jewel.JPMS.Features.Labour.MyDay

<Panel Title="This week" Class="mb-4" BodyClass="p-4" Prominent="false">
    @if (amending is { } day)
    {
        <MyDayAmendForm Day="day" Codes="CodesFor(day)" RecentCodes="RecentCodes" OnDone="CloseAsync" />
    }
    else
    {
        @foreach (var row in Week)
        {
            <div class="flex items-center justify-between gap-3 border-t border-line/60 py-1.5 text-sm">
                <span class="text-content-subtle min-w-0">
                    @row.Date.ToString(DayFormat) · @row.ProjectName
                    @if (row.IsLogged)
                    {
                        <span class="whitespace-nowrap"> · @row.CostCode</span>
                    }
                </span>
                <span class="shrink-0 whitespace-nowrap flex items-center gap-2">
                    @if (row.IsLogged)
                    {
                        <span class="text-content font-medium">@MyDayHoursText.Of(row.Hours)</span>
                        <StatusPill Status="@row.Status!.Value" />
                    }
                    @if (row.Kind == MyWeekDayKind.Off)
                    {
                        <Pill Tone="Tone.Muted">Off</Pill>
                    }
                    @if (row.Kind == MyWeekDayKind.Nothing)
                    {
                        <Pill Tone="Tone.Warning">Nothing</Pill>
                    }
                    @if (row.CanBeAmended)
                    {
                        <button type="button" class="btn-secondary" @onclick="() => amending = row">Amend</button>
                    }
                </span>
            </div>
        }
        <p class="text-xs text-content-subtle mt-2">A day can be amended until the office has approved it.</p>
    }
</Panel>

@code {
    private const string DayFormat = "ddd dd";

    [Parameter, EditorRequired] public IReadOnlyList<MyWeekDay> Week { get; set; } = Array.Empty<MyWeekDay>();
    [Parameter, EditorRequired] public IReadOnlyList<MyLabourProject> Projects { get; set; } = Array.Empty<MyLabourProject>();
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = Array.Empty<string>();

    private MyWeekDay? amending;

    private IReadOnlyList<SiteSheetCostCode> CodesFor(MyWeekDay day) =>
        Projects.FirstOrDefault(project => project.ProjectId == day.ProjectId)?.CostCodes ?? Array.Empty<SiteSheetCostCode>();

    private Task CloseAsync()
    {
        amending = null;
        return Task.CompletedTask;
    }
}
