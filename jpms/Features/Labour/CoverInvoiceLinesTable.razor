@namespace Jewel.JPMS.Features.Labour

<table class="data-table data-table-dense max-w-3xl">
    <thead>
        <tr>
            <th>Supplier</th><th>Date</th>
            <th>Description</th><th class="text-right">Net £</th>
            <th>Settles timesheets of</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var line in Lines)
        {
            <tr>
                <td class="text-content">@line.ContactName</td>
                <td class="text-content-subtle">@(line.Date?.ToString("dd MMM yy") ?? "—")</td>
                <td class="text-content-subtle truncate max-w-xs" title="@line.Description">@line.Description</td>
                <td class="text-right tabular-nums">@line.Net.ToString("N2")</td>
                <td>
                    <select class="field" @onchange="@(args => OnSettlesPicked.InvokeAsync((line.XeroLedgerLineId, (string)args.Value!)))">
                        <option value="">Subcontractor…</option>
                        @foreach (var subcontractor in Subcontractors)
                        {
                            <option value="@subcontractor.Id">@subcontractor.Name</option>
                        }
                    </select>
                </td>
                <td class="text-right">
                    <button type="button" class="btn-secondary" @onclick="() => OnMarkCovered.InvokeAsync(line)">Mark covered</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public IReadOnlyList<XeroLedgerLine> Lines { get; set; } = Array.Empty<XeroLedgerLine>();
    /// <summary>The subcontractor companies behind the project's workers — the "settles" choices.</summary>
    [Parameter] public IReadOnlyList<(string Id, string Name)> Subcontractors { get; set; } = Array.Empty<(string, string)>();
    /// <summary>A line's "settles timesheets of" pick: the line id and the chosen subcontractor id.</summary>
    [Parameter] public EventCallback<(string LineId, string SubcontractorId)> OnSettlesPicked { get; set; }
    [Parameter] public EventCallback<XeroLedgerLine> OnMarkCovered { get; set; }
}
