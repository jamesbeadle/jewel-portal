@using Jewel.JPMS.Contracts.WeeklyCashflow
@namespace Jewel.JPMS.Features.WeeklyCashflow
@using static Jewel.JPMS.Features.Cashflow.CashflowDisplay

@* The KPI strip. The movement tiles are everyone's; the bank-anchored tiles are the directors',
   mirroring the API's gate. Tiles keep their shape while loading: label stays, figure pulses. *@
<div class="grid gap-4 sm:grid-cols-2 @(IsDirector ?"lg:grid-cols-4" : "lg:grid-cols-3") mb-8">
    @if (IsDirector)
    {
        <StatTile Label="Cash in bank" IsLoading="@(Bank is null)">
            @if (!BankReady)
            {
                <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
            }
            else
            {
                <p class="text-2xl font-semibold text-content">@Money(Bank!.TotalCash)</p>
                <p class="text-xs text-content-subtle mt-1">Xero, as of @FetchedText</p>
            }
        </StatTile>
    }
    <StatTile Label="To pay this week" IsLoading="@(View is null)" LoadingLabel="Loading this week's payments"
                Title="Cash out planned for the current week — bills and manual items placed (or due) this week.">
        <p class="text-2xl font-semibold text-content">@Money(View!.CashOut[0])</p>
        <p class="text-xs text-content-subtle mt-1">incl. everything overdue</p>
    </StatTile>
    @if (IsDirector)
    {
        <StatTile Label="Lowest week" IsLoading="@(View is null || Bank is null)" LoadingLabel="Loading the lowest week"
                    Title="The running bank balance's low point across the visible weeks — the week to plan for.">
            @if (View!.Closing is null)
            {
                <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
            }
            else
            {
                var low = View.Closing[View.MinClosingIndex];
                <p class="text-2xl font-semibold @(low < 0m ?"text-negative" : "text-content")">@Money(low)</p>
                <p class="text-xs text-content-subtle mt-1">@WeekLabel(View.WeekStarts[View.MinClosingIndex], View.MinClosingIndex)</p>
            }
        </StatTile>
        <StatTile Label="Balance at horizon end" IsLoading="@(View is null || Bank is null)" LoadingLabel="Loading the horizon-end balance"
                    Title="The running bank balance after the last visible week. Entries in Later are beyond the horizon and not yet counted.">
            @if (View!.Closing is null)
            {
                <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
            }
            else
            {
                var horizonEnd = View.Closing[^1];
                <p class="text-2xl font-semibold @(horizonEnd < 0m ?"text-negative" : "text-content")">@Money(horizonEnd)</p>
                <p class="text-xs text-content-subtle mt-1">after @WeekLabel(View.WeekStarts[^1], View.WeekStarts.Count - 1)</p>
            }
        </StatTile>
    }
    else
    {
        <StatTile Label="@($"Cash out, {WeeklyCashflowMaths.DefaultWeekCount} weeks")" IsLoading="@(View is null)" LoadingLabel="Loading cash out">
            <p class="text-2xl font-semibold text-content">@Money(VisibleTotal(View!.CashOut))</p>
            <p class="text-xs text-content-subtle mt-1">bills and manual items in the visible weeks</p>
        </StatTile>
        <StatTile Label="@($"Cash in, {WeeklyCashflowMaths.DefaultWeekCount} weeks")" IsLoading="@(View is null)" LoadingLabel="Loading cash in">
            <p class="text-2xl font-semibold text-content">@Money(VisibleTotal(View!.CashIn))</p>
            <p class="text-xs text-content-subtle mt-1">outstanding invoices due in the visible weeks</p>
        </StatTile>
    }
</div>

@code {
    [Parameter] public bool IsDirector { get; set; }
    /// <summary>The Xero bank position — null until the store has answered; directors only.</summary>
    [Parameter] public XeroCashSummarySnapshot? Bank { get; set; }
    [Parameter] public bool BankReady { get; set; }
    /// <summary>The grid as built this render — null until every source has landed.</summary>
    [Parameter] public WeeklyCashflowView? View { get; set; }
    [Parameter] public string FetchedText { get; set; } = "—";

    /// <summary>The visible weeks' total — the Later column, always last, left out.</summary>
    private static decimal VisibleTotal(IReadOnlyList<decimal> totals) =>
        totals.Take(totals.Count - 1).Sum();
}
