@using Jewel.JPMS.Contracts.WeeklyCashflow
@namespace Jewel.JPMS.Features.WeeklyCashflow
@using static Jewel.JPMS.Features.Cashflow.CashflowDisplay

@* The weekly grid: one column per week, the two Xero bands, a band per manual category in play
   and the standing Add item row, with the running answer — net movement, and for directors the
   closing bank balance — at BOTH ends (Nigel, 2026-09-21: a long grid reads its answer at the
   head without scrolling past every band; the Excel export keeps its single set at the foot).
   The page owns the moves, the exclusions and the dialogs; every band reads the same page state
   and reports to the same page handlers, so Band wires a section once and SummaryRows the pair. *@
<RecordsTable MaxHeight="" Class="mb-6">
    <thead>
        <tr>
            <th class="min-w-[260px]"></th>
            @for (var index = 0; index < View.WeekStarts.Count; index++)
            {
                <th class="text-right whitespace-nowrap">@WeekLabel(View.WeekStarts[index], index)</th>
            }
            <th class="text-right whitespace-nowrap border-l"
                title="Due beyond the visible weeks. Entries here roll into view as the weeks advance.">Later</th>
        </tr>
    </thead>
    <tbody>
        @SummaryRows
        <tr>
            <td colspan="@(View.WeekStarts.Count + 2)" class="eyebrow">Cash in</td>
        </tr>
        @Band(WeeklyCashflowBand.ClientReceipts, "Client invoices outstanding",
              "one line per outstanding sales invoice in Xero, at its due week — or at the Expected date when one is set in Xero",
              Array.Empty<GroupSlice>())
        <tr>
            <td colspan="@(View.WeekStarts.Count + 2)" class="eyebrow">Cash out</td>
        </tr>
        @Band(WeeklyCashflowBand.SupplierBills, "Supplier bills",
              "one line per outstanding bill in Xero — drafts included, as Aged Payables counts them; a Planned date set in Xero picks the week",
              SupplierGroups)
        @foreach (var category in WeeklyCashflowCategories.All.Where(HasLiveItems))
        {
            @Band(WeeklyCashflowMaths.BandFor(category), WeeklyCashflowCategories.BandLabel(category), "manual items — added on this page", Array.Empty<GroupSlice>())
        }
        <CashflowAddItemRow WeekCellCount="View.WeekStarts.Count + 1" OnAddItem="OnAddItem" />
        @SummaryRows
    </tbody>
</RecordsTable>

@code {
    [Parameter, EditorRequired] public WeeklyCashflowView View { get; set; } = default!;
    /// <summary>The bank-anchored row is the directors' — mirroring the API's gate.</summary>
    [Parameter] public bool IsDirector { get; set; }
    [Parameter, EditorRequired] public IReadOnlyCollection<WeeklyCashflowBand> CollapsedBands { get; set; } = default!;
    [Parameter] public EventCallback<WeeklyCashflowBand> OnToggleBand { get; set; }

    /// <summary>The supplier groups as they land on this grid — the Supplier bills band's combined rows.</summary>
    [Parameter] public IReadOnlyList<GroupSlice> SupplierGroups { get; set; } = Array.Empty<GroupSlice>();
    [Parameter] public IReadOnlyCollection<string> ExpandedGroups { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyCollection<string> MovingGroupIds { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnToggleGroup { get; set; }
    [Parameter] public EventCallback<(GroupSlice Slice, int CellIndex)> OnResetGroupCell { get; set; }
    [Parameter] public EventCallback<(GroupSlice Slice, int FromWeek, int ToWeek)> OnMoveGroupCell { get; set; }

    [Parameter] public IReadOnlyList<WeeklyCashflowSeed> ExcludedSeeds { get; set; } = Array.Empty<WeeklyCashflowSeed>();
    [Parameter, EditorRequired] public Func<string, string?> ExcludedByFor { get; set; } = default!;
    [Parameter] public IReadOnlyCollection<string> MovingKeys { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyCollection<string> ExcludingKeys { get; set; } = Array.Empty<string>();

    [Parameter] public EventCallback<string> OnEdit { get; set; }
    [Parameter] public EventCallback<WeeklyCashflowEntry> OnExclude { get; set; }
    [Parameter] public EventCallback<string> OnRestore { get; set; }
    [Parameter] public EventCallback<WeeklyCashflowEntry> OnReset { get; set; }
    [Parameter] public EventCallback<(WeeklyCashflowEntry Entry, int ToWeek)> OnMove { get; set; }
    [Parameter] public EventCallback OnAddItem { get; set; }

    // The running answer, drawn at the head and the foot from the one view the page computed:
    // net movement for everyone, the bank-anchored closing balance for directors alone.
    private RenderFragment SummaryRows => __builder =>
    {
        <WeeklyNetMovementRow View="View" />
        @if (IsDirector && View.Closing is not null)
        {
            <WeeklyClosingBalanceRow View="View" />
        }
    };

    private bool HasLiveItems(WeeklyCashflowCategory category) => View.Entries.Any(entry => entry.Band == WeeklyCashflowMaths.BandFor(category));

    private RenderFragment Band(WeeklyCashflowBand band, string label, string sub, IReadOnlyList<GroupSlice> groups) => __builder =>
    {
        <CashflowBandSection View="View" Band="band" Label="@label" Sub="@sub"
                             Expanded="@(!CollapsedBands.Contains(band))" OnToggle="OnToggleBand"
                             Groups="groups" ExpandedGroups="ExpandedGroups" MovingGroupIds="MovingGroupIds"
                             OnToggleGroup="OnToggleGroup" OnResetGroupCell="OnResetGroupCell" OnMoveGroupCell="OnMoveGroupCell"
                             ExcludedSeeds="ExcludedSeeds" ExcludedByFor="ExcludedByFor"
                             MovingKeys="MovingKeys" ExcludingKeys="ExcludingKeys"
                             OnEdit="OnEdit" OnExclude="OnExclude" OnRestore="OnRestore" OnReset="OnReset" OnMove="OnMove" />
    };
}
