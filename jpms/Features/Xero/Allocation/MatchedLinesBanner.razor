@namespace Jewel.JPMS.Features.Xero

@* The one-shot offer over the plain queue: lines whose Xero tracking matched both a project
   and a cost centre can be allocated together. Armed-then-confirmed, and the arming lives
   here — nothing else on the page cares whether the offer is armed. *@
<div class="mb-4 rounded-xl border border-line bg-surface-raised px-4 py-3 flex items-center gap-3 flex-wrap text-sm">
    <span class="text-content-muted">
        <span class="text-content font-medium">@Count lines</span> have both a project and a
        cost centre matched from their Xero tracking.
    </span>
    @if (!armed)
    {
        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                disabled="@Busy" @onclick="() => armed = true">
            Allocate all matched…
        </button>
    }
    else
    {
        <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
                disabled="@Busy" @onclick="ConfirmAsync">
            @(Busy ? "Allocating…" : $"Confirm — allocate {Count} lines")
        </button>
        <button class="text-xs text-content-subtle underline underline-offset-4"
                @onclick="() => armed = false">Cancel</button>
    }
    <span class="text-xs text-content-subtle">Noted as auto-matched; each line stays reversible via Undo.</span>
</div>

@code {
    /// <summary>How many lines the one-shot would allocate.</summary>
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Busy { get; set; }
    /// <summary>Runs the server's allocate-all-suggested one-shot.</summary>
    [Parameter] public EventCallback OnAllocate { get; set; }

    private bool armed;

    private async Task ConfirmAsync()
    {
        armed = false;
        await OnAllocate.InvokeAsync();
    }
}
