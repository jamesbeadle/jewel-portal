@namespace Jewel.JPMS.Features.Xero

<BulkSelectionBar Count="Count" OnClear="OnClear">
    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
            disabled="@Busy" @onclick="() => OnSendToCostCentre.InvokeAsync()">Send to cost centre…</button>
    <button class="text-sm font-medium rounded-lg px-3 py-1.5 bg-content text-surface disabled:opacity-50"
            title="Move the selected lines to another project — each keeps its cost centre, and the Xero site is rewritten"
            disabled="@Busy" @onclick="() => OnSendToProject.InvokeAsync()">Send to project…</button>
    <button class="btn-secondary"
            title="Return the selected lines to the unallocated queue"
            disabled="@Busy" @onclick="() => OnUndo.InvokeAsync()">Undo selected</button>
</BulkSelectionBar>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnSendToCostCentre { get; set; }
    [Parameter] public EventCallback OnSendToProject { get; set; }
    [Parameter] public EventCallback OnUndo { get; set; }
}
