@namespace Jewel.JPMS.Features.Xero

<BulkSelectionBar Count="Count" OnClear="OnClear">
    <SearchSelect Options="@ProjectOptions" WidthClass="w-44" Placeholder="Project…"
                  Value="@ProjectId" ValueChanged="ProjectIdChanged" />
    <SearchSelect Options="@CostCenterOptions" WidthClass="w-52" Placeholder="Cost centre…"
                  Value="@CostCenterCode" ValueChanged="CostCenterCodeChanged" />
    <button class="text-sm font-medium rounded px-3 py-1.5 bg-content text-surface disabled:opacity-50"
            disabled="@(Busy || string.IsNullOrEmpty(ProjectId) || string.IsNullOrEmpty(CostCenterCode))"
            @onclick="() => OnAllocate.InvokeAsync()">Allocate selected</button>
    <button class="btn-secondary"
            title="Save the project and set its Xero site on every selected line — moves them to that project's tab, cost centres to follow"
            disabled="@(Busy || string.IsNullOrEmpty(ProjectId))"
            @onclick="() => OnSetProject.InvokeAsync()">Set selected</button>
    <span class="text-content-subtle">·</span>
    <select class="field"
            value="@Bucket" @onchange="e => BucketChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)">
        <option value="">Bucket…</option>
        @foreach (var bucket in XeroBuckets.All)
        {
            <option value="@bucket">@bucket</option>
        }
    </select>
    <button class="btn-secondary"
            disabled="@(Busy || string.IsNullOrEmpty(Bucket))" @onclick="() => OnBucket.InvokeAsync()">Bucket selected</button>
    <button class="btn-secondary"
            disabled="@Busy" @onclick="() => OnIgnore.InvokeAsync()">Ignore selected</button>
</BulkSelectionBar>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public IReadOnlyList<SearchSelect.Option> ProjectOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    [Parameter] public IReadOnlyList<SearchSelect.Option> CostCenterOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    /// <summary>Page-owned picks — the bulk commands read them when they fire.</summary>
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public EventCallback<string> ProjectIdChanged { get; set; }
    [Parameter] public string CostCenterCode { get; set; } = "";
    [Parameter] public EventCallback<string> CostCenterCodeChanged { get; set; }
    [Parameter] public string Bucket { get; set; } = "";
    [Parameter] public EventCallback<string> BucketChanged { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnAllocate { get; set; }
    [Parameter] public EventCallback OnSetProject { get; set; }
    [Parameter] public EventCallback OnBucket { get; set; }
    [Parameter] public EventCallback OnIgnore { get; set; }
}
