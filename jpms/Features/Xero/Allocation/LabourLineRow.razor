@namespace Jewel.JPMS.Features.Xero
@using static Jewel.JPMS.Features.Xero.XeroLedgerDisplay

@* One labour-recognised line (scope §6): settlement of timesheets, not a cost to allocate.
   The row shows the matched worker — with the inline settlement-identity fix (2026-08-31)
   when the worker has no linked company — and marks the bill against its month. *@
<tr>
    <td class="px-3 py-2.5">
        <input type="checkbox" checked="@Selected" @onchange="() => OnToggleSelected.InvokeAsync()" />
    </td>
    <LedgerLineIdentityCell Line="Line" OnOpenInvoice="OnOpenInvoice" />
    <td class="px-3 py-2.5 text-right text-content font-medium whitespace-nowrap align-top">@Money(SignedNet(Line))</td>
    <td class="px-3 py-2.5 align-top">
        @if (Line.MatchedWorkerName is not null)
        {
            <span class="text-content font-medium whitespace-nowrap">@Line.MatchedWorkerName</span>
            @if (Line.MatchedSubcontractorId is null)
            {
                @* The month-end doc's exact dead end (2026-08-31): the gap
                   used to be reported here and fixable only on the Workers
                   page, one modal at a time. The fix now lives where the
                   error is: link a directory company inline, or flag the
                   worker a sole trader — both audited, both re-checked
                   against the ledger immediately. *@
                <span class="block text-xs text-negative mt-0.5"
                      title="Covering reconciles by settlement counterparty: a linked subcontractor company, or the worker themself when flagged a sole trader.">
                    ⚠ No settlement identity
                </span>
                <div class="flex items-center gap-1.5 mt-1.5">
                    <SearchSelect Options="@DirectoryOptions" WidthClass="w-44"
                                  Placeholder="Link company…"
                                  Disabled="@(Busy || !DirectoryLoaded)"
                                  Value="@LinkPick"
                                  ValueChanged="value => OnLinkPickChanged.InvokeAsync(value)" />
                    <button class="btn-secondary"
                            disabled="@(Busy || LinkPick == "")"
                            title="Link the worker to the picked directory company — audited; settlement then reconciles through it"
                            @onclick="() => OnLinkWorker.InvokeAsync()">Link</button>
                    <button class="btn-secondary"
                            disabled="@Busy"
                            title="They bill under their own name — becomes their own settlement counterparty; no directory company is created"
                            @onclick="() => OnMarkSoleTrader.InvokeAsync()">Sole trader</button>
                </div>
            }
        }
        else
        {
            @* Covered, but the supplier no longer matches anyone on the
               registry (worker renamed or deactivated). The cover stands;
               only re-marking would need a match. *@
            <span class="text-xs text-content-subtle">No current registry match</span>
        }
    </td>
    <td class="px-3 py-2.5 text-right whitespace-nowrap align-top">
        @if (Line.CoveredByTimesheets)
        {
            <Pill Tone="Tone.Muted" Class="align-middle" Title="Marked as settlement — the covered value is excluded from cost-of-sales aggregations; the worker-month verdict lives on the Labour overview's Settlement view">
                Covered · @(Line.CoveredPeriodStart?.ToString("MMM yyyy") ?? "")
            </Pill>
            <button class="btn-secondary ml-2 align-middle"
                    title="Remove the settlement mark — the line goes back to the outstanding labour list"
                    disabled="@Busy" @onclick="() => OnUnmarkCover.InvokeAsync()">Un-mark</button>
        }
        else
        {
            <button class="text-xs font-medium rounded px-2.5 py-1 bg-content text-surface disabled:opacity-40 align-middle"
                    title="@MarkCoverHint(Line)"
                    disabled="@(Busy || !CanMarkCover(Line))"
                    @onclick="() => OnMarkCover.InvokeAsync()">Mark as settlement@(SettlementMonthOf(Line) is { } month ? $" · {month:MMM yyyy}" : "")</button>
        }
        <DropdownMenu Label="More" WidthClass="w-72" Disabled="@Busy"
                      ToggleClass="inline-flex items-center gap-1 rounded border border-line bg-surface px-2.5 py-1 text-xs text-content-muted hover:text-content transition"
                      Class="inline-block text-left ml-2 align-middle whitespace-normal"
                      Items="MenuItems"
                      OnOpenChanged="open => OnMenuOpenChanged.InvokeAsync(open)" />
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public XeroLedgerLine Line { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnToggleSelected { get; set; }
    [Parameter] public EventCallback<XeroLedgerLine> OnOpenInvoice { get; set; }
    [Parameter] public bool Busy { get; set; }

    /// <summary>The inline settlement-identity fix: the directory pick and its two actions.</summary>
    [Parameter] public IReadOnlyList<SearchSelect.Option> DirectoryOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    [Parameter] public bool DirectoryLoaded { get; set; }
    [Parameter] public string LinkPick { get; set; } = "";
    [Parameter] public EventCallback<string> OnLinkPickChanged { get; set; }
    [Parameter] public EventCallback OnLinkWorker { get; set; }
    [Parameter] public EventCallback OnMarkSoleTrader { get; set; }

    [Parameter] public EventCallback OnMarkCover { get; set; }
    [Parameter] public EventCallback OnUnmarkCover { get; set; }

    /// <summary>The row's More menu (Not labour, Ignore, Dispute) — built by the page.</summary>
    [Parameter] public IReadOnlyList<DropdownMenu.Item> MenuItems { get; set; } = Array.Empty<DropdownMenu.Item>();
    /// <summary>The page lifts the table's overflow cap while a row menu is open.</summary>
    [Parameter] public EventCallback<bool> OnMenuOpenChanged { get; set; }
}
