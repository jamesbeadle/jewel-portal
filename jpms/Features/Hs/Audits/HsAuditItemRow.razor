@namespace Jewel.JPMS.Features.Hs.Audits
@using Jewel.JPMS.Contracts.Hs

<tr class="@(Draft.IsDirty ? "bg-surface-raised/50" : "")">
    <td class="font-mono text-xs whitespace-nowrap">@Draft.Code</td>
    <td class="text-content">
        @Draft.Name
        @if (Draft.HsRecordId is not null)
        {
            <Pill Tone="Tone.Info" Class="ml-2" Title="A corrective action is on the register for this item">Action</Pill>
        }
    </td>
    <td>
        <HsAuditKeySelect TKey="HsAuditComment" Value="@Draft.Comment" ValueChanged="comment => Score(() => Draft.Comment = comment)"
                          Code="comment => comment.Code()" Describe="comment => comment.DisplayName()" Disabled="@ReadOnly" />
    </td>
    <td>
        <HsAuditKeySelect TKey="HsAuditRate" Value="@Draft.Rate" ValueChanged="rate => Score(() => Draft.Rate = rate)"
                          Code="HsAuditItemEdits.Rate" Describe="rate => rate.DisplayName()" Disabled="@ReadOnly" />
    </td>
    <td>
        <HsAuditKeySelect TKey="HsAuditClass" Value="@Draft.Class" ValueChanged="hsAuditClass => Score(() => Draft.Class = hsAuditClass)"
                          Code="hsAuditClass => hsAuditClass.Letter()" Describe="hsAuditClass => hsAuditClass.DisplayName()" Disabled="@ReadOnly" />
    </td>
    <td class="text-right text-content-subtle">@Draft.PointsOffText</td>
    <td>
        <HsAuditKeySelect TKey="HsAuditTimeScale" Value="@Draft.TimeScale" ValueChanged="timeScale => Draft.TimeScale = timeScale"
                          Code="timeScale => timeScale.Code()" Describe="timeScale => timeScale.DisplayName()" Disabled="@ReadOnly" />
    </td>
    <td>
        <input type="text" class="field py-1 w-full" disabled="@ReadOnly"
               value="@Draft.Findings" @oninput="e => Draft.Findings = e.Value?.ToString() ?? string.Empty" />
    </td>
    <td>
        <input type="text" class="field py-1 w-full" maxlength="@StoredTextLengths.Name" disabled="@ReadOnly" placeholder="Name"
               value="@Draft.OwnerName" @oninput="e => Draft.OwnerName = e.Value?.ToString() ?? string.Empty" />
    </td>
    <td>
        <input type="date" class="field py-1" disabled="@ReadOnly"
               value="@HsAuditItemEdits.DateInput(Draft.DateRectified)" @onchange="e => Draft.DateRectified = HsAuditItemEdits.ParseDate(e)" />
    </td>
</tr>

@code {
    [Parameter, EditorRequired] public HsAuditItemDraft Draft { get; set; } = default!;
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Raised after an edit that moves the score, so the page's live chip follows.</summary>
    [Parameter] public EventCallback OnScoreChanged { get; set; }

    private Task Score(Action change)
    {
        change();
        return OnScoreChanged.InvokeAsync();
    }
}
