@namespace Jewel.JPMS.Features.Hs.Audits
@using Jewel.JPMS.Contracts.Hs

@*
    One section of the framework on the audit form — the spreadsheet's block of rows, each with
    the officer's comment code, rate, class, minus, time-scale, findings, owner and date rectified.
    From md up it is the sheet's table; on a phone, where the officer fills it in on site, each
    item is a card and the section's Save sits under the last one. Edits live on the drafts until
    "Save section" sends the dirty rows; the page owns the drafts so the score chip can read every
    section at once.
*@

<Panel Title="@($"{Section.Number}. {Section.Name}")" BodyClass="p-0" Class="mb-5">
    <HeaderActions>
        @if (!ReadOnly)
        {
            <button type="button" class="btn-secondary" disabled="@(!HasChanges || Busy)" @onclick="SaveAsync">@SaveLabel</button>
        }
    </HeaderActions>
    <ChildContent>
        <div class="hidden md:block overflow-x-auto">
            <table class="data-table data-table-dense min-w-[1100px]">
                <thead>
                    <tr>
                        <th class="w-16">Code</th>
                        <th>Item</th>
                        <th class="w-28">Comment</th>
                        <th class="w-24">Rate</th>
                        <th class="w-20">Class</th>
                        <th class="w-20 text-right" title="Points the class and a repeat take off, as the sheet prints them — the score deducts each class once">Pts off</th>
                        <th class="w-28">Time-scale</th>
                        <th>Findings / advice given</th>
                        <th class="w-36">Owner</th>
                        <th class="w-36">Rectified</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var draft in Drafts)
                    {
                        <HsAuditItemRow @key="draft.HsAuditItemId" Draft="draft" ReadOnly="@ReadOnly" OnScoreChanged="OnScoreChanged" />
                    }
                </tbody>
            </table>
        </div>
        <div class="md:hidden">
            @foreach (var draft in Drafts)
            {
                <HsAuditItemCard @key="draft.HsAuditItemId" Draft="draft" ReadOnly="@ReadOnly" OnScoreChanged="OnScoreChanged" />
            }
            @if (!ReadOnly)
            {
                <div class="px-4 py-3 border-t border-line bg-surface-raised">
                    <button type="button" class="btn-secondary w-full" disabled="@(!HasChanges || Busy)" @onclick="SaveAsync">@SaveLabel</button>
                </div>
            }
        </div>
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired] public HsAuditTemplateSection Section { get; set; } = new(0, "");
    [Parameter, EditorRequired] public IReadOnlyList<HsAuditItemDraft> Drafts { get; set; } = Array.Empty<HsAuditItemDraft>();
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<HsAuditItemEntry>> OnSave { get; set; }
    /// <summary>Raised after an edit that moves the score, so the page's live chip follows.</summary>
    [Parameter] public EventCallback OnScoreChanged { get; set; }

    private int DirtyCount => Drafts.Count(draft => draft.IsDirty);
    private bool HasChanges => DirtyCount > 0;
    private string SaveLabel => HasChanges ? $"Save section ({DirtyCount})" : "Saved";

    private Task SaveAsync() =>
        OnSave.InvokeAsync(Drafts.Where(draft => draft.IsDirty).Select(draft => draft.ToEntry()).ToList());
}
