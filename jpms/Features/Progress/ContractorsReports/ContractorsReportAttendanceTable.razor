@using Jewel.JPMS.Contracts.Progress

@* Section 8: the work orders on site come from the register; the days on site and the
   client-nominated flag are what a person keys against each, with the scope as the report words
   it — what they did this week (blank prints the order's title). Only an order given days on
   site prints in the report, as Subcontractor / Scope — the rest stay here, never on the document. *@

<RecordsTable IsEmpty="@(Subcontractors.Count == 0)" EmptyMessage="No work orders are on site this week." Dense>
    <thead>
        <tr>
            <th>Order</th>
            <th>Supplier</th>
            <th>Scope this week</th>
            <th class="text-right w-28">Days on site</th>
            <th class="w-36">Client nominated</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var subcontractor in Subcontractors)
        {
            var line = Draft.AttendanceFor(subcontractor.WorkOrderId);
            <tr>
                <td class="font-medium">@subcontractor.Reference</td>
                <td>@subcontractor.Supplier</td>
                <td>
                    <input class="field" maxlength="1000" value="@line.Scope" placeholder="@subcontractor.WorkOrderTitle" title="@subcontractor.WorkOrderTitle"
                           @onchange="e => line.Scope = e.Value?.ToString() ?? string.Empty" />
                </td>
                <td class="text-right">
                    <input type="number" min="0" max="7" class="field text-right" value="@line.AttendanceDays"
                           @onchange="e => line.AttendanceDays = int.TryParse(e.Value?.ToString(), out var days) ? days : null" />
                </td>
                <td><Checkbox Value="@line.IsClientNominated" ValueChanged="value => line.IsClientNominated = value" /></td>
            </tr>
        }
    </tbody>
</RecordsTable>

@code {
    [Parameter, EditorRequired] public ContractorsReportDraft Draft { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ContractorsReportSubcontractor> Subcontractors { get; set; } = Array.Empty<ContractorsReportSubcontractor>();
}
