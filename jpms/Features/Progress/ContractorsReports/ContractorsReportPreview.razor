@using Jewel.JPMS.Contracts.Progress

@* The document as it will print, read from the SAME composition the PDF build uses —
   so the page never shows one thing and the file another. Register-read sections are shown as
   read; the entered ones show what was last SAVED. *@

<div class="space-y-5 text-sm">
    <ContractorsReportPreviewProgress Document="Document" />
    <section>
        <h3 class="font-semibold text-content mb-2">2. Look Ahead — Next Two Weeks</h3>
        @if (!Document.LookAhead.Any(item => !item.IsDone))
        {
            <p class="text-content-subtle italic">No items are planned for the coming week.</p>
        }
        <ul class="list-disc pl-5 text-content-muted">
            @foreach (var item in Document.LookAhead.Where(item => !item.IsDone))
            {
                <li>@item.Text</li>
            }
        </ul>
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">3. Decisions / Instructions Needed</h3>
        @if (Document.Decisions.Count == 0)
        {
            <p class="text-content-subtle italic">No decisions or instructions are outstanding.</p>
        }
        @if (Document.Decisions.Count > 0)
        {
            <p class="text-content-muted mb-1">@ContractorsReportPrintedText.DecisionsOpening</p>
        }
        @foreach (var decision in Document.Decisions)
        {
            <p class="text-content-muted"><span class="font-medium text-content">@ContractorsReportPrintedText.DecisionRow(decision)</span> · @ContractorsReportPrintedText.DecisionStatus(decision, Document.Header.DateOfIssue)</p>
        }
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">4. Variations</h3>
        @if (Document.Variations.Count == 0)
        {
            <p class="text-content-subtle italic">@ContractorsReportVariationWording.NothingOutstanding(Document)</p>
        }
        @if (Document.Variations.Count > 0)
        {
            <p class="text-content-muted mb-1">@ContractorsReportVariationWording.Paragraph(Document)</p>
        }
        @foreach (var variation in Document.Variations)
        {
            <p class="text-content-muted"><span class="font-medium text-content">@ContractorsReportVariationWording.Row(variation)</span> · @ContractorsReportVariationWording.Position(variation)</p>
        }
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">5. Neighbours</h3>
        <p class="whitespace-pre-line text-content-muted">@Shown(Document.Neighbours)</p>
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">6. Health &amp; Safety</h3>
        <p class="whitespace-pre-line text-content-muted">@Shown(Document.HealthAndSafety)</p>
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">7. Building Control</h3>
        @if (Document.BuildingControl.HasCase())
        {
            <p class="text-content-muted">@(Document.BuildingControl.BodyName ?? "—") · @(Document.BuildingControl.ContactName ?? "—") · @(Document.BuildingControl.ContactEmail ?? "—") · @(Document.BuildingControl.ContactPhone ?? "—")</p>
        }
        @if (!Document.BuildingControl.HasCase())
        {
            <p class="text-content-muted">Building Control Contact: @(Document.BuildingControl.EnteredContact ?? "—")</p>
        }
        <p class="whitespace-pre-line text-content-muted">@Shown(Document.BuildingControl.Liaison)</p>
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">8. Specialist Subcontractors</h3>
        @if (Document.Subcontractors.Count == 0)
        {
            <p class="text-content-subtle italic">No specialist subcontractors were on site this week.</p>
        }
        @foreach (var subcontractor in Document.Subcontractors)
        {
            <p class="text-content-muted"><span class="font-medium text-content">@subcontractor.Supplier</span> · @subcontractor.Scope · @ContractorsReportPrintedText.DaysOnSite(subcontractor)</p>
        }
    </section>
    <section>
        <h3 class="font-semibold text-content mb-2">9. Site Photographs</h3>
        @if (!Document.Progress.Any(day => day.Photos.Count > 0))
        {
            <p class="text-content-subtle italic">Nothing to report.</p>
        }
        @foreach (var day in Document.Progress.Where(day => day.Photos.Count > 0))
        {
            <p class="text-xs font-semibold text-accent">@ContractorsReportPrintedText.PhotoDayHeading(day)</p>
        }
    </section>
</div>

@code {
    [Parameter, EditorRequired] public ContractorsReportDocument Document { get; set; } = default!;

    private static string Shown(string text) => string.IsNullOrWhiteSpace(text) ? "Nothing to report." : text;
}
