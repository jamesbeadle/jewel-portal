@using Jewel.JPMS.Contracts.Progress

@*
    The review screen: the days the week holds and what each becomes, the messages nobody has
    attributed, the photographs that appeared twice, and what was set aside. A day already
    carrying an update arrives unticked — re-running a week never duplicates it.
*@

<div class="mt-6 space-y-5">
    @foreach (var note in Preview.Notes)
    {
        <Notice Tone="Tone.Info">@note</Notice>
    }

    <SectionHeader Title="@($"Friday {Preview.WeekStart:d MMMM} to Thursday {Preview.WeekEnd:d MMMM yyyy}")" />
    <p class="text-sm text-content-muted">
        @Preview.Days.Count day@(Preview.Days.Count == 1 ? "" : "s") with messages for this project
        · @Preview.OtherSiteMessageCount from other sites left out@(Preview.OtherSiteSenders.Count > 0 ? $" ({string.Join(", ", Preview.OtherSiteSenders)})" : "")
        · @Preview.MessagesOutsideWeek outside the week ignored
    </p>

    <RecordsTable Dense="true" MaxHeight="" IsLoading="false" IsEmpty="@(Preview.Days.Count == 0)"
                  EmptyMessage="No messages from this project's senders fell in the week.">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="w-10"></th>
                    <th class="text-left">Day</th>
                    <th class="text-right">Messages</th>
                    <th class="text-right">Photos</th>
                    <th class="text-left">Notes as they will read</th>
                    <th class="text-left">Already on the feed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var day in Preview.Days)
                {
                    <tr>
                        <td><input type="checkbox" checked="@TickedDays.Contains(day.Date)" @onchange="e => Toggle(day.Date, e)" /></td>
                        <td class="whitespace-nowrap">@day.Date.ToString("ddd d MMM")</td>
                        <td class="text-right">@day.MessageCount</td>
                        <td class="text-right">@day.PhotoFileNames.Count</td>
                        <td><pre class="whitespace-pre-wrap text-xs font-sans max-w-xl">@Clip(day.Description)</pre></td>
                        <td class="text-warning">@string.Join("; ", day.ExistingUpdateTitles)</td>
                    </tr>
                }
            </tbody>
        </table>
    </RecordsTable>

    <WhatsAppUnattributedMessages Messages="Preview.Unattributed" />

    @if (Preview.RepeatedPhotos.Count > 0)
    {
        <Notice Tone="Tone.Info">
            @Preview.RepeatedPhotos.Count photograph@(Preview.RepeatedPhotos.Count == 1 ? "" : "s") appeared on more than one day and will be kept on the first:
            @string.Join("; ", Preview.RepeatedPhotos.Select(photo => $"{photo.FileName} on {photo.KeptOn:ddd d MMM} (also {string.Join(", ", photo.DroppedFrom.Select(day => day.ToString("ddd d MMM")))})"))
        </Notice>
    }

    @if (Preview.MissingMediaFileNames.Count > 0)
    {
        <Notice Tone="Tone.Warning">
            @Preview.MissingMediaFileNames.Count file@(Preview.MissingMediaFileNames.Count == 1 ? "" : "s") the chat refers to are not in the export: @string.Join(", ", Preview.MissingMediaFileNames.Take(10))@(Preview.MissingMediaFileNames.Count > 10 ? "…" : "")
        </Notice>
    }
</div>

@code {
    private const int ClipLength = 600;

    [Parameter] public WhatsAppWeekPreview Preview { get; set; } = default!;
    [Parameter] public HashSet<DateOnly> TickedDays { get; set; } = new();
    [Parameter] public EventCallback OnTickedChanged { get; set; }

    private Task Toggle(DateOnly day, ChangeEventArgs e)
    {
        var isTicked = e.Value is bool ticked && ticked;
        if (isTicked) TickedDays.Add(day); else TickedDays.Remove(day);
        return OnTickedChanged.InvokeAsync();
    }

    private static string Clip(string text) =>
        text.Length <= ClipLength ? text : text[..ClipLength] + "…";
}
