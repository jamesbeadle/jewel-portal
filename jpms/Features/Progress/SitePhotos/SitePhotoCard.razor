@namespace Jewel.JPMS.Features.Progress.SitePhotos
@using Jewel.JPMS.Contracts.Progress

@*
    One pool photograph: the thumbnail (click opens the viewer), the file name, and its standing —
    an unfiled photo is the working row; a filed one is dimmed and says which update took it; an
    archived one (left out of the report by the weekly run) is dimmed with its reason and can be
    restored. Delete is the two-click InlineConfirm; a filed photo's copy on its update is not touched.
*@

<div class="group flex flex-col rounded border border-line bg-surface @(Photo.IsWaiting ? "" : "opacity-70")">
    <button type="button" class="block" @onclick="OnOpen" title="@Photo.FileName">
        <img src="@($"/api/site-photos/{Photo.SitePhotoId}/file?inline=1")" alt="@Photo.FileName" loading="lazy"
             class="h-32 w-full object-cover rounded-t" />
    </button>
    <div class="flex flex-col gap-1 p-2">
        <span class="truncate text-xs text-content" title="@Photo.FileName">@Photo.FileName</span>
        <span class="text-xs text-content-subtle">
            @if (Photo.IsFiled)
            {
                <Pill Tone="Tone.Positive">Filed</Pill>
                <span class="ml-1">@DateText(Photo.FiledAt)</span>
            }
            @if (Photo.Archive is { } archive)
            {
                <Pill Tone="Tone.Warning" Title="@SitePhotoText.ArchiveReading(archive)">Archived</Pill>
                <span class="ml-1">@archive.Reason.Label()</span>
            }
            @if (Photo.IsWaiting)
            {
                <Pill Tone="Tone.Muted">Unfiled</Pill>
                <span class="ml-1">@DateText(Photo.UploadedAt)</span>
            }
        </span>
        @if (CanDelete && Photo.IsArchived)
        {
            <button type="button" class="btn-secondary self-start" disabled="@Busy" @onclick="OnRestore"
                    title="Bring this photograph back to Unfiled so it can go in the report">Restore</button>
        }
        @if (CanDelete)
        {
            <InlineConfirm Label="Delete" Question="Delete from the pool? Click again" Ghost="true" Busy="@Busy"
                           Title="Remove this photograph from the pool (a copy already filed onto an update stays there)"
                           OnConfirm="OnDelete" Class="self-start" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SitePhoto Photo { get; set; } = default!;
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnRestore { get; set; }
}
