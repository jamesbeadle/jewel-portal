@namespace Jewel.JPMS.Features.Requests
@using Jewel.JPMS.Contracts.MailboxCompose

@* Email this record — a pure VIEW over the host's sending state. Two paths behind the buttons: a
   fresh email (To/CC/BCC from the project's correspondence profile) or reply-all into a tagged
   email chain, the whole conversation quoted beneath; the record's PDF is attached either way.
   Send delivers it from the projects mailbox, Save as draft leaves it in Drafts for Outlook, and
   the result card says which happened. The host owns the chain fetch and the commands. *@
<Modal IsOpen="IsOpen"
       Title="@($"Email this {KindLabel}")"
       OnCancel="() => OnCancel.InvokeAsync()"
       Class="max-w-xl">
    <ChildContent>
    <div class="space-y-4">
        @if (DraftResult is null)
        {
            <p class="text-sm text-content-subtle">
                Sends from the projects mailbox with the @KindLabel PDF attached.
                Save as draft to review it in Outlook first.
            </p>

            @* The words nobody used to be able to read. The cover note and subject are composed
               server-side, so this is the server's own composition rather than a copy built here.
               A reply keeps the same note; Graph supplies its recipients and quoted history, so
               the envelope below is the fresh email's. *@
            <div>
                <p class="text-xs text-content-subtle mb-1">
                    @(SelectedChainId == "" ? "This is the email as it will go:" : "The note this reply will carry:")
                </p>
                <RecordEmailPreviewPanel Preview="Preview" Loading="PreviewLoading" Error="@PreviewError" />
            </div>

            <div class="space-y-2">
                <label class="flex items-start gap-2.5 rounded border p-3 cursor-pointer @(SelectedChainId =="" ? "border-accent bg-accent/5" : "border-line hover:border-line-strong")">
                    <input type="radio" name="email-target" class="mt-0.5" checked="@(SelectedChainId == "")"
                           @onchange="() => SelectedChainIdChanged.InvokeAsync(string.Empty)" />
                    <span>
                        <span class="block text-sm font-medium text-content">Start a fresh email</span>
                        <span class="block text-xs text-content-subtle mt-0.5">A new thread — To/CC/BCC pre-filled from the project's correspondence profile.</span>
                    </span>
                </label>

                <LoadGate IsLoading="@TaggedEmailsLoading" Label="Loading tagged emails">
                @if (TaggedEmails.Count == 0)
                {
                    <p class="text-xs text-content-subtle px-1">No emails are tagged to this request yet, so there is no chain to append to.</p>
                }
                else
                {
                    <p class="eyebrow pt-1">Or append to a tagged email chain</p>
                    @foreach (var email in TaggedEmails)
                    {
                        <label class="flex items-start gap-2.5 rounded border p-3 cursor-pointer @(SelectedChainId == email.MailboxId ?"border-accent bg-accent/5" : "border-line hover:border-line-strong")">
                            <input type="radio" name="email-target" class="mt-0.5" checked="@(SelectedChainId == email.MailboxId)"
                                   @onchange="() => SelectedChainIdChanged.InvokeAsync(email.MailboxId!)" />
                            <span class="min-w-0">
                                <span class="block text-sm font-medium text-content truncate">@(string.IsNullOrWhiteSpace(email.Subject) ? Truncate(email.Body, 80) : email.Subject)</span>
                                <span class="block text-xs text-content-subtle mt-0.5">@AuthorLabel(email) · @DateTimeText(email.PostedAt) — reply-all in this thread, the whole chain quoted beneath.</span>
                            </span>
                        </label>
                    }
                }
                </LoadGate>
            </div>

            @if (Error is not null)
            {
                <Notice Tone="Tone.Negative">@Error</Notice>
            }
        }
        else
        {
            <Notice Tone="@(DraftResult.Sent ? Tone.Positive : DraftResult.FailureNote is null ? Tone.Info : Tone.Warning)">
                <p class="text-sm font-medium">@Headline</p>
                <p class="text-xs text-content-subtle mt-1">To: @string.Join(", ", DraftResult.Recipients)</p>
                @if (DraftResult.Cc is { Count: > 0 } draftCc)
                {
                    <p class="text-xs text-content-subtle">CC: @string.Join(", ", draftCc)</p>
                }
                @if (DraftResult.Bcc is { Count: > 0 } draftBcc)
                {
                    <p class="text-xs text-content-subtle">BCC: @string.Join(", ", draftBcc)</p>
                }
                @if (!DraftResult.Sent)
                {
                    <p class="text-xs text-content-subtle mt-1">@(DraftResult.FailureNote ?? "Review the recipients and send it from Outlook — nothing has been sent.")</p>
                }
                @if (!string.IsNullOrWhiteSpace(DraftResult.WebLink))
                {
                    <a href="@DraftResult.WebLink" target="_blank" rel="noopener"
                       class="text-xs text-accent hover:underline underline-offset-2">Open it in Outlook</a>
                }
            </Notice>
            <div class="flex justify-end">
                <button type="button" class="btn-primary" @onclick="() => OnCancel.InvokeAsync()">Done</button>
            </div>
        }
    </div>
    </ChildContent>
    <FooterContent>
        @if (DraftResult is null)
        {
            <button type="button" class="btn-secondary btn-lg" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
            <button type="button" class="btn-secondary btn-lg" disabled="@Preparing"
                    @onclick="() => OnSend.InvokeAsync(true)">Save as draft</button>
            <button type="button" class="btn-primary btn-lg" disabled="@Preparing"
                    @onclick="() => OnSend.InvokeAsync(false)">@(Preparing ? "Working…" : "Send")</button>
        }
    </FooterContent>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>"Request" / "RFI" — how the record names itself in the title and blurb.</summary>
    [Parameter] public string KindLabel { get; set; } = "";

    /// <summary>The record's tagged emails — the chains the draft can append to.</summary>
    [Parameter] public IReadOnlyList<RequestMessage> TaggedEmails { get; set; } = Array.Empty<RequestMessage>();
    [Parameter] public bool TaggedEmailsLoading { get; set; }

    /// <summary>"" = fresh email; otherwise the chosen chain's mailbox id.</summary>
    [Parameter] public string SelectedChainId { get; set; } = "";
    [Parameter] public EventCallback<string> SelectedChainIdChanged { get; set; }

    /// <summary>The email as the server composes it, loaded by the host when the modal opens.</summary>
    [Parameter] public RecordEmailPreview? Preview { get; set; }
    [Parameter] public bool PreviewLoading { get; set; }
    [Parameter] public string? PreviewError { get; set; }

    /// <summary>Set once the email has gone or been staged — swaps the picker for the result card.</summary>
    [Parameter] public RequestEmailOutcome? DraftResult { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Preparing { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>True asks for a draft in the mailbox instead of a send.</summary>
    [Parameter] public EventCallback<bool> OnSend { get; set; }

    private string Headline =>
        DraftResult is { Sent: true } ? "Sent from the projects mailbox."
        : DraftResult?.FailureNote is not null ? "The send didn't go through."
        : "Draft created in the projects mailbox.";

    private static string AuthorLabel(RequestMessage email) =>
        string.IsNullOrWhiteSpace(email.AuthorName) ? email.AuthorEmail : email.AuthorName;

    private static string Truncate(string value, int max) =>
        string.IsNullOrEmpty(value) || value.Length <= max ? value : value[..max].TrimEnd() + "…";
}
