@namespace Jewel.JPMS.Features.Triage.Workspace

@*
    One pane's icon row — the same set on both sides, so either window can load any content.
    Pressing an icon loads that content THIS side; whatever the pane showed before waits in its
    history. The Email and Preview icons only exist while there is an email / a document to show.

    Rail order is the triager's mental path (2026-08-27 restructure): the inbox and the open
    email, then the four pathway panes — "here's how I deal with this email on the client /
    subcontractor / supplier / internal side" — then the reference tools.
*@

<div class="flex items-center gap-1 flex-wrap">
    @RailButton(PanelKind.Inbox, "Email inbox — triage and apply")
    @if (EmailAvailable)
    {
        @RailButton(PanelKind.Email, EmailLabel)
    }
    @RailButton(PanelKind.Client, "Client — tag and action this email on the client side")
    @RailButton(PanelKind.Subcontractor, "Subcontractor — tag and action this email on the subcontractor side")
    @RailButton(PanelKind.Supplier, "Supplier — tag and action this email on the supplier side")
    @RailButton(PanelKind.Internal, "Internal — tag and action this email on the staff side")
    @RailButton(PanelKind.Records, "Record explorer")
    @RailButton(PanelKind.Xero, "Xero explorer")
    @RailButton(PanelKind.Compose, "New email")
    @RailButton(PanelKind.Outbox, "Outbox — emails lined up for Apply")
    @if (PreviewAvailable)
    {
        @RailButton(PanelKind.Preview, "Document preview")
    }
</div>

@code {
    [Parameter, EditorRequired] public PanelWorkspaceState State { get; set; } = default!;
    [Parameter, EditorRequired] public PanelSide Side { get; set; }

    /// <summary>An email is open, so the Email icon exists. Otherwise it disappears entirely.</summary>
    [Parameter] public bool EmailAvailable { get; set; }

    /// <summary>A document is open from a record, so the Preview icon exists.</summary>
    [Parameter] public bool PreviewAvailable { get; set; }

    /// <summary>Staged tags + actions per pathway — badged on that pathway's icon, so the rail
    /// says at a glance which sides of the triage already carry staged work.</summary>
    [Parameter] public int ClientBadge { get; set; }
    [Parameter] public int SubcontractorBadge { get; set; }
    [Parameter] public int SupplierBadge { get; set; }
    [Parameter] public int InternalBadge { get; set; }

    /// <summary>How many emails are lined up to send — badged on the Outbox icon.</summary>
    [Parameter] public int OutboxBadge { get; set; }

    // The other pane already reading the email means this icon opens the mirror — say so.
    private string EmailLabel =>
        State.ActiveOn(Side == PanelSide.Left ? PanelSide.Right : PanelSide.Left) == PanelKind.Email
            ? "The open email — a reading copy this side, while the reply is written in the other window"
            : "The open email";

    private RenderFragment RailButton(PanelKind kind, string label) => __builder =>
    {
        var active = State.ActiveOn(Side);
        // The mirror is the email pressed a second time, so it lights the Email icon too.
        var isActive = active == kind || (kind == PanelKind.Email && active == PanelKind.EmailMirror);
        <button type="button" title="@label" aria-label="@label" @onclick="() => State.Show(kind, Side)"
                class="@ButtonClass(isActive)">
            <WorkspaceIcon Kind="kind" />
            @if (BadgeFor(kind) is > 0 and var badge)
            {
                <span class="absolute -top-1 -right-1 min-w-[1.1rem] h-[1.1rem] px-0.5 rounded-full bg-accent text-accent-ink text-[10px] font-semibold flex items-center justify-center leading-none">@badge</span>
            }
        </button>
    };

    private int BadgeFor(PanelKind kind) => kind switch
    {
        PanelKind.Client => ClientBadge,
        PanelKind.Subcontractor => SubcontractorBadge,
        PanelKind.Supplier => SupplierBadge,
        PanelKind.Internal => InternalBadge,
        PanelKind.Outbox => OutboxBadge,
        _ => 0
    };

    private static string ButtonClass(bool isActive) =>
        "relative inline-flex items-center justify-center w-8 h-8 rounded-lg border transition "
        + (isActive
            ? "border-accent/60 bg-accent/10 text-accent"
            : "border-transparent text-content-subtle hover:text-content hover:bg-surface-raised");
}
