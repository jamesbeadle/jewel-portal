@namespace Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Contracts.MailboxCompose
@using Jewel.JPMS.Features.Drawings
@implements IDisposable
@inject IDrawingStore Drawings
@inject IProgressStore Progress
@inject IIntakeQueue Intake

@* The composer's attachment tray: what's attached so far (chips with remove), plus five ways to
   add — files from this computer, drawings from a project's register, progress photos, a system
   record's official document (an RFI's PDF, say), and the opened email's own attachments
   (forwarding them on). Everything except uploads is attached by id and resolved server-side —
   drawings and photos from blob storage, record documents rendered fresh at send time — so
   nothing round-trips through the browser. *@

<div class="space-y-2">
    @if (Attachments.Count > 0)
    {
        <div class="flex flex-wrap gap-1.5">
            @foreach (var attachment in Attachments)
            {
                <span @key="attachment.Key" class="inline-flex items-center gap-1.5 rounded-full bg-surface-raised border border-line px-2.5 py-1 text-xs text-content">
                    <span>@AttachmentGlyph(attachment.Source)</span>
                    <span class="max-w-[16rem] truncate">@attachment.FileName</span>
                    <span class="text-content-faint">@SizeLabel(attachment.SizeBytes)</span>
                    <button type="button" class="text-content-subtle hover:text-negative" title="Remove"
                            @onclick="() => RemoveAsync(attachment)">✕</button>
                </span>
            }
        </div>
    }

    <div class="flex flex-wrap items-center gap-2 text-xs">
        <label class="inline-flex items-center gap-1 rounded-lg border border-line px-2.5 py-1.5 text-content-muted hover:text-content hover:border-line-strong cursor-pointer">
            📎 Attach files
            <InputFile OnChange="OnFilesPicked" multiple class="hidden" />
        </label>
        <button type="button" class="@SourceButtonClass(Panel.Drawings)" @onclick="() => TogglePanel(Panel.Drawings)">📐 Project drawings</button>
        <button type="button" class="@SourceButtonClass(Panel.Photos)" @onclick="() => TogglePanel(Panel.Photos)">📷 Progress photos</button>
        <button type="button" class="@SourceButtonClass(Panel.Records)" @onclick="() => TogglePanel(Panel.Records)">📄 System documents</button>
        @if (OriginalAttachments is { Count: > 0 })
        {
            <button type="button" class="@SourceButtonClass(Panel.Original)" @onclick="() => TogglePanel(Panel.Original)">✉️ This email's attachments</button>
        }
        @if (oversizeNote is not null)
        {
            <span class="text-negative">@oversizeNote</span>
        }
    </div>

    @if (openPanel != Panel.None)
    {
        <div class="rounded-lg border border-line bg-surface-raised p-3 space-y-2">
            @if (openPanel is Panel.Drawings or Panel.Photos or Panel.Records)
            {
                <div>
                    <label class="block text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-1">Project</label>
                    <select class="field" value="@panelProjectId" @onchange="OnPanelProjectChanged">
                        <option value="">Select a project…</option>
                        @foreach (var project in Projects)
                        {
                            <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                        }
                    </select>
                </div>
            }

            @if (openPanel == Panel.Drawings)
            {
                @if (string.IsNullOrEmpty(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Choose a project to list its drawing register.</p>
                }
                else if (!Drawings.DrawingsLoadedFor(panelProjectId) || !Drawings.FoldersLoadedFor(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Loading drawings…</p>
                }
                else if (Drawings.DrawingsFor(panelProjectId).Count == 0)
                {
                    <p class="text-xs text-content-subtle">No drawings on this project yet.</p>
                }
                else
                {
                    <input class="field w-full" type="text" placeholder="Search drawings — code, title, file name or folder…"
                           value="@drawingSearch" @oninput="e => drawingSearch = e.Value?.ToString() ?? string.Empty" />

                    <div class="max-h-64 overflow-y-auto divide-y divide-line">
                        @if (HasDrawingSearch)
                        {
                            @if (DrawingSearchResults.Count == 0)
                            {
                                <p class="text-xs text-content-subtle py-1.5">No drawings match — try a code, title, file name or folder name.</p>
                            }
                            else
                            {
                                @foreach (var drawing in DrawingSearchResults)
                                {
                                    <div @key="drawing.DrawingId">@DrawingRow(drawing, 0, true)</div>
                                }
                            }
                        }
                        else
                        {
                            @foreach (var folderGroup in VisibleDrawingSections)
                            {
                                <div @key="@("folder-" + folderGroup.Key)">
                                    @if (folderGroup.Folder is not null || HasDrawingFolders)
                                    {
                                        <div class="flex items-center gap-2 py-1.5" style="@IndentStyle(folderGroup.Depth)">
                                            <input type="checkbox" checked="@FolderFullySelected(folderGroup)"
                                                   title="Tick every drawing in this folder, sub-folders included"
                                                   @onchange="() => ToggleFolderSelection(folderGroup)" />
                                            <button type="button" class="flex-1 min-w-0 text-left text-xs text-content font-semibold hover:text-accent flex items-center gap-1.5"
                                                    @onclick="() => ToggleFolderCollapse(folderGroup.Key)">
                                                <span class="text-content-faint">@(IsFolderCollapsed(folderGroup.Key) ? "▸" : "▾")</span>
                                                <span class="truncate">@(folderGroup.Folder?.Name ?? "Ungrouped")</span>
                                                <span class="text-content-faint font-normal tabular-nums" title="Drawings in this folder, sub-folders included">@FolderSubtreeCount(folderGroup)</span>
                                            </button>
                                        </div>
                                    }
                                    @if (!IsFolderCollapsed(folderGroup.Key))
                                    {
                                        @foreach (var drawing in folderGroup.Drawings)
                                        {
                                            <div @key="drawing.DrawingId">@DrawingRow(drawing, folderGroup.Folder is null && !HasDrawingFolders ? 0 : folderGroup.Depth + 1, false)</div>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="flex flex-wrap items-center gap-2 pt-1 text-xs">
                        <button type="button"
                                class="inline-flex items-center gap-1 rounded-lg border border-accent text-accent bg-accent/5 hover:bg-accent/10 px-2.5 py-1.5 disabled:opacity-60"
                                disabled="@(SelectedDrawingCount == 0 || attachingSelected)" @onclick="AttachSelectedDrawingsAsync">
                            @(attachingSelected ? "Attaching…" : $"Attach {SelectedDrawingCount} selected")
                        </button>
                        @if (SelectedDrawingCount > 0 && !attachingSelected)
                        {
                            <button type="button" class="text-content-subtle hover:text-content" @onclick="ClearDrawingSelection">Clear selection</button>
                        }
                        @if (attachNote is not null)
                        {
                            <span class="text-content-subtle">@attachNote</span>
                        }
                    </div>
                    <p class="text-[11px] text-content-faint">
                        Tick drawings (or a whole folder) and press Attach — each drawing's approved file is used, or its latest upload when nothing is approved.
                        Expand a drawing to tick a specific revision instead.
                    </p>
                }
            }
            else if (openPanel == Panel.Photos)
            {
                @if (string.IsNullOrEmpty(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Choose a project to list its progress photos.</p>
                }
                else if (!Progress.UpdatesLoadedFor(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Loading progress updates…</p>
                }
                else if (Progress.UpdatesFor(panelProjectId).Count == 0)
                {
                    <p class="text-xs text-content-subtle">No progress updates on this project yet.</p>
                }
                else
                {
                    <div class="max-h-64 overflow-y-auto space-y-2">
                        @foreach (var update in Progress.UpdatesFor(panelProjectId))
                        {
                            <div @key="update.ProgressUpdateId">
                                <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                                    @update.Title@(update.WorkDate is { } wd ? $" — {wd:d MMM yyyy}" : "")
                                </p>
                                <div class="flex flex-wrap gap-1.5 pt-1">
                                    @foreach (var photo in update.Photos)
                                    {
                                        <button type="button" @key="photo.ProgressPhotoId" title="@photo.FileName — attach"
                                                class="relative rounded border border-line overflow-hidden hover:border-accent"
                                                @onclick="() => AddPhotoAsync(photo)">
                                            <img src="/api/progress-photos/@photo.ProgressPhotoId/file?inline=1" alt="@photo.FileName"
                                                 class="h-14 w-14 object-cover" loading="lazy" />
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (openPanel == Panel.Records)
            {
                @if (string.IsNullOrEmpty(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Choose a project to list its records.</p>
                }
                else if (recordsFailedFor == panelProjectId)
                {
                    <p class="text-xs text-negative">The project's records couldn't be loaded — close and reopen this panel to try again.</p>
                }
                else if (!recordsByProject.ContainsKey(panelProjectId))
                {
                    <p class="text-xs text-content-subtle">Loading records…</p>
                }
                else
                {
                    <div class="flex flex-wrap items-center gap-3">
                        <input class="field flex-1 min-w-[10rem]" type="text" placeholder="Filter by reference or title…"
                               value="@recordSearch" @oninput="e => recordSearch = e.Value?.ToString() ?? string.Empty" />
                        <label class="inline-flex items-center gap-1.5 text-xs text-content-muted whitespace-nowrap">
                            <input type="checkbox" checked="@recordsIncludeInactive"
                                   @onchange="e => recordsIncludeInactive = e.Value is true" />
                            Include closed
                        </label>
                    </div>

                    @if (FilteredRecords.Count == 0)
                    {
                        <p class="text-xs text-content-subtle">
                            @(recordsByProject[panelProjectId].Count == 0
                                ? "No requests, variation orders or tender enquiries on this project yet."
                                : "No records match — clear the filter or include closed records.")
                        </p>
                    }
                    else
                    {
                        <div class="max-h-56 overflow-y-auto divide-y divide-line">
                            @foreach (var record in FilteredRecords)
                            {
                                <button type="button" @key="record.RecordId" title="Attach the official PDF"
                                        class="w-full text-left text-xs text-content-muted hover:text-accent flex items-center gap-2 py-1.5"
                                        @onclick="() => AddRecordDocumentAsync(record)">
                                    <span class="font-mono text-content">@record.Reference</span>
                                    <span class="truncate flex-1">@record.Title</span>
                                    @if (record.StatusLabel is { Length: > 0 })
                                    {
                                        <span class="text-content-faint">@record.StatusLabel</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                    <p class="text-[11px] text-content-faint">
                        Attaches the record's official PDF, rendered as the record stands when the email is sent.
                        Requests (RFI, NOD, EOT…), variation orders and tender enquiries (the PQQ response) carry official documents today.
                    </p>
                }
            }
            else if (openPanel == Panel.Original && OriginalAttachments is not null)
            {
                <div class="space-y-1">
                    @foreach (var attachment in OriginalAttachments)
                    {
                        <button type="button" @key="attachment.Id"
                                class="w-full text-left text-xs text-content-muted hover:text-accent flex items-center gap-2"
                                @onclick="() => AddOriginalAsync(attachment)">
                            <span>📎</span>
                            <span class="truncate flex-1">@attachment.Name</span>
                            <span class="text-content-faint">@SizeLabel(attachment.Size)</span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>


@code {
    // One drawing row — a tick box, the drawing's identity (with its folder path when the flat
    // search list needs it), what "its file" currently means, and the revisions expander.
    private RenderFragment DrawingRow(Drawing drawing, int depth, bool showPath) => @<text>
        <div class="flex items-center gap-2 py-1.5" style="@IndentStyle(depth)">
            <input type="checkbox" checked="@selectedDrawingIds.Contains(drawing.DrawingId)"
                   title="Tick to attach this drawing's file"
                   @onchange="() => ToggleDrawingSelection(drawing.DrawingId)" />
            <button type="button" class="flex-1 min-w-0 text-left text-xs text-content hover:text-accent flex items-center gap-2"
                    title="Show this drawing's revisions" @onclick="() => ToggleDrawing(drawing.DrawingId)">
                <span class="font-mono">@DrawingNaming.Code(drawing)</span>
                <span class="truncate flex-1">@DrawingNaming.Name(drawing)</span>
                @if (showPath && FolderPathFor(drawing) is { Length: > 0 } path)
                {
                    <span class="text-content-faint truncate max-w-[10rem]" title="@path">@path</span>
                }
                @if (DrawingNaming.ApprovedRevisionText(drawing) is { } approved)
                {
                    <span class="text-content-faint whitespace-nowrap">@approved</span>
                }
                <span class="text-content-faint">@(expandedDrawingId == drawing.DrawingId ? "▾" : "▸")</span>
            </button>
        </div>
        @if (expandedDrawingId == drawing.DrawingId)
        {
            @if (Drawings.RevisionsFailedFor(drawing.DrawingId))
            {
                <button type="button" class="text-[11px] text-negative hover:underline pb-1 text-left"
                        style="@IndentStyle(depth + 1)" @onclick="() => Drawings.RetryRevisions(drawing.DrawingId)">
                    The revisions couldn't be loaded — press to try again.
                </button>
            }
            else if (!Drawings.RevisionsLoadedFor(drawing.DrawingId))
            {
                <p class="text-[11px] text-content-subtle pb-1" style="@IndentStyle(depth + 1)">Loading revisions…</p>
            }
            else
            {
                <div class="pb-1.5 space-y-1" style="@IndentStyle(depth + 1)">
                    @foreach (var revision in Drawings.RevisionsFor(drawing.DrawingId))
                    {
                        <label @key="revision.DrawingRevisionId"
                               class="flex items-center gap-2 text-[11px] text-content-muted cursor-pointer hover:text-content">
                            <input type="checkbox" checked="@selectedRevisionsById.ContainsKey(revision.DrawingRevisionId)"
                                   @onchange="() => ToggleRevisionSelection(revision)" />
                            <span class="font-medium">@DrawingNaming.RevisionText(revision.RevisionLabel)</span>
                            <span class="truncate flex-1">@revision.FileName</span>
                            <span>@(revision.ApprovalStatus == DrawingApprovalStatus.Approved ? "Approved" : revision.ApprovalStatus == DrawingApprovalStatus.Archived ? "Archived" : "Unapproved")</span>
                            <span class="text-content-faint">@SizeLabel(revision.FileSizeBytes ?? 0)</span>
                        </label>
                    }
                </div>
            }
        }
    </text>;
}
