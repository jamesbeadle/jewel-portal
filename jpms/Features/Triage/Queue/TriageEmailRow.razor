@using Jewel.JPMS.Features.Triage
@namespace Jewel.JPMS.Features.Triage.Queue

@* One email in a triage list — queue, discarded or tagged. The row is the whole button:
   sender and time on the top line, subject with markers, then the one-line preview and
   whatever chips the hosting list asked for. *@
<button type="button" @onclick="() => OnSelect.InvokeAsync(Item)" class="@RowClass">
    <div class="flex items-baseline justify-between gap-2">
        <span class="text-sm font-semibold text-content truncate">@TriageEmailDisplay.DisplayFrom(Item)</span>
        <span class="text-[11px] text-content-subtle shrink-0">@TriageEmailDisplay.ListDate(Item.ReceivedAt)</span>
    </div>
    <div class="flex items-center gap-1.5 mt-0.5">
        <p class="text-sm text-content-muted truncate flex-1">@TriageEmailDisplay.Dash(Item.Subject)</p>
        @if (HasParkedDraft && InlineDraftMarker)
        {
            <span title="Unfinished triage — open the email to carry on where you left off" class="text-[10px] font-semibold text-accent shrink-0">✎ draft</span>
        }
        @if (Item.HasAttachments)
        {
            <span title="Has attachments" class="inline-flex items-center text-content-subtle shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="w-3 h-3 shrink-0" aria-hidden="true">
                    <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                </svg>
            </span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Item.BodyPreview))
    {
        <p class="text-xs text-content-subtle truncate mt-0.5">@TriageEmailDisplay.FirstLineOf(Item.BodyPreview)</p>
    }
    @if (HasParkedDraft && !InlineDraftMarker)
    {
        <p class="text-[10px] font-semibold text-accent mt-0.5">✎ draft in progress</p>
    }
    @if (ShowThreadTags && Item.ThreadTags is { Count: > 0 } threadTags)
    {
        <div class="flex flex-wrap items-center gap-1 mt-1">
            <span class="text-[10px] text-content-subtle">Thread:</span>
            @foreach (var tag in threadTags)
            {
                <span class="inline-flex items-center rounded-full border border-accent/40 text-accent/90 text-[10px] font-medium px-2 py-0.5">@TriageEmailDisplay.TagLabel(tag)</span>
            }
        </div>
    }
    @if (ShowFilingChips)
    {
        @if (Item.Bucket is not null || Item.Categories.Count > 0)
        {
            <div class="flex flex-wrap items-center gap-1 mt-1">
                @if (TriagePathways.FromBucket(Item.Bucket) is { } rowPathway)
                {
                    <span class="inline-flex items-center rounded-full @TriagePathways.ChipColour(rowPathway) text-[10px] font-medium px-2 py-0.5">@TriagePathways.Label(rowPathway)</span>
                }
                @foreach (var tag in Item.Categories)
                {
                    <Pill Tone="Tone.Info">@TriageEmailDisplay.TagLabel(tag)</Pill>
                }
            </div>
        }
        else if (ShowUntaggedFallback)
        {
            <div class="flex flex-wrap items-center gap-1 mt-1">
                <Pill Tone="Tone.Muted">Untagged — still in the queue</Pill>
            </div>
        }
    }
</button>

@code {
    [Parameter, EditorRequired] public MailboxMessage Item { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool HasParkedDraft { get; set; }

    /// <summary>Queue rows mark a parked draft inline beside the subject; tagged rows give it its own line.</summary>
    [Parameter] public bool InlineDraftMarker { get; set; }

    /// <summary>Queue rows hint at record tags elsewhere in the conversation.</summary>
    [Parameter] public bool ShowThreadTags { get; set; }

    /// <summary>Tagged (and freshly-tagged queue) rows show the thread's pathway and record chips.</summary>
    [Parameter] public bool ShowFilingChips { get; set; }

    /// <summary>Free-text search can surface untagged queue emails in the tagged list — say so.</summary>
    [Parameter] public bool ShowUntaggedFallback { get; set; }

    [Parameter] public EventCallback<MailboxMessage> OnSelect { get; set; }

    private string RowClass
    {
        get
        {
            var baseClass = "w-full text-left rounded-lg border px-3 py-2 transition";
            return IsSelected
                ? $"{baseClass} border-accent bg-surface-raised"
                : $"{baseClass} border-line hover:border-line-strong hover:bg-surface-raised";
        }
    }
}
