@namespace Jewel.JPMS.Features.Triage.Queue

@* Cursor-paged list navigation: Previous / "Page x of y · n emails" / Next. Renders nothing for a
   single page. The empty spans keep the centre label centred when a button stands down. *@
@if (PageCount > 1)
{
    <div class="flex items-center justify-between gap-2 pt-2">
        @if (PageIndex > 0)
        {
            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="() => OnPrevious.InvokeAsync()">Previous</button>
        }
        else
        {
            <span></span>
        }
        <span class="text-xs text-content-subtle">Page @(PageIndex + 1) / @PageCount · @Total email@(Total == 1 ? "" : "s")</span>
        @if (HasNext)
        {
            <button type="button" class="btn-secondary text-xs px-2.5 py-1.5" @onclick="() => OnNext.InvokeAsync()">Next</button>
        }
        else
        {
            <span></span>
        }
    </div>
}

@code {
    [Parameter] public int PageIndex { get; set; }
    [Parameter] public int PageCount { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool HasNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}
