@namespace Jewel.JPMS.Features.Triage.Queue

@* One of the triage bar's Yes/No pairs: two joined pill halves, neither lit until the triager
   picks a side (null = blank) — the bar's Apply stands down until every pair on show is
   answered, so each apply carries decisions someone actually made. Clicking the picked side
   again is a no-op, not a clear: "no answer" isn't a state anyone can put back. A pair that
   does not apply to this email (a Relevant Event with no project to have a programme, 2026-09-15)
   is NotAsked: it stays on show so the bar reads the same every time, but says why it is
   quiet instead of offering a Yes that could never file. *@
<div class="flex items-center justify-between gap-3" title="@Title">
    <span class="text-sm @(NotAsked ? "text-content-subtle" : "text-content")">@ChildContent</span>
    @if (NotAsked)
    {
        <span class="text-xs text-content-subtle shrink-0">@NotAskedNote</span>
    }
    else
    {
        <div class="flex items-center shrink-0">
            <button type="button" class="@HalfClass(answer: true, first: true)"
                    @onclick="() => ValueChanged.InvokeAsync(true)">Yes</button>
            <button type="button" class="@HalfClass(answer: false, first: false)"
                    @onclick="() => ValueChanged.InvokeAsync(false)">No</button>
        </div>
    }
</div>

@code {
    /// <summary>The decision's on-screen name — plain text or richer markup (the "Use existing
    /// tags" row lists the tags in a muted span).</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>The full wording of what Yes and No each do, shown on hover.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>True when the question does not apply to this email — the Yes/No is replaced by
    /// <see cref="NotAskedNote"/> and the answer is not awaited.</summary>
    [Parameter] public bool NotAsked { get; set; }
    [Parameter] public string NotAskedNote { get; set; } = "";

    /// <summary>Null until the triager picks a side.</summary>
    [Parameter] public bool? Value { get; set; }
    [Parameter] public EventCallback<bool?> ValueChanged { get; set; }

    // Picked reads like a picked record row (accent on raised surface); unpicked stays muted.
    private string HalfClass(bool answer, bool first) =>
        "px-2.5 py-1 text-xs border transition "
        + (first ? "rounded-l-lg" : "rounded-r-lg -ml-px")
        + (Value == answer
            ? " relative border-accent bg-surface-raised text-content font-medium"
            : " border-line text-content-subtle hover:text-content hover:border-line-strong");
}
