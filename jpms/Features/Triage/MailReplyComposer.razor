@namespace Jewel.JPMS.Features.Triage
@inject IIntakeQueue Intake

@* THE reply widget — one composer for every place a communication is listed. Two modes, decided
   by which callback the host passes:
   - Send mode (OnSent): the email goes on the wire immediately from the projects mailbox — the
     record pages' behaviour (a reply from a variation's Communications panel just sends).
   - Stage mode (OnStage): nothing is sent; the composer hands back a StagedOutboxReply for the
     Control Centre's Outbox, where many replies line up and the page's Apply sends them all.
   Forward=true composes a FORWARD of the anchor instead: blank envelope, "FW:" subject, and the
   original email's attachments travel automatically (Graph's createForward carries them on the
   draft), so the picker doesn't offer them a second time. A reply's envelope prefills reply-all
   from the anchor's live detail (minus the projects mailbox — Cc'ing it would deliver a copy
   straight back into the triage queue). Either way the visible fields are exactly what goes on
   the wire. *@

<div class="rounded-lg border border-line bg-surface-raised p-4 space-y-3">
    <div class="flex items-center justify-between">
        <p class="eyebrow">@HeaderLabel</p>
        <button type="button" class="text-xs text-content-subtle hover:text-negative underline"
                @onclick="() => OnCancel.InvokeAsync()">@(IsEditingDraft ? "Cancel" : "Discard draft")</button>
    </div>

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }

    <div>
        <FormField Label="To" Required>
        <RecipientInput Value="@toField" ValueChanged="value => { toField = value; _ = NotifyEditedAsync(); }" />
        </FormField>
    </div>
    <div>
        <div class="flex items-center justify-between">
            <label class="block text-sm font-medium text-content mb-1">Cc</label>
            @if (!showBcc)
            {
                <button type="button" class="text-xs text-content-subtle hover:text-content underline"
                        @onclick="() => showBcc = true">Bcc</button>
            }
        </div>
        <RecipientInput Value="@ccField" ValueChanged="value => { ccField = value; _ = NotifyEditedAsync(); }" Placeholder="Copied recipients" />
    </div>
    @if (showBcc)
    {
        <div>
            <FormField Label="Bcc">
            <RecipientInput Value="@bccField" ValueChanged="value => { bccField = value; _ = NotifyEditedAsync(); }" Placeholder="Blind-copied recipients" />
            </FormField>
        </div>
    }
    <div>
        <FormField Label="Subject" Required>
        <input class="field" type="text" value="@subject"
               @oninput="e => { subject = e.Value?.ToString() ?? string.Empty; _ = NotifyEditedAsync(); }" />
        </FormField>
    </div>
    <div>
        <label class="block text-sm font-medium text-content mb-1">
            @(IsForward ? "Your message *" : IsReply ? "Your reply *" : "Your email *")
        </label>
        <RichTextEditor @bind-Value="body" @bind-Value:after="NotifyEditedAsync" MinHeight="180"
                        Placeholder="@(IsForward ? "Write the message — the forwarded email is quoted behind it…"
                                     : IsReply ? "Write the reply — the whole thread is quoted behind it…" : "Write the email…")" />
    </div>

    @* A forward carries the original email's attachments automatically (Graph's createForward
       copies them onto the draft), so the picker only offers EXTRA files — offering the originals
       again would attach every file twice. *@
    <AttachmentPicker Attachments="attachments" AttachmentsChanged="picked => attachments = picked"
                      Projects="@Projects" ProjectId="@ProjectId"
                      OriginalAttachments="@(IsForward ? null : anchorDetail?.Attachments)" OriginalMessageId="@AnchorMessageId"
                      ThreadConversationId="@(string.IsNullOrEmpty(ReplyTo?.ConversationId) ? null : ReplyTo!.ConversationId)" ThreadSubject="@ReplyTo?.Subject" />
    @if (IsForward && anchorDetail is { Attachments.Count: > 0 } forwarded)
    {
        <p class="text-xs text-content-subtle">
            The original email's @(forwarded.Attachments.Count == 1 ? "attachment travels" : $"{forwarded.Attachments.Count} attachments travel")
            with the forward automatically.
        </p>
    }

    <div class="flex items-center justify-between gap-3 pt-1">
        <p class="text-xs text-content-subtle">@(FooterNote ?? DefaultFooterNote)</p>
        <button type="button" class="btn-primary" disabled="@(sending || !IsSendable)" @onclick="ConfirmAsync">
            @PrimaryLabel
        </button>
    </div>
</div>
