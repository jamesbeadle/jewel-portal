@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.TenderEnquiries

@* "Log Tender Enquiry" — the email-linked create for an architect's invitation to tender. Drafts
   the ONE page-owned StagedRecordCreate (Kind = TenderEnquiry) like the other creates, so Apply
   logs the enquiry through LogTenderEnquiryFromMessage and the email is tagged to it. The form
   pre-fills what the email already says — the title from the subject, the contact from the
   sender — and ticks every attachment, since an enquiry's attachments are the PQQ and drawings. *@

<div class="space-y-4">
    <p class="text-xs text-content-subtle">
        @(Draft.CreatesNewProject
            ? "A Lead-stage project is created for the job, the enquiry logged on it, and this email tagged to the enquiry on apply."
            : "The enquiry is logged on the email's project and this email tagged to it on apply.")
    </p>

    <TenderEnquiryDetailsForm Draft="@Draft.Details" OnChanged="NotifyCreate" ShowProblem="@(StagedCreate is not null)" />

    <label class="flex items-start gap-2 cursor-pointer">
        <input type="checkbox" checked="@Draft.CreatesNewProject" @onchange="e => Set(draft => draft.CreatesNewProject = e.Value is true)" />
        <span class="text-sm text-content">
            Create a new project for this job
            <span class="block text-xs text-content-subtle">
                @(string.IsNullOrWhiteSpace(ProjectId)
                    ? "Untick to log the enquiry on an existing project — set it in the triage bar above."
                    : $"Untick to log it on {ProjectLabel} instead.")
            </span>
        </span>
    </label>

    @if (Draft.CreatesNewProject)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 rounded-lg border border-line bg-surface-raised p-3">
            <FormField Label="Project name" Value="@Draft.ProjectName" Required="true" OnChange="v => Set(draft => draft.ProjectName = v)" />
            <FormField Label="Client (if known)" Value="@Draft.ClientName" OnChange="v => Set(draft => draft.ClientName = v)" />
            <div>
                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Jewel entity</label>
                <select class="field" value="@((int)Draft.Organisation)" @onchange="OnOrganisationChanged">
                    @foreach (var organisation in Enum.GetValues<Organisation>())
                    {
                        <option value="@((int)organisation)">@organisation.DisplayName()</option>
                    }
                </select>
            </div>
            <FormField Label="Site address" Value="@Draft.AddressLine" OnChange="v => Set(draft => draft.AddressLine = v)" />
            <FormField Label="Town" Value="@Draft.Town" OnChange="v => Set(draft => draft.Town = v)" />
            <FormField Label="Postcode" Value="@Draft.Postcode" OnChange="v => Set(draft => draft.Postcode = v)" />
        </div>
    }

    @if (TickableEmailAttachments.Count > 0)
    {
        <div>
            <p class="text-xs font-semibold text-content-subtle mb-1">Keep from this email (the PQQ, the drawings)</p>
            <ul class="space-y-1">
                @foreach (var attachment in TickableEmailAttachments)
                {
                    var emailAttachment = attachment;
                    <li>
                        <label class="flex items-center gap-2 text-sm text-content cursor-pointer">
                            <input type="checkbox" checked="@Draft.EmailAttachmentIds.Contains(emailAttachment.Id)"
                                   @onchange="e => ToggleEmailAttachment(emailAttachment, e.Value is true)" />
                            <span class="truncate" title="@emailAttachment.Name">@emailAttachment.Name</span>
                        </label>
                    </li>
                }
            </ul>
        </div>
    }

    @if (StagedCreate is not null && Draft.Problem(!string.IsNullOrWhiteSpace(ProjectId)) is { } problem)
    {
        <p class="text-xs text-amber-600">@problem</p>
    }
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();
    [Parameter] public StagedRecordCreate? StagedCreate { get; set; }
    [Parameter] public EventCallback<StagedRecordCreate?> StagedCreateChanged { get; set; }
    [Parameter] public IReadOnlyList<IntakeAttachment> EmailAttachments { get; set; } = Array.Empty<IntakeAttachment>();
    [Parameter] public string SenderEmail { get; set; } = "";
    [Parameter] public string EmailSubject { get; set; } = "";

    // The form binds to a scratch instance until something is typed, so an empty form never
    // stages a phantom "new record" — the StagedRecordActionEditor arrangement.
    private StagedRecordCreate scratchCreate = new() { Kind = StagedRecordKind.TenderEnquiry };
    private StagedRecordCreate? lastStaged;
    private StagedRecordCreate Create => StagedCreate ?? scratchCreate;
    private StagedTenderEnquiryDraft Draft => Create.TenderEnquiry;

    private string ProjectLabel => Projects.FirstOrDefault(project => project.ProjectId == ProjectId)?.Name ?? "the email's project";

    private IReadOnlyList<IntakeAttachment> TickableEmailAttachments =>
        (EmailAttachments ?? Array.Empty<IntakeAttachment>()).Where(attachment => !string.IsNullOrEmpty(attachment.Id)).ToList();

    protected override void OnInitialized()
    {
        PrefillFromEmail(scratchCreate);
        // A draft staged under another action keeps its content — its title becomes the enquiry's
        // and the email's attachments are offered — and is re-stamped to what Apply now raises.
        if (StagedCreate is not { } staged || staged.Kind == StagedRecordKind.TenderEnquiry) return;
        if (string.IsNullOrWhiteSpace(staged.TenderEnquiry.Details.Title)) PrefillFromEmail(staged);
        if (string.IsNullOrWhiteSpace(staged.TenderEnquiry.Details.Title)) staged.TenderEnquiry.Details.Title = staged.Title;
        NotifyCreate();
    }

    protected override void OnParametersSet()
    {
        // Once staged, scratch and page copy are the SAME object — replace the scratch when the
        // staged draft goes away, or the form would silently re-stage the old content.
        if (lastStaged is not null && StagedCreate is null)
        {
            scratchCreate = new StagedRecordCreate { Kind = StagedRecordKind.TenderEnquiry };
            PrefillFromEmail(scratchCreate);
        }
        lastStaged = StagedCreate;
    }

    // Suggestions only, filled WITHOUT staging: the subject (minus FW:/RE:) as the title and the
    // project name, the sender as the contact, every attachment ticked, a project by default
    // when the bar has none.
    private void PrefillFromEmail(StagedRecordCreate target)
    {
        var draft = target.TenderEnquiry;
        var subject = StripReplyPrefixes(EmailSubject);
        draft.Details.Title = subject;
        draft.ProjectName = subject;
        draft.Details.ArchitectContactEmail = SenderEmail.Trim();
        draft.CreatesNewProject = string.IsNullOrWhiteSpace(ProjectId);
        draft.EmailAttachmentIds.Clear();
        draft.EmailAttachmentIds.AddRange(TickableEmailAttachments.Select(attachment => attachment.Id));
    }

    private static string StripReplyPrefixes(string subject)
    {
        var cleaned = subject.Trim();
        while (System.Text.RegularExpressions.Regex.IsMatch(cleaned, @"^(fw|fwd|re)\s*:\s*", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"^(fw|fwd|re)\s*:\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return cleaned;
    }

    private void Set(Action<StagedTenderEnquiryDraft> edit)
    {
        edit(Draft);
        NotifyCreate();
    }

    private void OnOrganisationChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<Organisation>(e.Value?.ToString(), out var parsed)) Set(draft => draft.Organisation = parsed);
    }

    private void ToggleEmailAttachment(IntakeAttachment attachment, bool isTicked) =>
        Set(draft =>
        {
            draft.EmailAttachmentIds.Remove(attachment.Id);
            if (isTicked) draft.EmailAttachmentIds.Add(attachment.Id);
        });

    // First keystroke on the scratch form stages it; a staged form just reports the edit.
    private void NotifyCreate()
    {
        var target = StagedCreate ?? scratchCreate;
        target.Kind = StagedRecordKind.TenderEnquiry;
        _ = StagedCreateChanged.InvokeAsync(target);
    }
}
