@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Requests
@inject IRequestRegister RequestRegister

@* Raise Request / Raise RFI as a STAGED action: the same RequestForm the raise dialog uses,
   with the payload snapshotted here and fired by the email's Apply. Attachments are hidden —
   a staged draft has no request id to attach to until it fires. *@

<div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
        <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold shrink-0">Project</label>
        <ProjectSelect Projects="@Projects" Value="@projectId" ValueChanged="v => projectId = v"
                       AllowNone="false" Placeholder="Pick a project…" ToggleTitle="The project the request is raised on" />
    </div>
    @if (projectId != "")
    {
        <RequestForm @ref="form" @key="projectId" ProjectId="@projectId" ShowAttachments="false" OnSubmit="StageAsync" />
        <button type="button" class="btn-primary" @onclick="SubmitAsync">Stage action</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    /// <summary>RaiseRequest opens on General, RaiseRfi straight on the official RFI kind — one
    /// form, two dropdown entries.</summary>
    [Parameter] public SystemActionKind Kind { get; set; } = SystemActionKind.RaiseRequest;

    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private string projectId = "";
    private RequestForm? form;

    protected override void OnAfterRender(bool firstRender)
    {
        // Idempotent: SetKind no-ops once the form is already on the kind.
        if (Kind == SystemActionKind.RaiseRfi) form?.PresetKind(RequestType.Rfi);
    }

    private async Task SubmitAsync()
    {
        if (form is not null) await form.TrySubmitAsync();
    }

    private async Task StageAsync(RequestForm.Draft draft)
    {
        var register = RequestRegister;
        var noun = draft.Command.Kind == RequestType.Rfi ? "RFI" : "request";
        var project = Projects.FirstOrDefault(p => p.ProjectId == draft.Command.ProjectId);
        await OnStaged.InvokeAsync(new StagedSystemAction(
            Kind,
            $"raise {noun} \"{draft.Command.Title}\" on {project?.Reference ?? "the project"}",
            async () => await register.RaiseAsync(draft.Command)));
        form?.Reset();
    }
}
