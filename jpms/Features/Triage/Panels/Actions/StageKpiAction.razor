@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Kpi
@using Jewel.JPMS.Features.Kpi
@inject IUserDirectory UserDirectory
@inject ICommandSender Commands
@inject KpiReadModel Kpis
@inject KpiPeopleReadModel People
@implements IDisposable

@* Mark as KPI as a STAGED action (administrators only, 2026-09-03): pick the person the email is
   evidence about — pre-matched from the sender, then the To/Cc list; a portal user, someone
   already on the KPI list, or "Someone else…" typed by name for staff with no login — add an
   optional note, stage; MarkEmailAsKpi runs with the email's Apply. No project: the mark lives
   in the administrators-only register (Admin → KPI emails). The server tags the email JPMS/Admin
   (+ Internal pathway) so it leaves the queue (2026-09-03 — the queue is Inbox-without-a-tag, so
   an untagged KPI email never left it); the tag says nothing about KPIs. How far it spreads is the
   Control Centre's "Entire thread" answer, handed in at Apply via ExecuteWithScopeAsync. *@

<div class="space-y-3">
    <div class="space-y-1">
        <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Filed under</label>
        <KpiPersonPicker @ref="picker" Value="@person" ValueChanged="OnPersonChanged" />
        @if (matchedFrom is not null && person is { Email: not null } && person.Email == matchedEmail)
        {
            <p class="text-xs text-content-subtle">Matched from the email's @matchedFrom — change it if the KPI is about someone else.</p>
        }
    </div>
    <div class="space-y-1">
        <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Note <span class="font-normal normal-case">(optional)</span></label>
        <textarea class="field w-full" rows="2" placeholder="Why this is a KPI — e.g. handled the client's complaint same day"
                  @bind="note" @bind:event="oninput"></textarea>
    </div>
    <p class="text-xs text-content-subtle">Administrators only. The mark goes to Admin → KPI emails, where nobody else can see it; the email is tagged <span class="font-medium">Admin</span> (Internal pathway) so it leaves the queue — the tag doesn't say KPI.</p>
    @if (duplicate is not null)
    {
        <p class="text-xs text-amber-500">@duplicate</p>
    }
    @if (!CanStage)
    {
        <p class="text-xs text-amber-500">@(UserDirectory.IsLoaded ? "Pick the person the KPI is about before staging." : "Waiting for the people list…")</p>
    }
    <button type="button" class="@(CanStage ? "btn-primary" : "btn-primary opacity-50 cursor-not-allowed")" disabled="@(!CanStage)"
            title="@(CanStage ? "Line up the KPI mark for this email's Apply" : "Pick the person first")"
            @onclick="StageAsync">Stage action</button>
</div>

@code {
    /// <summary>The open email's live Graph id and stable internet id.</summary>
    [Parameter, EditorRequired] public string MessageId { get; set; } = "";
    [Parameter] public string? InternetMessageId { get; set; }
    [Parameter] public string EmailSubject { get; set; } = "";
    /// <summary>Sender first, then recipients — the pre-match order.</summary>
    [Parameter] public string SenderEmail { get; set; } = "";
    [Parameter] public IReadOnlyList<string> RecipientEmails { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private KpiPersonPicker? picker;
    private string? duplicate;
    private KpiPersonChoice? person;
    private string note = "";
    private string? matchedEmail;
    private string? matchedFrom;
    private bool prematched;

    protected override void OnInitialized()
    {
        UserDirectory.OnChange += OnDirectoryChanged;
        _ = UserDirectory.All(); // starts the lazy fetch the pre-match waits on
        TryPrematch();
    }

    protected override void OnParametersSet() => TryPrematch();

    private void OnDirectoryChanged()
    {
        TryPrematch();
        StateHasChanged();
    }

    // Once, when the directory is in: the sender if they are a portal user, else the first
    // To/Cc address that is. A choice the administrator has made is never overwritten.
    private void TryPrematch()
    {
        if (prematched || !UserDirectory.IsLoaded) return;
        prematched = true;
        if (Match(SenderEmail) is { } sender)
        {
            person = new KpiPersonChoice(Email: sender.Email);
            matchedEmail = sender.Email;
            matchedFrom = "sender";
            return;
        }
        foreach (var recipient in RecipientEmails)
        {
            if (Match(recipient) is { } user)
            {
                person = new KpiPersonChoice(Email: user.Email);
                matchedEmail = user.Email;
                matchedFrom = "recipients";
                return;
            }
        }
    }

    private DirectoryUser? Match(string? email) =>
        string.IsNullOrWhiteSpace(email) ? null
            : UserDirectory.All().FirstOrDefault(user => string.Equals(user.Email, email.Trim(), StringComparison.OrdinalIgnoreCase));

    private void OnPersonChanged(KpiPersonChoice? choice) => person = choice;

    // Nothing stages without a person: the directory must be in (so the pick is a real one) and
    // a choice made — an id, a portal email, or a typed name that isn't blank.
    private bool CanStage => UserDirectory.IsLoaded && person is { IsEmpty: false }
        && (person.Name is null || !string.IsNullOrWhiteSpace(person.Name));

    [Parameter] public List<StagedSystemAction> StagedActions { get; set; } = new();

    private async Task StageAsync()
    {
        if (!CanStage) return;
        var chosen = person;
        var key = KpiStaging.KeyFor(chosen);
        if (StagedActions.Any(a => a.Kind == SystemActionKind.MarkAsKpi && a.Key == key))
        {
            duplicate = $"Already staged for {picker?.LabelFor(chosen) ?? chosen.Name ?? chosen.Email} — see the list above (or the Tagging tab's KPI people).";
            return;
        }
        duplicate = null;
        var chosenName = picker?.LabelFor(chosen) ?? chosen.Name ?? chosen.Email ?? chosen.PersonId ?? "";
        var chosenNote = note.Trim();
        var messageId = MessageId;
        var internetMessageId = InternetMessageId;
        var commands = Commands;
        var register = Kpis;
        var people = People;
        // The command tags the email, so it runs with the plan's thread scope: ExecuteAsync
        // (scope-less) is the MessageOnly fallback for any caller that doesn't hand one in.
        Func<LinkThreadScope, Task> run = async scope =>
        {
            await commands.SendAsync(
                new MarkEmailAsKpi(messageId, chosen.PersonId, chosen.Email, chosen.Name, chosenNote, internetMessageId, Scope: scope),
                CancellationToken.None);
            // Keep already-loaded lists current (a name-only person is new to the people
            // list); a list never opened stays unfetched.
            try
            {
                if (people.Current is not null) await people.RefreshAsync(CancellationToken.None);
                if (register.Current is not null) await register.RefreshAsync(CancellationToken.None);
            }
            catch { /* the toast has it */ }
        };
        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.MarkAsKpi,
            $"file this email as a KPI under {chosenName} and tag it Admin" + (chosenNote == "" ? "" : $" (“{chosenNote}”)"),
            () => run(LinkThreadScope.MessageOnly))
        { Key = key, ExecuteWithScopeAsync = run });
        note = "";
    }

    public void Dispose() => UserDirectory.OnChange -= OnDirectoryChanged;
}
