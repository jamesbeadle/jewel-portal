@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Procurement
@inject ICommandSender Commands
@inject AuthService Auth
@inject NavigationManager Nav

@* Raise Work Order as a STAGED action: the same WorkOrderForm the work-orders modal uses (core
   order surface — the modal-only packaging and attachment steps stay on its page), snapshotted
   here and fired by the email's Apply. A released order still keeps the modal's promise: its
   purchase-order email goes to the supplier when the action fires (a draft's waits for
   approval); the send outcome is best-effort, the order itself is the act. *@

<div class="space-y-3">
    <div class="flex flex-wrap items-center gap-2">
        <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold shrink-0">Project</label>
        <ProjectSelect Projects="@Projects" Value="@projectId" ValueChanged="v => projectId = v"
                       AllowNone="false" Placeholder="Pick a project…" ToggleTitle="The project the order is raised on" />
    </div>
    @if (projectId != "")
    {
        <WorkOrderForm @ref="form" ProjectId="@projectId" />
        <button type="button" class="btn-primary" @onclick="StageAsync">Stage action</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();
    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private string projectId = "";
    private WorkOrderForm? form;

    private async Task StageAsync()
    {
        if (form is null) return;
        var draft = form.TryBuildDraft();
        if (draft is null) return;

        // Snapshot everything the closure needs NOW — the form is reset the moment this stages.
        var commands = Commands;
        var stagedProjectId = projectId;
        var project = Projects.FirstOrDefault(p => p.ProjectId == stagedProjectId);
        var supplier = form.SelectedSupplier;
        var raisedBy = Auth.CurrentUser?.Email ?? "";
        var baseUri = Nav.BaseUri;

        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.RaiseWorkOrder,
            $"raise {(draft.SaveAsDraft ? "draft " : "")}work order \"{draft.Title}\" to {supplier?.CompanyName ?? "the subcontractor"} on {project?.Reference ?? "the project"}",
            async () =>
            {
                var order = await commands.SendAsync(new CreateManualWorkOrder(
                    stagedProjectId, draft.SubcontractorId, draft.Title, draft.Scope,
                    raisedBy, draft.Lines.ToList(),
                    draft.ProgrammeStart, draft.TargetCompletion, draft.ProgrammeNotes,
                    SaveAsDraft: draft.SaveAsDraft,
                    DepositRequired: draft.DepositRequired,
                    DepositPercent: draft.DepositPercent), CancellationToken.None);

                // The released order's promised PO email — best-effort, same as every other route:
                // the order is already raised, so a failed send never fails the action.
                if (draft.SaveAsDraft || supplier is null || string.IsNullOrWhiteSpace(supplier.ContactEmail)) return;
                var emailLines = draft.Lines
                    .Select(line => new WorkOrderPoEmail.Line(line.Title, 1m, "item", line.Amount))
                    .ToList();
                try
                {
                    await commands.SendAsync(new SendWorkOrderPoEmail(
                        order.WorkOrderId,
                        WorkOrderPoEmail.Subject(order, project?.Name ?? stagedProjectId),
                        WorkOrderPoEmail.Body(order, supplier.CompanyName, emailLines, project?.Name ?? "", baseUri)),
                        CancellationToken.None);
                }
                catch (Exception ex) when (ex is not OperationCanceledException) { /* order raised; send from its PO page */ }
            }));
        form.Reset();
    }
}
