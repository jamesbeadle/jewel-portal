@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Procurement
@inject ICommandSender Commands
@inject AuthService Auth

@* Create Bid Package Invite as a STAGED action: the same CreateBidPackage command the Bid
   Package Invites page's create form sends, snapshotted here and fired by the email's Apply.
   The package lands as a draft; inviting subcontractors and line items live on its page. *@

<div class="space-y-3">
    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@error</p>
    }
    <FormField Label="Title" Value="@title" OnChange="v => title = v" Required="true" />
    <FormField Label="Trade" Value="@trade" OnChange="v => trade = v" />
    <label class="flex items-center gap-2 text-sm text-content cursor-pointer select-none">
        <input type="checkbox" @bind="materialsApplicable" />
        Materials applicable
    </label>
    <button type="button" class="btn-primary" @onclick="StageAsync">Stage action</button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    /// <summary>The email's project, set in the triage bar above the split.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private string title = "";
    private string trade = "";
    private bool materialsApplicable;
    private string? error;

    private async Task StageAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(title)) { error = "A title is required."; return; }

        var commands = Commands;
        var command = new CreateBidPackage(ProjectId, title.Trim(), trade.Trim(),
            Auth.CurrentUser?.Email ?? "", materialsApplicable);
        var project = Projects.FirstOrDefault(p => p.ProjectId == ProjectId);
        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.CreateBidPackageInvite,
            $"create bid package \"{command.Title}\" on {project?.Reference ?? "the project"}",
            async () => await commands.SendAsync(command, CancellationToken.None)));
        title = trade = "";
        materialsApplicable = false;
    }
}
