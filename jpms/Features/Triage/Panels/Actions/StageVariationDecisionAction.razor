@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Commercial
@inject IVariationStore Variations
@inject IIntakeQueue Intake

@* Approve / Reject Variation Order as STAGED actions on the triage bar's project. Approving
   reuses VariationApprovePanel — the exact cost-code/lines build-up the variation page shows —
   with the built ApproveRequest snapshotted and fired by the email's Apply; rejecting stages
   the same RejectAsync the page's status pill sends. *@

<div class="space-y-3">
    @if (error is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@error</p>
    }
    @if (orders is null)
    {
        <p class="text-sm text-content-subtle italic">Loading the project's variations…</p>
    }
    else
    {
        <select class="field" value="@variationOrderId" @onchange="OnVariationPicked">
            <option value="">@(Candidates.Count == 0 ? $"No {CandidateNoun} on this project" : "Select a variation…")</option>
            @foreach (var order in Candidates)
            {
                <option value="@order.VariationOrderId">@order.DisplayNumber — @order.Title</option>
            }
        </select>
    }

    @if (Kind == SystemActionKind.ApproveVariationOrder && Picked is { } picked)
    {
        @* Keyed per variation so the build-up seeds fresh from its estimate. *@
        <VariationApprovePanel @key="picked.VariationOrderId"
                               IsManual="true" ShowHeading="false"
                               EstimatedValue="@picked.EstimatedValue"
                               DefaultDescription="@picked.Title"
                               SubmitLabel="Stage action"
                               HelpOverride="Staged, not sent: the approval fires when the email's triage is applied."
                               OnApprove="StageApproveAsync" />
    }
    else if (Kind == SystemActionKind.RejectVariationOrder)
    {
        <button type="button" class="btn-primary" disabled="@(Picked is null)" @onclick="StageRejectAsync">Stage action</button>
    }
</div>

@code {
    /// <summary>The email's project, set in the triage bar above the split.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>ApproveVariationOrder or RejectVariationOrder — one picker, two decisions.</summary>
    [Parameter] public SystemActionKind Kind { get; set; }

    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private string loadedProjectId = "";
    private string variationOrderId = "";
    // Null until the project's variations have landed — distinct from an empty answer.
    private IReadOnlyList<VariationOrder>? orders;
    private string? error;

    // The triage bar owns the project; reload this project's variations when it changes hands.
    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == loadedProjectId) return;
        loadedProjectId = ProjectId;
        variationOrderId = "";
        orders = null;
        error = null;
        if (ProjectId == "") return;
        try { orders = await Variations.ListForProjectAsync(ProjectId); }
        catch { orders = Array.Empty<VariationOrder>(); error = "Couldn't load the project's variations. Please try again."; }
    }

    private void OnVariationPicked(ChangeEventArgs e) => variationOrderId = e.Value?.ToString() ?? "";

    // Approval takes anything not yet approved or rejected; rejection anything not yet rejected —
    // the same reach the variation page's status pill offers.
    private IReadOnlyList<VariationOrder> Candidates =>
        (orders ?? Array.Empty<VariationOrder>())
            .Where(order => Kind == SystemActionKind.ApproveVariationOrder
                ? order.Status is not (VariationOrderStatus.Approved or VariationOrderStatus.Rejected)
                : order.Status != VariationOrderStatus.Rejected)
            .ToList();

    private string CandidateNoun => Kind == SystemActionKind.ApproveVariationOrder
        ? "unapproved variation" : "rejectable variation";

    private VariationOrder? Picked =>
        Candidates.FirstOrDefault(order => order.VariationOrderId == variationOrderId);

    private async Task StageApproveAsync(VariationApprovePanel.ApproveRequest request)
    {
        if (Picked is not { } picked) return;
        var variations = Variations;
        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.ApproveVariationOrder,
            $"approve {picked.DisplayNumber} at {request.Total.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"))}",
            async () => await variations.ApproveAsync(picked.VariationOrderId, request.PrimaryCostCode, request.Total, request.Lines),
            await TargetFor(picked)));
        variationOrderId = "";
    }

    private async Task StageRejectAsync()
    {
        if (Picked is not { } picked) return;
        var variations = Variations;
        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.RejectVariationOrder,
            $"reject {picked.DisplayNumber}",
            async () => await variations.RejectAsync(picked.VariationOrderId),
            await TargetFor(picked)));
        variationOrderId = "";
    }

    // The decision fires on an existing variation, so its tag rides along (PathwayActionsSection
    // stages the pick into System Tags) — approving V87 from an email files the email against
    // V87. The server's own projection is fetched rather than hand-built: a not-yet-approved
    // variation links under its stable quoting-stage identity (the VOQ- tag stem), and only the
    // provider knows which identity a row carries. Links land before actions run in the page's
    // Apply, so the tag stem staged here is the record's identity at apply time — and the
    // variation page reads both stems' mail either way.
    private async Task<LinkableRecord?> TargetFor(VariationOrder picked)
    {
        try
        {
            var records = await Intake.ListLinkableRecordsAsync(picked.ProjectId, RecordType.Variation);
            return records.FirstOrDefault(r => r.RecordId == picked.VariationOrderId);
        }
        catch { return null; } // the action still stages; only the automatic tag is lost
    }
}
