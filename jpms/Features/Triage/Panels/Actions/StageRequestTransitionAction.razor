@namespace Jewel.JPMS.Features.Triage.Panels
@implements IDisposable
@inject IRequestRegister RequestRegister
@inject AuthService Auth
@inject IIntakeQueue Intake

@* Promote Request to RFI / Close RFI / Reopen RFI as STAGED actions: pick the target record on
   the triage bar's project, stage; the same store calls the request page's buttons make fire
   with the email's Apply (closing still goes through the agent gate — a blocked close fails the
   apply with the agents' reason, exactly as the page would refuse it). *@

<div class="space-y-3">
    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }
    @* SearchSelect rather than a native select: the register runs long, so the record is found
       by typing (matches reference and title), the list opens downward whenever it fits, and
       the options read in reference-number order rather than the store's arrival order. *@
    <SearchSelect Options="@CandidateOptions"
                  WidthClass="w-full" InputClass="field"
                  Disabled="@(Candidates.Count == 0)"
                  Placeholder="@(ProjectId == "" ? "Pick the email's project in the bar above first…"
                                 : Candidates.Count == 0 ? $"No {CandidateNoun} on this project"
                                 : $"Select a {CandidateNoun}…")"
                  @bind-Value="requestId" />

    @if (Kind == SystemActionKind.CloseRfi)
    {
        <div class="flex flex-wrap items-center gap-2">
            <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold shrink-0">Closed date</label>
            <input type="date" class="field max-w-[12rem]" @bind="closeDate" />
        </div>
    }

    <button type="button" class="btn-primary" disabled="@(requestId == "")" @onclick="StageAsync">Stage action</button>
</div>

@code {
    /// <summary>The email's project, set in the triage bar above the split.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>PromoteRequestToRfi, CloseRfi or ReopenRfi — one picker, three transitions.</summary>
    [Parameter] public SystemActionKind Kind { get; set; }

    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private string loadedProjectId = "";
    private string requestId = "";
    private DateTime? closeDate = DateTime.Today;
    private string? error;

    protected override void OnInitialized() => RequestRegister.OnChange += StoreChanged;
    public void Dispose() => RequestRegister.OnChange -= StoreChanged;
    private void StoreChanged() => InvokeAsync(StateHasChanged);

    // The triage bar owns the project; react when it changes hands.
    protected override void OnParametersSet()
    {
        if (ProjectId == loadedProjectId) return;
        loadedProjectId = ProjectId;
        requestId = "";
        error = null;
        if (ProjectId != "") RequestRegister.Refresh(ProjectId); // stale-while-revalidate, never from render
    }

    // Which records the transition can touch: promotion takes an unpromoted General container;
    // closing takes anything not yet closed; reopening takes what is closed. Always presented in
    // reference-number order (REQ-009 before REQ-012, prefixes grouped) — the store's order is
    // arrival order, which reads as random in a picker.
    private IReadOnlyList<Request> Candidates => (Kind switch
    {
        SystemActionKind.PromoteRequestToRfi => RequestRegister.ForProject(ProjectId)
            .Where(request => request.Kind == RequestType.General && request.Status != RequestStatus.Closed),
        SystemActionKind.CloseRfi => RequestRegister.ForProject(ProjectId)
            .Where(request => request.Status != RequestStatus.Closed),
        _ => RequestRegister.ForProject(ProjectId)
            .Where(request => request.Status == RequestStatus.Closed)
    })
        .OrderBy(request => ReferenceSortKey(request).Prefix, StringComparer.OrdinalIgnoreCase)
        .ThenBy(request => ReferenceSortKey(request).Number)
        .ThenBy(request => request.Reference, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<SearchSelect.Option> CandidateOptions =>
        Candidates.Select(request => new SearchSelect.Option(
            request.RequestId, $"{request.Reference} — {request.Title}")).ToList();

    // "REQ-012" → ("REQ", 12); suffixed references still parse ("RFI-049A" → 49); anything not
    // shaped {prefix}-{digits} sorts after the numbered entries under its own prefix.
    private static (string Prefix, int Number) ReferenceSortKey(Request request)
    {
        var reference = request.Reference?.Trim() ?? string.Empty;
        var dash = reference.IndexOf('-');
        if (dash <= 0) return (reference, int.MaxValue);
        var digits = new string(reference[(dash + 1)..].TakeWhile(char.IsDigit).ToArray());
        return (reference[..dash], int.TryParse(digits, out var number) ? number : int.MaxValue);
    }

    private string CandidateNoun => Kind switch
    {
        SystemActionKind.PromoteRequestToRfi => "General request",
        SystemActionKind.CloseRfi => "open request / RFI",
        _ => "closed request / RFI"
    };

    private async Task StageAsync()
    {
        error = null;
        var picked = Candidates.FirstOrDefault(request => request.RequestId == requestId);
        if (picked is null) { error = "Pick the record first."; return; }
        DateTimeOffset? closedAt = null;
        if (Kind == SystemActionKind.CloseRfi)
        {
            if (closeDate is not { } chosen) { error = "A close date is required."; return; }
            if (chosen.Date > DateTime.Today) { error = "The closed date cannot be in the future."; return; }
            closedAt = new DateTimeOffset(DateTime.SpecifyKind(chosen.Date, DateTimeKind.Utc));
        }
        await OnStaged.InvokeAsync(new StagedSystemAction(
            Kind, SummaryFor(picked, closedAt), ExecutorFor(picked, closedAt), await TargetFor(picked)));
        requestId = "";
    }

    // The action fires on an existing record, so its tag rides along (PathwayActionsSection stages
    // the pick into System Tags) — actioning REQ-0012 from an email files the email against
    // REQ-0012. The server's own projection is fetched rather than hand-built here: tag stems
    // are provider business (project-qualified), and a guessed stem would silently detach mail.
    private async Task<LinkableRecord?> TargetFor(Request picked)
    {
        try
        {
            var records = await Intake.ListLinkableRecordsAsync(picked.ProjectId, RecordType.Request);
            return records.FirstOrDefault(r => r.RecordId == picked.RequestId);
        }
        catch { return null; } // the action still stages; only the automatic tag is lost
    }

    private string SummaryFor(Request picked, DateTimeOffset? closedAt) => Kind switch
    {
        SystemActionKind.PromoteRequestToRfi => $"promote {picked.Reference} to an RFI",
        SystemActionKind.CloseRfi => $"close {picked.Reference} (dated {closedAt!.Value.LocalDateTime:d MMM yyyy})",
        _ => $"reopen {picked.Reference}"
    };

    private Func<Task> ExecutorFor(Request picked, DateTimeOffset? closedAt)
    {
        var register = RequestRegister;
        var email = Auth.CurrentUser?.Email;
        return Kind switch
        {
            SystemActionKind.PromoteRequestToRfi => async () =>
                await register.PromoteToRfiAsync(picked.RequestId, picked.ProjectId),

            SystemActionKind.CloseRfi => async () =>
            {
                var closed = await register.CloseAsync(picked.RequestId, picked.ProjectId, closedAt!.Value);
                if (!closed)
                    throw new CommandFailedException($"{picked.Reference} no longer exists.");
            },

            // Reopening puts the ball back in our court — the same UpdateRequestDetails the page
            // sends, re-read at fire time so no other field is clobbered by a stale copy.
            _ => async () =>
            {
                var current = await register.GetAsync(picked.RequestId)
                    ?? throw new CommandFailedException($"{picked.Reference} no longer exists.");
                await register.UpdateAsync(new UpdateRequestDetails(
                    current.RequestId, current.Reference, current.Title, current.Description,
                    RequestStatus.NeedsAction, current.Value, current.ResponseText,
                    current.RespondedByEmail ?? email, current.ImpliesVariation, current.DrawingRef,
                    current.ResponseDue, current.RelatedDrawingSpec, current.InternalNotes, current.ClientNotes));
            }
        };
    }
}
