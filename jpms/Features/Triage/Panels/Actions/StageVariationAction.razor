@namespace Jewel.JPMS.Features.Triage.Panels
@inject IVariationStore Variations

@* Raise Variation Order as a STAGED action: the same ManualVariationForm the variations page's
   dialog uses — priced lines up front (2026-09-14) — snapshotted here and fired by the email's
   Apply. Lands in Issued with its build-up staged, like every manual variation, on the triage
   bar's project. "Approve on apply" stages ONE action that creates the variation and then runs
   the real approval on the same lines (V-ref minted, valuation report / CVR / budget written
   through), so a retrospective or client-instructed variation never waits for a second pass. *@

<div class="space-y-3">
    <ManualVariationForm @ref="form" ShowIntro="@(!approveOnApply)" OnSubmit="StageAsync" />

    <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none"
           title="Apply creates the variation and approves it in the same run — the V-ref is minted and the lines above write through to the valuation report, CVR and cost-centre budgets, exactly as if you'd opened it and used Approve manually & raise VO">
        <input type="checkbox" class="cursor-pointer align-middle" checked="@approveOnApply"
               @onchange="e => approveOnApply = e.Value is true" />
        Approve on apply — create it and approve it in one go
    </label>

    @if (approveOnApply)
    {
        <p class="text-xs text-content-subtle">
            Staged, not sent: Apply creates the variation, mints its V-ref and writes the lines above to the
            valuation report, CVR and cost-centre budgets.
        </p>
    }

    <button type="button" class="btn-primary" disabled="@(ProjectId == "")"
            title="@(ProjectId == "" ? "Pick the email's project in the bar above first — the variation is raised on it" : null)"
            @onclick="SubmitAsync">Stage action</button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    /// <summary>The email's project, set in the triage bar above the split.</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    [Parameter] public EventCallback<StagedSystemAction> OnStaged { get; set; }

    private ManualVariationForm? form;
    private bool approveOnApply;

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");

    private async Task SubmitAsync()
    {
        if (form is not null) await form.TrySubmitAsync();
    }

    private async Task StageAsync(ManualVariationForm.Draft draft)
    {
        // The editor renders before the project auto-match lands (2026-08-28) — a variation must
        // never stage against a blank project, whatever route the submit took.
        if (ProjectId == "") return;
        var variations = Variations;
        var stagedProjectId = ProjectId;
        var project = Projects.FirstOrDefault(p => p.ProjectId == stagedProjectId);
        var approve = approveOnApply;

        await OnStaged.InvokeAsync(new StagedSystemAction(
            SystemActionKind.RaiseVariationOrder,
            approve
                ? $"raise and approve variation \"{draft.Title}\" at {draft.Total.ToString("C2", Gb)} on {project?.Reference ?? "the project"}"
                : $"raise variation \"{draft.Title}\" at {draft.Total.ToString("C2", Gb)} on {project?.Reference ?? "the project"}",
            async () =>
            {
                var created = await variations.CreateManualAsync(
                    stagedProjectId, draft.Title, draft.Description, draft.Lines, draft.Number,
                    draft.CommercialBasis, draft.ProgrammeImpact, draft.Exclusions);
                // Approval consumes the same build-up the creation staged — the first line's cost
                // centre is the primary, exactly as the approve modal would send it.
                if (approve)
                    await variations.ApproveAsync(created.VariationOrderId, draft.Lines[0].CostCode, draft.Total, draft.Lines);
            }));
        approveOnApply = false;
        form?.Reset();
    }
}
