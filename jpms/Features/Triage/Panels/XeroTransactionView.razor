@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.Xero

@*
    One Xero transaction read in full — the header facts, the money, and the line items with
    their site / cost-code tracking, sized for a workspace window.
*@

<div class="space-y-3">
    <button type="button" class="text-xs text-content-muted hover:text-content underline underline-offset-2"
            @onclick="OnBack">← Back to search</button>

    <div class="panel p-5 space-y-3">
        <div>
            <p class="eyebrow mb-1">@XeroExplorerPane.TypeLabel(Transaction.Type) · @Transaction.Status</p>
            <h2 class="text-lg font-semibold text-content leading-snug">@(Transaction.ContactName ?? "(no contact)")</h2>
            <p class="font-mono text-xs text-content-muted mt-0.5">@(Transaction.Number ?? Transaction.Reference ?? Transaction.TransactionId)</p>
        </div>

        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
            <span class="text-content-subtle">Date</span><span class="text-content">@DateText(Transaction.Date)</span>
            <span class="text-content-subtle">Due</span><span class="text-content">@DateText(Transaction.DueDate)</span>
            <span class="text-content-subtle">Subtotal</span><span class="text-content tabular-nums">@Money(Transaction.SubTotal)</span>
            <span class="text-content-subtle">Tax</span><span class="text-content tabular-nums">@Money(Transaction.TotalTax)</span>
            <span class="text-content-subtle">Total</span><span class="text-content tabular-nums font-medium">@Money(Transaction.Total)</span>
            <span class="text-content-subtle">Paid / due</span><span class="text-content tabular-nums">@Money(Transaction.AmountPaid) / @Money(Transaction.AmountDue)</span>
        </div>
    </div>

    @if (Transaction.Lines.Count > 0)
    {
        <div class="panel p-4">
            <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
                @Transaction.Lines.Count line item@(Transaction.Lines.Count == 1 ? "" : "s")
            </p>
            <div class="divide-y divide-line">
                @foreach (var line in Transaction.Lines)
                {
                    <div class="py-2 flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="text-sm text-content">@(string.IsNullOrWhiteSpace(line.Description) ? "(no description)" : line.Description)</p>
                            <p class="text-[11px] text-content-subtle mt-0.5">
                                @(line.AccountName ?? line.AccountCode ?? "—")@(line.Site is { Length: > 0 } site ? $" · {site}" : "")@(line.CostCode is { Length: > 0 } code ? $" · {code}" : "")
                            </p>
                        </div>
                        <span class="text-sm text-content tabular-nums shrink-0">@Money(line.LineAmount)</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public XeroTransaction Transaction { get; set; } = default!;
    [Parameter] public EventCallback OnBack { get; set; }

    private string Money(decimal value) =>
        $"{CurrencySymbol}{value:N2}";

    private string CurrencySymbol =>
        Transaction.CurrencyCode is null or "GBP" ? "£" : Transaction.CurrencyCode + " ";

    private static string DateText(DateTime? value) => value?.ToString("d MMM yyyy") ?? "—";
}
