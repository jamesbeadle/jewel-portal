@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Features.Triage
@inject IIntakeQueue Intake

@* The Compose window: a fresh outbound thread from the projects mailbox (was the New email
   modal). The pane owns its whole form — envelope, body, attachments, the optional file-to-a-
   record picks and the send itself; the host page only learns two things: the pane wants its
   window closed (Cancel, or a send that just completed) and a send's outcome for the page
   banner. The workspace keeps every once-shown pane rendered, so a half-written email survives
   swapping the window to other panes and back. *@
<div class="panel p-5">
    <h2 class="text-base font-semibold text-content mb-4">New email</h2>
    <div class="space-y-3">
    <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
        Sends from the <span class="font-medium text-content">projects mailbox</span>. Optionally file it to a record so the sent copy shows in that record's correspondence — replies will arrive in the queue either way.
    </p>

    @if (error is not null)
    {
        <Notice Tone="Tone.Negative">@error</Notice>
    }

    <div>
        <FormField Label="To" Required>
        <RecipientInput Value="@toField" ValueChanged="value => toField = value" />
        </FormField>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
            <FormField Label="Cc">
            <RecipientInput Value="@ccField" ValueChanged="value => ccField = value" Placeholder="Copied recipients" />
            </FormField>
        </div>
        <div>
            <FormField Label="Bcc">
            <RecipientInput Value="@bccField" ValueChanged="value => bccField = value" Placeholder="Blind-copied recipients" />
            </FormField>
        </div>
    </div>
    <div>
        <FormField Label="Subject" Required>
        <input class="field" type="text" value="@subject" @oninput="e => subject = e.Value?.ToString() ?? string.Empty" />
        </FormField>
    </div>
    <div>
        <FormField Label="Message" Required>
        <RichTextEditor @bind-Value="body" MinHeight="200" Placeholder="Write the email…" />
        </FormField>
    </div>

    <AttachmentPicker Attachments="attachments" AttachmentsChanged="picked => attachments = picked"
                      Projects="ProjectOptionsFor(projectId)" ProjectId="@projectId" />

    <div class="rounded border border-line p-3 space-y-2">
        <label class="flex items-center gap-2 text-sm text-content">
            <input type="checkbox" checked="@fileToRecord" @onchange="OnFileToggled" />
            File this email to a record (the sent copy shows in its correspondence)
        </label>
        @if (fileToRecord)
        {
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <select class="field" value="@projectId" @onchange="OnProjectChanged">
                    <option value="">Select a project…</option>
                    @foreach (var project in ProjectOptionsFor(projectId))
                    {
                        <option value="@project.ProjectId">@project.Reference — @project.Name</option>
                    }
                </select>
                <select class="field" value="@((int)recordType)" @onchange="OnRecordTypeChanged">
                    @foreach (var option in LinkableRecordTypes)
                    {
                        <option value="@((int)option)">@RecordTypeLabel(option)</option>
                    }
                </select>
                <select class="field" value="@recordId" @onchange="e => recordId = e.Value?.ToString() ?? string.Empty" disabled="@(string.IsNullOrEmpty(projectId))">
                    <option value="">@(string.IsNullOrEmpty(projectId) ? "Select a project first…" : recordsLoading ? "Loading…" : "Select a record…")</option>
                    @foreach (var record in records)
                    {
                        <option value="@record.RecordId">@record.Reference — @record.Title</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" class="btn-ghost" disabled="@busy" @onclick="Close">Cancel</button>
        <button type="button" class="btn-secondary" disabled="@(busy || !IsSendable)" @onclick="() => SendAsync(saveAsDraftOnly: true)">Save as draft</button>
        <button type="button" class="btn-primary" disabled="@(busy || !IsSendable)" @onclick="() => SendAsync(saveAsDraftOnly: false)">@(busy ? "Sending…" : "Send")</button>
    </div>
    </div>
</div>
