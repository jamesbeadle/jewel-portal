@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Features.Triage.Workspace
@inject IIntakeQueue Intake

@*
    The subcontractor communications browser: every email tagged with the SubComms family — general
    subcontractor correspondence plus its categories (Chaser / Info request / Materials / H&S),
    filed at triage with the Subcontractor tab's communication ticks — read live from the mailbox,
    newest thread first, narrowable to one category by the chip row. A workspace pane rather than
    the standalone page so it reads SIDE BY SIDE with a compose or an open email: browse a subbie's
    thread one window, copy and paste into the reply the other. Each email offers Reply and Forward,
    lined up in the Outbox and sent by the triage's Apply. Untagging stays on the Tagged view.

    Tagging happens HERE too (Nigel, 2026-08-22): when a queue email is open the pane leads with the
    communication ticks — the same ticks System Tags → Subcontractor shows — and every listed email
    offers "Tag open email like this", which stages the open email with that email's communication
    tags. The list narrows to the open email's project by name match (record-less tags carry no
    project), with an "All projects" switch back to the whole feed.
*@

<div class="space-y-3">
    @if (HasOpenEmail)
    {
        <div class="rounded-lg border border-accent/40 bg-accent/5 p-3 space-y-2">
            <p class="text-xs uppercase tracking-wider text-accent font-semibold">Tag the open email</p>
            <p class="text-xs text-content-subtle truncate" title="@EmailSubject">@EmailSubject</p>
            <SubcontractorCommsTicks Picked="Picked" OnStagingChanged="OnStagingChanged" />
            <p class="text-xs text-content-subtle">Ticks stage the open email — the inbox's Apply files it. Or press "Tag open email like this" on any email below.</p>
        </div>
    }

    <header>
        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Subcontractor communications</p>
        @if (loaded && loadError is null && total > 0)
        {
            <p class="text-sm text-content-muted mt-1">
                @total email@(total == 1 ? "" : "s") @(categoryTagFilter is null ? "tagged as subcontractor communication" : $"tagged {ActiveFilterLabel}").
            </p>
        }
    </header>

    @* The category chips — a filter control, so never gated: rendered from the contracts constant
       alone, usable before the first page lands. *@
    <div class="flex flex-wrap items-center gap-1.5">
        <button type="button" class="@ChipClass(null)" title="Every subcontractor communication, whatever its category"
                @onclick="() => SetCategoryFilterAsync(null)">All</button>
        @foreach (var familyRecord in SubcontractorComms.All)
        {
            var familyTag = $"JPMS/{familyRecord.TagReference}";
            var chipLabel = familyRecord.RecordId == SubcontractorComms.RecordId ? "General" : familyRecord.Title;
            <button type="button" @key="familyRecord.RecordId" class="@ChipClass(familyTag)" title="@familyRecord.Summary"
                    @onclick="() => SetCategoryFilterAsync(familyTag)">@chipLabel</button>
        }
    </div>

    @if (ProjectNameMatch.IsUsable(ProjectName))
    {
        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="@ScopeChipClass(isThisProject: true)" title="Emails that name this project in their subject or opening line"
                    @onclick="() => showAllProjects = false">This project · @ProjectName</button>
            <button type="button" class="@ScopeChipClass(isThisProject: false)" title="Every subcontractor communication, whatever the project"
                    @onclick="() => showAllProjects = true">All projects</button>
        </div>
    }

    @if (loadError is not null)
    {
        <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative">@loadError</p>
    }

    @if (!loaded)
    {
        <JewelSpinner Label="Loading communications" />
    }
    else if (items.Count == 0)
    {
        @* A failed fetch leaves the list empty; the banner above says so, and "nothing tagged
           yet" would read as an answer rather than a failure. *@
        @if (loadError is null)
        {
            <div class="panel p-6 text-center">
                <p class="text-sm text-content">@(categoryTagFilter is null ? "No subcontractor communications yet." : $"Nothing tagged {ActiveFilterLabel} yet.")</p>
                <p class="text-xs text-content-subtle mt-1">
                    Tick "Subcontractor communication" — or one of its categories — in System Tags and the thread appears here.
                </p>
            </div>
        }
    }
    else
    {
        <input class="field" type="search" placeholder="Filter by sender or subject…"
               value="@filter" @oninput="e => filter = e.Value?.ToString() ?? string.Empty" />

        @if (Filtered.Count == 0)
        {
            <p class="text-sm text-content-subtle">
                @(IsScopedToProject ? $"No loaded email names {ProjectName}" : $"No loaded email matches \"{filter}\"")@(nextCursor is not null ? " — try loading more below" : "")@(IsScopedToProject ? ", or switch to All projects" : "").
            </p>
        }
        else
        {
            <CorrespondenceThreadList Emails="Filtered" ExcludeTag="@ImpliedTag" OnPreview="OnPreview" OnReply="OnReply" OnForward="OnForward"
                                      OnTagLike="TagLikeWhenEmailOpen" />
        }

        @if (nextCursor is not null)
        {
            <div class="text-center">
                <button type="button" class="btn-secondary text-sm" disabled="@loadingMore" @onclick="LoadMoreAsync">
                    @(loadingMore ? "Loading…" : "Load more")
                </button>
            </div>
        }
    }
</div>

@code {
    private const int PageSize = 25;

    /// <summary>Opens an email attachment in the workspace Preview pane, opposite this window.</summary>
    [Parameter] public EventCallback<PreviewRequest> OnPreview { get; set; }

    /// <summary>Start a reply to a listed email — the page lines it up in the Outbox.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnReply { get; set; }

    /// <summary>Start a forward of a listed email — the page lines it up in the Outbox.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnForward { get; set; }

    /// <summary>The open queue email's subject — blank when none is open, which hides the tagging
    /// box and the per-email "tag like this" buttons.</summary>
    [Parameter] public string EmailSubject { get; set; } = "";

    /// <summary>The open email's project name (the triage bar's pick) — drives the
    /// "This project / All projects" scope. Blank or too short = no scope chips.</summary>
    [Parameter] public string ProjectName { get; set; } = "";

    /// <summary>The page-owned staged picks — the SAME list System Tags mutates, so a tick here
    /// and a tick there are one staged list, one badge, one Apply.</summary>
    [Parameter] public List<LinkableRecord> Picked { get; set; } = new();
    [Parameter] public EventCallback OnStagingChanged { get; set; }

    private bool HasOpenEmail => !string.IsNullOrWhiteSpace(EmailSubject);
    private bool showAllProjects;
    private bool IsScopedToProject => ProjectNameMatch.IsUsable(ProjectName) && !showAllProjects;

    private string ScopeChipClass(bool isThisProject) => ChipClassFor(isActive: isThisProject != showAllProjects);

    // The list only offers "tag like this" while there is an open email to tag.
    private EventCallback<MailboxMessage> TagLikeWhenEmailOpen =>
        HasOpenEmail ? EventCallback.Factory.Create<MailboxMessage>(this, TagOpenEmailLikeAsync) : default;

    // "Tag open email like this": every communication-family tag the listed email carries becomes
    // a pick for the open email (general when it carries none the family recognises).
    private async Task TagOpenEmailLikeAsync(MailboxMessage listed)
    {
        var family = SubcontractorComms.All
            .Where(record => listed.Categories.Contains($"JPMS/{record.TagReference}", StringComparer.OrdinalIgnoreCase))
            .ToList();
        if (family.Count == 0) family.Add(SubcontractorComms.Record);
        foreach (var record in family.Where(record => Picked.All(picked => picked.RecordId != record.RecordId)))
            Picked.Add(record);
        await OnStagingChanged.InvokeAsync();
    }

    // `loaded` opens the gate whether the fetch landed or failed (the banner says which);
    // the list itself accumulates pages like the Tagged view does.
    private readonly List<MailboxMessage> items = new();
    private bool loaded;
    private bool loadingMore;
    private string? loadError;
    private int total;
    private string? nextCursor;
    private string filter = "";

    protected override Task OnInitializedAsync() => LoadPageAsync(cursor: null);

    // A quick narrowing over the pages fetched so far — sender, subject or opening line. The
    // thread grouping happens after the filter, so a matching reply still surfaces its card.
    private IReadOnlyList<MailboxMessage> Filtered
    {
        get
        {
            var needle = filter.Trim();
            var inScope = IsScopedToProject
                ? items.Where(email => ProjectNameMatch.Mentions(email, ProjectName))
                : items;
            if (needle.Length == 0) return inScope.ToList();
            return inScope.Where(email =>
                    email.Subject.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || email.FromName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || email.FromEmail.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || email.BodyPreview.Contains(needle, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // The category filter (2026-08-17): null = the whole family (general + every category), or one
    // family tag from the chip row.
    private string? categoryTagFilter;

    private IReadOnlyList<string> TagsToRead =>
        categoryTagFilter is null
            ? SubcontractorComms.Tags
            : new[] { categoryTagFilter };

    // The tag a listed email's chip row may omit: it is this list's premise. Under "All" only the
    // general tag is implied — a category tag on a card is information, not noise.
    private string ImpliedTag => categoryTagFilter ?? SubcontractorComms.Tag;

    // Switching chip resets the list BEFORE the fetch: a failed re-query must not leave the old
    // filter's emails (or its Graph cursor — "Load more" would mix filters) under the new chip.
    private async Task SetCategoryFilterAsync(string? tag)
    {
        if (categoryTagFilter == tag) return;
        categoryTagFilter = tag;
        loaded = false;
        items.Clear();
        total = 0;
        nextCursor = null;
        await LoadPageAsync(cursor: null);
    }

    private string ActiveFilterLabel =>
        SubcontractorComms.All
            .Where(record => $"JPMS/{record.TagReference}" == categoryTagFilter)
            .Select(record => record.RecordId == SubcontractorComms.RecordId ? "General" : record.Title)
            .FirstOrDefault() ?? "";

    private string ChipClass(string? tag) => ChipClassFor(isActive: categoryTagFilter == tag);

    private static string ChipClassFor(bool isActive) =>
        "rounded-full border px-3 py-1 text-xs font-medium transition "
        + (isActive
            ? "border-accent bg-accent/10 text-accent"
            : "border-line text-content-muted hover:text-content hover:border-line-strong");

    // Two quick chip clicks race their fetches; whichever response lands LAST would win, chip or
    // not. The sequence number says which request is current — a stale response changes nothing.
    private int loadSequence;

    // One live read of the tagged mail, newest first — the same query the Tagged view and the
    // Subcontractor folder's Communications page use, narrowed to the communication family (or the
    // one category the chip row picked).
    private async Task LoadPageAsync(string? cursor)
    {
        var sequence = ++loadSequence;
        loadError = null;
        try
        {
            var page = await Intake.ListTaggedLiveAsync(
                cursor, PageSize, TagsToRead, newestFirst: true);
            if (sequence != loadSequence) return;
            if (cursor is null) items.Clear();
            items.AddRange(page.Items);
            total = page.Total;
            nextCursor = page.NextCursor;
        }
        catch
        {
            if (sequence != loadSequence) return;
            loadError = "Couldn't load the communications. Please try again.";
        }
        finally
        {
            if (sequence == loadSequence) loaded = true;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (nextCursor is null || loadingMore) return;
        loadingMore = true;
        try { await LoadPageAsync(nextCursor); }
        finally { loadingMore = false; }
    }
}
