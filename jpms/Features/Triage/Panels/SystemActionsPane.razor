@namespace Jewel.JPMS.Features.Triage.Panels

@*
    System actions — THE creation surface for triage: line up records and actions against the email
    being triaged, fired when its Apply runs (System Tags is tagging only — linking the email to
    records that already exist). Two families share the dropdown:
    - Email-linked creates (Raise RFI, Raise Work Order, Create Bid Package Invite,
      Raise Defect, Create To-do Items): drafted into page-owned staging and raised by Apply
      through the intake commands, so the EMAIL IS TAGGED to the new record.
    - Staged store calls (RFI transitions, variations, to-do completion, directory contact):
      each reuses the component or store call its home page uses, snapshotted as a closure at
      stage time. When the call fires on an EXISTING record (a transition, a variation decision,
      a to-do marked done), staging it also
      stages that record's tag into the page's System Tags picks — actioning a record from an
      email files the email against it, so the record's correspondence shows the email that
      caused the action. Removing the action removes the tag it added (and only that one).
*@

<div class="panel p-5 space-y-4">
    <div>
        <p class="eyebrow mb-1">System actions</p>
        <h2 class="text-base font-semibold text-content">Line up actions for when triage completes</h2>
    </div>

    @if (StagedActions.Count > 0 || StagedCreate is not null || TitledTodoRows.Count > 0 || CreatedRecords.Count > 0)
    {
        <div class="space-y-1.5">
            @* Records already raised from this email (Create now, or an earlier apply's create):
               done facts, not staged work — green, with the minted reference. *@
            @foreach (var created in CreatedRecords)
            {
                <div class="flex items-center gap-3 rounded-lg border border-positive/40 bg-positive/5 px-3 py-2">
                    <p class="text-sm text-content min-w-0">
                        <span class="text-xs uppercase tracking-wider text-positive font-semibold mr-2">✓ @created.Reference</span>
                        <span class="text-content-muted truncate">@created.Label@(string.IsNullOrWhiteSpace(created.Title) ? "" : $" — {created.Title}") — raised; this email is tagged to it.</span>
                    </p>
                </div>
            }
            @foreach (var staged in StagedActions.ToList())
            {
                var action = staged;
                <div class="flex items-center justify-between gap-3 rounded-lg border border-accent/40 bg-accent/5 px-3 py-2">
                    <p class="text-sm text-content min-w-0">
                        <span class="text-xs uppercase tracking-wider text-accent font-semibold mr-2">@SystemActionKinds.Label(action.Kind)</span>
                        <span class="text-content-muted">Will @action.Summary.@(TargetIsTagged(action) ? " This email is tagged to it." : "")</span>
                    </p>
                    <button type="button" class="text-xs text-content-subtle hover:text-negative shrink-0"
                            @onclick="() => RemoveAsync(action)">Remove</button>
                </div>
            }
            @if (StagedCreate is { } stagedRecord)
            {
                <div class="flex items-center justify-between gap-3 rounded-lg border border-accent/40 bg-accent/5 px-3 py-2">
                    <p class="text-sm text-content min-w-0">
                        <span class="text-xs uppercase tracking-wider text-accent font-semibold mr-2">✚ @stagedRecord.Label</span>
                        <span class="text-content-muted truncate">@(string.IsNullOrWhiteSpace(stagedRecord.DisplayTitle) ? "(untitled)" : stagedRecord.DisplayTitle) — this email is tagged to it.</span>
                    </p>
                    <div class="flex items-center gap-3 shrink-0">
                        @* Create now: raise the record immediately (email tagged to it in the same
                           act) instead of waiting for Apply — so the new record exists and can be
                           worked with (named in the reply, linked elsewhere) mid-triage. The page
                           validates readiness and says what's missing in its red bar. *@
                        <button type="button" class="btn-secondary text-xs"
                                disabled="@Busy"
                                title="Raise this record immediately — the email is tagged to it now, and the rest of the triage still lands with Apply"
                                @onclick="() => OnCreateNow.InvokeAsync()">Create now</button>
                        <button type="button" class="text-xs text-content-subtle hover:text-negative"
                                @onclick="ClearStagedCreateAsync">Remove</button>
                    </div>
                </div>
            }
            @foreach (var todoChipRow in TitledTodoRows)
            {
                var chipRow = todoChipRow;
                <div @key="chipRow" class="flex items-center justify-between gap-3 rounded-lg border border-accent/40 bg-accent/5 px-3 py-2">
                    <p class="text-sm text-content min-w-0">
                        <span class="text-xs uppercase tracking-wider text-accent font-semibold mr-2">✚ to-do</span>
                        <span class="text-content-muted truncate" title="@chipRow.Title">@chipRow.Title</span>
                    </p>
                    <button type="button" class="text-xs text-content-subtle hover:text-negative shrink-0"
                            @onclick="() => RemoveTodoRowAsync(chipRow)">Remove</button>
                </div>
            }
        </div>
    }

    <div class="flex flex-wrap items-center gap-2">
        <label class="text-xs uppercase tracking-wider text-content-subtle font-semibold shrink-0">Action</label>
        <select class="field max-w-xs" value="@((int)kind)" @onchange="OnKindChanged">
            @foreach (var option in SystemActionKinds.All)
            {
                <option value="@((int)option)">@SystemActionKinds.Label(option)</option>
            }
        </select>
    </div>

    @if (NeedsProject(kind) && ProjectId == "")
    {
        @* Every project-bound action raises on the email's project — one pick, in one place. *@
        <p class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 text-sm text-content">
            Pick the email's project in the bar above first — system actions are raised on it.
        </p>
    }
    else
    {
        @switch (kind)
        {
            case SystemActionKind.RaiseRfi:
                <StagedRecordActionEditor @key="kind" Kind="StagedRecordKind.Request" RequestKind="RequestType.Rfi"
                                          StagedCreate="@StagedCreate" StagedCreateChanged="StagedCreateChanged"
                                          EmailAttachments="@EmailAttachments" SenderEmail="@SenderEmail" />
                break;
            case SystemActionKind.PromoteRequestToRfi:
            case SystemActionKind.CloseRfi:
            case SystemActionKind.ReopenRfi:
                <StageRequestTransitionAction @key="kind" Kind="kind" ProjectId="@ProjectId" OnStaged="StagedAsync" />
                break;
            case SystemActionKind.RaiseVariationOrder:
                <StageVariationAction Projects="@Projects" ProjectId="@ProjectId" OnStaged="StagedAsync" />
                break;
            case SystemActionKind.ApproveVariationOrder:
            case SystemActionKind.RejectVariationOrder:
                <StageVariationDecisionAction @key="kind" Kind="kind" ProjectId="@ProjectId" OnStaged="StagedAsync" />
                break;
            case SystemActionKind.RaiseWorkOrder:
                <StagedRecordActionEditor @key="kind" Kind="StagedRecordKind.WorkOrder"
                                          StagedCreate="@StagedCreate" StagedCreateChanged="StagedCreateChanged"
                                          EmailAttachments="@EmailAttachments" SenderEmail="@SenderEmail" />
                break;
            case SystemActionKind.CreateBidPackageInvite:
                <StagedRecordActionEditor @key="kind" Kind="StagedRecordKind.BidPackage"
                                          StagedCreate="@StagedCreate" StagedCreateChanged="StagedCreateChanged"
                                          EmailAttachments="@EmailAttachments" SenderEmail="@SenderEmail" />
                break;
            case SystemActionKind.FileBidPackageTender:
                <StageTenderResponseAction @key="kind" ProjectId="@ProjectId" SenderEmail="@SenderEmail"
                                           OnStaged="StagedAsync" />
                break;
            case SystemActionKind.RaiseDefect:
                <StagedRecordActionEditor @key="kind" Kind="StagedRecordKind.Defect"
                                          StagedCreate="@StagedCreate" StagedCreateChanged="StagedCreateChanged"
                                          EmailAttachments="@EmailAttachments" SenderEmail="@SenderEmail" />
                break;
            case SystemActionKind.CreateTodos:
                <StageTodosAction TodoRows="TodoRows" TodoAssigneeOptions="@TodoAssigneeOptions"
                                  TodoProjectNote="@TodoProjectNote" OnStagingChanged="OnStagingChanged" />
                break;
            case SystemActionKind.CompleteTodo:
                <StageTodoCompleteAction ProjectId="@ProjectId" OnStaged="StagedAsync" />
                break;
            case SystemActionKind.AddDirectoryContact:
                <StageDirectoryContactAction OnStaged="StagedAsync" />
                break;
        }
        @if (IsRecordCreate(kind))
        {
            <StagedCreateFooter Staged="@StagedCreate" Busy="@Busy" OnCreateNow="OnCreateNow" OnClose="OnClose" />
        }
    }

    <p class="text-xs text-content-subtle pt-2 border-t border-line">
        Everything lined up here runs with the email's Apply — created records are tagged to the
        email, and an action on an existing record stages that record's tag in System Tags;
        staged actions clear if you move to another email without applying. A staged record's
        Create now raises it immediately instead (email tagged to it in the same act), so the new
        record exists to work with before the rest of the triage lands.
    </p>
</div>

@code {
    /// <summary>The full project list — the staged store calls read it only to name the project
    /// in their staged summaries.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();

    /// <summary>The email's project, picked once in the triage bar; blank shows the note above
    /// instead of a project-bound form (to-dos and directory contacts work without one).</summary>
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";

    /// <summary>Page-owned staged actions (cleared per selection, like all staging); the pane
    /// adds/removes and notifies.</summary>
    [Parameter, EditorRequired] public List<StagedSystemAction> StagedActions { get; set; } = new();
    [Parameter] public EventCallback OnStagingChanged { get; set; }

    /// <summary>The page's staged System Tags picks — the same list SystemTagsPane mutates. An
    /// action on an existing record stages that record's tag here the moment it stages, so the
    /// email is filed against what it actioned when Apply links the picks (links land before
    /// actions run).</summary>
    [Parameter, EditorRequired] public List<LinkableRecord> PickedRecords { get; set; } = new();

    /// <summary>The staged new record (null = none) — the email-linked creates' one draft. Owned
    /// by the page; edited in <see cref="StagedRecordActionEditor"/>.</summary>
    [Parameter] public StagedRecordCreate? StagedCreate { get; set; }
    [Parameter] public EventCallback<StagedRecordCreate?> StagedCreateChanged { get; set; }

    /// <summary>Records already raised from this email — by Create now, or by an apply whose
    /// create landed before a later step stopped it — shown as done chips with their minted
    /// references. Page-owned, parked/restored per email like the staging.</summary>
    [Parameter] public List<CreatedNowRecord> CreatedRecords { get; set; } = new();

    /// <summary>The staged chip's "Create now": the page raises the staged record immediately
    /// (email tagged in the same act) instead of waiting for Apply.</summary>
    [Parameter] public EventCallback OnCreateNow { get; set; }

    /// <summary>The page's busy flag — disables Create now while any apply/create is running.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <summary>Done pressed under a record form — the page hands this window back to the email.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    // The actions that draft the page's staged record — the ones the footer finishes.
    private static bool IsRecordCreate(SystemActionKind actionKind) =>
        actionKind is SystemActionKind.RaiseRfi
            or SystemActionKind.RaiseWorkOrder
            or SystemActionKind.CreateBidPackageInvite
            or SystemActionKind.RaiseDefect;

    /// <summary>Page-owned to-do draft rows — "Create To-do Items". One to-do per assignee per
    /// row on Apply, the email tagged to every one.</summary>
    [Parameter] public List<TodoDraftRow> TodoRows { get; set; } = new();
    [Parameter] public IReadOnlyList<SearchSelect.Option> TodoAssigneeOptions { get; set; } = Array.Empty<SearchSelect.Option>();
    [Parameter] public string? TodoProjectNote { get; set; }

    /// <summary>The open email's attachments — the work-order create offers them as record-keeping
    /// tick-boxes.</summary>
    [Parameter] public IReadOnlyList<IntakeAttachment> EmailAttachments { get; set; } = Array.Empty<IntakeAttachment>();

    /// <summary>The selected email's sender — pre-fills the work-order subcontractor and the
    /// defect assignee. Suggestions only.</summary>
    [Parameter] public string SenderEmail { get; set; } = "";

    private SystemActionKind kind = SystemActionKind.RaiseRfi;

    // To-dos are company-wide until a project is set, and a directory contact has no project at
    // all — everything else raises on the email's project.
    private static bool NeedsProject(SystemActionKind actionKind) =>
        actionKind is not (SystemActionKind.AddDirectoryContact or SystemActionKind.CreateTodos);

    private List<TodoDraftRow> TitledTodoRows => TodoRows.Where(r => !string.IsNullOrWhiteSpace(r.Title)).ToList();

    private void OnKindChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SystemActionKind>(e.Value?.ToString(), out var parsed)) kind = parsed;
    }

    private async Task StagedAsync(StagedSystemAction action)
    {
        // An action on an existing record tags the email to it: the target's pick is staged the
        // moment the action stages, exactly as if it had been ticked in System Tags by hand. A
        // record the triager already picked stays theirs (TargetAutoTagged false), so removing
        // the action later never takes away a tag it didn't add.
        if (action.Target is { } target && !PickedRecords.Any(r => r.RecordId == target.RecordId))
        {
            PickedRecords.Add(target);
            action = action with { TargetAutoTagged = true };
        }
        StagedActions.Add(action);
        await OnStagingChanged.InvokeAsync();
    }

    private async Task RemoveAsync(StagedSystemAction action)
    {
        StagedActions.Remove(action);
        // Take back the tag this action staged — unless another staged action still targets the
        // same record (its tag is still owed), or the pick was the triager's own to begin with.
        if (action is { TargetAutoTagged: true, Target: { } target }
            && !StagedActions.Any(a => a.Target?.RecordId == target.RecordId)
            && PickedRecords.FirstOrDefault(r => r.RecordId == target.RecordId) is { } picked)
        {
            PickedRecords.Remove(picked);
        }
        await OnStagingChanged.InvokeAsync();
    }

    /// <summary>Whether the action's target record is (still) among the staged tag picks — read
    /// live rather than snapshotted, so the row's "tagged to it" note stays honest if the pick
    /// is unticked in System Tags afterwards.</summary>
    private bool TargetIsTagged(StagedSystemAction action) =>
        action.Target is { } target && PickedRecords.Any(r => r.RecordId == target.RecordId);

    private async Task ClearStagedCreateAsync()
    {
        await StagedCreateChanged.InvokeAsync(null);
        await OnStagingChanged.InvokeAsync();
    }

    private async Task RemoveTodoRowAsync(TodoDraftRow row)
    {
        TodoRows.Remove(row);
        if (TodoRows.Count == 0) TodoRows.Add(new TodoDraftRow());
        await OnStagingChanged.InvokeAsync();
    }
}
