@namespace Jewel.JPMS.Features.Triage.Panels
@using Jewel.JPMS.Contracts.RecordLinks
@using Jewel.JPMS.Features.Triage.Workspace
@inject IQueryClient Queries

@*
    The correspondence currently tagged to the open record, read live from the mailbox — the same
    association the record's own page shows, in the same card style as every other communications
    section. Browsable: threads group into one card, any email opens in place to its full body,
    and attachments preview into the workspace's Preview pane (or download) — gathering context
    and copy/paste material while working an email in the other window. With OnReply wired, each
    email also offers Reply (lined up in the Control Centre's Outbox; sent directly on record
    pages). Tagging stays in triage.
*@

@if (emails is null)
{
    <p class="text-xs text-content-subtle italic px-1">Checking the record's correspondence…</p>
}
else if (emails.Count > 0)
{
    <div class="panel p-4">
        <p class="text-xs uppercase tracking-wider text-content-subtle font-semibold mb-2">
            Correspondence · @emails.Count
        </p>
        <CorrespondenceThreadList Emails="emails" ExcludeTag="@ExcludeTag" OnPreview="OnPreview" OnReply="OnReply" />
    </div>
}

@code {
    [Parameter, EditorRequired] public RecordType Type { get; set; }
    [Parameter, EditorRequired] public string RecordId { get; set; } = "";

    /// <summary>The record's own tag ("JPMS/&lt;TagReference&gt;") — the list's premise, so it is
    /// hidden from each email's chip row, which shows where ELSE the email is filed.</summary>
    [Parameter] public string ExcludeTag { get; set; } = "";

    /// <summary>Opens an email attachment in the workspace Preview pane, opposite this window.</summary>
    [Parameter] public EventCallback<PreviewRequest> OnPreview { get; set; }

    /// <summary>Start a reply to one of the record's emails — passed through to the thread list;
    /// the host decides what replying means.</summary>
    [Parameter] public EventCallback<MailboxMessage> OnReply { get; set; }

    private IReadOnlyList<MailboxMessage>? emails;
    private string loadedRecordId = "";

    protected override async Task OnParametersSetAsync()
    {
        if (RecordId == loadedRecordId) return;
        loadedRecordId = RecordId;
        emails = null;
        try { emails = await Queries.AskAsync(new ListRecordEmails(Type, RecordId), CancellationToken.None); }
        catch { emails = Array.Empty<MailboxMessage>(); }
    }
}
