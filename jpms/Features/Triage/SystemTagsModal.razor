@namespace Jewel.JPMS.Features.Triage
@using Jewel.JPMS.Features.Subcontractors
@using Jewel.JPMS.Features.CostCenters
@inject IIntakeQueue Intake
@inject SubcontractorsReadModel Subcontractors
@inject CostCentersReadModel CostCenters

@* THE tagging surface for triage: one modal, three tabs — Client / Subcontractor / Internal —
   each offering exactly what that side of the system can do with an email. Everything here is
   STAGED: picked records and the drafted new record go back to the page as pending work, applied
   (and tagged, verified) by the page's single Apply. A thread already filed under a pathway opens
   locked to its own tab — the client wall in tab form. *@

<Modal IsOpen="@IsOpen" Title="System tags" Class="max-w-3xl" DismissOnOverlayClick="false"
       ShowFooter="false" OnCancel="CloseAsync">
    <div class="space-y-4">

        @* Who is this correspondence with? The tab IS the pathway decision. *@
        <div class="flex items-center gap-2 border-b border-line">
            @foreach (var tab in Tabs)
            {
                var locked = LockedPathway is { } fixedTab && fixedTab != tab;
                <button type="button" @key="tab" disabled="@locked"
                        title="@(locked ? $"This thread is already filed under {LockedPathway} — its routing was decided at first filing" : TabHint(tab))"
                        class="@TabClass(tab, locked)" @onclick="() => SwitchTab(tab)">
                    @tab
                </button>
            }
        </div>
        @if (LockedPathway is { } lockedPathway)
        {
            <p class="text-xs text-content-subtle -mt-2">Already filed under <span class="font-medium text-content">@lockedPathway</span> — tags here work within it.</p>
        }

        @* What's staged so far, across every tab — the modal's running total. *@
        @if (Picked.Count > 0 || StagedCreate is not null)
        {
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var picked in Picked.ToList())
                {
                    <span @key="picked.RecordId" class="inline-flex items-center gap-1 rounded-full border border-accent/50 bg-accent/5 text-accent pl-2.5 pr-1 py-0.5 text-xs" title="@picked.Title">
                        <span>🔗 @picked.Reference</span>
                        <button type="button" class="leading-none px-1 text-accent/70 hover:text-negative" title="Unpick"
                                @onclick="() => TogglePick(picked)">&times;</button>
                    </span>
                }
                @if (StagedCreate is { } staged)
                {
                    <span class="inline-flex items-center gap-1 rounded-full border border-accent/50 bg-accent/5 text-accent pl-2.5 pr-1 py-0.5 text-xs">
                        <span>✚ @staged.Label: @(string.IsNullOrWhiteSpace(staged.Title) ? "(untitled)" : staged.Title)</span>
                        <button type="button" class="leading-none px-1 text-accent/70 hover:text-negative" title="Remove"
                                @onclick="ClearStagedCreate">&times;</button>
                    </span>
                }
            </div>
        }

        @if (string.IsNullOrWhiteSpace(ProjectId))
        {
            <p class="rounded-lg bg-amber-500/10 border border-amber-500/40 px-3 py-2 text-xs text-content">
                Set the email's <span class="font-medium">Project</span> on the page first — tags file the email against a project's records.
            </p>
        }
        else if (activeTab == "Internal")
        {
            @* Internal: link the email to existing to-do items (pathway-neutral). New to-dos are
               drafted in the To-dos modal, not here. *@
            <p class="text-xs text-content-subtle">Link this email to existing to-do items. New to-dos are raised from the To-dos button on the page.</p>
            @LinkPicker
        }
        else
        {
            <div class="flex items-center gap-2">
                <button type="button" class="@SubTabClass(!createOpen)" @onclick="() => createOpen = false">Link to existing</button>
                <button type="button" class="@SubTabClass(createOpen)" @onclick="OpenCreatePane">Create new</button>
            </div>

            @if (!createOpen)
            {
                @LinkPicker
            }
            else if (activeTab == "Client")
            {
                <div class="space-y-3">
                    <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-subtle">
                        Created as a <span class="font-medium text-content">General</span> request, auto-numbered REQ-#### — promote it to an official RFI (or on to a variation) from the request page. The email is tagged to it on apply.
                    </p>
                    <FormField Label="Raised to" Value="@Create.RaisedTo" OnChange="v => { Create.RaisedTo = v; NotifyCreate(); }" />
                    <FormField Label="Subject" Value="@Create.Title" OnChange="v => { Create.Title = v; NotifyCreate(); }" Required="true" />
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Detail</label>
                        <textarea class="field" rows="4" value="@Create.Description" @oninput="e => { Create.Description = e.Value?.ToString() ?? string.Empty; NotifyCreate(); }"></textarea>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <FormField Label="Drawing / detail ref" Value="@Create.DrawingRef" OnChange="v => { Create.DrawingRef = v; NotifyCreate(); }" />
                        <FormField Label="Response due" Value="@Create.ResponseDue" OnChange="v => { Create.ResponseDue = v; NotifyCreate(); }" InputType="date" />
                    </div>
                    <label class="flex items-start gap-2 cursor-pointer">
                        <input type="checkbox" checked="@Create.AddToProgramme" @onchange="e => { Create.AddToProgramme = e.Value is true; NotifyCreate(); }" />
                        <span class="text-sm text-content">
                            Also a Relevant Event for the Programme
                            <span class="block text-xs text-content-subtle">The email's thread is also tagged to the project's programme — it appears in the Programme tab's Relevant Events.</span>
                        </span>
                    </label>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @* Which Subcontractor record the create drafts: a bid package (tendering) or a
                       work order (direct commitment). One staged create either way — switching kind
                       re-labels what Apply will raise. *@
                    <div class="flex items-center gap-2">
                        <span class="text-xs uppercase tracking-wider text-content-subtle font-semibold">Record</span>
                        <button type="button" class="@SubTabClass(SubCreateKind == StagedRecordKind.BidPackage)"
                                @onclick="() => SwitchSubCreateKind(StagedRecordKind.BidPackage)">Bid package</button>
                        <button type="button" class="@SubTabClass(SubCreateKind == StagedRecordKind.WorkOrder)"
                                @onclick="() => SwitchSubCreateKind(StagedRecordKind.WorkOrder)">Work order</button>
                    </div>

                    @if (SubCreateKind == StagedRecordKind.BidPackage)
                    {
                        <p class="text-xs text-content-subtle">A draft bid package is created and this email is tagged to it on apply. Invite subcontractors and add line items from the bid package page.</p>
                        <FormField Label="Title" Value="@Create.Title" OnChange="v => { Create.Title = v; NotifyCreate(); }" Required="true" />
                        <FormField Label="Trade" Value="@Create.Trade" OnChange="v => { Create.Trade = v; NotifyCreate(); }" />
                    }
                    else
                    {
                        <p class="text-xs text-content-subtle">The work order is raised and this email is tagged to it on apply — released with the next order number, or as an unnumbered draft for approval from the Work Orders page.</p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Subcontractor *</label>
                                <select class="field" disabled="@(Subcontractors.Current is null)"
                                        @onchange="e => SetWorkOrder(c => c.SubcontractorId = e.Value?.ToString() ?? string.Empty)">
                                    @if (Subcontractors.Current is null)
                                    {
                                        <option value="">Loading…</option>
                                    }
                                    else
                                    {
                                        <option value="" selected="@(Create.SubcontractorId == "")">Choose a subcontractor…</option>
                                        @foreach (var sub in SortedSubcontractors)
                                        {
                                            <option value="@sub.SubcontractorId" selected="@(Create.SubcontractorId == sub.SubcontractorId)">@sub.CompanyName</option>
                                        }
                                    }
                                </select>
                                @if (senderMatchedCompany is { } matched && Create.SubcontractorId != "" && StagedCreate is null)
                                {
                                    <p class="text-[11px] text-content-subtle mt-1">Matched to the sender — @matched</p>
                                }
                            </div>
                            <FormField Label="Order title" Value="@Create.Title" OnChange="v => SetWorkOrder(c => c.Title = v)" Required="true" />
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Scope</label>
                            <textarea class="field" rows="2" maxlength="4000" placeholder="What the order instructs (optional)"
                                      value="@Create.Scope" @oninput="e => SetWorkOrder(c => c.Scope = e.Value?.ToString() ?? string.Empty)"></textarea>
                        </div>

                        @* Programme — printed in the purchase order's Programme section; all optional. *@
                        <div class="rounded-lg border border-line bg-surface p-3 space-y-3">
                            <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold"
                               title="Printed in the purchase order's Programme section — leave everything empty to omit it">Programme</p>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <FormField Label="Start date" Value="@Create.ProgrammeStart" OnChange="v => SetWorkOrder(c => c.ProgrammeStart = v)" InputType="date" />
                                <FormField Label="Target completion" Value="@Create.TargetCompletion" OnChange="v => SetWorkOrder(c => c.TargetCompletion = v)" InputType="date" />
                            </div>
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Programme notes</label>
                                <textarea class="field" rows="2" maxlength="2000" placeholder="e.g. Weekly programme duration 1st &amp; 2nd fix phases (optional)"
                                          value="@Create.ProgrammeNotes" @oninput="e => SetWorkOrder(c => c.ProgrammeNotes = e.Value?.ToString() ?? string.Empty)"></textarea>
                            </div>
                        </div>

                        @* Priced lines — each carries its own cost centre; the order's value is their sum. *@
                        <div class="rounded-lg border border-line bg-surface p-3">
                            <p class="text-[11px] uppercase tracking-wider text-content-subtle font-semibold mb-2"
                               title="Each line lands on its own cost centre — the order's value is their sum">Priced lines</p>
                            <div class="space-y-2">
                                @for (var index = 0; index < Create.Lines.Count; index++)
                                {
                                    var lineIndex = index;
                                    var line = Create.Lines[lineIndex];
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <SearchSelect Options="@CostCentreOptions" WidthClass="w-48"
                                                          Placeholder="Cost centre…"
                                                          InputClass="bg-surface border border-line px-2 py-1.5"
                                                          Value="@line.CostCode" ValueChanged="v => SetWorkOrder(_ => line.CostCode = v)" />
                                            <input type="text" maxlength="256" placeholder="What this line covers"
                                                   class="bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm flex-1"
                                                   value="@line.Title"
                                                   @onchange="e => SetWorkOrder(_ => line.Title = e.Value?.ToString() ?? string.Empty)" />
                                            <input type="number" step="any" placeholder="Amount £"
                                                   class="bg-surface border border-line rounded-lg px-2 py-1.5 text-right text-content text-sm w-28"
                                                   value="@line.AmountText"
                                                   @onchange="e => SetWorkOrder(_ => line.AmountText = e.Value?.ToString() ?? string.Empty)" />
                                            <button type="button" aria-label="Remove this line" disabled="@(Create.Lines.Count == 1)"
                                                    class="inline-flex items-center justify-center w-7 h-7 rounded-md text-content-subtle hover:text-negative hover:bg-surface-raised"
                                                    @onclick="() => SetWorkOrder(c => c.Lines.RemoveAt(lineIndex))">
                                                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                     stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
                                            </button>
                                        </div>
                                        <textarea rows="2" maxlength="1024" placeholder="Description — the full detail printed on the purchase order (optional)"
                                                  class="w-full bg-surface border border-line rounded-lg px-2 py-1.5 text-content text-sm placeholder:text-content-subtle"
                                                  value="@line.Description"
                                                  @onchange="e => SetWorkOrder(_ => line.Description = e.Value?.ToString() ?? string.Empty)"></textarea>
                                    </div>
                                }
                            </div>
                            <div class="flex items-center justify-between mt-2">
                                <button type="button" @onclick="() => SetWorkOrder(c => c.Lines.Add(new StagedWorkOrderLine()))"
                                        class="text-xs font-medium text-content-subtle hover:text-content underline underline-offset-4">
                                    + Add another line
                                </button>
                                <span class="text-sm text-content-muted">Order value <span class="text-content font-medium">@Money(OrderTotal)</span></span>
                            </div>
                        </div>

                        @* Deposit — percentage of the order value only, printed at the foot of the PO. *@
                        <div class="rounded-lg border border-line bg-surface p-3">
                            <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none"
                                   title="Tick when the subcontractor requires a deposit — the percentage prints at the foot of the purchase order">
                                <input type="checkbox" class="cursor-pointer align-middle" checked="@Create.DepositRequired"
                                       @onchange="e => SetWorkOrder(c => c.DepositRequired = e.Value is true)" />
                                Deposit required
                            </label>
                            @if (Create.DepositRequired)
                            {
                                <div class="mt-2 flex items-center gap-2">
                                    <input type="number" step="any" min="0" max="100" placeholder="%"
                                           class="bg-surface border border-line rounded-lg px-2 py-1.5 text-right text-content text-sm w-24"
                                           value="@Create.DepositPercentText"
                                           @onchange="e => SetWorkOrder(c => c.DepositPercentText = e.Value?.ToString() ?? string.Empty)" />
                                    <span class="text-sm text-content-muted">% of the order value</span>
                                </div>
                            }
                        </div>

                        <label class="flex w-fit items-center gap-2 text-sm text-content cursor-pointer select-none"
                               title="A draft is stored without a number and is invisible to the supplier — though its value counts in the Financials tab's committed figures — until someone approves or rejects it from the Work Orders tab">
                            <input type="checkbox" class="cursor-pointer align-middle" checked="@Create.SaveAsDraft"
                                   @onchange="e => SetWorkOrder(c => c.SaveAsDraft = e.Value is true)" />
                            Save as a draft — needs approval before it's issued
                        </label>

                        @if (StagedCreate is not null && Create.WorkOrderProblem is { } problem)
                        {
                            <p class="text-xs text-amber-600">@problem</p>
                        }
                    }
                </div>
            }
        }

        <div class="flex items-center justify-end pt-1">
            <button type="button" class="btn-primary" @onclick="CloseAsync">Done</button>
        </div>
    </div>
</Modal>

@code {
    private static readonly string[] Tabs = { "Client", "Subcontractor", "Internal" };

    // What each tab can link to. Cost Centre removed as a filing destination (2026-08-04);
    // VariationQuote folded into Variation (one record, one number). Scheduling removed
    // (2026-08-07): the programme bucket isn't a record anyone picks — the page's own
    // "Relevant Event for Programme" checkbox files to it instead; the bucket's claims
    // documents stay reachable here via Request / RFI and LADs claim.
    private static readonly RecordType[] ClientTypes = { RecordType.Request, RecordType.Variation, RecordType.Lad };
    private static readonly RecordType[] SubcontractorTypes = { RecordType.BidPackageInvite, RecordType.WorkOrder };
    private static readonly RecordType[] InternalTypes = { RecordType.Todo };

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string EmailSubject { get; set; } = "";

    /// <summary>The selected email's sender address — used to pre-select the work-order
    /// subcontractor when it matches a directory record (exact contact email, else a unique
    /// company domain). A suggestion only; the picker stays fully changeable.</summary>
    [Parameter] public string SenderEmail { get; set; } = "";

    /// <summary>The thread's fixed pathway label ("Client"/"Subcontractor"/"Internal"), when it is
    /// already filed — locks the tabs to that side (the wall in tab form). Null = free choice.</summary>
    [Parameter] public string? LockedPathway { get; set; }

    /// <summary>The tab in use — the pathway decision, reported up so the page files the thread
    /// (and stamps to-dos / Replied) under it.</summary>
    [Parameter] public string? ActivePathway { get; set; }
    [Parameter] public EventCallback<string> ActivePathwayChanged { get; set; }

    /// <summary>Page-owned staged record links; the modal mutates and notifies.</summary>
    [Parameter] public List<LinkableRecord> Picked { get; set; } = new();
    [Parameter] public EventCallback OnStagingChanged { get; set; }

    /// <summary>The staged new record (null = none). Owned by the page; edited here.</summary>
    [Parameter] public StagedRecordCreate? StagedCreate { get; set; }
    [Parameter] public EventCallback<StagedRecordCreate?> StagedCreateChanged { get; set; }

    private string activeTab = "Client";
    private bool createOpen;
    // Which Subcontractor record the create pane drafts (BidPackage | WorkOrder).
    private StagedRecordKind subCreateKind = StagedRecordKind.BidPackage;
    // One refresh of the work-order lookups (directory + cost-code master) per modal open.
    private bool workOrderLookupsRequested;
    // The company name the sender was matched to, shown as a hint under the pre-selected picker.
    private string? senderMatchedCompany;
    private RecordType linkType = RecordType.Request;
    private string search = "";
    private bool loading;
    private string loadedKey = "";
    private IReadOnlyList<LinkableRecord> records = Array.Empty<LinkableRecord>();
    private bool wasOpen;

    // The create form binds to a scratch instance until something is typed, so an empty form never
    // stages a phantom "new record".
    private StagedRecordCreate Create => StagedCreate ?? scratchCreate;
    private StagedRecordCreate scratchCreate = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !wasOpen)
        {
            activeTab = LockedPathway ?? ActivePathway ?? "Client";
            createOpen = StagedCreate is not null;
            // The house-standard response window pre-fills the request form — a week is what all
            // but a handful of requests get, so typing a date is keystrokes spent on the common case.
            scratchCreate = new StagedRecordCreate { ResponseDue = RequestDefaults.ResponseDue() };
            subCreateKind = StagedCreate?.Kind == StagedRecordKind.WorkOrder
                ? StagedRecordKind.WorkOrder
                : StagedRecordKind.BidPackage;
            workOrderLookupsRequested = false;
            senderMatchedCompany = null;
            if (createOpen && activeTab == "Subcontractor" && subCreateKind == StagedRecordKind.WorkOrder)
                _ = EnsureWorkOrderLookupsAsync();
            linkType = DefaultTypeFor(activeTab);
            await LoadRecordsAsync();
        }
        wasOpen = IsOpen;
    }

    private IReadOnlyList<RecordType> TypesFor(string tab) => tab switch
    {
        "Subcontractor" => SubcontractorTypes,
        "Internal" => InternalTypes,
        _ => ClientTypes
    };

    private static RecordType DefaultTypeFor(string tab) => tab switch
    {
        "Subcontractor" => RecordType.BidPackageInvite,
        "Internal" => RecordType.Todo,
        _ => RecordType.Request
    };

    private async Task SwitchTab(string tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        createOpen = false;
        linkType = DefaultTypeFor(tab);
        search = "";
        await ActivePathwayChanged.InvokeAsync(tab);
        await LoadRecordsAsync();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<RecordType>(e.Value?.ToString(), out var type)) linkType = type;
        await LoadRecordsAsync();
    }

    private async Task LoadRecordsAsync()
    {
        if (string.IsNullOrWhiteSpace(ProjectId)) { records = Array.Empty<LinkableRecord>(); return; }
        var key = $"{ProjectId}|{linkType}";
        if (key == loadedKey) return;
        loading = true;
        try
        {
            records = await Intake.ListLinkableRecordsAsync(ProjectId, linkType);
            loadedKey = key;
        }
        catch { records = Array.Empty<LinkableRecord>(); loadedKey = ""; }
        finally { loading = false; }
    }

    private async Task TogglePick(LinkableRecord record)
    {
        var existing = Picked.FirstOrDefault(r => r.RecordId == record.RecordId);
        if (existing is not null) Picked.Remove(existing);
        else Picked.Add(record);
        await OnStagingChanged.InvokeAsync();
    }

    private void NotifyCreate()
    {
        // First keystroke on the scratch form stages it; a staged form just reports the edit.
        var kind = activeTab == "Subcontractor" ? subCreateKind : StagedRecordKind.Request;
        if (StagedCreate is null)
        {
            scratchCreate.Kind = kind;
            _ = StagedCreateChanged.InvokeAsync(scratchCreate);
        }
        else
        {
            StagedCreate.Kind = kind;
            _ = StagedCreateChanged.InvokeAsync(StagedCreate);
        }
    }

    // ---- work order create (Subcontractor tab) ----

    private StagedRecordKind SubCreateKind => subCreateKind;

    private void OpenCreatePane()
    {
        createOpen = true;
        if (activeTab == "Subcontractor" && subCreateKind == StagedRecordKind.WorkOrder)
            _ = EnsureWorkOrderLookupsAsync();
    }

    private void SwitchSubCreateKind(StagedRecordKind kind)
    {
        if (subCreateKind == kind) return;
        subCreateKind = kind;
        if (kind == StagedRecordKind.WorkOrder) _ = EnsureWorkOrderLookupsAsync();
        // A staged create keeps its content and just changes what Apply will raise from it.
        if (StagedCreate is not null) NotifyCreate();
    }

    /// <summary>Every work-order form edit funnels through here: apply the edit, stamp the kind,
    /// and stage/report — so a half-built order is always the one staged record.</summary>
    private void SetWorkOrder(Action<StagedRecordCreate> edit)
    {
        edit(Create);
        subCreateKind = StagedRecordKind.WorkOrder;
        NotifyCreate();
    }

    // One refresh per open (stale-while-revalidate): cached lists render immediately, the fetch
    // freshens them in the background — and the sender match runs once the directory has landed.
    private async Task EnsureWorkOrderLookupsAsync()
    {
        if (workOrderLookupsRequested)
        {
            TryMatchSender();
            return;
        }
        workOrderLookupsRequested = true;
        try
        {
            await Task.WhenAll(
                Subcontractors.RefreshAsync(CancellationToken.None),
                CostCenters.RefreshAsync(CancellationToken.None));
        }
        catch { /* the pickers fall back to whatever is cached; the error toast already reported */ }
        TryMatchSender();
        StateHasChanged();
    }

    // Sender addresses from the big freemail providers say nothing about the company, so they
    // never drive a domain match (an exact contact-email match still wins even there).
    private static readonly HashSet<string> FreemailDomains = new(StringComparer.OrdinalIgnoreCase)
    {
        "gmail.com", "googlemail.com", "hotmail.com", "hotmail.co.uk", "outlook.com",
        "live.com", "live.co.uk", "yahoo.com", "yahoo.co.uk", "icloud.com", "me.com",
        "aol.com", "msn.com", "btinternet.com", "sky.com"
    };

    /// <summary>Pre-select the subcontractor from the email's sender: an exact contact-email match
    /// first, else the single directory record sharing the sender's (non-freemail) domain. Never
    /// overrides a choice already made.</summary>
    private void TryMatchSender()
    {
        if (string.IsNullOrWhiteSpace(SenderEmail) || Subcontractors.Current is not { } companies) return;
        if (Create.SubcontractorId != "") return;
        var email = SenderEmail.Trim();
        var match = companies.FirstOrDefault(company =>
            string.Equals(company.ContactEmail?.Trim(), email, StringComparison.OrdinalIgnoreCase));
        if (match is null)
        {
            var at = email.LastIndexOf('@');
            if (at < 0) return;
            var domain = email[(at + 1)..];
            if (FreemailDomains.Contains(domain)) return;
            var byDomain = companies
                .Where(company => (company.ContactEmail ?? "").Trim()
                    .EndsWith("@" + domain, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (byDomain.Count != 1) return;
            match = byDomain[0];
        }
        Create.SubcontractorId = match.SubcontractorId;
        senderMatchedCompany = match.CompanyName;
        // A scratch form isn't staged by a suggestion — only by the user's own first edit. A form
        // already staged reports the fill so the page's copy stays current.
        if (StagedCreate is not null) _ = StagedCreateChanged.InvokeAsync(StagedCreate);
    }

    private IEnumerable<Subcontractor> SortedSubcontractors =>
        (Subcontractors.Current ?? Array.Empty<Subcontractor>())
            .OrderBy(company => company.CompanyName, StringComparer.OrdinalIgnoreCase);

    // The label carries code + name so typing matches either — same convention as the manual
    // work-order modal and the Xero allocation page.
    private IReadOnlyList<SearchSelect.Option> CostCentreOptions =>
        CostCenters.Alphabetical
            .Select(centre => new SearchSelect.Option(centre.Code, $"{centre.Code} {centre.Name}"))
            .ToList();

    private decimal OrderTotal => Create.Lines.Sum(line => line.Amount ?? 0m);

    private static string Money(decimal value) =>
        value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-GB"));

    private void ClearStagedCreate()
    {
        scratchCreate = new StagedRecordCreate();
        _ = StagedCreateChanged.InvokeAsync(null);
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    // ---- link picker (shared by every tab) ----

    private RenderFragment LinkPicker => __builder =>
    {
        <div class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Record type</label>
                    <select class="field" value="@((int)linkType)" @onchange="OnTypeChanged" disabled="@(TypesFor(activeTab).Count == 1)">
                        @foreach (var recordType in TypesFor(activeTab))
                        {
                            <option value="@((int)recordType)">@TypeLabel(recordType)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-wider text-content-subtle font-semibold mb-1">Search</label>
                    <input class="field" type="text" placeholder="Reference or title…" value="@search"
                           @oninput="e => search = e.Value?.ToString() ?? string.Empty" />
                </div>
            </div>

            @if (loading)
            {
                <p class="text-sm text-content-subtle italic">Loading @TypeLabel(linkType) records…</p>
            }
            else
            {
                var candidates = Filter(Candidates());
                var others = Filter(records.Except(Candidates()).ToList());
                @if (candidates.Count > 0)
                {
                    <p class="text-xs font-semibold text-amber-600">Possible matches for this email</p>
                    <div class="space-y-1">
                        @foreach (var record in candidates) { @RecordRow(record, true) }
                    </div>
                }
                @if (others.Count > 0)
                {
                    <p class="text-xs font-semibold text-content-subtle">@(candidates.Count > 0 ? "Others" : "Records") on this project</p>
                    <div class="space-y-1 max-h-56 overflow-y-auto">
                        @foreach (var record in others) { @RecordRow(record, false) }
                    </div>
                }
                @if (candidates.Count == 0 && others.Count == 0)
                {
                    <p class="text-sm text-content-subtle italic">Nothing matching on this project.</p>
                }
                <p class="text-xs text-content-subtle">Click to add, click again to unpick — the email is tagged to every picked record on apply.</p>
            }
        </div>
    };

    private RenderFragment RecordRow(LinkableRecord record, bool candidate) => __builder =>
    {
        <button type="button" @key="record.RecordId" @onclick="() => TogglePick(record)" class="@RowClass(record, candidate)">
            <span class="font-mono text-xs text-content-muted shrink-0">@record.Reference</span>
            <span class="text-sm text-content truncate flex-1" title="@record.Summary">@record.Title</span>
            @if (!string.IsNullOrWhiteSpace(record.StatusLabel))
            {
                <span class="text-[10px] uppercase tracking-wider text-content-subtle shrink-0">@record.StatusLabel</span>
            }
        </button>
    };

    private string RowClass(LinkableRecord record, bool candidate)
    {
        var baseClass = "w-full text-left rounded-lg border px-3 py-1.5 flex items-center gap-2 transition";
        if (Picked.Any(r => r.RecordId == record.RecordId)) return $"{baseClass} border-accent bg-surface-raised";
        return candidate
            ? $"{baseClass} border-amber-500/40 hover:border-amber-500"
            : $"{baseClass} border-line hover:border-line-strong";
    }

    private List<LinkableRecord> Filter(IEnumerable<LinkableRecord> source) =>
        string.IsNullOrWhiteSpace(search)
            ? source.ToList()
            : source.Where(r =>
                    r.Reference.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || r.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || (r.Summary?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

    // Records whose reference or title overlaps the email subject — surfaced first so a duplicate
    // record isn't created for something already tracked.
    private List<LinkableRecord> Candidates()
    {
        var tokens = Tokenise(EmailSubject);
        return records
            .Select(r => (r, score: Score(r, tokens)))
            .Where(x => x.score > 0)
            .OrderByDescending(x => x.score)
            .Select(x => x.r)
            .ToList();
    }

    private int Score(LinkableRecord record, HashSet<string> subjectTokens)
    {
        var score = 0;
        if (!string.IsNullOrWhiteSpace(record.Reference)
            && EmailSubject.Contains(record.Reference, StringComparison.OrdinalIgnoreCase))
            score += 10;
        foreach (var token in Tokenise(record.Title))
            if (subjectTokens.Contains(token)) score++;
        return score;
    }

    private static HashSet<string> Tokenise(string text) =>
        (text ?? "")
        .ToLowerInvariant()
        .Split(new[] { ' ', ',', '.', ';', ':', '-', '—', '/', '(', ')', '[', ']' }, StringSplitOptions.RemoveEmptyEntries)
        .Where(t => t.Length >= 4)
        .ToHashSet();

    // UI terminology: Relevant Event (not Scheduling), LADs claim, Variation Order (one record).
    private static string TypeLabel(RecordType type) => type switch
    {
        RecordType.Request => "Request / RFI",
        RecordType.Variation => "Variation Order",
        RecordType.Lad => "LADs claim",
        RecordType.Scheduling => "Relevant Event",
        RecordType.BidPackageInvite => "Bid Package Invite",
        RecordType.WorkOrder => "Work Order",
        RecordType.Todo => "To-do item",
        _ => type.ToString()
    };

    private string TabClass(string tab, bool locked) =>
        "px-4 py-2 text-sm border-b-2 -mb-px transition "
        + (activeTab == tab
            ? "border-accent text-content font-semibold"
            : locked
                ? "border-transparent text-content-faint cursor-not-allowed"
                : "border-transparent text-content-muted hover:text-content");

    private string SubTabClass(bool active) =>
        "rounded-lg px-3 py-1.5 text-sm border transition "
        + (active
            ? "border-accent text-accent bg-accent/5 font-medium"
            : "border-line text-content-muted hover:text-content hover:border-line-strong");

    private static string TabHint(string tab) => tab switch
    {
        "Client" => "The client, or their architect and team",
        "Subcontractor" => "A subcontractor or supplier",
        _ => "Jewel staff — company admin"
    };
}
