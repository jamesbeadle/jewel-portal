@namespace Jewel.JPMS.Features.Cvr
@using static Jewel.JPMS.Features.Cvr.ProfitDisplay

@* The running-profit grid: one row per job, one column per month end. Each cell's main figure
   is the running % to date (the trend of the whole project); the small print is what the month
   did to it, in points and in £. The shade follows the MOVEMENT (the month's news), the number
   carries the level. The host builds the MovementModel and owns the labour-accrual overlay —
   the three delegates carry its per-cell hover, dot and to-date figures. *@
<div class="overflow-x-auto">
    <table class="w-full text-sm" style="border-collapse:separate;border-spacing:3px">
        <thead>
            <tr class="eyebrow">
                <th class="text-left py-1.5 px-2">Project</th>
                @foreach (var month in Movement.Months)
                {
                    <th class="text-center py-1.5 px-2 whitespace-nowrap">@month.ToString("MMM yy")</th>
                }
                <th class="text-center py-1.5 px-2 whitespace-nowrap">6-mo Δ</th>
                <th class="text-center py-1.5 px-2 whitespace-nowrap">Position now</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Movement.Rows)
            {
                <tr>
                    <td class="text-left whitespace-nowrap py-2 pr-3">
                        <span class="text-content">@row.Project.Name</span>
                        <span class="block font-mono text-xs text-content-faint">@row.Project.Reference</span>
                    </td>
                    @for (var index = 0; index < row.MonthCells.Count; index++)
                    {
                        var cell = row.MonthCells[index];
                        var cellMonth = Movement.Months[index];
                        var move = row.MovementsPp[index];
                        @if (cell.Empty)
                        {
                            <td class="text-center rounded-md py-2.5 px-2 text-xs text-content-faint" style="background:#12151c">—</td>
                        }
                        else if (cell.Running is not decimal runningLevel)
                        {
                            @* Costs have moved but nothing has EVER been invoiced — no honest running %; the £ is in the hover. *@
                            <td class="text-center rounded-md py-2.5 px-2 text-xs text-content-faint" style="background:#12151c"
                                title="@($"{cellMonth:MMM yy} — nothing invoiced to date · profit to date {SignedMoneyCompact(cell.CumProfit)}{AccrualHover(row.Project.ProjectId, cellMonth)}")">
                                n/a
                                @if (!cell.Own.Empty)
                                {
                                    <span class="block text-xs font-normal mt-0.5">@SignedMoneyCompact(cell.Own.Profit)</span>
                                }
                            </td>
                        }
                        else
                        {
                            <td class="text-center rounded-md py-1.5 px-2 text-xs tabular-nums"
                                style="@(move is decimal shadePp ? MovementCellStyle(shadePp, Movement.ShadeMax) : "background:#12151c")"
                                title="@(RunningCellHover(cellMonth, cell) + AccrualHover(row.Project.ProjectId, cellMonth))">
                                <span class="font-medium @ProfitClass(runningLevel)">@PctCell(runningLevel)</span>@if (AccrualOwnFor(row.Project.ProjectId, cellMonth) > 0m)
                                {<span class="text-warning ml-0.5" aria-hidden="true">•</span>}
                                <span class="block text-xs font-normal text-content-muted mt-0.5">@MovementPrint(move)@(cell.Own.Empty ? "" : $" · {SignedMoneyCompact(cell.Own.Profit)}")</span>
                            </td>
                        }
                    }
                    <td class="text-center py-2.5 px-2 text-xs font-semibold tabular-nums @ProfitClass(row.WindowDelta ?? 0m)"
                        title="@($"running % now vs 6 months ago · the window itself: invoiced {MoneyCompact(row.Window.Income)} · profit {SignedMoneyCompact(row.Window.Profit)}")">
                        @(row.WindowDelta is decimal windowDelta ? SignedPp(windowDelta) : "—")
                    </td>
                    <td class="text-center rounded-md py-2 px-3 text-xs font-semibold whitespace-nowrap border border-line bg-surface-raised @ProfitClass(row.RunningPercent ?? 0m)">
                        @(row.RunningPercent is decimal runningPct ? PctCell(runningPct) : "—")
                        <span class="block font-normal text-xs text-content-subtle mt-0.5">@MoneyCompact(row.PositionMoney)</span>
                        @if (AccrualToDateFor(row.Project.ProjectId) is > 0m and var accruedToDate)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">incl. @MoneyCompact(accruedToDate) accrued</span>
                        }
                        @if (row.Stale)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">⚠ no movement 6 mo</span>
                        }
                    </td>
                </tr>
            }
            @if (Movement.Rows.Count > 1)
            {
                <tr class="font-semibold">
                    <td class="text-left py-2.5 pr-3 border-t border-line text-content">
                        All jobs with Xero data
                        <span class="block font-normal text-xs text-content-faint">combined margin — total profit over total invoiced</span>
                    </td>
                    @for (var index = 0; index < Movement.ColumnTotals.Count; index++)
                    {
                        var total = Movement.ColumnTotals[index];
                        var totalMove = Movement.TotalMovementsPp[index];
                        <td class="text-center py-2 px-2 text-xs border-t border-line tabular-nums"
                            title="@($"invoiced to date {MoneyCompact(total.CumIncome)} · profit to date {SignedMoneyCompact(total.CumProfit)}")">
                            @if (total.Running is decimal totalPct)
                            {
                                <span class="@ProfitClass(totalPct)">@PctCell(totalPct)</span>
                                <span class="block text-xs font-normal text-content-muted mt-0.5">@MovementPrint(totalMove)@(total.Own.Empty ? "" : $" · {SignedMoneyCompact(total.Own.Profit)}")</span>
                            }
                            else
                            {
                                <span class="text-content-faint">@(total.Empty ? "—" : "n/a")</span>
                            }
                        </td>
                    }
                    <td class="text-center py-2.5 px-2 text-xs border-t border-line tabular-nums @ProfitClass(Movement.TotalWindowDelta ?? 0m)"
                        title="@($"running % now vs 6 months ago · the window itself: invoiced {MoneyCompact(Movement.TotalWindow.Income)} · profit {SignedMoneyCompact(Movement.TotalWindow.Profit)}")">
                        @(Movement.TotalWindowDelta is decimal totalWindowDelta ? SignedPp(totalWindowDelta) : "—")
                    </td>
                    <td class="text-center py-2.5 px-2 text-xs border-t border-line whitespace-nowrap @ProfitClass(Movement.TotalRunningPercent ?? 0m)">
                        @(Movement.TotalRunningPercent is decimal totalRunningPct ? PctCell(totalRunningPct) : "—")
                        <span class="block font-normal text-xs text-content-subtle mt-0.5">@MoneyCompact(Movement.TotalPositionMoney)</span>
                        @if (Movement.Rows.Sum(gridRow => AccrualToDateFor(gridRow.Project.ProjectId)) is > 0m and var totalAccrued)
                        {
                            <span class="block font-normal text-xs text-warning mt-0.5">incl. @MoneyCompact(totalAccrued) accrued</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public MovementModel Movement { get; set; } = default!;

    /// <summary>The host's labour-accrual overlay, per cell: the hover suffix…</summary>
    [Parameter, EditorRequired] public Func<string, DateTime, string> AccrualHover { get; set; } = default!;
    /// <summary>…the month's own accrued £ (a dot marks a cell carrying any)…</summary>
    [Parameter, EditorRequired] public Func<string, DateTime, decimal> AccrualOwnFor { get; set; } = default!;
    /// <summary>…and the to-date accrued £ for the Position column's memo.</summary>
    [Parameter, EditorRequired] public Func<string, decimal> AccrualToDateFor { get; set; } = default!;
}
