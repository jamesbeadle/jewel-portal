@namespace Jewel.JPMS.Features.Variations

@* Approval runs from either pre-approved status. With a recorded tender (a subcontractor and
   agreed value) this is the normal end of the pipeline; without one it is a MANUAL approval —
   the route for historic (seeded) and client-instructed variations that never tendered. The
   write-through (Valuation Report, CVR, cost-centre budgets) is identical either way. The
   build-up itself is captured in a modal (VariationApprovePanel) — the sidebar is too narrow
   for the line table — and the modal's open flag is bound, because the status pill's
   "Approved…" pick opens it too. *@
<div class="panel p-5 space-y-3">
    <h3 class="eyebrow">@(IsManual ? "Approve manually & raise Variation Order" : "Approve & raise Variation Order")</h3>
    <p class="text-xs text-content-subtle">
        Build the variation up from priced lines — one per cost centre — then approve. Each line writes onto
        the Valuation Report and commits its own cost centre's budget.
    </p>
    <button type="button" class="btn-primary w-full" disabled="@Busy" @onclick="() => ModalOpenChanged.InvokeAsync(true)">
        @(IsManual ? "Approve manually & raise VO…" : "Approve & raise VO…")
    </button>
</div>

<Modal IsOpen="ModalOpen"
       Title="@($"Approve {Order.Reference} — {Order.Title}")"
       ShowFooter="false"
       OnCancel="() => ModalOpenChanged.InvokeAsync(false)"
       Class="max-w-3xl">
    @* Pre-seeded from the staged agreed build-up when there is one, so approval
       is a check of the agreed lines rather than a retype of them. *@
    <VariationApprovePanel IsManual="@IsManual"
                           ShowHeading="false"
                           EstimatedValue="Order.EstimatedValue"
                           DefaultDescription="@Order.Title"
                           InitialLines="@Order.DraftLines"
                           Busy="@Busy"
                           OnApprove="OnApprove" />
</Modal>

@code {
    [Parameter, EditorRequired] public VariationOrder Order { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    /// <summary>Bound: the page's status pill opens the same modal.</summary>
    [Parameter] public bool ModalOpen { get; set; }
    [Parameter] public EventCallback<bool> ModalOpenChanged { get; set; }
    /// <summary>The build-up to approve with — the page writes it through.</summary>
    [Parameter] public EventCallback<VariationApprovePanel.ApproveRequest> OnApprove { get; set; }

    private bool IsManual => string.IsNullOrEmpty(Order.SelectedSubcontractorId);
}
