@namespace Jewel.JPMS.Features.Variations
@inject IVariationStore Variations

@* The agreed build-up, STAGED before approval: the client-agreed priced lines (from the agreed
   spreadsheet, the client's email — or the assistant reading them) captured now so the estimate
   reads the agreed figure and approval opens pre-seeded. Nothing reaches the Valuation Report
   until approval. The dialog, its narrative drafts and its error are the panel's own — key the
   panel by the record so a different variation gets a fresh one. *@
<div class="panel p-5 space-y-3">
    <h3 class="eyebrow">Agreed build-up (staged)</h3>
    @if (Order.DraftLines is { Count: > 0 } staged)
    {
        <div class="space-y-1">
            @foreach (var line in staged)
            {
                <div class="flex justify-between gap-3 text-sm">
                    <span class="text-content truncate" title="@line.Description">
                        <span class="font-mono text-content-subtle">@line.CostCode</span> @line.Description
                    </span>
                    <span class="font-mono whitespace-nowrap">@Pennies(line.Quantity * line.Rate)</span>
                </div>
            }
            <div class="flex justify-between text-sm pt-1 border-t border-line">
                <span class="text-content-subtle">Staged total (the estimate)</span>
                <span class="font-mono font-semibold">@Pennies(staged.Sum(line => line.Quantity * line.Rate))</span>
            </div>
        </div>
    }
    else
    {
        <p class="text-xs text-content-subtle">
            Nothing staged yet. Capture the client-agreed lines here — the total becomes the estimate
            and the approve modal opens with them filled in.
        </p>
    }
    <button type="button" class="btn-secondary w-full" disabled="@Busy" @onclick="Open">
        @(Order.DraftLines is { Count: > 0 } ? "Edit staged build-up…" : "Stage agreed build-up…")
    </button>
</div>

<Modal IsOpen="modalOpen"
       Title="@($"Agreed build-up — {Order.DisplayNumber}")"
       ShowFooter="false"
       OnCancel="Close"
       Class="max-w-3xl">
    <VariationApprovePanel ShowHeading="false"
                           InitialLines="@Order.DraftLines"
                           EstimatedValue="Order.EstimatedValue"
                           DefaultDescription="@Order.Title"
                           SubmitLabel="Stage build-up"
                           HelpOverride="Stages the client-agreed lines on this variation: their total becomes the estimate and the approve modal opens pre-filled with them. Nothing is written to the Valuation Report until approval."
                           Busy="@(Busy || staging)"
                           SubmitError="@error"
                           OnApprove="StageAsync" />
    <details class="mt-4" open="@narrativesOpen">
        <summary class="text-sm text-content-muted cursor-pointer select-none" @onclick="() => narrativesOpen = !narrativesOpen" @onclick:preventDefault="true">
            VO document sections (commercial basis, programme impact, exclusions)
        </summary>
        <div class="mt-3 space-y-3">
            <div>
                <label class="eyebrow block mb-1">Commercial basis</label>
                <textarea class="field min-h-[4rem]" value="@commercialBasis" @oninput="e => commercialBasis = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div>
                <label class="eyebrow block mb-1">Programme impact</label>
                <textarea class="field min-h-[4rem]" value="@programmeImpact" @oninput="e => programmeImpact = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div>
                <label class="eyebrow block mb-1">Exclusions</label>
                <textarea class="field min-h-[4rem]" value="@exclusions" @oninput="e => exclusions = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
        </div>
    </details>
</Modal>

@code {
    [Parameter, EditorRequired] public VariationOrder Order { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    /// <summary>The record as the server returned it after staging — the page swaps its copy and reloads.</summary>
    [Parameter] public EventCallback<VariationOrder> OnStaged { get; set; }

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    private static string Pennies(decimal value) => value.ToString("C2", Gb);

    private bool modalOpen;
    private bool staging;
    private bool narrativesOpen;
    private string? error;
    private string commercialBasis = "";
    private string programmeImpact = "";
    private string exclusions = "";

    private void Open()
    {
        error = null;
        commercialBasis = Order.CommercialBasis ?? "";
        programmeImpact = Order.ProgrammeImpact ?? "";
        exclusions = Order.Exclusions ?? "";
        narrativesOpen = !string.IsNullOrWhiteSpace(commercialBasis)
                         || !string.IsNullOrWhiteSpace(programmeImpact)
                         || !string.IsNullOrWhiteSpace(exclusions);
        modalOpen = true;
    }

    private void Close()
    {
        modalOpen = false;
        error = null;
    }

    private async Task StageAsync(VariationApprovePanel.ApproveRequest request)
    {
        if (staging) return;
        error = null;
        try
        {
            staging = true;
            var staged = await Variations.StageBuildUpAsync(
                Order.VariationOrderId, request.Lines, commercialBasis, programmeImpact, exclusions);
            modalOpen = false;
            await OnStaged.InvokeAsync(staged);
        }
        // The endpoint answers a refused staging with 400 and its own words (no toast, by
        // convention) — so they land in the dialog the user is still standing in.
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't stage the build-up. Please try again."; }
        finally { staging = false; }
    }
}
