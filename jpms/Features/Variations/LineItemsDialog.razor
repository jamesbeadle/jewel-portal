@namespace Jewel.JPMS.Features.Variations
@using Jewel.JPMS.Contracts.Variations
@inject IVariationStore Variations

@* Edits a variation's line items before approval: the priced lines held on the record, whose
   total is the estimate and which approval writes to the Valuation Report. Once approved, the
   page's "Edit line items…" opens the approved-lines editor instead — the same lines, the same
   table. Opened from the Actions menu (bound DialogOpen); key it by the record. *@
<Modal IsOpen="DialogOpen"
       Title="@($"Line items — {Order.DisplayNumber}")"
       ShowFooter="false"
       OnCancel="Close"
       Class="max-w-3xl">
    <VariationApprovePanel ShowHeading="false"
                           InitialLines="@Order.DraftLines"
                           EstimatedValue="Order.EstimatedValue"
                           DefaultDescription="@Order.Title"
                           SubmitLabel="Save line items"
                           HelpOverride="Their total becomes the estimate, and approval writes them to the Valuation Report. Nothing is written there until then."
                           Busy="@(Busy || staging)"
                           SubmitError="@error"
                           OnApprove="StageAsync" />
    <details class="mt-4" open="@narrativesOpen">
        <summary class="text-sm text-content-muted cursor-pointer select-none" @onclick="() => narrativesOpen = !narrativesOpen" @onclick:preventDefault="true">
            VO document sections (commercial basis, programme impact, exclusions)
        </summary>
        <div class="mt-3 space-y-3">
            <div>
                <FormField Label="Commercial basis">
                <textarea class="field min-h-[4rem]" value="@commercialBasis" @oninput="e => commercialBasis = e.Value?.ToString() ?? string.Empty"></textarea>
                </FormField>
            </div>
            <div>
                <FormField Label="Programme impact">
                <textarea class="field min-h-[4rem]" value="@programmeImpact" @oninput="e => programmeImpact = e.Value?.ToString() ?? string.Empty"></textarea>
                </FormField>
            </div>
            <div>
                <FormField Label="Exclusions">
                <textarea class="field min-h-[4rem]" value="@exclusions" @oninput="e => exclusions = e.Value?.ToString() ?? string.Empty"></textarea>
                </FormField>
            </div>
        </div>
    </details>
</Modal>

@code {
    [Parameter, EditorRequired] public VariationOrder Order { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    /// <summary>The record as the server returned it after saving — the page swaps its copy and reloads.</summary>
    [Parameter] public EventCallback<VariationOrder> OnStaged { get; set; }
    /// <summary>Bound: the page's Actions menu opens the dialog.</summary>
    [Parameter] public bool DialogOpen { get; set; }
    [Parameter] public EventCallback<bool> DialogOpenChanged { get; set; }

    private bool wasOpen;
    private bool staging;
    private bool narrativesOpen;
    private string? error;
    private string commercialBasis = "";
    private string programmeImpact = "";
    private string exclusions = "";

    // Each opening seeds the narrative drafts from the record — a cancelled dialog leaves nothing behind.
    protected override void OnParametersSet()
    {
        if (DialogOpen && !wasOpen) Seed();
        wasOpen = DialogOpen;
    }

    private void Seed()
    {
        error = null;
        commercialBasis = Order.CommercialBasis ?? "";
        programmeImpact = Order.ProgrammeImpact ?? "";
        exclusions = Order.Exclusions ?? "";
        narrativesOpen = !string.IsNullOrWhiteSpace(commercialBasis)
                         || !string.IsNullOrWhiteSpace(programmeImpact)
                         || !string.IsNullOrWhiteSpace(exclusions);
    }

    private async Task Close()
    {
        error = null;
        await DialogOpenChanged.InvokeAsync(false);
    }

    private async Task StageAsync(VariationApproval request)
    {
        if (staging) return;
        error = null;
        try
        {
            staging = true;
            var staged = await Variations.StageBuildUpAsync(
                Order.VariationOrderId, request.Lines, commercialBasis, programmeImpact, exclusions);
            await DialogOpenChanged.InvokeAsync(false);
            await OnStaged.InvokeAsync(staged);
        }
        // The endpoint answers a refused save with 400 and its own words (no toast, by
        // convention) — so they land in the dialog the user is still standing in.
        catch (CommandFailedException ex) { error = ex.Message; }
        catch { error = "Couldn't save the line items. Please try again."; }
        finally { staging = false; }
    }
}
