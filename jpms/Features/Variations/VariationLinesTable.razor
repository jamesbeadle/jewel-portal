@namespace Jewel.JPMS.Features.Variations

@* The approved variation's priced lines as they sit on the Valuation Report — the build-up
   behind the figure in the sidebar. *@
<div class="panel p-5">
    <div class="flex items-center justify-between mb-3">
        <h3 class="eyebrow">Variation lines</h3>
        <span class="text-xs text-content-subtle">On the Valuation Report as <span class="font-mono">@VariationRef</span></span>
    </div>
    <div class="overflow-x-auto">
        <table class="data-table data-table-dense">
            <thead>
                <tr>
                    <th>Cost centre</th>
                    <th>Description</th>
                    <th class="text-right">Qty</th>
                    <th class="text-right">Rate £</th>
                    <th class="text-right">Amount £</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Lines)
                {
                    <tr>
                        <td class="font-mono text-xs whitespace-nowrap">@line.CostCode</td>
                        <td>@line.Description</td>
                        <td class="text-right font-mono">@line.Quantity.ToString("0.##", Gb)</td>
                        <td class="text-right font-mono">@line.Rate.ToString("N2", Gb)</td>
                        <td class="text-right font-mono @(line.LineAmount < 0m ?"text-negative" : "")">@line.LineAmount.ToString("N2", Gb)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-t border-line-strong font-semibold text-content">
                    <td colspan="4">Total</td>
                    @* whitespace-nowrap: a negative total must never wrap its minus sign onto
                       its own line and read as positive. *@
                    <td class="text-right font-mono whitespace-nowrap @(Total < 0m ?"text-negative" : "")">@Total.ToString("C2", Gb)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ValuationLineItem> Lines { get; set; } = Array.Empty<ValuationLineItem>();
    /// <summary>The V-ref the lines sit under on the report.</summary>
    [Parameter] public string? VariationRef { get; set; }

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    private decimal Total => Lines.Sum(line => line.LineAmount);
}
