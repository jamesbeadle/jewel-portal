@namespace Jewel.JPMS.Features.Variations
@using Jewel.JPMS.Contracts.Variations

@* The variation's line items — one table at every stage. Before approval they are the lines held
   on the record; once approved, the lines on the Valuation Report under its V-ref. The status says
   which; the table reads the same either way. *@
<Panel Title="Line items" IsLoading="IsLoading" Prominent="false" LoadingLabel="Loading line items" BodyClass="overflow-x-auto">
    <HeaderActions>
        <span class="text-xs text-content-subtle">@Note</span>
    </HeaderActions>
    <ChildContent>
        @if (Lines.Count == 0)
        {
            <EmptyState Message="@EmptyMessage" />
        }
        else
        {
        <table class="data-table data-table-dense">
            <thead>
                <tr>
                    <th>Cost centre</th>
                    <th>Description</th>
                    <th class="text-right">Qty</th>
                    <th class="text-right">Rate £</th>
                    <th class="text-right">Amount £</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Lines)
                {
                    var amount = line.Quantity * line.Rate;
                    <tr>
                        <td class="font-mono text-xs whitespace-nowrap">@line.CostCode</td>
                        <td>@line.Description</td>
                        <td class="text-right font-mono">@line.Quantity.ToString("0.##", Gb)</td>
                        <td class="text-right font-mono">@line.Rate.ToString("N2", Gb)</td>
                        <td class="text-right font-mono @(amount < 0m ? "text-negative" : "")">@amount.ToString("N2", Gb)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="border-t border-line-strong font-semibold text-content">
                    <td colspan="4">Total</td>
                    @* whitespace-nowrap: a negative total must never wrap its minus sign onto
                       its own line and read as positive. *@
                    <td class="text-right font-mono whitespace-nowrap @(Total < 0m ? "text-negative" : "")">@Total.ToString("C2", Gb)</td>
                </tr>
            </tfoot>
        </table>
        }
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VariationLineInput> Lines { get; set; } = Array.Empty<VariationLineInput>();
    /// <summary>Where the lines stand — on the Valuation Report, or written there on approval.</summary>
    [Parameter] public string? Note { get; set; }
    [Parameter] public string EmptyMessage { get; set; } = "No line items yet.";
    [Parameter] public bool IsLoading { get; set; }

    private static readonly System.Globalization.CultureInfo Gb = System.Globalization.CultureInfo.GetCultureInfo("en-GB");
    private decimal Total => Lines.Sum(line => line.Quantity * line.Rate);
}
