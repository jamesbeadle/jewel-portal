@inject IJSRuntime JS
@implements IAsyncDisposable

<Panel Title="Works by trade" BodyClass="p-0">
    <HeaderActions>
        <Checkbox Value="@isGhosting" ValueChanged="SetGhostAsync" Label="Ghost removed" Title="Show what the works take out in red" />
        <Checkbox Value="@showsShell" ValueChanged="SetShellAsync" Label="Shell" Title="Show the house around the works" />
        <Toolbar>
            <ToolbarButton Icon="record" Label="@(isRecording ? "Stop recording" : "Record the play to a video")" Disabled="@(!ready)" Busy="@isRecording" OnClick="ToggleRecordingAsync" />
            <ToolbarButton Icon="fullscreen" Label="Fullscreen" Disabled="@(!ready)" OnClick="ToggleFullscreenAsync" />
        </Toolbar>
    </HeaderActions>
    <ChildContent>
        @if (error is not null)
        {
            <p class="p-6 text-sm text-content-subtle">The works couldn't be shown (@error).</p>
        }
        @if (error is null)
        {
            <div class="flex">
                <LoadGate IsLoading="@(!ready)" Overlay="true" Label="Building the works" Class="flex-1 min-w-0">
                    <div @ref="host" class="aspect-[16/10] bg-canvas select-none" style="touch-action: none;"></div>
                </LoadGate>
                <WorksModelLegend Trades="@Definition.Trades" Hidden="@hiddenTrades" OnToggle="ToggleTradeAsync" />
            </div>
            <WorksModelStrip IsReady="@ready" IsPlaying="@isPlaying" PhaseIndex="@phaseIndex" Definition="@Definition" Picked="@picked"
                             Caption="@Caption" OnPlay="PlayAsync" OnPause="PauseAsync" OnPhase="SetPhaseAsync" OnClosePicked="ClosePicked" />
        }
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired] public string DefinitionJson { get; set; } = "";
    [Parameter, EditorRequired] public WorksModelDefinition Definition { get; set; } = default!;
    [Parameter] public string? Caption { get; set; }

    private ElementReference host;
    private WorksModelInterop? viewer;
    private DotNetObjectReference<LeadWorksModelPanel>? selfReference;
    private readonly HashSet<string> hiddenTrades = new();
    private bool ready;
    private bool isPlaying;
    private bool isGhosting = true;
    private bool showsShell = true;
    private bool isRecording;
    private int phaseIndex;
    private WorksElement? picked;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (viewer is not null || error is not null) return;
        viewer = new WorksModelInterop(JS, host);
        selfReference ??= DotNetObjectReference.Create(this);
        try { await viewer.Mount(DefinitionJson, selfReference); }
        catch (JSException exception) { error = exception.Message; StateHasChanged(); }
    }

    [JSInvokable] public void ModelReady(int phaseCount) { ready = true; StateHasChanged(); }
    [JSInvokable] public void PhaseChanged(int index) { phaseIndex = index; StateHasChanged(); }
    [JSInvokable] public void PlaybackChanged(string state) { isPlaying = state == "playing"; StateHasChanged(); }
    [JSInvokable] public void ElementPicked(string? json) { picked = WorksElement.FromJson(json); StateHasChanged(); }
    [JSInvokable] public void RecordingChanged(bool recording) { isRecording = recording; StateHasChanged(); }

    private Task PlayAsync() => viewer!.Play();
    private Task PauseAsync() => viewer!.Pause();
    private Task ToggleFullscreenAsync() => viewer!.ToggleFullscreen();
    private Task ToggleRecordingAsync() => isRecording ? viewer!.StopRecording() : viewer!.StartRecording();
    private void ClosePicked() => picked = null;

    private Task SetPhaseAsync(int index) { phaseIndex = index; return viewer!.SetPhase(index); }
    private Task SetGhostAsync(bool value) { isGhosting = value; return viewer!.SetGhost(value); }
    private Task SetShellAsync(bool value) { showsShell = value; return viewer!.SetShell(value); }

    private Task ToggleTradeAsync((string Key, bool IsVisible) change)
    {
        var (key, isVisible) = change;
        _ = isVisible ? hiddenTrades.Remove(key) : hiddenTrades.Add(key);
        return viewer!.SetTradeVisible(key, isVisible);
    }

    public async ValueTask DisposeAsync()
    {
        try { if (viewer is not null) await viewer.Dispose(); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        selfReference?.Dispose();
    }
}
