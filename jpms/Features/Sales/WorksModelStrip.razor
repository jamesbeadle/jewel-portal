<footer class="px-6 py-4 border-t border-line space-y-3">
    <div class="flex flex-wrap items-center gap-3">
        @if (IsPlaying)
        {
            <button type="button" class="btn-secondary" @onclick="OnPause">Pause</button>
        }
        @if (!IsPlaying)
        {
            <button type="button" class="btn-primary" disabled="@(!IsReady)" @onclick="OnPlay">Play the phases</button>
        }
        <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-content">@PhaseTitle</p>
            <p class="text-xs text-content-subtle">Drag the slider to any phase, click an element to read it, drag the model to orbit.</p>
        </div>
    </div>
    <input type="range" class="w-full" min="0" max="@(Math.Max(0, Phases.Count - 1))" step="1" value="@PhaseIndex"
           disabled="@(!IsReady)" aria-label="Phase" @oninput="OnScrub" />
    <ol class="flex justify-between text-xs text-content-faint" aria-hidden="true">
        @foreach (var phase in Phases)
        {
            <li>@phase.Key</li>
        }
    </ol>
    @if (Picked is not null)
    {
        <WorksElementCard Element="@Picked" Definition="@Definition" OnClose="OnClosePicked" />
    }
    @if (Caption is not null)
    {
        <p class="text-xs text-content-faint">@Caption</p>
    }
</footer>

@code {
    [Parameter] public bool IsReady { get; set; }
    [Parameter] public bool IsPlaying { get; set; }
    [Parameter] public int PhaseIndex { get; set; }
    [Parameter, EditorRequired] public WorksModelDefinition Definition { get; set; } = default!;
    [Parameter] public WorksElement? Picked { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public EventCallback OnPlay { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback<int> OnPhase { get; set; }
    [Parameter] public EventCallback OnClosePicked { get; set; }

    private IReadOnlyList<WorksPhase> Phases => Definition.Phases;

    private string PhaseTitle => PhaseIndex >= 0 && PhaseIndex < Phases.Count
        ? $"Phase {Phases[PhaseIndex].Key} · {Phases[PhaseIndex].Name}"
        : "The works by phase";

    private Task OnScrub(ChangeEventArgs args)
    {
        var text = args.Value?.ToString();
        return int.TryParse(text, out var index) ? OnPhase.InvokeAsync(index) : Task.CompletedTask;
    }
}
