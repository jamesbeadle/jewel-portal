@using Jewel.JPMS.Contracts.Sales
@inject ICommandSender Commands
@inject IUserDirectory UserDirectory
@inject AuthService Auth
@implements IDisposable

@*
    Create or edit a sales strategy. The brief comes first and is all a new strategy needs — the
    idea in the team's own words; the audience and channel say who and how; and "Research it now
    with AI" (on by default when creating) sends it to the worker, which finds the areas, the
    evidence and the pitch and fills the rest in. The definition fields sit under a fold for
    anyone who wants to write them by hand — the research keeps whatever is written. The
    approach plan is not here: it is drafted (or written) on the strategy page.
*@

<Modal IsOpen="@IsOpen"
       Title="@(Existing is null ? "New strategy" : "Edit strategy")"
       ConfirmLabel="@(busy ? "Saving…" : Existing is null ? (researchNow ? "Create & research" : "Create strategy") : "Save changes")"
       ConfirmDisabled="@(busy || !FormReady)"
       OnCancel="Cancel"
       OnConfirm="SaveAsync"
       Class="max-w-3xl">
    @if (error is not null)
    {
        <p class="rounded bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-4">@error</p>
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-content mb-1">Name *</label>
            <input type="text" class="field w-full" maxlength="256" placeholder="Something short you'd say out loud — e.g. Build before the price rise"
                   value="@name" @oninput="e => name = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-content mb-1">The idea, in your own words *</label>
            <textarea class="field w-full" rows="5" maxlength="4000"
                      placeholder="e.g. Find the areas where house prices are about to rise faster than the rest of the county — new stations, big planning consents, that sort of thing — and write to the owners of the bigger houses there with the research, making the case that extending or rebuilding now is an investment that pays twice."
                      value="@brief" @oninput="e => brief = e.Value?.ToString() ?? string.Empty"></textarea>
            <p class="text-xs text-content-subtle mt-1">This is what the research works from. Say who you're after and why they'd say yes; the AI finds the where, the numbers and the sources.</p>
        </div>
        <div>
            <label class="block text-sm font-medium text-content mb-1">Who it targets</label>
            <select class="field w-full" value="@audience" @onchange="e => audience = Enum.Parse<SalesAudience>(e.Value?.ToString() ?? nameof(SalesAudience.Homeowners))">
                @foreach (var option in Enum.GetValues<SalesAudience>())
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-content mb-1">How they are reached</label>
            <select class="field w-full" value="@channel" @onchange="e => channel = Enum.Parse<SalesChannel>(e.Value?.ToString() ?? nameof(SalesChannel.Mixed))">
                @foreach (var option in Enum.GetValues<SalesChannel>())
                {
                    <option value="@option">@option.DisplayName()</option>
                }
            </select>
        </div>
        @if (Existing is null)
        {
            <div class="sm:col-span-2">
                <label class="inline-flex items-center gap-2 text-sm text-content cursor-pointer">
                    <input type="checkbox" checked="@researchNow" @onchange="e => researchNow = e.Value is true" />
                    <span>Research it now with AI — find the areas, the evidence and the pitch, and draft the plan (a few minutes, in the background)</span>
                </label>
            </div>
        }
        <div class="sm:col-span-2">
            <button type="button" class="btn-ghost text-sm" @onclick="() => detailsOpen = !detailsOpen">
                @(detailsOpen ? "Hide the details" : Existing is null ? "Write the details yourself instead (optional)" : "Show the details")
            </button>
        </div>
        @if (detailsOpen)
        {
            <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-content mb-1">Where</label>
                <input type="text" class="field w-full" maxlength="512" placeholder="Leave blank for the research to find — or postcodes, towns, a radius"
                       value="@targetArea" @oninput="e => targetArea = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-content mb-1">Hypothesis — why these people, why now</label>
                <textarea class="field w-full" rows="3" maxlength="4000" placeholder="Leave blank for the research to write from the evidence"
                          value="@hypothesis" @oninput="e => hypothesis = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-content mb-1">Evidence — the data and findings behind it</label>
                <textarea class="field w-full" rows="3" maxlength="4000" placeholder="Leave blank for the research to find — or what you already know and where it came from"
                          value="@evidence" @oninput="e => evidence = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
            <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-content mb-1">Proposition — what we say to them</label>
                <textarea class="field w-full" rows="2" maxlength="1024" placeholder="Leave blank for the research to draft"
                          value="@proposition" @oninput="e => proposition = e.Value?.ToString() ?? string.Empty"></textarea>
            </div>
        }
        <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-content mb-1">Owner *</label>
            <SearchSelect Options="@OwnerOptions" Value="@ownerEmail" ValueChanged="v => ownerEmail = v"
                          Placeholder="Who is running it" WidthClass="w-full" InputClass="field" />
        </div>
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public SalesStrategy? Existing { get; set; }
    /// <summary>Fires with the saved strategy and whether research was requested (creating only).</summary>
    [Parameter] public EventCallback<SalesStrategy> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool busy;
    private string? error;
    private string? loadedForKey;
    private bool detailsOpen;
    private bool researchNow = true;

    private string name = "";
    private string brief = "";
    private SalesAudience audience = SalesAudience.Homeowners;
    private SalesChannel channel = SalesChannel.DirectMail;
    private string targetArea = "";
    private string hypothesis = "";
    private string evidence = "";
    private string proposition = "";
    private string ownerEmail = "";

    private bool FormReady => !string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(brief) && !string.IsNullOrWhiteSpace(ownerEmail);

    private IReadOnlyList<SearchSelect.Option> OwnerOptions =>
        UserDirectory.All()
            .OrderBy(user => user.DisplayName, StringComparer.OrdinalIgnoreCase)
            .Select(user => new SearchSelect.Option(user.Email, string.IsNullOrWhiteSpace(user.DisplayName) ? user.Email : user.DisplayName))
            .ToList();

    protected override void OnInitialized()
    {
        UserDirectory.OnChange += StateHasChanged;
        _ = UserDirectory.All();
    }

    protected override void OnParametersSet()
    {
        var key = IsOpen ? Existing?.StrategyId ?? "new" : null;
        if (key is null) { loadedForKey = null; return; }
        if (loadedForKey == key) return;
        loadedForKey = key;
        error = null;
        if (Existing is { } strategy)
        {
            name = strategy.Name; brief = strategy.Brief; audience = strategy.Audience; channel = strategy.Channel;
            targetArea = strategy.TargetArea; hypothesis = strategy.Hypothesis; evidence = strategy.Evidence;
            proposition = strategy.Proposition; ownerEmail = strategy.OwnerEmail;
            detailsOpen = true;
            researchNow = false;
        }
        else
        {
            name = ""; brief = ""; audience = SalesAudience.Homeowners; channel = SalesChannel.DirectMail;
            targetArea = ""; hypothesis = ""; evidence = ""; proposition = "";
            ownerEmail = Auth.CurrentUser?.Email ?? "";
            detailsOpen = false;
            researchNow = true;
        }
    }

    private async Task Cancel()
    {
        if (busy) return;
        await OnCancel.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (!FormReady || busy) return;
        busy = true; error = null;
        try
        {
            SalesStrategy saved = Existing is { } strategy
                ? await Commands.SendAsync(new UpdateSalesStrategy(
                    strategy.StrategyId, name.Trim(), brief.Trim(), audience, targetArea.Trim(), hypothesis.Trim(), evidence.Trim(),
                    channel, proposition.Trim(), strategy.ApproachPlan, ownerEmail.Trim()), CancellationToken.None)
                : await Commands.SendAsync(new CreateSalesStrategy(
                    name.Trim(), brief.Trim(), audience, targetArea.Trim(), hypothesis.Trim(), evidence.Trim(),
                    channel, proposition.Trim(), ownerEmail.Trim()), CancellationToken.None);
            if (Existing is null && researchNow)
            {
                // Kick the research off straight away; a refusal here (no queue configured) is
                // shown on the strategy page's research banner rather than blocking the create.
                try { saved = await Commands.SendAsync(new RunStrategyResearch(saved.StrategyId), CancellationToken.None); }
                catch (CommandFailedException) { }
            }
            await OnSaved.InvokeAsync(saved);
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    public void Dispose() => UserDirectory.OnChange -= StateHasChanged;
}
