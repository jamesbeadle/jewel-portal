<div class="rounded border border-line px-4 py-3 text-sm">
    <div class="flex items-start justify-between gap-3">
        <p class="font-medium text-content">@Element.Name</p>
        <button type="button" class="btn-secondary text-xs" @onclick="OnClose">Close</button>
    </div>
    <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
        <dt class="text-content-subtle">Trade</dt><dd class="text-content">@TradeName</dd>
        <dt class="text-content-subtle">Joins</dt><dd class="text-content">@PhaseName(Element.PhaseIn, "Existing")</dd>
        <dt class="text-content-subtle">Leaves</dt><dd class="text-content">@PhaseName(Element.PhaseOut, "Stays")</dd>
        @if (!string.IsNullOrWhiteSpace(Element.CostCode))
        {
            <dt class="text-content-subtle">Cost code</dt><dd class="text-content">@Element.CostCode</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Element.VariationRef))
        {
            <dt class="text-content-subtle">Variation</dt><dd class="text-content">@Element.VariationRef</dd>
        }
    </dl>
    @if (!string.IsNullOrWhiteSpace(Element.Note))
    {
        <p class="mt-2 text-xs text-content-subtle">@Element.Note</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public WorksElement Element { get; set; } = default!;
    [Parameter, EditorRequired] public WorksModelDefinition Definition { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private string TradeName
    {
        get
        {
            var key = Element.Trade;
            var trade = Definition.Trades.FirstOrDefault(candidate => candidate.Key == key);
            return trade?.Name ?? key;
        }
    }

    private string PhaseName(string? key, string whenNone)
    {
        if (string.IsNullOrWhiteSpace(key)) return whenNone;
        var phase = Definition.Phases.FirstOrDefault(candidate => candidate.Key == key);
        return phase is null ? key : $"{phase.Key} {phase.Name}";
    }
}
