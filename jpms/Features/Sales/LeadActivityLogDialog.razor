@using Jewel.JPMS.Contracts.Sales
@inject ICommandSender Commands

<Modal IsOpen="@IsOpen"
       Title="Log activity"
       ConfirmLabel="@(busy ? "Saving…" : "Add to timeline")"
       ConfirmDisabled="@(busy || string.IsNullOrWhiteSpace(logSummary))"
       OnCancel="OnCancel"
       OnConfirm="LogAsync">
    @if (error is not null)
    {
        <Notice Tone="Tone.Negative" Class="mb-4">@error</Notice>
    }
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
            <FormField Label="What">
            <select class="field w-full" value="@logKind" @onchange="e => logKind = Enum.Parse<LeadActivityKind>(e.Value?.ToString() ?? nameof(LeadActivityKind.Note))">
                @foreach (var kind in LeadActivityKindExtensions.Loggable)
                {
                    <option value="@kind">@kind.DisplayName()</option>
                }
            </select>
            </FormField>
        </div>
        <div>
            <FormField Label="When">
            <input type="datetime-local" class="field w-full" value="@logWhen" @onchange="e => logWhen = e.Value?.ToString() ?? string.Empty" />
            </FormField>
        </div>
        <div class="sm:col-span-2">
            <FormField Label="What happened" Required>
            <textarea class="field w-full" rows="4" maxlength="4000" placeholder="Who you spoke to, what was said, what happens next"
                      value="@logSummary" @oninput="e => logSummary = e.Value?.ToString() ?? string.Empty"></textarea>
            </FormField>
        </div>
    </div>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public string LeadId { get; set; } = "";
    [Parameter] public EventCallback OnLogged { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool busy;
    private bool wasOpen;
    private string? error;
    private LeadActivityKind logKind = LeadActivityKind.Call;
    private string logSummary = "";
    private string logWhen = "";

    protected override void OnParametersSet()
    {
        if (IsOpen == wasOpen) return;
        wasOpen = IsOpen;
        if (!IsOpen) return;
        error = null;
        logKind = LeadActivityKind.Call;
        logSummary = "";
        logWhen = DateTime.Now.ToString("yyyy-MM-dd'T'HH:mm");
    }

    private async Task LogAsync()
    {
        if (busy || string.IsNullOrWhiteSpace(logSummary)) return;
        busy = true; error = null;
        try
        {
            DateTimeOffset? when = DateTime.TryParse(logWhen, out var parsed) ? new DateTimeOffset(parsed, TimeZoneInfo.Local.GetUtcOffset(parsed)) : null;
            await Commands.SendAsync(new LogLeadActivity(LeadId, logKind, logSummary.Trim(), when), CancellationToken.None);
            await OnLogged.InvokeAsync();
        }
        catch (CommandFailedException ex) { error = ex.Message; }
        finally { busy = false; }
    }
}
