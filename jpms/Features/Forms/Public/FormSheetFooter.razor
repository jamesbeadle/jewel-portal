<footer class="form-sheet-footer">
    <div>@RegistrationLine</div>
    <div>Registered office: @JewelBespokeBuild.RegisteredOffice</div>
    <div>
        <a href="@PhoneAddress" rel="noopener">@JewelBespokeBuild.Phone</a>@Between
        <a href="@EmailAddress" rel="noopener">@JewelBespokeBuild.Email</a>@Between
        <a href="@JewelBespokeBuild.Website" target="@NewTab" rel="noopener">@WebsiteLabel</a>
    </div>
    <div class="mt-2.5"><a href="@PrivacyNoticeLink.Path" target="@NewTab" rel="noopener">How we look after your details</a></div>
</footer>

@code {
    private const string Between = " · ";
    private const string NewTab = "_blank";

    private static string RegistrationLine => string.Join(Between, new[]
    {
        JewelBespokeBuild.LegalName,
        "Company no. " + JewelBespokeBuild.CompanyNumber,
        JewelBespokeBuild.VatNumber.Length > 0 ? "VAT " + JewelBespokeBuild.VatNumber : ""
    }.Where(part => part.Length > 0));

    private static string PhoneAddress => "tel:" + JewelBespokeBuild.Phone.Replace(" ", "");

    private static string EmailAddress => "mailto:" + JewelBespokeBuild.Email;

    private static string WebsiteLabel => new Uri(JewelBespokeBuild.Website).Host;
}
