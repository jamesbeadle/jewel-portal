<div class="form-sheet">
    <div class="form-sheet-column">
        <div class="form-sheet-logo-bar">
            <img class="form-sheet-logo" src="@Logo" alt="@JewelBespokeBuild.ShortName" />
        </div>
        <div class="form-sheet-hero">
            <div class="form-sheet-kicker">@JewelBespokeBuild.ShortName</div>
            <div class="form-sheet-title"><h1>@Title</h1></div>
            <p class="form-sheet-intro">@Intro</p>
        </div>
        @ChildContent
        <FormSheetFooter />
    </div>
</div>

@code {
    private const string Logo = "/branding/jewel-bespoke-build-logo.svg";

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Intro { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
