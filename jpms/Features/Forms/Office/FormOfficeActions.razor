@switch (Reading.Submission.FormSlug)
{
    case FormSlugs.TrainingCertificate:
        <AcceptTrainingPanel Reading="Reading" OnChanged="OnChanged" />
        break;
    case FormSlugs.SubcontractorQuestionnaire:
    case FormSlugs.InsuranceUpdate:
        <FileToDirectoryPanel Reading="Reading" OnChanged="OnChanged" />
        break;
    case FormSlugs.CyberQuiz:
        if (Reading.View.QuizScore is { } score)
        {
            <QuizResultPanel Reading="Reading" Score="score" OnChanged="OnChanged" />
        }
        break;
    case FormSlugs.CompanyVehicle:
        <LicenceCheckPanel Reading="Reading" OnChanged="OnChanged" />
        break;
    case FormSlugs.RightToWork:
        <RightToWorkFromFormPanel Reading="Reading" OnChanged="OnChanged" />
        break;
    case FormSlugs.WorkstationAssessment:
        <WorkstationActionsPanel Reading="Reading" OnChanged="OnChanged" />
        break;
}

@code {
    [Parameter, EditorRequired] public FormSubmissionReading Reading { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
}
