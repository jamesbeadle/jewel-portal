@namespace Jewel.JPMS.Features.Cashflow
@using static Jewel.JPMS.Features.Cashflow.CashflowDisplay

@* The balance line, drawn inline — one series, the zero line dashed, the trough flagged.
   Coordinates are formatted invariant: SVG wants dots regardless of the browser's culture. *@
@{
    const double width = 1000, height = 140, padX = 30, padTop = 18, padBottom = 22;
    var closing = Closing;
    var low = Math.Min(0m, closing.Min());
    var high = Math.Max(HighReference, closing.Max());
    if (high == low) high = low + 1m;
    string S(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    double X(int index) => padX + (width - 2 * padX) * index / Math.Max(1, closing.Length - 1);
    double Y(decimal value) => padTop + (height - padTop - padBottom) * (1 - (double)((value - low) / (high - low)));
    var path = string.Join(" ", closing.Select((value, index) => $"{(index == 0 ? "M" : "L")}{S(X(index))} {S(Y(value))}"));
}
<svg width="100%" height="140" viewBox="0 0 1000 140" preserveAspectRatio="none" role="img"
     aria-label="Closing bank balance by month">
    <line x1="@S(padX)" y1="@S(Y(0m))" x2="@S(width - padX)" y2="@S(Y(0m))"
          stroke="#34373B" stroke-width="1" stroke-dasharray="4 4" />
    <path d="@path" fill="none" stroke="#57E08A" stroke-width="2" stroke-linejoin="round" />
    @for (var index = 0; index < closing.Length; index++)
    {
        var isMin = index == MinIndex;
        <circle cx="@S(X(index))" cy="@S(Y(closing[index]))" r="@(isMin ? "5" : "3.5")"
                fill="@(isMin ? "#FF4D4D" : "#57E08A")" stroke="#161719" stroke-width="2">
            <title>@MonthLabel(Axis[index]): @Money(closing[index])</title>
        </circle>
        @* SVG's <text> element collides with Razor's own <text> literal tag, which may
           not carry attributes (RZ1023) — so the labels are emitted as MarkupString.
           Safe: every interpolated value is numeric or from our own formatters. *@
        @((MarkupString)($"<text x=\"{S(X(index))}\" y=\"{S(height - 6)}\" text-anchor=\"{(index == 0 ? "start" : index == closing.Length - 1 ? "end" : "middle")}\" font-size=\"10\" fill=\"#8A9099\">{System.Net.WebUtility.HtmlEncode(MonthLabel(Axis[index]))}</text>"))
    }
    @((MarkupString)($"<text x=\"{S(X(MinIndex))}\" y=\"{S(Y(closing[MinIndex]) - 10)}\" text-anchor=\"middle\" font-size=\"11\" font-weight=\"600\" fill=\"#FF4D4D\">{System.Net.WebUtility.HtmlEncode(Money(closing[MinIndex]))}</text>"))
</svg>

@code {
    /// <summary>The forecast months, one label per point.</summary>
    [Parameter, EditorRequired] public DateTime[] Axis { get; set; } = default!;
    /// <summary>The closing balance per month — the one series.</summary>
    [Parameter, EditorRequired] public decimal[] Closing { get; set; } = default!;
    /// <summary>The trough's index — flagged red with its figure above it.</summary>
    [Parameter] public int MinIndex { get; set; }
    /// <summary>Today's bank position: the top of the scale never sits below it.</summary>
    [Parameter] public decimal HighReference { get; set; }
}
