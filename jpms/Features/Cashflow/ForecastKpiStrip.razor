@namespace Jewel.JPMS.Features.Cashflow
@using static Jewel.JPMS.Features.Cashflow.CashflowDisplay

@* The KPI strip, directors only — every tile is anchored to the bank position (mirrors the
   API's directors-only gate). Tiles keep their shape while loading: label stays, figure
   pulses. *@
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    <StatTile Label="Cash in bank" IsLoading="@(Bank is null)">
        @if (!Bank!.IsConfigured || Bank.Error is not null)
        {
            <p class="text-sm text-content-muted mt-1">@(Bank.Error ?? "Xero isn't connected — add the Xero__ClientId / Xero__ClientSecret app settings.")</p>
        }
        else
        {
            <p class="text-2xl font-semibold text-content">@Money(Bank.TotalCash)</p>
            <p class="text-xs text-content-subtle mt-1">@Bank.BankAccounts.Count @(Bank.BankAccounts.Count == 1 ? "account" : "accounts") · fetched @FetchedText</p>
        }
    </StatTile>
    <StatTile Label="Lowest forecast balance" IsLoading="@(!BankReady || !TableReady)"
                Title="The lowest the forecast bank balance gets across the visible months — the month to plan for.">
        @if (Forecast is not { } low || low.Closing.Length == 0)
        {
            <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
        }
        else
        {
            <p class="text-2xl font-semibold @(low.Closing[low.MinIndex] < 0m ? "text-negative" : "text-content")">@Money(low.Closing[low.MinIndex])</p>
            <p class="text-xs text-content-subtle mt-1">@MonthLabel(low.Axis[low.MinIndex]) — the month to plan for</p>
        }
    </StatTile>
    <StatTile Label="Outstanding sales invoices" IsLoading="@(Bank is null)">
        @if (!Bank!.IsConfigured || Bank.Error is not null)
        {
            <p class="text-sm text-content-muted mt-1">—</p>
        }
        else
        {
            <p class="text-2xl font-semibold text-content">@Money(Bank.TotalOutstanding)</p>
            <p class="text-xs text-content-subtle mt-1">
                issued &amp; awaiting payment ·
                <a class="underline underline-offset-2 hover:text-content" href="/finance/aged-receivables">aged receivables</a>
            </p>
        }
    </StatTile>
    <StatTile Label="Balance at horizon end" IsLoading="@(!BankReady || !TableReady)"
                Title="Bank cash after every visible month and the dated flows beyond them — where the selected jobs leave the company if they run to the end as forecast. Undated flows excluded until they earn a date.">
        @if (Forecast is not { } view || view.Closing.Length == 0)
        {
            <p class="text-sm text-content-muted mt-1">Needs the bank position from Xero.</p>
        }
        else
        {
            var horizonEnd = view.Closing[^1] + view.LaterNet;
            <p class="text-2xl font-semibold @(horizonEnd < 0m ? "text-negative" : "text-content")">@Money(horizonEnd)</p>
            <p class="text-xs text-content-subtle mt-1">after @MonthLabel(view.Axis[^1]) incl. later retention releases</p>
        }
    </StatTile>
</div>

@code {
    /// <summary>The Xero bank position — null until the store has answered.</summary>
    [Parameter] public XeroCashSummarySnapshot? Bank { get; set; }
    [Parameter] public bool BankReady { get; set; }
    /// <summary>Every selected project has landed — the forecast can be built.</summary>
    [Parameter] public bool TableReady { get; set; }
    /// <summary>The forecast as built this render — null until it can be.</summary>
    [Parameter] public ForecastView? Forecast { get; set; }
    [Parameter] public string FetchedText { get; set; } = "—";
}
