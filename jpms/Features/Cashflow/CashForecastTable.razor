@namespace Jewel.JPMS.Features.Cashflow
@using Jewel.JPMS.Commercial
@using static Jewel.JPMS.Features.Cashflow.CashflowDisplay

@* The forecast table: one column per month, rows in two bands, every category expandable to
   its per-project lines; then the running answer — project movement, the overheads row, net
   movement, and for directors the closing bank balance with its low point ringed. *@
<RecordsTable Dense="true" MaxHeight="" Class="mb-6">
    <thead>
        <tr>
            <th class="min-w-[230px]"></th>
            @foreach (var month in Forecast.Axis)
            {
                <th class="text-right whitespace-nowrap">@MonthLabel(month)</th>
            }
            <th class="text-right whitespace-nowrap border-l"
                title="Dated flows beyond the visible months — typically the final retention releases.">Later</th>
            <th class="text-right whitespace-nowrap border-l"
                title="Flows with no honest date — e.g. spreads on a project with no practical-completion date. Kept out of the balance until dated.">Undated</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="@(Forecast.Axis.Length + 3)" class="eyebrow">Cash in</td>
        </tr>
        @foreach (var row in ForecastRows.In)
        {
            <ForecastCategoryRow Forecast="Forecast" Row="row" Expanded="ExpandedCategories.Contains(row.Category)" OnToggle="OnToggle"
                                 OnNextValuationChanged="OnNextValuationChanged" OnMonthlyValuationChanged="OnMonthlyValuationChanged" />
        }
        <tr>
            <td colspan="@(Forecast.Axis.Length + 3)" class="eyebrow">Cash out</td>
        </tr>
        @foreach (var row in ForecastRows.Out)
        {
            <ForecastCategoryRow Forecast="Forecast" Row="row" Expanded="ExpandedCategories.Contains(row.Category)" OnToggle="OnToggle"
                                 OnNextValuationChanged="OnNextValuationChanged" OnMonthlyValuationChanged="OnMonthlyValuationChanged" />
        }
        @* Project movement — the ticked projects' cash in less cash out,
           before company overheads (FD, 2026-08-17): what the selected jobs
           themselves move, so the jobs and the overheads read separately. *@
        <tr class="border-t-2 font-medium">
            <td>
                <span class="text-content font-medium">Project movement</span>
                <span class="block text-xs text-content-faint font-normal">cash in less cash out for the projects ticked — before company overheads</span>
            </td>
            @for (var index = 0; index < Forecast.Axis.Length; index++)
            {
                var movement = Forecast.ProjectNet[index];
                <td class="text-right whitespace-nowrap @(movement < 0m ?"text-negative" : "text-positive")">@Signed(movement)</td>
            }
            <td class="text-right whitespace-nowrap border-l @(Forecast.LaterNet < 0m ?"text-negative" : "text-positive")">@Signed(Forecast.LaterNet)</td>
            <td class="text-right border-l text-content-faint font-normal" title="Undated flows are excluded from the balance until they earn a date.">excluded</td>
        </tr>
        <OverheadsRow Axis="Forecast.Axis" Default="OverheadsDefault" Overrides="OverheadsOverrides"
                      OnDefaultChanged="OnOverheadsDefaultChanged" OnMonthChanged="OnOverheadsMonthChanged" />
        @* ── The running answer ── *@
        <tr class="border-t-2 font-semibold">
            <td class="text-content">
                Net movement
                <span class="block text-xs text-content-faint font-normal">project movement less company overheads</span>
            </td>
            @for (var index = 0; index < Forecast.Axis.Length; index++)
            {
                var net = Forecast.Net[index];
                <td class="text-right whitespace-nowrap @(net < 0m ?"text-negative" : "text-positive")">@Signed(net)</td>
            }
            <td class="text-right whitespace-nowrap border-l @(Forecast.LaterNet < 0m ?"text-negative" : "text-positive")">@Signed(Forecast.LaterNet)</td>
            <td class="text-right border-l text-content-faint font-normal" title="Undated flows are excluded from the balance until they earn a date.">excluded</td>
        </tr>
        @if (IsDirector && Forecast.Closing.Length > 0)
        {
            <ClosingBalanceRow Forecast="Forecast" />
        }
    </tbody>
</RecordsTable>

@code {
    [Parameter, EditorRequired] public ForecastView Forecast { get; set; } = default!;
    /// <summary>The bank-anchored row is the directors' — mirroring the API's gate.</summary>
    [Parameter] public bool IsDirector { get; set; }
    [Parameter, EditorRequired] public IReadOnlyCollection<ForecastCategory> ExpandedCategories { get; set; } = default!;
    [Parameter] public EventCallback<ForecastCategory> OnToggle { get; set; }
    [Parameter] public EventCallback<(Project Project, ChangeEventArgs Args)> OnNextValuationChanged { get; set; }
    [Parameter] public EventCallback<(Project Project, ChangeEventArgs Args)> OnMonthlyValuationChanged { get; set; }
    [Parameter] public decimal OverheadsDefault { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<DateTime, decimal> OverheadsOverrides { get; set; } = default!;
    [Parameter] public EventCallback<ChangeEventArgs> OnOverheadsDefaultChanged { get; set; }
    [Parameter] public EventCallback<(DateTime Month, ChangeEventArgs Args)> OnOverheadsMonthChanged { get; set; }
}
