@namespace Jewel.JPMS.Features.Todos.Detail
@using Jewel.JPMS.Features.Todos

@* The "Assigned to" fact: a role, optionally pinned to a named holder — the picker is the role
   select plus the optional person select (TodoAssigneeSelect), then Save. Reassigning a DONE item would move work nobody is going to do, so the control is
   for open items only. *@

<div>
    <dt class="eyebrow">Assigned to</dt>
    @if (editing)
    {
        <TodoFactEditor Options="@Options" InitialValue="@TodoAssigneePicker.ValueFor(Item)" Assignee="true"
                        Placeholder="Unassigned" Busy="@Busy" RequirePick="false"
                        Hint="A role puts this item on the list of everyone holding it; a named person keeps it to their list alone. Either way it leaves the old assignee's list."
                        OnSave="SaveAsync" OnCancel="() => editing = false" />
    }
    else
    {
        <dd class="text-content mt-0.5 flex flex-wrap items-center gap-2">
            <span>@(TodoAssigneePicker.Label(Item) ?? "Unassigned")</span>
            @if (ShowReassign)
            {
                <button type="button" class="btn-secondary text-xs px-1.5 py-0.5" disabled="@Busy"
                        title="Assign this item to a different role or person"
                        @onclick="() => editing = true">Reassign</button>
            }
        </dd>
    }
</div>

@code {
    [Parameter, EditorRequired] public TodoItem Item { get; set; } = default!;
    /// <summary>Whether the signed-in user may reassign — the API's manage gate, mirrored by the page.</summary>
    [Parameter] public bool CanReassign { get; set; }
    [Parameter] public IReadOnlyList<SearchSelect.Option> Options { get; set; } = Array.Empty<SearchSelect.Option>();
    [Parameter] public bool Busy { get; set; }
    /// <summary>Runs the reassign command; true = saved (the editor closes), false = failed (it
    /// stays open with the pick intact — the page's error bar carries the reason).</summary>
    [Parameter, EditorRequired] public Func<TodoAssignee?, Task<bool>> Reassign { get; set; } = default!;

    private bool editing;

    private bool ShowReassign => CanReassign && !Item.IsComplete && Options.Count > 0;

    private async Task SaveAsync(string picked)
    {
        if (await Reassign(TodoAssigneePicker.Parse(picked))) editing = false;
    }
}
