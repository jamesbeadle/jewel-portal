@using Jewel.JPMS.Contracts.Procurement
@using Jewel.JPMS.Features.CostCenters
@namespace Jewel.JPMS.Features.Procurement
@inject CostCentersReadModel CostCenters

@* Edit package details: the specification summary + the line-item schedule, edited together in
   ONE dialog with one Save. One act of authorship — and the one shape the AI flow can fill in a
   single update (splitting them across two dialogs relied on the model following through
   across turns, and it didn't: 2026-08-16). The dialog owns the drafts, seeding them from the
   package each time it opens, and hands back the trimmed schedule for the host to save; every
   kept line must know its cost-centre home before Save hands anything over.
   DismissOnOverlayClick off: a stray click must not throw away a half-keyed schedule. *@
<Modal IsOpen="IsOpen" Title="Edit package details" DismissOnOverlayClick="false"
       OnCancel="() => OnCancel.InvokeAsync()" Class="max-w-4xl w-full">
    <FooterContent>
        <button type="button" class="btn-secondary" disabled="@Busy" @onclick="() => lineDrafts.Add(new LineDraft())">Add line</button>
        <button type="button" class="btn-neutral" disabled="@Busy" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        <button type="button" class="btn-primary" disabled="@Busy" @onclick="SaveAsync">@(Busy ? "Saving…" : "Save details")</button>
    </FooterContent>
    <ChildContent>
        @if ((validationError ?? Error) is { } shown)
        {
            <p class="rounded-lg bg-negative/10 border border-negative/30 px-3 py-2 text-sm text-negative mb-3">@shown</p>
        }

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Specification summary</label>
        <p class="text-xs text-content-subtle mb-2">
            One point per line — it prints at the top of the pricing schedule each tenderer receives,
            so say what the package covers and to what standard.
        </p>
        <textarea class="field w-full min-h-28 mb-4" rows="6"
                  placeholder="One point per line — e.g. All flat roofing to BS 6229:2018."
                  @bind="specDraft"></textarea>

        <label class="block text-xs font-semibold uppercase tracking-wide text-content-subtle mb-1">Line items</label>
        <div class="rounded-xl border border-line bg-surface overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-surface-raised border-b border-line">
                    <tr class="text-left text-[11px] uppercase tracking-wider text-content-subtle font-semibold">
                        <th class="px-3 py-2">Trade</th>
                        <th class="px-3 py-2">Description</th>
                        <th class="px-3 py-2 hidden sm:table-cell">Unit</th>
                        <th class="px-3 py-2">Qty</th>
                        <th class="px-3 py-2">Cost code</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-line">
                    @for (var i = 0; i < lineDrafts.Count; i++)
                    {
                        var draft = lineDrafts[i];
                        <tr>
                            <td class="px-3 py-2"><input class="field" @bind="draft.Trade" placeholder="e.g. Electrical" /></td>
                            <td class="px-3 py-2"><input class="field" @bind="draft.Description" placeholder="Description" /></td>
                            <td class="px-3 py-2 hidden sm:table-cell"><input class="field" @bind="draft.Unit" placeholder="e.g. m²" /></td>
                            <td class="px-3 py-2"><input class="field" type="number" step="any" @bind="draft.Quantity" /></td>
                            <td class="px-3 py-2">
                                <select class="field min-w-[14rem]" @bind="draft.CostCode">
                                    <option value="">Cost centre…</option>
                                    @foreach (var centre in CostCenters.Alphabetical)
                                    {
                                        <option value="@centre.Code">@($"{centre.Code} — {centre.Name}")</option>
                                    }
                                </select>
                            </td>
                            <td class="px-3 py-2 text-right">
                                <button type="button" class="btn-neutral px-2 py-1 text-xs text-negative border-negative/40" @onclick="() => lineDrafts.Remove(draft)">Remove</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</Modal>
