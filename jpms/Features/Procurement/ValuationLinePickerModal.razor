@using Jewel.JPMS.Features.CostCenters
@namespace Jewel.JPMS.Features.Procurement
@inject IQueryClient Queries
@inject CostCentersReadModel CostCenters

@* Select line items from the valuation report — the fast path onto a bid package. Every priced
   row of the bill (contract works, PC sums, contingency, variations) is a checkbox; confirmed
   rows are handed back as package line inputs carrying the report's cost code, description,
   unit and quantity. Sale values are internal figures shown for context only — they are never
   stored on the package and never reach a tenderer. The modal owns its own read of the LIVE
   report (the same rows the Valuation tab edits) and resets itself each time it opens. *@
<Modal IsOpen="IsOpen" Title="Select line items" ShowFooter="true"
       ConfirmLabel="@(Busy ? "Adding…" : selection.Count == 0 ? "Add line items" : selection.Count == 1 ? "Add 1 line item" : $"Add {selection.Count} line items")"
       ConfirmDisabled="@(Busy || selection.Count == 0)" CancelLabel="Cancel"
       OnCancel="() => OnCancel.InvokeAsync()" OnConfirm="ConfirmAsync" Class="max-w-4xl w-full">
    @if (lines is null && !loadFailed)
    {
        <LoadGate IsLoading="true" Prominent="true" Label="Loading valuation report" />
    }
    else if (lines is null)
    {
        <p class="text-sm text-negative">Couldn't load the valuation report lines — close this dialog and try again.</p>
    }
    else if (SelectableLines.Count == 0)
    {
        <EmptyState Message="No priced lines on this project's valuation report yet. Build the report on the
            Valuation tab first, or key line items by hand under Edit details." />
    }
    else
    {
        <p class="rounded bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
            Tick the report lines this package covers — each becomes a line item carrying the
            report's cost code, description, unit and quantity (trade defaults to the package's
            own). Sale values are internal figures shown for context only — they are not saved
            on the package and never appear on anything a tenderer sees.
        </p>
        @* Search narrows the VIEW only — ticks made before narrowing survive it (the confirm
           reads the selection against the full report, not the filtered rows). *@
        <input class="field w-full mb-3" placeholder="Search by description, cost code or section…"
               value="@search" @oninput="OnSearchInput" />
        @if (FilteredLines.Count == 0)
        {
            <p class="text-sm text-content-subtle italic">
                No report lines match "@search.Trim()" — clear the search to see every line.
                @if (selection.Count > 0)
                {
                    <text> Your @(selection.Count == 1 ? "ticked line is" : $"{selection.Count} ticked lines are") still selected.</text>
                }
            </p>
        }
        else
        {
        <RecordsTable Dense="true" MaxHeight="max-h-[60vh]">
            <thead>
                <tr>
                    <th class="w-8"></th>
                    <th>Cost code</th>
                    <th>Description</th>
                    <th class="hidden sm:table-cell">Unit</th>
                    <th class="text-right">Qty</th>
                    <th class="text-right" title="Internal — never shown to tenderers">Sale value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in FilteredLines.GroupBy(GroupLabel))
                {
                    var groupIds = group.Where(l => !string.IsNullOrWhiteSpace(l.CostCode)).Select(l => l.ValuationLineItemId).ToList();
                    var allTicked = groupIds.Count > 0 && groupIds.All(selection.Contains);
                    <tr class="bg-surface-raised/60">
                        <td>
                            <input type="checkbox" checked="@allTicked" disabled="@(Busy || groupIds.Count == 0)"
                                   title="Select every line shown in this section"
                                   @onchange="() => ToggleGroup(group)" />
                        </td>
                        <td colspan="5" class="eyebrow">@group.Key</td>
                    </tr>
                    @foreach (var line in group)
                    {
                        var hasCostCode = !string.IsNullOrWhiteSpace(line.CostCode);
                        <tr class="@(hasCostCode ?"" : "opacity-60")">
                            <td>
                                <input type="checkbox" checked="@selection.Contains(line.ValuationLineItemId)"
                                       disabled="@(Busy || !hasCostCode)"
                                       title="@(hasCostCode ? null : "This line has no cost code on the valuation report — set one there first.")"
                                       @onchange="() => ToggleLine(line)" />
                            </td>
                            <td>
                                @if (hasCostCode)
                                {
                                    <span class="text-content-muted" title="@CostCentreLabel(line.CostCode)">@line.CostCode</span>
                                }
                                else
                                {
                                    <Pill Tone="Tone.Warning">No cost code</Pill>
                                }
                            </td>
                            <td class="text-content">
                                @LineDescription(line)
                                @if (LineTypeBadge(line) is { } badge)
                                {
                                    <Pill Tone="Tone.Muted" Class="ml-2">@badge</Pill>
                                }
                            </td>
                            <td class="hidden sm:table-cell">@line.Unit</td>
                            <td class="text-right">@line.Quantity</td>
                            <td class="text-right tabular-nums">@line.LineAmount.ToString("£#,##0.00")</td>
                        </tr>
                    }
                }
            </tbody>
        </RecordsTable>
        }
        <p class="text-xs text-content-subtle mt-2">
            Lines are appended — nothing already on the package changes. Adjust descriptions,
            units and quantities afterwards under Edit details, and link coverage from the
            line list as usual.
        </p>
    }
</Modal>
