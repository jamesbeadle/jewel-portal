@namespace Jewel.JPMS.Features.Procurement

@* Work-order email to the winning subcontractor: drafted into the shared mailbox, sent from
   Outlook — nothing sends from here. The page seeds the subject and body from the order. *@
<Modal IsOpen="IsOpen" Title="Email work order to winner" ShowFooter="true"
       ConfirmLabel="@(Busy ? "Drafting…" : "Create draft in mailbox")" ConfirmDisabled="@Busy" CancelLabel="Cancel"
       OnCancel="OnCancel" OnConfirm="OnConfirm" Class="max-w-3xl w-full">
    <p class="rounded-lg bg-surface-raised border border-line px-3 py-2 text-xs text-content-muted mb-3">
        Nothing sends from here — this creates a draft in the shared mailbox, addressed to the winning
        subcontractor and tagged @PackageReference, for you to review and send from Outlook.
    </p>

    <label class="block eyebrow mb-1">Subject</label>
    <input class="field mb-3" value="@Subject" @onchange='e => SubjectChanged.InvokeAsync(e.Value?.ToString() ?? "")' />

    <label class="block eyebrow mb-1">Body (HTML)</label>
    <textarea class="field font-mono text-xs" rows="14" value="@Body" @onchange='e => BodyChanged.InvokeAsync(e.Value?.ToString() ?? "")'></textarea>
</Modal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? PackageReference { get; set; }
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public EventCallback<string> SubjectChanged { get; set; }
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public EventCallback<string> BodyChanged { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
}
