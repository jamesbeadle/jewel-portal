@namespace Jewel.JPMS.Features.Procurement

@* Cancelled orders stay on the page as the record of a voided purchase order — they keep their
   number (one went out under that reference) but count nowhere and offer no actions. *@
<details class="mb-6">
    <summary class="text-xs font-medium text-content-subtle cursor-pointer select-none">
        Cancelled work orders (@Orders.Count)
    </summary>
    <ul class="mt-2 text-sm divide-y divide-line panel opacity-70">
        @foreach (var detail in Orders)
        {
            <li class="px-4 py-2 flex items-center gap-3">
                <Pill Tone="Tone.Muted">Cancelled</Pill>
                <span class="font-mono text-xs text-content-subtle">@detail.Order.Reference</span>
                <span class="text-content-muted">@detail.Order.Title</span>
                <span class="text-content-subtle">@detail.SubcontractorName</span>
                <span class="ml-auto text-content-subtle line-through">@Money(detail.Order.Value)</span>
            </li>
        }
    </ul>
</details>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ProjectWorkOrderDetail> Orders { get; set; } = default!;
}
