@using Jewel.JPMS.Contracts.Subcontractors
@namespace Jewel.JPMS.Features.Procurement
@inject ISubcontractorStore Subs

@* The tender submissions compared line by line: one column per quote, one row per package line
   item, priced cells where the tender covered the line and an "outside package scope" row for
   anything it added. The winning column is badged; a tender-only prospect's column carries the
   deliberate add-to-directory act (a submitted tender is the moment to judge quality); the
   footer totals each tender and, while the package is unawarded, offers Award per column. *@
<RecordsTable Dense="true" MaxHeight="max-h-[85vh]">
    <thead>
        <tr>
            <th>Line item</th>
            <th class="hidden sm:table-cell">Qty</th>
            @foreach (var quote in Quotes)
            {
                var sub = Subs.Find(quote.SubcontractorId);
                var won = Recipients.Any(r =>
                    string.Equals(r.SubcontractorId, quote.SubcontractorId, StringComparison.OrdinalIgnoreCase)
                    && r.Status == BidPackageRecipientStatus.Won);
                <th class="text-right">
                    @(sub?.CompanyName ?? quote.SubcontractorId)
                    @if (won)
                    {
                        <Pill Tone="Tone.Positive" Class="ml-1.5">Won</Pill>
                    }
                    @if (sub is { IsProspect: true } && CanAddToDirectory)
                    {
                        <span class="block mt-1">
                            <button type="button" class="btn-secondary px-2 py-0.5 text-xs normal-case tracking-normal font-medium" disabled="@Busy"
                                    title="This company isn't in the Directory — it was only added to this tender list. Add it if the tender's worth keeping them for."
                                    @onclick="() => OnAddToDirectory.InvokeAsync(sub!.SubcontractorId)">Add to directory</button>
                        </span>
                    }
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in LineItems)
        {
            <tr>
                <td class="text-content">@item.Description</td>
                <td class="hidden sm:table-cell">@item.Quantity @item.Unit</td>
                @foreach (var quote in Quotes)
                {
                    var line = QuoteLines.FirstOrDefault(l => l.QuoteId == quote.QuoteId && l.BidPackageLineItemId == item.LineItemId);
                    <td class="text-right">
                        @(line is null ? "—" : line.Total.ToString("£#,##0.00"))
                    </td>
                }
            </tr>
        }
        @{ var extras = QuoteLines.Where(l => l.BidPackageLineItemId is null).ToList(); }
        @if (extras.Count > 0)
        {
            <tr>
                <td class="text-content-subtle italic">Outside package scope</td>
                <td class="hidden sm:table-cell"></td>
                @foreach (var quote in Quotes)
                {
                    var sum = extras.Where(l => l.QuoteId == quote.QuoteId).Sum(l => l.Total);
                    <td class="text-right text-content-subtle italic">@(sum == 0 ? "—" : sum.ToString("£#,##0.00"))</td>
                }
            </tr>
        }
    </tbody>
    <tfoot class="bg-surface-raised border-t border-line">
        <tr class="font-semibold text-content">
            <td>Total</td>
            <td class="hidden sm:table-cell"></td>
            @foreach (var quote in Quotes)
            {
                <td class="text-right">@quote.Value.ToString("£#,##0.00")</td>
            }
        </tr>
        @if (AwardEnabled)
        {
            <tr>
                <td></td>
                <td class="hidden sm:table-cell"></td>
                @foreach (var quote in Quotes)
                {
                    <td class="text-right">
                        <button type="button" class="text-xs text-accent hover:underline" disabled="@Busy"
                                @onclick="() => OnAward.InvokeAsync(quote)">Award</button>
                    </td>
                }
            </tr>
        }
    </tfoot>
</RecordsTable>

@foreach (var quote in Quotes.Where(q => !string.IsNullOrWhiteSpace(q.Notes)))
{
    var sub = Subs.Find(quote.SubcontractorId);
    <p class="text-xs text-content-subtle mt-2"><span class="font-medium text-content-muted">@(sub?.CompanyName ?? quote.SubcontractorId):</span> @quote.Notes</p>
}

@code {
    [Parameter] public IReadOnlyList<Quote> Quotes { get; set; } = Array.Empty<Quote>();
    [Parameter] public IReadOnlyList<QuoteLineItem> QuoteLines { get; set; } = Array.Empty<QuoteLineItem>();
    [Parameter] public IReadOnlyList<BidPackageLineItem> LineItems { get; set; } = Array.Empty<BidPackageLineItem>();

    /// <summary>The tender list — the Won badge reads each column's status from it.</summary>
    [Parameter] public IReadOnlyList<BidPackageRecipient> Recipients { get; set; } = Array.Empty<BidPackageRecipient>();

    /// <summary>The Award row renders only while the host says so (an editor, package unawarded).</summary>
    [Parameter] public bool AwardEnabled { get; set; }
    [Parameter] public bool CanAddToDirectory { get; set; }
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<Quote> OnAward { get; set; }
    [Parameter] public EventCallback<string> OnAddToDirectory { get; set; }
}
