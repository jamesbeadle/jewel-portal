{
  "sourceGlobs": [
    "api/**/*.cs",
    "contracts/**/*.cs",
    "jpms/**/*.cs",
    "jpms/**/*.razor",
    "worker/**/*.cs"
  ],
  "excludeGlobs": [
    "**/bin/**",
    "**/obj/**",
    "**/Migrations/**",
    "**/node_modules/**",
    "**/wwwroot/lib/**"
  ],
  "maxFileLines": 100,
  "maxFunctionLines": 30,
  "fileLengthExemptGlobs": [
    "**/GlobalUsings.cs",
    "**/*.Designer.cs"
  ],
  "booleanPrefixes": [
    "is",
    "has",
    "should",
    "can",
    "was",
    "will",
    "must",
    "allows"
  ],
  "bannedAbbreviations": [
    "usr",
    "btn",
    "cfg",
    "tmp",
    "req",
    "res",
    "ctx",
    "idx",
    "err",
    "msg",
    "num",
    "val",
    "cnt",
    "arr",
    "obj2",
    "fn"
  ],
  "commentMarkers": {
    "line": "//",
    "documentation": "///",
    "markup": "@*"
  },
  "duplication": {
    "minTokens": 70,
    "ignoreGlobs": [
      "**/bin/**",
      "**/obj/**",
      "**/Migrations/**"
    ]
  },
  "inventory": {
    "pagesGlob": "jpms/Pages/**/*.razor",
    "componentsGlob": "jpms/Components/**/*.razor",
    "widgetMarkers": {
      "table": "<table",
      "modal": "Modal",
      "form": "FormField",
      "loadGate": "LoadGate",
      "spinner": "Spinner",
      "toast": "toast",
      "dropdown": "DropdownMenu",
      "panel": "Panel",
      "export": "ExportToExcelButton"
    }
  },
  "styleTokens": {
    "markupGlobs": [
      "jpms/**/*.razor",
      "jpms/**/*.css"
    ],
    "forbidInlineHexColours": true,
    "forbidInlineStyleAttributes": true
  },
  "prose": {
    "maxMemberAccessesPerLine": 3,
    "maxLineLength": 160,
    "maxIndentDepth": 5,
    "indentWidth": 4,
    "maxMemberChainDepth": 1,
    "freeChainPrefixes": [
      "this.",
      "base.",
      "self.",
      "import.meta."
    ]
  },
  "functionNames": {
    "maxWords": 5,
    "maxLength": 40
  },
  "areas": [
    {
      "name": "tests",
      "globs": [
        "tests/**",
        "**/*Tests.cs"
      ]
    },
    {
      "name": "docs",
      "globs": [
        "**/*.md",
        "docs/**",
        "handover-prompt/**",
        "Claude outputs/**"
      ]
    },
    {
      "name": "tooling",
      "globs": [
        "tools/**",
        ".claude/**",
        "scripts/**",
        "patches/**"
      ]
    },
    {
      "name": "database",
      "globs": [
        "**/Migrations/**",
        "**/*.sql"
      ]
    },
    {
      "name": "infrastructure",
      "globs": [
        "infra/**",
        ".github/**",
        "**/*.csproj",
        "**/*.sln",
        "**/host.json",
        "**/local.settings.json*",
        ".gitignore"
      ]
    },
    {
      "name": "connector",
      "globs": [
        "api/Features/Ai/**",
        "api/Features/Connect/**",
        "contracts/Ai/**"
      ]
    },
    {
      "name": "api",
      "globs": [
        "api/**"
      ]
    },
    {
      "name": "worker",
      "globs": [
        "worker/**"
      ]
    },
    {
      "name": "contracts",
      "globs": [
        "contracts/**"
      ]
    },
    {
      "name": "frontend",
      "globs": [
        "jpms/**",
        "prototypes/**",
        "assets/**"
      ]
    }
  ],
  "designPatterns": {
    "entityGlobs": [
      "**/Domain/**/*.cs",
      "**/Entities/**/*.cs",
      "**/Models/**/*.cs"
    ],
    "minimumFamilySize": 4,
    "cooccurrenceThreshold": 0.75,
    "fileCountBand": 2.0,
    "acceptedGaps": []
  },
  "score": {
    "elements": {}
  },
  "siteDefinition": {
    "viewGlobs": [
      "jpms/**/*.razor"
    ],
    "ignoredTags": [
      "PageTitle",
      "HeadContent"
    ],
    "catalogue": [
      "Page",
      "PageHeader",
      "PageHeading",
      "SectionHeader",
      "Panel",
      "Notice",
      "Pill",
      "DropdownMenu",
      "FormField",
      "Checkbox",
      "RecordsTable",
      "SortableColumnHeader",
      "TabRow",
      "FilterChips",
      "SearchInput",
      "SearchSelect",
      "StatTile",
      "MetricStat",
      "EmptyState",
      "ConfirmDialog",
      "InlineConfirm",
      "Modal",
      "Toolbar",
      "ToolbarButton",
      "ToolbarDivider",
      "LoadGate",
      "DateText",
      "DateTimeText",
      "Money",
      "WholeMoney",
      "RecordTabBar",
      "ExportToExcelButton",
      "RichTextEditor",
      "ErrorToast"
    ],
    "handRolled": [
      {
        "element": "table",
        "ownedBy": "RecordsTable"
      },
      {
        "element": "input",
        "ownedBy": "FormField",
        "unlessAttributes": [
          "type=\"checkbox\"",
          "type=\"radio\"",
          "type=\"file\"",
          "type=\"hidden\""
        ]
      },
      {
        "element": "select",
        "ownedBy": "FormField"
      },
      {
        "element": "textarea",
        "ownedBy": "FormField"
      },
      {
        "element": "h1",
        "ownedBy": "PageHeader"
      },
      {
        "element": "h2",
        "ownedBy": "SectionHeader"
      },
      {
        "element": "h3",
        "ownedBy": "SectionHeader"
      },
      {
        "element": "dl",
        "ownedBy": "KeyValueList"
      },
      {
        "element": "button",
        "ownedBy": "Button",
        "unlessClassPrefixes": [
          "btn-",
          "chip",
          "tab"
        ]
      }
    ],
    "horizontalClasses": [
      "flex",
      "inline-flex"
    ],
    "verticalClasses": [
      "flex-col"
    ],
    "document": "tools/refactor/site-definition.md"
  },
  "frameworkHandlers": {
    "namePatterns": [
      "^on[A-Z]",
      "^handle[A-Z]",
      "^On[A-Z]",
      "^Handle[A-Z]"
    ],
    "names": [],
    "coincidenceLines": 12
  }
}
