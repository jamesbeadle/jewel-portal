{
  "sourceGlobs": [
    "api/**/*.cs",
    "contracts/**/*.cs",
    "jpms/**/*.cs",
    "jpms/**/*.razor",
    "worker/**/*.cs"
  ],
  "excludeGlobs": [
    "**/bin/**",
    "**/obj/**",
    "**/Migrations/**",
    "**/node_modules/**",
    "**/wwwroot/lib/**"
  ],
  "maxFileLines": 100,
  "maxFunctionLines": 30,
  "fileLengthExemptGlobs": [
    "**/GlobalUsings.cs",
    "**/*.Designer.cs"
  ],
  "booleanPrefixes": [
    "is",
    "has",
    "should",
    "can",
    "was",
    "will",
    "must",
    "allows"
  ],
  "bannedAbbreviations": [
    "usr",
    "btn",
    "cfg",
    "tmp",
    "req",
    "res",
    "ctx",
    "idx",
    "err",
    "msg",
    "num",
    "val",
    "cnt",
    "arr",
    "obj2",
    "fn"
  ],
  "commentMarkers": {
    "line": "//",
    "documentation": "///",
    "markup": "@*"
  },
  "duplication": {
    "minTokens": 70,
    "ignoreGlobs": [
      "**/bin/**",
      "**/obj/**",
      "**/Migrations/**"
    ]
  },
  "inventory": {
    "pagesGlob": "jpms/Pages/**/*.razor",
    "componentsGlob": "jpms/Components/**/*.razor",
    "widgetMarkers": {
      "table": "<table",
      "modal": "Modal",
      "form": "FormField",
      "loadGate": "LoadGate",
      "spinner": "Spinner",
      "toast": "toast",
      "dropdown": "DropdownMenu",
      "panel": "Panel",
      "export": "ExportToExcelButton"
    }
  },
  "styleTokens": {
    "markupGlobs": [
      "jpms/**/*.razor",
      "jpms/**/*.css"
    ],
    "forbidInlineHexColours": true,
    "forbidInlineStyleAttributes": true
  },
  "prose": {
    "maxMemberAccessesPerLine": 3,
    "maxLineLength": 160,
    "maxIndentDepth": 5,
    "indentWidth": 4
  },
  "functionNames": {
    "maxWords": 5,
    "maxLength": 40
  },
  "areas": [
    {
      "name": "tests",
      "globs": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/tests/**",
        "**/Tests/**",
        "**/*.Tests/**",
        "**/*Tests.cs"
      ]
    },
    {
      "name": "docs",
      "globs": [
        "**/*.md",
        "docs/**"
      ]
    },
    {
      "name": "tooling",
      "globs": [
        "tools/**",
        ".claude/**",
        "scripts/**"
      ]
    },
    {
      "name": "database",
      "globs": [
        "**/Migrations/**",
        "**/*.sql"
      ]
    },
    {
      "name": "api",
      "globs": [
        "**/Controllers/**",
        "**/Endpoints/**",
        "**/Api/**",
        "**/Functions/**",
        "**/Ai/**"
      ]
    },
    {
      "name": "frontend",
      "globs": [
        "**/*.razor",
        "**/*.razor.cs",
        "**/*.razor.css",
        "**/wwwroot/**",
        "**/*.css",
        "**/*.js"
      ]
    },
    {
      "name": "backend",
      "globs": [
        "**/*.cs"
      ]
    },
    {
      "name": "infrastructure",
      "globs": [
        "infra/**",
        "**/*.bicep",
        ".github/**",
        "**/*.csproj",
        "**/*.sln",
        "*.json",
        "*.yml",
        "*.yaml",
        ".*"
      ]
    }
  ],
  "designPatterns": {
    "entityGlobs": [
      "**/Domain/**/*.cs",
      "**/Entities/**/*.cs",
      "**/Models/**/*.cs"
    ],
    "minimumFamilySize": 4,
    "cooccurrenceThreshold": 0.75,
    "fileCountBand": 2.0,
    "acceptedGaps": []
  },
  "score": {
    "elements": {}
  }
}
