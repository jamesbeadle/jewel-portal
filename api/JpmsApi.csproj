<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jewel.JPMS.Api</RootNamespace>
    <AssemblyName>Jewel.JPMS.Api</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      DEPLOY SIZE (2026-09-16). SWA managed functions reject an API over 100 MB, and this project
      ships several packages that carry a native library for every platform (Docnet's pdfium,
      Magick.NET's ImageMagick) plus EF Core Design's Roslyn with resources in eleven languages.
      Two trims keep the published output to what the host can actually use:
        - SatelliteResourceLanguages: only English resource assemblies are published (no cs/de/…).
        - TrimPublishedRuntimes (below): after publish, runtimes/<rid> folders the host cannot load
          are deleted. The SWA deploy log says the managed-functions host is Windows
          ("Function Runtime Information. OS: windows"), so win, win-x64 and win-x86 are kept —
          both bitnesses because the worker process bitness on that host is not under our control.
      Override PublishRuntimesToKeep (semicolon list) or set KeepAllRuntimes=true if the host changes.
      The trim is for the SWA host ONLY. The MCP connector host (func-jpms-mcp-prod) is LINUX and has
      no package cap, so .github/workflows/jpms-mcp.yml publishes with -p:KeepAllRuntimes=true:
      trimming there removed runtimes/unix (the Linux Microsoft.Data.SqlClient) and every database
      call on the connector failed with a 500 (2026-09-16).
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishRuntimesToKeep Condition="'$(PublishRuntimesToKeep)' == ''">win;win-x64;win-x86</PublishRuntimesToKeep>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project pins the AI transcript shape (BuildTranscript) and other internals. -->
    <InternalsVisibleTo Include="Jewel.JPMS.Tests" />
    <InternalsVisibleTo Include="smoke" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" Version="1.0.1" />
    <!--
      Azure.Identity provides the app-only Graph token (client-credentials) used by the on-demand
      intake message reader, which fetches an email's full body + attachment names live when a
      triager opens it. Ganss.Xss sanitises that untrusted HTML body before it is rendered.
    -->
    <PackageReference Include="Azure.Identity" Version="1.12.1" />
    <PackageReference Include="HtmlSanitizer" Version="8.1.870" />
    <!--
      Azure.Storage.Queues is the producer SDK used by StorageMailboxQueue to enqueue work for the
      worker Function App. The Functions queue/timer *trigger* extensions and Azure.Identity (Graph)
      live in the worker project — SWA managed functions only support HTTP triggers.
    -->
    <PackageReference Include="Azure.Storage.Queues" Version="12.19.1" />
    <!--
      Azure.Storage.Blobs stores the actual drawing files behind each revision (private container,
      proxied downloads). Uploads run through the SWA-managed HTTP Function; no queue/timer trigger.
    -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="1.22.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="1.3.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="1.17.4" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="1.2.0" />
    <!--
      PDFsharp/MigraDoc (MIT) renders the branded request (RFI) document. The pure-managed package
      (no -gdi / -wpf suffix) is the right choice for the Linux Azure Functions host; a custom
      IFontResolver (DocumentFontResolver) supplies the TrueType faces it needs there.
    -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.1.1" />
    <!-- PDF TEXT EXTRACTION (reading, where PDFsharp above is generation) — read_email_attachment
         and chat uploads route PDFs through AiAttachmentReader.ExtractPdf on it. -->
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- PAGE RENDERING (a scanned PDF has no text layer — its pages are shown to the assistant as
         images, and OCR'd when Azure AI Vision is configured). Docnet wraps pdfium with the native
         library for linux-x64 / win-x64 / osx in the package; nothing to install on the host. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- PHOTOGRAPH PREPARATION (progress photos, 2026-09-16): Magick.NET opens the HEIC an iPhone
         exports as well as JPEG and PNG, turns each image by its EXIF orientation, shrinks it to
         display size and re-encodes it (ProgressPhotoPreparation). The AnyCPU package carries the
         native ImageMagick — with libheif — for every platform (win/linux/osx, x64/x86/arm64);
         nothing to install. AnyCPU rather than -x64 because local development on an Apple-silicon
         Mac needs the osx-arm64 build; the unused platforms are removed at publish by
         TrimPublishedRuntimes, otherwise ~150 MB of native libraries would go to Azure. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="13.10.0" />
    <!--
      ClosedXML (MIT, pure managed — fine on the Linux Functions host) reads the spreadsheets users
      attach to the assistant chat (AiAttachmentReader): the boss's tracker workbook goes in, text
      the model can populate a create form from comes out. Read-only use; nothing writes xlsx here.
    -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!--
      The Word half of the Contractor's Report (ContractorsReportWordRenderer) writes .docx
      directly with the Open XML SDK. Pinned at the version ClosedXML already carries, so the
      one assembly serves both.
    -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\contracts\Jewel.JPMS.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- Poppins (OFL, fonts/LICENCE-Poppins.txt): the brand face every generated document is set in
         (2026-09-15). DocumentFontResolver probes the fonts folder beside the application first. -->
    <None Include="fonts\*.ttf;fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- See the DEPLOY SIZE note at the top. Runs on every publish, including the Oryx build the
       SWA GitHub Action performs (it calls `dotnet publish` on this project). -->
  <Target Name="TrimPublishedRuntimes" AfterTargets="Publish" Condition="'$(KeepAllRuntimes)' != 'true'">
    <PropertyGroup>
      <_PublishRuntimesRoot>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))runtimes</_PublishRuntimesRoot>
      <_PublishRuntimesKeepList>;$(PublishRuntimesToKeep);</_PublishRuntimesKeepList>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_PublishRuntimesRoot)')">
      <_PublishRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(_PublishRuntimesRoot)'))" />
      <_PublishRuntimeDirToRemove Include="@(_PublishRuntimeDir)"
                                  Condition="!$(_PublishRuntimesKeepList.Contains(';%(Filename)%(Extension);'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_PublishRuntimeDirToRemove)" />
    <Message Importance="high" Text="TrimPublishedRuntimes: kept [$(PublishRuntimesToKeep)], removed [@(_PublishRuntimeDirToRemove->'%(Filename)%(Extension)', ', ')] from $(_PublishRuntimesRoot)" />
  </Target>

</Project>
